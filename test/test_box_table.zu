# CASE more than 4096 boxes live at once
template Holder { bytes: box[4], id: int }
let all = []
for (let i = 0; i < 10000; i++) {
    let b = box[4]
    b[0] = i % 250
    append(all, Holder(b, i))
}
let total = 0
for (let h in all) {
    total += h.bytes[0]
}
print(len(all))
print(total)
print(all[9999].bytes[0])
# CASE many boxes made and released one after another
func fill(n) {
    let total = 0
    for (let i = 0; i < n; i++) {
        let b = box[8]
        b[0] = i % 200
        total += b[0]
    }
    return total
}
print(fill(10000))
# CASE a big box
let big = box[1000000]
big[999999] = 9
big[0] = 1
print(big.len)
print(big[-1] + big[0])
# CASE the largest box
let huge = box[16777216]
huge[-1] = 3
print(huge[-1])
# CASE assigning a box copies it
let a = box[4]
a[0] = 1
let b = a
b[0] = 2
print(a[0])
print(b[0])
# CASE a box assigned again copies again
let a = box[2]
let b = box[2]
a[1] = 7
b = a
a[1] = 8
print(b[1])
# CASE passing a box to a function lends it
func set_first(buf, value) {
    buf[0] = value
}
let a = box[4]
set_first(a, 9)
print(a[0])
# CASE a freed box lent to a function is still freed
func touch(buf) {
    buf[0] = 1
}
let a = box[2]
free(a)
touch(a)
# CASE a stack box in a loop is released each time
func loop_boxes() {
    let sum = 0
    for (let i = 0; i < 20000; i++) {
        let tmp = box[16]
        tmp[15] = 1
        sum += tmp[15]
    }
    return sum
}
print(loop_boxes())
# CASE boxes made in a function are gone after it returns
func make_and_use() {
    let one = box[4]
    let two = box[4]
    one[0] = 1
    two[0] = 2
    return one[0] + two[0]
}
print(make_and_use())
print(make_and_use())
# CASE freeing early and then leaving the scope is fine
func early_free() {
    let b = box[4]
    b[0] = 5
    let value = b[0]
    free(b)
    return value
}
print(early_free())
