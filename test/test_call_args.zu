// Every argument must land in its own slot, whatever expression produces it.
// An inline func literal used to shift the arguments after it by one register.
print("Testing call arguments...")

func two(a: string, b: int) {
    return "{a}|{b}"
}

let r1: int = reduce(range(3), func(a: int, b: int) { return a + b }, 100)
assert(r1 == 103)
let r2: string = reduce(range(3), func(acc: string, x: int) { return acc + to_string(x) }, "z")
assert(r2 == "z012")
assert(two(string(func() { return 1 }()), 9) == "1|9")

let m = {"k": 3}
let l = [1, 2, 3]
template T { v }
assert(two(string([1, 2]), 9) == "[1, 2]|9")
assert(two(string(m.k), 9) == "3|9")
assert(two(string(l[1]), 9) == "2|9")
assert(two(string(true and 1 < 2), 9) == "true|9")
assert(two("x{l[2]}y", 9) == "x3y|9")
assert(two(two("1", 2), 9) == "1|2|9")
assert(two(string(T(5).v), 9) == "5|9")
assert(two(repeat("ab", 2) + to_string(5), 9) == "abab5|9")

print("Call argument tests passed!")
