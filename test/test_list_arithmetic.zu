//
// + - * / between two lists: element by element, and the result is a dense list of floats.

# CASE the result holds floats and the checker knows it
let s = [4, 6] + [2, 3]
let x = s[0]
x = x + 1.5
print(s, x)
print([4, 6] * [2, 3], [4, 6] / [2, 3], [4, 6] - [2, 3])
# CASE an int variable cannot take an item of list arithmetic
let s = [4, 6] + [2, 3]
let x: int = s[0]
