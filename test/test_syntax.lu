# CASE arithmetic precedence and associativity
print(1 + 2 * 3)
print((1 + 2) * 3)
print(10 - 4 - 3)
print(100 / 10 / 5)
print(2 * 3 % 4)
print(7 % 4 * 2)
print(10 / 3)
print(-7 / 2)
print(-7 % 3)
print(2 + 3 * 4 - 5)
# CASE unary minus
let a = 5
print(-a)
print(- -a)
print(-(a + 1))
print(2 - -3)
print(-2 * -3)
print(a * -1)
print(-a + 10)
# CASE float arithmetic and printing
print(1.5 + 2.25)
print(10.0 / 4.0)
print(2.0 * 3.5)
print(1.0)
print(0.5 + 0.25)
print(7.0 - 0.5 * 3.0)
# CASE comparison and equality precedence
print(1 + 1 == 2)
print(1 < 2 == true)
print(3 > 2 and 2 > 1)
print(1 == 1 and 2 == 2)
print(1 != 2)
print(2 <= 2)
print(3 >= 4)
# CASE logic precedence
print(true or false and false)
print(false and true or true)
print(not true or true)
print(not false and true)
print(true and not false)
# CASE short circuit does not evaluate the right side
let calls = 0
func touch() {
    calls += 1
    return true
}
let r1 = false and touch()
let r2 = true or touch()
print(calls)
let r3 = true and touch()
print(calls)
# CASE strings and escapes
print("tab\there")
print("quote \" inside")
print("back\\slash")
print("two\nlines")
print("")
print("hash # not a comment")
print("slash // not a comment")
# CASE string interpolation
let name = "Luna"
let n = 3
let xs = [10, 20, 30]
print("hi {name}")
print("sum {n + 4}")
print("item {xs[1]}")
print("{name}{n}")
print("literal \{n}")
print("{len(xs)} items")
print("{}")
# CASE comments
let c = 1 # trailing hash
let d = 2 // trailing slashes
print(c + d)
# a whole-line comment
// another whole-line comment
print(c)
# CASE let and const forms
let p = 1
let q, r = 2, 3
const k = 4
const u, v = 5, 6
print(p + q + r + k + u + v)
# CASE if else chains
func grade(score) {
    if (score >= 90) {
        return "A"
    } else if (score >= 80) {
        return "B"
    } else if (score >= 70) {
        return "C"
    } else {
        return "F"
    }
}
print(grade(95))
print(grade(85))
print(grade(75))
print(grade(10))
# CASE else on the next line
let x = 3
if (x > 5) {
    print("big")
}
else {
    print("small")
}
# CASE while with break and continue
let i = 0
let total = 0
while (true) {
    i += 1
    if (i == 3) {
        continue
    }
    if (i > 6) {
        break
    }
    total += i
}
print(total)
# CASE classic for loop
let s = 0
for (let j = 0; j < 5; j++) {
    s += j
}
print(s)
# CASE for loop with an existing variable
let m = 0
for (m = 10; m > 7; m--) {
    print(m)
}
# CASE for in over a list and a string
for (let item in [1, 2, 3]) {
    print(item)
}
for (let ch in "ab") {
    print(ch)
}
# CASE for in over range
let acc = []
for (let t in range(3)) {
    append(acc, t * t)
}
print(acc)
# CASE nested loops with break
for (let a = 0; a < 3; a++) {
    for (let b = 0; b < 3; b++) {
        if (b == 2) {
            break
        }
        print("{a}{b}")
    }
}
# CASE switch
func word(n) {
    switch (n) {
        case 1:
            return "one"
        case 2:
            return "two"
        default:
            return "many"
    }
}
print(word(1))
print(word(2))
print(word(9))
# CASE function defaults and calls
func add(a, b = 10) {
    return a + b
}
print(add(1))
print(add(1, 2))
print(add(add(1), add(2, 3)))
# CASE closures keep their own state
func make_counter() {
    let count = 0
    return func() {
        count += 1
        return count
    }
}
let c1 = make_counter()
let c2 = make_counter()
print(c1())
print(c1())
print(c2())
# CASE functions as values
func apply(f, x) {
    return f(x)
}
func double(n) {
    return n * 2
}
print(apply(double, 4))
print(apply(func(n) { return n + 1 }, 4))
# CASE recursion
func fib(n) {
    if (n < 2) {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}
print(fib(15))
# CASE nested function definitions
func outer(x) {
    func inner(y) {
        return y * x
    }
    return inner(3)
}
print(outer(4))
# CASE lists and indexing
let xs = [5, 6, 7]
print(xs[0])
print(xs[-1])
print(xs[1 + 1])
xs[1] = 60
xs[2] += 1
print(xs)
print(len(xs))
# CASE nested lists
let grid = [[1, 2], [3, 4]]
print(grid[1][0])
grid[0][1] = 20
print(grid)
# CASE maps
let mp = {"a": 1, "b": 2}
print(mp.a)
print(mp["b"])
mp.c = 3
mp["a"] = 10
print(mp.a + mp.b + mp.c)
let nested = {"p": {"q": 5}}
nested.p.q = 6
print(nested.p.q)
# CASE compound assignment and increment
let v = 10
v += 5
v -= 3
v *= 2
v /= 4
print(v)
let w = 1
w++
w++
w--
print(w)
# CASE data and template and bloc
data Point { x, y }
template Player { name, hp }
bloc Vec { x, y }
let pt = Point(1, 2)
pt.x = 9
print(pt.x + pt.y)
let hero = Player("Astra", 100)
hero.hp = 80
print(hero.hp)
let vv = Vec{3, 4}
print(vv.x * vv.y)
# CASE call arguments over several lines
func sum3(a, b, c) {
    return a + b + c
}
print(sum3(
    1,
    2,
    3
))
let big = [
    1,
    2,
    3
]
print(len(big))
let table = {
    "x": 1,
    "y": 2
}
print(table.y)
# CASE blank lines and indentation do not matter

let blank = 1


print(blank)
		print(blank + 1)
# CASE statements on one line
let a1 = 1 let a2 = 2 print(a1 + a2)
# CASE not binds looser than comparison
let n = 5
print(not n == 3)
print(not n == 5)
print(not n < 3 and n > 1)
print(not true or true)
print(true and not false)
print(not not true)
# CASE postfix increment gives the old value
let a = 5
let b = a++
print(b)
print(a)
print(a--)
print(a)
# CASE prefix increment gives the new value
let c = 5
print(++c)
print(--c)
print(c)
# CASE increment inside an expression
let i = 0
let s = 0
while (i < 4) {
    s += i++
}
print(s)
print(i)
# CASE standalone blocks scope their variables
let v = 1
{
    let v = 2
    print(v)
}
print(v)
# CASE for loop without a condition
let k = 0
for (;;) {
    k++
    if (k > 2) {
        break
    }
}
print(k)
# CASE for loop with empty parts
let j = 0
for (; j < 3;) {
    j += 1
}
print(j)
# CASE operator at the end of a line continues the expression
let total = 1 +
    2 +
    3
print(total)
let ok = true and
    false
print(ok)
# CASE line breaks inside brackets
let sum = (1
    + 2
    + 3)
print(sum)
let xs = [1,
    2
    , 3]
print(xs)
# CASE trailing commas
func add(a, b,) {
    return a + b
}
print(add(1, 2,))
let ys = [1, 2, 3,]
print(len(ys))
let m = {"a": 1, "b": 2,}
print(m.b)
# CASE keywords as field names
let t = {"data": 1, "in": 2, "print": 3, "if": 4}
print(t.data)
print(t.in)
print(t.print)
print(t.if)
# CASE modulo assignment
let r = 17
r %= 5
print(r)
# CASE declaration continues after an equals sign
let long_value =
    42
print(long_value)
# CASE shadowing in an inner block is allowed
func f(x) {
    if (x > 0) {
        let x2 = x * 2
        return x2
    }
    return 0
}
print(f(4))
let q = 1
if (true) {
    let q = 2
    print(q)
}
print(q)
