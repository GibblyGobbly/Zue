# CASE string plus int
func pass(v: string) {
    return [v, null][0]
}
let s = pass("a") + 1
# test: no-strict
# CASE int plus bool
func pass(v: int) {
    return [v, null][0]
}
let s = pass(1) + true
# test: no-strict
# CASE null plus int
func pass(v) {
    return [v, null][0]
}
let s = pass(null) + 1
# test: no-strict
# CASE list plus int
func pass(v: list<int>) {
    return [v, null][0]
}
let s = pass([1, 2]) + 1
# test: no-strict
# CASE integer overflow
let big = 9223372036854775807
let s = big + 1
# CASE integer overflow in multiply
let big = 4611686018427387904
let s = big * 2
# CASE integer division by zero
let z = 0
let s = 1 / z
# CASE float division by zero
let z = 0.0
let s = 1.5 / z
# CASE modulo by zero
let z = 0
let s = 5 % z
# CASE if on an int
func pass(v: int) {
    return [v, null][0]
}
if (pass(5)) { print("no") }
# test: no-strict
# CASE while on a string
func pass(v: string) {
    return [v, null][0]
}
while (pass("x")) { print("no") }
# test: no-strict
# CASE not on an int
func pass(v: int) {
    return [v, null][0]
}
let s = not pass(0)
# test: no-strict
# CASE and on an int
func pass(v: int) {
    return [v, null][0]
}
let s = pass(1) and true
# test: no-strict
# CASE compare int with string
func pass(v: int) {
    return [v, null][0]
}
let s = pass(1) == "1"
# test: no-strict
# CASE order int and string
func pass(v: int) {
    return [v, null][0]
}
let s = pass(1) < "a"
# test: no-strict
# CASE negate a string
func pass(v: string) {
    return [v, null][0]
}
let t = pass("x")
let s = -t
# test: no-strict
# CASE the right side of and must be a bool
func pass(v: int) { return [v, null][0] }
print(true and pass(5))
# test: no-strict
# CASE the right side of or must be a bool
func pass(v: string) { return [v, null][0] }
print(false or pass("x"))
# test: no-strict
# CASE and and or give a bool when both sides are bools
func pass(v) { return [v, null][0] }
print(true and pass(true))
print(false or pass(false))
print(false and pass(5))
print(true or pass(5))
# test: no-strict
