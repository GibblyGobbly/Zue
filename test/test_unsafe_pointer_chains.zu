//
// ptr_add on a pointer that ptr_add made: the offset counts from the start of the allocation.

# CASE chained ptr_add
unsafe {
    let p = alloc(4)
    store(p, 7)
    let q = ptr_add(ptr_add(p, 1), 1)
    store(q, 9)
    print(load(ptr_add(p, 2)), load(p))
    let r = ptr_add(q, -1)
    store(r, 8)
    print(load(ptr_add(p, 1)))
    free(p)
}
# CASE chained ptr_add past the end
unsafe {
    let p = alloc(4)
    let q = ptr_add(ptr_add(p, 2), 2)
    print(q)
    free(p)
}
# CASE chained ptr_add before the start
unsafe {
    let p = alloc(4)
    let q = ptr_add(ptr_add(p, 1), -2)
    print(q)
    free(p)
}
# CASE an old pointer after many allocations
func main() {
    unsafe {
        let first = alloc(4)
        store(first, 1)
        store(ptr_add(first, 3), 4)
        let i = 0
        while (i < 20000) {
            let p = alloc(2)
            store(p, i)
            free(p)
            i++
        }
        let total = 0
        let j = 0
        while (j < 20000) {
            total += load(first) as int + load(ptr_add(first, 3)) as int
            j++
        }
        print(total)
        free(first)
    }
}
main()
