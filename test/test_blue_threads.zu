# Blue threads: spawn, wait, yield and channels. Each CASE runs on its own. Run with
# ZUE_RT_GC_STRESS=1 ZUE_RT_GC_VERIFY=1 to check that the collector sees the stacks of threads that are away.
# The cases here record the order in which threads run, so they run without time slices (a thread is
# switched out only where it waits); test_blue_preemption.zu covers the slices.
# test: no-preempt

# CASE results and order
func add(a: int, b: int) {
    return a + b
}
let t1 = spawn(add, 2, 3)
let t2 = spawn(add, 10, 20)
print(wait(t2), wait(t1))
print(type(t1), type(channel()))

# CASE threads run only when the running thread waits
func say(name: string) {
    print("in {name}")
    return name
}
let t = spawn(say, "child")
print("before wait")
print(wait(t))

# CASE yield alternates between threads
func count(name: string, n: int) {
    for (let i = 0; i < n; i++) {
        print("{name} {i}")
        yield()
    }
    return n
}
let a = spawn(count, "a", 3)
let b = spawn(count, "b", 3)
let ra: int = wait(a)
let rb: int = wait(b)
print(ra + rb)

# CASE unbuffered channel hands values over in order
func producer(ch: channel, n: int) {
    for (let i = 0; i < n; i++) {
        send(ch, i * i)
    }
}
let ch = channel()
let p = spawn(producer, ch, 5)
let out = []
for (let i = 0; i < 5; i++) {
    append(out, recv(ch))
}
wait(p)
print(out)

# CASE buffered channel fills and the sender waits for room
func fill(ch: channel) {
    for (let i = 0; i < 6; i++) {
        send(ch, i)
        print("sent {i}")
    }
}
let ch = channel(2)
let f = spawn(fill, ch)
yield()
print("main wakes")
let sum = 0
for (let i = 0; i < 6; i++) {
    let got: int = recv(ch)
    sum += got
}
wait(f)
print(sum)

# CASE a pipeline of three threads
func gen(out: channel, n: int) {
    for (let i = 1; i <= n; i++) {
        send(out, i)
    }
    channel_close(out)
}
func square(inp: channel, out: channel, n: int) {
    for (let i = 0; i < n; i++) {
        let v: int = recv(inp)
        send(out, v * recv_one_more())
    }
}
func recv_one_more() {
    return 1
}
let c1 = channel(1)
let c2 = channel(1)
let g = spawn(gen, c1, 4)
let s = spawn(square, c1, c2, 4)
let total = 0
for (let i = 0; i < 4; i++) {
    let got: int = recv(c2)
    total += got
}
print(total)

# CASE closed channel keeps its buffered values
let ch = channel(3)
send(ch, "x")
send(ch, "y")
channel_close(ch)
print(recv(ch), recv(ch))
recv(ch)

# CASE send on a closed channel
let ch = channel(1)
channel_close(ch)
send(ch, 1)

# CASE deadlock is an error
let ch = channel()
recv(ch)

# CASE a thread waiting for itself
func me(ch: channel) {
    let t: thread = recv(ch)
    return wait(t)
}
let ch = channel(1)
let first = spawn(me, ch)
send(ch, first)
wait(first)

# CASE wait needs a thread
wait(5)

# CASE spawn needs a function
spawn(5)

# CASE channel size must not be negative
channel(0 - 1)

# CASE a thread keeps its own call depth
func deep(n: int) {
    if (n == 0) {
        yield()
        return 0
    }
    return 1 + deep(n - 1)
}
let a = spawn(deep, 50)
let b = spawn(deep, 80)
print(deep(30), wait(a), wait(b))

# CASE recursion too deep in a thread is an error, not a crash
func forever(n: int) -> int {
    return forever(n + 1) + 1
}
wait(spawn(forever, 0))

# CASE many threads
func square_of(n: int) {
    return n * n
}
let ts = []
for (let i = 0; i < 2000; i++) {
    append(ts, spawn(square_of, i))
}
let total = 0
for (let i = 0; i < 2000; i++) {
    let got_total: int = wait(ts[i])
    total += got_total
}
print(total)

# CASE objects held only by a thread that is away survive collections
func holder_thread(ch: channel, id: int) {
    let mine = []
    for (let i = 0; i < 200; i++) {
        append(mine, [id, i, "s{id}-{i}"])
    }
    send(ch, id)
    yield()
    let sum = 0
    for (let i = 0; i < 200; i++) {
        let row = mine[i]
        if (row[0] as int != id or row[1] as int != i or row[2] as string != "s{id}-{i}") {
            print("thread {id} lost data at {i}")
            exit(1)
        }
        sum += row[1] as int
    }
    return sum
}
let ch = channel(100)
let ts = []
for (let id = 0; id < 20; id++) {
    append(ts, spawn(holder_thread, ch, id))
}
for (let id = 0; id < 20; id++) {
    recv(ch)
}
let junk = []
for (let i = 0; i < 20000; i++) {
    append(junk, [i, "j{i}"])
    if (len(junk) > 100) {
        junk = []
    }
}
let total = 0
for (let id = 0; id < 20; id++) {
    let got_total: int = wait(ts[id])
    total += got_total
}
print(total)

# CASE a thread that runs before the collector reached its stack sends what only it held
func deep(shelf: channel, id: int, n: int) {
    if (n == 0) {
        let mine = [id, "only{id}"]
        yield()
        send(shelf, mine)
        mine = [0, "gone"]
        let junk = []
        for (let i = 0; i < 20; i++) {
            append(junk, "j{i}")
        }
        yield()
        return id
    }
    let pad = n * 2
    return deep(shelf, id, n - 1) + pad - pad
}
func start(shelf: channel, id: int) {
    return deep(shelf, id, 150)
}
let ds = []
let shelf_ch = channel(400)
for (let id = 0; id < 400; id++) {
    append(ds, spawn(start, shelf_ch, id))
}
let waste = []
for (let i = 0; i < 30000; i++) {
    append(waste, [i, "w{i}"])
    if (len(waste) > 200) {
        waste = []
    }
    if (i % 3000 == 0) {
        yield()
    }
}
let sum = 0
for (let id = 0; id < 400; id++) {
    let got_sum: int = wait(ds[id])
    sum += got_sum
}
let ok = 0
let shelf = []
for (let i = 0; i < 400; i++) {
    let row: list = recv(shelf_ch)
    append(shelf, row)
    if (row[1] as string == "only{row[0]}") {
        ok += 1
    }
}
print(sum, len(shelf), ok)

# CASE blocking inside an unsafe block is an error
func blocked() {
    yield()
}
let t = spawn(blocked)
unsafe {
    yield()
}
