# Types the checker works out without annotations: a list that starts empty, a branch on type(x), a
# recursive function that returns a template, and the results of builtins.

# CASE a list that starts empty takes the type of its first append
let xs = []
append(xs, 1)
append(xs, 2)
print(xs[0] + xs[1])
let s: string = xs[0]

# CASE a value of another type makes it a list of mixed items
let xs = []
append(xs, 1)
append(xs, "two")
xs[0] = true
print(xs)

# CASE a branch on type(x) that cannot run is not counted
func size(x) {
    if (type(x) == "string") {
        return "text"
    }
    return len(x)
}
let n = size([1, 2, 3])
print(n + 1)
let t: string = size([1])

# CASE a recursive function that returns a template or null has the template type
template Tree { v: int, l: Tree }
func build(n) {
    if (n == 0) {
        return null
    }
    return Tree(n, build(n - 1))
}
let tree = build(3)
print(tree.l.v)
let bad: int = tree

# CASE builtin results are known
let a = args()
let m = {"x": 1, "y": 2}
print(map_get(m, "x") + 1)
print(len(map_values(m)))
let wrong: int = a
# CASE after if (type(x) == "list") { return ... } the rest of the function is not for a list
func first(x) {
    if (type(x) == "list") {
        return len(x)
    }
    return x + 1
}
print(first([1, 2]))
print(first(5))
# CASE a function returning a string or null has the type string, and so does map_get with a null default
# strict
func name_of(id: int) {
    if (id == 1) {
        return "Ann"
    }
    return null
}
let n = name_of(1)
print(n + "!")
print(name_of(2) == null)
let ages: map<string> = {"a": "x"}
let v = map_get(ages, "a", null)
print(v + "y")
# CASE an int or null stays unknown in strict mode
# strict
func count_of(id: int) {
    if (id == 1) {
        return 3
    }
    return null
}
print(count_of(1) + 1)
# CASE a function knows a variable declared below it
# strict
func bump() {
    COUNT += 1
    return COUNT > 1
}
let COUNT = 0
print(bump())
print(bump())
# CASE a field read on a map has the map's value type, and open gives a file
# strict
let mode = {"name": "text"}
print(mode.name + "!")
let f = open("no_such_file_here.txt", "r")
print(f == null)
# CASE a parameter given null: the code after if (x == null) { return ... } is not checked for it
# strict
template Pt { x: int, y: int }
func sum_of(p) {
    if (p == null) {
        return 0
    }
    return p.x + p.y
}
print(sum_of(null))
print(sum_of(Pt(2, 3)))
