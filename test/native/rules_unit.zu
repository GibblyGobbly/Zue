# Unit tests for compiler/runtime/zue_rt_rules.zu, compiled in the native dialect together
# with that file by test/native/run.sh. They port the tests of the Rust libraries the rules
# replaced (rust/data_rt and rust/unsafe_rt) and add checks of the error text and of the
# string handling.

extern("printf", "i32", "ptr,...")
extern("strcmp", "i32", "ptr,ptr")

let failures = 0
let checks = 0

func expect(label, got, want) {
    checks += 1
    if (got != want) {
        failures += 1
        printf(cstr("[FAIL] %s: got %ld, want %ld\n"), label, got, want)
    }
}

# Writes up to four bytes and a NUL terminator into buf (a zero byte ends the string).
func raw(buf, a, b, c, d) {
    st8(buf, a)
    st8(buf + 1, b)
    st8(buf + 2, c)
    st8(buf + 3, d)
    st8(buf + 4, 0)
    return buf
}

func expect_text(label, code_is_mem, code, want) {
    let buf = stack_buf(256)
    if (code_is_mem != 0) {
        zue_mem_error_message(code, buf, 256)
    } else {
        zue_data_error_message(code, buf, 256)
    }
    checks += 1
    if (strcmp(buf, want) != 0) {
        failures += 1
        printf(cstr("[FAIL] %s: got \"%s\", want \"%s\"\n"), label, buf, want)
    }
}

# Unsafe_rt tests

func test_enter_block_rejects_nesting() {
    zue_mem_init()
    expect("begin", zue_mem_begin(), 0)
    expect("nested begin", zue_mem_begin(), 0)
    zue_mem_end()
    zue_mem_end()
    expect("begin after end", zue_mem_begin(), 0)
    zue_mem_end()
}

func test_alloc_tracking_and_poisoning() {
    zue_mem_init()
    zue_mem_track_alloc(100, 8)
    expect("deref", zue_mem_deref_ok(100), 0)
    expect("store", zue_mem_store_ok(107), 0)
    expect("deref past end", zue_mem_deref_ok(108), 13)
    expect("deref before", zue_mem_deref_ok(99), 13)
    expect("ptr_add 4", zue_mem_ptr_add_ok(100, 4, 0), 0)
    expect("ptr_add 8", zue_mem_ptr_add_ok(100, 8, 0), 3)
    expect("ptr_add -1", zue_mem_ptr_add_ok(100, -1, 0), 3)
    expect("ptr_add unknown", zue_mem_ptr_add_ok(101, 1, 0), 13)
    let out = stack_buf(8)
    st64(out, 7)
    expect("ptr_add result ok", zue_mem_ptr_add_ok(100, 5, out), 0)
    expect("ptr_add result", ld64(out), 105)
    st64(out, 7)
    expect("ptr_add result err", zue_mem_ptr_add_ok(100, 9, out), 3)
    expect("ptr_add result untouched", ld64(out), 7)
    expect("free", zue_mem_free_ok(100), 0)
    expect("deref after free", zue_mem_deref_ok(100), 4)
    expect("store after free", zue_mem_store_ok(100), 4)
    expect("ptr_add after free", zue_mem_ptr_add_ok(100, 1, 0), 4)
    expect("double free", zue_mem_free_ok(100), 4)
    expect("free unknown", zue_mem_free_ok(5), 13)
    expect("free interior", zue_mem_free_ok(101), 13)
    zue_mem_track_alloc(100, 16)
    expect("re-register revives", zue_mem_deref_ok(100), 0)
    expect("re-register size", zue_mem_ptr_add_ok(100, 15, 0), 0)
    zue_mem_init()
    expect("init clears", zue_mem_deref_ok(100), 13)
}

func test_compare_and_cast_rules() {
    zue_mem_init()
    zue_mem_track_alloc(100, 8)
    zue_mem_track_alloc(200, 8)
    expect("cmp same base", zue_mem_cmp_ok(100, 102, 2), 0)
    expect("cmp different base", zue_mem_cmp_ok(100, 200, 2), 9)
    expect("cmp eq different base", zue_mem_cmp_ok(100, 200, 0), 0)
    expect("cmp ne unregistered", zue_mem_cmp_ok(1, 2, 1), 0)
    expect("cmp unregistered a", zue_mem_cmp_ok(1, 100, 3), 13)
    expect("cmp unregistered b", zue_mem_cmp_ok(100, 1, 5), 13)
    expect("cast int", zue_mem_cast_ok(100, 0), 0)
    expect("cast other", zue_mem_cast_ok(100, 1), 10)
}

func test_defer_marks_freed() {
    zue_mem_init()
    zue_mem_track_alloc(100, 8)
    zue_mem_track_alloc(200, 8)
    zue_mem_defer(100)
    zue_mem_defer(300)
    zue_mem_defer(200)
    zue_mem_run_defers(0)
    expect("deferred 100", zue_mem_deref_ok(100), 4)
    expect("deferred 200", zue_mem_deref_ok(200), 4)
    zue_mem_track_alloc(400, 8)
    zue_mem_begin()
    zue_mem_defer(400)
    zue_mem_end()
    expect("end runs defers", zue_mem_deref_ok(400), 4)
    expect("end leaves the block", zue_mem_begin(), 0)
    zue_mem_end()
}

func test_nested_blocks_free_their_own_defers() {
    zue_mem_init()
    zue_mem_track_alloc(100, 8)
    zue_mem_track_alloc(200, 8)
    zue_mem_begin()
    zue_mem_defer(100)
    zue_mem_begin()
    zue_mem_defer(200)
    zue_mem_end()
    expect("inner end frees the inner pointer", zue_mem_deref_ok(200), 4)
    expect("inner end keeps the outer pointer", zue_mem_deref_ok(100), 0)
    zue_mem_end()
    expect("outer end frees the outer pointer", zue_mem_deref_ok(100), 4)
}

func test_addr_and_call_checks() {
    zue_mem_init()
    zue_mem_track_alloc(100, 8)
    expect("addr named", zue_mem_addr_ok(10, 1), 0)
    expect("addr pointer", zue_mem_addr_ok(100, 1), 1)
    expect("addr temporary", zue_mem_addr_ok(10, 0), 5)
    expect("alloc size 1", zue_mem_alloc_size_ok(1, 1), 0)
    expect("alloc size 0", zue_mem_alloc_size_ok(0, 1), 8)
    expect("alloc size -5", zue_mem_alloc_size_ok(-5, 1), 8)
    expect("alloc size float", zue_mem_alloc_size_ok(4, 0), 8)
    expect("escape", zue_mem_escape_ok(100), 2)
    expect("gc store", zue_mem_gc_store_ok(100), 7)
}

func test_many_allocations() {
    zue_mem_init()
    for (let i = 0; i < 5000; i++) {
        zue_mem_track_alloc(4096 + i * 32, 32)
    }
    let bad = 0
    for (let i = 0; i < 5000; i++) {
        if (zue_mem_deref_ok(4096 + i * 32 + 31) != 0) {
            bad += 1
        }
        if (zue_mem_ptr_add_ok(4096 + i * 32, 31, 0) != 0) {
            bad += 1
        }
        if (zue_mem_free_ok(4096 + i * 32) != 0) {
            bad += 1
        }
    }
    expect("5000 allocations", bad, 0)
    expect("5000 freed", zue_mem_deref_ok(4096 + 4999 * 32), 4)
}

func test_mem_messages() {
    expect_text("mem 0", 1, 0, "ok")
    expect_text("mem 1", 1, 1, "cannot take address_of() of a pointer value")
    expect_text("mem 2", 1, 2, "pointer cannot escape the current unsafe block")
    expect_text("mem 3", 1, 3, "ptr_add() moved outside the allocation bounds")
    expect_text("mem 4", 1, 4, "pointer was freed or freed twice")
    expect_text("mem 5", 1, 5, "address_of() only works on named values")
    expect_text("mem 7", 1, 7, "pointers cannot be stored inside GC-managed values")
    expect_text("mem 8", 1, 8, "alloc() size must be a positive integer")
    expect_text("mem 9", 1, 9, "ordered pointer comparisons need the same base allocation")
    expect_text("mem 10", 1, 10, "pointers may only be cast to int")
    expect_text("mem 12", 1, 12, "memory from alloc() was not freed before the unsafe block ended")
    expect_text("mem 13", 1, 13, "unsafe error: pointer is not registered in the runtime")
    expect_text("mem 14", 1, 14, "unsafe error: unknown runtime error")
    expect_text("mem -1", 1, -1, "unsafe error: unknown runtime error")
}

# Data_rt tests

func test_box_lifecycle() {
    zue_data_init()
    expect("size 32", zue_data_box_size_ok(32), 0)
    expect("size 1", zue_data_box_size_ok(1), 0)
    expect("size 4096", zue_data_box_size_ok(4096), 0)
    expect("size 0", zue_data_box_size_ok(0), 4)
    expect("size 4097", zue_data_box_size_ok(4097), 0)
    expect("size 16777216", zue_data_box_size_ok(16777216), 0)
    expect("size 16777217", zue_data_box_size_ok(16777217), 4)
    expect("size huge", zue_data_box_size_ok(-1), 4)

    expect("untracked access", zue_data_box_access_ok(42), 6)
    expect("untracked free", zue_data_box_free_ok(42), 6)
    zue_data_box_track(42)
    expect("access", zue_data_box_access_ok(42), 0)
    expect("free", zue_data_box_free_ok(42), 0)
    expect("access after free", zue_data_box_access_ok(42), 5)
    expect("double free", zue_data_box_free_ok(42), 5)
    zue_data_box_track(42)
    expect("track again", zue_data_box_access_ok(42), 0)
    zue_data_box_track(0)
    zue_data_box_track(4294967296 + 7)
    expect("handle 0", zue_data_box_access_ok(0), 0)
    expect("handle with generation", zue_data_box_access_ok(4294967296 + 7), 0)
    expect("other generation", zue_data_box_access_ok(8589934592 + 7), 6)
    zue_data_init()
    expect("init clears", zue_data_box_access_ok(42), 6)
}

func test_box_many_handles() {
    zue_data_init()
    for (let i = 0; i < 20000; i++) {
        zue_data_box_track(i * 4294967296 + (i % 4096) + 1)
    }
    let bad = 0
    for (let i = 0; i < 20000; i++) {
        if (zue_data_box_free_ok(i * 4294967296 + (i % 4096) + 1) != 0) {
            bad += 1
        }
    }
    expect("20000 handles", bad, 0)
    expect("20000 freed", zue_data_box_access_ok(19999 * 4294967296 + (19999 % 4096) + 1), 5)
}

func test_bloc_validate() {
    let f = stack_buf(128)
    st64(f, cstr("x"))
    st64(f + 8, cstr("y"))
    st64(f + 16, cstr("z"))
    st64(f + 24, cstr("w"))
    st64(f + 32, cstr("v"))
    st64(f + 40, cstr("u"))
    st64(f + 48, cstr("t"))
    st64(f + 56, cstr("s"))
    st64(f + 64, cstr("r"))
    expect("Vec2 fits", zue_data_bloc_validate(cstr("Vec2"), f, 2), 0)
    expect("four fields fit", zue_data_bloc_validate(cstr("Quad"), f, 4), 0)
    expect("five fields still fit", zue_data_bloc_validate(cstr("Wide"), f, 5), 0)
    expect("nine fields oversize", zue_data_bloc_validate(cstr("TooWide"), f, 9), 3)
    expect("no fields", zue_data_bloc_validate(cstr("Empty"), 0, 0), 0)
    expect("negative count", zue_data_bloc_validate(cstr("Neg"), f, -3), 0)
    expect("empty name", zue_data_bloc_validate(cstr(""), f, 2), 1)
    expect("blank name", zue_data_bloc_validate(cstr(" \t\n"), f, 2), 1)
    expect("null name", zue_data_bloc_validate(0, f, 2), 1)
    expect("unicode blank name", zue_data_bloc_validate(cstr("　  "), f, 2), 1)
    expect("name with spaces", zue_data_bloc_validate(cstr(" a "), f, 2), 0)
    st64(f + 8, cstr("x"))
    expect("duplicate field", zue_data_bloc_validate(cstr("Dup"), f, 2), 2)
    st64(f + 8, cstr("y"))
    st64(f + 32, cstr("x"))
    expect("duplicate before oversize", zue_data_bloc_validate(cstr("DupWide"), f, 5), 2)
    st64(f + 24, cstr("w"))
    st64(f + 32, cstr("v"))
    st64(f + 8, 0)
    expect("null field is skipped", zue_data_bloc_validate(cstr("Skip"), f, 5), 0)
    let b = stack_buf(8)
    st64(f + 8, raw(b, 255, 0, 0, 0))
    expect("invalid utf-8 field is skipped", zue_data_bloc_validate(cstr("Skip2"), f, 5), 0)
    expect("truncated utf-8 name", zue_data_bloc_validate(raw(b, 97, 195, 0, 0), f, 1), 1)
    expect("overlong utf-8 name", zue_data_bloc_validate(raw(b, 192, 128, 0, 0), f, 1), 1)
    expect("surrogate utf-8 name", zue_data_bloc_validate(raw(b, 237, 160, 128, 0), f, 1), 1)
    expect("too large utf-8 name", zue_data_bloc_validate(raw(b, 244, 144, 128, 128), f, 1), 1)
    expect("valid 2-byte name", zue_data_bloc_validate(raw(b, 195, 169, 0, 0), f, 1), 0)
    expect("valid 3-byte name", zue_data_bloc_validate(raw(b, 226, 130, 172, 0), f, 1), 0)
    expect("valid 4-byte name", zue_data_bloc_validate(raw(b, 240, 157, 132, 158), f, 1), 0)
    expect("next-line name", zue_data_bloc_validate(raw(b, 194, 133, 0, 0), f, 1), 1)
}

func test_template_register() {
    zue_data_init()
    let f = stack_buf(32)
    st64(f, cstr("name"))
    st64(f + 8, cstr("hp"))
    st64(f + 16, cstr("pos"))
    expect("register Player", zue_data_template_register(cstr("Player"), f, 3), 0)
    expect("register Player again", zue_data_template_register(cstr("Player"), f, 3), 0)
    st64(f + 8, cstr("name"))
    expect("duplicate field", zue_data_template_register(cstr("Bad"), f, 3), 8)
    expect("duplicate field, registered name", zue_data_template_register(cstr("Player"), f, 3), 8)
    expect("empty name", zue_data_template_register(cstr(""), f, 1), 7)
    expect("blank name", zue_data_template_register(cstr("   "), f, 1), 7)
    expect("null name", zue_data_template_register(0, f, 1), 7)
    expect("no fields", zue_data_template_register(cstr("Unit"), 0, 0), 0)
    st64(f, cstr("left"))
    st64(f + 8, cstr("right"))
    expect("register Pair", zue_data_template_register(cstr("Pair"), f, 2), 0)
    expect("Pair arity 2", zue_data_template_arity_ok(cstr("Pair"), 2), 0)
    expect("Pair arity 1", zue_data_template_arity_ok(cstr("Pair"), 1), 10)
    expect("Pair arity -1", zue_data_template_arity_ok(cstr("Pair"), -1), 10)
    expect("Unit arity 0", zue_data_template_arity_ok(cstr("Unit"), 0), 0)
    expect("Player arity 3", zue_data_template_arity_ok(cstr("Player"), 3), 0)
    expect("Player arity 2", zue_data_template_arity_ok(cstr("Player"), 2), 10)
    expect("unregistered arity", zue_data_template_arity_ok(cstr("Nope"), 5), 0)
    expect("null name arity", zue_data_template_arity_ok(0, 5), 7)
    expect("Pair field left", zue_data_template_field_ok(cstr("Pair"), cstr("left")), 0)
    expect("Pair field missing", zue_data_template_field_ok(cstr("Pair"), cstr("missing")), 11)
    expect("unregistered field", zue_data_template_field_ok(cstr("Nope"), cstr("x")), 0)
    expect("null field", zue_data_template_field_ok(cstr("Pair"), 0), 11)
    expect("null name field", zue_data_template_field_ok(0, cstr("left")), 7)
    zue_data_init()
    expect("init clears schemas", zue_data_template_arity_ok(cstr("Pair"), 1), 0)
}

func test_containment() {
    expect("template in template", zue_data_containment_ok(3, 3), 0)
    expect("bloc in template", zue_data_containment_ok(3, 1), 0)
    expect("box in template", zue_data_containment_ok(3, 2), 0)
    expect("box in bloc", zue_data_containment_ok(1, 2), 0)
    expect("template in bloc", zue_data_containment_ok(1, 3), 12)
    expect("bloc in bloc", zue_data_containment_ok(1, 1), 12)
    expect("bloc in box", zue_data_containment_ok(2, 1), 12)
    expect("box in box", zue_data_containment_ok(2, 2), 12)
    expect("template in box", zue_data_containment_ok(2, 3), 12)
    expect("unknown kinds", zue_data_containment_ok(0, 9), 12)
}

func test_data_messages() {
    expect_text("data 0", 0, 0, "ok")
    expect_text("data 1", 0, 1, "bloc name cannot be empty")
    expect_text("data 2", 0, 2, "bloc has duplicate field names")
    expect_text("data 3", 0, 3, "bloc exceeds the cache-line size limit (64 bytes)")
    expect_text("data 4", 0, 4, "box size must be between 1 and 16777216 bytes")
    expect_text("data 5", 0, 5, "box was already freed (use-after-free)")
    expect_text("data 6", 0, 6, "box is not live")
    expect_text("data 7", 0, 7, "template name cannot be empty")
    expect_text("data 8", 0, 8, "template has duplicate field names")
    expect_text("data 9", 0, 9, "template with this name is already registered")
    expect_text("data 10", 0, 10, "template constructor argument count does not match field count")
    expect_text("data 11", 0, 11, "template does not have a field with that name")
    expect_text("data 12", 0, 12, "containment hierarchy violation: type cannot be stored inside this tier")
    expect_text("data 13", 0, 13, "unknown data runtime error")
    expect_text("data -1", 0, -1, "unknown data runtime error")

    # The message is cut to buf_len - 1 bytes and always NUL-terminated.
    let small = stack_buf(16)
    st64(small, 0)
    zue_data_error_message(3, small, 8)
    expect("cut text", strcmp(small, cstr("bloc ex")), 0)
    zue_data_error_message(1, small, 1)
    expect("cut to nothing", ld8(small), 0)
    st8(small, 65)
    zue_data_error_message(1, small, 0)
    expect("zero length leaves buffer", ld8(small), 65)
    zue_mem_error_message(2, 0, 8)
    zue_data_error_message(2, 0, 8)
}

func main(argc_i, argv_p) {
    test_enter_block_rejects_nesting()
    test_alloc_tracking_and_poisoning()
    test_compare_and_cast_rules()
    test_defer_marks_freed()
    test_nested_blocks_free_their_own_defers()
    test_addr_and_call_checks()
    test_many_allocations()
    test_mem_messages()
    test_box_lifecycle()
    test_box_many_handles()
    test_bloc_validate()
    test_template_register()
    test_containment()
    test_data_messages()
    if (failures != 0) {
        printf(cstr("[ERROR] %ld of %ld checks failed\n"), failures, checks)
        return 1
    }
    printf(cstr("[OK] %ld checks passed\n"), checks)
    return 0
}
