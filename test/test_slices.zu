// s[a:b]: positions count from 0 like indexes and both ends are included. Works on strings and lists.

# CASE strings
let s = "bug"
print(s[0:2])
print(s[0:0])
print(s[2:2])
print(s[1:2])
print(s[0:1])
print("hello world"[6:10])
# CASE open ends
let s = "bug"
print(s[:1])
print(s[1:])
print(s[:])
print(s[:2])
print(s[2:])

# CASE lists
let l = [10, 20, 30, 40]
print(l[1:2])
print(l[:1])
print(l[2:])
print(l[:])
print(l[0:3])
let words = ["a", "b", "c"]
print(words[1:2])
# CASE bounds are expressions
# test: no-strict
let s = "abcdef"
let n = 2
print(s[n:n + 2])
print(s[n * 2:len(s) - 1])
func first(t, k: int) {
    return t[0:k]
}
print(first("hello", 3))
print(first([1, 2, 3], 1))
# CASE slice of a slice and of a call result
func upper(t: string) {
    return to_upper(t)
}
let s = "abcdef"
print(s[1:4][1:2])
print(upper("abc")[0:1])
# CASE the result is a copy for lists
let a = [1, 2, 3]
let b = a[0:2]
append(b, 4)
print(a)
print(b)
# CASE slice inside interpolation
let s = "bug"
print("first two: {s[0:1]}, last: {s[2:2]}")
# CASE empty string and empty list
let e = ""
print(e[:])
let el = []
print(el[:])
# CASE end past the end
let s = "bug"
print(s[0:3])
# CASE start after end
let s = "bug"
print(s[2:1])
# CASE negative position
let s = "bug"
print(s[-1:1])
# CASE list out of bounds
let l = [1, 2, 3]
print(l[1:9])
# CASE position must be an int at run time
func pass(v: string) {
    return [v, null][0]
}
let s = "bug"
print(s[pass("1"):1])
# test: no-strict
# CASE end must be an int at run time
func pass(v: float) {
    return [v, null][0]
}
let s = "bug"
print(s[0:pass(2.0)])
# test: no-strict
# CASE value that cannot be sliced at run time
func pass(v: int) {
    return [v, null][0]
}
print(pass(5)[0:1])
# test: no-strict
# CASE float position is a compile error
let s = "bug"
print(s[1.5:1])
# CASE slicing an int is a compile error
let n = 5
print(n[0:1])
# CASE missing close bracket
let s = "bug"
print(s[0:1
# CASE slice is not assignable
let s = "bug"
s[0:1] = "x"
# CASE the slice builtin matches the slice syntax
let s = "abcdef"
let l = [10, 20, 30, 40]
print(slice(s, 1, 3))
print(slice(s, 0, 5))
print(slice(l, 1, 2))
print(slice(l, 3, 3))
print(slice(s, 1, 3) == s[1:3])
# CASE the slice builtin stays within the text
func pass(v: int) { return [v, null][0] }
print(slice("abc", pass(-1), 1))
# test: no-strict
# CASE the slice builtin does not take an end before its start
func pass(v: int) { return [v, null][0] }
print(slice([1, 2, 3], pass(2), 1))
# test: no-strict
# CASE the slice builtin needs ints
func pass(v: string) { return [v, null][0] }
print(slice("abc", pass("1"), 1))
# test: no-strict
# CASE the whole-list slice is a copy too
let a = [1, 2, 3]
let b = a[:]
append(b, 4)
b = reverse(b)
print(a)
print(b)
let e = []
let f = e[:]
append(f, 1)
print(e)
print(f)
