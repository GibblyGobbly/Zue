# CASE a bloc with float fields
bloc Vec { x: float, y: float }
let v = Vec{1.5, 2.5}
print(v.x + v.y)
print(v == Vec{1.5, 2.5})
# CASE whole-number literals become floats for float fields
bloc Vec { x: float, y: float }
let v = Vec{1, 2}
print(v.x)
print(v.x + v.y)
# CASE a variable holding an int is not a float
bloc Vec { x: float, y: float }
let n = 3
let v = Vec{n, 2}
# CASE a string given to a float field
bloc Vec { x: float, y: float }
let v = Vec{1.0, "a"}
# CASE bloc with the wrong number of values
bloc Vec { x: float, y: float }
let v = Vec{1.0}
# CASE a bloc stays immutable
bloc Vec { x: float, y: float }
let v = Vec{1.0, 2.0}
v.x = 5.0
# CASE nested blocs and strings
bloc Inner { a: int }
bloc Outer { i: Inner, tag: string }
let o = Outer{Inner{3}, "x"}
print(o.i.a)
print(o.tag)
print(o == Outer{Inner{3}, "x"})
print(o == Outer{Inner{4}, "x"})
# CASE the wrong nested bloc
bloc Inner { a: int }
bloc Other { a: int }
bloc Outer { i: Inner }
func pass(v) {
    return [v, null][0]
}
let o = Outer{pass(Other{1})}
# test: no-strict
# CASE a bloc cannot hold a template
template T { a: int }
bloc B { t: T }
# CASE a bloc cannot hold a list
bloc B { items: list }
# CASE a bloc cannot hold a map
bloc B { m: map }
# CASE a bloc that is too big
bloc Big { a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int, i: int }
# CASE a bloc of exactly 64 bytes
bloc Fits { a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int }
let f = Fits{1, 2, 3, 4, 5, 6, 7, 8}
print(f.h)
# CASE a bloc with only some fields typed
bloc Half { a: int, b }
# CASE a box inside a bloc is a copy
bloc Packet { id: int, payload: box[8] }
let b = box[8]
b[0] = 5
let p = Packet{1, b}
b[0] = 99
print(p.payload[0])
print(b[0])
print(p.payload.len)
# CASE the box inside a bloc cannot be changed
bloc Packet { id: int, payload: box[8] }
let p = Packet{1, box[8]}
p.payload[0] = 7
# CASE a box of the wrong size
bloc Packet { id: int, payload: box[8] }
let p = Packet{1, box[4]}
# CASE blocs with equal boxes are equal
bloc Packet { payload: box[2] }
let a = box[2]
let b = box[2]
a[0] = 1
b[0] = 1
print(Packet{a} == Packet{b})
b[1] = 9
print(Packet{a} == Packet{b})
# CASE a bloc with a box and other fields
bloc Frame { id: int, flags: box[4], scale: float }
let flags = box[4]
flags[3] = 200
let fr = Frame{7, flags, 2}
print(fr.flags[3])
print(fr.scale)
# CASE a template with typed fields
template Player { name: string, hp: int, pos: list }
let p = Player("Astra", 100, [0, 0])
p.hp = 80
print(p.hp)
print(p.name)
# CASE a template field assigned the wrong type
template Player { name: string, hp: int }
func pass(v) {
    return [v, null][0]
}
let p = Player("Astra", 100)
p.hp = pass("dead")
# test: no-strict
# CASE a template built with the wrong type
template Player { name: string, hp: int }
let p = Player("Astra", 1.5)
# CASE a template holds a bloc and a box
bloc V { x: float, y: float }
template Body { pos: V, bytes: box[4] }
func make() {
    let b = box[4]
    b[0] = 3
    return Body(V{1, 2}, b)
}
let body = make()
print(body.pos.y)
print(body.bytes[0])
body.bytes[0] = 4
print(body.bytes[0])
# CASE a template field typed with a bloc gets another type
bloc V { x: float, y: float }
template Body { pos: V }
func pass(v) {
    return [v, null][0]
}
let b = Body(pass(5))
# test: no-strict
# CASE a template may hold another template
template Inner { n: int }
template Outer { inner: Inner, name: string }
let o = Outer(Inner(4), "o")
print(o.inner.n)
o.inner.n = 5
print(o.inner.n)
# CASE a template field typed as a function
template Handler { name: string, run: function }
let h = Handler("double", func(x: int) { return x * 2 })
print(h.run(4))
# CASE a typed template mixed with untyped fields
template Mixed { id: int, extra }
let m = Mixed(1, "anything")
func pass(v) {
    return [v, null][0]
}
m.extra = "more"
print(m.extra)
m.id = pass("no")
# test: no-strict
# CASE data cannot have field types
data D { a: int }
# CASE an unknown type name on a template field
template Holder { thing: Missing }
let h = Holder(1)
# CASE templates declared in the unparsed program keep their types
template Pair { left: int, right: float }
let p = Pair(1, 2)
print(p.right)

# CASE a field without a type takes the type of the value the template is made with
template Stack { items }
let a = Stack([1, 2])
let b = Stack(["x"])
append(a.items, 3)
append(b.items, "y")
print(a.items, b.items)
print(a.items[0] + 1)

# CASE storing another type in such a field is found when the program is built
template Stack { items }
let a = Stack([1, 2])
append(a.items, "y")

# CASE assigning another type to such a field is found when the program is built
template Pair { a, b }
let p = Pair(1, "one")
p.a = 2
p.b = "two"
print(p.a, p.b)
p.a = "three"

# CASE one function works for templates made with different types
template Pair { a, b }
func first(p) {
    return p.a
}
print(first(Pair(2, 0)) + 1)
print(first(Pair("t", 0)) + "u")
print(first(Pair(1.5, 0)) * 2.0)

# CASE a variable keeps the field types of its first value
template Box { v }
let x = Box(1)
x = Box(2)
print(x.v)
x = Box("s")


# CASE a typed template field may be empty
template Node { k: string, l: Node, r: Node }
let leaf = Node("id", null, null)
let both = Node("bin", leaf, leaf)
let one = Node("not", both, null)
let n = leaf
n = both
n = one
print(n.l.l.k)
print(n.r == null)
one.l = null
print(one.l == null)

# CASE an empty field is missing for else
template Node { k: string, l: Node }
let leaf = Node("id", null)
let left = leaf.l else {
    print("no left child")
    exit(0)
}
print(left.k)

# CASE using an empty field is an error when the program runs
template Node { k: string, l: Node }
func pass(v) {
    return [v, null][0]
}
let leaf = pass(Node("id", null))
print(leaf.l.k)
# test: no-strict

# CASE a bloc field may not be empty
bloc P { x: int, y: int }
let p = P{1, null}
# CASE a variable, a list item and an argument of a template type may be empty
template Link { v: int, next: Link }
func total(l: Link) {
    if (l == null) {
        return 0
    }
    return l.v + total(l.next)
}
let mut_l = Link(1, Link(2, null))
print(total(mut_l))
mut_l = null
print(total(null))
let links: list<Link> = []
append(links, null)
append(links, Link(3, null))
links[0] = Link(4, null)
print(total(links[0]) + total(links[1]))
# CASE a variable or list of ints or strings may not be emptied
let n = 5
n = null
let names: list<string> = []
append(names, null)
# CASE a bloc made with ints and one made with floats are not compared
bloc V { x, y }
print(V{1, 2} == V{1.0, 2.0})
