// sort (insertion plus merge; non-negative ints from 256 items up use a radix sort) and ssort.

# CASE small lists
let a = [3, 1, 2]
sort(a)
print(a)
let e = []
sort(e)
print(e)
let one = [7]
sort(one)
print(one)
let d = [5, 5, 1, 1, 3]
sort(d)
print(d)
# CASE negative and mixed sign ints
let a = [3, -1, 0, -7, 12, 5, -1]
sort(a)
print(a)
# CASE floats
let f = [2.5, -1.5, 0.0, 10.25]
sort(f)
print(f)
# CASE ints mixed with floats have no order
func pass(v) {
    return [v, null][0]
}
let m = pass([3, 1.5, 2, 0.5])
sort(m)
print(m)
# CASE strings and chars
let s = ["pear", "apple", "fig", "banana", "Apple", ""]
sort(s)
print(s)
let c = ['b', 'a', 'c']
sort(c)
print(c)
# CASE radix sizes around the cutoff
func ordered(l) {
    for (let i = 1; i < len(l); i++) {
        if (l[i - 1] > l[i]) {
            return false
        }
    }
    return true
}

func floats_of(l) {
    let f = []
    for (let i = 0; i < len(l); i++) {
        append(f, to_float(l[i]))
    }
    return f
}

# Sorts the ints and the same values as floats (a different path) and compares the two results.
func agrees(l) {
    let f = floats_of(l)
    sort(l)
    sort(f)
    return ordered(l) and len(l) == len(f) and ordered(f) and sum_matches(l, f)
}

func sum_matches(l, f) {
    for (let i = 0; i < len(l); i++) {
        if (to_float(l[i]) != f[i]) {
            return false
        }
    }
    return true
}

func random_ints(n, hi) {
    let l = []
    for (let i = 0; i < n; i++) {
        append(l, rand(0, hi))
    }
    return l
}
srand(11)
print(agrees(random_ints(255, 1000000)))
print(agrees(random_ints(256, 1000000)))
print(agrees(random_ints(257, 1000000)))
print(agrees(random_ints(1000, 1000000)))
print(agrees(random_ints(100000, 1000000000)))
