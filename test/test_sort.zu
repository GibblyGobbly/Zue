func agrees(l) {
    let f = floats_of(l)
    sort(l)
    sort(f)
    return ordered(l) and len(l) == len(f) and ordered(f) and sum_matches(l, f)
}

func sum_matches(l, f) {
    for (let i = 0; i < len(l); i++) {
        if (to_float(l[i]) != f[i]) {
            return false
        }
    }
    return true
}

func random_ints(n, hi) {
    let l = []
    for (let i = 0; i < n; i++) {
        append(l, rand(0, hi))
    }
    return l
}
