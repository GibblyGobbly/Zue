func random_ints(n, hi) {
    let l = []
    for (let i = 0; i < n; i++) {
        append(l, rand(0, hi))
    }
    return l
}
let z = []
let up = []
let down = []
for (let i = 0; i < 400; i++) {
    append(z, 0)
    append(up, i * 3)
    append(down, 1200 - i * 3)
}
sort(z)
print(z[0] == 0 and z[399] == 0 and len(z) == 400)
sort(up)
print(ordered(up) and up[0] == 0 and up[399] == 1197)
sort(down)
print(ordered(down) and down[0] == 3 and down[399] == 1200)
let same = []
for (let i = 0; i < 400; i++) {
    append(same, 77)
}
sort(same)
print(same[0] == 77 and same[399] == 77)
