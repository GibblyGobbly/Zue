sort(l)
let first = l[0]
let last = l[999]
sort(l)
print(first == l[0] and last == l[999] and ordered(l))
# CASE ssort keeps a rising run
let a = [1, 5, 2, 7, 3, 9]
ssort(a)
print(a)
let b = [4, 4, 3, 5]
ssort(b)
print(b)
let c = [9, 1, 2]
ssort(c)
print(c)
let e = []
ssort(e)
print(e)
let s = ["b", "a", "c", "d", "a"]
ssort(s)
print(s)
# CASE ssort on a dense list
let d = dense_list(4, 0.0)
d[0] = 1.0
d[1] = 3.0
d[2] = 2.0
d[3] = 4.0
ssort(d)
print(len(d))
# CASE sort of a mix of numbers and strings
func pass(v) {
    return [v, null][0]
}
let l = pass([3, "a", 1])
sort(l)
# CASE sort of a long mix of ints and a string
func pass(v) {
    return [v, null][0]
}
let l = []
for (let i = 0; i < 400; i++) {
    append(l, i)
}
append(l, "x")
sort(pass(l))
# CASE sort of booleans
func pass(v) {
    return [v, null][0]
}
let l = pass([true, false])
sort(l)
# CASE sort of a number
func pass(v) {
    return [v, null][0]
}
sort(pass(5))
# CASE sort with two arguments
func pass(v) {
    return [v, null][0]
}
sort(pass([1]), [2])
# CASE sort with no argument
func pass(v) {
    return [v, null][0]
}
sort()
# CASE ssort of a string
func pass(v) {
    return [v, null][0]
}
ssort(pass("abc"))
# CASE ssort with two arguments
func pass(v) {
    return [v, null][0]
}
ssort(pass([1]), [2])
# CASE ssort of mixed items
func pass(v) {
    return [v, null][0]
}
let l = pass([1, "a"])
ssort(l)
