#
# Types cross files: the result of an imported function, an imported template and an imported variable
# are known where they are used, and an untyped parameter takes the type of each call.

use { area, twice, Size, UNIT } from "fixtures/typed_shapes.zu"

let a = area(2.0, 3.0)
print(a + 0.5)
print(twice(4) + 1)
print(twice("ab") + "!")
let s = Size(2.0, 4.0)
print(area(s.w, s.h))
print(UNIT * 2.0)
