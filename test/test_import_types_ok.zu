# Types cross files: the result of an imported function, an imported template and an imported variable
# are known where they are used.

use { area, twice, Size, UNIT, corner_of } from "fixtures/typed_shapes.zu"

let a = area(2.0, 3.0)
print(a + 0.5)
print(twice(4) + 1)
let s = Size(2.0, 4.0)
print(area(s.w, s.h))
print(UNIT * 2.0)
let c = corner_of(s)
print(c.at.w + c.at.h)
print(c.next == null)
