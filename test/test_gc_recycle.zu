# After a sweep, the free slots of a page are the zero bytes of its used map, and the allocator hands them out
# again. An object put into such a slot must stay visible to the collector. These cases replace live objects
# over many rounds, so that the objects that survive sit in recycled slots, and check every one at the end.
# CASE objects in recycled slots survive later collections
let live = []
for (let i = 0; i < 20000; i++) {
    append(live, ["a", i, "x{i}"])
}
let junk = 0
for (let round = 0; round < 40; round++) {
    for (let k = 0; k < 30000; k++) {
        let g = [k, k, k, k]
        junk += len(g)
    }
    for (let i = round % 7; i < 20000; i += 7) {
        live[i] = ["a", i, "x{i}"]
    }
}
let bad = 0
for (let i = 0; i < 20000; i++) {
    let r = live[i]
    if (len(r) != 3 or r[0] as string != "a" or r[1] as int != i or r[2] as string != "x{i}") {
        bad += 1
    }
}
print("bad {bad} junk {junk}")
# CASE strings and lists of different sizes share recycled pages
let keep = []
let total = 0
for (let round = 0; round < 30; round++) {
    for (let k = 0; k < 20000; k++) {
        let s = "g{k}-{round}"
        total += len(s)
    }
    for (let i = 0; i < 300; i++) {
        append(keep, "keep{round}-{i}")
        append(keep, [round, i, "n{i}"])
    }
}
let bad = 0
let at = 0
for (let round = 0; round < 30; round++) {
    for (let i = 0; i < 300; i++) {
        if (keep[at] as string != "keep{round}-{i}") {
            bad += 1
        }
        let r: list = keep[at + 1]
        if (r[0] as int != round or r[1] as int != i or r[2] as string != "n{i}") {
            bad += 1
        }
        at += 2
    }
}
print("kept {len(keep)} bad {bad} total {total}")
# CASE a heap of constant size does not grow while the program keeps allocating
func peak_kib() {
    let f = open("/proc/self/status", "r")
    let text = read(f)
    close(f)
    for (let line in split(text, "\n")) {
        if (starts_with(line, "VmHWM:")) {
            return int(split(trim(substring(line, 6, len(line))), " ")[0])
        }
    }
    return 0
}
func churn(n) {
    let sum = 0
    for (let i = 0; i < n; i++) {
        let tmp = [i, i + 1, i + 2, i + 3]
        let s = "k{i}"
        sum += tmp[0] % 7 + len(s)
    }
    return sum
}
let live = []
for (let i = 0; i < 80000; i++) {
    append(live, [i, i + 1, i + 2, i + 3, i + 4, i + 5, i + 6, i + 7])
}
churn(16000000)
let early = peak_kib()
churn(48000000)
let late = peak_kib()
print("peak grew by more than a third: {late > early * 4 / 3 + 10240}")
print("live data intact: {len(live[79999])}")
