# Holes in the type checker found when phases 1 to 4 were checked again (F1 to F11).
# CASE a nested function is checked for the captured types of each call of its parent
func outer(a) {
    func inner() {
        return a
    }
    return inner()
}
let r = outer(2)
let q = outer(2.5)
print(r + 1, q + 1.5)
# CASE a nested function given a wrong captured type is an error
func outer(a) {
    func inner(b) {
        return a + b
    }
    return inner(1)
}
print(outer(2))
print(outer("s"))
# CASE the default value of a typed parameter must have its type
func f(b: list<int> = ["a"]) {
    return b
}
print(f())
# CASE a whole-number default of a float parameter is a float
func f(b: float = 2) {
    return b * 1.5
}
func g(n: int = 3) -> int {
    return n * 2
}
template P { x: int }
func h(p: P = null) {
    return p
}
print(f(), g(), h())
# CASE a value of unknown type stored in a typed list needs as
let person = ["Ann", 30]
let xs: list<int> = [1, 2]
xs[0] = person[0]
# CASE a value of unknown type appended to a typed list needs as
let person = ["Ann", 30]
let xs: list<int> = [1, 2]
append(xs, person[1])
# CASE a value of unknown type stored in a typed map needs as
let person = ["Ann", 30]
let m: map<int> = {"a": 1}
m["b"] = person[1]
# CASE a value converted with as goes into a typed list
let person = ["Ann", 30]
let xs: list<int> = [1, 2]
xs[0] = person[1] as int
append(xs, person[1] as int)
print(xs)
# CASE a typed list literal cannot hold null
let xs: list<int> = [1, null]
# CASE a typed list literal cannot hold an item of another type
let xs: list<int> = [1, "a"]
# CASE whole numbers in a typed float list or map literal are floats
let ys: list<float> = [1.5, 2]
let m: map<float> = {"a": 1.5, "b": 2}
let zz: list<list<int>> = [[1], [2, 3]]
print(ys, m, zz)
# CASE a whole-number literal next to a float in ** is a float
let f = 1.5
print(f ** 2, 2 ** f, 2 ** 3)
func p(x) {
    return x ** 2
}
print(p(1.5), p(3))
# CASE a switch whose cases and default all return counts as returning
func g(n: int) -> int {
    switch (n) {
        case 1:
            return 1
        default:
            return 2
    }
}
func h(n) {
    switch (n) {
        case 1:
            return 10
        default:
            return 20
    }
}
print(g(1) + 1, g(5) + 1, h(1) + 1)
# CASE a switch with a break does not count as returning
func k(n: int) -> int {
    switch (n) {
        case 1:
            if (n > 0) {
                break
            }
            return 1
        default:
            return 2
    }
}
print(k(1))
# CASE assert needs a bool
let n = 1
assert(n == 1)
assert(n)
# CASE a builtin's argument of the wrong type is an error when the program is built
print("start")
print(len(2.5))
# CASE a builtin given the wrong number of arguments is an error when the program is built
print("start")
print(trim())
# CASE a builtin's argument of unknown type is an error
let person = ["Ann", 30]
print(to_upper(person[0]))
# CASE builtins take the argument types they are made for
let s = "a,b"
let parts = split(s, ',')
print(len(parts), to_upper('x'), pad_left("7", 3, '0'), is_digit('5'), contains("abc", 'b'))
print(dense_list(2, 1), len(reverse([])), input("") == "")
template T { a: int, b: int }
print(len(T(1, 2)))
# CASE a named function with untyped parameters used as a value is an error
func add(a, b) {
    return a + b
}
let h = add
# CASE a named function given to map is checked for the items of the list
func dbl(x) {
    return x * 2
}
print(map(["a"], dbl))
# CASE a named function given to spawn is checked for the arguments
func work(a: int) {
    return a + 1
}
let t = spawn(work, "s")
# CASE named functions given to map, filter, reduce and spawn
func dbl(x) {
    return x * 2
}
func even(x) {
    return x % 2 == 0
}
func plus(acc, x) {
    return acc + x
}
func work(a) {
    return a + 1
}
let xs = [1, 2, 3]
print(map(xs, dbl), filter(xs, even), reduce(xs, plus, 0))
let r: int = wait(spawn(work, 41))
func g(x: string) {
    return x
}
let k = g
print(r, k("ok"))
