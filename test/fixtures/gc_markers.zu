# Builds a live heap, churns it through many collections and prints a checksum of what stayed live. The output is
# the same for any number of marking threads (test_cli runs it with ZUE_RT_GC_MARKERS=1, 3 and 8).
let live = []
for (let i = 0; i < 200000; i++) {
    append(live, [i, [i * 2, "item"], {"k": i}])
}
for (let round = 0; round < 200; round++) {
    let junk = []
    for (let i = 0; i < 20000; i++) {
        append(junk, [round, i, [i, i]])
    }
    live[round * 1000] = [round, [round * 2, "new"], {"k": round}]
}
let sum = 0
for (let row in live) {
    let pair: list = row[1]
    let m: map<int> = row[2]
    sum = sum + row[0] as int + pair[0] as int + m["k"]
}
print(sum)
