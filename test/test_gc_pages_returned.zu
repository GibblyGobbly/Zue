# Empty pages go back to the OS: after a large structure is dropped and the collector has run, the
# resident memory of the process falls well below its peak. Reads VmRSS and VmHWM from /proc.

func status_kib(name) {
    let f = open("/proc/self/status", "r")
    let text = read(f)
    close(f)
    for (let line in split(text, "\n")) {
        if (starts_with(line, name)) {
            let parts = split(trim(substring(line, len(name), len(line))), " ")
            return to_int(parts[0])
        }
    }
    print("no {name} line")
    exit(1)
}

func build_and_drop() {
    let big = []
    for (let i = 0; i < 1500000; i++) {
        let row = []
        for (let j = 0; j < 8; j++) {
            append(row, i + j)
        }
        append(big, row)
    }
    return len(big)
}

build_and_drop()

# Garbage in small pieces makes the collector run a few cycles, which sweep the dropped rows.
let total = 0
for (let i = 0; i < 3000000; i++) {
    let tmp = [i, i + 1]
    total += tmp[1] - tmp[0]
}
let peak_kib = status_kib("VmHWM:")
let now_kib = status_kib("VmRSS:")
print("garbage loop done {total}")
print("peak over 200 MiB: {peak_kib > 204800}")
print("resident memory under half of the peak: {now_kib * 2 < peak_kib}")
