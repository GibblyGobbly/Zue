// Lexer edge cases around the scanning fast paths: string bodies, interpolation, numbers with
// underscores, comments at the end of the file, and the errors the lexer reports.

# CASE braces and interpolation in strings
let x = 7
print("{}" + "a{}b" + "\{x\}" + "[{x}]" + "{x}{x}")
print("multi
line {x + 1}
end")
print("quote \" and {"inner"} and \\ backslash")
# CASE numbers with underscores
print(1_000 + 2_0)
print(1_0.5_0)
print(0xff_ff)
print(1e3)
print(2.5e-1)
# CASE comments
let a = 1 // trailing
let b = 2 # trailing
print(a + b) # last line without a newline
# CASE unterminated string
let a = "never closed
# CASE unterminated interpolation
let a = "x{1 +
# CASE number followed by a letter
let n = 12abc
# CASE double underscore in a number
let n = 1__0
# CASE underscore at the end of a number
let n = 10_
# CASE non-ASCII outside a string
let a = 1 é
# CASE unexpected character
let a = $
