# CASE R1 address_of a pointer
unsafe {
    let a = alloc(1)
    defer(a)
    let b = address_of(a)
}
# CASE R2 pointer assigned to a global
let g = null
unsafe {
    let a = alloc(1)
    defer(a)
    g = a
}
# CASE R2 pointer assigned to an outer local variable
func keep_outside() {
    let outer = null
    unsafe {
        let a = alloc(1)
        defer(a)
        outer = a
    }
    return 0
}
keep_outside()
# CASE R2 pointer returned from the block
func return_inside() {
    unsafe {
        let a = alloc(1)
        defer(a)
        return a
    }
}
return_inside()
# CASE R2 pointer stored in a list
unsafe {
    let a = alloc(1)
    defer(a)
    let l = [a]
}
# CASE R2 pointer stored in a map
unsafe {
    let a = alloc(1)
    defer(a)
    let m = {"k": a}
}
# CASE R3 ptr_offset out of bounds
unsafe {
    let a = alloc(1)
    defer(a)
    let b = ptr_offset(a, 1)
}
# CASE R4 use after free
unsafe {
    let a = alloc(1)
    free(a)
    print(load(a))
}
# CASE R4 double free
unsafe {
    let a = alloc(1)
    free(a)
    free(a)
}
# CASE R5 address_of a temporary
unsafe {
    let p = address_of(1 + 2)
}
# CASE R5 address_of outside unsafe
let p = address_of(1 + 2)
# CASE R7 invalid alloc size
unsafe {
    let a = alloc(0)
}
# CASE R8 compare pointers from different allocations
unsafe {
    let a = alloc(1)
    let b = alloc(1)
    defer(a)
    defer(b)
    let bad = a < b
}
# CASE R9 invalid pointer cast
unsafe {
    let a = alloc(1)
    defer(a)
    let f = float(a)
}
# CASE R10 alloc never freed
unsafe {
    let a = alloc(1)
    store(a, 5)
}
# CASE R10 several allocs never freed
unsafe {
    let a = alloc(1)
    let b = alloc(2)
    let c = alloc(3)
    free(b)
}
# CASE R6 unsafe block inside an unsafe block
unsafe {
    let outer = alloc(1)
    defer(outer)
    unsafe {
        let inner = alloc(1)
        defer(inner)
    }
}
# CASE R10 leak in a function called from an unsafe block
func wrapper() {
    unsafe {
        let inner = alloc(1)
    }
}
unsafe {
    let outer = alloc(1)
    defer(outer)
    wrapper()
}
# CASE R10 alloc inside a called function
func make_leak() {
    unsafe {
        let a = alloc(1)
    }
}
make_leak()
# CASE box inside unsafe
unsafe {
    let b = box[8]
}
# CASE box returned from a function
func mk() {
    let x = box[4]
    return x
}
let r = mk()
# CASE box stored in a list
let b = box[4]
let l = [b]
# CASE box stored in a map
let b = box[4]
let m = {"k": b}
# CASE box appended to a list
let b = box[4]
let l = []
append(l, b)
# CASE box assigned to a global from a function
let g = null
func leak() {
    let y = box[2]
    g = y
}
leak()
# CASE box use after free
let b = box[4]
free(b)
print(b.len)
# CASE box double free
let b = box[4]
free(b)
free(b)
# CASE box index out of bounds
let b = box[2]
b[2] = 1
# CASE box byte out of range
let b = box[2]
b[0] = 256
# CASE box size too large
let b = box[16777217]
# CASE bloc is immutable
bloc P { x, y }
let p = P{1, 2}
p.x = 5
# CASE bloc unknown field
bloc P { x, y }
let p = P{1, 2}
print(p.z)
# CASE bloc field must be a primitive
bloc Tag { name }
let t = Tag{"hello"}
# CASE bloc wrong arity
bloc P { x, y }
let p = P{1}
# CASE bloc duplicate field
bloc B { x, x }
# CASE bloc oversize
bloc B { a, b, c, d, e, f, g, h, i }
# CASE bloc redefined with different fields in the same scope
bloc W { x }
bloc W { y }
# CASE template unknown field read
template T { x, y }
let t = T(1, 2)
print(t.z)
# CASE template unknown field write
template T { x, y }
let t = T(1, 2)
t.z = 3
# CASE template redefined with different fields in the same scope
template A { x }
template A { y }
# CASE template wrong arity
template Pair { left, right }
let p = Pair(42)
# CASE list write out of bounds
let l = [1, 2, 3]
l[5] = 1
