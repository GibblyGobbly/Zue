//
// Ints and floats never mix at run time either: an operator, a comparison or a float builtin given an int
// and a float is a Type Error, also when the checker could not see the types. A number written in the
// source still adapts, at compile time or, when its context is not known then, at run time.

# CASE adding a hidden int and float
func pass(v) {
    return [v, null][0]
}
print(pass(1.0) + pass(1))
# CASE remainder of a hidden int and float
func pass(v) {
    return [v, null][0]
}
print(pass(7) % pass(2.0))
# CASE comparing a hidden int and float
func pass(v) {
    return [v, null][0]
}
print(pass(9007199254740993) == pass(9007199254740992.0))
# CASE ordering a hidden int and float
func pass(v) {
    return [v, null][0]
}
print(pass(1) < pass(2.0))
# CASE sqrt of a hidden int
func pass(v) {
    return [v, null][0]
}
print(sqrt(pass(4)))
# CASE floor of a hidden int
func pass(v) {
    return [v, null][0]
}
print(floor(pass(4)))
# CASE pow of a hidden int and float
func pass(v) {
    return [v, null][0]
}
print(pow(pass(2), pass(0.5)))
# CASE clamp needs one number type
func pass(v) {
    return [v, null][0]
}
print(clamp(pass(5), pass(1.0), pass(10)))
# CASE clamp with floats
func pass(v) {
    return [v, null][0]
}
print(clamp(pass(5.0), pass(1.0), pass(2.5)))
# CASE literals next to hidden values take their type at run time
func pass(v) {
    return [v, null][0]
}
let f = pass(2.5)
let i = pass(4)
print(f + 1, 1 + f, f * 2, f / 2, f - 1, f % 2, f < 3, f == 2.5, 3 > f)
print(i + 1, i * 2, i / 2, i % 3, i < 3, i == 4)
# CASE divmod and floor_div of floats agree with mod
print(divmod(1.0, 0.1))
print(floor_div(1.0, 0.1), mod(1.0, 0.1))
print(divmod(-7.5, 2.0))
# CASE the remainder stays below the divisor
print(mod(-1e-300, 1e300) < 1e300)
# CASE sums and means whose partial sums overflow
print(sum([1e308, 1e308, -1e308]))
print(mean([1e308, 1e308]))
print(sum([1e308, 1e308]))
# CASE lerp and degrees near the float limit
print(lerp(-1e308, 1e308, 0.5))
print(deg_to_rad(1.7e308))
# CASE mat_mul of ints stays exact
print(mat_mul([[1, 2], [3, 4]], [[5, 6], [7, 8]]))
print(mat_mul([[9223372036854775807]], [[2]]))
# CASE mat_mul of ints with floats
func pass(v) {
    return [v, null][0]
}
print(mat_mul(pass([[1, 2]]), pass([[1.0], [2.0]])))
