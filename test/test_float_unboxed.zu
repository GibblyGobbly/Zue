//
// Raw float arithmetic: float(int) is a plain conversion, and a -0.0 result prints as 0.0.

# CASE float of an int in a loop
func main() {
    let s = 0.0
    let i = 1
    while (i <= 4) {
        s = s + float(i) * 0.5
        i++
    }
    print(s, float(7), float(-3) / 2.0)
}
main()
# CASE negative zero never shows
func main() {
    let a = 0.0
    let b = a * -1.0
    let c = -1.0 * a + 0.0 * -2.0
    print(b, c, b == 0.0, 1.0 + b)
    let xs = [b, c]
    print(xs)
}
main()
# CASE float of an int variable that a function shadows
func float(x: int) { return x }
func main() {
    let i = 3
    print(float(i))
}
main()
# CASE float overflow in a chain is still reported
func main() {
    let big = 1.0e308
    let k = 1
    let r = big * 10.0 - big
    print(r)
}
main()
# CASE math builtins on raw floats give the same values
let x = 2.0
let y = 10.5
print(sqrt(x), floor(y), ceil(y), round(y), abs(0.0 - y))
print(pow(x, 10.0), sin(x) + cos(x) + tan(x), ln(y) + log10(y) + exp(x))
print(asin(0.5) + acos(0.5) + atan(x), sinh(x) + cosh(x) + tanh(x))
let t = 0.0
for (let i = 1; i <= 100; i++) {
    let v = float(i)
    t += sqrt(v) + float(floor(v / 3.0)) + pow(v, 2.0) / 1000.0
}
print(t)
# CASE sqrt of a negative raw float is the same domain error
let x = 0.0 - 4.0
print(sqrt(x))
# CASE ln of zero is the same domain error
let x = 0.0
print(ln(x))
# CASE exp that overflows is the same error
let x = 1000.0
print(exp(x))
# CASE pow of zero to a negative power is the same error
let x = 0.0
let y = 0.0 - 1.0
print(pow(x, y))
# CASE floor of a float that does not fit in an int is the same error
let x = 1e30
print(floor(x))
