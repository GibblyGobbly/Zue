# What unsafe blocks allow: nesting, calls to your own functions, and freeing under any condition.

func square(x) {
    return x * x
}

func fill(buf, n) {
    for (let i = 0; i < n; i++) {
        store(ptr_offset(buf, i), square(i))
    }
}

func sum(buf, n) {
    let total = 0
    for (let i = 0; i < n; i++) {
        total += load(ptr_offset(buf, i))
    }
    return total
}

# Your own functions may be called inside unsafe, with pointers as arguments.
unsafe {
    let buf = alloc(5)
    defer(buf)
    fill(buf, 5)
    print(sum(buf, 5))
}

# A function with its own unsafe block can be called from inside another one: a safe wrapper.
# Each block frees its own memory when it ends, and only a plain value comes back out.
func read_twice(value) {
    unsafe {
        let inner = alloc(1)
        defer(inner)
        store(inner, value)
        return load(inner) * 2
    }
}

unsafe {
    let outer = alloc(1)
    defer(outer)
    store(outer, 10)
    print(load(outer) + read_twice(16))
    print(load(outer))
}

# free may sit in a condition, a loop, or a switch.
unsafe {
    let a = alloc(1)
    let keep = true
    if (keep) {
        free(a)
    }
    let b = alloc(1)
    for (let i = 0; i < 1; i++) {
        free(b)
    }
}

# A pointer made by a function called inside the block stays inside the block.
func make(n) {
    let p = alloc(n)
    store(p, 7)
    return p
}
unsafe {
    let p = make(2)
    print(load(p))
    free(p)
}

# Values copied out of the block are fine.
let result = 0
unsafe {
    let a = alloc(1)
    defer(a)
    store(a, 99)
    result = load(a)
}
print(result)
