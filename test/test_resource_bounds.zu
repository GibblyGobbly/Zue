# The runtime keeps its own records for everything it hands out: pages, maps, boxes, ranges of unsafe memory,
# thread stacks, large objects. Each case below uses one of them over and over with constant live data and
# checks that the peak resident memory does not keep growing. A leak of a few bytes per use shows up as growth
# between an early and a late measurement. (The collector's page records leaked this way once, see
# test_gc_recycle.zu.)
# CASE strings of many sizes do not grow the peak
func peak_kib() {
    let f = open("/proc/self/status", "r")
    let text = read(f)
    close(f)
    for (let line in split(text, "\n")) {
        if (starts_with(line, "VmHWM:")) {
            return int(split(trim(substring(line, 6, len(line))), " ")[0])
        }
    }
    return 0
}

# The peak may grow by a third and 16 MiB between the early and the late measurement.
func grew(early: int, late: int) {
    return late > early * 4 / 3 + 16384
}

func make_string(n: int) {
    let s = "x"
    while (len(s) < n) {
        s = s + s
    }
    return substring(s, 0, n)
}
let ring = []
for (let i = 0; i < 400; i++) {
    append(ring, "")
}
func churn_strings(rounds: int) {
    for (let r = 0; r < rounds; r++) {
        for (let i = 0; i < 400; i++) {
            ring[i] = make_string(1 + (r * 31 + i * 17) % 3000)
        }
    }
}
churn_strings(40)
let early = peak_kib()
churn_strings(160)
print("grew: {grew(early, peak_kib())}")
# CASE maps filled and emptied again and again do not grow the peak
func peak_kib() {
    let f = open("/proc/self/status", "r")
    let text = read(f)
    close(f)
    for (let line in split(text, "\n")) {
        if (starts_with(line, "VmHWM:")) {
            return int(split(trim(substring(line, 6, len(line))), " ")[0])
        }
    }
    return 0
}

# The peak may grow by a third and 16 MiB between the early and the late measurement.
func grew(early: int, late: int) {
    return late > early * 4 / 3 + 16384
}

func churn_maps(rounds: int) {
    for (let r = 0; r < rounds; r++) {
        let m = {}
        for (let i = 0; i < 4000; i++) {
            m["key{i}"] = [i]
        }
        for (let i = 0; i < 4000; i++) {
            map_delete(m, "key{i}")
        }
    }
}
churn_maps(40)
let early = peak_kib()
churn_maps(160)
print("grew: {grew(early, peak_kib())}")
# CASE large objects made and dropped do not grow the peak
func peak_kib() {
    let f = open("/proc/self/status", "r")
    let text = read(f)
    close(f)
    for (let line in split(text, "\n")) {
        if (starts_with(line, "VmHWM:")) {
            return int(split(trim(substring(line, 6, len(line))), " ")[0])
        }
    }
    return 0
}

# The peak may grow by a third and 16 MiB between the early and the late measurement.
func grew(early: int, late: int) {
    return late > early * 4 / 3 + 16384
}

let big = []
for (let i = 0; i < 8; i++) {
    append(big, [0])
}
func churn_large(rounds: int) {
    for (let r = 0; r < rounds; r++) {
        let l = []
        let size = 60000 + (r * 7919) % 200000
        for (let j = 0; j < size; j++) {
            append(l, j)
        }
        big[r % 8] = l
    }
}
churn_large(60)
let early = peak_kib()
churn_large(240)
print("grew: {grew(early, peak_kib())}")
# CASE boxes made and freed with their scope do not grow the peak
func peak_kib() {
    let f = open("/proc/self/status", "r")
    let text = read(f)
    close(f)
    for (let line in split(text, "\n")) {
        if (starts_with(line, "VmHWM:")) {
            return int(split(trim(substring(line, 6, len(line))), " ")[0])
        }
    }
    return 0
}

# The peak may grow by a third and 16 MiB between the early and the late measurement.
func grew(early: int, late: int) {
    return late > early * 4 / 3 + 16384
}

func use_box(i: int) {
    let b = box[64]
    b[0] = i % 200
    return b[0]
}
func churn_boxes(n: int) {
    let sum = 0
    for (let i = 0; i < n; i++) {
        sum += use_box(i)
    }
    return sum
}
churn_boxes(300000)
let early = peak_kib()
churn_boxes(1200000)
print("grew: {grew(early, peak_kib())}")
# CASE unsafe memory allocated and freed does not grow the peak
func peak_kib() {
    let f = open("/proc/self/status", "r")
    let text = read(f)
    close(f)
    for (let line in split(text, "\n")) {
        if (starts_with(line, "VmHWM:")) {
            return int(split(trim(substring(line, 6, len(line))), " ")[0])
        }
    }
    return 0
}

# The peak may grow by a third and 16 MiB between the early and the late measurement.
func grew(early: int, late: int) {
    return late > early * 4 / 3 + 16384
}

func churn_unsafe(n: int) {
    for (let i = 0; i < n; i++) {
        unsafe {
            let p = alloc(64)
            store(p, i)
            free(p)
        }
    }
}
churn_unsafe(200000)
let early = peak_kib()
churn_unsafe(800000)
print("grew: {grew(early, peak_kib())}")
# CASE threads made and finished do not grow the peak
func peak_kib() {
    let f = open("/proc/self/status", "r")
    let text = read(f)
    close(f)
    for (let line in split(text, "\n")) {
        if (starts_with(line, "VmHWM:")) {
            return int(split(trim(substring(line, 6, len(line))), " ")[0])
        }
    }
    return 0
}

# The peak may grow by a third and 16 MiB between the early and the late measurement.
func grew(early: int, late: int) {
    return late > early * 4 / 3 + 16384
}

func work(n: int) {
    return n + 1
}
func churn_threads(n: int) {
    let total = 0
    for (let i = 0; i < n; i++) {
        let got_total: int = wait(spawn(work, i))
        total += got_total
    }
    return total
}
churn_threads(30000)
let early = peak_kib()
churn_threads(120000)
print("grew: {grew(early, peak_kib())}")
# CASE channels made, used and closed do not grow the peak
func peak_kib() {
    let f = open("/proc/self/status", "r")
    let text = read(f)
    close(f)
    for (let line in split(text, "\n")) {
        if (starts_with(line, "VmHWM:")) {
            return int(split(trim(substring(line, 6, len(line))), " ")[0])
        }
    }
    return 0
}

# The peak may grow by a third and 16 MiB between the early and the late measurement.
func grew(early: int, late: int) {
    return late > early * 4 / 3 + 16384
}

func churn_channels(n: int) {
    let total = 0
    for (let i = 0; i < n; i++) {
        let ch = channel(2)
        send(ch, i)
        send(ch, i + 1)
        total += recv(ch) as int + recv(ch) as int
        channel_close(ch)
    }
    return total
}
churn_channels(50000)
let early = peak_kib()
churn_channels(200000)
print("grew: {grew(early, peak_kib())}")
# CASE closures and the cells they share do not grow the peak
func peak_kib() {
    let f = open("/proc/self/status", "r")
    let text = read(f)
    close(f)
    for (let line in split(text, "\n")) {
        if (starts_with(line, "VmHWM:")) {
            return int(split(trim(substring(line, 6, len(line))), " ")[0])
        }
    }
    return 0
}

# The peak may grow by a third and 16 MiB between the early and the late measurement.
func grew(early: int, late: int) {
    return late > early * 4 / 3 + 16384
}

func make_counter(start: int) {
    let n = start
    return func() {
        n += 1
        return n
    }
}
func churn_closures(count: int) {
    let sum = 0
    for (let i = 0; i < count; i++) {
        let c = make_counter(i)
        let first: int = c()
        let second: int = c()
        sum += first + second
    }
    return sum
}
churn_closures(400000)
let early = peak_kib()
churn_closures(1600000)
print("grew: {grew(early, peak_kib())}")
# CASE dense lists made and dropped do not grow the peak
func peak_kib() {
    let f = open("/proc/self/status", "r")
    let text = read(f)
    close(f)
    for (let line in split(text, "\n")) {
        if (starts_with(line, "VmHWM:")) {
            return int(split(trim(substring(line, 6, len(line))), " ")[0])
        }
    }
    return 0
}

# The peak may grow by a third and 16 MiB between the early and the late measurement.
func grew(early: int, late: int) {
    return late > early * 4 / 3 + 16384
}

func churn_dense(rounds: int) {
    let sum = 0.0
    for (let r = 0; r < rounds; r++) {
        let d = dense_list(50000, 1.5)
        sum += d[r % 50000]
    }
    return sum
}
churn_dense(200)
let early = peak_kib()
churn_dense(800)
print("grew: {grew(early, peak_kib())}")
# CASE boxes owned by templates do not grow the peak
func peak_kib() {
    let f = open("/proc/self/status", "r")
    let text = read(f)
    close(f)
    for (let line in split(text, "\n")) {
        if (starts_with(line, "VmHWM:")) {
            return int(split(trim(substring(line, 6, len(line))), " ")[0])
        }
    }
    return 0
}

# The peak may grow by a third and 16 MiB between the early and the late measurement.
func grew(early: int, late: int) {
    return late > early * 4 / 3 + 16384
}

# The box bytes are outside the heap; they count toward the next cycle, or the template and its box (about
# 100 heap bytes) would never start one (1.3 GB peak at 160,000 boxes before).
template Holder { name, buf }
let holders = []
for (let i = 0; i < 64; i++) {
    append(holders, null)
}
func churn_holders(n: int) {
    for (let i = 0; i < n; i++) {
        holders[i % 64] = Holder("h", box[65536])
    }
}
churn_holders(8000)
let early = peak_kib()
churn_holders(64000)
print("grew: {grew(early, peak_kib())}")
# CASE unsafe memory of varying sizes in one long block does not grow the peak
func peak_kib() {
    let f = open("/proc/self/status", "r")
    let text = read(f)
    close(f)
    for (let line in split(text, "\n")) {
        if (starts_with(line, "VmHWM:")) {
            return int(split(trim(substring(line, 6, len(line))), " ")[0])
        }
    }
    return 0
}

# The peak may grow by a third and 16 MiB between the early and the late measurement.
func grew(early: int, late: int) {
    return late > early * 4 / 3 + 16384
}

# Sizes vary so that malloc hands out addresses again in a different order; ptr_add makes interior pointers.
func churn_sizes(n: int) {
    unsafe {
        for (let i = 0; i < n; i++) {
            let a = alloc(4 + (i * 7919) % 500)
            let b = alloc(4 + (i * 104729) % 700)
            store(ptr_add(b, 3), i)
            store(a, load(ptr_add(b, 3)))
            free(a)
            free(b)
        }
    }
}
churn_sizes(50000)
let early = peak_kib()
churn_sizes(400000)
print("grew: {grew(early, peak_kib())}")
