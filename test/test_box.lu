print("=== Running Box Tests ===")

let buf = box[16]
assert(type(buf) == "box")
assert(shape(buf) == "box")
assert(buf.len == 16)
assert(buf.cap >= 16)

# Assigning a box makes a copy with its own bytes.
buf[0] = 5
let alias = buf
assert(alias.len == 16)
assert(alias[0] == 5)
buf[0] = 6
assert(alias[0] == 5)

free(buf)

assert(to_string(buf) == "<box freed>")
assert(alias[0] == 5)
free(alias)

let tiny = box[1]
assert(tiny.len == 1)
free(tiny)

let escaped = null
if (true) {
    let scoped = box[8]
    escaped = scoped
    assert(escaped.len == 8)
}
assert(to_string(escaped) == "<box freed>")

print("Box tests passed!")
