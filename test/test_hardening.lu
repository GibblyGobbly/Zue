# CASE float and string ordering at equal values
print(1.5 < 1.5)
print(1.5 <= 1.5)
print(1.5 > 1.5)
print(1.5 >= 1.5)
print("a" < "a")
print("a" <= "a")
print("a" >= "a")
print(1 < 1.0)
print(2 <= 2.0)
# CASE float printing keeps six significant digits
print(3.14159265)
print(1.0 / 3.0)
print(100000000.5)
print(0.000123456789)
print(2.5)
print(1.0)
# CASE sort of a long list
let xs = []
for (let i = 0; i < 40; i++) {
    append(xs, (i * 17) % 40)
}
sort(xs)
print(xs)
let words = ["pear", "apple", "fig", "banana", "cherry", "date", "grape", "kiwi", "lemon", "mango", "nut", "olive", "peach", "plum", "quince", "rasp", "straw", "tang", "ugli"]
sort(words)
print(words)
# CASE index_of positions
print(index_of("hello", "h"))
print(index_of("hello", "o"))
print(index_of("hello", "z"))
print(index_of("hello", ""))
print(last_index_of("hello", "h"))
print(last_index_of("hello", "l"))
# CASE write returns whether it worked
let f = open("test/util.lu", "r")
print(write(f, "x"))
close(f)
let g = open("test_hardening_tmp.txt", "w")
print(write(g, "abc"))
close(g)
print(remove_file("test_hardening_tmp.txt"))
# CASE a box owned by a template cannot be freed
template Holder { bytes }
let h = Holder(box[4])
unsafe {
    free(h.bytes)
}
# CASE huge range is an out of memory error
print(len(range(0, 1152921504606846976)))
# CASE huge dense list is an out of memory error
print(len(dense_list(2305843009213693952, 1.0)))
# CASE repeat of an empty string is empty
print(len(repeat("", 4611686018427387904)))
# CASE repeat that cannot fit
print(len(repeat("ab", 4611686018427387904)))
# CASE the smallest integer literal is fine
print(-9223372036854775808)
print(9223372036854775807)
# CASE deep recursion is an error, not a crash
func f(n) {
    if (n == 0) {
        return 0
    }
    return 1 + f(n - 1)
}
print(f(99990))
print(f(100000))
