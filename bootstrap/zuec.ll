@.s671 = private unnamed_addr constant [287 x i8] c"    {\22code\22: \22E0420\22, \22title\22: \22Two lists have different sizes\22, \22match\22: [\22different lengths\22, \22dimension mismatch\22], \22text\22: \22Element-wise operations and matrix products need lists of matching sizes.\22, \22example\22: \22print([1, 2] + [1, 2, 3])\22, \22fix\22: \22Make the lists the same length.\22},\00"
@.s672 = private unnamed_addr constant [398 x i8] c"    {\22code\22: \22E0201\22, \22title\22: \22An operator is used on values of the wrong types\22, \22match\22: [\22cannot use '\22], \22text\22: \22Arithmetic needs two numbers of the same type (two ints or two floats); + also joins two\5Cnstrings. int and float never mix, and nothing is converted for you.\22, \22example\22: \22print(1 + \5C\22a\5C\22)\5Cnprint(2 * 1.5)\22, \22fix\22: \22Convert one side on purpose: to_string(x), float(x), int(x).\22},\00"
@.s673 = private unnamed_addr constant [541 x i8] c"    {\22code\22: \22E0202\22, \22title\22: \22A function was given the wrong kind of value\22, \22match\22: [\22argument 1 must be\22, \22argument 2 must be\22, \22argument 3 must be\22, \22argument 4 must be\22, \22argument must be an int\22, \22digits must be an int\22, \22cannot be called with\22, \22arguments must both be\22, \22slice start must be\22, \22slice end must be\22], \22text\22: \22The function needs a value of a certain type for this argument and got another one.\22, \22example\22: \22print(sqrt(\5C\22a\5C\22))\22, \22fix\22: \22Convert the value, as the hint says, for example with float(x) or to_int(s).\22},\00"
@.s674 = private unnamed_addr constant [381 x i8] c"    {\22code\22: \22E0203\22, \22title\22: \22A function was called with the wrong number of arguments\22, \22match\22: [\22but got\22, \22expects exactly\22, \22expects 1 pointer\22, \22takes exactly\22], \22text\22: \22Each function takes a fixed number of arguments (some allow a range). The call has too many\5Cnor too few.\22, \22example\22: \22print(sqrt(1, 2))\22, \22fix\22: \22Pass exactly the arguments that the function takes.\22},\00"
@.s675 = private unnamed_addr constant [399 x i8] c"    {\22code\22: \22E0204\22, \22title\22: \22A value of the wrong type is stored\22, \22match\22: [\22cannot assign\22, \22cannot store\22, \22cannot append\22, \22must be a bool, got\22, \22variable '\22], \22text\22: \22A variable keeps the type of its first value, and a list or typed field holds one type.\22, \22example\22: \22let n = 1\5Cnn = \5C\22one\5C\22\22, \22fix\22: \22Use another variable for the new value, or convert it to the type the variable has.\22},\00"
@.s676 = private unnamed_addr constant [343 x i8] c"    {\22code\22: \22E0205\22, \22title\22: \22A condition is not true or false\22, \22match\22: [\22needs a bool\22, \22needs bool operands\22, \22condition must be a boolean\22], \22text\22: \22if, while, for, and, or and not need a bool. A number or text is never turned into one.\22, \22example\22: \22let n = 1\5Cnif (n) \5C{ print(\5C\22yes\5C\22) }\22, \22fix\22: \22Write a comparison: if (n != 0).\22},\00"
@.s677 = private unnamed_addr constant [450 x i8] c"    {\22code\22: \22E0206\22, \22title\22: \22An index or a slice position is not valid\22, \22match\22: [\22list index must be\22, \22slice position must be\22, \22cannot slice\22, \22Use an int index\22, \22cannot index\22, \22map key must be\22], \22text\22: \22A list is indexed by a whole number counting from 0, a map by a string, and a slice\5Cns[a:b] takes whole numbers counting from 0.\22, \22example\22: \22let xs = [1, 2]\5Cnprint(xs[\5C\22a\5C\22])\22, \22fix\22: \22Use an int index, or a string key for a map.\22},\00"
@.s678 = private unnamed_addr constant [256 x i8] c"    {\22code\22: \22E0207\22, \22title\22: \22A division by zero\22, \22match\22: [\22division by zero\22], \22text\22: \22Dividing or taking a remainder with 0 is always an error, because Zue has no infinity.\22, \22example\22: \22print(10 / 0)\22, \22fix\22: \22Check the divisor before dividing.\22},\00"
@.s679 = private unnamed_addr constant [360 x i8] c"    {\22code\22: \22E0208\22, \22title\22: \22Strict mode needs a type that is not known\22, \22match\22: [\22strict mode\22], \22text\22: \22A file that starts with the comment # strict must give a type to every parameter and to\5Cnevery value whose type the checker cannot work out.\22, \22example\22: \22# strict\5Cnfunc add(a, b) \5C{ return a + b }\22, \22fix\22: \22Add types: func add(a: int, b: int).\22},\00"
@.s680 = private unnamed_addr constant [289 x i8] c"    {\22code\22: \22E0209\22, \22title\22: \22A type name is not known\22, \22match\22: [\22unknown type\22], \22text\22: \22The name after a colon is not a built-in type or one of your types.\22, \22example\22: \22let x: integer = 1\22, \22fix\22: \22Use int, float, bool, char, string, list, map, function, or a type you defined.\22},\00"
@.s681 = private unnamed_addr constant [320 x i8] c"    {\22code\22: \22E0210\22, \22title\22: \22A typed field is given the wrong type\22, \22match\22: [\22' field '\22], \22text\22: \22A bloc or template with typed fields checks each value when you build it or change it.\22, \22example\22: \22template P \5C{ x: float }\5CnP(\5C\22a\5C\22)\22, \22fix\22: \22Pass a value of the declared type. Write 2.0, not 2, for a float.\22},\00"
@.s682 = private unnamed_addr constant [452 x i8] c"    {\22code\22: \22E0211\22, \22title\22: \22A call or value cannot be used this way\22, \22match\22: [\22cannot call\22, \22cannot compare\22, \22cannot order\22, \22cannot read field\22, \22for-in expects\22, \22cannot negate\22, \22cannot convert\22], \22text\22: \22Only functions can be called, only numbers, strings and chars are ordered, and only lists,\5Cnstrings and numbers can be iterated or converted.\22, \22example\22: \22let n = 3\5Cnn()\22, \22fix\22: \22Check the type of the value; the message names it.\22},\00"
@.s683 = private unnamed_addr constant [324 x i8] c"    {\22code\22: \22E0301\22, \22title\22: \22A name is not defined\22, \22match\22: [\22is not defined\22], \22text\22: \22The program uses a name that no let, func, parameter or use declares. Often it is a typo.\22, \22example\22: \22let items = [1, 2]\5Cnprint(itms[0])\22, \22fix\22: \22Fix the spelling (the hint suggests the closest name) or declare it with let.\22},\00"
@.s684 = private unnamed_addr constant [599 x i8] c"    {\22code\22: \22E0302\22, \22title\22: \22An import cannot be resolved\22, \22match\22: [\22Could not import\22, \22Circular import\22, \22does not export\22], \22text\22: \22A use statement names a file that does not exist, a file that imports back into the one that\5Cnis loading it, or a name the file does not export. The compiler reports it at the use line,\5Cneven when that line is in a branch that never runs.\22, \22example\22: \22use \5C{ helper } from \5C\22missing.zu\5C\22\22, \22fix\22: \22Check the path (it is relative to the file with the use), mark the name with export in the\5Cnmodule, or move shared code to a third module to break a cycle.\22},\00"
@.s685 = private unnamed_addr constant [432 x i8] c"    {\22code\22: \22E0401\22, \22title\22: \22An index or slice is outside its list or string\22, \22match\22: [\22is out of bounds\22, \22Slice start\22], \22text\22: \22Positions in a list or string count from 0 up to length - 1. A slice s[a:b] counts from 0\5Cnlike an index and includes both ends. A position past either end stops the program.\22, \22example\22: \22let xs = [1, 2, 3]\5Cnprint(xs[3])\22, \22fix\22: \22Check len(xs) first, or use an index from 0 to len(xs) - 1.\22},\00"
@.s686 = private unnamed_addr constant [298 x i8] c"    {\22code\22: \22E0402\22, \22title\22: \22A field or key does not exist\22, \22match\22: [\22does not exist\22], \22text\22: \22A template, bloc or box has only the fields that were declared.\22, \22example\22: \22template P \5C{ x }\5Cnlet p = P(1)\5Cnprint(p.y)\22, \22fix\22: \22Use a field that was declared, or add it to the declaration.\22},\00"
