@.s759 = private unnamed_addr constant [599 x i8] c"    {\22code\22: \22E0302\22, \22title\22: \22An import cannot be resolved\22, \22match\22: [\22Could not import\22, \22Circular import\22, \22does not export\22], \22text\22: \22A use statement names a file that does not exist, a file that imports back into the one that\5Cnis loading it, or a name the file does not export. The compiler reports it at the use line,\5Cneven when that line is in a branch that never runs.\22, \22example\22: \22use \5C{ helper } from \5C\22missing.zu\5C\22\22, \22fix\22: \22Check the path (it is relative to the file with the use), mark the name with export in the\5Cnmodule, or move shared code to a third module to break a cycle.\22},\00"
@.s760 = private unnamed_addr constant [432 x i8] c"    {\22code\22: \22E0401\22, \22title\22: \22An index or slice is outside its list or string\22, \22match\22: [\22is out of bounds\22, \22Slice start\22], \22text\22: \22Positions in a list or string count from 0 up to length - 1. A slice s[a:b] counts from 0\5Cnlike an index and includes both ends. A position past either end stops the program.\22, \22example\22: \22let xs = [1, 2, 3]\5Cnprint(xs[3])\22, \22fix\22: \22Check len(xs) first, or use an index from 0 to len(xs) - 1.\22},\00"
@.s761 = private unnamed_addr constant [448 x i8] c"    {\22code\22: \22E0402\22, \22title\22: \22A field or key does not exist\22, \22match\22: [\22does not exist\22], \22text\22: \22A template, bloc or box has only the fields that were declared, and reading m[key] or m.key needs the map to have that key.\22, \22example\22: \22template P \5C{ x }\5Cnlet p = P(1)\5Cnprint(p.y)\22, \22fix\22: \22Use a field that was declared, or add it to the declaration. For a map, check with map_has(m, key) first, or give a default: map_get(m, key, default).\22},\00"
@.s762 = private unnamed_addr constant [365 x i8] c"    {\22code\22: \22E0403\22, \22title\22: \22A search found nothing\22, \22match\22: [\22did not find\22], \22text\22: \22find, index_of and last_index_of give the position of what they look for; when it is not there, that is an error rather than -1, which would index the last item.\22, \22example\22: \22print(find([1, 2], 3))\22, \22fix\22: \22Check with contains(list, value) or contains(s, sub) first.\22},\00"
@.s763 = private unnamed_addr constant [352 x i8] c"    {\22code\22: \22E0410\22, \22title\22: \22An integer calculation overflowed\22, \22match\22: [\22integer overflow\22, \22does not fit in a 64-bit int\22, \22shift count\22], \22text\22: \22Ints are 64 bits (about 9.2 quintillion). A result that does not fit is an error, never a\5Cnwrap-around.\22, \22example\22: \22print(9223372036854775807 + 1)\22, \22fix\22: \22Use floats for very large numbers.\22},\00"
@.s764 = private unnamed_addr constant [421 x i8] c"    {\22code\22: \22E0411\22, \22title\22: \22A float calculation went out of range or outside its domain\22, \22match\22: [\22float overflow\22, \22does not fit in a 64-bit float\22], \22text\22: \22Zue has no infinity and no NaN. A float result that is too large, or an input outside what\5Cna function accepts (the square root of a negative number), is an error.\22, \22example\22: \22print(exp(1000.0))\22, \22fix\22: \22Check the range of the input before calling.\22},\00"
@.s765 = private unnamed_addr constant [689 x i8] c"    {\22code\22: \22E0412\22, \22title\22: \22A function was given a value it cannot work with\22, \22match\22: [\22must not be negative\22, \22must not be 0\22, \22argument must be greater than\22, \22argument must be between\22, \22is greater than the upper\22, \22needs a list with at least one\22, \22digits must be between\22, \22decimals must be between\22, \22exponent of an int\22, \22mode '\22, \22contains a NUL byte\22, \22status must be from\22, \22is out of range\22, \22needs one pad character\22, \22cannot replace an empty string\22], \22text\22: \22The type is right but the value is not allowed, such as a negative size or an empty list.\22, \22example\22: \22print(range(0, 10, 0))\22, \22fix\22: \22Pass a value in the range the function accepts; the hint says which.\22},\00"
