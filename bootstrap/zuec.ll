@.s751 = private unnamed_addr constant [446 x i8] c"    {\22code\22: \22E0121\22, \22title\22: \22A use or export is not valid\22, \22match\22: [\22export can only be used\22, \22export cannot be used\22, \22Expected string path\22, \22Expected 'from'\22], \22text\22: \22use \5C{ name } from \5C\22file.zu\5C\22 brings names in, and export may go before func, const, template,\5Cnbloc and data. A let is not exported: it can change, and an importer would keep a stale copy.\22, \22example\22: \22export print(1)\22, \22fix\22: \22Write a declaration after export.\22},\00"
@.s752 = private unnamed_addr constant [357 x i8] c"    {\22code\22: \22E0122\22, \22title\22: \22A switch has something other than case or default\22, \22match\22: [\22Expected 'case' or 'default'\22, \22two default branches\22, \22appears twice in this switch\22], \22text\22: \22Inside switch (x) \5C{ ... } only case and default clauses may appear.\22, \22example\22: \22switch (x) \5C{ print(1) }\22, \22fix\22: \22Put the statements under a case or default.\22},\00"
@.s753 = private unnamed_addr constant [793 x i8] c"    {\22code\22: \22E0124\22, \22title\22: \22A conversion or its 'else' is written wrongly\22, \22match\22: [\22after 'as'\22, \22needs a value that may be missing\22, \22block of a 'let' must leave\22], \22text\22: \22'as' converts to int, float or string. 'else' after a let, and 'if (let ...)', take a value\5Cnthat may be missing: a conversion that can fail (to int or to float), an index or field read,\5Cnfind, index_of, last_index_of or open. The 'else' block of a let must leave with return, break\5Cnor continue, because after the let the name must hold a value.\22, \22example\22: \22func f(s) \5C{\5Cn    let n = s as int else \5C{\5Cn        print(\5C\22not a number\5C\22)\5Cn    }\5Cn    return n\5Cn}\5Cnprint(f(\5C\224\5C\22))\22, \22fix\22: \22Give a value that may be missing, such as s as int or m[key], and end the 'else' block with\5Cnreturn, break or continue.\22},\00"
@.s754 = private unnamed_addr constant [941 x i8] c"    {\22code\22: \22E0125\22, \22title\22: \22A named argument does not fit the call\22, \22match\22: [\22is named twice\22, \22cannot come after a named one\22, \22has no parameter\22, \22by position and by name\22, \22Named arguments go in the order\22, \22needs a value for\22, \22has only\22, \22cannot skip\22, \22takes no named arguments\22, \22Named arguments need a function\22], \22text\22: \22A call can name its arguments, greet(\5C\22Ann\5C\22, greeting: \5C\22Hi\5C\22). The named ones come after the\5Cnpositional ones and in the order of the parameters, each parameter is given once, and every\5Cnparameter without a default gets a value. The function must be known when the program is built:\5Cnone declared with func (and not assigned elsewhere), a template, or a builtin that has names.\22, \22example\22: \22func greet(name, greeting = \5C\22Hello\5C\22) \5C{\5Cn    return greeting + name\5Cn}\5Cnprint(greet(\5C\22Ann\5C\22, greting: \5C\22Hi\5C\22))\22, \22fix\22: \22Use the names the message lists, in their order, or pass the arguments by position.\22},\00"
@.s755 = private unnamed_addr constant [368 x i8] c"    {\22code\22: \22E0123\22, \22title\22: \22A token other than the expected one was found\22, \22match\22: [\22Expected\22, \22statement outside loop\22, \22defer expects a call\22], \22text\22: \22The parser needed a particular token here (such as a brace after a function header) and\5Cnfound something else.\22, \22example\22: \22if (true)\5Cn    print(1)\22, \22fix\22: \22Add the missing token shown in the message.\22},\00"
@.s756 = private unnamed_addr constant [287 x i8] c"    {\22code\22: \22E0420\22, \22title\22: \22Two lists have different sizes\22, \22match\22: [\22different lengths\22, \22dimension mismatch\22], \22text\22: \22Element-wise operations and matrix products need lists of matching sizes.\22, \22example\22: \22print([1, 2] + [1, 2, 3])\22, \22fix\22: \22Make the lists the same length.\22},\00"
@.s757 = private unnamed_addr constant [402 x i8] c"    {\22code\22: \22E0201\22, \22title\22: \22An operator is used on values of the wrong types\22, \22match\22: [\22cannot use '\22], \22text\22: \22Arithmetic needs two numbers of the same type (two ints or two floats); + also joins two\5Cnstrings. int and float never mix, and nothing is converted for you.\22, \22example\22: \22print(1 + \5C\22a\5C\22)\5Cnprint(2 * 1.5)\22, \22fix\22: \22Convert one side on purpose: float(n), round(x), or x as string.\22},\00"
@.s758 = private unnamed_addr constant [647 x i8] c"    {\22code\22: \22E0202\22, \22title\22: \22A function was given the wrong kind of value\22, \22match\22: [\22argument 1 must be\22, \22argument 2 must be\22, \22argument 3 must be\22, \22argument 4 must be\22, \22argument must be an int\22, \22digits must be an int\22, \22cannot be called with\22, \22arguments must both be\22, \22slice start must be\22, \22slice end must be\22, \22clamp() arguments must all be\22, \22must both hold ints or both hold floats\22, \22needs a string, list or map\22], \22text\22: \22The function needs a value of a certain type for this argument and got another one.\22, \22example\22: \22print(sqrt(\5C\22a\5C\22))\22, \22fix\22: \22Convert the value, as the hint says, for example with float(n) or s as int.\22},\00"
@.s759 = private unnamed_addr constant [381 x i8] c"    {\22code\22: \22E0203\22, \22title\22: \22A function was called with the wrong number of arguments\22, \22match\22: [\22but got\22, \22expects exactly\22, \22expects 1 pointer\22, \22takes exactly\22], \22text\22: \22Each function takes a fixed number of arguments (some allow a range). The call has too many\5Cnor too few.\22, \22example\22: \22print(sqrt(1, 2))\22, \22fix\22: \22Pass exactly the arguments that the function takes.\22},\00"
@.s760 = private unnamed_addr constant [424 x i8] c"    {\22code\22: \22E0204\22, \22title\22: \22A value of the wrong type is stored\22, \22match\22: [\22cannot assign\22, \22cannot store\22, \22cannot append\22, \22must be a bool, got\22, \22variable '\22, \22store() cannot change\22], \22text\22: \22A variable keeps the type of its first value, and a list or typed field holds one type.\22, \22example\22: \22let n = 1\5Cnn = \5C\22one\5C\22\22, \22fix\22: \22Use another variable for the new value, or convert it to the type the variable has.\22},\00"
@.s761 = private unnamed_addr constant [343 x i8] c"    {\22code\22: \22E0205\22, \22title\22: \22A condition is not true or false\22, \22match\22: [\22needs a bool\22, \22needs bool operands\22, \22condition must be a boolean\22], \22text\22: \22if, while, for, and, or and not need a bool. A number or text is never turned into one.\22, \22example\22: \22let n = 1\5Cnif (n) \5C{ print(\5C\22yes\5C\22) }\22, \22fix\22: \22Write a comparison: if (n != 0).\22},\00"
@.s762 = private unnamed_addr constant [450 x i8] c"    {\22code\22: \22E0206\22, \22title\22: \22An index or a slice position is not valid\22, \22match\22: [\22list index must be\22, \22slice position must be\22, \22cannot slice\22, \22Use an int index\22, \22cannot index\22, \22map key must be\22], \22text\22: \22A list is indexed by a whole number counting from 0, a map by a string, and a slice\5Cns[a:b] takes whole numbers counting from 0.\22, \22example\22: \22let xs = [1, 2]\5Cnprint(xs[\5C\22a\5C\22])\22, \22fix\22: \22Use an int index, or a string key for a map.\22},\00"
@.s763 = private unnamed_addr constant [256 x i8] c"    {\22code\22: \22E0207\22, \22title\22: \22A division by zero\22, \22match\22: [\22division by zero\22], \22text\22: \22Dividing or taking a remainder with 0 is always an error, because Zue has no infinity.\22, \22example\22: \22print(10 / 0)\22, \22fix\22: \22Check the divisor before dividing.\22},\00"
@.s764 = private unnamed_addr constant [443 x i8] c"    {\22code\22: \22E0208\22, \22title\22: \22Strict mode needs a type that is not known\22, \22match\22: [\22strict mode\22], \22text\22: \22A file that starts with the comment # strict must give a type to every value whose type the\5Cnchecker cannot work out, and to the parameters of a function value (func without a name).\22, \22example\22: \22# strict\5Cnlet xs = [1, \5C\22two\5C\22]\5Cnlet y = xs[0] + 1\22, \22fix\22: \22Write the type, let y: int = ..., or convert the value: xs[0] as int.\22},\00"
@.s765 = private unnamed_addr constant [289 x i8] c"    {\22code\22: \22E0209\22, \22title\22: \22A type name is not known\22, \22match\22: [\22unknown type\22], \22text\22: \22The name after a colon is not a built-in type or one of your types.\22, \22example\22: \22let x: integer = 1\22, \22fix\22: \22Use int, float, bool, char, string, list, map, function, or a type you defined.\22},\00"
@.s766 = private unnamed_addr constant [320 x i8] c"    {\22code\22: \22E0210\22, \22title\22: \22A typed field is given the wrong type\22, \22match\22: [\22' field '\22], \22text\22: \22A bloc or template with typed fields checks each value when you build it or change it.\22, \22example\22: \22template P \5C{ x: float }\5CnP(\5C\22a\5C\22)\22, \22fix\22: \22Pass a value of the declared type. Write 2.0, not 2, for a float.\22},\00"
@.s767 = private unnamed_addr constant [452 x i8] c"    {\22code\22: \22E0211\22, \22title\22: \22A call or value cannot be used this way\22, \22match\22: [\22cannot call\22, \22cannot compare\22, \22cannot order\22, \22cannot read field\22, \22for-in expects\22, \22cannot negate\22, \22cannot convert\22], \22text\22: \22Only functions can be called, only numbers, strings and chars are ordered, and only lists,\5Cnstrings and numbers can be iterated or converted.\22, \22example\22: \22let n = 3\5Cnn()\22, \22fix\22: \22Check the type of the value; the message names it.\22},\00"
@.s768 = private unnamed_addr constant [508 x i8] c"    {\22code\22: \22E0212\22, \22title\22: \22A function does not return its written result type\22, \22match\22: [\22must return\22], \22text\22: \22A function with a result type after -> (func area(w: float, h: float) -> float) must return a value of\5Cnthat type from every return, and must not end without a return unless its result is a template, which\5Cnmay be empty.\22, \22example\22: \22func label(n: int) -> int \5C{\5Cn    return \5C\22n is \5C{n}\5C\22\5Cn}\22, \22fix\22: \22Return a value of the written type, convert the value, or change the result type.\22},\00"
@.s769 = private unnamed_addr constant [324 x i8] c"    {\22code\22: \22E0301\22, \22title\22: \22A name is not defined\22, \22match\22: [\22is not defined\22], \22text\22: \22The program uses a name that no let, func, parameter or use declares. Often it is a typo.\22, \22example\22: \22let items = [1, 2]\5Cnprint(itms[0])\22, \22fix\22: \22Fix the spelling (the hint suggests the closest name) or declare it with let.\22},\00"
@.s770 = private unnamed_addr constant [599 x i8] c"    {\22code\22: \22E0302\22, \22title\22: \22An import cannot be resolved\22, \22match\22: [\22Could not import\22, \22Circular import\22, \22does not export\22], \22text\22: \22A use statement names a file that does not exist, a file that imports back into the one that\5Cnis loading it, or a name the file does not export. The compiler reports it at the use line,\5Cneven when that line is in a branch that never runs.\22, \22example\22: \22use \5C{ helper } from \5C\22missing.zu\5C\22\22, \22fix\22: \22Check the path (it is relative to the file with the use), mark the name with export in the\5Cnmodule, or move shared code to a third module to break a cycle.\22},\00"
@.s771 = private unnamed_addr constant [432 x i8] c"    {\22code\22: \22E0401\22, \22title\22: \22An index or slice is outside its list or string\22, \22match\22: [\22is out of bounds\22, \22Slice start\22], \22text\22: \22Positions in a list or string count from 0 up to length - 1. A slice s[a:b] counts from 0\5Cnlike an index and includes both ends. A position past either end stops the program.\22, \22example\22: \22let xs = [1, 2, 3]\5Cnprint(xs[3])\22, \22fix\22: \22Check len(xs) first, or use an index from 0 to len(xs) - 1.\22},\00"
@.s772 = private unnamed_addr constant [448 x i8] c"    {\22code\22: \22E0402\22, \22title\22: \22A field or key does not exist\22, \22match\22: [\22does not exist\22], \22text\22: \22A template, bloc or box has only the fields that were declared, and reading m[key] or m.key needs the map to have that key.\22, \22example\22: \22template P \5C{ x }\5Cnlet p = P(1)\5Cnprint(p.y)\22, \22fix\22: \22Use a field that was declared, or add it to the declaration. For a map, check with map_has(m, key) first, or give a default: map_get(m, key, default).\22},\00"
@.s773 = private unnamed_addr constant [365 x i8] c"    {\22code\22: \22E0403\22, \22title\22: \22A search found nothing\22, \22match\22: [\22did not find\22], \22text\22: \22find, index_of and last_index_of give the position of what they look for; when it is not there, that is an error rather than -1, which would index the last item.\22, \22example\22: \22print(find([1, 2], 3))\22, \22fix\22: \22Check with contains(list, value) or contains(s, sub) first.\22},\00"
@.s774 = private unnamed_addr constant [352 x i8] c"    {\22code\22: \22E0410\22, \22title\22: \22An integer calculation overflowed\22, \22match\22: [\22integer overflow\22, \22does not fit in a 64-bit int\22, \22shift count\22], \22text\22: \22Ints are 64 bits (about 9.2 quintillion). A result that does not fit is an error, never a\5Cnwrap-around.\22, \22example\22: \22print(9223372036854775807 + 1)\22, \22fix\22: \22Use floats for very large numbers.\22},\00"
@.s775 = private unnamed_addr constant [421 x i8] c"    {\22code\22: \22E0411\22, \22title\22: \22A float calculation went out of range or outside its domain\22, \22match\22: [\22float overflow\22, \22does not fit in a 64-bit float\22], \22text\22: \22Zue has no infinity and no NaN. A float result that is too large, or an input outside what\5Cna function accepts (the square root of a negative number), is an error.\22, \22example\22: \22print(exp(1000.0))\22, \22fix\22: \22Check the range of the input before calling.\22},\00"
@.s776 = private unnamed_addr constant [689 x i8] c"    {\22code\22: \22E0412\22, \22title\22: \22A function was given a value it cannot work with\22, \22match\22: [\22must not be negative\22, \22must not be 0\22, \22argument must be greater than\22, \22argument must be between\22, \22is greater than the upper\22, \22needs a list with at least one\22, \22digits must be between\22, \22decimals must be between\22, \22exponent of an int\22, \22mode '\22, \22contains a NUL byte\22, \22status must be from\22, \22is out of range\22, \22needs one pad character\22, \22cannot replace an empty string\22], \22text\22: \22The type is right but the value is not allowed, such as a negative size or an empty list.\22, \22example\22: \22print(range(0, 10, 0))\22, \22fix\22: \22Pass a value in the range the function accepts; the hint says which.\22},\00"
@.s777 = private unnamed_addr constant [321 x i8] c"    {\22code\22: \22E0413\22, \22title\22: \22Text cannot be read as a number\22, \22match\22: [\22cannot read\22], \22text\22: \22s as int, s as float, int(s) and float(s) need the whole text to be a number.\22, \22example\22: \22print(\5C\2212abc\5C\22 as int)\22, \22fix\22: \22Fix the text, or say what happens when it is not a number: let n = s as int else \5C{ ... }.\22},\00"
@.s778 = private unnamed_addr constant [512 x i8] c"    {\22code\22: \22E0414\22, \22title\22: \22A conversion would change the value\22, \22match\22: [\22is not a whole number\22, \22has no exact float\22, \22is not a character code\22], \22text\22: \22A conversion keeps the value exactly. A float with a fraction has no int (rounding is a\5Cnchoice, so it has its own functions), a very large int has no exact float, and a char holds\5Cnone byte, a code from 0 to 255.\22, \22example\22: \22print(int(2.5))\22, \22fix\22: \22Round on purpose with round(x), floor(x), ceil(x) or trunc(x), or keep the value as it is.\22},\00"
@.s779 = private unnamed_addr constant [417 x i8] c"    {\22code\22: \22E0430\22, \22title\22: \22A function was given a list or value of the wrong shape\22, \22match\22: [\22needs a list\22, \22list items must\22, \22must be numbers\22, \22cannot store a\22, \22a whole object\22, \22expects a list\22, \22must be ints\22], \22text\22: \22The function works on a list of numbers (or another shape) and the value is not.\22, \22example\22: \22print(sum([1, \5C\22a\5C\22]))\22, \22fix\22: \22Pass a list whose items are all ints or all floats.\22},\00"
@.s780 = private unnamed_addr constant [411 x i8] c"    {\22code\22: \22E0440\22, \22title\22: \22The program ran out of stack or memory\22, \22match\22: [\22stack overflow\22, \22out of memory\22, \22too many boxes\22, \22too many to hold in memory\22, \22too large to hold in memory\22], \22text\22: \22A recursion that never stops uses up the stack. Very large data can use up memory.\22, \22example\22: \22func f(n) \5C{ return f(n + 1) }\5Cnf(0)\22, \22fix\22: \22Give the recursion a base case, or work on smaller data.\22},\00"
@.s781 = private unnamed_addr constant [495 x i8] c"    {\22code\22: \22E0450\22, \22title\22: \22A file operation failed\22, \22match\22: [\22on a closed file\22, \22cannot open\22, \22cannot read file\22, \22No such file\22, \22() failed:\22], \22text\22: \22The file was closed, does not exist, or cannot be opened with that mode, or the system\5Cnreported an error while reading, writing, flushing or closing it (a full disk, for example).\22, \22example\22: \22let f = open(\5C\22out.txt\5C\22, \5C\22w\5C\22)\5Cnclose(f)\5Cnwrite(f, \5C\22x\5C\22)\22, \22fix\22: \22Open the file again, and check the path with file_exists(path).\22},\00"
@.s782 = private unnamed_addr constant [373 x i8] c"    {\22code\22: \22E0451\22, \22title\22: \22The operating system could not give random bytes\22, \22match\22: [\22cannot read system entropy\22], \22text\22: \22trand() and tshuffle() read the kernel's entropy source and report a failure instead of\5Cnreturning a number that is not random.\22, \22example\22: \22\22, \22fix\22: \22Check that the program is allowed to use getrandom, or use rand() with srand(seed).\22},\00"
@.s783 = private unnamed_addr constant [577 x i8] c"    {\22code\22: \22E0452\22, \22title\22: \22A thread or a channel cannot go on\22, \22match\22: [\22cannot wait for itself\22, \22every blue thread is waiting\22, \22on a closed channel\22, \22from a closed channel\22], \22text\22: \22A thread cannot wait for itself; when every thread waits for another, none can go on (a deadlock);\5Cna closed channel takes no more values, and an empty closed channel gives none.\22, \22example\22: \22let ch = channel(1)\5Cnchannel_close(ch)\5Cnsend(ch, 1)\22, \22fix\22: \22Send before closing, close a channel only when no more values come, and make sure some thread\5Cnsends what another receives.\22},\00"
@.s784 = private unnamed_addr constant [522 x i8] c"    {\22code\22: \22E0460\22, \22title\22: \22An unsafe rule was broken\22, \22match\22: [\22unsafe\22, \22alloc()\22, \22free()\22, \22box\22, \22pointer\22, \22ptr_add()\22, \22address_of\22, \22defer()\22, \22double free\22, \22use-after-free\22], \22text\22: \22Raw memory is only allowed inside unsafe blocks, and the ten rules there are checked: no\5Cnuse after free, no double free, no pointer that outlives its block, and every alloc() freed.\22, \22example\22: \22unsafe \5C{ let p = alloc(8) }\22, \22fix\22: \22Free what you allocate, keep pointers inside their block, and read docs/unsafe.md.\22},\00"
@.s785 = private unnamed_addr constant [401 x i8] c"    {\22code\22: \22E0470\22, \22title\22: \22A bloc or template rule was broken\22, \22match\22: [\22bloc\22, \22Bloc\22, \22template\22, \22Template\22, \22Data constructor\22], \22text\22: \22A bloc is immutable and holds only simple values; a template holds anything and is checked\5Cnwhen it is built and changed.\22, \22example\22: \22bloc P \5C{ x: int }\5Cnlet p = P(1)\5Cnp.x = 2\22, \22fix\22: \22Build a new bloc instead of changing one, or use a template.\22},\00"
@.s786 = private unnamed_addr constant [238 x i8] c"    {\22code\22: \22E0480\22, \22title\22: \22An assertion failed\22, \22match\22: [\22Assertion failed\22], \22text\22: \22assert(condition) stops the program when the condition is false.\22, \22example\22: \22assert(1 == 2)\22, \22fix\22: \22Find out why the condition is false.\22},\00"
@.s787 = private unnamed_addr constant [358 x i8] c"    {\22code\22: \22E0490\22, \22title\22: \22Crash\22, \22match\22: [\22invalid memory access\22, \22arithmetic fault\22], \22text\22: \22The program touched memory it does not own. In ordinary Zue code this cannot happen; it\5Cnpoints to unsafe code or to a bug in the runtime.\22, \22example\22: \22unsafe \5C{ ... }\22, \22fix\22: \22Check pointers in unsafe code, and report the problem if there is none.\22}\00"
