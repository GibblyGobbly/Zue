@.s638 = private unnamed_addr constant [412 x i8] c"    {\22code\22: \22E0101\22, \22title\22: \22A string has no closing quote\22, \22match\22: [\22Unterminated string\22, \22Unterminated character literal\22], \22text\22: \22A string literal starts with a double quote and must end with another one on the same\5Cnline, or on a later line if the text goes on. The end of the file was reached first.\22, \22example\22: \22let name = \5C\22Ann\5Cnprint(name)\22, \22fix\22: \22Add the closing quote: let name = \5C\22Ann\5C\22\22},\00"
@.s639 = private unnamed_addr constant [402 x i8] c"    {\22code\22: \22E0102\22, \22title\22: \22An escape sequence is not known\22, \22match\22: [\22Unknown escape\22, \22A backslash at the end of a line\22], \22text\22: \22Inside a string or a character, a backslash starts an escape such as \5C\5Cn for a new line.\5CnOnly a few escapes exist: \5C\5Cn \5C\5Ct \5C\5Cr \5C\5C\5C\5C \5C\5C\5C\22 \5C\5C' \5C\5C\5C{ \5C\5C} and, in characters, \5C\5C0.\22, \22example\22: \22print(\5C\22a\5C\5Cqb\5C\22)\22, \22fix\22: \22Write \5C\5C\5C\5C for a backslash, or remove it.\22},\00"
@.s640 = private unnamed_addr constant [348 x i8] c"    {\22code\22: \22E0103\22, \22title\22: \22A character is not part of the language\22, \22match\22: [\22Unexpected character\22], \22text\22: \22The source holds a character that Zue does not use outside a string or a comment, such as\5Cn@, $, ? or a letter with an accent.\22, \22example\22: \22let x = 5 @ 3\22, \22fix\22: \22Remove the character, or put it inside a string or a comment.\22},\00"
@.s641 = private unnamed_addr constant [474 x i8] c"    {\22code\22: \22E0104\22, \22title\22: \22A number is written wrongly\22, \22match\22: [\22number literal\22, \22Misplaced '_'\22, \22Integer literal does not fit\22], \22text\22: \22A number is digits, optionally with a single _ between two digits (1_000), a decimal\5Cnpoint with digits on both sides (2.5), 0x or 0b followed by digits, and it must fit in 64 bits.\22, \22example\22: \22let a = 12abc\5Cnlet b = 1__000\22, \22fix\22: \22Put a space or an operator between a number and a name, and use one _ between digits.\22},\00"
@.s642 = private unnamed_addr constant [349 x i8] c"    {\22code\22: \22E0105\22, \22title\22: \22A character literal is not one character\22, \22match\22: [\22character literal\22], \22text\22: \22A character literal has exactly one character between single quotes, like 'a'. Text with\5Cnmore than one character is a string and goes between double quotes.\22, \22example\22: \22let c = 'ab'\22, \22fix\22: \22Use double quotes for text: \5C\22ab\5C\22\22},\00"
@.s643 = private unnamed_addr constant [521 x i8] c"    {\22code\22: \22E0106\22, \22title\22: \22A string interpolation is not closed or not valid\22, \22match\22: [\22Unclosed string interpolation\22, \22Invalid expression inside string interpolation\22], \22text\22: \22Inside a string, \5C{ starts an expression whose value is put into the text, and } ends it.\5CnThe braces must match and what is between them must be a valid expression.\22, \22example\22: \22print(\5C\22total: \5C{1 +}\5C\22)\5Cnprint(\5C\22open: \5C{x\5C\22)\22, \22fix\22: \22Close the brace and write a complete expression, or write \5C\5C\5C{ for a brace that is only text.\22},\00"
@.s644 = private unnamed_addr constant [385 x i8] c"    {\22code\22: \22E0110\22, \22title\22: \22An expression was expected\22, \22match\22: [\22expected an expression\22, \22Unexpected semicolon\22], \22text\22: \22The program has a token where a value, a name or a call should be. A statement ends at the\5Cnend of the line, so a semicolon is not needed.\22, \22example\22: \22let a = 1 +* 2\5Cnlet b =\22, \22fix\22: \22Write the missing value, or remove the extra operator or token.\22},\00"
@.s645 = private unnamed_addr constant [421 x i8] c"    {\22code\22: \22E0111\22, \22title\22: \22A closing bracket, brace or parenthesis is missing\22, \22match\22: [\22Expected ')'\22, \22Expected ']'\22, \22Expected '}'\22, \22Expected '>'\22], \22text\22: \22Every ( [ and \5C{ must be closed by ) ] and } in the right order. The message points at the\5Cnplace where the closer was expected and at the opener that was never closed.\22, \22example\22: \22print((1 + 2)\22, \22fix\22: \22Add the closing bracket where it belongs.\22},\00"
@.s646 = private unnamed_addr constant [286 x i8] c"    {\22code\22: \22E0112\22, \22title\22: \22A closing brace has no opening brace\22, \22match\22: [\22there is no block to close\22], \22text\22: \22A } ends a block that a \5C{ started, but there is no open block here.\22, \22example\22: \22let a = 1\5Cn}\22, \22fix\22: \22Remove the extra }, or add the \5C{ that it should close.\22},\00"
@.s647 = private unnamed_addr constant [320 x i8] c"    {\22code\22: \22E0113\22, \22title\22: \22A name is declared twice in one scope\22, \22match\22: [\22is already declared\22], \22text\22: \22Inside one block, a variable, parameter, function or type name can be declared once.\22, \22example\22: \22let x = 1\5Cnlet x = 2\22, \22fix\22: \22Use another name, or assign to the existing variable without let: x = 2\22},\00"
@.s648 = private unnamed_addr constant [550 x i8] c"    {\22code\22: \22E0114\22, \22title\22: \22A name was expected\22, \22match\22: [\22Expected variable name\22, \22Expected parameter name\22, \22Expected function name\22, \22Expected a name after\22, \22Expected field name\22, \22Expected loop variable name\22, \22Expected exported name\22], \22text\22: \22A declaration needs a name made of letters, digits and _, not starting with a digit. Words\5Cnsuch as let, func, if, template, bloc, box, unsafe, use, export and case are keywords and cannot\5Cnbe names.\22, \22example\22: \22let template = 3\5Cnfunc case() \5C{ return 1 }\22, \22fix\22: \22Choose another name.\22},\00"
@.s649 = private unnamed_addr constant [312 x i8] c"    {\22code\22: \22E0115\22, \22title\22: \22A parameter without a default follows one with a default\22, \22match\22: [\22needs a default value\22], \22text\22: \22Once a parameter has a default, every parameter after it must have one too.\22, \22example\22: \22func f(a = 1, b) \5C{ return a + b }\22, \22fix\22: \22Give b a default, or put it before a.\22},\00"
@.s650 = private unnamed_addr constant [371 x i8] c"    {\22code\22: \22E0116\22, \22title\22: \22Something that is not a variable is changed\22, \22match\22: [\22Invalid assignment target\22, \22can only be applied to variables\22], \22text\22: \22The left side of = and the operand of ++ and -- must be a variable, an item such as\5Cnlist[0], or a field such as point.x.\22, \22example\22: \22f() = 3\5Cnxs[0]++\22, \22fix\22: \22Assign to a variable, an item or a field.\22},\00"
@.s651 = private unnamed_addr constant [306 x i8] c"    {\22code\22: \22E0117\22, \22title\22: \22A declaration has the wrong number of values\22, \22match\22: [\22Variable count\22, \22const declarations require\22], \22text\22: \22let a, b = 1, 2 needs one value for each name, and a const needs a value.\22, \22example\22: \22let a, b = 1, 2, 3\5Cnconst k\22, \22fix\22: \22Give one value for each name.\22},\00"
@.s652 = private unnamed_addr constant [411 x i8] c"    {\22code\22: \22E0118\22, \22title\22: \22A type annotation is not valid\22, \22match\22: [\22Expected a type after\22, \22take an element type\22, \22to close the element type\22], \22text\22: \22After a colon you may write int, float, bool, char, string, list, map, function or the name\5Cnof one of your types. Only list and map take an element type in angle brackets.\22, \22example\22: \22let x: int< = 1\22, \22fix\22: \22Write a type such as list<int>.\22},\00"
@.s653 = private unnamed_addr constant [256 x i8] c"    {\22code\22: \22E0119\22, \22title\22: \22A map literal key is not a string\22, \22match\22: [\22Map literal keys\22], \22text\22: \22In a map literal such as \5C{\5C\22a\5C\22: 1}, each key is a plain string.\22, \22example\22: \22let m = \5C{1: 2}\22, \22fix\22: \22Write the key as a string: \5C{\5C\221\5C\22: 2}\22},\00"
@.s654 = private unnamed_addr constant [408 x i8] c"    {\22code\22: \22E0120\22, \22title\22: \22A field declaration is not allowed\22, \22match\22: [\22fields cannot have types\22, \22give a type to every field\22, \22box field needs\22], \22text\22: \22A data type has untyped fields; use a template for typed fields. A bloc types all its fields\5Cnor none. A box field is written box[16] with a number.\22, \22example\22: \22data D \5C{ a: int }\22, \22fix\22: \22Use template, or type every field of the bloc.\22},\00"
@.s655 = private unnamed_addr constant [347 x i8] c"    {\22code\22: \22E0121\22, \22title\22: \22A use or export is not valid\22, \22match\22: [\22export can only be used\22, \22Expected string path\22, \22Expected 'from'\22], \22text\22: \22use \5C{ name } from \5C\22file.zu\5C\22 brings names in, and export may go before let, const, func,\5Cndata, template and bloc.\22, \22example\22: \22export print(1)\22, \22fix\22: \22Write a declaration after export.\22},\00"
@.s656 = private unnamed_addr constant [301 x i8] c"    {\22code\22: \22E0122\22, \22title\22: \22A switch has something other than case or default\22, \22match\22: [\22Expected 'case' or 'default'\22], \22text\22: \22Inside switch (x) \5C{ ... } only case and default clauses may appear.\22, \22example\22: \22switch (x) \5C{ print(1) }\22, \22fix\22: \22Put the statements under a case or default.\22},\00"
@.s657 = private unnamed_addr constant [318 x i8] c"    {\22code\22: \22E0123\22, \22title\22: \22A token other than the expected one was found\22, \22match\22: [\22Expected\22], \22text\22: \22The parser needed a particular token here (such as a brace after a function header) and\5Cnfound something else.\22, \22example\22: \22if (true)\5Cn    print(1)\22, \22fix\22: \22Add the missing token shown in the message.\22},\00"
@.s658 = private unnamed_addr constant [287 x i8] c"    {\22code\22: \22E0420\22, \22title\22: \22Two lists have different sizes\22, \22match\22: [\22different lengths\22, \22dimension mismatch\22], \22text\22: \22Element-wise operations and matrix products need lists of matching sizes.\22, \22example\22: \22print([1, 2] + [1, 2, 3])\22, \22fix\22: \22Make the lists the same length.\22},\00"
@.s659 = private unnamed_addr constant [398 x i8] c"    {\22code\22: \22E0201\22, \22title\22: \22An operator is used on values of the wrong types\22, \22match\22: [\22cannot use '\22], \22text\22: \22Arithmetic needs two numbers of the same type (two ints or two floats); + also joins two\5Cnstrings. int and float never mix, and nothing is converted for you.\22, \22example\22: \22print(1 + \5C\22a\5C\22)\5Cnprint(2 * 1.5)\22, \22fix\22: \22Convert one side on purpose: to_string(x), float(x), int(x).\22},\00"
@.s660 = private unnamed_addr constant [446 x i8] c"    {\22code\22: \22E0202\22, \22title\22: \22A function was given the wrong kind of value\22, \22match\22: [\22argument 1 must be\22, \22argument 2 must be\22, \22argument 3 must be\22, \22argument 4 must be\22, \22argument must be an int\22, \22digits must be an int\22], \22text\22: \22The function needs a value of a certain type for this argument and got another one.\22, \22example\22: \22print(sqrt(\5C\22a\5C\22))\22, \22fix\22: \22Convert the value, as the hint says, for example with float(x) or to_int(s).\22},\00"
@.s661 = private unnamed_addr constant [381 x i8] c"    {\22code\22: \22E0203\22, \22title\22: \22A function was called with the wrong number of arguments\22, \22match\22: [\22but got\22, \22expects exactly\22, \22expects 1 pointer\22, \22takes exactly\22], \22text\22: \22Each function takes a fixed number of arguments (some allow a range). The call has too many\5Cnor too few.\22, \22example\22: \22print(sqrt(1, 2))\22, \22fix\22: \22Pass exactly the arguments that the function takes.\22},\00"
@.s662 = private unnamed_addr constant [399 x i8] c"    {\22code\22: \22E0204\22, \22title\22: \22A value of the wrong type is stored\22, \22match\22: [\22cannot assign\22, \22cannot store\22, \22cannot append\22, \22must be a bool, got\22, \22variable '\22], \22text\22: \22A variable keeps the type of its first value, and a list or typed field holds one type.\22, \22example\22: \22let n = 1\5Cnn = \5C\22one\5C\22\22, \22fix\22: \22Use another variable for the new value, or convert it to the type the variable has.\22},\00"
@.s663 = private unnamed_addr constant [343 x i8] c"    {\22code\22: \22E0205\22, \22title\22: \22A condition is not true or false\22, \22match\22: [\22needs a bool\22, \22needs bool operands\22, \22condition must be a boolean\22], \22text\22: \22if, while, for, and, or and not need a bool. A number or text is never turned into one.\22, \22example\22: \22let n = 1\5Cnif (n) \5C{ print(\5C\22yes\5C\22) }\22, \22fix\22: \22Write a comparison: if (n != 0).\22},\00"
@.s664 = private unnamed_addr constant [450 x i8] c"    {\22code\22: \22E0206\22, \22title\22: \22An index or a slice position is not valid\22, \22match\22: [\22list index must be\22, \22slice position must be\22, \22cannot slice\22, \22Use an int index\22, \22cannot index\22, \22map key must be\22], \22text\22: \22A list is indexed by a whole number counting from 0, a map by a string, and a slice\5Cns[a:b] takes whole numbers counting from 1.\22, \22example\22: \22let xs = [1, 2]\5Cnprint(xs[\5C\22a\5C\22])\22, \22fix\22: \22Use an int index, or a string key for a map.\22},\00"
@.s665 = private unnamed_addr constant [256 x i8] c"    {\22code\22: \22E0207\22, \22title\22: \22A division by zero\22, \22match\22: [\22division by zero\22], \22text\22: \22Dividing or taking a remainder with 0 is always an error, because Zue has no infinity.\22, \22example\22: \22print(10 / 0)\22, \22fix\22: \22Check the divisor before dividing.\22},\00"
@.s666 = private unnamed_addr constant [360 x i8] c"    {\22code\22: \22E0208\22, \22title\22: \22Strict mode needs a type that is not known\22, \22match\22: [\22strict mode\22], \22text\22: \22A file that starts with the comment # strict must give a type to every parameter and to\5Cnevery value whose type the checker cannot work out.\22, \22example\22: \22# strict\5Cnfunc add(a, b) \5C{ return a + b }\22, \22fix\22: \22Add types: func add(a: int, b: int).\22},\00"
@.s667 = private unnamed_addr constant [289 x i8] c"    {\22code\22: \22E0209\22, \22title\22: \22A type name is not known\22, \22match\22: [\22unknown type\22], \22text\22: \22The name after a colon is not a built-in type or one of your types.\22, \22example\22: \22let x: integer = 1\22, \22fix\22: \22Use int, float, bool, char, string, list, map, function, or a type you defined.\22},\00"
@.s668 = private unnamed_addr constant [320 x i8] c"    {\22code\22: \22E0210\22, \22title\22: \22A typed field is given the wrong type\22, \22match\22: [\22' field '\22], \22text\22: \22A bloc or template with typed fields checks each value when you build it or change it.\22, \22example\22: \22template P \5C{ x: float }\5CnP(\5C\22a\5C\22)\22, \22fix\22: \22Pass a value of the declared type. Write 2.0, not 2, for a float.\22},\00"
@.s669 = private unnamed_addr constant [452 x i8] c"    {\22code\22: \22E0211\22, \22title\22: \22A call or value cannot be used this way\22, \22match\22: [\22cannot call\22, \22cannot compare\22, \22cannot order\22, \22cannot read field\22, \22for-in expects\22, \22cannot negate\22, \22cannot convert\22], \22text\22: \22Only functions can be called, only numbers, strings and chars are ordered, and only lists,\5Cnstrings and numbers can be iterated or converted.\22, \22example\22: \22let n = 3\5Cnn()\22, \22fix\22: \22Check the type of the value; the message names it.\22},\00"
@.s670 = private unnamed_addr constant [324 x i8] c"    {\22code\22: \22E0301\22, \22title\22: \22A name is not defined\22, \22match\22: [\22is not defined\22], \22text\22: \22The program uses a name that no let, func, parameter or use declares. Often it is a typo.\22, \22example\22: \22let items = [1, 2]\5Cnprint(itms[0])\22, \22fix\22: \22Fix the spelling (the hint suggests the closest name) or declare it with let.\22},\00"
@.s671 = private unnamed_addr constant [418 x i8] c"    {\22code\22: \22E0401\22, \22title\22: \22An index or slice is outside its list or string\22, \22match\22: [\22is out of bounds\22, \22Slice start\22], \22text\22: \22Positions in a list or string count from 0 up to length - 1. A slice s[a:b] counts from 1\5Cnand includes both ends. A position past either end stops the program.\22, \22example\22: \22let xs = [1, 2, 3]\5Cnprint(xs[3])\22, \22fix\22: \22Check len(xs) first, or use an index from 0 to len(xs) - 1.\22},\00"
@.s672 = private unnamed_addr constant [298 x i8] c"    {\22code\22: \22E0402\22, \22title\22: \22A field or key does not exist\22, \22match\22: [\22does not exist\22], \22text\22: \22A template, bloc or box has only the fields that were declared.\22, \22example\22: \22template P \5C{ x }\5Cnlet p = P(1)\5Cnprint(p.y)\22, \22fix\22: \22Use a field that was declared, or add it to the declaration.\22},\00"
@.s673 = private unnamed_addr constant [352 x i8] c"    {\22code\22: \22E0410\22, \22title\22: \22An integer calculation overflowed\22, \22match\22: [\22integer overflow\22, \22does not fit in a 64-bit int\22, \22shift count\22], \22text\22: \22Ints are 64 bits (about 9.2 quintillion). A result that does not fit is an error, never a\5Cnwrap-around.\22, \22example\22: \22print(9223372036854775807 + 1)\22, \22fix\22: \22Use floats for very large numbers.\22},\00"
@.s674 = private unnamed_addr constant [421 x i8] c"    {\22code\22: \22E0411\22, \22title\22: \22A float calculation went out of range or outside its domain\22, \22match\22: [\22float overflow\22, \22does not fit in a 64-bit float\22], \22text\22: \22Zue has no infinity and no NaN. A float result that is too large, or an input outside what\5Cna function accepts (the square root of a negative number), is an error.\22, \22example\22: \22print(exp(1000.0))\22, \22fix\22: \22Check the range of the input before calling.\22},\00"
@.s675 = private unnamed_addr constant [474 x i8] c"    {\22code\22: \22E0412\22, \22title\22: \22A function was given a value it cannot work with\22, \22match\22: [\22must not be negative\22, \22must not be 0\22, \22is greater than the upper\22, \22needs a list with at least one\22, \22digits must be between\22, \22exponent of an int\22, \22mode '\22], \22text\22: \22The type is right but the value is not allowed, such as a negative size or an empty list.\22, \22example\22: \22print(range(0, 10, 0))\22, \22fix\22: \22Pass a value in the range the function accepts; the hint says which.\22},\00"
@.s676 = private unnamed_addr constant [278 x i8] c"    {\22code\22: \22E0413\22, \22title\22: \22Text cannot be read as a number\22, \22match\22: [\22cannot read\22], \22text\22: \22to_int, to_float, int and float need the whole text to be a number.\22, \22example\22: \22print(to_int(\5C\2212abc\5C\22))\22, \22fix\22: \22Check the text first with is_digit(s), or fix the value.\22},\00"
@.s677 = private unnamed_addr constant [417 x i8] c"    {\22code\22: \22E0430\22, \22title\22: \22A function was given a list or value of the wrong shape\22, \22match\22: [\22needs a list\22, \22list items must\22, \22must be numbers\22, \22cannot store a\22, \22a whole object\22, \22expects a list\22, \22must be ints\22], \22text\22: \22The function works on a list of numbers (or another shape) and the value is not.\22, \22example\22: \22print(sum([1, \5C\22a\5C\22]))\22, \22fix\22: \22Pass a list whose items are all ints or all floats.\22},\00"
@.s678 = private unnamed_addr constant [350 x i8] c"    {\22code\22: \22E0440\22, \22title\22: \22The program ran out of stack or memory\22, \22match\22: [\22stack overflow\22, \22out of memory\22, \22too many boxes\22], \22text\22: \22A recursion that never stops uses up the stack. Very large data can use up memory.\22, \22example\22: \22func f(n) \5C{ return f(n + 1) }\5Cnf(0)\22, \22fix\22: \22Give the recursion a base case, or work on smaller data.\22},\00"
