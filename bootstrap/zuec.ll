@.s7730 = private unnamed_addr constant [87 x i8] c"# emit_native.zu: the native backend. It compiles the runtime of Zue, which is written\00"
@.s7731 = private unnamed_addr constant [47 x i8] c"# in Zue, to LLVM IR without any C in between.\00"
@.s7732 = private unnamed_addr constant [87 x i8] c"# A native source file uses the ordinary Zue syntax but has one type: the 64-bit word.\00"
@.s7733 = private unnamed_addr constant [90 x i8] c"# Integers, pointers and doubles (as their bit pattern) are all words; memory is read and\00"
@.s7734 = private unnamed_addr constant [87 x i8] c"# written through the intrinsics below. Several files are compiled into one module and\00"
@.s7735 = private unnamed_addr constant [30 x i8] c"# see each other's functions.\00"
@.s7736 = private unnamed_addr constant [86 x i8] c"#   func name(a, b_i, c_p) { ... }   parameters; a suffix _i is a C int, _p a pointer\00"
@.s7737 = private unnamed_addr constant [61 x i8] c"#   const NAME = 16                  a compile-time constant\00"
@.s7738 = private unnamed_addr constant [66 x i8] c"#   let counter = 0                  a module-level word variable\00"
@.s7739 = private unnamed_addr constant [74 x i8] c"#   extern(\22snprintf\22, \22i32\22, \22ptr,i64,ptr,...\22)    declares a C function\00"
@.s7740 = private unnamed_addr constant [72 x i8] c"#   space(\22lv_depth\22, 4)             a zeroed global of that many bytes\00"
@.s7741 = private unnamed_addr constant [54 x i8] c"#   table(\22sizes\22, \22i32\22, 16, 32)    a constant array\00"
@.s7742 = private unnamed_addr constant [84 x i8] c"# Intrinsics: ld8 ld16 ld32 ld64 lds8 lds16 lds32 st8 st16 st32 st64, band bor bxor\00"
@.s7743 = private unnamed_addr constant [83 x i8] c"# shl shr sar bnot, ult ule ugt uge udiv urem, addof subof mulof (overflow flags),\00"
@.s7744 = private unnamed_addr constant [85 x i8] c"# fadd fsub fmul fdiv fneg flt fle fgt fge feq fne i2f f2i dbl, cstr addr_of fn_addr\00"
@.s7745 = private unnamed_addr constant [103 x i8] c"# ld8a ld64a (acquire loads) st8a st64a (release stores) cas8 fence (for data shared between threads),\00"
@.s7746 = private unnamed_addr constant [90 x i8] c"# stack_buf frame_addr stack_ptr spill_regs call_ptr callv retv retp trap. p[i] reads and\00"
