@.s749 = private unnamed_addr constant [381 x i8] c"    {\22code\22: \22E0203\22, \22title\22: \22A function was called with the wrong number of arguments\22, \22match\22: [\22but got\22, \22expects exactly\22, \22expects 1 pointer\22, \22takes exactly\22], \22text\22: \22Each function takes a fixed number of arguments (some allow a range). The call has too many\5Cnor too few.\22, \22example\22: \22print(sqrt(1, 2))\22, \22fix\22: \22Pass exactly the arguments that the function takes.\22},\00"
@.s750 = private unnamed_addr constant [424 x i8] c"    {\22code\22: \22E0204\22, \22title\22: \22A value of the wrong type is stored\22, \22match\22: [\22cannot assign\22, \22cannot store\22, \22cannot append\22, \22must be a bool, got\22, \22variable '\22, \22store() cannot change\22], \22text\22: \22A variable keeps the type of its first value, and a list or typed field holds one type.\22, \22example\22: \22let n = 1\5Cnn = \5C\22one\5C\22\22, \22fix\22: \22Use another variable for the new value, or convert it to the type the variable has.\22},\00"
