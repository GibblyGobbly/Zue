@.s748 = private unnamed_addr constant [402 x i8] c"    {\22code\22: \22E0201\22, \22title\22: \22An operator is used on values of the wrong types\22, \22match\22: [\22cannot use '\22], \22text\22: \22Arithmetic needs two numbers of the same type (two ints or two floats); + also joins two\5Cnstrings. int and float never mix, and nothing is converted for you.\22, \22example\22: \22print(1 + \5C\22a\5C\22)\5Cnprint(2 * 1.5)\22, \22fix\22: \22Convert one side on purpose: float(n), round(x), or x as string.\22},\00"
