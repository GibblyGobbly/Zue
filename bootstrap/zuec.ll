@.s744 = private unnamed_addr constant [793 x i8] c"    {\22code\22: \22E0124\22, \22title\22: \22A conversion or its 'else' is written wrongly\22, \22match\22: [\22after 'as'\22, \22needs a value that may be missing\22, \22block of a 'let' must leave\22], \22text\22: \22'as' converts to int, float or string. 'else' after a let, and 'if (let ...)', take a value\5Cnthat may be missing: a conversion that can fail (to int or to float), an index or field read,\5Cnfind, index_of, last_index_of or open. The 'else' block of a let must leave with return, break\5Cnor continue, because after the let the name must hold a value.\22, \22example\22: \22func f(s) \5C{\5Cn    let n = s as int else \5C{\5Cn        print(\5C\22not a number\5C\22)\5Cn    }\5Cn    return n\5Cn}\5Cnprint(f(\5C\224\5C\22))\22, \22fix\22: \22Give a value that may be missing, such as s as int or m[key], and end the 'else' block with\5Cnreturn, break or continue.\22},\00"
@.s745 = private unnamed_addr constant [368 x i8] c"    {\22code\22: \22E0123\22, \22title\22: \22A token other than the expected one was found\22, \22match\22: [\22Expected\22, \22statement outside loop\22, \22defer expects a call\22], \22text\22: \22The parser needed a particular token here (such as a brace after a function header) and\5Cnfound something else.\22, \22example\22: \22if (true)\5Cn    print(1)\22, \22fix\22: \22Add the missing token shown in the message.\22},\00"
