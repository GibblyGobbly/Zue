@.s754 = private unnamed_addr constant [360 x i8] c"    {\22code\22: \22E0208\22, \22title\22: \22Strict mode needs a type that is not known\22, \22match\22: [\22strict mode\22], \22text\22: \22A file that starts with the comment # strict must give a type to every parameter and to\5Cnevery value whose type the checker cannot work out.\22, \22example\22: \22# strict\5Cnfunc add(a, b) \5C{ return a + b }\22, \22fix\22: \22Add types: func add(a: int, b: int).\22},\00"
