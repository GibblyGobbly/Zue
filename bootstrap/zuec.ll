@.s744 = private unnamed_addr constant [675 x i8] c"    {\22code\22: \22E0124\22, \22title\22: \22A conversion or its 'else' is written wrongly\22, \22match\22: [\22after 'as'\22, \22needs a conversion that can fail\22, \22block of a 'let' must leave\22], \22text\22: \22'as' converts to int, float or string. 'else' after a let, and 'if (let ...)', take a\5Cnconversion that can fail (to int or to float), and the 'else' block of a let must leave with\5Cnreturn, break or continue, because after the let the name must hold a value.\22, \22example\22: \22func f(s) \5C{\5Cn    let n = s as int else \5C{\5Cn        print(\5C\22not a number\5C\22)\5Cn    }\5Cn    return n\5Cn}\5Cnprint(f(\5C\224\5C\22))\22, \22fix\22: \22Convert with s as int or float(s), and end the 'else' block with return, break or continue.\22},\00"
