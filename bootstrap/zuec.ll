@.s647 = private unnamed_addr constant [412 x i8] c"    {\22code\22: \22E0101\22, \22title\22: \22A string has no closing quote\22, \22match\22: [\22Unterminated string\22, \22Unterminated character literal\22], \22text\22: \22A string literal starts with a double quote and must end with another one on the same\5Cnline, or on a later line if the text goes on. The end of the file was reached first.\22, \22example\22: \22let name = \5C\22Ann\5Cnprint(name)\22, \22fix\22: \22Add the closing quote: let name = \5C\22Ann\5C\22\22},\00"
@.s648 = private unnamed_addr constant [402 x i8] c"    {\22code\22: \22E0102\22, \22title\22: \22An escape sequence is not known\22, \22match\22: [\22Unknown escape\22, \22A backslash at the end of a line\22], \22text\22: \22Inside a string or a character, a backslash starts an escape such as \5C\5Cn for a new line.\5CnOnly a few escapes exist: \5C\5Cn \5C\5Ct \5C\5Cr \5C\5C\5C\5C \5C\5C\5C\22 \5C\5C' \5C\5C\5C{ \5C\5C} and, in characters, \5C\5C0.\22, \22example\22: \22print(\5C\22a\5C\5Cqb\5C\22)\22, \22fix\22: \22Write \5C\5C\5C\5C for a backslash, or remove it.\22},\00"
@.s649 = private unnamed_addr constant [348 x i8] c"    {\22code\22: \22E0103\22, \22title\22: \22A character is not part of the language\22, \22match\22: [\22Unexpected character\22], \22text\22: \22The source holds a character that Zue does not use outside a string or a comment, such as\5Cn@, $, ? or a letter with an accent.\22, \22example\22: \22let x = 5 @ 3\22, \22fix\22: \22Remove the character, or put it inside a string or a comment.\22},\00"
@.s650 = private unnamed_addr constant [504 x i8] c"    {\22code\22: \22E0104\22, \22title\22: \22A number is written wrongly\22, \22match\22: [\22number literal\22, \22Misplaced '_'\22, \22Integer literal does not fit\22, \22Float literal does not fit\22], \22text\22: \22A number is digits, optionally with a single _ between two digits (1_000), a decimal\5Cnpoint with digits on both sides (2.5), 0x or 0b followed by digits, and it must fit in 64 bits.\22, \22example\22: \22let a = 12abc\5Cnlet b = 1__000\22, \22fix\22: \22Put a space or an operator between a number and a name, and use one _ between digits.\22},\00"
@.s651 = private unnamed_addr constant [349 x i8] c"    {\22code\22: \22E0105\22, \22title\22: \22A character literal is not one character\22, \22match\22: [\22character literal\22], \22text\22: \22A character literal has exactly one character between single quotes, like 'a'. Text with\5Cnmore than one character is a string and goes between double quotes.\22, \22example\22: \22let c = 'ab'\22, \22fix\22: \22Use double quotes for text: \5C\22ab\5C\22\22},\00"
@.s652 = private unnamed_addr constant [521 x i8] c"    {\22code\22: \22E0106\22, \22title\22: \22A string interpolation is not closed or not valid\22, \22match\22: [\22Unclosed string interpolation\22, \22Invalid expression inside string interpolation\22], \22text\22: \22Inside a string, \5C{ starts an expression whose value is put into the text, and } ends it.\5CnThe braces must match and what is between them must be a valid expression.\22, \22example\22: \22print(\5C\22total: \5C{1 +}\5C\22)\5Cnprint(\5C\22open: \5C{x\5C\22)\22, \22fix\22: \22Close the brace and write a complete expression, or write \5C\5C\5C{ for a brace that is only text.\22},\00"
@.s653 = private unnamed_addr constant [385 x i8] c"    {\22code\22: \22E0110\22, \22title\22: \22An expression was expected\22, \22match\22: [\22expected an expression\22, \22Unexpected semicolon\22], \22text\22: \22The program has a token where a value, a name or a call should be. A statement ends at the\5Cnend of the line, so a semicolon is not needed.\22, \22example\22: \22let a = 1 +* 2\5Cnlet b =\22, \22fix\22: \22Write the missing value, or remove the extra operator or token.\22},\00"
@.s654 = private unnamed_addr constant [421 x i8] c"    {\22code\22: \22E0111\22, \22title\22: \22A closing bracket, brace or parenthesis is missing\22, \22match\22: [\22Expected ')'\22, \22Expected ']'\22, \22Expected '}'\22, \22Expected '>'\22], \22text\22: \22Every ( [ and \5C{ must be closed by ) ] and } in the right order. The message points at the\5Cnplace where the closer was expected and at the opener that was never closed.\22, \22example\22: \22print((1 + 2)\22, \22fix\22: \22Add the closing bracket where it belongs.\22},\00"
@.s655 = private unnamed_addr constant [286 x i8] c"    {\22code\22: \22E0112\22, \22title\22: \22A closing brace has no opening brace\22, \22match\22: [\22there is no block to close\22], \22text\22: \22A } ends a block that a \5C{ started, but there is no open block here.\22, \22example\22: \22let a = 1\5Cn}\22, \22fix\22: \22Remove the extra }, or add the \5C{ that it should close.\22},\00"
@.s656 = private unnamed_addr constant [320 x i8] c"    {\22code\22: \22E0113\22, \22title\22: \22A name is declared twice in one scope\22, \22match\22: [\22is already declared\22], \22text\22: \22Inside one block, a variable, parameter, function or type name can be declared once.\22, \22example\22: \22let x = 1\5Cnlet x = 2\22, \22fix\22: \22Use another name, or assign to the existing variable without let: x = 2\22},\00"
@.s657 = private unnamed_addr constant [550 x i8] c"    {\22code\22: \22E0114\22, \22title\22: \22A name was expected\22, \22match\22: [\22Expected variable name\22, \22Expected parameter name\22, \22Expected function name\22, \22Expected a name after\22, \22Expected field name\22, \22Expected loop variable name\22, \22Expected exported name\22], \22text\22: \22A declaration needs a name made of letters, digits and _, not starting with a digit. Words\5Cnsuch as let, func, if, template, bloc, box, unsafe, use, export and case are keywords and cannot\5Cnbe names.\22, \22example\22: \22let template = 3\5Cnfunc case() \5C{ return 1 }\22, \22fix\22: \22Choose another name.\22},\00"
@.s658 = private unnamed_addr constant [312 x i8] c"    {\22code\22: \22E0115\22, \22title\22: \22A parameter without a default follows one with a default\22, \22match\22: [\22needs a default value\22], \22text\22: \22Once a parameter has a default, every parameter after it must have one too.\22, \22example\22: \22func f(a = 1, b) \5C{ return a + b }\22, \22fix\22: \22Give b a default, or put it before a.\22},\00"
@.s659 = private unnamed_addr constant [371 x i8] c"    {\22code\22: \22E0116\22, \22title\22: \22Something that is not a variable is changed\22, \22match\22: [\22Invalid assignment target\22, \22can only be applied to variables\22], \22text\22: \22The left side of = and the operand of ++ and -- must be a variable, an item such as\5Cnlist[0], or a field such as point.x.\22, \22example\22: \22f() = 3\5Cnxs[0]++\22, \22fix\22: \22Assign to a variable, an item or a field.\22},\00"
@.s660 = private unnamed_addr constant [306 x i8] c"    {\22code\22: \22E0117\22, \22title\22: \22A declaration has the wrong number of values\22, \22match\22: [\22Variable count\22, \22const declarations require\22], \22text\22: \22let a, b = 1, 2 needs one value for each name, and a const needs a value.\22, \22example\22: \22let a, b = 1, 2, 3\5Cnconst k\22, \22fix\22: \22Give one value for each name.\22},\00"
@.s661 = private unnamed_addr constant [411 x i8] c"    {\22code\22: \22E0118\22, \22title\22: \22A type annotation is not valid\22, \22match\22: [\22Expected a type after\22, \22take an element type\22, \22to close the element type\22], \22text\22: \22After a colon you may write int, float, bool, char, string, list, map, function or the name\5Cnof one of your types. Only list and map take an element type in angle brackets.\22, \22example\22: \22let x: int< = 1\22, \22fix\22: \22Write a type such as list<int>.\22},\00"
@.s662 = private unnamed_addr constant [256 x i8] c"    {\22code\22: \22E0119\22, \22title\22: \22A map literal key is not a string\22, \22match\22: [\22Map literal keys\22], \22text\22: \22In a map literal such as \5C{\5C\22a\5C\22: 1}, each key is a plain string.\22, \22example\22: \22let m = \5C{1: 2}\22, \22fix\22: \22Write the key as a string: \5C{\5C\221\5C\22: 2}\22},\00"
@.s663 = private unnamed_addr constant [408 x i8] c"    {\22code\22: \22E0120\22, \22title\22: \22A field declaration is not allowed\22, \22match\22: [\22fields cannot have types\22, \22give a type to every field\22, \22box field needs\22], \22text\22: \22A data type has untyped fields; use a template for typed fields. A bloc types all its fields\5Cnor none. A box field is written box[16] with a number.\22, \22example\22: \22data D \5C{ a: int }\22, \22fix\22: \22Use template, or type every field of the bloc.\22},\00"
@.s664 = private unnamed_addr constant [446 x i8] c"    {\22code\22: \22E0121\22, \22title\22: \22A use or export is not valid\22, \22match\22: [\22export can only be used\22, \22export cannot be used\22, \22Expected string path\22, \22Expected 'from'\22], \22text\22: \22use \5C{ name } from \5C\22file.zu\5C\22 brings names in, and export may go before func, const, template,\5Cnbloc and data. A let is not exported: it can change, and an importer would keep a stale copy.\22, \22example\22: \22export print(1)\22, \22fix\22: \22Write a declaration after export.\22},\00"
@.s665 = private unnamed_addr constant [301 x i8] c"    {\22code\22: \22E0122\22, \22title\22: \22A switch has something other than case or default\22, \22match\22: [\22Expected 'case' or 'default'\22], \22text\22: \22Inside switch (x) \5C{ ... } only case and default clauses may appear.\22, \22example\22: \22switch (x) \5C{ print(1) }\22, \22fix\22: \22Put the statements under a case or default.\22},\00"
