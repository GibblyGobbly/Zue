@.s7688 = private unnamed_addr constant [66 x i8] c"#   let counter = 0                  a module-level word variable\00"
@.s7689 = private unnamed_addr constant [74 x i8] c"#   extern(\22snprintf\22, \22i32\22, \22ptr,i64,ptr,...\22)    declares a C function\00"
