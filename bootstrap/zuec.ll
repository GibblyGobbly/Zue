@.s771 = private unnamed_addr constant [512 x i8] c"    {\22code\22: \22E0414\22, \22title\22: \22A conversion would change the value\22, \22match\22: [\22is not a whole number\22, \22has no exact float\22, \22is not a character code\22], \22text\22: \22A conversion keeps the value exactly. A float with a fraction has no int (rounding is a\5Cnchoice, so it has its own functions), a very large int has no exact float, and a char holds\5Cnone byte, a code from 0 to 255.\22, \22example\22: \22print(int(2.5))\22, \22fix\22: \22Round on purpose with round(x), floor(x), ceil(x) or trunc(x), or keep the value as it is.\22},\00"
