# ast_nodes.zu: the syntax tree node type and the functions that build them.
#
# Every node is one template, Node, whatever its kind: k (the kind, a string) says which of its fields
# the node uses, and the other fields stay empty (null). One type for every node lets a variable or a
# list hold nodes of any kind with its type known. line, col, eline and ecol are the place of the node in
# the source: the line and column of its first byte and the line and column just after its last byte
# (columns count bytes from 1). A node made by the compiler itself keeps col 0, which means "no place
# known beyond the line". The fields read most come first, because a field is found by its name.
# Fields that end in span hold a Span, the place of a name, an operator, a type or an argument list, so
# the checker can point at exactly that text; the spans lists hold a Span or null per item.
# The checker adds sty to let and for-in nodes (and stys, the same per signature of the function that
# holds them) and spec to call nodes (the signature of a direct call, see check.zu), and ads and ad to
# whole-number literals (what the literal becomes per signature, see adapt_to in check.zu), and the
# emitter caches the raw kind of a binary node in kc. A literal keeps its value as text in v: digits for
# num and float, the text for str, "true" or "false" for bool, the character code for char. A func node
# keeps the result type written after -> in rtype (null when none), and its place in rspan.
# NODE_FIELDS lists the fields each kind uses besides k, line and the places; ast_dump.zu and the tree
# walkers read it. A possible later form, smaller in memory, is in docs/plan.md (phase 4).

use { Token } from "lexer.zu"
use { Span, span_at, span_line } from "diag.zu"

export template Node {
    k: string, line: int, name: string, v: string, op: string, l: Node, r: Node, e: Node, callee: Node,
    args: list<Node>, target: Node, index: Node, field: string, body: list<Node>, cond: Node, then: list<Node>,
    els: list<Node>, items: list<Node>, init: Node, iter: Node, incr: Node, params: list<string>,
    defaults: list<Node>, ptypes: list<string>, exported: bool, type: string, sty: string, stys: map<string>, spec: string,
    kc: string, ads: map<string>, ad: string, unary: bool, prefix: bool, const_decl: bool, orelse: list<Node>,
    keys: list<string>, vals: list<Node>, parts: list<Node>, size: Node, lo: Node, hi: Node, cases: list<Node>,
    dflt: list<Node>, is_template: bool, is_bloc: bool, fields: list<string>, ftypes: list<string>, path: string,
    names: list<string>, col: int, eline: int, ecol: int, nspan: Span, ospan: Span, aspan: Span, fspan: Span,
    pspan: Span, tspan: Span, nspans: list<Span>, pspans: list<Span>, tspans: list<Span>, fspans: list<Span>, rtype: string, rspan: Span, chk: string
}

# A node of kind k from token (or node) st to en, every other field empty.
func node(k: string, st: Token, en: Token) {
    return Node(k, st.line, null, null, null, null, null, null, null, null, null, null, null, null, null, null,
        null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null,
        null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null,
        null, null, st.col, en.eline, en.ecol, null, null, null, null, null, null, null, null, null,
        null, null, null, null)
}

# The place of a token as a Span, or null.
func sp(x: Token) -> Span {
    if (x == null) {
        return null
    }
    return span_at(x.line, x.col, x.eline, x.ecol)
}

# The place of a node as a Span (its line and columns as the parser saw them), or null.
func nsp(x: Node) -> Span {
    if (x == null) {
        return null
    }
    return span_at(x.line, x.col, x.eline, x.ecol)
}

# A token standing for a place, so a node can be made from a span or another node.
export func span_token(s: Span) -> Token {
    return Token("", "", [], s.line, s.col, s.eline, s.ecol)
}

export func node_token(n: Node) -> Token {
    return Token("", "", [], n.line, n.col, n.eline, n.ecol)
}

export const NODE_FIELDS: map<list<string>> = {
    "num": ["v", "ads", "ad"], "float": ["v"], "str": ["v"], "char": ["v"], "bool": ["v"], "text": ["v"],
    "id": ["name"],
    "tmpl": ["parts"],
    "list": ["items"],
    "map": ["keys", "vals"],
    "func": ["name", "params", "defaults", "ptypes", "body", "exported", "rtype", "chk"],
    "box": ["size"],
    "call": ["callee", "args", "spec", "names"],
    "absent": [],
    "index": ["target", "index"],
    "slice": ["target", "lo", "hi"],
    "field": ["target", "field"],
    "incdec": ["name", "op", "prefix"],
    "bin": ["op", "l", "r", "unary", "kc"],
    "not": ["e"],
    "let": ["name", "init", "exported", "const_decl", "type", "sty", "stys", "orelse", "chk"],
    "group": ["items"],
    "if": ["cond", "then", "els"],
    "forin": ["name", "iter", "body", "sty", "stys"],
    "for": ["init", "cond", "incr", "body"],
    "while": ["cond", "body"],
    "switch": ["e", "cases", "dflt"],
    "case": ["e", "body"],
    "assign": ["name", "e"],
    "setidx": ["target", "index", "e", "op"],
    "typedef": ["exported", "name", "is_template", "is_bloc", "fields", "ftypes"],
    "use": ["names", "path"],
    "block": ["body"], "unsafe": ["body"],
    "return": ["e"],
    "break": [], "continue": []
}

# Fields that a node may not have set at all. ast_dump.zu leaves them out when they are null.
export const OPTIONAL_FIELDS: list<string> = ["rtype", "ptypes", "type", "const_decl", "unary", "kc", "sty", "stys", "spec", "ads", "ad", "orelse", "names", "chk"]

# The constructors take st and en, the first and the last token of the node (a node can stand for
# either: anything with line, col, eline and ecol). The node starts at st and ends where en ends, and
# its line is the line of st. An argument that ends in span is a token or a Span, or null.
# Evaluate the children before reading the parser's last token for en: arguments are read in order.

export func mk_lit(k: string, st: Token, en: Token, v: string) {
    let n = node(k, st, en)
    n.v = v
    return n
}

export func mk_id(st: Token, en: Token, name: string) {
    let n = node("id", st, en)
    n.name = name
    return n
}

# An id node for a name made by the compiler, with no place in the source but its line.
export func mk_id_line(line: int, name: string) {
    let at = span_at(line, 0, line, 0)
    let n = node("id", span_token(at), span_token(at))
    n.name = name
    return n
}

export func mk_tmpl(st: Token, en: Token, parts: list<Node>) {
    let n = node("tmpl", st, en)
    n.parts = parts
    return n
}

export func mk_list(st: Token, en: Token, items: list<Node>) {
    let n = node("list", st, en)
    n.items = items
    return n
}

export func mk_map(st: Token, en: Token, keys: list<string>, vals: list<Node>) {
    let n = node("map", st, en)
    n.keys = keys
    n.vals = vals
    return n
}

# nspan is the name of a named function; pspans the parameter names, tspans their type annotations.
export func mk_func(st: Token, en: Token, name: string, params: list<string>, defaults: list<Node>, ptypes: list<string>, body: list<Node>, exported: bool, nspan: Token, pspans: list<Span>, tspans: list<Span>, rtype: string = null, rspan: Span = null) {
    let n = node("func", st, en)
    n.name = name
    n.params = params
    n.defaults = defaults
    n.ptypes = ptypes
    n.body = body
    n.exported = exported
    n.nspan = sp(nspan)
    n.pspans = pspans
    n.tspans = tspans
    n.rtype = rtype
    n.rspan = rspan
    return n
}

export func mk_box(st: Token, en: Token, size: Node) {
    let n = node("box", st, en)
    n.size = size
    return n
}

# aspan is the argument list with its brackets.
export func mk_call(st: Token, en: Token, callee: Node, args: list<Node>, aspan: Span) {
    let n = node("call", st, en)
    n.callee = callee
    n.args = args
    n.aspan = aspan
    return n
}

export func mk_index(st: Token, en: Token, target: Node, index: Node) {
    let n = node("index", st, en)
    n.target = target
    n.index = index
    return n
}

# target[lo:hi]: positions from lo to hi, counting from 0, both included. lo or hi is null when left out.
export func mk_slice(st: Token, en: Token, target: Node, lo: Node, hi: Node) {
    let n = node("slice", st, en)
    n.target = target
    n.lo = lo
    n.hi = hi
    return n
}

export func mk_field(st: Token, en: Token, target: Node, field: string, fspan: Token) {
    let n = node("field", st, en)
    n.target = target
    n.field = field
    n.fspan = sp(fspan)
    return n
}

export func mk_incdec(st: Token, en: Token, name: string, op: string, prefix: bool, nspan: Token) {
    let n = node("incdec", st, en)
    n.name = name
    n.op = op
    n.prefix = prefix
    n.nspan = sp(nspan)
    return n
}

# ospan is the operator.
export func mk_bin(st: Token, en: Token, op: string, l: Node, r: Node, ospan: Token) {
    let n = node("bin", st, en)
    n.op = op
    n.l = l
    n.r = r
    n.ospan = sp(ospan)
    return n
}

# Unary minus is stored as 0 - r, with unary set.
export func mk_neg(st: Token, en: Token, zero: Node, r: Node, ospan: Token) {
    let n = node("bin", st, en)
    n.op = "-"
    n.l = zero
    n.r = r
    n.unary = true
    n.ospan = sp(ospan)
    return n
}

export func mk_not(st: Token, en: Token, e: Node) {
    let n = node("not", st, en)
    n.e = e
    return n
}

export func mk_let(st: Token, en: Token, name: string, init: Node, exported: bool, const_decl: bool, type: string, nspan: Span, tspan: Span) {
    let n = node("let", st, en)
    n.name = name
    n.init = init
    n.exported = exported
    n.const_decl = const_decl
    if (type != "") {
        n.type = type
    }
    n.nspan = nspan
    n.tspan = tspan
    return n
}

export func mk_group(st: Token, en: Token, items: list<Node>) {
    let n = node("group", st, en)
    n.items = items
    return n
}

export func mk_if(st: Token, en: Token, cond: Node, then: list<Node>, els: list<Node>) {
    let n = node("if", st, en)
    n.cond = cond
    n.then = then
    n.els = els
    return n
}

export func mk_forin(st: Token, en: Token, name: string, iter: Node, body: list<Node>, nspan: Token) {
    let n = node("forin", st, en)
    n.name = name
    n.iter = iter
    n.body = body
    n.nspan = sp(nspan)
    return n
}

export func mk_for(st: Token, en: Token, init: Node, cond: Node, incr: Node, body: list<Node>) {
    let n = node("for", st, en)
    n.init = init
    n.cond = cond
    n.incr = incr
    n.body = body
    return n
}

export func mk_while(st: Token, en: Token, cond: Node, body: list<Node>) {
    let n = node("while", st, en)
    n.cond = cond
    n.body = body
    return n
}

export func mk_switch(st: Token, en: Token, e: Node, cases: list<Node>, dflt: list<Node>) {
    let n = node("switch", st, en)
    n.e = e
    n.cases = cases
    n.dflt = dflt
    return n
}

# A case of a switch: its value and its statements.
export func mk_case(st: Token, e: Node, body: list<Node>) {
    let n = node("case", st, st)
    n.e = e
    n.body = body
    return n
}

export func mk_assign(st: Token, en: Token, name: string, e: Node, nspan: Node) {
    let n = node("assign", st, en)
    n.name = name
    n.e = e
    n.nspan = nsp(nspan)
    return n
}

export func mk_setidx(st: Token, en: Token, target: Node, index: Node, e: Node, op: string) {
    let n = node("setidx", st, en)
    n.target = target
    n.index = index
    n.e = e
    n.op = op
    return n
}

# nspan is the name; fspans the field names.
export func mk_typedef(st: Token, en: Token, exported: bool, name: string, is_template: bool, is_bloc: bool, fields: list<string>, ftypes: list<string>, nspan: Token, fspans: list<Span>) {
    let n = node("typedef", st, en)
    n.exported = exported
    n.name = name
    n.is_template = is_template
    n.is_bloc = is_bloc
    n.fields = fields
    n.ftypes = ftypes
    n.nspan = sp(nspan)
    n.fspans = fspans
    return n
}

# pspan is the path string; nspans the imported names.
export func mk_use(st: Token, en: Token, names: list<string>, path: string, pspan: Token, nspans: list<Span>) {
    let n = node("use", st, en)
    n.names = names
    n.path = path
    n.pspan = sp(pspan)
    n.nspans = nspans
    return n
}

# k is "block" for a bare { } block and "unsafe" for an unsafe block.
export func mk_block(k: string, st: Token, en: Token, body: list<Node>) {
    let n = node(k, st, en)
    n.body = body
    return n
}

export func mk_return(st: Token, en: Token, e: Node) {
    let n = node("return", st, en)
    n.e = e
    return n
}

# k is "break" or "continue".
export func mk_jump(k: string, st: Token, en: Token) {
    let n = node(k, st, en)
    return n
}

# The place of a node: the whole node, or only its line when it has no column.
export func node_span(n: Node) -> Span {
    if (n.col == 0) {
        return span_line(n.line)
    }
    return span_at(n.line, n.col, n.eline, n.ecol)
}

# The kind of a syntax tree node.
export func node_kind(x: Node) -> string {
    return x.k
}

# The nodes directly inside x, in the order of the fields of its kind (NODE_FIELDS). An empty field or
# list item is left out. The tree walkers use it to visit every part of a tree.
export func node_children(x: Node) -> list<Node> {
    let out: list<Node> = []
    for (let name in NODE_FIELDS[x.k]) {
        add_child(out, x, name)
    }
    return out
}

func add_node(out: list<Node>, y: Node) {
    if (y != null) {
        append(out, y)
    }
}

func add_nodes(out: list<Node>, ys: list<Node>) {
    if (ys == null) {
        return null
    }
    for (let y in ys) {
        add_node(out, y)
    }
}

# Adds what field name of x holds when it is a node or a list of nodes.
func add_child(out: list<Node>, x: Node, name: string) {
    add_node(out, child_node(x, name))
    add_nodes(out, child_list(x, name))
}

# The node field name of x holds, or null when it is empty or not a node field.
export func child_node(x: Node, name: string) -> Node {
    if (name == "l") {
        return x.l
    } else if (name == "r") {
        return x.r
    } else if (name == "e") {
        return x.e
    } else if (name == "callee") {
        return x.callee
    } else if (name == "target") {
        return x.target
    } else if (name == "index") {
        return x.index
    } else if (name == "cond") {
        return x.cond
    } else if (name == "init") {
        return x.init
    } else if (name == "iter") {
        return x.iter
    } else if (name == "incr") {
        return x.incr
    } else if (name == "size") {
        return x.size
    } else if (name == "lo") {
        return x.lo
    } else if (name == "hi") {
        return x.hi
    }
    return null
}

# The list of nodes field name of x holds: null when the field is empty, [] when it is not such a field.
export func child_list(x: Node, name: string) -> list<Node> {
    if (name == "args") {
        return x.args
    } else if (name == "body") {
        return x.body
    } else if (name == "then") {
        return x.then
    } else if (name == "els") {
        return x.els
    } else if (name == "items") {
        return x.items
    } else if (name == "orelse") {
        return x.orelse
    } else if (name == "vals") {
        return x.vals
    } else if (name == "parts") {
        return x.parts
    } else if (name == "cases") {
        return x.cases
    } else if (name == "dflt") {
        return x.dflt
    } else if (name == "defaults") {
        return x.defaults
    }
    return []
}

# Every node in xs and inside them, each before the nodes inside it.
export func nodes_under(xs: list<Node>) -> list<Node> {
    let out: list<Node> = []
    let stack: list<Node> = []
    let i = len(xs) - 1
    while (i >= 0) {
        add_node(stack, xs[i])
        i -= 1
    }
    while (len(stack) > 0) {
        let n = remove(stack, len(stack) - 1)
        append(out, n)
        let kids = node_children(n)
        let k = len(kids) - 1
        while (k >= 0) {
            append(stack, kids[k])
            k -= 1
        }
    }
    return out
}
