# ast_nodes.zu: the syntax tree node type and the functions that build them.
#
# Every node is one template, Node, whatever its kind: k (the kind, a string) says which of its fields
# the node uses, and the other fields stay empty (null). One type for every node lets a variable or a
# list hold nodes of any kind with its type known. line, col, eline and ecol are the place of the node in
# the source: the line and column of its first byte and the line and column just after its last byte
# (columns count bytes from 1). A node made by the compiler itself keeps col 0, which means "no place
# known beyond the line". The fields read most come first, because a field is found by its name.
# Fields that end in span hold a Span, the place of a name, an operator, a type or an argument list, so
# the checker can point at exactly that text; the spans lists hold a Span or null per item.
# The checker adds sty to let and for-in nodes (and stys, the same per signature of the function that
# holds them) and spec to call nodes (the signature of a direct call, see check.zu), and ads and ad to
# whole-number literals (what the literal becomes per signature, see adapt_to in check.zu), and the
# emitter caches the raw kind of a binary node in kc. A literal keeps its value as text in v: digits for
# num and float, the text for str, "true" or "false" for bool, the character code for char. A func node
# keeps the result type written after -> in rtype (null when none), and its place in rspan.
# NODE_FIELDS lists the fields each kind uses besides k, line and the places; ast_dump.zu and the tree
# walkers read it. A possible later form, smaller in memory, is in docs/plan.md (phase 4).

use { Span, span_at } from "diag.zu"

export template Node {
    k: string, line: int, name: string, v: string, op: string, l: Node, r: Node, e: Node, callee: Node,
    args: list<Node>, target: Node, index: Node, field: string, body: list<Node>, cond: Node, then: list<Node>,
    els: list<Node>, items: list<Node>, init: Node, iter: Node, incr: Node, params: list<string>,
    defaults: list, ptypes: list, exported: bool, type: string, sty: string, stys: map<string>, spec: string,
    kc: string, ads: map<string>, ad: string, unary: bool, prefix: bool, const_decl: bool, orelse: list<Node>,
    keys: list<string>, vals: list<Node>, parts: list, size: Node, lo: Node, hi: Node, cases: list,
    dflt: list<Node>, is_template: bool, is_bloc: bool, fields: list<string>, ftypes: list, path: string,
    names: list, col: int, eline: int, ecol: int, nspan: Span, ospan: Span, aspan: Span, fspan: Span,
    pspan: Span, tspan: Span, nspans: list, pspans: list, tspans: list, fspans: list, rtype: string, rspan: Span
}

# A node of kind k from token (or node) st to en, every other field empty.
func node(k, st, en) {
    return Node(k, st.line, null, null, null, null, null, null, null, null, null, null, null, null, null, null,
        null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null,
        null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null,
        null, null, st.col, en.eline, en.ecol, null, null, null, null, null, null, null, null, null,
        null, null, null)
}

# The place of a token, a Span or a node as a Span, or null.
func sp(x) {
    if (x == null) {
        return null
    }
    return span_at(x.line, x.col, x.eline, x.ecol)
}

export const NODE_FIELDS = {
    "num": ["v", "ads", "ad"], "float": ["v"], "str": ["v"], "char": ["v"], "bool": ["v"],
    "id": ["name"],
    "tmpl": ["parts"],
    "list": ["items"],
    "map": ["keys", "vals"],
    "func": ["name", "params", "defaults", "ptypes", "body", "exported", "rtype"],
    "box": ["size"],
    "call": ["callee", "args", "spec", "names"],
    "absent": [],
    "index": ["target", "index"],
    "slice": ["target", "lo", "hi"],
    "field": ["target", "field"],
    "incdec": ["name", "op", "prefix"],
    "bin": ["op", "l", "r", "unary", "kc"],
    "not": ["e"],
    "let": ["name", "init", "exported", "const_decl", "type", "sty", "stys", "orelse"],
    "group": ["items"],
    "if": ["cond", "then", "els"],
    "forin": ["name", "iter", "body", "sty", "stys"],
    "for": ["init", "cond", "incr", "body"],
    "while": ["cond", "body"],
    "switch": ["e", "cases", "dflt"],
    "assign": ["name", "e"],
    "setidx": ["target", "index", "e", "op"],
    "typedef": ["exported", "name", "is_template", "is_bloc", "fields", "ftypes"],
    "use": ["names", "path"],
    "block": ["body"], "unsafe": ["body"],
    "return": ["e"],
    "break": [], "continue": []
}

# Fields that a node may not have set at all. ast_dump.zu leaves them out when they are null.
export const OPTIONAL_FIELDS = ["rtype", "ptypes", "type", "const_decl", "unary", "kc", "sty", "stys", "spec", "ads", "ad", "orelse", "names"]

# The constructors take st and en, the first and the last token of the node (a node can stand for
# either: anything with line, col, eline and ecol). The node starts at st and ends where en ends, and
# its line is the line of st. An argument that ends in span is a token or a Span, or null.
# Evaluate the children before reading the parser's last token for en: arguments are read in order.

export func mk_lit(k, st, en, v) {
    let n = node(k, st, en)
    n.v = v
    return n
}

export func mk_id(st, en, name) {
    let n = node("id", st, en)
    n.name = name
    return n
}

# An id node for a name made by the compiler, with no place in the source but its line.
export func mk_id_line(line, name) {
    let at = span_at(line, 0, line, 0)
    let n = node("id", at, at)
    n.name = name
    return n
}

export func mk_tmpl(st, en, parts) {
    let n = node("tmpl", st, en)
    n.parts = parts
    return n
}

export func mk_list(st, en, items) {
    let n = node("list", st, en)
    n.items = items
    return n
}

export func mk_map(st, en, keys, vals) {
    let n = node("map", st, en)
    n.keys = keys
    n.vals = vals
    return n
}

# nspan is the name of a named function; pspans the parameter names, tspans their type annotations.
export func mk_func(st, en, name, params, defaults, ptypes, body, exported, nspan, pspans, tspans, rtype = null, rspan = null) {
    let n = node("func", st, en)
    n.name = name
    n.params = params
    n.defaults = defaults
    n.ptypes = ptypes
    n.body = body
    n.exported = exported
    n.nspan = sp(nspan)
    n.pspans = pspans
    n.tspans = tspans
    n.rtype = rtype
    n.rspan = sp(rspan)
    return n
}

export func mk_box(st, en, size) {
    let n = node("box", st, en)
    n.size = size
    return n
}

# aspan is the argument list with its brackets.
export func mk_call(st, en, callee, args, aspan) {
    let n = node("call", st, en)
    n.callee = callee
    n.args = args
    n.aspan = sp(aspan)
    return n
}

export func mk_index(st, en, target, index) {
    let n = node("index", st, en)
    n.target = target
    n.index = index
    return n
}

# target[lo:hi]: positions from lo to hi, counting from 0, both included. lo or hi is null when left out.
export func mk_slice(st, en, target, lo, hi) {
    let n = node("slice", st, en)
    n.target = target
    n.lo = lo
    n.hi = hi
    return n
}

export func mk_field(st, en, target, field, fspan) {
    let n = node("field", st, en)
    n.target = target
    n.field = field
    n.fspan = sp(fspan)
    return n
}

export func mk_incdec(st, en, name, op, prefix, nspan) {
    let n = node("incdec", st, en)
    n.name = name
    n.op = op
    n.prefix = prefix
    n.nspan = sp(nspan)
    return n
}

# ospan is the operator.
export func mk_bin(st, en, op, l, r, ospan) {
    let n = node("bin", st, en)
    n.op = op
    n.l = l
    n.r = r
    n.ospan = sp(ospan)
    return n
}

# Unary minus is stored as 0 - r, with unary set.
export func mk_neg(st, en, zero, r, ospan) {
    let n = node("bin", st, en)
    n.op = "-"
    n.l = zero
    n.r = r
    n.unary = true
    n.ospan = sp(ospan)
    return n
}

export func mk_not(st, en, e) {
    let n = node("not", st, en)
    n.e = e
    return n
}

export func mk_let(st, en, name, init, exported, const_decl, type, nspan, tspan) {
    let n = node("let", st, en)
    n.name = name
    n.init = init
    n.exported = exported
    n.const_decl = const_decl
    n.type = type
    n.nspan = sp(nspan)
    n.tspan = sp(tspan)
    return n
}

export func mk_group(st, en, items) {
    let n = node("group", st, en)
    n.items = items
    return n
}

export func mk_if(st, en, cond, then, els) {
    let n = node("if", st, en)
    n.cond = cond
    n.then = then
    n.els = els
    return n
}

export func mk_forin(st, en, name, iter, body, nspan) {
    let n = node("forin", st, en)
    n.name = name
    n.iter = iter
    n.body = body
    n.nspan = sp(nspan)
    return n
}

export func mk_for(st, en, init, cond, incr, body) {
    let n = node("for", st, en)
    n.init = init
    n.cond = cond
    n.incr = incr
    n.body = body
    return n
}

export func mk_while(st, en, cond, body) {
    let n = node("while", st, en)
    n.cond = cond
    n.body = body
    return n
}

export func mk_switch(st, en, e, cases, dflt) {
    let n = node("switch", st, en)
    n.e = e
    n.cases = cases
    n.dflt = dflt
    return n
}

export func mk_assign(st, en, name, e, nspan) {
    let n = node("assign", st, en)
    n.name = name
    n.e = e
    n.nspan = sp(nspan)
    return n
}

export func mk_setidx(st, en, target, index, e, op) {
    let n = node("setidx", st, en)
    n.target = target
    n.index = index
    n.e = e
    n.op = op
    return n
}

# nspan is the name; fspans the field names.
export func mk_typedef(st, en, exported, name, is_template, is_bloc, fields, ftypes, nspan, fspans) {
    let n = node("typedef", st, en)
    n.exported = exported
    n.name = name
    n.is_template = is_template
    n.is_bloc = is_bloc
    n.fields = fields
    n.ftypes = ftypes
    n.nspan = sp(nspan)
    n.fspans = fspans
    return n
}

# pspan is the path string; nspans the imported names.
export func mk_use(st, en, names, path, pspan, nspans) {
    let n = node("use", st, en)
    n.names = names
    n.path = path
    n.pspan = sp(pspan)
    n.nspans = nspans
    return n
}

# k is "block" for a bare { } block and "unsafe" for an unsafe block.
export func mk_block(k, st, en, body) {
    let n = node(k, st, en)
    n.body = body
    return n
}

export func mk_return(st, en, e) {
    let n = node("return", st, en)
    n.e = e
    return n
}

# k is "break" or "continue".
export func mk_jump(k, st, en) {
    let n = node(k, st, en)
    return n
}

export func is_node(x) {
    return type(x) == "template"
}

# The values inside x that can hold more nodes: lists, maps and nodes. x is a node, or a map such as
# a switch case. The tree walkers use it to visit every part of a tree.
# The kind of a syntax tree node, or null for a map that is not a node (a switch case, a string part).
export func node_kind(x) {
    if (type(x) == "template") {
        return x.k
    }
    return map_get(x, "k", null)
}

export func node_children(x) {
    let out = []
    if (type(x) == "map") {
        for (let y in map_values(x)) {
            let t = type(y)
            if (t == "list" or t == "map" or t == "template") {
                append(out, y)
            }
        }
        return out
    }
    for (let name in NODE_FIELDS[x.k]) {
        let y = x[name]
        let t = type(y)
        if (t == "list" or t == "map" or t == "template") {
            append(out, y)
        }
    }
    return out
}
