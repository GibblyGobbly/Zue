# named_args.zu: turns the named arguments of each call (greet("Ann", greeting: "Hi")) into positional
# ones, before the checker runs. The called function must be known when the program is built: a function
# of this file or of an imported one, a template or bloc (its fields), or a builtin (BUILTIN_PARAMS).
# Named arguments come after the positional ones and in the order of the parameters, so the arguments
# still run in the order they are written. A parameter left out that has a default gets an "absent" node,
# which the called function reads as not given.

use { NODE_FIELDS, Node, child_list, child_node, mk_jump, node_span, node_token, nodes_under } from "ast_nodes.zu"
use { Span, diag_new, diag_text, diag_label, diag_hint, diag_exit_if_errors, diag_count, suggest } from "diag.zu"
use { parse_source } from "parser.zu"
use { BUILTINS } from "shared.zu"
use { ST } from "state.zu"
use { path_dir, path_join, path_norm, split_lines } from "util.zu"

# The parameter names of the builtins that take named arguments. A builtin that takes more than one kind
# of argument list (min, max, rand, slice, contains), any number of arguments (print, spawn) or works
# inside unsafe is left out.
let BUILTIN_PARAMS: map<list<string>> = {}

func add_params(text: string) {
    for (let entry in split(text, ";")) {
        let parts = split(trim(entry), " ")
        let names: list<string> = []
        for (let i = 1; i < len(parts); i++) {
            append(names, parts[i])
        }
        BUILTIN_PARAMS[parts[0]] = names
    }
}

add_params("len v; str_len s; append list v; list_append list v; type v; int v; float v; string v; code c; char n; to_string x digits; fixed x decimals; assert cond; input prompt; debug v; range start end step; args; exit code; system cmd; clock")
add_params("map_set m key v; map_get m key fallback; map_has m key; map_delete m key; map_keys m; map_values m; map_items m; remove list i; find list v; sort list; map list fn; filter list fn; reduce list fn init; is_empty s")
add_params("concat s1 s2; substring s start n; char_at s i; index_of s sub start; index_of_any s set start; skip_chars s set start; last_index_of s sub; starts_with s pre; ends_with s suf; to_upper s; to_lower s; trim s; trim_left s; trim_right s; replace s old new; reverse s; repeat s n; pad_left s w ch; pad_right s w ch; split s sep; join list sep; is_digit s; is_alpha s; is_alnum s; is_space s")
add_params("abs x; clamp x lo hi; sign x; pow base exp; sqrt x; cbrt x; exp x; ln x; log10 x; sin x; cos x; tan x; asin x; acos x; atan x; atan2 y x; sinh x; cosh x; tanh x; floor x; ceil x; round x digits; trunc x; fract x; mod x y; floor_div x y; divmod x y; sum list; mean list; gcd a b; lcm a b; isqrt n; lerp a b t; deg_to_rad d; rad_to_deg r")
add_params("open path mode; close handle; read handle; read_line handle; write handle text; file_exists path; remove_file path; flush handle; dense_list n fill; vec_add a b; vec_sub a b; vec_mul a b; vec_div a b; vec_mul_inline a b; mat_mul a b; srand seed; shuffle list; tshuffle list; ssort list; shape v; wait thread; yield; channel n; send ch v; recv ch; channel_close ch")

# The top-level statements of imported files, by path, parsed once.
let IMPORTED: map<list<Node>> = {}

# What a name in a scope is: kind "func" or "typedef" (with its node), "var", or "import" (the path of
# the file and the name there).
template Decl { kind: string, node: Node, path: string, name: string }

# The state of one pass over a file: its path, the names assigned anywhere in it, the open scopes.
template Pass { canon: string, assigned: map<bool>, scopes: list<map<Decl>> }

# Stops the run when this pass found an error. Errors found before it (the type checker reads imported
# files while it checks the main one) are left to be reported with the rest.
export func resolve_named_args(stmts: list<Node>, canon: string) {
    let before = diag_count()
    let ps = Pass(canon, {}, [])
    collect_assigned(stmts, ps.assigned)
    walk_list(stmts, ps)
    if (diag_count() > before) {
        diag_exit_if_errors()
    }
}

# Names that an assignment or ++/-- changes somewhere: a function name among them may hold another
# function when it is called.
func collect_assigned(stmts: list<Node>, out: map<bool>) {
    for (let x in nodes_under(stmts)) {
        if (x.k == "assign" or x.k == "incdec") {
            out[x.name] = true
        }
    }
}

# A statement list opens a scope that holds its functions, types, variables and imports from the start,
# so a function can be called above the line that declares it.
func declare_all(stmts: list<Node>, scope: map<Decl>, ps: Pass) {
    for (let s in stmts) {
        if (s == null) {
            continue
        }
        let k = s.k
        if ((k == "func" or k == "typedef") and s.name != null) {
            scope[s.name] = Decl(k, s, null, null)
        } else if (k == "let") {
            scope[s.name] = Decl("var", null, null, null)
        } else if (k == "group") {
            declare_all(s.items, scope, ps)
        } else if (k == "use" and s.names != null and len(s.names) > 0) {
            for (let nm in s.names) {
                scope[nm] = Decl("import", null, s.path, nm)
            }
        } else if (k == "use") {
            # use "x.zu" without a list of names brings in every name the file exports
            let names: list<string> = []
            exported_names(imported_stmts(ps, s.path), names)
            for (let nm in names) {
                scope[nm] = Decl("import", null, s.path, nm)
            }
        }
    }
}

func var_scope(name: string) -> map<Decl> {
    let scope: map<Decl> = {}
    scope[name] = Decl("var", null, null, null)
    return scope
}

func with_scope(ps: Pass, scope: map<Decl>, xs: list<Node>) {
    append(ps.scopes, scope)
    walk_list(xs, ps)
    remove(ps.scopes, len(ps.scopes) - 1)
}

# A list of statements or expressions, in a scope of its own.
func walk_list(xs: list<Node>, ps: Pass) {
    if (xs == null) {
        return null
    }
    let scope: map<Decl> = {}
    declare_all(xs, scope, ps)
    append(ps.scopes, scope)
    for (let y in xs) {
        walk(y, ps)
    }
    remove(ps.scopes, len(ps.scopes) - 1)
}

func walk(x: Node, ps: Pass) {
    if (x == null) {
        return null
    }
    let k = x.k
    if (k == "func") {
        let scope: map<Decl> = {}
        for (let p in x.params) {
            scope[p] = Decl("var", null, null, null)
        }
        append(ps.scopes, scope)
        walk_list(x.defaults, ps)
        walk_list(x.body, ps)
        remove(ps.scopes, len(ps.scopes) - 1)
        return null
    }
    if (k == "forin") {
        walk(x.iter, ps)
        with_scope(ps, var_scope(x.name), x.body)
        return null
    }
    if (k == "if" and x.cond.k == "let") {
        walk(x.cond.init, ps)
        with_scope(ps, var_scope(x.cond.name), x.then)
        walk_list(x.els, ps)
        return null
    }
    if (k == "for") {
        # one scope holds the variable of the init, the condition, the step and the body
        let scope: map<Decl> = {}
        if (x.init != null) {
            declare_all([x.init], scope, ps)
        }
        append(ps.scopes, scope)
        walk(x.init, ps)
        walk(x.cond, ps)
        walk(x.incr, ps)
        walk_list(x.body, ps)
        remove(ps.scopes, len(ps.scopes) - 1)
        return null
    }
    # each list of nodes in a scope of its own
    for (let name in NODE_FIELDS[k]) {
        walk(child_node(x, name), ps)
        walk_list(child_list(x, name), ps)
    }
    if (k == "call" and x.names != null) {
        resolve_call(x, ps)
    }
    return null
}

func lookup(ps: Pass, name: string) -> Decl {
    for (let i = len(ps.scopes) - 1; i >= 0; i--) {
        if (map_has(ps.scopes[i], name)) {
            return ps.scopes[i][name]
        }
    }
    return null
}

# The exported function or type called name in an imported file, or null.
func imported_def(ps: Pass, ent: Decl) -> Node {
    return find_def(imported_stmts(ps, ent.path), ent.name)
}

# The top-level statements of the file path, as the file being read imports it ([] when it cannot be read).
func imported_stmts(ps: Pass, path: string) -> list<Node> {
    let canon = path_norm(path_join(path_dir(ps.canon), path))
    if (not map_has(IMPORTED, canon)) {
        let f = open(canon, "r")
        if (f == null) {
            IMPORTED[canon] = []
        } else {
            let text = read(f)
            close(f)
            let saved_file = ST.src_file
            let saved_lines = ST.src_lines
            ST.src_file = canon
            ST.src_lines = split_lines(text)
            IMPORTED[canon] = parse_source(text)
            ST.src_file = saved_file
            ST.src_lines = saved_lines
        }
    }
    return IMPORTED[canon]
}

# The names of the functions, types and variables stmts export, added to out.
func exported_names(stmts: list<Node>, out: list<string>) {
    for (let s in stmts) {
        let k = s.k
        if ((k == "func" or k == "typedef" or k == "let") and s.name != null and s.exported == true) {
            append(out, s.name)
        } else if (k == "group") {
            exported_names(s.items, out)
        }
    }
}

func find_def(stmts: list<Node>, name: string) -> Node {
    for (let s in stmts) {
        let k = s.k
        if ((k == "func" or k == "typedef" or k == "let") and s.name == name and s.exported == true) {
            return s
        }
        if (k == "group") {
            let d = find_def(s.items, name)
            if (d != null) {
                return d
            }
        }
    }
    return null
}

func unknown_callee(c: Node, why: string) {
    let d = diag_new("Argument Error", node_span(c.callee), "Named arguments need a function known when the program is built")
    diag_text(d, why)
    diag_hint(d, "Pass the arguments by position, or call a function declared with func by its name")
}

func resolve_call(c: Node, ps: Pass) {
    if (c.callee.k != "id") {
        unknown_callee(c, "not the name of a function")
        return null
    }
    let name = c.callee.name
    let ent = lookup(ps, name)
    let def: Node = null
    if (ent == null) {
        if (not map_has(BUILTINS, name)) {
            unknown_callee(c, "'{name}' is not a function this file knows")
            return null
        }
        if (not map_has(BUILTIN_PARAMS, name)) {
            let d = diag_new("Argument Error", c.nspans[first_named(c)], "{name}() takes no named arguments")
            diag_text(d, "a named argument")
            diag_hint(d, "Pass the arguments of {name}() by position")
            return null
        }
        place(c, name, BUILTIN_PARAMS[name], [])
        return null
    }
    if (ent.kind == "import") {
        def = imported_def(ps, ent)
        if (def == null) {
            # st_use reports a name the module does not export.
            return null
        }
    } else if (ent.kind == "func" or ent.kind == "typedef") {
        def = ent.node
    } else {
        unknown_callee(c, "'{name}' is a variable")
        return null
    }
    if (map_has(ps.assigned, name)) {
        unknown_callee(c, "'{name}' is assigned elsewhere, so the function it holds can change")
        return null
    }
    if (def.k == "func") {
        place(c, name, def.params, def.defaults)
    } else if (def.k == "typedef") {
        place(c, name, def.fields, [])
    } else {
        unknown_callee(c, "'{name}' is a variable")
    }
    return null
}

func first_named(c: Node) -> int {
    for (let i = 0; i < len(c.names); i++) {
        if (c.names[i] != "") {
            return i
        }
    }
    return 0
}

# Puts each argument at the place of its parameter. defaults is empty for a builtin or a type, whose
# arguments fill the parameters in order with no gaps; for a function, a parameter with a default may be
# left out.
func place(c: Node, name: string, params: list<string>, defaults: list<Node>) {
    let np = len(params)
    let slots: list<Node> = []
    for (let i = 0; i < np; i++) {
        append(slots, null)
    }
    let last = -1
    let prev_named = -1
    for (let i = 0; i < len(c.args); i++) {
        let pos = i
        let nm = c.names[i]
        if (nm == "") {
            if (i >= np) {
                let d = diag_new("Argument Error", node_span(c.args[i]), "{name}() has only {np} parameter{s_if(np)}")
                diag_text(d, "one argument too many")
                diag_hint(d, "Usage: {name}({join(params, ", ")})")
                return null
            }
        } else {
            pos = index_in(params, nm)
            if (pos < 0) {
                let d = diag_new("Argument Error", c.nspans[i], "{name}() has no parameter '{nm}'")
                diag_text(d, "not a parameter")
                let hint = "The parameters are: {join(params, ", ")}"
                if (np == 0) {
                    hint = "{name}() takes no arguments"
                }
                let guess = suggest(nm, params)
                if (guess != null) {
                    hint = "Did you mean '{guess}'? {hint}"
                }
                diag_hint(d, hint)
                return null
            }
            if (slots[pos] != null) {
                let d = diag_new("Argument Error", c.nspans[i], "'{nm}' is given by position and by name")
                diag_text(d, "given again here")
                diag_label(d, node_span(c.args[pos]), "given by position here")
                diag_hint(d, "Give each argument once")
                return null
            }
            if (pos < prev_named) {
                let d = diag_new("Argument Error", c.nspans[i], "Named arguments go in the order of the parameters")
                diag_text(d, "'{nm}' comes before '{params[prev_named]}'")
                diag_hint(d, "Usage: {name}({join(params, ", ")})")
                return null
            }
            prev_named = pos
        }
        slots[pos] = c.args[i]
        if (pos > last) {
            last = pos
        }
    }
    let args: list<Node> = []
    for (let p = 0; p < np; p++) {
        if (slots[p] != null) {
            append(args, slots[p])
        } else if (len(defaults) == 0) {
            if (p < last) {
                let d = diag_new("Argument Error", c.nspans[first_named(c)], "{name}() cannot skip '{params[p]}'")
                diag_text(d, "'{params[p]}' is not given before this")
                diag_hint(d, "Give '{params[p]}' too: the arguments of {name}() fill its parameters in order")
                return null
            }
        } else if (defaults[p] != null) {
            if (p < last) {
                append(args, mk_jump("absent", node_token(c), node_token(c)))
            }
        } else {
            let d = diag_new("Argument Error", c.aspan, "{name}() needs a value for '{params[p]}'")
            diag_text(d, "'{params[p]}' is not given")
            diag_hint(d, "Usage: {name}({join(params, ", ")})")
            return null
        }
    }
    c.args = args
    c.names = null
    c.nspans = null
    return null
}

func index_in(xs: list<string>, v: string) -> int {
    for (let i = 0; i < len(xs); i++) {
        if (xs[i] == v) {
            return i
        }
    }
    return -1
}

func s_if(n: int) -> string {
    if (n == 1) {
        return ""
    }
    return "s"
}
