#
# ll_typed.zu: expressions computed on raw machine values.
#
# An expression made only of literals and variables kept raw (see ll_unbox.zu) is computed as i64,
# double or i1 with no 16-byte LV and no tag test. skind says whether an expression qualifies without
# emitting anything; tex emits it. The results match the boxed fast paths: an int result that
# overflows, a zero divisor, and a float result that is not finite all end in the same runtime
# call, which reports the error.

use { diag_exit_if_errors, diag_hint, diag_new } from "diag.zu"
use { Node, node_span } from "ast_nodes.zu"
use { HOOKS, SPECS, SpecEntry, ll, ll_alloca, ll_temp_alloca, ll_args_array, ll_br, ll_call_out, ll_slot, ll_condbr, ll_cstr, ll_float_text, ll_gname, ll_label, ll_mark, ll_new_label, ll_pos, ll_reg, ll_store_pos } from "ll_state.zu"
use { find_local, resolve } from "ll_scope.zu"
use { box_raw, ty_load, unbox_checked } from "ll_unbox.zu"
use { SPEC_FRAME_SIZE, SPEC_MAX_DEPTH, Sig, machine_type, parse_sig, spec_closure_global, spec_key_of, spec_symbol } from "ll_spec.zu"
use { ST } from "state.zu"
use { cut } from "ranges.zu"

let T_VALUE_CALL: map<string> = {"+": "add", "-": "sub", "*": "mul", "/": "div", "%": "mod"}
let T_INT_OP: map<string> = {"+": "sadd", "-": "ssub", "*": "smul"}
let T_FLOAT_OP: map<string> = {"+": "fadd", "-": "fsub", "*": "fmul", "/": "fdiv"}
let T_INT_CMP: map<string> = {"==": "eq", "!=": "ne", "<": "slt", "<=": "sle", ">": "sgt", ">=": "sge"}
let T_FLOAT_CMP: map<string> = {"==": "oeq", "!=": "une", "<": "olt", "<=": "ole", ">": "ogt", ">=": "oge"}
let T_BITWISE: map<string> = {"&": "and", "|": "or", "^": "xor"}

# An integer literal must fit in 64 bits; -9223372036854775808 is the one that needs the sign.
export func lit_int(n: Node) -> string {
    let digits = n.v
    let limit = "9223372036854775807"
    if (starts_with(digits, "-")) {
        digits = cut(digits, 1, len(digits))
        limit = "9223372036854775808"
    }
    while (len(digits) > 1 and starts_with(digits, "0")) {
        digits = cut(digits, 1, len(digits))
    }
    if (len(digits) > 19 or (len(digits) == 19 and digits > limit)) {
        let d = diag_new("Syntax Error", node_span(n), "Integer literal does not fit in 64 bits")
        diag_hint(d, "The largest int is 9223372036854775807")
        diag_exit_if_errors()
    }
    return n.v
}

# Whether a whole-number literal is a float in the specialized version being emitted: the checker found it
# wanted as a float for this signature (n.ads, see adapt_to in check.zu).
export func spec_float_lit(n: Node) -> bool {
    return n.k == "num" and n.ads != null and ST.ctx.spec != null and map_get(n.ads, ST.ctx.spec.argkey, "") == "float"
}

# The kind (int, float or bool) n has when computed raw, or "" when it cannot be.
export func skind(n: Node) -> string {
    let k = n.k
    if (k == "num") {
        if (spec_float_lit(n)) {
            return "float"
        }
        return "int"
    }
    if (k == "float") {
        return "float"
    }
    if (k == "bool") {
        return "bool"
    }
    if (k == "id") {
        let v = find_local(n.name)
        if (v != null and v.ty != null) {
            return v.ty
        }
        return ""
    }
    if (k == "not") {
        if (skind(n.e) == "bool") {
            return "bool"
        }
        return ""
    }
    if (k == "bin") {
        # kc keeps the answer ("-" for none) so a long chain is walked once, not once per level
        if (n.kc != null) {
            if (n.kc == "-") {
                return ""
            }
            return n.kc
        }
        let r = bin_kind(n)
        if (r == "") {
            n.kc = "-"
        } else {
            n.kc = r
        }
        return r
    }
    if (k == "call") {
        if (is_float_of_int(n)) {
            return "float"
        }
        let sp = call_spec(n)
        if (sp != null) {
            return sp.sig.res
        }
        let ms = math_spec(n)
        if (ms != null) {
            return ms.res
        }
    }
    return ""
}

# A direct call: the signature key, the function's SpecEntry, the signature and the function's name.
export template SpecCall { key: string, entry: SpecEntry, sig: Sig, name: string }

# The direct call n can be made with, or null: the checker proved a signature for it (n.spec), the callee
# is a function of this module that has specialized functions for it, the name is not shadowed here, and
# every argument is available as a raw value of the kind the signature wants.
export func call_spec(n: Node) -> SpecCall {
    if (n.spec == null or n.callee.k != "id") {
        return null
    }
    let name = n.callee.name
    let entry = map_get(SPECS, spec_key_of(name), null)
    if (entry == null or find_local(name) != null or len(n.args) != len(entry.node.params)) {
        return null
    }
    for (let key in split(n.spec, ";")) {
        if (map_has(entry.sigs, key)) {
            let sig = parse_sig(key, len(n.args))
            if (sig != null and args_fit(n.args, sig.args)) {
                return SpecCall(key, entry, sig, name)
            }
        }
    }
    return null
}

func args_fit(args: list<Node>, kinds: list<string>) -> bool {
    for (let i = 0; i < len(args); i++) {
        let a = args[i]
        let k = skind(a)
        if (k != kinds[i] and not (kinds[i] == "float" and a.k == "num")) {
            return false
        }
    }
    return true
}

# float(x) where x is computed raw as an int and float is the builtin: a plain conversion that
# cannot fail.
func is_float_of_int(n: Node) -> bool {
    let c = n.callee
    if (c.k != "id" or c.name != "float" or len(n.args) != 1) {
        return false
    }
    if (resolve("float").kind != "builtin") {
        return false
    }
    return skind(n.args[0]) == "int"
}

# The kind both operands of a binary node are computed in, or "". A whole-number literal next to a
# float is a float, as it is in the runtime.
func operand_kind(n: Node) -> string {
    let a = skind(n.l)
    if (a == "") {
        return ""
    }
    let b = skind(n.r)
    if (b == "") {
        return ""
    }
    if (a == b) {
        return a
    }
    if (a == "float" and n.r.k == "num") {
        return "float"
    }
    if (b == "float" and n.l.k == "num") {
        return "float"
    }
    return ""
}

func bin_kind(n: Node) -> string {
    let op = n.op
    if (op == "and" or op == "or") {
        if (skind(n.l) == "bool" and skind(n.r) == "bool") {
            return "bool"
        }
        return ""
    }
    let u = operand_kind(n)
    if (u == "") {
        return ""
    }
    if (u == "bool") {
        if (op == "==" or op == "!=") {
            return "bool"
        }
        return ""
    }
    if (map_has(T_INT_CMP, op)) {
        return "bool"
    }
    if (op == "+" or op == "-" or op == "*" or op == "/") {
        return u
    }
    if ((op == "%" or op == "&" or op == "|" or op == "^") and u == "int") {
        return "int"
    }
    return ""
}

# The raw operand of n, which skind accepted.
export func tex(n: Node) -> string {
    let k = n.k
    if (k == "num") {
        if (spec_float_lit(n)) {
            return ll_float_text("{n.v}.0")
        }
        return lit_int(n)
    }
    if (k == "float") {
        return ll_float_text(n.v)
    }
    if (k == "bool") {
        return "{n.v}"
    }
    if (k == "id") {
        return ty_load(find_local(n.name))
    }
    if (k == "not") {
        let e = tex(n.e)
        let r = ll_reg()
        ll("{r} = xor i1 {e}, true")
        return r
    }
    if (k == "call") {
        if (is_float_of_int(n)) {
            # Exact for every int from -2^53 to 2^53; the runtime checks the others, which may have no float.
            let raw = tex(n.args[0])
            let r = ll_reg()
            ll("{r} = sitofp i64 {raw} to double")
            let a = ll_reg()
            let small = ll_reg()
            ll("{a} = add i64 {raw}, 9007199254740992")
            ll("{small} = icmp ule i64 {a}, 18014398509481984")
            let big = ll_new_label("fbig")
            let done = ll_new_label("fexact")
            ll_condbr(small, done, big)
            ll_label(big)
            ll_mark(n)
            ll("call i64 @lvv_int_to_float(i64 {raw})")
            ll_br(done)
            ll_label(done)
            return r
        }
        if (call_spec(n) != null) {
            return tex_spec_call(n)
        }
        return tex_math_call(n)
    }
    return tex_bin(n)
}

# Math builtins called on raw floats. The runtime does the same work: a test of the argument, the libm function,
# a test that the result is a finite number. Here the tests are inline, and when one of them fails the ordinary
# builtin is called on the boxed arguments, so that it reports the exact error it always did.
# Each entry: the function to call and the test of the argument (none, ge0: not negative, gt0: positive,
# unit: from -1 to 1).
let MATH_UNARY: map<list<string>> = {
    "sqrt": ["llvm.sqrt.f64", "ge0"], "exp": ["exp", "none"], "ln": ["log", "gt0"], "log10": ["log10", "gt0"],
    "sin": ["sin", "none"], "cos": ["cos", "none"], "tan": ["tan", "none"], "asin": ["asin", "unit"],
    "acos": ["acos", "unit"], "atan": ["atan", "none"], "sinh": ["sinh", "none"], "cosh": ["cosh", "none"],
    "tanh": ["tanh", "none"]
}
let MATH_ROUND: map<string> = {"floor": "llvm.floor.f64", "ceil": "llvm.ceil.f64", "round": "llvm.round.f64"}

# A call of a math builtin with raw arguments: the builtin, which kind of call (unary, round, pow, abs) and
# the kind of its result.
export template MathSpec { name: string, kind: string, res: string }

# The MathSpec of n when n is a call of a math builtin whose arguments are raw floats (or whole number
# literals, which the runtime also takes as numbers), else null. abs takes a raw int too.
export func math_spec(n: Node) -> MathSpec {
    if (n.callee.k != "id") {
        return null
    }
    let name = n.callee.name
    let kind = null
    if (map_has(MATH_UNARY, name) and len(n.args) == 1) {
        kind = "unary"
    } else if (map_has(MATH_ROUND, name) and len(n.args) == 1) {
        kind = "round"
    } else if (name == "pow" and len(n.args) == 2) {
        kind = "pow"
    } else if (name == "abs" and len(n.args) == 1) {
        kind = "abs"
    }
    if (kind == null or resolve(name).kind != "builtin") {
        return null
    }
    # A whole-number literal adapts to a float argument, except for floor, ceil, round and trunc: they return
    # an int argument unchanged (floor(9223372036854775807) is that int, which has no exact float).
    for (let a in n.args) {
        let k = skind(a)
        if (k != "float" and not (a.k == "num" and kind != "abs" and kind != "round") and not (kind == "abs" and k == "int")) {
            return null
        }
    }
    # pow of two ints is an exact int power in the runtime: at least one argument must be a float
    if (kind == "pow" and skind(n.args[0]) != "float" and skind(n.args[1]) != "float") {
        return null
    }
    let res = "float"
    if (kind == "round") {
        res = "int"
    } else if (kind == "abs") {
        res = skind(n.args[0])
    }
    return MathSpec(name, kind, res)
}

# The result r of a libm call is used when it is finite (not NaN, not infinite); otherwise the slow path runs.
func math_finite_or_slow(r: string, good: string, slow: string) {
    let a = ll_reg()
    ll("{a} = call double @llvm.fabs.f64(double {r})")
    let fin = ll_reg()
    ll("{fin} = fcmp olt double {a}, 0x7FF0000000000000")
    ll_condbr(fin, good, slow)
}

func tex_math_call(n: Node) -> string {
    let ms = math_spec(n)
    let rt = machine_type(ms.res)
    let out = ll_temp_alloca(rt)
    let raws: list<string> = []
    let kinds: list<string> = []
    for (let a in n.args) {
        if (a.k == "num" and ms.kind != "abs") {
            append(raws, ll_float_text(a.v))
            append(kinds, "float")
        } else {
            append(raws, tex(a))
            append(kinds, skind(a))
        }
    }
    let slow = ll_new_label("mslow")
    let done = ll_new_label("mdone")
    let needs_slow = true
    let x = raws[0]
    if (ms.kind == "abs" and ms.res == "float") {
        let r = ll_reg()
        ll("{r} = call double @llvm.fabs.f64(double {x})")
        ll("store double {r}, ptr {out}")
        needs_slow = false
        ll_br(done)
    } else if (ms.kind == "abs") {
        let c = ll_reg()
        ll("{c} = icmp eq i64 {x}, -9223372036854775808")
        let comp = ll_new_label("mcomp")
        ll_condbr(c, slow, comp)
        ll_label(comp)
        let neg = ll_reg()
        ll("{neg} = sub i64 0, {x}")
        let isneg = ll_reg()
        ll("{isneg} = icmp slt i64 {x}, 0")
        let r = ll_reg()
        ll("{r} = select i1 {isneg}, i64 {neg}, i64 {x}")
        ll("store i64 {r}, ptr {out}")
        ll_br(done)
    } else if (ms.kind == "unary") {
        let info = MATH_UNARY[ms.name]
        let comp = ll_new_label("mcomp")
        let test = info[1]
        if (test == "none") {
            ll_br(comp)
        } else {
            let c = ll_reg()
            if (test == "ge0") {
                ll("{c} = fcmp oge double {x}, 0.0")
            } else if (test == "gt0") {
                ll("{c} = fcmp ogt double {x}, 0.0")
            } else {
                let lo = ll_reg()
                let hi = ll_reg()
                ll("{lo} = fcmp oge double {x}, -1.0")
                ll("{hi} = fcmp ole double {x}, 1.0")
                ll("{c} = and i1 {lo}, {hi}")
            }
            ll_condbr(c, comp, slow)
        }
        ll_label(comp)
        let r = ll_reg()
        ll("{r} = call double @{info[0]}(double {x})")
        let good = ll_new_label("mgood")
        math_finite_or_slow(r, good, slow)
        ll_label(good)
        ll("store double {r}, ptr {out}")
        ll_br(done)
    } else if (ms.kind == "round") {
        let r = ll_reg()
        ll("{r} = call double @{MATH_ROUND[ms.name]}(double {x})")
        let lo = ll_reg()
        let hi = ll_reg()
        let c = ll_reg()
        ll("{lo} = fcmp oge double {r}, 0xC3E0000000000000")
        ll("{hi} = fcmp olt double {r}, 0x43E0000000000000")
        ll("{c} = and i1 {lo}, {hi}")
        let good = ll_new_label("mgood")
        ll_condbr(c, good, slow)
        ll_label(good)
        let i = ll_reg()
        ll("{i} = fptosi double {r} to i64")
        ll("store i64 {i}, ptr {out}")
        ll_br(done)
    } else {
        let y = raws[1]
        let zero = ll_reg()
        let neg_exp = ll_reg()
        let bad1 = ll_reg()
        ll("{zero} = fcmp oeq double {x}, 0.0")
        ll("{neg_exp} = fcmp olt double {y}, 0.0")
        ll("{bad1} = and i1 {zero}, {neg_exp}")
        let neg_base = ll_reg()
        let whole = ll_reg()
        let frac = ll_reg()
        let bad2 = ll_reg()
        ll("{neg_base} = fcmp olt double {x}, 0.0")
        ll("{whole} = call double @llvm.trunc.f64(double {y})")
        ll("{frac} = fcmp one double {y}, {whole}")
        ll("{bad2} = and i1 {neg_base}, {frac}")
        let bad = ll_reg()
        ll("{bad} = or i1 {bad1}, {bad2}")
        let comp = ll_new_label("mcomp")
        ll_condbr(bad, slow, comp)
        ll_label(comp)
        let r = ll_reg()
        ll("{r} = call double @pow(double {x}, double {y})")
        let good = ll_new_label("mgood")
        math_finite_or_slow(r, good, slow)
        ll_label(good)
        ll("store double {r}, ptr {out}")
        ll_br(done)
    }
    if (needs_slow) {
        ll_label(slow)
        ll_mark(n)
        let argv: list<string> = []
        for (let i = 0; i < len(raws); i++) {
            append(argv, box_raw(kinds[i], raws[i]))
        }
        let slot: string = HOOKS.builtin(ms.name, argv)
        let u = unbox_checked(slot, ms.res, ms.name)
        ll("store {rt} {u}, ptr {out}")
        ll_br(done)
    }
    ll_label(done)
    let res = ll_reg()
    ll("{res} = load {rt}, ptr {out}")
    return res
}

# A call that skind accepted through call_spec. It follows the order of the ordinary call: the callee is
# read first (an undefined name is the same error, before any argument is computed), then the arguments
# are computed once, as raw values, then the call is made. If the name holds the closure the specialized
# functions were made for, the call goes straight to the one for the signature, with the same bookkeeping
# as lvp_call. If not (the name was given another value), the arguments are boxed and it is the ordinary
# call, and its result is unboxed with the check of a tag.
func tex_spec_call(n: Node) -> string {
    let sp = call_spec(n)
    let rt = machine_type(sp.sig.res)
    let out = ll_temp_alloca(rt)
    let g = ll_gname(sp.name)
    let tag = ll_reg()
    ll("{tag} = load i64, ptr {g}")
    let undefined = ll_reg()
    ll("{undefined} = icmp eq i64 {tag}, 17")
    let l_undef = ll_new_label("sundef")
    let l_def = ll_new_label("sdef")
    ll_condbr(undefined, l_undef, l_def)
    ll_label(l_undef)
    HOOKS.ex(n.callee)
    ll("unreachable")
    ll_label(l_def)
    let payload_p = ll_reg()
    ll("{payload_p} = getelementptr inbounds i8, ptr {g}, i64 8")
    let held = ll_reg()
    ll("{held} = load i64, ptr {payload_p}")
    let made = ll_reg()
    ll("{made} = load i64, ptr {spec_closure_global(sp.entry)}")
    let is_func = ll_reg()
    ll("{is_func} = icmp eq i64 {tag}, 8")
    let same = ll_reg()
    ll("{same} = icmp eq i64 {held}, {made}")
    let ok = ll_reg()
    ll("{ok} = and i1 {is_func}, {same}")
    let raws: list<string> = []
    for (let i = 0; i < len(n.args); i++) {
        let a = n.args[i]
        if (sp.sig.args[i] == "float" and a.k == "num") {
            append(raws, ll_float_text(a.v))
        } else {
            append(raws, tex(a))
        }
    }
    ll_mark(n)
    let pos = ll_pos(n)
    let name = ll_cstr(sp.name)
    let fast = ll_new_label("sfast")
    let slow = ll_new_label("sslow")
    let done = ll_new_label("sdone")
    ll_condbr(ok, fast, slow)
    ll_label(fast)
    let args: list<string> = []
    for (let i = 0; i < len(raws); i++) {
        append(args, "{machine_type(sp.sig.args[i])} {raws[i]}")
    }
    # What lvp_call does around a call, done here: the depth, the record of the call, the test of the
    # stack. Inside the code of a module the current module is always that module, so it is a constant.
    let d0 = ll_reg()
    ll("{d0} = load i32, ptr @lv_depth")
    let d1 = ll_reg()
    ll("{d1} = add i32 {d0}, 1")
    let deep = ll_reg()
    ll("{deep} = icmp sgt i32 {d1}, {SPEC_MAX_DEPTH}")
    let l_deep = ll_new_label("sdeep")
    let l_in = ll_new_label("sin")
    ll_condbr(deep, l_deep, l_in)
    ll_label(l_deep)
    ll("call void @lvp_enter(ptr {name})")
    ll("unreachable")
    ll_label(l_in)
    ll("store i32 {d1}, ptr @lv_depth")
    let d64 = ll_reg()
    ll("{d64} = zext i32 {d1} to i64")
    let off = ll_reg()
    ll("{off} = mul i64 {d64}, {SPEC_FRAME_SIZE}")
    let frames = ll_reg()
    ll("{frames} = load ptr, ptr @lv_frames_p")
    let fr = ll_reg()
    ll("{fr} = getelementptr inbounds i8, ptr {frames}, i64 {off}")
    ll("store i64 {pos}, ptr {fr}")
    let fr_mod = ll_reg()
    ll("{fr_mod} = getelementptr inbounds i8, ptr {fr}, i64 8")
    ll("store i64 ptrtoint (ptr @mod_{ST.mod.id} to i64), ptr {fr_mod}")
    let fr_name = ll_reg()
    ll("{fr_name} = getelementptr inbounds i8, ptr {fr}, i64 16")
    ll("store i64 ptrtoint (ptr {name} to i64), ptr {fr_name}")
    let low = ll_reg()
    ll("{low} = load i64, ptr @lv_stack_low")
    let here = ll_reg()
    ll("{here} = ptrtoint ptr {out} to i64")
    let known = ll_reg()
    ll("{known} = icmp ne i64 {low}, 0")
    let under = ll_reg()
    ll("{under} = icmp ult i64 {here}, {low}")
    let spent = ll_reg()
    ll("{spent} = and i1 {known}, {under}")
    let l_stack = ll_new_label("sstack")
    let l_go = ll_new_label("sgo")
    ll_condbr(spent, l_stack, l_go)
    # Either the stack is used up, or the scheduler asked this thread to let another run: it raises the
    # limit above every address, so the test every call makes anyway also serves as that request.
    ll_label(l_stack)
    ll("call void @lvp_stack_slow()")
    ll_br(l_go)
    ll_label(l_go)
    let r = ll_reg()
    ll("{r} = call {rt} {spec_symbol(sp.entry, sp.key)}({join(args, ", ")})")
    ll("store i32 {d0}, ptr @lv_depth")
    ll("store i64 {pos}, ptr @lv_pos")
    ll("store {rt} {r}, ptr {out}")
    ll_br(done)
    ll_label(slow)
    let callee = ll_slot()
    ll("store i64 {tag}, ptr {callee}")
    let callee_p = ll_reg()
    ll("{callee_p} = getelementptr inbounds i8, ptr {callee}, i64 8")
    ll("store i64 {held}, ptr {callee_p}")
    let argv: list<string> = []
    for (let i = 0; i < len(raws); i++) {
        append(argv, box_raw(sp.sig.args[i], raws[i]))
    }
    let arr = ll_args_array(argv)
    let slot = ll_call_out("lvp_call", "ptr {callee}, i32 {len(argv)}, ptr {arr}")
    let u = unbox_checked(slot, sp.sig.res, sp.name)
    ll("store {rt} {u}, ptr {out}")
    ll_br(done)
    ll_label(done)
    let res = ll_reg()
    ll("{res} = load {rt}, ptr {out}")
    return res
}

# n computed as kind want; a whole-number literal becomes a double when a float is wanted.
func tex_as(n: Node, want: string) -> string {
    if (want == "float" and n.k == "num") {
        return ll_float_text(n.v)
    }
    return tex(n)
}

func tex_bin(n: Node) -> string {
    let op = n.op
    if (op == "and" or op == "or") {
        return tex_logic(n)
    }
    let u = operand_kind(n)
    let a = tex_as(n.l, u)
    let b = tex_as(n.r, u)
    if (map_has(T_INT_CMP, op)) {
        let r = ll_reg()
        if (u == "float") {
            ll("{r} = fcmp {T_FLOAT_CMP[op]} double {a}, {b}")
        } else if (u == "bool") {
            ll("{r} = icmp {T_INT_CMP[op]} i1 {a}, {b}")
        } else {
            ll("{r} = icmp {T_INT_CMP[op]} i64 {a}, {b}")
        }
        return r
    }
    if (map_has(T_BITWISE, op)) {
        let r = ll_reg()
        ll("{r} = {T_BITWISE[op]} i64 {a}, {b}")
        return r
    }
    if (u == "float") {
        return tex_float_arith(op, a, b, ll_pos(n))
    }
    return tex_int_arith(op, a, b, ll_pos(n))
}

# cur plus or minus one, for ++ and --, in the machine type of kind.
export func tex_step(kind: string, op: string, cur: string, pos: int) -> string {
    if (kind == "float") {
        return tex_float_arith(op, cur, "1.0", pos)
    }
    return tex_int_arith(op, cur, "1", pos)
}

# a and b / a or b: the right side runs only when the left does not decide.
func tex_logic(n: Node) -> string {
    let res = ll_temp_alloca("i64")
    let left = tex(n.l)
    let lw = ll_reg()
    ll("{lw} = zext i1 {left} to i64")
    ll("store i64 {lw}, ptr {res}")
    let rhs = ll_new_label("trhs")
    let done = ll_new_label("tdone")
    if (n.op == "and") {
        ll_condbr(left, rhs, done)
    } else {
        ll_condbr(left, done, rhs)
    }
    ll_label(rhs)
    let right = tex(n.r)
    let rw = ll_reg()
    ll("{rw} = zext i1 {right} to i64")
    ll("store i64 {rw}, ptr {res}")
    ll_br(done)
    ll_label(done)
    let w = ll_reg()
    ll("{w} = load i64, ptr {res}")
    let r = ll_reg()
    ll("{r} = icmp ne i64 {w}, 0")
    return r
}

# + - * with an overflow check, and / % where a divisor of 0 or -1 is left to the runtime (the two
# that raise an error or overflow). The runtime call returns the result or raises.
func tex_int_arith(op: string, a: string, b: string, pos: int) -> string {
    let fast = ll_new_label("tfast")
    let slow = ll_new_label("tslow")
    let done = ll_new_label("tdone")
    let value = ll_reg()
    if (map_has(T_INT_OP, op)) {
        let pair = ll_reg()
        let overflow = ll_reg()
        ll("{pair} = call \{ i64, i1 } @llvm.{T_INT_OP[op]}.with.overflow.i64(i64 {a}, i64 {b})")
        ll("{value} = extractvalue \{ i64, i1 } {pair}, 0")
        ll("{overflow} = extractvalue \{ i64, i1 } {pair}, 1")
        ll_condbr(overflow, slow, fast)
    } else {
        let shifted = ll_reg()
        let usable = ll_reg()
        ll("{shifted} = add i64 {b}, 1")
        ll("{usable} = icmp ugt i64 {shifted}, 1")
        ll_condbr(usable, fast, slow)
    }
    ll_label(slow)
    ll_store_pos(pos)
    let sres = ll_reg()
    let spay = ll_reg()
    ll("{sres} = call %LV @lvv_{T_VALUE_CALL[op]}(i64 2, i64 {a}, i64 2, i64 {b})")
    ll("{spay} = extractvalue %LV {sres}, 1")
    ll_br(done)
    ll_label(fast)
    if (not map_has(T_INT_OP, op)) {
        let inst = "sdiv"
        if (op == "%") {
            inst = "srem"
        }
        ll("{value} = {inst} i64 {a}, {b}")
    }
    ll_br(done)
    ll_label(done)
    let r = ll_reg()
    ll("{r} = phi i64 [ {value}, %{fast} ], [ {spay}, %{slow} ]")
    return r
}

# + - * / on doubles. A zero divisor and a result that is not finite go to the runtime, which
# raises the error. A result may be -0.0; ty_store and box_raw turn it into 0.0 where it leaves the
# chain of operations.
func tex_float_arith(op: string, a: string, b: string, pos: int) -> string {
    let compute = ll_new_label("tcomp")
    let store = ll_new_label("tstore")
    let slow = ll_new_label("tslow")
    let done = ll_new_label("tdone")
    if (op == "/") {
        let zero = ll_reg()
        ll("{zero} = fcmp oeq double {b}, 0.0")
        ll_condbr(zero, slow, compute)
    } else {
        ll_br(compute)
    }
    ll_label(compute)
    let res = ll_reg()
    let mag = ll_reg()
    let finite = ll_reg()
    ll("{res} = {T_FLOAT_OP[op]} double {a}, {b}")
    ll("{mag} = call double @llvm.fabs.f64(double {res})")
    ll("{finite} = fcmp olt double {mag}, 0x7FF0000000000000")
    ll_condbr(finite, store, slow)
    ll_label(store)
    ll_br(done)
    ll_label(slow)
    ll_store_pos(pos)
    let abits = ll_reg()
    let bbits = ll_reg()
    let sres = ll_reg()
    let spay = ll_reg()
    let sval = ll_reg()
    ll("{abits} = bitcast double {a} to i64")
    ll("{bbits} = bitcast double {b} to i64")
    ll("{sres} = call %LV @lvv_{T_VALUE_CALL[op]}(i64 3, i64 {abits}, i64 3, i64 {bbits})")
    ll("{spay} = extractvalue %LV {sres}, 1")
    ll("{sval} = bitcast i64 {spay} to double")
    ll_br(done)
    ll_label(done)
    let r = ll_reg()
    ll("{r} = phi double [ {res}, %{store} ], [ {sval}, %{slow} ]")
    return r
}
