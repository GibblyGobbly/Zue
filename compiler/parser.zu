#
# parser.zu: tokens to AST.
#
# Every node gets its place in the source (see ast_nodes.zu). A mistake is recorded with diag_new
# and the parser goes on, so one run finds every syntax error:
#
#   - The first error in a statement puts the parser in panic mode. While it is on, further errors
#     are not recorded (they would only follow from the first one), and the parser builds
#     placeholder nodes without consuming input.
#   - When the statement ends, p_recover skips to the start of the next statement and turns panic off.
#   - At most one syntax error is recorded for a line.
#
# The tree of a program with errors is never used.

use { Diag, Span, diag_new, diag_text, diag_hint, diag_label, diag_on_line, diag_exit_if_errors, diag_count, span_at, span_line } from "diag.zu"
use { StrPart, Token, lex } from "lexer.zu"
use { KEYWORDS } from "token.zu"
use { Node, node_span, mk_lit, mk_id, mk_tmpl, mk_list, mk_map, mk_func, mk_box, mk_call, mk_index, mk_slice, mk_field, mk_incdec, mk_bin, mk_not, mk_let, mk_group, mk_if, mk_forin, mk_for, mk_while, mk_switch, mk_assign, mk_setidx, mk_case, mk_typedef, mk_use, mk_block, mk_return, mk_jump, mk_neg, span_token } from "ast_nodes.zu"
use { cut } from "ranges.zu"

let P_toks: list<Token> = []
let P_pos = 0

# Number of ( [ and literal { currently open. Inside them a line break is only white space.
let P_depth = 0

# The last token that was consumed.
let P_prev: Token = null

# True from the first error in a statement until p_recover.
let P_panic = false

# Closing braces to skip silently because their opening brace was skipped by p_recover.
let P_ignore_close = 0

# Names declared so far in each open scope, innermost last, each with the span of its declaration;
# a name may be declared once per scope.
let P_scopes: list<map<Span>> = [{}]

# Set when p_close_angle used up the first character of a token such as >> and left the rest.
let P_split_tok: Token = null

# Records an error unless the parser is already in panic mode or the line has an error. A syntax
# error puts the parser in panic mode (panic is true); a rule error such as a repeated name does not.
func p_diag(span: Span, msg: string, text: string, panic: bool) -> Diag {
    if (P_panic or diag_on_line(span.line)) {
        if (panic) {
            P_panic = true
        }
        return null
    }
    let d = diag_new("Syntax Error", span, msg)
    if (len(text) > 0) {
        diag_text(d, text)
    }
    if (panic) {
        P_panic = true
    }
    return d
}

# The place of a token.
func tspan(tk: Token) -> Span {
    return span_at(tk.line, tk.col, tk.eline, tk.ecol)
}

func p_scope_push() {
    append(P_scopes, {})
}

func p_scope_pop() {
    remove(P_scopes, len(P_scopes) - 1)
}

func p_declare(name: string, tk: Token) {
    let top = P_scopes[len(P_scopes) - 1]
    if (map_has(top, name)) {
        let first = top[name]
        let d = p_diag(tspan(tk), "'{name}' is already declared in this scope", "declared again here", false)
        if (d != null) {
            diag_label(d, first, "first declared here")
            diag_hint(d, "Use another name, or assign to the existing variable without 'let'")
        }
        return null
    }
    top[name] = tspan(tk)
}

# The current token and its kind. While a bracket is open, line breaks are skipped before either is
# set, so the parser never sees them there. p_sync must run whenever P_pos or P_depth changes.
let P_tk: Token = null
let P_kind = ""

func p_sync() {
    if (P_depth > 0) {
        while (P_toks[P_pos].t == "nl") {
            P_pos += 1
        }
    }
    P_tk = P_toks[P_pos]
    P_kind = P_tk.t
}

func p_at(t: string) -> bool {
    return P_kind == t
}

func p_next() -> Token {
    let tk = P_tk
    P_prev = tk
    if (P_pos < len(P_toks) - 1) {
        P_pos += 1
    }
    p_sync()
    return tk
}

func p_eat(t: string) -> bool {
    if (P_kind == t) {
        p_next()
        return true
    }
    return false
}

# Counts one more open bracket, after its opening token has been consumed.
func p_enter() {
    P_depth += 1
    p_sync()
}

# Words that are keywords only where they mean something: in (for loops), from (use lists) and
# data (data declarations). Elsewhere they are ordinary names.
func p_at_word(w: string) -> bool {
    let tk = P_tk
    return tk.t == "id" and tk.v == w
}

func p_eat_word(w: string) -> bool {
    if (p_at_word(w)) {
        p_next()
        return true
    }
    return false
}

func p_expect_word(w: string, msg: string) -> Token {
    if (not p_at_word(w)) {
        p_fail(msg)
        return P_tk
    }
    return p_next()
}

# data Name { ... }: the word data, a name, then an opening brace.
func p_at_data() -> bool {
    if (not p_at_word("data")) {
        return false
    }
    let i = P_pos + 1
    return i + 1 < len(P_toks) and P_toks[i].t == "id" and P_toks[i + 1].t == "\{"
}

# True when the current token is the first on its line, inside brackets where line breaks are not
# tokens the parser sees.
func p_first_on_line() -> bool {
    return P_depth > 0 and P_pos > 0 and P_toks[P_pos - 1].t == "nl"
}

# Where an error about the current token points. At the end of a line or of the file the token is
# not text, so the error points at the place just after the last token that was read.
func p_here() -> Span {
    let tk = P_tk
    if ((tk.t == "nl" or tk.t == "eof" or p_first_on_line()) and P_prev != null) {
        return span_at(P_prev.eline, P_prev.ecol, P_prev.eline, P_prev.ecol + 1)
    }
    return tspan(tk)
}

# What the current token is, for the text next to the carets.
func p_found_text() -> string {
    let tk = P_tk
    let t = tk.t
    if (t == "nl" or p_first_on_line()) {
        return "unexpected end of line"
    }
    if (t == "eof" and P_inline > 0) {
        return "the interpolation ends here"
    }
    if (t == "eof") {
        return "unexpected end of file"
    }
    if (t == "str") {
        return "unexpected string"
    }
    if (t == "num" or t == "float") {
        return "unexpected number"
    }
    if (t == "char") {
        return "unexpected character literal"
    }
    if (t == "id") {
        return "unexpected name '{tk.v}'"
    }
    if (tk.v != null) {
        return "unexpected '{tk.v}'"
    }
    return "unexpected '{t}'"
}

# Records a syntax error at the current token and puts the parser in panic mode. Returns the error,
# or null when it was not recorded.
func p_fail(msg: string) -> Diag {
    let d = p_diag(p_here(), msg, p_found_text(), true)
    let tk = P_tk
    if (d != null and tk.v != null and map_has(KEYWORDS, tk.v) and contains(msg, "name")) {
        diag_hint(d, "'{tk.v}' is a keyword and cannot be used as a name; choose another")
    }
    return d
}

func p_fail_at(tk: Token, msg: string, text: string) -> Diag {
    return p_diag(tspan(tk), msg, text, true)
}

func p_fail_span(span: Span, msg: string, text: string) -> Diag {
    return p_diag(span, msg, text, true)
}

# Consumes a token of kind t. When it is missing nothing is consumed and the current token is
# returned, as if the missing token had been there.
func p_expect(t: string, msg: string) -> Token {
    if (P_kind != t) {
        p_fail(msg)
        return P_tk
    }
    return p_next()
}

# Consumes the opening bracket t, and line breaks stop mattering until p_close.
func p_open(t: string, msg: string) {
    if (P_kind != t) {
        p_fail(msg)
        return null
    }
    p_next()
    p_enter()
}

# The opening bracket that the closer t should have matched: the nearest one before the current
# token that has no closer of its own. Only used to describe an error.
func p_find_opener(t: string) -> Token {
    let open = "("
    if (t == "]") {
        open = "["
    } else if (t == "}") {
        open = "\{"
    }
    let depth = 0
    let i = P_pos - 1
    while (i >= 0) {
        let k = P_toks[i].t
        if (k == t) {
            depth += 1
        } else if (k == open) {
            if (depth == 0) {
                return P_toks[i]
            }
            depth -= 1
        }
        i -= 1
    }
    return null
}

# The closing bracket is checked first and the depth lowered before it is consumed, so a line break
# after it still ends the statement. A missing one points at the bracket that was left open.
func p_close(t: string, msg: string) {
    if (P_kind != t) {
        let d = p_fail(msg)
        if (d != null) {
            let opener = p_find_opener(t)
            if (opener != null) {
                diag_label(d, tspan(opener), "this '{opener.v}' is never closed")
            }
        }
        return null
    }
    P_depth -= 1
    p_next()
}

func p_skip_nl() {
    while (P_kind == "nl") {
        p_next()
    }
}

# Parses source text with its own token stream, then restores the parser.
let P_inline = 0

func parse_inline(text: string, line: int, col: int) -> Node {
    P_inline += 1
    let saved_toks = P_toks
    let saved_pos = P_pos
    let saved_depth = P_depth
    let saved_prev = P_prev
    P_toks = lex(text, line, col)
    P_pos = 0
    P_depth = 1
    p_sync()
    let e = p_expr()
    if (not (P_kind == "eof")) {
        p_fail("Invalid expression inside string interpolation")
    }
    P_inline -= 1
    P_toks = saved_toks
    P_pos = saved_pos
    P_depth = saved_depth
    P_prev = saved_prev
    p_sync()
    return e
}

# A string literal: a "str" node, or a "tmpl" node whose parts are "text" nodes and the expressions
# of its interpolations.
func p_string(tk: Token) -> Node {
    let parts = tk.parts
    let has_expr = false
    for (let part in parts) {
        if (part.expr != null) {
            has_expr = true
        }
    }
    if (not has_expr) {
        return mk_lit("str", tk, tk, parts[0].text)
    }
    let items: list<Node> = []
    for (let part in parts) {
        if (part.expr != null) {
            append(items, parse_inline(part.expr, part.line, part.col))
        } else {
            append(items, mk_lit("text", tk, tk, part.text))
        }
    }
    return mk_tmpl(tk, tk, items)
}

func p_list_literal(st: Token) -> Node {
    p_enter()
    let items: list<Node> = []
    while (not (P_kind == "]") and not (P_kind == "eof")) {
        append(items, p_expr())
        if (not p_eat(",")) {
            break
        }
    }
    p_close("]", "Expected ']' at end of list")
    return mk_list(st, P_prev, items)
}

func p_map_literal(st: Token) -> Node {
    p_enter()
    let keys: list<string> = []
    let vals: list<Node> = []
    while (not (P_kind == "}") and not (P_kind == "eof")) {
        if (not (P_kind == "str")) {
            p_fail("Map literal keys must be strings")
            break
        }
        let kt = p_next()
        if (len(kt.parts) != 1 or kt.parts[0].expr != null) {
            p_fail_at(kt, "Map literal keys must be plain strings", "this key has an interpolation")
            break
        }
        let key = kt.parts[0].text
        if (contains(keys, key)) {
            p_fail_at(kt, "Map literal key '{key}' is given twice", "the key again")
        }
        append(keys, key)
        p_expect(":", "Expected ':' after map key")
        append(vals, p_expr())
        if (not p_eat(",")) {
            break
        }
    }
    p_close("}", "Expected '}' at end of map literal")
    return mk_map(st, P_prev, keys, vals)
}

# A type annotation after ':' on a variable, a parameter or a field: a type name, and for list and
# map an element type in angle brackets, as in list<int> or map<list<float>>. Returned as text.
func p_type(what: string, after: string = ":") -> string {
    # box is a keyword (box[16] makes one) and also the name of its type
    if (P_kind == "box") {
        p_next()
        return "box"
    }
    if (not (P_kind == "id")) {
        p_fail("Expected a type after '{after}' in {what}")
        return "any"
    }
    let name = p_next().v
    if (not (P_kind == "<")) {
        return name
    }
    if (name != "list" and name != "map") {
        p_fail("Only list and map take an element type, for example list<int>")
        return name
    }
    p_next()
    let inner = p_type(what)
    p_close_angle()
    return "{name}<{inner}>"
}

# The '>' that ends an element type. A '>>' or '>=' token is split: the first '>' is used up and the
# rest stays as the current token.
func p_close_angle() {
    if (P_kind == ">") {
        p_next()
        return null
    }
    if (P_kind == ">>" or P_kind == ">=") {
        let rest = ">"
        if (P_kind == ">=") {
            rest = "="
        }
        P_tk.t = rest
        P_tk.v = rest
        P_tk.col += 1
        P_kind = rest
        P_split_tok = P_tk
        return null
    }
    p_fail("Expected '>' to close the element type")
}

# The span of the type annotation that started at token st and has just been read.
func p_type_span(st: Token) -> Span {
    if (P_split_tok != null and P_split_tok == P_tk) {
        return span_at(st.line, st.col, P_tk.line, P_tk.col)
    }
    return span_at(st.line, st.col, P_prev.eline, P_prev.ecol)
}

# name and nt are the name and its token of a named function, "" and null for a function value; st the
# token where the function starts.
# A parameter without a type has "" in ptypes and an empty item in tspans; a parameter without a default
# has an empty item in defaults.
func p_func_rest(name: string, nt: Token, st: Token, is_export: bool) -> Node {
    p_open("(", "Expected '('")
    p_scope_push()
    let params: list<string> = []
    let defaults: list<Node> = []
    let ptypes: list<string> = []
    let pspans: list<Span> = []
    let tspans: list<Span> = []
    let has_default = false
    let has_type = false
    while (not (P_kind == ")") and not (P_kind == "eof")) {
        if (not (P_kind == "id")) {
            p_fail("Expected parameter name")
            break
        }
        let pt = p_next()
        p_declare(pt.v, pt)
        append(params, pt.v)
        append(pspans, tspan(pt))
        if (p_eat(":")) {
            let ts = P_tk
            append(ptypes, p_type("a parameter"))
            append(tspans, p_type_span(ts))
            has_type = true
        } else {
            append(ptypes, "")
            append(tspans, null)
        }
        if (p_eat("=")) {
            append(defaults, p_expr())
            has_default = true
        } else {
            if (has_default) {
                let d = p_diag(tspan(pt), "Parameter '{pt.v}' needs a default value because an earlier parameter has one", "no default value", false)
                if (d != null) {
                    diag_hint(d, "Give it a default, for example {pt.v} = 0, or move it before the parameters that have one")
                }
            }
            append(defaults, null)
        }
        if (not p_eat(",")) {
            break
        }
    }
    p_close(")", "Expected ')'")
    # func area(w: float, h: float) -> float: the type of the result
    let rtype = ""
    let rspan: Span = null
    if (P_kind == "->") {
        p_next()
        let ts = P_tk
        rtype = p_type("a function", "->")
        rspan = p_type_span(ts)
    }
    p_skip_nl()
    p_expect("\{", "Expected '\{'")
    let body = p_block_body()
    p_scope_pop()
    let n = mk_func(st, P_prev, null, params, defaults, null, body, is_export, nt, pspans, tspans)
    if (name != "") {
        n.name = name
    }
    if (has_type) {
        n.ptypes = ptypes
    }
    if (rtype != "") {
        n.rtype = rtype
        n.rspan = rspan
    }
    return n
}

func p_primary() -> Node {
    let tk = P_tk
    let line = tk.line
    let t = tk.t
    if (t == "num") {
        p_next()
        return mk_lit("num", tk, tk, tk.v)
    }
    if (t == "float") {
        p_next()
        return mk_lit("float", tk, tk, tk.v)
    }
    if (t == "str") {
        p_next()
        return p_string(tk)
    }
    if (t == "char") {
        p_next()
        return mk_lit("char", tk, tk, "{tk.v}")
    }
    if (t == "true" or t == "false") {
        p_next()
        return mk_lit("bool", tk, tk, t)
    }
    if (t == "id") {
        p_next()
        return mk_id(tk, tk, tk.v)
    }
    if (t == "(") {
        p_next()
        p_enter()
        let e = p_expr()
        p_close(")", "Expected ')' after expression")
        return e
    }
    if (t == "[") {
        p_next()
        return p_list_literal(tk)
    }
    if (t == "\{") {
        p_next()
        return p_map_literal(tk)
    }
    if (t == "func") {
        p_next()
        return p_func_rest("", null, tk, false)
    }
    if (t == "box") {
        p_next()
        p_expect("[", "Expected '[' after 'box'")
        let size = p_expr()
        p_expect("]", "Expected ']' after box size")
        return mk_box(tk, P_prev, size)
    }
    if (t == ";") {
        let d = p_fail("Unexpected semicolon ';'")
        diag_hint(d, "A statement ends at the end of the line. Put each statement on its own line")
    } else if (t == "eof" and P_inline > 0) {
        # "{1 +}": the end of the interpolation, not of the file
        p_fail("Invalid expression inside string interpolation: an expression is missing before its closing }")
    } else {
        let d = p_fail("Unexpected token '{t}': expected an expression")
        if (t == "else") {
            diag_hint(d, "'else' must follow the closing brace of an if block")
        } else if (t == "case" or t == "default") {
            diag_hint(d, "'{t}' belongs inside a switch block")
        } else if (t == ")" or t == "]" or t == "}") {
            diag_hint(d, "There is no matching opening bracket, or an expression is missing before it")
        } else if (t == "eof" or t == "nl") {
            diag_hint(d, "Finish the expression: a value, a name or a call is needed here")
        }
    }
    return mk_lit("num", tk, tk, "0")
}

# The arguments of a call: their values, names and the places of the names. A named argument is written
# name: value and comes after the positional ones; names is empty when no argument is named, else it holds
# the name of each argument ("" for a positional one).
template CallArgs { args: list<Node>, names: list<string>, nspans: list<Span> }

func p_args(closer: string, msg: string) -> CallArgs {
    p_enter()
    let args: list<Node> = []
    let names: list<string> = []
    let nspans: list<Span> = []
    let named = false
    while (not p_at(closer) and not p_at("eof")) {
        let nt: Token = null
        if (P_kind == "id" and P_toks[P_pos + 1].t == ":") {
            nt = p_next()
            p_next()
            for (let i = 0; i < len(names); i++) {
                if (names[i] == nt.v) {
                    let d = p_fail_at(nt, "Argument '{nt.v}' is named twice", "named again here")
                    if (d != null) {
                        diag_label(d, nspans[i], "first named here")
                        diag_hint(d, "Give each argument once")
                    }
                }
            }
            named = true
        } else if (named) {
            let d = p_fail_at(P_tk, "A positional argument cannot come after a named one", "positional, after a named argument")
            if (d != null) {
                diag_hint(d, "Put the positional arguments first, or name this one too")
            }
        }
        append(args, p_expr())
        if (nt == null) {
            append(names, "")
            append(nspans, null)
        } else {
            append(names, nt.v)
            append(nspans, tspan(nt))
        }
        if (not p_eat(",")) {
            break
        }
    }
    p_close(closer, msg)
    if (not named) {
        return CallArgs(args, null, null)
    }
    return CallArgs(args, names, nspans)
}

# A call node with the arguments p_args gave.
func p_mk_call(st: Token, callee: Node, a: CallArgs, open: Token) -> Node {
    let c = mk_call(st, P_prev, callee, a.args, span_at(open.line, open.col, P_prev.eline, P_prev.ecol))
    c.names = a.names
    c.nspans = a.nspans
    return c
}

func p_postfix() -> Node {
    let st = P_tk
    let e = p_primary()
    while (true) {
        if ((P_kind == "(")) {
            let open = P_tk
            p_next()
            e = p_mk_call(st, e, p_args(")", "Expected ')' after arguments"), open)
        } else if ((P_kind == "\{") and e.k == "id") {
            let open = P_tk
            p_next()
            e = p_mk_call(st, e, p_args("}", "Expected '}' after typed constructor arguments"), open)
        } else if ((P_kind == "[")) {
            p_next()
            p_enter()
            let lo: Node = null
            if (P_kind != ":") {
                lo = p_expr()
            }
            if (P_kind == ":") {
                p_next()
                let hi: Node = null
                if (P_kind != "]") {
                    hi = p_expr()
                }
                p_close("]", "Expected ']' after slice")
                e = mk_slice(st, P_prev, e, lo, hi)
            } else {
                p_close("]", "Expected ']' after index")
                e = mk_index(st, P_prev, e, lo)
            }
        } else if ((P_kind == ".")) {
            p_next()
            let tk = P_tk
            let is_word = tk.t == "id" or (tk.v != null and map_has(KEYWORDS, tk.v))
            if (not is_word) {
                p_fail("Expected field name after '.'")
                break
            }
            p_next()
            e = mk_field(st, P_prev, e, tk.v, tk)
        } else if ((P_kind == "++") or (P_kind == "--")) {
            let optk = P_tk
            if (e.k != "id") {
                p_fail_at(optk, "'{optk.t}' can only be applied to variables", "this is not a variable")
                p_next()
                break
            }
            p_next()
            e = mk_incdec(st, P_prev, e.name, optk.t, false, st)
        } else {
            break
        }
    }
    return e
}

func p_unary() -> Node {
    let st = P_tk
    if (p_eat("-")) {
        let r = p_unary()
        if (r.k == "num" or r.k == "float") {
            # A literal that is already negative (as in -(-3)) turns positive.
            if (starts_with(r.v, "-")) {
                r.v = cut(r.v, 1, len(r.v))
            } else {
                r.v = "-{r.v}"
            }
            r.col = st.col
            return r
        }
        let zero = mk_lit("num", st, st, "0")
        return mk_neg(st, P_prev, zero, r, st)
    }
    if ((P_kind == "++") or (P_kind == "--")) {
        let op = p_next().t
        if (not (P_kind == "id")) {
            p_fail("'{op}' can only be applied to variables")
            return mk_lit("num", st, st, "0")
        }
        let nt = p_next()
        return mk_incdec(st, P_prev, nt.v, op, true, nt)
    }
    if (p_eat("+")) {
        return p_unary()
    }
    if (P_kind == "~") {
        # ~x is x ^ -1
        p_next()
        let operand = p_unary()
        let one = mk_lit("num", st, st, "-1")
        return mk_bin(st, P_prev, "^", operand, one, st)
    }
    let base = p_postfix()
    if (P_kind == "**") {
        # ** binds tighter than a unary minus on its left and is right-associative: -2 ** 2 is -4
        let optk = P_tk
        p_next()
        p_skip_nl()
        let rhs = p_unary()
        return mk_bin(st, P_prev, "**", base, rhs, optk)
    }
    return base
}

# Binding power of each binary operator; a higher number binds tighter. All are left-associative.
let BINARY: map<int> = {
    "or": 1, "and": 2,
    "==": 3, "!=": 3,
    "<": 4, ">": 4, "<=": 4, ">=": 4,
    "|": 5, "^": 6, "&": 7, "<<": 8, ">>": 8,
    "+": 9, "-": 9,
    "*": 10, "/": 10, "%": 10
}

# Parses an expression whose operators all bind at least as tight as min_bp.
# Expressions nested deeper than this are a syntax error: the parser, the checker and the code generator
# each recurse once per level, and about 20,000 levels ran the compiler out of stack.
const MAX_NESTING = 10000
let P_nesting = 0

func p_expr_bp(min_bp: int) -> Node {
    P_nesting += 1
    if (P_nesting > MAX_NESTING) {
        let d = p_fail("Expression is nested more than {MAX_NESTING} levels deep")
        diag_hint(d, "Split it into several statements with variables for the parts")
        diag_exit_if_errors()
    }
    let r = p_expr_bp_inner(min_bp)
    P_nesting -= 1
    return r
}

func p_expr_bp_inner(min_bp: int) -> Node {
    let st = P_tk
    let left: Node = null
    if (min_bp <= 3 and (P_kind == "not")) {
        # not binds looser than a comparison and tighter than and: not a == b is not (a == b).
        p_next()
        let operand = p_expr_bp(3)
        left = mk_not(st, P_prev, operand)
    } else {
        left = p_as(p_unary(), st)
    }
    while (true) {
        if (not map_has(BINARY, P_tk.t) or BINARY[P_tk.t] < min_bp) {
            break
        }
        let bp = BINARY[P_tk.t]
        let optk = P_tk
        let op = p_next().t
        p_skip_nl()
        let right = p_expr_bp(bp + 1)
        left = mk_bin(st, P_prev, op, left, right, optk)
    }
    return left
}

func p_expr() -> Node {
    return p_expr_bp(1)
}

# x as int, x as float and x as string are int(x), float(x) and string(x): the tree holds the call. 'as'
# binds tighter than every binary operator (a + b as int is a + (b as int)) and looser than a unary minus.
func p_as(left: Node, st: Token) -> Node {
    while (P_kind == "as") {
        p_next()
        if (not (P_kind == "id") or (P_tk.v != "int" and P_tk.v != "float" and P_tk.v != "string")) {
            let d = p_fail("Expected int, float or string after 'as'")
            if (d != null) {
                diag_hint(d, "'as' converts a value: n as int, x as float, v as string")
            }
            return left
        }
        let tt = p_next()
        left = mk_call(st, tt, mk_id(tt, tt, tt.v), [left], span_at(tt.line, tt.col, tt.eline, tt.ecol))
    }
    return left
}

# The calls whose value may be missing, besides the conversions int(x) and float(x).
let P_MAY_MISS: list<string> = ["find", "index_of", "last_index_of", "open"]

# Whether e is a value that may be missing, the value 'else' and 'if (let ...)' take: a conversion int(x)
# or float(x) (also written x as int and x as float), an index or field read, a search or open.
func p_can_fail(e: Node) -> bool {
    if (e.k == "index" or e.k == "field") {
        return true
    }
    if (e.k != "call" or e.callee.k != "id") {
        return false
    }
    if (e.callee.name == "int" or e.callee.name == "float") {
        return len(e.args) == 1
    }
    return contains(P_MAY_MISS, e.callee.name)
}

# The checks of the value of a 'let' with 'else' or of 'if (let ...)'; what names the construct.
func p_check_can_fail(e: Node, what: string) {
    if (not p_can_fail(e)) {
        let d = p_fail_span(node_span(e), "{what} needs a value that may be missing", "this cannot be missing")
        if (d != null) {
            diag_hint(d, "Use a conversion (s as int), a read (m[key], p.field), find, index_of, last_index_of or open")
        }
    }
}

# Whether a block ends by leaving: its last statement is return, break or continue, or a call of exit.
func p_leaves(stmts: list<Node>) -> bool {
    if (len(stmts) == 0) {
        return false
    }
    let last = stmts[len(stmts) - 1]
    if (last.k == "return" or last.k == "break" or last.k == "continue") {
        return true
    }
    return last.k == "call" and last.callee.k == "id" and last.callee.name == "exit"
}

func p_block() -> list<Node> {
    p_scope_push()
    let stmts = p_block_body()
    p_scope_pop()
    return stmts
}

# After a statement: when it had an error, skip to the start of the next statement; a statement
# that consumed nothing and had no error cannot happen, but one token is skipped so that a loop
# over statements always ends.
func p_stmt_end(before: int) {
    if (P_panic) {
        p_recover()
    } else if (P_pos == before) {
        p_next()
    } else if ((P_kind == "num" or P_kind == "float" or P_kind == "str" or P_kind == "char") and P_toks[P_pos - 1].t != "nl") {
        # Several statements may share a line (let a = 1 let b = 2), but a literal right after a finished
        # statement cannot start one that does anything: let x = a--1 was let x = a-- and a stray 1, and
        # let y = 3 4 dropped the 4 without a word. (An if statement has already read the line break while it
        # looked for else.)
        p_fail("Expected a line break after the statement")
        p_recover()
    }
}

# Panic mode ends here. Skips tokens up to and including the line break that ends the statement.
# Brackets that were open when the error happened are matched first, so a call that continues on the
# next lines is skipped as a whole. A { that is not inside brackets opens a block whose statements
# are parsed on their own; its } is then skipped silently. A } that closes the enclosing block stops
# the skipping.
func p_recover() {
    P_panic = false
    let depth = P_depth
    P_depth = 0
    p_sync()
    if (depth > 0 and P_pos > 0 and P_toks[P_pos - 1].t == "nl" and P_kind != "eof") {
        # The error is the first token of a line inside an unfinished bracket, as when a closing
        # bracket was forgotten: the line is taken to start a new statement.
        return null
    }
    let opened = 0
    while (P_kind != "eof") {
        let k = P_kind
        if (k == "nl" and depth == 0) {
            p_next()
            break
        }
        if (k == "(" or k == "[") {
            depth += 1
        } else if (k == "\{") {
            if (depth == 0) {
                opened += 1
            } else {
                depth += 1
            }
        } else if (k == ")" or k == "]") {
            if (depth > 0) {
                depth -= 1
            }
        } else if (k == "}") {
            if (depth > 0) {
                depth -= 1
            } else if (opened > 0) {
                opened -= 1
            } else {
                break
            }
        }
        p_next()
    }
    P_ignore_close += opened
}

func p_block_body() -> list<Node> {
    let open_tk = P_prev
    let saved_depth = P_depth
    P_depth = 0
    p_sync()
    let stmts: list<Node> = []
    while (not (P_kind == "eof")) {
        if (P_kind == "}") {
            if (P_ignore_close > 0) {
                P_ignore_close -= 1
                p_next()
                continue
            }
            break
        }
        if (p_eat("nl")) {
            continue
        }
        let before = P_pos
        append(stmts, p_statement())
        p_stmt_end(before)
    }
    if (P_kind == "}") {
        p_next()
    } else {
        let d = p_fail("Expected '}'")
        if (d != null and open_tk != null and open_tk.t == "\{") {
            diag_label(d, tspan(open_tk), "this '\{' is never closed")
        }
    }
    P_depth = saved_depth
    p_sync()
    return stmts
}

# A name without a type has "" in types.
func p_declaration(st: Token, is_const: bool, is_export: bool) -> Node {
    let names: list<string> = []
    let types: list<string> = []
    let nspans: list<Span> = []
    let tspans: list<Span> = []
    let more = true
    while (more) {
        if (not (P_kind == "id")) {
            p_fail("Expected variable name after 'let' or ','")
            break
        }
        let nt = p_next()
        p_declare(nt.v, nt)
        append(names, nt.v)
        append(nspans, tspan(nt))
        if (p_eat(":")) {
            let ts = P_tk
            append(types, p_type("a variable"))
            append(tspans, p_type_span(ts))
        } else {
            append(types, "")
            append(tspans, null)
        }
        more = p_eat(",")
        if (more) {
            p_skip_nl()
        }
    }
    let vals: list<Node> = []
    if (p_eat("=")) {
        p_skip_nl()
        more = true
        while (more) {
            append(vals, p_expr())
            more = p_eat(",")
            if (more) {
                p_skip_nl()
            }
        }
    }
    if (len(names) == 0) {
        return mk_lit("num", st, st, "0")
    }
    if (is_const and len(vals) != len(names)) {
        let d = p_fail_span(span_at(st.line, st.col, P_prev.eline, P_prev.ecol), "const declarations require an initializer for every name", "needs a value for every name")
        diag_hint(d, "Write the value after the name, for example const limit = 10")
    }
    if (len(vals) > 0 and len(vals) != len(names)) {
        let d = p_fail_span(span_at(st.line, st.col, P_prev.eline, P_prev.ecol), "Variable count ({len(names)}) does not match value count ({len(vals)})", "{len(names)} names, {len(vals)} values")
        diag_hint(d, "Give one value for each name")
    }
    let end = P_prev
    if (P_kind == "else" and len(names) == 1 and len(vals) == 1 and not is_const) {
        # let n = s as int else { ... }: the block runs when the conversion fails, and must leave
        let et = p_next()
        p_check_can_fail(vals[0], "'else' after 'let'")
        p_expect("\{", "Expected '\{' after 'else'")
        let orelse = p_block()
        if (not P_panic and not p_leaves(orelse)) {
            let d = p_fail_at(et, "The 'else' block of a 'let' must leave", "can end without leaving")
            if (d != null) {
                diag_hint(d, "End it with return, break or continue: after the 'let', '{names[0]}' must hold a value")
            }
        }
        let n = mk_let(st, P_prev, names[0], vals[0], is_export, is_const, types[0], nspans[0], tspans[0])
        n.orelse = orelse
        return n
    }
    if (len(names) == 1) {
        let init: Node = null
        if (len(vals) > 0) {
            init = vals[0]
        }
        return mk_let(st, end, names[0], init, is_export, is_const, types[0], nspans[0], tspans[0])
    }
    let lets: list<Node> = []
    for (let i = 0; i < len(names); i++) {
        let init: Node = null
        if (len(vals) > 0 and i < len(vals)) {
            init = vals[i]
        }
        append(lets, mk_let(st, end, names[i], init, is_export, is_const, types[i], nspans[i], tspans[i]))
    }
    return mk_group(st, end, lets)
}

func p_cond_paren(what: string) -> Node {
    p_open("(", "Expected '(' after {what}")
    let c = p_expr()
    p_close(")", "Expected ')' after condition")
    return c
}

func p_if(st: Token) -> Node {
    let cond: Node = null
    let bound = false
    if (P_kind == "(" and P_toks[P_pos + 1].t == "let") {
        # if (let n = s as int) { ... }: n exists in the first block only, where the conversion worked
        p_open("(", "Expected '(' after if")
        let lt = p_next()
        if (not (P_kind == "id")) {
            p_fail("Expected variable name after 'let'")
        }
        let nt = p_next()
        p_expect("=", "Expected '=' after the name in 'if (let ...)'")
        let e = p_expr()
        p_close(")", "Expected ')' after condition")
        p_check_can_fail(e, "'if (let ...)'")
        cond = mk_let(lt, P_prev, nt.v, e, false, false, "", span_at(nt.line, nt.col, nt.eline, nt.ecol), null)
        p_scope_push()
        p_declare(nt.v, nt)
        bound = true
    } else {
        cond = p_cond_paren("if")
    }
    p_skip_nl()
    p_expect("\{", "Expected '\{'")
    let then_body = p_block()
    if (bound) {
        p_scope_pop()
    }
    let els: list<Node> = []
    # else may come after blank lines; the line breaks read here also end the if statement (p_stmt_end)
    p_skip_nl()
    if (p_eat("else")) {
        p_skip_nl()
        if ((P_kind == "if")) {
            els = [p_statement()]
        } else {
            p_expect("\{", "Expected '\{'")
            els = p_block()
        }
    }
    return mk_if(st, P_prev, cond, then_body, els)
}

func p_for(st: Token) -> Node {
    p_scope_push()
    let n = p_for_header(st)
    p_scope_pop()
    return n
}

func p_for_header(st: Token) -> Node {
    p_open("(", "Expected '(' after for")
    if ((P_kind == "let")) {
        let lt = p_next()
        if (not (P_kind == "id")) {
            p_fail("Expected loop variable name in for loop")
            return mk_while(st, st, mk_lit("bool", st, st, "false"), [])
        }
        let nt = p_next()
        let name = nt.v
        p_declare(name, nt)
        if (p_eat_word("in")) {
            let iter = p_expr()
            p_close(")", "Expected ')' after for-in iterable")
            p_skip_nl()
            p_expect("\{", "Expected '\{' for loop body")
            let body = p_block()
            return mk_forin(st, P_prev, name, iter, body, nt)
        }
        let ty = ""
        let tsp: Span = null
        if (p_eat(":")) {
            let ts = P_tk
            ty = p_type("a variable")
            tsp = p_type_span(ts)
        }
        let first: Node = null
        if (p_eat("=")) {
            first = p_expr()
        }
        let init = mk_let(lt, P_prev, name, first, false, false, ty, span_at(nt.line, nt.col, nt.eline, nt.ecol), tsp)
        return p_for_rest(st, init)
    }
    if ((P_kind == ";")) {
        return p_for_rest(st, null)
    }
    return p_for_rest(st, p_statement())
}

func p_for_rest(st: Token, init: Node) -> Node {
    p_expect(";", "Expected ';' after loop initializer")
    let cond: Node = null
    if (not (P_kind == ";")) {
        cond = p_expr()
    }
    p_expect(";", "Expected ';' after loop condition")
    let incr: Node = null
    if (not (P_kind == ")")) {
        incr = p_statement()
    }
    p_close(")", "Expected ')' after loop increment")
    p_skip_nl()
    p_expect("\{", "Expected '\{' for loop body")
    let body = p_block()
    return mk_for(st, P_prev, init, cond, incr, body)
}

# Each case is a "case" node: its value in e and its statements in body.
func p_switch(st: Token) -> Node {
    p_open("(", "Expected '(' after switch")
    let e = p_expr()
    p_close(")", "Expected ')'")
    p_skip_nl()
    p_expect("\{", "Expected '\{' starting switch block")
    let cases: list<Node> = []
    let dflt: list<Node> = []
    let seen_default = false
    let seen_values: map<bool> = {}
    while (not (P_kind == "}") and not (P_kind == "eof")) {
        let ctk = P_tk
        if (p_eat("case")) {
            let v = p_expr()
            # A literal value given twice: the second case could never run.
            if (v.k == "num" or v.k == "float" or v.k == "str" or v.k == "char" or v.k == "bool") {
                let key = "{v.k}:{v.v}"
                if (map_has(seen_values, key)) {
                    p_fail_span(node_span(v), "case value {v.v} appears twice in this switch", "already a case above")
                }
                seen_values[key] = true
            }
            p_expect(":", "Expected ':' after case value")
            let body = p_case_body()
            append(cases, mk_case(ctk, v, body))
        } else if (p_eat("default")) {
            if (seen_default) {
                p_fail_at(P_prev, "switch has two default branches", "the second default")
            }
            seen_default = true
            p_expect(":", "Expected ':' after default")
            dflt = p_case_body()
        } else if (p_eat("nl")) {
            continue
        } else {
            p_fail("Expected 'case' or 'default' inside switch")
            p_recover()
        }
    }
    p_expect("}", "Expected '}' ending switch")
    return mk_switch(st, P_prev, e, cases, dflt)
}

func p_case_body() -> list<Node> {
    p_scope_push()
    let body: list<Node> = []
    while (not (P_kind == "case") and not (P_kind == "default") and not (P_kind == "}") and not (P_kind == "eof")) {
        if (p_eat("nl")) {
            continue
        }
        let before = P_pos
        append(body, p_statement())
        p_stmt_end(before)
    }
    p_scope_pop()
    return body
}

func compound_op(t: string) -> string {
    if (t == "+=") {
        return "+"
    }
    if (t == "-=") {
        return "-"
    }
    if (t == "*=") {
        return "*"
    }
    if (t == "/=") {
        return "/"
    }
    if (t == "%=") {
        return "%"
    }
    return ""
}

func p_simple(st: Token) -> Node {
    let e = p_expr()
    if (P_kind == "=") {
        p_next()
        p_skip_nl()
        let v = p_expr()
        if (e.k == "id") {
            return mk_assign(st, P_prev, e.name, v, e)
        }
        return make_setidx(st, e, v, "")
    }
    let op = compound_op(P_tk.t)
    if (op != "") {
        let optk = p_next()
        p_skip_nl()
        let rhs = p_expr()
        if (e.k == "id") {
            let b = mk_bin(st, P_prev, op, e, rhs, optk)
            return mk_assign(st, P_prev, e.name, b, e)
        }
        return make_setidx(st, e, rhs, op)
    }
    return e
}

# target[index] = value  /  target.field = value, with an optional compound op ("" for none).
func make_setidx(st: Token, e: Node, v: Node, op: string) -> Node {
    let index = e.index
    if (e.k == "field") {
        index = mk_lit("str", span_token(e.fspan), span_token(e.fspan), e.field)
    }
    if (e.k == "index" or e.k == "field") {
        let n = mk_setidx(st, P_prev, e.target, index, v, null)
        if (op != "") {
            n.op = op
        }
        return n
    }
    let d = p_fail_span(node_span(e), "Invalid assignment target", "cannot assign to this")
    diag_hint(d, "Assign to a variable, an item such as list[0], or a field such as point.x")
    return v
}

# A field without a type has "" in ftypes.
func p_typedef(st: Token, word: string, is_export: bool) -> Node {
    if (not (P_kind == "id")) {
        p_fail("Expected a name after '{word}'")
        return mk_block("block", st, st, [])
    }
    let nt = p_next()
    let name = nt.v
    p_declare(name, nt)
    let fields: list<string> = []
    let ftypes: list<string> = []
    let fspans: list<Span> = []
    p_expect("\{", "Expected '\{' after type name")
    while (not (P_kind == "}") and not (P_kind == "eof")) {
        p_skip_nl()
        if (not (P_kind == "id")) {
            p_fail("Expected field name in {word} declaration")
            break
        }
        let ft = p_next()
        # the same check the runtime makes when the type is defined, found before the program runs
        if (contains(fields, ft.v)) {
            p_fail_at(ft, "{word} has duplicate field names", "'{ft.v}' is already a field")
        }
        append(fields, ft.v)
        append(fspans, tspan(ft))
        if (P_kind == ":") {
            p_next()
            append(ftypes, p_field_type(word))
        } else {
            append(ftypes, "")
        }
        p_skip_nl()
        if (not p_eat(",")) {
            break
        }
    }
    p_expect("}", "Expected '}' after {word} fields")
    let n = mk_typedef(st, P_prev, is_export, name, word == "template", word == "bloc", fields, ftypes, nt, fspans)
    p_check_field_types(n, word)
    return n
}

# The type after "name:" in a bloc or template field: int, float, bool, char, string, list, map,
# function, the name of another type, or box[N]. Returned as text: "box:16" for box[16].
func p_field_type(word: string) -> string {
    if (P_kind == "box") {
        p_next()
        p_expect("[", "Expected '[' after box in a field type")
        if (not (P_kind == "num")) {
            p_fail("A box field needs its size written as a number, for example box[16]")
            return "box:0"
        }
        let size = p_next().v
        p_expect("]", "Expected ']' after the box size")
        return "box:{size}"
    }
    return p_type("a {word} field")
}

# A data type has no field types. A bloc has types on all its fields or on none.
func p_check_field_types(n: Node, word: string) {
    let typed = 0
    for (let t in n.ftypes) {
        if (t != "") {
            typed += 1
        }
    }
    if (typed == 0) {
        return null
    }
    if (word == "data") {
        let d = p_diag(n.nspan, "data fields cannot have types; use a template for typed fields", "this is a data type", false)
        diag_hint(d, "Change 'data' to 'template' to keep the field types")
        return null
    }
    if (word == "bloc" and typed != len(n.fields)) {
        let d = p_diag(n.nspan, "bloc '{n.name}': give a type to every field or to none", "{typed} of {len(n.fields)} fields have a type", false)
        if (d != null) {
            for (let i = 0; i < len(n.fields); i++) {
                if (n.ftypes[i] == "") {
                    diag_label(d, n.fspans[i], "no type")
                }
            }
        }
    }
    return null
}

func p_use(st: Token, word: string) -> Node {
    let names: list<string> = []
    let nspans: list<Span> = []
    if ((P_kind == "\{")) {
        p_next()
        p_enter()
        while (not (P_kind == "}") and not (P_kind == "eof")) {
            if (not (P_kind == "id")) {
                p_fail("Expected exported name inside use list")
                break
            }
            let ut = p_next()
            p_declare(ut.v, ut)
            append(names, ut.v)
            append(nspans, tspan(ut))
            if (not p_eat(",")) {
                break
            }
        }
        p_close("}", "Expected '}' after use list")
        p_expect_word("from", "Expected 'from' after use list")
    }
    if (not (P_kind == "str")) {
        p_fail("Expected string path after {word}")
        return mk_use(st, st, names, "", st, nspans)
    }
    let pt = p_next()
    # The path is found when the program is compiled, so it cannot depend on a value: no interpolation.
    if (len(pt.parts) == 0) {
        p_fail_at(pt, "Expected string path after {word}: the path is empty", "this path is empty")
        return mk_use(st, P_prev, names, "", pt, nspans)
    }
    if (len(pt.parts) != 1 or pt.parts[0].expr != null) {
        p_fail_at(pt, "Expected string path after {word}: a path cannot hold an interpolation", "this path has an interpolation")
        return mk_use(st, P_prev, names, "", pt, nspans)
    }
    return mk_use(st, P_prev, names, pt.parts[0].text, pt, nspans)
}

# One statement.
func p_statement() -> Node {
    let tk = P_tk
    let t = tk.t
    if (t == "func") {
        p_next()
        if (not (P_kind == "id")) {
            p_fail("Expected function name after 'func'")
            return mk_block("block", tk, tk, [])
        }
        let nt = p_next()
        p_declare(nt.v, nt)
        return p_func_rest(nt.v, nt, tk, false)
    }
    if (t == "let" or t == "const") {
        p_next()
        return p_declaration(tk, t == "const", false)
    }
    if (t == "export") {
        p_next()
        if ((P_kind == "let") or (P_kind == "const")) {
            let is_const = (P_kind == "const")
            if (not is_const) {
                let d = p_fail_at(P_tk, "export cannot be used with let", "this variable can change")
                diag_hint(d, "Use export const for a value that stays the same, or export a function that returns the value: an importer gets a copy of an exported let that does not follow later changes")
            }
            p_next()
            return p_declaration(tk, is_const, true)
        }
        if ((P_kind == "func")) {
            p_next()
            if (not (P_kind == "id")) {
                p_fail("Expected function name after 'func'")
                return mk_block("block", tk, tk, [])
            }
            let nt = p_next()
            p_declare(nt.v, nt)
            return p_func_rest(nt.v, nt, tk, true)
        }
        if (p_at_data() or (P_kind == "template") or (P_kind == "bloc")) {
            let word = p_next().v
            return p_typedef(tk, word, true)
        }
        p_fail("export can only be used with func, const, template, bloc or data declarations")
        return mk_block("block", tk, tk, [])
    }
    if (t == "use" or t == "import") {
        p_next()
        return p_use(tk, t)
    }
    if (p_at_data() or t == "template" or t == "bloc") {
        p_next()
        return p_typedef(tk, tk.v, false)
    }
    if (t == "\{") {
        p_next()
        let body = p_block()
        return mk_block("block", tk, P_prev, body)
    }
    if (t == "unsafe") {
        p_next()
        p_eat("nl")
        p_expect("\{", "Expected '\{' after unsafe")
        let body = p_block()
        return mk_block("unsafe", tk, P_prev, body)
    }
    if (t == "return") {
        p_next()
        let e = null
        if (not (P_kind == "}") and not (P_kind == "nl") and not (P_kind == "eof")) {
            e = p_expr()
        }
        return mk_return(tk, P_prev, e)
    }
    if (t == "break") {
        p_next()
        return mk_jump("break", tk, tk)
    }
    if (t == "continue") {
        p_next()
        return mk_jump("continue", tk, tk)
    }
    if (t == "if") {
        p_next()
        return p_if(tk)
    }
    if (t == "while") {
        p_next()
        let cond = p_cond_paren("while")
        p_skip_nl()
        p_expect("\{", "Expected '\{'")
        let body = p_block()
        return mk_while(tk, P_prev, cond, body)
    }
    if (t == "for") {
        p_next()
        return p_for(tk)
    }
    if (t == "switch") {
        p_next()
        return p_switch(tk)
    }
    return p_simple(tk)
}

export func parse_program(toks: list<Token>) -> list<Node> {
    P_toks = toks
    P_pos = 0
    P_depth = 0
    P_prev = null
    P_panic = false
    P_ignore_close = 0
    P_split_tok = null
    P_scopes = [{}]
    p_sync()
    let stmts: list<Node> = []
    while (not (P_kind == "eof")) {
        if (p_eat("nl")) {
            continue
        }
        if (P_kind == "}") {
            if (P_ignore_close > 0) {
                P_ignore_close -= 1
            } else {
                let d = p_fail("Unexpected '}': there is no block to close")
                diag_hint(d, "Remove it, or add the '\{' that it should close")
                P_panic = false
            }
            p_next()
            continue
        }
        let before = P_pos
        append(stmts, p_statement())
        p_stmt_end(before)
    }
    return stmts
}

# Lexes and parses a whole source text. Every lexical and syntax error found is printed together and
# the run ends if there was any.
# Stops the run when the text has a syntax error. Errors found before (the type checker reads imported
# files while it checks the main one) are left to be reported with the rest.
export func parse_source(text: string) -> list<Node> {
    let before = diag_count()
    let stmts = parse_program(lex(text, 1))
    if (diag_count() > before) {
        diag_exit_if_errors()
    }
    return stmts
}
