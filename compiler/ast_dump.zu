#
# ast_dump.zu: the AST as text, for `zue ast prog.zu`. One top-level statement per line, written as
#   (kind@line :field value :field value ...)
# Fields are sorted by name, so the same tree always gives the same text.

use { NODE_FIELDS, OPTIONAL_FIELDS } from "ast_nodes.zu"

func quote_text(s) {
    let q = "\""
    let t = replace(s, "\\", "\\\\")
    t = replace(t, q, "\\\"")
    t = replace(t, "\n", "\\n")
    return q + t + q
}

func dump_value(x) {
    let t = type(x)
    if (t == "map" or t == "template") {
        return dump_node(x)
    }
    if (t == "list") {
        let items = []
        for (let item in x) {
            append(items, dump_value(item))
        }
        return "[" + join(items, " ") + "]"
    }
    if (t == "string") {
        return quote_text(x)
    }
    return to_string(x)
}

# A node is a template with a k kind; other maps (switch cases) print as "map". A field in
# OPTIONAL_FIELDS that is null was never set, so it is left out.
func is_optional(key) {
    for (let name in OPTIONAL_FIELDS) {
        if (name == key) {
            return true
        }
    }
    return false
}

func dump_node(n) {
    let kind = n.k
    let keys = []
    let is_tree_node = type(n) == "template"
    if (is_tree_node) {
        for (let name in NODE_FIELDS[kind]) {
            append(keys, name)
        }
    } else {
        keys = map_keys(n)
    }
    sort(keys)
    if (kind == null) {
        kind = "map"
    }
    let parts = ["({kind}@{n.line}"]
    for (let key in keys) {
        if (key != "k" and key != "line") {
            let value = n[key]
            if (not (is_tree_node and value == null and is_optional(key))) {
                append(parts, ":{key} {dump_value(value)}")
            }
        }
    }
    return join(parts, " ") + ")"
}

export func dump_program(stmts) {
    let lines = []
    for (let s in stmts) {
        append(lines, dump_value(s))
    }
    return join(lines, "\n")
}
