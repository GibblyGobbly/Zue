# The int for r, or an error when r (also NaN) is outside -2^63 <= r < 2^63.
func _round_to_int(self_p, o, r) {
    if (fge(r, -9223372036854775808.0) == 0 or flt(r, 9223372036854775808.0) == 0) {
        _errf(E_RUNTIME, cstr("Keep the value in the 64-bit int range, or use the float result."),
              cstr("%s() result does not fit in a 64-bit int"), _fname(self_p), 0, 0)
    }
    _int(o, f2i(r))
}

# 0 = floor, 1 = ceil, 2 = round, 3 = trunc
func _round_builtin(self_p, argc_i, argv_p, which, o) {
    lv_arity(self_p, argc_i, 1, 1)
    if (_tag(argv_p) == T_INT) {
        _cp(o, argv_p)
        return 0
    }
    let x = _arg_num(self_p, argv_p, 0)
    if (which == 0) {
        _round_to_int(self_p, o, floor(x))
    } else if (which == 1) {
        _round_to_int(self_p, o, ceil(x))
    } else if (which == 2) {
        _round_to_int(self_p, o, round(x))
    } else {
        _round_to_int(self_p, o, trunc(x))
    }
}

func lb_floor(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _round_builtin(self_p, argc_i, argv_p, 0, o)
    retp(o)
}

func lb_ceil(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _round_builtin(self_p, argc_i, argv_p, 1, o)
    retp(o)
}

# round(x) gives an int. round(x, digits) keeps x a float with 0 to 15 decimal places, halves away
# from zero; an int x is returned unchanged. The scaling is done in binary, so a value such as
# 1.005 (really 1.00499999999999989...) rounds down.
func lb_round(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 2)
    let o = stack_buf(16)
    if (argc_i == 1) {
        _round_builtin(self_p, argc_i, argv_p, 2, o)
        retp(o)
    }
    let x = _arg_num(self_p, argv_p, 0)
    if (_tag(argv_p + 16) != T_INT) {
        _errf(E_TYPE, 0, cstr("round() digits must be an int, got %s"), _type_name(argv_p + 16), 0, 0)
    }
    let digits = _val(argv_p + 16)
    if (digits < 0 or digits > 15) {
        _errf(E_ARGUMENT, cstr("Use a number of decimal places from 0 to 15."),
              cstr("round() digits must be between 0 and 15"), 0, 0, 0)
    }
    if (_tag(argv_p) == T_INT) {
        _cp(o, argv_p)
        retp(o)
    }
    let scale = 1.0
    for (let i = 0; i < digits; i++) {
        scale = fmul(scale, 10.0)
    }
    let v = fmul(x, scale)
    if (fge(fabs(v), 9007199254740992.0)) {
        _flt(o, x)
        retp(o)
    }
    _flt(o, fdiv(round(v), scale))
    retp(o)
}

func lb_trunc(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _round_builtin(self_p, argc_i, argv_p, 3, o)
    retp(o)
}

# base ** exp for ints with exp >= 0, by repeated squaring; an overflow is an error.
func _int_pow(base, n) {
    let result = 1
    let b = base
    let e = n
    while (e > 0) {
        if (band(e, 1) != 0) {
            if (mulof(result, b) != 0) {
                _overflow(cstr("pow"))
            }
            result = result * b
        }
        e = shr(e, 1)
        if (e > 0) {
            if (mulof(b, b) != 0) {
                _overflow(cstr("pow"))
            }
            b = b * b
        }
    }
    return result
}

func lb_pow(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    _arg_num(self_p, argv_p, 0)
    _arg_num(self_p, argv_p, 1)
    let o = stack_buf(16)
    if (_tag(argv_p) == T_INT and _tag(argv_p + 16) == T_INT and _val(argv_p + 16) < 0) {
        if (_val(argv_p) == 0) {
            _div_zero()
        }
        _errf(E_ARGUMENT, cstr("Use floats for a negative power, for example pow(2.0, -1.0)."),
              cstr("%s() exponent of an int must not be negative"), _fname(self_p), 0, 0)
    }
    if (_tag(argv_p) == T_INT and _tag(argv_p + 16) == T_INT) {
        _int(o, _int_pow(_val(argv_p), _val(argv_p + 16)))
        retp(o)
    }
    let x = _num(argv_p)
    let y = _num(argv_p + 16)
    if (feq(x, 0.0) and flt(y, 0.0)) {
        _div_zero()
    }
    if (flt(x, 0.0) and fne(y, trunc(y))) {
        _domain(self_p, cstr("base must not be negative when the exponent is not a whole number"))
    }
    let r = pow(x, y)
    if (_is_finite(r) == 0) {
        _math_overflow(self_p)
    }
    _flt(o, r)
    retp(o)
}

func lb_atan2(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let o = stack_buf(16)
    _flt(o, atan2(_arg_num(self_p, argv_p, 0), _arg_num(self_p, argv_p, 1)))
    retp(o)
}

# The two arguments of mod, floor_div and divmod must both be ints or both be floats.
func _same_number_type(self_p, argv_p) {
    _arg_num(self_p, argv_p, 0)
    _arg_num(self_p, argv_p, 1)
    if (_tag(argv_p) != _tag(argv_p + 16)) {
        let msg = stack_buf(256)
        snprintf(msg, 256, cstr("%s() arguments must both be int or both be float, got %s and %s"),
                 _fname(self_p), _type_name(argv_p), _type_name(argv_p + 16))
        lv_error(E_TYPE, msg, cstr("Convert one of them with int() or float() so that both have the same type."))
    }
}

# Floored division of ints: the quotient rounds toward negative infinity and the remainder takes the
# sign of the divisor. The results are left in g_math_q and g_math_r.
let g_math_q = 0
let g_math_r = 0
let g_math_ovf = 0

func _floor_divmod_int(a, b) {
    if (b == 0) {
        _div_zero()
    }
    g_math_ovf = 0
    if (b == -1) {
        g_math_r = 0
        g_math_q = 0
        if (a == -9223372036854775807 - 1) {
            g_math_ovf = 1
        } else {
            g_math_q = 0 - a
        }
        return 0
    }
    let q = a / b
    let r = a % b
    if (r != 0 and ((r < 0) != (b < 0))) {
        q -= 1
        r += b
    }
    g_math_q = q
    g_math_r = r
}

# The floored remainder of floats: the sign of the divisor. The divisor is not zero and both are
# finite, so the result is finite.
func _floor_mod_float(a, b) {
    let r = fmod(a, b)
    if (fne(r, 0.0) and (flt(r, 0.0) != flt(b, 0.0))) {
        r = fadd(r, b)
    }
    return r
}

func lb_mod(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    _same_number_type(self_p, argv_p)
    let o = stack_buf(16)
    if (_tag(argv_p) == T_INT) {
        _floor_divmod_int(_val(argv_p), _val(argv_p + 16))
        _int(o, g_math_r)
        retp(o)
    }
    let b = _num(argv_p + 16)
    if (feq(b, 0.0)) {
        _div_zero()
    }
    _flt(o, _floor_mod_float(_num(argv_p), b))
    retp(o)
}

func lb_floor_div(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    _same_number_type(self_p, argv_p)
    let o = stack_buf(16)
    if (_tag(argv_p) == T_INT) {
        _floor_divmod_int(_val(argv_p), _val(argv_p + 16))
        if (g_math_ovf != 0) {
            _overflow(cstr("floor_div"))
        }
        _int(o, g_math_q)
        retp(o)
    }
    let b = _num(argv_p + 16)
    if (feq(b, 0.0)) {
        _div_zero()
    }
    let q = floor(fdiv(_num(argv_p), b))
    if (_is_finite(q) == 0) {
        _float_overflow(cstr("floor_div"))
    }
    _flt(o, q)
    retp(o)
}

func lb_divmod(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    _same_number_type(self_p, argv_p)
    let o = stack_buf(16)
    let cell = stack_buf(16)
    _list_new(o, 2)
    if (_tag(argv_p) == T_INT) {
        _floor_divmod_int(_val(argv_p), _val(argv_p + 16))
        if (g_math_ovf != 0) {
            _overflow(cstr("divmod"))
        }
        _int(cell, g_math_q)
        _list_push(o, cell)
        _int(cell, g_math_r)
        _list_push(o, cell)
        retp(o)
    }
    let b = _num(argv_p + 16)
    if (feq(b, 0.0)) {
        _div_zero()
    }
    let q = floor(fdiv(_num(argv_p), b))
    if (_is_finite(q) == 0) {
        _float_overflow(cstr("divmod"))
    }
    _flt(cell, q)
    _list_push(o, cell)
    _flt(cell, _floor_mod_float(_num(argv_p), b))
    _list_push(o, cell)
    retp(o)
}

func lb_lerp(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 3, 3)
    let a = _arg_num(self_p, argv_p, 0)
    let b = _arg_num(self_p, argv_p, 1)
    let t = _arg_num(self_p, argv_p, 2)
    let o = stack_buf(16)
    let r = fadd(a, fmul(fsub(b, a), t))
    if (_is_finite(r) == 0) {
        _math_overflow(self_p)
    }
    _flt(o, r)
    retp(o)
}

# Files

# The LvFile of argument i, which must be an open file.
func _arg_file(self_p, argv, i) {
    if (_tag(argv + 16 * i) != T_FILE) {
        _arg_fail(self_p, argv, i, cstr("file"))
    }
    let f = _val(argv + 16 * i)
    if (ld32(f + FI_CLOSED) != 0) {
        _errf(E_RUNTIME, 0, cstr("%s() on a closed file"), _fname(self_p), 0, 0)
    }
    return f
}

func lb_open(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let path = _arg_str(self_p, argv_p, 0)
    let mode = _arg_str(self_p, argv_p, 1)
    let m = mode + S_DATA
    if (strcmp(m, cstr("r")) != 0 and strcmp(m, cstr("w")) != 0 and strcmp(m, cstr("a")) != 0) {
        _errf(E_ARGUMENT, cstr("Use \"r\", \"w\" or \"a\""), cstr("open() mode '%s' is not supported"), m, 0, 0)
    }
    let o = stack_buf(16)
    let fp = fopen(path + S_DATA, m)
    if (fp == 0) {
        _null(o)
        retp(o)
    }
    let f = lv_alloc(16)
    st64(f + FI_FP, fp)
    st32(f + FI_CLOSED, 0)
    _set(o, T_FILE, f)
    retp(o)
}

func lb_close(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let f = _arg_file(self_p, argv_p, 0)
    fclose(ld64(f + FI_FP))
    st32(f + FI_CLOSED, 1)
    let o = stack_buf(16)
    _null(o)
    retp(o)
}

func lb_read(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let f = _arg_file(self_p, argv_p, 0)
    let b = stack_buf(B_SIZE)
    let o = stack_buf(16)
    let chunk = stack_buf(65536)
    _buf_init(b)
    let n = fread(chunk, 1, 65536, ld64(f + FI_FP))
    while (n > 0) {
        _buf_add(b, chunk, n)
        n = fread(chunk, 1, 65536, ld64(f + FI_FP))
    }
    _buf_done(o, b)
    retp(o)
}

func lb_read_line(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let f = _arg_file(self_p, argv_p, 0)
    let o = stack_buf(16)
    let cell = stack_buf(16)
    st64(cell, 0)
    st64(cell + 8, 0)
    let n = getline(cell, cell + 8, ld64(f + FI_FP))
    let line = ld64(cell)
    if (n < 0) {
        free(line)
        _null(o)
        retp(o)
    }
    if (n > 0 and ld8(line + n - 1) == 10) {
        n -= 1
    }
    _str_n(o, line, n)
    free(line)
    retp(o)
}

func lb_write(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let f = _arg_file(self_p, argv_p, 0)
    let s = stack_buf(16)
    _to_string(s, argv_p + 16)
    let w = fwrite(_val(s) + S_DATA, 1, ld64(_val(s)), ld64(f + FI_FP))
    let o = stack_buf(16)
    _bool(o, w == ld64(_val(s)))
    retp(o)
}

func lb_file_exists(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    _bool(o, access(_arg_str(self_p, argv_p, 0) + S_DATA, 0) == 0)
    retp(o)
}

func lb_remove_file(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    _bool(o, remove(_arg_str(self_p, argv_p, 0) + S_DATA) == 0)
    retp(o)
}

func lb_flush(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    fflush(ld64(_arg_file(self_p, argv_p, 0) + FI_FP))
    let o = stack_buf(16)
    _null(o)
    retp(o)
}

# Dense lists and vector math

func lb_dense_list(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    _arg_int(self_p, argv_p, 0)
    if (_tag(argv_p + 16) != T_FLOAT) {
        _arg_fail(self_p, argv_p, 1, cstr("float"))
    }
    let n = _val(argv_p)
    if (n < 0) {
        lv_error(E_ARGUMENT, cstr("dense_list() size must not be negative"), cstr("Usage: dense_list(100, 1.5)"))
    }
    let o = stack_buf(16)
    _dense_new(o, n)
    let dat = ld64(_val(o) + D_DATA)
    for (let i = 0; i < n; i++) {
        dat[i] = _val(argv_p + 16)
    }
    retp(o)
}

func _vec_op(self_p, argc_i, argv_p, op, o) {
    lv_arity(self_p, argc_i, 2, 2)
    _list_arith(o, op, argv_p, argv_p + 16)
}

func lb_vec_add(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _vec_op(self_p, argc_i, argv_p, 0, o)
    retp(o)
}

func lb_vec_sub(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _vec_op(self_p, argc_i, argv_p, 1, o)
    retp(o)
}

func lb_vec_mul(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _vec_op(self_p, argc_i, argv_p, 2, o)
    retp(o)
}

func lb_vec_div(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _vec_op(self_p, argc_i, argv_p, 3, o)
    retp(o)
}

func lb_vec_mul_inline(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    if (_tag(argv_p) != T_DENSE) {
        _arg_fail(self_p, argv_p, 0, cstr("dense list"))
    }
    if (_tag(argv_p + 16) != T_DENSE) {
        _arg_fail(self_p, argv_p, 1, cstr("dense list"))
    }
    let a = _val(argv_p)
    let b = _val(argv_p + 16)
    let n = ld64(a + D_COUNT)
    if (ld64(b + D_COUNT) != n) {
        _errf4(E_ARGUMENT, cstr("Both lists need the same number of elements."),
               cstr("vec_mul_inline() lists have different lengths (%d and %d)"), n, ld64(b + D_COUNT), 0, 0)
    }
    let da = ld64(a + D_DATA)
    let db = ld64(b + D_DATA)
    for (let i = 0; i < n; i++) {
        let r = fmul(da[i], db[i])
        if (_is_finite(r) == 0) {
            _float_overflow(cstr("*"))
        }
        da[i] = r
    }
    let o = stack_buf(16)
    _null(o)
    retp(o)
}

func _row_len(r) {
    if (_tag(r) == T_LIST) {
        return ld64(_val(r) + L_COUNT)
    }
    if (_tag(r) == T_DENSE) {
        return ld64(_val(r) + D_COUNT)
    }
    return 0
}

func _row_at(r, j) {
    if (_tag(r) == T_DENSE) {
        return ld64(_val(r) + D_DATA)[j]
    }
    return _elem(ld64(_val(r) + L_ITEMS) + 16 * j)
}

func lb_mat_mul(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let o = stack_buf(16)
    let a = argv_p
    let b = argv_p + 16
    if (_is_listish(a) == 0) {
        _arg_fail(self_p, argv_p, 0, cstr("list of rows"))
    }
    if (_is_listish(b) == 0) {
        _arg_fail(self_p, argv_p, 1, cstr("list of rows"))
    }
    let rows_a = 1
    let rows_b = 1
    if (_tag(a) == T_LIST) {
        rows_a = ld64(_val(a) + L_COUNT)
    }
    if (_tag(b) == T_LIST) {
        rows_b = ld64(_val(b) + L_COUNT)
    }
    if (rows_a == 0 or rows_b == 0) {
        _list_new(o, 0)
        retp(o)
    }
    let first_a = a
    let first_b = b
    if (_tag(a) == T_LIST and ld64(_val(a) + L_COUNT) > 0) {
        first_a = ld64(_val(a) + L_ITEMS)
    }
    if (_tag(b) == T_LIST and ld64(_val(b) + L_COUNT) > 0) {
        first_b = ld64(_val(b) + L_ITEMS)
    }
    let cols_a = _row_len(first_a)
    let cols_b = _row_len(first_b)
    if (cols_a != rows_b or cols_a == 0) {
        _errf(E_ARGUMENT, cstr("The first matrix needs as many columns as the second has rows."),
              cstr("mat_mul() dimension mismatch (%d columns vs %d rows)"), cols_a, rows_b, 0)
    }
    let fa = lv_alloc(8 * rows_a * cols_a)
    let fb = lv_alloc(8 * rows_b * cols_b)
    let fc = calloc(rows_a * cols_b, 8)
    if (fc == 0) {
        lv_error(E_RUNTIME, cstr("out of memory"), 0)
    }
    for (let i = 0; i < rows_a; i++) {
        let row = a
        if (_tag(a) == T_LIST) {
            row = ld64(_val(a) + L_ITEMS) + 16 * i
        }
        for (let j = 0; j < cols_a; j++) {
            fa[i * cols_a + j] = _row_at(row, j)
        }
    }
    for (let i = 0; i < rows_b; i++) {
        let row = b
        if (_tag(b) == T_LIST) {
            row = ld64(_val(b) + L_ITEMS) + 16 * i
        }
        for (let j = 0; j < cols_b; j++) {
            fb[i * cols_b + j] = _row_at(row, j)
        }
    }
    for (let i = 0; i < rows_a; i++) {
        for (let k = 0; k < cols_a; k++) {
            let av = fa[i * cols_a + k]
            for (let j = 0; j < cols_b; j++) {
                let r = fadd(fc[i * cols_b + j], fmul(av, fb[k * cols_b + j]))
                if (_is_finite(r) == 0) {
                    _float_overflow(cstr("*"))
                }
                fc[i * cols_b + j] = r
            }
        }
    }
    let res = stack_buf(16)
    let row_lv = stack_buf(16)
    _list_new(res, rows_a)
    for (let i = 0; i < rows_a; i++) {
        _dense_new(row_lv, cols_b)
        let rd = ld64(_val(row_lv) + D_DATA)
        for (let j = 0; j < cols_b; j++) {
            rd[j] = fc[i * cols_b + j]
        }
        _list_push(res, row_lv)
    }
    free(fc)
    retp(res)
}

# Random numbers

# xoroshiro128++, seeded and scrambled exactly as in src/math_lib.c.
space("_rng", 16)

func _rotl(x, k) {
    return bor(shl(x, k), shr(x, 64 - k))
}

func _rng_next() {
    let s = addr_of("_rng")
    let s0 = s[0]
    let s1 = s[1]
    let result = _rotl(s0 + s1, 17) + s0
    s1 = bxor(s1, s0)
    s[0] = bxor(bxor(_rotl(s0, 49), s1), shl(s1, 21))
    s[1] = _rotl(s1, 28)
    return result
}

func _os_entropy() {
    let val = stack_buf(8)
    st64(val, 0)
    let f = fopen(cstr("/dev/urandom"), cstr("rb"))
    if (f != 0) {
        if (fread(val, 8, 1, f) != 1) {
            st64(val, time(0))
        }
        fclose(f)
    } else {
        st64(val, time(0))
    }
    return ld64(val)
}

func _splitmix(z0) {
    let z = z0 + -7046029254386353131
    z = bxor(z, shr(z, 30)) * -4658895280553007687
    z = bxor(z, shr(z, 27)) * -7723592293110705685
    return bxor(z, shr(z, 31))
}

func _seed(seed) {
    let s = addr_of("_rng")
    s[0] = _splitmix(seed)
    s[1] = _splitmix(s[0])
}

func _srand_default() {
    _seed(_os_entropy())
}

func lb_trand(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 0, 0)
    let o = stack_buf(16)
    _int(o, _os_entropy())
    retp(o)
}

func lb_srand(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 0, 1)
    if (argc_i == 0) {
        _seed(_os_entropy())
    } else {
        _seed(_arg_int(self_p, argv_p, 0))
    }
    let o = stack_buf(16)
    _null(o)
    retp(o)
}

func lb_rand(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 0, 2)
    let o = stack_buf(16)
    if (argc_i == 0) {
        let r = _rng_next()
        _flt(o, fmul(i2f(shr(r, 11)), fdiv(1.0, 9007199254740992.0)))
        retp(o)
    }
    let lo = 0
    let hi = 0
    if (argc_i == 1) {
        hi = _arg_int(self_p, argv_p, 0)
    } else {
        lo = _arg_int(self_p, argv_p, 0)
        hi = _arg_int(self_p, argv_p, 1)
    }
    if (lo > hi) {
        let t = lo
        lo = hi
        hi = t
    }
    let range = hi - lo + 1
    if (range == 0) {
        # The range covers every 64-bit value.
        _int(o, _rng_next())
        retp(o)
    }
    _int(o, lo + urem(_rng_next(), range))
    retp(o)
}

func lb_shuffle(self_p, argc_i, argv_p) {
    if (argc_i != 1 or _tag(argv_p) != T_LIST) {
        lv_error(E_ARGUMENT, cstr("shuffle() expects 1 list"), cstr("Usage: shuffle(myList)"))
    }
    let l = _val(argv_p)
    let items = ld64(l + L_ITEMS)
    let t = stack_buf(16)
    let i = ld64(l + L_COUNT) - 1
    while (i > 0) {
        let j = urem(_rng_next(), i + 1)
        _cp(t, items + 16 * i)
        _cp(items + 16 * i, items + 16 * j)
        _cp(items + 16 * j, t)
        i -= 1
    }
    let o = stack_buf(16)
    _null(o)
    retp(o)
}

# Stalin sort: drops every element smaller than the last one kept.
func lb_ssort(self_p, argc_i, argv_p) {
    if (argc_i != 1 or (_tag(argv_p) != T_LIST and _tag(argv_p) != T_DENSE)) {
        lv_error(E_ARGUMENT, cstr("ssort() expects 1 list"), cstr("Usage: ssort(myList)"))
    }
    let o = stack_buf(16)
    _null(o)
    if (_tag(argv_p) == T_LIST) {
        let l = _val(argv_p)
        if (ld64(l + L_COUNT) <= 1) {
            retp(o)
        }
        let items = ld64(l + L_ITEMS)
        let w = 1
        let last = stack_buf(16)
        _cp(last, items)
        for (let r = 1; r < ld64(l + L_COUNT); r++) {
            let cur = items + 16 * r
            if (_sort_cmp(cur, last) >= 0) {
                _cp(items + 16 * w, cur)
                w++
                _cp(last, cur)
            }
        }
        st64(l + L_COUNT, w)
    } else {
        let d = _val(argv_p)
        if (ld64(d + D_COUNT) <= 1) {
            retp(o)
        }
        let dat = ld64(d + D_DATA)
        let w = 1
        let last = dat[0]
        for (let r = 1; r < ld64(d + D_COUNT); r++) {
            if (fge(dat[r], last)) {
                dat[w] = dat[r]
                w++
                last = dat[r]
            }
        }
        st64(d + D_COUNT, w)
    }
    retp(o)
}

# Greatest common divisor of two ints by Euclid's algorithm. The result may be negative; a divisor
# of -1 is handled apart because INT_MIN % -1 traps.
func _gcd_int(x, y) {
    let a = x
    let b = y
    while (b != 0) {
        if (b == -1) {
            a = 1
            b = 0
        } else {
            let t = a % b
            a = b
            b = t
        }
    }
    return a
}

func _int_pair(self_p, argv_p) {
    for (let i = 0; i < 2; i++) {
        if (_tag(argv_p + 16 * i) != T_INT) {
            _errf(E_TYPE, 0, cstr("%s() argument %d must be an int, got %s"), _fname(self_p), i + 1,
                  _type_name(argv_p + 16 * i))
        }
    }
}

func lb_gcd(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    _int_pair(self_p, argv_p)
    let g = _gcd_int(_val(argv_p), _val(argv_p + 16))
    if (g == -9223372036854775807 - 1) {
        _overflow(cstr("gcd"))
    }
    let o = stack_buf(16)
    if (g < 0) {
        g = 0 - g
    }
    _int(o, g)
    retp(o)
}

func lb_lcm(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    _int_pair(self_p, argv_p)
    let x = _val(argv_p)
    let y = _val(argv_p + 16)
    let o = stack_buf(16)
    if (x == 0 or y == 0) {
        _int(o, 0)
        retp(o)
    }
    let g = _gcd_int(x, y)
    if (g == -9223372036854775807 - 1) {
        _overflow(cstr("lcm"))
    }
    if (g < 0) {
        g = 0 - g
    }
    let q = x / g
    if (mulof(q, y) != 0) {
        _overflow(cstr("lcm"))
    }
    let r = q * y
    if (r == -9223372036854775807 - 1) {
        _overflow(cstr("lcm"))
    }
    if (r < 0) {
        r = 0 - r
    }
    _int(o, r)
    retp(o)
}

# The largest r with r * r <= n: the float square root is within one of it, then corrected exactly.
func lb_isqrt(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    if (_tag(argv_p) != T_INT) {
        _errf(E_TYPE, 0, cstr("isqrt() argument must be an int, got %s"), _type_name(argv_p), 0, 0)
    }
    let n = _val(argv_p)
    if (n < 0) {
        _errf(E_ARGUMENT, cstr("Check the value before taking the square root."),
              cstr("isqrt() argument must not be negative"), 0, 0, 0)
    }
    let r = f2i(sqrt(i2f(n)))
    while (mulof(r, r) != 0 or r * r > n) {
        r = r - 1
    }
    while (mulof(r + 1, r + 1) == 0 and (r + 1) * (r + 1) <= n) {
        r = r + 1
    }
    let o = stack_buf(16)
    _int(o, r)
    retp(o)
}
