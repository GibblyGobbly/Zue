# The int for r, or an error when r (also NaN) is outside -2^63 <= r < 2^63.
func _round_to_int(self_p, o, r) {
    if (fge(r, -9223372036854775808.0) == 0 or flt(r, 9223372036854775808.0) == 0) {
        _errf(E_RUNTIME, cstr("Keep the value in the 64-bit int range, or use the float result."),
              cstr("%s() result does not fit in a 64-bit int"), _fname(self_p), 0, 0)
    }
    _int(o, f2i(r))
}

# 0 = floor, 1 = ceil, 2 = round, 3 = trunc
func _round_builtin(self_p, argc_i, argv_p, which, o) {
    lv_arity(self_p, argc_i, 1, 1)
    let x = _arg_flt(self_p, argv_p, 0)
    if (which == 0) {
        _round_to_int(self_p, o, floor(x))
    } else if (which == 1) {
        _round_to_int(self_p, o, ceil(x))
    } else if (which == 2) {
        _round_to_int(self_p, o, round(x))
    } else {
        _round_to_int(self_p, o, trunc(x))
    }
}

func lb_floor(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _round_builtin(self_p, argc_i, argv_p, 0, o)
    retp(o)
}

func lb_ceil(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _round_builtin(self_p, argc_i, argv_p, 1, o)
    retp(o)
}

# round(x) gives an int. round(x, digits) keeps x a float with 0 to 15 decimal places, halves away
# from zero; an int x is returned unchanged. The scaling is done in binary, so a value such as
# 1.005 (really 1.00499999999999989...) rounds down.
func lb_round(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 2)
    let o = stack_buf(16)
    if (argc_i == 1) {
        _round_builtin(self_p, argc_i, argv_p, 2, o)
        retp(o)
    }
    let x = _arg_num(self_p, argv_p, 0)
    if (_tag(argv_p + 16) != T_INT) {
        _errf(E_TYPE, cstr("The second argument is the number of decimal places, a whole number from 0 to 15"), cstr("round() digits must be an int, got %s"), _type_name(argv_p + 16), 0, 0)
    }
    let digits = _val(argv_p + 16)
    if (digits < 0 or digits > 15) {
        _errf(E_ARGUMENT, cstr("Use a number of decimal places from 0 to 15."),
              cstr("round() digits must be between 0 and 15"), 0, 0, 0)
    }
    if (_tag(argv_p) == T_INT) {
        _cp(o, argv_p)
        retp(o)
    }
    let scale = 1.0
    for (let i = 0; i < digits; i++) {
        scale = fmul(scale, 10.0)
    }
    let v = fmul(x, scale)
    if (fge(fabs(v), 9007199254740992.0)) {
        _flt(o, x)
        retp(o)
    }
    _flt(o, fdiv(round(v), scale))
    retp(o)
}

func lb_trunc(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _round_builtin(self_p, argc_i, argv_p, 3, o)
    retp(o)
}

# base ** exp for ints with exp >= 0, by repeated squaring; an overflow is an error.
func _int_pow(base, n) {
    let result = 1
    let b = base
    let e = n
    while (e > 0) {
        if (band(e, 1) != 0) {
            if (mulof(result, b) != 0) {
                _overflow(cstr("pow"))
            }
            result = result * b
        }
        e = shr(e, 1)
        if (e > 0) {
            if (mulof(b, b) != 0) {
                _overflow(cstr("pow"))
            }
            b = b * b
        }
    }
    return result
}

func lb_pow(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    _same_number_type(self_p, argv_p)
    let o = stack_buf(16)
    if (_tag(argv_p) == T_INT and _tag(argv_p + 16) == T_INT and _val(argv_p + 16) < 0) {
        if (_val(argv_p) == 0) {
            _div_zero()
        }
        _errf(E_ARGUMENT, cstr("Use floats for a negative power, for example pow(2.0, -1.0)."),
              cstr("%s() exponent of an int must not be negative"), _fname(self_p), 0, 0)
    }
    if (_tag(argv_p) == T_INT and _tag(argv_p + 16) == T_INT) {
        _int(o, _int_pow(_val(argv_p), _val(argv_p + 16)))
        retp(o)
    }
    let x = _num(argv_p)
    let y = _num(argv_p + 16)
    if (feq(x, 0.0) and flt(y, 0.0)) {
        _div_zero()
    }
    if (flt(x, 0.0) and fne(y, trunc(y))) {
        _domain(self_p, cstr("base must not be negative when the exponent is not a whole number"))
    }
    let r = pow(x, y)
    if (_is_finite(r) == 0) {
        _math_overflow(self_p)
    }
    _flt(o, r)
    retp(o)
}

func lb_atan2(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let o = stack_buf(16)
    _flt(o, atan2(_arg_flt(self_p, argv_p, 0), _arg_flt(self_p, argv_p, 1)))
    retp(o)
}

# The two arguments of mod, floor_div and divmod must both be ints or both be floats.
func _same_number_type(self_p, argv_p) {
    _arg_num(self_p, argv_p, 0)
    _arg_num(self_p, argv_p, 1)
    if (_tag(argv_p) != _tag(argv_p + 16)) {
        let msg = stack_buf(256)
        snprintf(msg, 256, cstr("%s() arguments must both be int or both be float, got %s and %s"),
                 _fname(self_p), _type_name(argv_p), _type_name(argv_p + 16))
        lv_error(E_TYPE, msg, cstr("Convert one of them with int() or float() so that both have the same type."))
    }
}

# Floored division of ints: the quotient rounds toward negative infinity and the remainder takes the
# sign of the divisor. The results are left in g_math_q and g_math_r.
let g_math_q = 0
let g_math_r = 0
let g_math_ovf = 0

func _floor_divmod_int(a, b) {
    if (b == 0) {
        _div_zero()
    }
    g_math_ovf = 0
    if (b == -1) {
        g_math_r = 0
        g_math_q = 0
        if (a == -9223372036854775807 - 1) {
            g_math_ovf = 1
        } else {
            g_math_q = 0 - a
        }
        return 0
    }
    let q = a / b
    let r = a % b
    if (r != 0 and ((r < 0) != (b < 0))) {
        q -= 1
        r += b
    }
    g_math_q = q
    g_math_r = r
}

# The floored remainder of floats: the sign of the divisor, and smaller than it in size. The divisor is not
# zero and both are finite, so the result is finite. Adding the divisor to a tiny remainder of the other sign
# can round to the divisor itself (mod(-1e-300, 1e300)); the float just below it is the nearest one that is a
# remainder.
func _floor_mod_float(a, b) {
    let r = fmod(a, b)
    if (fne(r, 0.0) and (flt(r, 0.0) != flt(b, 0.0))) {
        r = fadd(r, b)
        if (fge(fabs(r), fabs(b))) {
            r = nextafter(b, 0.0)
        }
    }
    return r
}

# The floored quotient of floats, the one that goes with _floor_mod_float: a = q * b + r up to rounding.
# floor(a / b) can be one more: divmod(1.0, 0.1) gave [10.0, 0.0999...] although 10 * 0.1 + 0.0999 is 1.1.
func _floor_div_float(a, b) {
    return round(fdiv(fsub(a, _floor_mod_float(a, b)), b))
}

func lb_mod(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    _same_number_type(self_p, argv_p)
    let o = stack_buf(16)
    if (_tag(argv_p) == T_INT) {
        _floor_divmod_int(_val(argv_p), _val(argv_p + 16))
        _int(o, g_math_r)
        retp(o)
    }
    let b = _num(argv_p + 16)
    if (feq(b, 0.0)) {
        _div_zero()
    }
    _flt(o, _floor_mod_float(_num(argv_p), b))
    retp(o)
}

func lb_floor_div(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    _same_number_type(self_p, argv_p)
    let o = stack_buf(16)
    if (_tag(argv_p) == T_INT) {
        _floor_divmod_int(_val(argv_p), _val(argv_p + 16))
        if (g_math_ovf != 0) {
            _overflow(cstr("floor_div"))
        }
        _int(o, g_math_q)
        retp(o)
    }
    let b = _num(argv_p + 16)
    if (feq(b, 0.0)) {
        _div_zero()
    }
    let q = _floor_div_float(_num(argv_p), b)
    if (_is_finite(q) == 0) {
        _float_overflow(cstr("floor_div"))
    }
    _flt(o, q)
    retp(o)
}

func lb_divmod(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    _same_number_type(self_p, argv_p)
    let o = stack_buf(16)
    let cell = stack_buf(16)
    _list_new(o, 2)
    if (_tag(argv_p) == T_INT) {
        _floor_divmod_int(_val(argv_p), _val(argv_p + 16))
        if (g_math_ovf != 0) {
            _overflow(cstr("divmod"))
        }
        _int(cell, g_math_q)
        _list_push(o, cell)
        _int(cell, g_math_r)
        _list_push(o, cell)
        retp(o)
    }
    let b = _num(argv_p + 16)
    if (feq(b, 0.0)) {
        _div_zero()
    }
    let q = _floor_div_float(_num(argv_p), b)
    if (_is_finite(q) == 0) {
        _float_overflow(cstr("divmod"))
    }
    _flt(cell, q)
    _list_push(o, cell)
    _flt(cell, _floor_mod_float(_num(argv_p), b))
    _list_push(o, cell)
    retp(o)
}

func lb_lerp(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 3, 3)
    let a = _arg_flt(self_p, argv_p, 0)
    let b = _arg_flt(self_p, argv_p, 1)
    let t = _arg_flt(self_p, argv_p, 2)
    let o = stack_buf(16)
    let r = fadd(a, fmul(fsub(b, a), t))
    # b - a can overflow when the result does not: lerp(-1e308, 1e308, 0.5) is 0.0.
    if (_is_finite(fsub(b, a)) == 0) {
        r = fadd(fmul(a, fsub(1.0, t)), fmul(b, t))
    }
    if (_is_finite(r) == 0) {
        _math_overflow(self_p)
    }
    _flt(o, r)
    retp(o)
}

# Files

# The LvFile of argument i, which must be an open file.
func _arg_file(self_p, argv, i) {
    if (_tag(argv + 16 * i) != T_FILE) {
        _arg_fail(self_p, argv, i, cstr("file"))
    }
    let f = _val(argv + 16 * i)
    if (ld32(f + FI_CLOSED) != 0) {
        _errf(E_RUNTIME, cstr("The file was closed earlier. Open it again with open() before using it"), cstr("%s() on a closed file"), _fname(self_p), 0, 0)
    }
    return f
}

# An error for a file operation that the system refused, with its reason (errno).
func _io_fail(self_p) {
    let e = ld32(__errno_location())
    _errf(E_RUNTIME, cstr("The system reported this error. Check the disk, the path and the mode the file was opened with."),
          cstr("%s() failed: %s"), _fname(self_p), strerror(e), 0)
}

func lb_open(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let path = _arg_path(self_p, argv_p, 0)
    let mode = _arg_str(self_p, argv_p, 1)
    let m = mode + S_DATA
    if (strcmp(m, cstr("r")) != 0 and strcmp(m, cstr("w")) != 0 and strcmp(m, cstr("a")) != 0) {
        _errf(E_ARGUMENT, cstr("Use \"r\", \"w\" or \"a\""), cstr("open() mode '%s' is not supported"), m, 0, 0)
    }
    let o = stack_buf(16)
    let fp = fopen(path + S_DATA, m)
    if (fp == 0) {
        _null(o)
        retp(o)
    }
    # fopen opens a directory for reading; reading it would fail, so it is refused like a missing file.
    let st = stack_buf(144)
    if (fstat(fileno(fp), st) == 0 and band(ld32(st + 24), 61440) == 16384) {
        fclose(fp)
        _null(o)
        retp(o)
    }
    let f = lv_alloc(16)
    st64(f + FI_FP, fp)
    st32(f + FI_CLOSED, 0)
    _set(o, T_FILE, f)
    retp(o)
}

func lb_close(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let f = _arg_file(self_p, argv_p, 0)
    st32(f + FI_CLOSED, 1)
    if (fclose(ld64(f + FI_FP)) != 0) {
        _io_fail(self_p)
    }
    let o = stack_buf(16)
    _null(o)
    retp(o)
}

func lb_read(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let f = _arg_file(self_p, argv_p, 0)
    let b = stack_buf(B_SIZE)
    let o = stack_buf(16)
    let chunk = stack_buf(65536)
    let fp = ld64(f + FI_FP)
    _buf_init(b)
    # A regular file is read straight into a string of its size (a growing buffer used about 3.8 times the
    # size at its peak). If the file grew meanwhile, the rest is read the general way below.
    let st = stack_buf(144)
    let pos = ftell(fp)
    if (pos >= 0 and fstat(fileno(fp), st) == 0 and band(ld32(st + 24), 61440) == 32768 and ld64(st + 48) >= pos) {
        let want = ld64(st + 48) - pos
        let str = lv_alloc_atomic(S_DATA + want + 1)
        let got = fread(str + S_DATA, 1, want, fp)
        if (ferror(fp) != 0) {
            _io_fail(self_p)
        }
        let c = -1
        if (got == want) {
            c = fgetc(fp)
        }
        if (c < 0) {
            if (ferror(fp) != 0) {
                _io_fail(self_p)
            }
            st64(str, got)
            st8(str + S_DATA + got, 0)
            _set(o, T_STR, str)
            retp(o)
        }
        _buf_add(b, str + S_DATA, got)
        st8(chunk, c)
        _buf_add(b, chunk, 1)
    }
    let n = fread(chunk, 1, 65536, fp)
    while (n > 0) {
        _buf_add(b, chunk, n)
        n = fread(chunk, 1, 65536, ld64(f + FI_FP))
    }
    if (ferror(ld64(f + FI_FP)) != 0) {
        _io_fail(self_p)
    }
    _buf_done(o, b)
    retp(o)
}

func lb_read_line(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let f = _arg_file(self_p, argv_p, 0)
    let o = stack_buf(16)
    let cell = stack_buf(16)
    st64(cell, 0)
    st64(cell + 8, 0)
    let n = getline(cell, cell + 8, ld64(f + FI_FP))
    let line = ld64(cell)
    if (n < 0) {
        free(line)
        if (ferror(ld64(f + FI_FP)) != 0) {
            _io_fail(self_p)
        }
        _null(o)
        retp(o)
    }
    # The line ending goes: "\n", or "\r\n" from a file written on Windows.
    if (n > 0 and ld8(line + n - 1) == 10) {
        n -= 1
        if (n > 0 and ld8(line + n - 1) == 13) {
            n -= 1
        }
    }
    _str_n(o, line, n)
    free(line)
    retp(o)
}

func lb_write(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let f = _arg_file(self_p, argv_p, 0)
    let s = _arg_str(self_p, argv_p, 1)
    let w = fwrite(s + S_DATA, 1, ld64(s), ld64(f + FI_FP))
    if (w != ld64(s)) {
        _io_fail(self_p)
    }
    let o = stack_buf(16)
    _null(o)
    retp(o)
}

func lb_file_exists(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    _bool(o, access(_arg_path(self_p, argv_p, 0) + S_DATA, 0) == 0)
    retp(o)
}

func lb_remove_file(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    _bool(o, remove(_arg_path(self_p, argv_p, 0) + S_DATA) == 0)
    retp(o)
}

func lb_flush(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    if (fflush(ld64(_arg_file(self_p, argv_p, 0) + FI_FP)) != 0) {
        _io_fail(self_p)
    }
    let o = stack_buf(16)
    _null(o)
    retp(o)
}

# Dense lists and vector math

func lb_dense_list(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    _arg_int(self_p, argv_p, 0)
    if (_tag(argv_p + 16) != T_FLOAT) {
        _arg_fail(self_p, argv_p, 1, cstr("float"))
    }
    let n = _val(argv_p)
    if (n < 0) {
        lv_error(E_ARGUMENT, cstr("dense_list() size must not be negative"), cstr("Usage: dense_list(100, 1.5)"))
    }
    # 2^36 floats take 512 GiB; a list that size is refused here with the line, not as a bare "out of memory".
    if (n > 68719476736) {
        _errf(E_ARGUMENT, cstr("Use a smaller size."),
              cstr("dense_list() would make %lld items, too many to hold in memory"), n, 0, 0)
    }
    let o = stack_buf(16)
    _dense_new(o, n)
    let dat = ld64(_val(o) + D_DATA)
    for (let i = 0; i < n; i++) {
        dat[i] = _val(argv_p + 16)
    }
    retp(o)
}

func _vec_op(self_p, argc_i, argv_p, op, o) {
    lv_arity(self_p, argc_i, 2, 2)
    _list_arith(o, op, argv_p, argv_p + 16)
}

func lb_vec_add(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _vec_op(self_p, argc_i, argv_p, 0, o)
    retp(o)
}

func lb_vec_sub(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _vec_op(self_p, argc_i, argv_p, 1, o)
    retp(o)
}

func lb_vec_mul(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _vec_op(self_p, argc_i, argv_p, 2, o)
    retp(o)
}

func lb_vec_div(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _vec_op(self_p, argc_i, argv_p, 3, o)
    retp(o)
}

func lb_vec_mul_inline(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    if (_tag(argv_p) != T_DENSE) {
        _arg_fail(self_p, argv_p, 0, cstr("dense list"))
    }
    if (_tag(argv_p + 16) != T_DENSE) {
        _arg_fail(self_p, argv_p, 1, cstr("dense list"))
    }
    let a = _val(argv_p)
    let b = _val(argv_p + 16)
    let n = ld64(a + D_COUNT)
    if (ld64(b + D_COUNT) != n) {
        _errf4(E_ARGUMENT, cstr("Both lists need the same number of elements."),
               cstr("vec_mul_inline() lists have different lengths (%d and %d)"), n, ld64(b + D_COUNT), 0, 0)
    }
    let da = ld64(a + D_DATA)
    let db = ld64(b + D_DATA)
    for (let i = 0; i < n; i++) {
        let r = fmul(da[i], db[i])
        if (_is_finite(r) == 0) {
            _float_overflow(cstr("*"))
        }
        da[i] = r
    }
    let o = stack_buf(16)
    _null(o)
    retp(o)
}

func _row_len(r) {
    if (_tag(r) == T_LIST) {
        return ld64(_val(r) + L_COUNT)
    }
    if (_tag(r) == T_DENSE) {
        return ld64(_val(r) + D_COUNT)
    }
    return 0
}

func _row_at(r, j) {
    if (_tag(r) == T_DENSE) {
        return ld64(_val(r) + D_DATA)[j]
    }
    return _elem(ld64(_val(r) + L_ITEMS) + 16 * j)
}

# The column count of a matrix argument (a list of rows, or one dense row). Every row must be a list or a
# dense list of that many items, and at least one.
func _mat_cols(m, argn) {
    if (_tag(m) == T_DENSE) {
        if (ld64(_val(m) + D_COUNT) == 0) {
            _errf(E_ARGUMENT, cstr("A matrix needs at least one row and one column."),
                  cstr("mat_mul() dimension mismatch (argument %d has no columns)"), argn, 0, 0)
        }
        return ld64(_val(m) + D_COUNT)
    }
    let n = ld64(_val(m) + L_COUNT)
    let items = ld64(_val(m) + L_ITEMS)
    let cols = 0
    for (let i = 0; i < n; i++) {
        let row = items + 16 * i
        if (_is_listish(row) == 0) {
            _errf4(E_ARGUMENT, cstr("Each row of a matrix is a list or a dense list of numbers."),
                   cstr("mat_mul() dimension mismatch (argument %d: row %d has type %s, not list)"), argn, i + 1, _type_name(row), 0)
        }
        let len = _row_len(row)
        if (i == 0) {
            cols = len
            if (cols == 0) {
                _errf(E_ARGUMENT, cstr("A matrix needs at least one row and one column."),
                      cstr("mat_mul() dimension mismatch (argument %d has no columns)"), argn, 0, 0)
            }
        } else if (len != cols) {
            _errf4(E_ARGUMENT, cstr("Every row of a matrix has the same number of items."),
                   cstr("mat_mul() dimension mismatch (argument %d: row %d has length %d, row 1 has length %d)"), argn, i + 1, len, cols)
        }
    }
    return cols
}

# The one number type of a matrix: T_FLOAT for a dense row or rows of floats, T_INT for rows of ints. Items of
# other types, or ints with floats, are errors.
func _mat_kind(m, argn) {
    if (_tag(m) == T_DENSE) {
        return T_FLOAT
    }
    let kind = 0
    let rows = ld64(_val(m) + L_ITEMS)
    for (let i = 0; i < ld64(_val(m) + L_COUNT); i++) {
        let row = rows + 16 * i
        if (_tag(row) == T_DENSE) {
            kind = _mat_kind_join(kind, T_FLOAT, argn)
        } else {
            let items = ld64(_val(row) + L_ITEMS)
            for (let j = 0; j < ld64(_val(row) + L_COUNT); j++) {
                let t = _tag(items + 16 * j)
                if (t != T_INT and t != T_FLOAT) {
                    _errf4(E_TYPE, cstr("A matrix holds only numbers."),
                           cstr("mat_mul() argument %d: row %d holds a %s, not a number"), argn, i + 1, _type_name(items + 16 * j), 0)
                }
                kind = _mat_kind_join(kind, t, argn)
            }
        }
    }
    return kind
}

func _mat_kind_join(kind, t, argn) {
    if (kind != 0 and kind != t) {
        _errf(E_TYPE, cstr("Ints and floats do not mix: convert the items with float(x) or int(x)."),
              cstr("mat_mul() argument %d holds ints and floats"), argn, 0, 0)
    }
    return t
}

func _type_name_of_tag(t) {
    if (t == T_INT) {
        return cstr("ints")
    }
    return cstr("floats")
}

# The product of two int matrices as a list of int lists; an overflow in a product or a sum is an error.
func _mat_mul_int(o, a, b, rows_a, cols_a, cols_b) {
    let row = stack_buf(16)
    let cell = stack_buf(16)
    _list_new(o, rows_a)
    for (let i = 0; i < rows_a; i++) {
        let ai = ld64(_val(ld64(_val(a) + L_ITEMS) + 16 * i) + L_ITEMS)
        _list_new(row, cols_b)
        for (let j = 0; j < cols_b; j++) {
            let acc = 0
            for (let k = 0; k < cols_a; k++) {
                let bk = ld64(_val(ld64(_val(b) + L_ITEMS) + 16 * k) + L_ITEMS)
                let x = _val(ai + 16 * k)
                let y = _val(bk + 16 * j)
                if (mulof(x, y) != 0) {
                    _overflow(cstr("*"))
                }
                if (addof(acc, x * y) != 0) {
                    _overflow(cstr("+"))
                }
                acc = acc + x * y
            }
            _int(cell, acc)
            _list_push(row, cell)
        }
        _list_push(o, row)
    }
}

func lb_mat_mul(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let o = stack_buf(16)
    let a = argv_p
    let b = argv_p + 16
    if (_is_listish(a) == 0) {
        _arg_fail(self_p, argv_p, 0, cstr("list of rows"))
    }
    if (_is_listish(b) == 0) {
        _arg_fail(self_p, argv_p, 1, cstr("list of rows"))
    }
    let rows_a = 1
    let rows_b = 1
    if (_tag(a) == T_LIST) {
        rows_a = ld64(_val(a) + L_COUNT)
    }
    if (_tag(b) == T_LIST) {
        rows_b = ld64(_val(b) + L_COUNT)
    }
    if (rows_a == 0 or rows_b == 0) {
        _errf(E_ARGUMENT, cstr("A matrix needs at least one row and one column."),
              cstr("mat_mul() dimension mismatch (argument %d has no rows)"), 1 + (rows_a != 0), 0, 0)
    }
    let cols_a = _mat_cols(a, 1)
    let cols_b = _mat_cols(b, 2)
    if (cols_a != rows_b) {
        _errf(E_ARGUMENT, cstr("The first matrix needs as many columns as the second has rows."),
              cstr("mat_mul() dimension mismatch (%d columns vs %d rows)"), cols_a, rows_b, 0)
    }
    let ka = _mat_kind(a, 1)
    let kb = _mat_kind(b, 2)
    if (ka != kb) {
        _errf(E_TYPE, cstr("Ints and floats do not mix: convert one matrix with float(x) or int(x)."),
              cstr("mat_mul() matrices must both hold ints or both hold floats, got %s and %s"), _type_name_of_tag(ka), _type_name_of_tag(kb), 0)
    }
    if (ka == T_INT) {
        _mat_mul_int(o, a, b, rows_a, cols_a, cols_b)
        retp(o)
    }
    let fa = lv_alloc(8 * rows_a * cols_a)
    let fb = lv_alloc(8 * rows_b * cols_b)
    let fc = calloc(rows_a * cols_b, 8)
    if (fc == 0) {
        lv_error(E_RUNTIME, cstr("out of memory"), cstr("The system could not give the program more memory. Free values you no longer need, or work on smaller data."))
    }
    for (let i = 0; i < rows_a; i++) {
        let row = a
        if (_tag(a) == T_LIST) {
            row = ld64(_val(a) + L_ITEMS) + 16 * i
        }
        for (let j = 0; j < cols_a; j++) {
            fa[i * cols_a + j] = _row_at(row, j)
        }
    }
    for (let i = 0; i < rows_b; i++) {
        let row = b
        if (_tag(b) == T_LIST) {
            row = ld64(_val(b) + L_ITEMS) + 16 * i
        }
        for (let j = 0; j < cols_b; j++) {
            fb[i * cols_b + j] = _row_at(row, j)
        }
    }
    for (let i = 0; i < rows_a; i++) {
        for (let k = 0; k < cols_a; k++) {
            let av = fa[i * cols_a + k]
            for (let j = 0; j < cols_b; j++) {
                let prod = fmul(av, fb[k * cols_b + j])
                if (_is_finite(prod) == 0) {
                    _float_overflow(cstr("*"))
                }
                let r = fadd(fc[i * cols_b + j], prod)
                if (_is_finite(r) == 0) {
                    _float_overflow(cstr("+"))
                }
                fc[i * cols_b + j] = r
            }
        }
    }
    let res = stack_buf(16)
    let row_lv = stack_buf(16)
    _list_new(res, rows_a)
    for (let i = 0; i < rows_a; i++) {
        _dense_new(row_lv, cols_b)
        let rd = ld64(_val(row_lv) + D_DATA)
        for (let j = 0; j < cols_b; j++) {
            rd[j] = fc[i * cols_b + j]
        }
        _list_push(res, row_lv)
    }
    free(fc)
    retp(res)
}

# Random numbers

# xoroshiro128++, seeded and scrambled exactly as in src/math_lib.c.
space("_rng", 16)

func _rotl(x, k) {
    return bor(shl(x, k), shr(x, 64 - k))
}

func _rng_next() {
    let s = addr_of("_rng")
    let s0 = s[0]
    let s1 = s[1]
    let result = _rotl(s0 + s1, 17) + s0
    s1 = bxor(s1, s0)
    s[0] = bxor(bxor(_rotl(s0, 49), s1), shl(s1, 21))
    s[1] = _rotl(s1, 28)
    return result
}

# Fills n bytes from the kernel's entropy source. Failing is an error: a clock value is not entropy.
func _os_fill(buf, n) {
    let off = 0
    while (off < n) {
        let r = getrandom(buf + off, n - off, 0)
        if (r < 0) {
            let e = ld32(__errno_location())
            if (e != 4) {
                _errf(E_RUNTIME, cstr("The operating system could not supply random bytes."),
                      cstr("cannot read system entropy: %s"), strerror(e), 0, 0)
            }
        } else {
            off += r
        }
    }
}

func _os_entropy() {
    let val = stack_buf(8)
    _os_fill(val, 8)
    return ld64(val)
}

# A uniform value from 0 to range - 1 (range is not 0). Values below 2^64 mod range are thrown
# away, so every result is equally likely.
func _rng_below(range) {
    let thr = urem(0 - range, range)
    let x = _rng_next()
    while (ult(x, thr)) {
        x = _rng_next()
    }
    return urem(x, range)
}

func _os_below(range) {
    let thr = urem(0 - range, range)
    let x = _os_entropy()
    while (ult(x, thr)) {
        x = _os_entropy()
    }
    return urem(x, range)
}

# A buffered entropy stream for loops that need many words: word 0 is the next unread word,
# words 1 to 256 hold the bytes. One kernel call serves 256 draws.
func _ent_init(ctl) {
    ctl[0] = 256
}

func _ent_word(ctl) {
    if (ctl[0] >= 256) {
        _os_fill(ctl + 8, 2048)
        ctl[0] = 0
    }
    let w = ctl[ctl[0] + 1]
    ctl[0] = ctl[0] + 1
    return w
}

func _ent_below(ctl, range) {
    let thr = urem(0 - range, range)
    let x = _ent_word(ctl)
    while (ult(x, thr)) {
        x = _ent_word(ctl)
    }
    return urem(x, range)
}

func _splitmix(z0) {
    let z = z0 + -7046029254386353131
    z = bxor(z, shr(z, 30)) * -4658895280553007687
    z = bxor(z, shr(z, 27)) * -7723592293110705685
    return bxor(z, shr(z, 31))
}

func _seed(seed) {
    let s = addr_of("_rng")
    s[0] = _splitmix(seed)
    s[1] = _splitmix(s[0])
}

func _srand_default() {
    _seed(_os_entropy())
}

func lb_trand(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 0, 2)
    let o = stack_buf(16)
    if (argc_i == 0) {
        _int(o, _os_entropy())
        retp(o)
    }
    let bounds = stack_buf(16)
    _int_bounds(self_p, argc_i, argv_p, bounds)
    if (bounds[1] == 0) {
        _int(o, _os_entropy())
        retp(o)
    }
    _int(o, bounds[0] + _os_below(bounds[1]))
    retp(o)
}

func lb_srand(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 0, 1)
    if (argc_i == 0) {
        _seed(_os_entropy())
    } else {
        _seed(_arg_int(self_p, argv_p, 0))
    }
    let o = stack_buf(16)
    _null(o)
    retp(o)
}

# The bounds of f(max) and f(min, max), both ends included and swapped if reversed:
# out[0] is the low end, out[1] the number of values (0 stands for all 2^64 of them).
func _int_bounds(self_p, argc_i, argv_p, out) {
    let lo = 0
    let hi = 0
    if (argc_i == 1) {
        hi = _arg_int(self_p, argv_p, 0)
    } else {
        lo = _arg_int(self_p, argv_p, 0)
        hi = _arg_int(self_p, argv_p, 1)
    }
    if (lo > hi) {
        let t = lo
        lo = hi
        hi = t
    }
    out[0] = lo
    out[1] = hi - lo + 1
}

func lb_rand(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 0, 2)
    let o = stack_buf(16)
    if (argc_i == 0) {
        let r = _rng_next()
        _flt(o, fmul(i2f(shr(r, 11)), fdiv(1.0, 9007199254740992.0)))
        retp(o)
    }
    let bounds = stack_buf(16)
    _int_bounds(self_p, argc_i, argv_p, bounds)
    if (bounds[1] == 0) {
        # The range covers every 64-bit value.
        _int(o, _rng_next())
        retp(o)
    }
    _int(o, bounds[0] + _rng_below(bounds[1]))
    retp(o)
}

# Fisher-Yates. ctl is 0 to draw from the seeded generator, or an entropy stream.
func _shuffle_items(items, n, ctl) {
    let t = stack_buf(16)
    let i = n - 1
    while (i > 0) {
        let j = 0
        if (ctl == 0) {
            j = _rng_below(i + 1)
        } else {
            j = _ent_below(ctl, i + 1)
        }
        _cp(t, items + 16 * i)
        _cp(items + 16 * i, items + 16 * j)
        _cp(items + 16 * j, t)
        i -= 1
    }
}

func lb_shuffle(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let l = _arg_list(self_p, argv_p, 0)
    _shuffle_items(ld64(l + L_ITEMS), ld64(l + L_COUNT), 0)
    let o = stack_buf(16)
    _null(o)
    retp(o)
}

func lb_tshuffle(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let l = _arg_list(self_p, argv_p, 0)
    let ctl = stack_buf(2064)
    _ent_init(ctl)
    _shuffle_items(ld64(l + L_ITEMS), ld64(l + L_COUNT), ctl)
    let o = stack_buf(16)
    _null(o)
    retp(o)
}

# Stalin sort: drops every element smaller than the last one kept.
func lb_ssort(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    if (_tag(argv_p) != T_LIST and _tag(argv_p) != T_DENSE) {
        _arg_fail(self_p, argv_p, 0, cstr("list"))
    }
    let o = stack_buf(16)
    _null(o)
    if (_tag(argv_p) == T_LIST) {
        let l = _val(argv_p)
        if (ld64(l + L_COUNT) <= 1) {
            retp(o)
        }
        let items = ld64(l + L_ITEMS)
        let w = 1
        let last = stack_buf(16)
        _cp(last, items)
        for (let r = 1; r < ld64(l + L_COUNT); r++) {
            let cur = items + 16 * r
            if (_sort_cmp(cur, last) >= 0) {
                _cp(items + 16 * w, cur)
                w++
                _cp(last, cur)
            }
        }
        # slots past the new end would keep the removed values alive
        for (let k = w; k < ld64(l + L_COUNT); k++) {
            _null(items + 16 * k)
        }
        st64(l + L_COUNT, w)
    } else {
        let d = _val(argv_p)
        if (ld64(d + D_COUNT) <= 1) {
            retp(o)
        }
        let dat = ld64(d + D_DATA)
        let w = 1
        let last = dat[0]
        for (let r = 1; r < ld64(d + D_COUNT); r++) {
            if (fge(dat[r], last)) {
                dat[w] = dat[r]
                w++
                last = dat[r]
            }
        }
        st64(d + D_COUNT, w)
    }
    retp(o)
}

# Greatest common divisor of two ints by Euclid's algorithm. The result may be negative; a divisor
# of -1 is handled apart because INT_MIN % -1 traps.
func _gcd_int(x, y) {
    let a = x
    let b = y
    while (b != 0) {
        if (b == -1) {
            a = 1
            b = 0
        } else {
            let t = a % b
            a = b
            b = t
        }
    }
    return a
}

func _int_pair(self_p, argv_p) {
    for (let i = 0; i < 2; i++) {
        if (_tag(argv_p + 16 * i) != T_INT) {
            _errf(E_TYPE, cstr("Whole numbers only; a float never becomes an int by itself, so use int(x), floor(x) or round(x)"), cstr("%s() argument %d must be an int, got %s"), _fname(self_p), i + 1,
                  _type_name(argv_p + 16 * i))
        }
    }
}

func lb_gcd(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    _int_pair(self_p, argv_p)
    let g = _gcd_int(_val(argv_p), _val(argv_p + 16))
    if (g == -9223372036854775807 - 1) {
        _overflow(cstr("gcd"))
    }
    let o = stack_buf(16)
    if (g < 0) {
        g = 0 - g
    }
    _int(o, g)
    retp(o)
}

func lb_lcm(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    _int_pair(self_p, argv_p)
    let x = _val(argv_p)
    let y = _val(argv_p + 16)
    let o = stack_buf(16)
    if (x == 0 or y == 0) {
        _int(o, 0)
        retp(o)
    }
    let g = _gcd_int(x, y)
    if (g == -9223372036854775807 - 1) {
        _overflow(cstr("lcm"))
    }
    if (g < 0) {
        g = 0 - g
    }
    let q = x / g
    if (mulof(q, y) != 0) {
        _overflow(cstr("lcm"))
    }
    let r = q * y
    if (r == -9223372036854775807 - 1) {
        _overflow(cstr("lcm"))
    }
    if (r < 0) {
        r = 0 - r
    }
    _int(o, r)
    retp(o)
}

# The largest r with r * r <= n: the float square root is within one of it, then corrected exactly.
func lb_isqrt(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    if (_tag(argv_p) != T_INT) {
        _errf(E_TYPE, cstr("isqrt works on whole numbers; for a float use sqrt(x) or convert with int(x)"), cstr("isqrt() argument must be an int, got %s"), _type_name(argv_p), 0, 0)
    }
    let n = _val(argv_p)
    if (n < 0) {
        _errf(E_ARGUMENT, cstr("Check the value before taking the square root."),
              cstr("isqrt() argument must not be negative"), 0, 0, 0)
    }
    let r = f2i(sqrt(i2f(n)))
    while (mulof(r, r) != 0 or r * r > n) {
        r = r - 1
    }
    while (mulof(r + 1, r + 1) == 0 and (r + 1) * (r + 1) <= n) {
        r = r + 1
    }
    let o = stack_buf(16)
    _int(o, r)
    retp(o)
}
