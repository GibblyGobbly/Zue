# Math

func lb_abs(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    if (_tag(argv_p) == T_INT) {
        let i = _val(argv_p)
        if (i == -9223372036854775807 - 1) {
            _overflow(cstr("abs"))
        }
        if (i < 0) {
            _int(o, 0 - i)
        } else {
            _int(o, i)
        }
        retp(o)
    }
    _flt(o, fabs(_arg_num(self_p, argv_p, 0)))
    retp(o)
}

# The list argument of sum, mean, min and max: not empty, every item a number, all of one type.
# Returns the item count.
func _number_list(self_p, argv_p) {
    let t = _tag(argv_p)
    if (t != T_LIST and t != T_DENSE) {
        _errf(E_TYPE, cstr("Pass a list such as [1, 2, 3]"), cstr("%s() needs a list of numbers, got %s"), _fname(self_p), _type_name(argv_p), 0)
    }
    let n = lvp_iter_len(argv_p)
    if (n == 0) {
        _errf(E_ARGUMENT, cstr("Check that the list has items before calling it."),
              cstr("%s() needs a list with at least one item"), _fname(self_p), 0, 0)
    }
    let first = stack_buf(16)
    let item = stack_buf(16)
    lvp_iter_at(first, argv_p, 0)
    for (let i = 0; i < n; i++) {
        lvp_iter_at(item, argv_p, i)
        if (_is_num(item) == 0) {
            _errf(E_TYPE, cstr("Every item must be an int or a float; convert text with to_int() or to_float()"), cstr("%s() list items must be numbers, got %s"), _fname(self_p), _type_name(item), 0)
        }
        if (_tag(item) != _tag(first)) {
            _errf(E_TYPE, cstr("Convert the items with int() or float() so that all have the same type."),
                  cstr("%s() list items must all be int or all be float, got %s and %s"),
                  _fname(self_p), _type_name(first), _type_name(item))
        }
    }
    return n
}

# min and max of a list: which is -1 for the smallest item, 1 for the largest.
func _list_extreme(argv_p, n, which, o) {
    let item = stack_buf(16)
    lvp_iter_at(o, argv_p, 0)
    for (let i = 1; i < n; i++) {
        lvp_iter_at(item, argv_p, i)
        if (_sort_cmp(item, o) * which > 0) {
            _cp(o, item)
        }
    }
}

func lb_min(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 2)
    let o = stack_buf(16)
    if (argc_i == 1) {
        _list_extreme(argv_p, _number_list(self_p, argv_p), -1, o)
        retp(o)
    }
    _same_number_type(self_p, argv_p)
    if (_sort_cmp(argv_p + 16, argv_p) < 0) {
        _cp(o, argv_p + 16)
    } else {
        _cp(o, argv_p)
    }
    retp(o)
}

func lb_max(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 2)
    let o = stack_buf(16)
    if (argc_i == 1) {
        _list_extreme(argv_p, _number_list(self_p, argv_p), 1, o)
        retp(o)
    }
    _same_number_type(self_p, argv_p)
    if (_sort_cmp(argv_p + 16, argv_p) > 0) {
        _cp(o, argv_p + 16)
    } else {
        _cp(o, argv_p)
    }
    retp(o)
}

# Neumaier's compensated sum of the list items as floats, each multiplied by scale: the rounding error of
# every addition is collected in a second variable and added at the end.
func _float_list_sum(argv_p, n, scale) {
    let item = stack_buf(16)
    let s = 0.0
    let c = 0.0
    for (let i = 0; i < n; i++) {
        lvp_iter_at(item, argv_p, i)
        let x = fmul(_num(item), scale)
        let t = fadd(s, x)
        if (fge(fabs(s), fabs(x))) {
            c = fadd(c, fadd(fsub(s, t), x))
        } else {
            c = fadd(c, fadd(fsub(x, t), s))
        }
        s = t
    }
    return fadd(s, c)
}

func lb_sum(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let n = _number_list(self_p, argv_p)
    let o = stack_buf(16)
    let item = stack_buf(16)
    lvp_iter_at(item, argv_p, 0)
    if (_tag(item) == T_INT) {
        let total = 0
        for (let i = 0; i < n; i++) {
            lvp_iter_at(item, argv_p, i)
            if (addof(total, _val(item)) != 0) {
                _overflow(cstr("sum"))
            }
            total = total + _val(item)
        }
        _int(o, total)
        retp(o)
    }
    let r = _float_list_sum(argv_p, n, 1.0)
    if (_is_finite(r) == 0) {
        # A partial sum overflowed (sum([1e308, 1e308, -1e308])). With every item scaled by 2^-64 no partial sum
        # of fewer than 2^63 items can; scaling back by 2^64 is exact unless the sum itself is too large.
        r = fmul(_float_list_sum(argv_p, n, 0.0000000000000000000542101086242752217003726400434970855712890625), 18446744073709551616.0)
    }
    _flt_checked(o, r, cstr("sum"))
    retp(o)
}

func lb_mean(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let n = _number_list(self_p, argv_p)
    let o = stack_buf(16)
    let r = fdiv(_float_list_sum(argv_p, n, 1.0), i2f(n))
    if (_is_finite(r) == 0) {
        r = fmul(fdiv(_float_list_sum(argv_p, n, 0.0000000000000000000542101086242752217003726400434970855712890625), i2f(n)), 18446744073709551616.0)
    }
    _flt_checked(o, r, cstr("mean"))
    retp(o)
}

func lb_clamp(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 3, 3)
    _arg_num(self_p, argv_p, 0)
    _arg_num(self_p, argv_p, 1)
    _arg_num(self_p, argv_p, 2)
    if (_tag(argv_p) != _tag(argv_p + 16) or _tag(argv_p) != _tag(argv_p + 32)) {
        _errf(E_TYPE, cstr("Convert the arguments with int() or float() so that all have the same type."),
              cstr("clamp() arguments must all be int or all be float, got %s, %s and %s"),
              _type_name(argv_p), _type_name(argv_p + 16), _type_name(argv_p + 32))
    }
    if (_sort_cmp(argv_p + 16, argv_p + 32) > 0) {
        lv_error(E_ARGUMENT, cstr("clamp() lower bound is greater than the upper bound"),
                 cstr("Write clamp(value, low, high) with low <= high."))
    }
    let o = stack_buf(16)
    if (_sort_cmp(argv_p, argv_p + 16) < 0) {
        _cp(o, argv_p + 16)
    } else if (_sort_cmp(argv_p, argv_p + 32) > 0) {
        _cp(o, argv_p + 32)
    } else {
        _cp(o, argv_p)
    }
    retp(o)
}

func lb_sign(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let x = _arg_num(self_p, argv_p, 0)
    let o = stack_buf(16)
    _int(o, fgt(x, 0.0) - flt(x, 0.0))
    retp(o)
}

# glibc returns 3.0000000000000004 for cbrt(27); make exact cubes exact.
func _cbrt(x) {
    let r = cbrt(x)
    let n = round(r)
    if (feq(fmul(fmul(n, n), n), x)) {
        return n
    }
    return r
}

func _domain(self_p, what) {
    _errf(E_ARGUMENT, cstr("Check the argument before calling."),
          cstr("%s() %s"), _fname(self_p), what, 0)
}

func _math_overflow(self_p) {
    _errf(E_RUNTIME, cstr("Zue has no infinity: the result must fit in a 64-bit float."),
          cstr("float overflow in %s()"), _fname(self_p), 0, 0)
}

# One-argument math: which picks the function.
func _math1(self_p, argc_i, argv_p, which, o) {
    lv_arity(self_p, argc_i, 1, 1)
    let x = _arg_flt(self_p, argv_p, 0)
    let r = 0
    if (which == 0 and flt(x, 0.0)) {
        _domain(self_p, cstr("argument must not be negative"))
    }
    if ((which == 3 or which == 4) and fle(x, 0.0)) {
        _domain(self_p, cstr("argument must be greater than 0"))
    }
    if ((which == 8 or which == 9) and (flt(x, -1.0) or fgt(x, 1.0))) {
        _domain(self_p, cstr("argument must be between -1 and 1"))
    }
    if (which == 0) {
        r = sqrt(x)
    } else if (which == 1) {
        r = _cbrt(x)
    } else if (which == 2) {
        r = exp(x)
    } else if (which == 3) {
        r = log(x)
    } else if (which == 4) {
        r = log10(x)
    } else if (which == 5) {
        r = sin(x)
    } else if (which == 6) {
        r = cos(x)
    } else if (which == 7) {
        r = tan(x)
    } else if (which == 8) {
        r = asin(x)
    } else if (which == 9) {
        r = acos(x)
    } else if (which == 10) {
        r = atan(x)
    } else if (which == 11) {
        r = sinh(x)
    } else if (which == 12) {
        r = cosh(x)
    } else if (which == 13) {
        r = tanh(x)
    } else if (which == 14) {
        r = fsub(x, trunc(x))
    } else if (which == 15) {
        r = fdiv(fmul(x, 3.14159265358979323846), 180.0)
        if (_is_finite(r) == 0) {
            r = fmul(fdiv(x, 180.0), 3.14159265358979323846)    # x * pi overflowed although the result fits
        }
    } else {
        r = fdiv(fmul(x, 180.0), 3.14159265358979323846)
        if (_is_finite(r) == 0) {
            r = fmul(fdiv(x, 3.14159265358979323846), 180.0)
        }
    }
    if (_is_finite(r) == 0) {
        _math_overflow(self_p)
    }
    _flt(o, r)
}

func lb_sqrt(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _math1(self_p, argc_i, argv_p, 0, o)
    retp(o)
}

