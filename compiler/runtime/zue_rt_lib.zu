func lb_map_items(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let m = _val(_arg_map(self_p, argv_p, 0))
    let o = stack_buf(16)
    let pair = stack_buf(32)
    let item = stack_buf(16)
    _list_new(o, ld64(m + M_COUNT))
    for (let i = 0; i < ld64(m + M_USED); i++) {
        let e = ld64(m + M_ENTRIES) + i * E_SIZE
        if (ld32(e + E_LIVE) == 0) {
            continue
        }
        _set(pair, T_STR, ld64(e + E_KEY))
        _cp(pair + 16, e + E_VAL)
        _list_of(item, 2, pair)
        _list_push(o, item)
    }
    retp(o)
}

# Lists

func lb_remove(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let l = _arg_list(self_p, argv_p, 0)
    let i = _arg_int(self_p, argv_p, 1)
    let orig = i
    let count = ld64(l + L_COUNT)
    if (i < 0) {
        i += count
    }
    if (i < 0 or i >= count) {
        _oob(orig, count, cstr("list"))
    }
    let items = ld64(l + L_ITEMS)
    let o = stack_buf(16)
    _cp(o, items + 16 * i)
    memmove(items + 16 * i, items + 16 * (i + 1), 16 * (count - i - 1))
    st64(l + L_COUNT, count - 1)
    retp(o)
}

func lb_find(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let l = _arg_list(self_p, argv_p, 0)
    let o = stack_buf(16)
    for (let i = 0; i < ld64(l + L_COUNT); i++) {
        if (lvp_equal(ld64(l + L_ITEMS) + 16 * i, argv_p + 16) != 0) {
            _int(o, i)
            retp(o)
        }
    }
    _int(o, -1)
    retp(o)
}

func lb_slice(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 3, 3)
    _arg_int(self_p, argv_p, 1)
    _arg_int(self_p, argv_p, 2)
    if (_tag(argv_p) != T_LIST) {
        _arg_str(self_p, argv_p, 0)
    }
    let o = stack_buf(16)
    lvp_slice(o, argv_p, argv_p + 16, argv_p + 32)
    retp(o)
}

func _sort_cmp(a, b) {
    if (_tag(a) == T_INT and _tag(b) == T_INT) {
        return (_val(a) > _val(b)) - (_val(a) < _val(b))
    }
    if (_is_num(a) and _is_num(b)) {
        let x = _num(a)
        let y = _num(b)
        return fgt(x, y) - flt(x, y)
    }
    return _order(a, b)
}

func _merge_sort(items, tmp, n) {
    if (n < 2) {
        return 0
    }
    if (n <= 16) {
        let x = stack_buf(16)
        for (let i = 1; i < n; i++) {
            _cp(x, items + 16 * i)
            let j = i - 1
            while (j >= 0 and _sort_cmp(items + 16 * j, x) > 0) {
                _cp(items + 16 * (j + 1), items + 16 * j)
                j -= 1
            }
            _cp(items + 16 * (j + 1), x)
        }
        return 0
    }
    let h = n / 2
    _merge_sort(items, tmp, h)
    _merge_sort(items + 16 * h, tmp, n - h)
    let i = 0
    let j = h
    let k = 0
    while (i < h and j < n) {
        if (_sort_cmp(items + 16 * j, items + 16 * i) < 0) {
            _cp(tmp + 16 * k, items + 16 * j)
            j++
        } else {
            _cp(tmp + 16 * k, items + 16 * i)
            i++
        }
        k++
    }
    while (i < h) {
        _cp(tmp + 16 * k, items + 16 * i)
        i++
        k++
    }
    while (j < n) {
        _cp(tmp + 16 * k, items + 16 * j)
        j++
        k++
    }
    memcpy(items, tmp, 16 * n)
}

const RADIX_MIN = 256

# Sorts a list of non-negative ints with an LSD radix sort on 8-bit digits: one counting pass per
# byte the largest value needs, and no comparisons. Returns 0 with the list untouched when any
# item is not such an int.
func _radix_sort(items, n) {
    let mx = 0
    for (let i = 0; i < n; i++) {
        let it = items + 16 * i
        if (_tag(it) != T_INT) {
            return 0
        }
        let v = _val(it)
        if (v < 0) {
            return 0
        }
        if (v > mx) {
            mx = v
        }
    }
    let passes = 0
    let rest = mx
    while (rest != 0) {
        passes++
        rest = shr(rest, 8)
    }
    if (passes == 0) {
        return 1
    }
    let a = lv_alloc_atomic(16 * n)
    let b = a + 8 * n
    let cnt = stack_buf(16384)
    memset(cnt, 0, 16384)
    for (let i = 0; i < n; i++) {
        let v = _val(items + 16 * i)
        a[i] = v
        for (let p = 0; p < passes; p++) {
            let k = p * 256 + band(shr(v, 8 * p), 255)
            cnt[k] = cnt[k] + 1
        }
    }
    for (let p = 0; p < passes; p++) {
        let c = cnt + 2048 * p
        # A pass where every item has the same digit would change nothing.
        if (c[band(shr(a[0], 8 * p), 255)] != n) {
            let pos = 0
            for (let d = 0; d < 256; d++) {
                let k = c[d]
                c[d] = pos
                pos += k
            }
            for (let i = 0; i < n; i++) {
                let v = a[i]
                let d = band(shr(v, 8 * p), 255)
                b[c[d]] = v
                c[d] = c[d] + 1
            }
            let t = a
            a = b
            b = t
        }
    }
    for (let i = 0; i < n; i++) {
        st64(items + 16 * i + 8, a[i])
    }
    return 1
}

func lb_sort(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let l = _arg_list(self_p, argv_p, 0)
    let n = ld64(l + L_COUNT)
    let o = stack_buf(16)
    _null(o)
    if (n >= RADIX_MIN and _radix_sort(ld64(l + L_ITEMS), n) != 0) {
        retp(o)
    }
    let tmp = lv_alloc(16 * (n + 1))
    _merge_sort(ld64(l + L_ITEMS), tmp, n)
    retp(o)
}

func lb_map(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let l = _arg_list(self_p, argv_p, 0)
    let o = stack_buf(16)
    let a = stack_buf(16)
    let r = stack_buf(16)
    _list_new(o, ld64(l + L_COUNT))
    for (let i = 0; i < ld64(l + L_COUNT); i++) {
        _cp(a, ld64(l + L_ITEMS) + 16 * i)
        lvp_call(r, argv_p + 16, 1, a)
        _list_push(o, r)
    }
    retp(o)
}

func lb_filter(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let l = _arg_list(self_p, argv_p, 0)
    let o = stack_buf(16)
    let a = stack_buf(16)
    let r = stack_buf(16)
    _list_new(o, ld64(l + L_COUNT))
    for (let i = 0; i < ld64(l + L_COUNT); i++) {
        _cp(a, ld64(l + L_ITEMS) + 16 * i)
        lvp_call(r, argv_p + 16, 1, a)
        if (lvp_truth(r) != 0) {
            _list_push(o, a)
        }
    }
    retp(o)
}

func lb_reduce(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 3, 3)
    let l = _arg_list(self_p, argv_p, 0)
    let acc = stack_buf(16)
    let pair = stack_buf(32)
    _cp(acc, argv_p + 32)
    for (let i = 0; i < ld64(l + L_COUNT); i++) {
        _cp(pair, acc)
        _cp(pair + 16, ld64(l + L_ITEMS) + 16 * i)
        lvp_call(acc, argv_p + 16, 2, pair)
    }
    retp(acc)
}

# Strings

func lb_is_empty(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    _bool(o, ld64(_arg_str(self_p, argv_p, 0)) == 0)
    retp(o)
}

func lb_concat(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let a = stack_buf(16)
    let b = stack_buf(16)
    let o = stack_buf(16)
    _text_str(self_p, argv_p, 0, a)
    _text_str(self_p, argv_p + 16, 1, b)
    if (_tag(argv_p) == T_STR) {
        _cp(a, argv_p)
    }
    if (_tag(argv_p + 16) == T_STR) {
        _cp(b, argv_p + 16)
    }
    lvp_add(o, a, b)
    retp(o)
}

func lb_substring(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 3, 3)
    let s = _arg_str(self_p, argv_p, 0)
    let start = _arg_int(self_p, argv_p, 1)
    let n = _arg_int(self_p, argv_p, 2)
    let o = stack_buf(16)
    if (start < 0) {
        start = 0
    }
    if (start >= ld64(s)) {
        _str(o, cstr(""))
        retp(o)
    }
    if (n < 0) {
        n = 0
    }
    if (start + n > ld64(s)) {
        n = ld64(s) - start
    }
    _str_n(o, s + S_DATA + start, n)
    retp(o)
}

func lb_char_at(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let s = _arg_str(self_p, argv_p, 0)
    let i = _arg_int(self_p, argv_p, 1)
    let o = stack_buf(16)
    if (i < 0 or i >= ld64(s)) {
        _str(o, cstr(""))
    } else {
        _str_n(o, s + S_DATA + i, 1)
    }
    retp(o)
}

# Index of sub in s at or after from, or -1.
func _find_sub(s, sub, frm) {
    let n = ld64(s)
    let m = ld64(sub)
    if (m == 0) {
        if (frm <= n) {
            return frm
        }
        return -1
    }
    if (frm + m > n) {
        return -1
    }
    let p = memmem(s + S_DATA + frm, n - frm, sub + S_DATA, m)
    if (p == 0) {
        return -1
    }
    return p - (s + S_DATA)
}

# The optional start position argument i: 0 when it is not given, otherwise an int from 0 to n.
func _start_arg(self_p, argc_i, argv_p, i, n) {
    if (argc_i <= i) {
        return 0
    }
    let frm = _arg_int(self_p, argv_p, i)
    if (frm < 0 or frm > n) {
        _errf4(E_INDEX, cstr("Ensure the start is between 0 and len(s)"),
               cstr("%s() start %lld is out of bounds for a string of length %lld"), _fname(self_p), frm, n, 0)
    }
    return frm
}

func lb_index_of(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 3)
    let tmp = stack_buf(16)
    let s = _arg_str(self_p, argv_p, 0)
    let sub = _text_str(self_p, argv_p + 16, 1, tmp)
    let frm = _start_arg(self_p, argc_i, argv_p, 2, ld64(s))
    let o = stack_buf(16)
    _int(o, _find_sub(s, sub, frm))
    retp(o)
}

# Tables of recently used set strings for index_of_any and skip_chars: 8 entries chosen by the
# string's address, each the address (kept alive by the root range, so it cannot be reused) and a
# 256-byte table with 1 at every byte of the set. The lexer asks for the same few sets over and over.
let g_set_cache = 0

func _fill_table(tbl, set) {
    memset(tbl, 0, 256)
    for (let k = 0; k < ld64(set); k++) {
        st8(tbl + ld8(set + S_DATA + k), 1)
    }
}

# A table for the set in argument 1 (a string or a char). scratch is 256 bytes for the char case.
func _set_table(self_p, argv_p, scratch) {
    if (_tag(argv_p + 16) == T_STR) {
        let set = _val(argv_p + 16)
        if (g_set_cache == 0) {
            g_set_cache = calloc(8, 272)
            lv_gc_root_add(g_set_cache, g_set_cache + 2176)
        }
        let e = g_set_cache + 272 * band(shr(set, 4), 7)
        if (ld64(e) != set) {
            _fill_table(e + 8, set)
            st64(e, set)
        }
        return e + 8
    }
    let tmp = stack_buf(16)
    _fill_table(scratch, _text_str(self_p, argv_p + 16, 1, tmp))
    return scratch
}

# index_of_any(s, set, start): the first index at or after start whose byte is in set, or -1.
func lb_index_of_any(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 3)
    let s = _arg_str(self_p, argv_p, 0)
    let tbl = _set_table(self_p, argv_p, stack_buf(256))
    let i = _start_arg(self_p, argc_i, argv_p, 2, ld64(s))
    let n = ld64(s)
    let o = stack_buf(16)
    _int(o, -1)
    while (i < n) {
        if (ld8(tbl + ld8(s + S_DATA + i)) != 0) {
            _int(o, i)
            break
        }
        i += 1
    }
    retp(o)
}

# skip_chars(s, set, start): the first index at or after start whose byte is not in set, or len(s).
func lb_skip_chars(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 3)
    let s = _arg_str(self_p, argv_p, 0)
    let tbl = _set_table(self_p, argv_p, stack_buf(256))
    let i = _start_arg(self_p, argc_i, argv_p, 2, ld64(s))
    let n = ld64(s)
    while (i < n and ld8(tbl + ld8(s + S_DATA + i)) != 0) {
        i += 1
    }
    let o = stack_buf(16)
    _int(o, i)
    retp(o)
}

func lb_last_index_of(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let tmp = stack_buf(16)
    let s = _arg_str(self_p, argv_p, 0)
    let t = _text_str(self_p, argv_p + 16, 1, tmp)
    let o = stack_buf(16)
    let i = ld64(s) - ld64(t)
    while (i >= 0) {
        if (memcmp(s + S_DATA + i, t + S_DATA, ld64(t)) == 0) {
            _int(o, i)
            retp(o)
        }
        i -= 1
    }
    _int(o, -1)
    retp(o)
}

func lb_contains(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let o = stack_buf(16)
    if (_tag(argv_p) == T_LIST) {
        let l = _val(argv_p)
        for (let i = 0; i < ld64(l + L_COUNT); i++) {
            if (lvp_equal(ld64(l + L_ITEMS) + 16 * i, argv_p + 16) != 0) {
                _bool(o, 1)
                retp(o)
            }
        }
        _bool(o, 0)
        retp(o)
    }
    let tmp = stack_buf(16)
    let s = _arg_str(self_p, argv_p, 0)
    let sub = _text_str(self_p, argv_p + 16, 1, tmp)
    _bool(o, _find_sub(s, sub, 0) >= 0)
    retp(o)
}

func lb_starts_with(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let tmp = stack_buf(16)
    let s = _arg_str(self_p, argv_p, 0)
    let p = _text_str(self_p, argv_p + 16, 1, tmp)
    let o = stack_buf(16)
    _bool(o, ld64(p) <= ld64(s) and memcmp(s + S_DATA, p + S_DATA, ld64(p)) == 0)
    retp(o)
}

func lb_ends_with(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let tmp = stack_buf(16)
    let s = _arg_str(self_p, argv_p, 0)
    let p = _text_str(self_p, argv_p + 16, 1, tmp)
    let o = stack_buf(16)
    _bool(o, ld64(p) <= ld64(s) and memcmp(s + S_DATA + ld64(s) - ld64(p), p + S_DATA, ld64(p)) == 0)
    retp(o)
}

# A copy of s with every byte run through the C ctype function toupper or tolower.
func _map_case(o, s, upper) {
    _str_n(o, s + S_DATA, ld64(s))
    let d = _val(o) + S_DATA
    for (let i = 0; i < ld64(s); i++) {
        if (upper != 0) {
            st8(d + i, toupper(ld8(s + S_DATA + i)))
        } else {
            st8(d + i, tolower(ld8(s + S_DATA + i)))
        }
    }
}

func _case_builtin(self_p, argc_i, argv_p, upper) {
    lv_arity(self_p, argc_i, 1, 1)
    let tmp = stack_buf(16)
    let o = stack_buf(16)
    let s = _text_str(self_p, argv_p, 0, tmp)
    _map_case(o, s, upper)
    if (_tag(argv_p) == T_CHAR) {
        _chr(o, ld8(_val(o) + S_DATA))
    }
    retp(o)
}

func lb_to_upper(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    callv(o, _case_builtin, self_p, argc_i, argv_p, 1)
    retp(o)
}

func lb_to_lower(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    callv(o, _case_builtin, self_p, argc_i, argv_p, 0)
    retp(o)
}

func _trim(o, s, left, right) {
    let a = 0
    let b = ld64(s)
    if (left != 0) {
        while (a < b and isspace(ld8(s + S_DATA + a)) != 0) {
            a += 1
        }
    }
    if (right != 0) {
        while (b > a and isspace(ld8(s + S_DATA + b - 1)) != 0) {
            b -= 1
        }
    }
    _str_n(o, s + S_DATA + a, b - a)
}

func lb_trim(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    _trim(o, _arg_str(self_p, argv_p, 0), 1, 1)
    retp(o)
}

func lb_trim_left(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    _trim(o, _arg_str(self_p, argv_p, 0), 1, 0)
    retp(o)
}

func lb_trim_right(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    _trim(o, _arg_str(self_p, argv_p, 0), 0, 1)
    retp(o)
}

func lb_replace(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 3, 3)
    let t1 = stack_buf(16)
    let t2 = stack_buf(16)
    let s = _arg_str(self_p, argv_p, 0)
    let frm = _text_str(self_p, argv_p + 16, 1, t1)
    let to = _text_str(self_p, argv_p + 32, 2, t2)
    let o = stack_buf(16)
    if (ld64(frm) == 0) {
        _cp(o, argv_p)
        retp(o)
    }
    let b = stack_buf(B_SIZE)
    _buf_init(b)
    let i = 0
    while (true) {
        let j = _find_sub(s, frm, i)
        if (j < 0) {
            break
        }
        _buf_add(b, s + S_DATA + i, j - i)
        _buf_add(b, to + S_DATA, ld64(to))
        i = j + ld64(frm)
    }
    _buf_add(b, s + S_DATA + i, ld64(s) - i)
    _buf_done(o, b)
    retp(o)
}

func lb_reverse(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    if (_tag(argv_p) == T_LIST) {
        let l = _val(argv_p)
        let n = ld64(l + L_COUNT)
        _list_of(o, n, ld64(l + L_ITEMS))
        let items = ld64(_val(o) + L_ITEMS)
        let t = stack_buf(16)
        let i = 0
        let j = n - 1
        while (i < j) {
            _cp(t, items + 16 * i)
            _cp(items + 16 * i, items + 16 * j)
            _cp(items + 16 * j, t)
            i++
            j -= 1
        }
        retp(o)
    }
    let s = _arg_str(self_p, argv_p, 0)
    _str_n(o, s + S_DATA, ld64(s))
    let n = ld64(s)
    for (let i = 0; i < n; i++) {
        st8(_val(o) + S_DATA + i, ld8(s + S_DATA + n - 1 - i))
    }
    retp(o)
}

func lb_repeat(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let tmp = stack_buf(16)
    let s = _text_str(self_p, argv_p, 0, tmp)
    let n = _arg_int(self_p, argv_p, 1)
    let o = stack_buf(16)
    if (n <= 0 or ld64(s) == 0) {
        _str(o, cstr(""))
        retp(o)
    }
    if (n > 70368744177664 / ld64(s)) {
        _die_oom()
    }
    let b = stack_buf(B_SIZE)
    _buf_init(b)
    for (let i = 0; i < n; i++) {
        _buf_add(b, s + S_DATA, ld64(s))
    }
    _buf_done(o, b)
    retp(o)
}

func _pad(self_p, argv, left, o) {
    let s = _arg_str(self_p, argv, 0)
    let w = _arg_int(self_p, argv, 1)
    let tmp = stack_buf(16)
    let pad = _text_str(self_p, argv + 32, 0, tmp)
    if (ld64(s) >= w or ld64(pad) == 0) {
        _cp(o, argv)
        return 0
    }
    if (w - ld64(s) > 70368744177664) {
        _die_oom()
    }
    let b = stack_buf(B_SIZE)
    _buf_init(b)
    if (left == 0) {
        _buf_add(b, s + S_DATA, ld64(s))
    }
    for (let i = 0; i < w - ld64(s); i++) {
        _buf_add(b, pad + S_DATA, 1)
    }
    if (left != 0) {
        _buf_add(b, s + S_DATA, ld64(s))
    }
    _buf_done(o, b)
}

func lb_pad_left(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 3, 3)
    let o = stack_buf(16)
    _pad(self_p, argv_p, 1, o)
    retp(o)
}

func lb_pad_right(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 3, 3)
    let o = stack_buf(16)
    _pad(self_p, argv_p, 0, o)
    retp(o)
}

# Splits on every occurrence of the delimiter; empty pieces are kept.
func lb_split(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let tmp = stack_buf(16)
    let s = _arg_str(self_p, argv_p, 0)
    let d = _text_str(self_p, argv_p + 16, 1, tmp)
    let o = stack_buf(16)
    let piece = stack_buf(16)
    _list_new(o, 8)
    if (ld64(d) == 0) {
        for (let i = 0; i < ld64(s); i++) {
            _str_n(piece, s + S_DATA + i, 1)
            _list_push(o, piece)
        }
        retp(o)
    }
    # Like strtok: every character of the delimiter separates, and empty pieces
    # are dropped.
    let copy = lv_alloc(ld64(s) + 1)
    memcpy(copy, s + S_DATA, ld64(s) + 1)
    let save = stack_buf(8)
    let tok = strtok_r(copy, d + S_DATA, save)
    while (tok != 0) {
        _str(piece, tok)
        _list_push(o, piece)
        tok = strtok_r(0, d + S_DATA, save)
    }
    retp(o)
}

func lb_join(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    let l = _arg_list(self_p, argv_p, 0)
    let tmp = stack_buf(16)
    let d = _text_str(self_p, argv_p + 16, 0, tmp)
    let b = stack_buf(B_SIZE)
    let o = stack_buf(16)
    let count = ld64(l + L_COUNT)
    # A list of strings, the usual case, is joined with one exact-size allocation and one copy.
    let total = 0
    let all_text = 1
    for (let i = 0; i < count; i++) {
        let item = ld64(l + L_ITEMS) + 16 * i
        if (_tag(item) != T_STR) {
            all_text = 0
            break
        }
        total += ld64(_val(item))
    }
    if (all_text != 0) {
        if (count > 1) {
            total += ld64(d) * (count - 1)
        }
        if (ugt(total, 70368744177664)) {
            _die_oom()
        }
        let st = lv_alloc_atomic(S_DATA + total + 1)
        st64(st, total)
        let at = st + S_DATA
        for (let i = 0; i < count; i++) {
            if (i != 0 and ld64(d) != 0) {
                memcpy(at, d + S_DATA, ld64(d))
                at += ld64(d)
            }
            let src = _val(ld64(l + L_ITEMS) + 16 * i)
            if (ld64(src) != 0) {
                memcpy(at, src + S_DATA, ld64(src))
                at += ld64(src)
            }
        }
        st8(at, 0)
        _set(o, T_STR, st)
        retp(o)
    }
    _buf_init(b)
    for (let i = 0; i < count; i++) {
        if (i != 0) {
            _buf_add(b, d + S_DATA, ld64(d))
        }
        _buf_value(b, ld64(l + L_ITEMS) + 16 * i)
    }
    _buf_done(o, b)
    retp(o)
}

# 0 = isdigit, 1 = isalpha, 2 = isalnum, 3 = isspace
func _class_match(kind, c) {
    if (kind == 0) {
        return isdigit(c)
    }
    if (kind == 1) {
        return isalpha(c)
    }
    if (kind == 2) {
        return isalnum(c)
    }
    return isspace(c)
}

func _char_class(self_p, argc_i, argv_p, kind, o) {
    lv_arity(self_p, argc_i, 1, 1)
    let tmp = stack_buf(16)
    let s = _text_str(self_p, argv_p, 0, tmp)
    if (ld64(s) == 0) {
        _bool(o, 0)
        return 0
    }
    for (let i = 0; i < ld64(s); i++) {
        if (_class_match(kind, ld8(s + S_DATA + i)) == 0) {
            _bool(o, 0)
            return 0
        }
    }
    _bool(o, 1)
}

func lb_is_digit(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _char_class(self_p, argc_i, argv_p, 0, o)
    retp(o)
}

func lb_is_alpha(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _char_class(self_p, argc_i, argv_p, 1, o)
    retp(o)
}

func lb_is_alnum(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _char_class(self_p, argc_i, argv_p, 2, o)
    retp(o)
}

func lb_is_space(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    _char_class(self_p, argc_i, argv_p, 3, o)
    retp(o)
}
