# zue_rt_lib.zu: the builtin functions of the core library: conversions, maps, lists and
# strings. Every builtin is lb_<name>(self, argc, argv) and returns its result as an LV.
# Math, files, random numbers and vectors are in zue_rt_math.zu.

extern("getline", "i64", "ptr,ptr,ptr")
extern("system", "i32", "ptr")
extern("clock_gettime", "i32", "i32,ptr")
extern("calloc", "ptr", "i64,i64")
extern("strtoll", "i64", "ptr,ptr,i32")
extern("strtod", "double", "ptr,ptr")
extern("strtok_r", "ptr", "ptr,ptr,ptr")
extern("isspace", "i32", "i32")
extern("isdigit", "i32", "i32")
extern("isalpha", "i32", "i32")
extern("isalnum", "i32", "i32")
extern("toupper", "i32", "i32")
extern("tolower", "i32", "i32")
extern("memmem", "ptr", "ptr,i64,ptr,i64")

# Argument helpers

func _fname(self_p) {
    if (self_p != 0 and ld64(self_p + F_NAME) != 0) {
        return ld64(self_p + F_NAME)
    }
    return cstr("builtin")
}

# "a" or "an" for a type name.
func _article(what) {
    let c = ld8(what)
    if (c == 97 or c == 101 or c == 105 or c == 111 or c == 117 or c == 65 or c == 69 or c == 73 or c == 79 or c == 85) {
        return cstr("an")
    }
    return cstr("a")
}

func _is(a, b) {
    return strcmp(a, b) == 0
}

# What to write to get a value of type want from one of type got, or 0.
func _convert_hint(want, got) {
    let num_got = _is(got, cstr("int")) or _is(got, cstr("float"))
    if (_is(want, cstr("string"))) {
        if (num_got) {
            return cstr("Convert a number to text with to_string(x), or write it inside a string: \"\{x}\"")
        }
        return cstr("Pass a string such as \"abc\"")
    }
    if (_is(want, cstr("int"))) {
        if (_is(got, cstr("float"))) {
            return cstr("A float never becomes an int by itself: use int(x), floor(x), ceil(x) or round(x)")
        }
        if (_is(got, cstr("string"))) {
            return cstr("Convert text to a number with s as int")
        }
        return cstr("Pass a whole number such as 3")
    }
    if (_is(want, cstr("float"))) {
        if (_is(got, cstr("int"))) {
            return cstr("An int never becomes a float by itself: convert it with float(x), or write 2.0")
        }
        if (_is(got, cstr("string"))) {
            return cstr("Convert text to a number with s as float")
        }
        return cstr("Pass a number with a decimal point such as 2.5")
    }
    if (_is(want, cstr("number"))) {
        if (_is(got, cstr("string"))) {
            return cstr("Convert text to a number with s as int or s as float")
        }
        return cstr("Pass an int such as 3 or a float such as 2.5")
    }
    if (_is(want, cstr("list"))) {
        return cstr("Pass a list such as [1, 2, 3]")
    }
    if (_is(want, cstr("map"))) {
        return cstr("Pass a map such as \{\"key\": 1}")
    }
    return 0
}

func _arg_fail(self_p, argv, i, what) {
    let msg = stack_buf(256)
    snprintf(msg, 256, cstr("%s() argument %d must be %s %s, got %s"), _fname(self_p), i + 1, _article(what), what,
             _type_name(argv + 16 * i))
    let lab = stack_buf(96)
    snprintf(lab, 96, cstr("expected %s, found %s"), what, _type_name(argv + 16 * i))
    st64(addr_of("lv_err_arg"), i + 1)
    lv_error_labeled(E_TYPE, msg, _convert_hint(what, _type_name(argv + 16 * i)), lab, 0, 0)
}

# The LvStr of argument i.
func _arg_str(self_p, argv, i) {
    if (_tag(argv + 16 * i) != T_STR) {
        _arg_fail(self_p, argv, i, cstr("string"))
    }
    return _val(argv + 16 * i)
}

# A string argument that is passed to the system as a C string (a path or a command): a NUL byte in it
# would silently cut it short.
func _arg_path(self_p, argv, i) {
    let s = _arg_str(self_p, argv, i)
    if (strlen(s + S_DATA) != ld64(s)) {
        _errf(E_ARGUMENT, cstr("A path or command cannot hold the character '\\0'."),
              cstr("%s() argument %d contains a NUL byte"), _fname(self_p), i + 1, 0)
    }
    return s
}

func _arg_int(self_p, argv, i) {
    if (_tag(argv + 16 * i) != T_INT) {
        _arg_fail(self_p, argv, i, cstr("int"))
    }
    return _val(argv + 16 * i)
}

# A number argument as a double.
# A float argument; an int is an error, as everywhere a float is wanted (int and float never mix).
func _arg_flt(self_p, argv, i) {
    if (_tag(argv + 16 * i) != T_FLOAT) {
        _arg_fail(self_p, argv, i, cstr("float"))
    }
    return _val(argv + 16 * i)
}

func _arg_num(self_p, argv, i) {
    if (_is_num(argv + 16 * i) == 0) {
        _arg_fail(self_p, argv, i, cstr("number"))
    }
    return _num(argv + 16 * i)
}

# The LvList of argument i.
func _arg_list(self_p, argv, i) {
    if (_tag(argv + 16 * i) != T_LIST) {
        _arg_fail(self_p, argv, i, cstr("list"))
    }
    return _val(argv + 16 * i)
}

# The LV of argument i, which must be a map.
func _arg_map(self_p, argv, i) {
    if (_tag(argv + 16 * i) != T_MAP) {
        _arg_fail(self_p, argv, i, cstr("map"))
    }
    return argv + 16 * i
}

# A char counts as a one-character string: the LvStr of v, using tmp for the char case.
# i is the argument number that errors name.
func _text_str(self_p, v, i, tmp) {
    if (_tag(v) == T_CHAR) {
        _str_n(tmp, v + 8, 1)
        return _val(tmp)
    }
    if (_tag(v) != T_STR) {
        _arg_fail(self_p, v - 16 * i, i, cstr("string"))
    }
    return _val(v)
}

# Core builtins

func lb_len(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    let t = _tag(argv_p)
    if (t == T_STR) {
        _int(o, ld64(_val(argv_p)))
    } else if (t == T_LIST) {
        _int(o, ld64(_val(argv_p) + L_COUNT))
    } else if (t == T_DENSE) {
        _int(o, ld64(_val(argv_p) + D_COUNT))
    } else if (t == T_MAP) {
        _int(o, ld64(_val(argv_p) + M_COUNT))
    } else if (t == T_BOX or t == T_TEMPLATE) {
        let n = stack_buf(8)
        _data_len(argv_p, n)
        _int(o, ld64(n))
    } else {
        _errf(E_TYPE, cstr("len works on a string, a list, a map or a box"), cstr("len() needs a string, list or map, got %s"), _type_name(argv_p), 0, 0)
    }
    retp(o)
}

# How many "{}" placeholders the string f holds.
func _holes(f) {
    let n = ld64(f)
    let holes = 0
    let i = 0
    while (i + 1 < n) {
        if (ld8(f + S_DATA + i) == 123 and ld8(f + S_DATA + i + 1) == 125) {
            holes += 1
            i += 1
        }
        i += 1
    }
    return holes
}

# print(a, b, c) prints each value on its own line. When the first value is a string with {}
# placeholders, print(text, x, y) fills them with the values after it and prints one line: there
# must be exactly one value for each placeholder.
func lb_print(self_p, argc_i, argv_p) {
    if (argc_i >= 2 and _tag(argv_p) == T_STR) {
        let f = _val(argv_p)
        let holes = _holes(f)
        if (holes > 0) {
            if (holes != argc_i - 1) {
                _errf4(E_ARGUMENT, cstr("Give one value for each \{} in the first string, or print the values on their own lines by leaving \{} out."),
                       cstr("print() has %d \{} placeholder(s) but got %d value(s)"), holes, argc_i - 1, 0, 0)
            }
            let b = stack_buf(B_SIZE)
            let line = stack_buf(16)
            _buf_init(b)
            let next = 1
            let n = ld64(f)
            let i = 0
            while (i < n) {
                if (ld8(f + S_DATA + i) == 123 and i + 1 < n and ld8(f + S_DATA + i + 1) == 125) {
                    _buf_value(b, argv_p + 16 * next)
                    next += 1
                    i += 1
                } else {
                    _buf_add(b, f + S_DATA + i, 1)
                }
                i += 1
            }
            _buf_done(line, b)
            lvp_print(line)
            let o = stack_buf(16)
            _null(o)
            retp(o)
        }
    }
    for (let i = 0; i < argc_i; i++) {
        lvp_print(argv_p + 16 * i)
    }
    let o = stack_buf(16)
    _null(o)
    retp(o)
}

func lb_str_len(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    _int(o, ld64(_arg_str(self_p, argv_p, 0)))
    retp(o)
}

func lb_append(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    _arg_list(self_p, argv_p, 0)
    _list_push(argv_p, argv_p + 16)
    # the same list, changed in place, so print(append(x, 1)) shows it
    let o = stack_buf(16)
    _cp(o, argv_p)
    retp(o)
}

func lb_list_append(self_p, argc_i, argv_p) {
    let o = stack_buf(16)
    callv(o, lb_append, self_p, argc_i, argv_p)
    retp(o)
}

# The type() result for each fixed type tag, made once: strings never change, so every call can
# share them. The table is a root range, so the collector keeps the strings alive.
let g_type_names = 0

func lb_type(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    let t = _tag(argv_p)
    if (t <= T_MAP or t == T_DENSE) {
        if (g_type_names == 0) {
            g_type_names = calloc(16, 8)
            lv_gc_root_add(g_type_names, g_type_names + 128)
        }
        let cached = ld64(g_type_names + t * 8)
        if (cached == 0) {
            _str(o, _type_name(argv_p))
            cached = _val(o)
            st64(g_type_names + t * 8, cached)
        }
        _set(o, T_STR, cached)
        retp(o)
    }
    _str(o, _type_name(argv_p))
    retp(o)
}

# Reads the whole text s as a base-10 int into out_p, with optional spaces around and an optional sign.
# Returns 0, or why it cannot: 1 the text is not a whole number, 2 the value does not fit in 64 bits.
func _read_int(s, out_p) {
    let p = s
    while (isspace(ld8(p)) != 0) {
        p += 1
    }
    let neg = 0
    if (ld8(p) == 45) {
        neg = 1
        p += 1
    } else if (ld8(p) == 43) {
        p += 1
    }
    if (isdigit(ld8(p)) == 0) {
        return 1
    }
    # Digits are accumulated as a negative number so that -2^63 fits.
    let v = 0
    while (isdigit(ld8(p)) != 0) {
        let d = ld8(p) - 48
        if (mulof(v, 10) != 0 or subof(v * 10, d) != 0) {
            return 2
        }
        v = v * 10 - d
        p += 1
    }
    while (isspace(ld8(p)) != 0) {
        p += 1
    }
    if (ld8(p) != 0) {
        return 1
    }
    if (neg == 0) {
        if (v == -9223372036854775807 - 1) {
            return 2
        }
        v = 0 - v
    }
    st64(out_p, v)
    return 0
}

# Reads the whole text s as a float into out_p (its bits): digits with an optional sign, point and exponent,
# and optional spaces around. Returns 0, or why it cannot: 1 the text is not a number (names such as nan and
# inf and hex digits are not), 2 the value is too large for a float, 4 it is too small (it would read as 0.0).
func _read_float(s, out_p) {
    let p = s
    while (isspace(ld8(p)) != 0) {
        p += 1
    }
    let start = p
    let digits = 0
    while (ld8(p) != 0 and isspace(ld8(p)) == 0) {
        let c = ld8(p)
        if (isdigit(c) != 0) {
            digits = 1
        } else if (c != 43 and c != 45 and c != 46 and c != 101 and c != 69) {
            digits = 0
            break
        }
        p += 1
    }
    if (digits == 0) {
        return 1
    }
    let end = stack_buf(8)
    let r = strtod(start, end)
    let e = ld64(end)
    while (isspace(ld8(e)) != 0) {
        e += 1
    }
    if (ld8(e) != 0) {
        return 1
    }
    if (_is_finite(r) == 0) {
        return 2
    }
    # A value too small for a float would read as 0.0 without a word (float("1e-400")); it is refused
    # unless the digits before the exponent are all zero.
    if (feq(r, 0.0)) {
        let q = start
        while (ld8(q) != 0 and ld8(q) != 101 and ld8(q) != 69) {
            if (ld8(q) >= 49 and ld8(q) <= 57) {
                return 4
            }
            q += 1
        }
    }
    st64(out_p, r)
    return 0
}

# The error for text that cannot be read as an int (want 1) or a float (want 2), for the reason r of
# _read_int or _read_float. name is the function the program called.
func _conv_text_fail(name, s, r, want) {
    if (r == 1 and want == 1) {
        _errf(E_ARGUMENT, cstr("Use a string of digits such as \"42\" or \"-7\"."),
              cstr("%s() cannot read \"%s\" as an integer"), name, s, 0)
    }
    if (r == 1) {
        _errf(E_ARGUMENT, cstr("Use a number such as \"3.5\", \"-2\" or \"1e3\"."),
              cstr("%s() cannot read \"%s\" as a float"), name, s, 0)
    }
    if (want == 1) {
        _errf(E_RUNTIME, cstr("The value must fit in a 64-bit int."),
              cstr("%s() value \"%s\" does not fit in a 64-bit int"), name, s, 0)
    }
    if (r == 2) {
        _errf(E_RUNTIME, cstr("Zue has no infinity: the value must fit in a 64-bit float."),
              cstr("%s() value \"%s\" does not fit in a 64-bit float"), name, s, 0)
    }
    _errf(E_RUNTIME, cstr("The smallest float above 0 is about 4.9e-324."),
          cstr("%s() value \"%s\" does not fit in a 64-bit float"), name, s, 0)
}

# Whether the string v holds a NUL byte: read as a number, the text would end there and hide what follows.
func _has_nul(v) {
    return strlen(_val(v) + S_DATA) != ld64(_val(v))
}

# int(v) into o. Returns 0, or why v has no int of the same value: 1 and 2 as for _read_int (text), 3 text
# with a NUL byte, 5 a float with a fraction, 6 a float outside the 64-bit range, 7 a char, 8 a bool, 9 any
# other type. A pointer gives its address, the one cast unsafe code may make.
func _conv_int(o, v) {
    let t = _tag(v)
    if (t == T_PTR and _is_pointer(v) != 0) {
        _int(o, _ptr_address(v))
        return 0
    }
    if (t == T_INT) {
        _cp(o, v)
        return 0
    }
    if (t == T_FLOAT) {
        let f = _val(v)
        if (fge(f, -9223372036854775808.0) == 0 or flt(f, 9223372036854775808.0) == 0) {
            return 6
        }
        let i = f2i(f)
        if (feq(i2f(i), f) == 0) {
            return 5
        }
        _int(o, i)
        return 0
    }
    if (t == T_STR) {
        if (_has_nul(v) != 0) {
            return 3
        }
        let b = stack_buf(8)
        let r = _read_int(_val(v) + S_DATA, b)
        if (r != 0) {
            return r
        }
        _int(o, ld64(b))
        return 0
    }
    if (t == T_CHAR) {
        return 7
    }
    if (t == T_BOOL) {
        return 8
    }
    return 9
}

# float(v) into o. Returns 0, or why v has no float of the same value: 1, 2 and 4 as for _read_float (text),
# 3 text with a NUL byte, 5 an int that has no exact float, 7 a char, 8 a bool, 9 any other type.
func _conv_float(o, v) {
    let t = _tag(v)
    if (t == T_INT) {
        let i = _val(v)
        let f = i2f(i)
        if (fge(f, 9223372036854775808.0) != 0 or f2i(f) != i) {
            return 5
        }
        _flt(o, f)
        return 0
    }
    if (t == T_FLOAT) {
        _cp(o, v)
        return 0
    }
    if (t == T_STR) {
        if (_has_nul(v) != 0) {
            return 3
        }
        let b = stack_buf(8)
        let r = _read_float(_val(v) + S_DATA, b)
        if (r != 0) {
            return r
        }
        _flt(o, ld64(b))
        return 0
    }
    if (t == T_CHAR) {
        return 7
    }
    if (t == T_BOOL) {
        return 8
    }
    return 9
}

# The error for a conversion of v to an int (want 1) or a float (want 2) that failed for the reason r of
# _conv_int or _conv_float. name is the function the program called.
func _conv_fail(name, v, r, want) {
    if (r == 1 or r == 2 or r == 4) {
        _conv_text_fail(name, _val(v) + S_DATA, r, want)
    }
    if (r == 3) {
        _errf(E_ARGUMENT, cstr("Text read as a number holds only digits, a sign, a point and an exponent."),
              cstr("%s() cannot read text that holds a NUL byte as a number"), name, 0, 0)
    }
    if (r == 5 and want == 1) {
        let tmp = stack_buf(64)
        _float_text(tmp, _val(v), 17)
        _errf(E_ARGUMENT, cstr("Say how to round it: round(x), floor(x), ceil(x) or trunc(x)."),
              cstr("%s() of %s is not a whole number"), name, tmp, 0)
    }
    if (r == 5) {
        _errf(E_ARGUMENT, cstr("Ints up to 9007199254740992 (2^53) all have an exact float; keep this value as an int."),
              cstr("%s() of %lld has no exact float"), name, _val(v), 0)
    }
    if (r == 6) {
        _errf(E_RUNTIME, cstr("The largest int is 9223372036854775807. Keep very large numbers as floats"),
              cstr("%s() of a float that does not fit in a 64-bit int"), name, 0, 0)
    }
    if (r == 7 and want == 1) {
        _errf(E_TYPE, cstr("A char is not a number: code(c) gives the code of a character."),
              cstr("%s() cannot convert a char"), name, 0, 0)
    }
    if (r == 7) {
        _errf(E_TYPE, cstr("A char is not a number: float(code(c)) gives the code of a character as a float."),
              cstr("%s() cannot convert a char"), name, 0, 0)
    }
    if (r == 8) {
        _errf(E_TYPE, cstr("A bool is not a number: choose the number with an if."),
              cstr("%s() cannot convert a bool"), name, 0, 0)
    }
    if (want == 1) {
        _errf(E_TYPE, cstr("int() takes a whole float, or text that is a whole number, such as int(\"42\")"),
              cstr("%s() cannot convert %s"), name, _type_name(v), 0)
    }
    _errf(E_TYPE, cstr("float() takes an int, or text that is a number, such as float(\"2.5\")"),
          cstr("%s() cannot convert %s"), name, _type_name(v), 0)
}

func lb_int(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    let r = _conv_int(o, argv_p)
    if (r != 0) {
        _conv_fail(_fname(self_p), argv_p, r, 1)
    }
    retp(o)
}

func lb_float(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    _ptr_cast_check(argv_p, 1)
    let r = _conv_float(o, argv_p)
    if (r != 0) {
        _conv_fail(_fname(self_p), argv_p, r, 2)
    }
    retp(o)
}

# For 'else' and 'if (let ...)': converts v to an int (kind 1) or a float (kind 2) into out_p and returns 1,
# or returns 0 where int(v) or float(v) would be an error.
func lv_try_convert(out_p, v_p, kind) {
    if (kind == 1) {
        return _conv_int(out_p, v_p) == 0
    }
    _ptr_cast_check(v_p, 1)
    return _conv_float(out_p, v_p) == 0
}

# float(i) of an int the program keeps raw: the bits of the float, or an error when it has no exact float.
func lvv_int_to_float(i) {
    let f = i2f(i)
    if (fge(f, 9223372036854775808.0) != 0 or f2i(f) != i) {
        _errf(E_ARGUMENT, cstr("Ints up to 9007199254740992 (2^53) all have an exact float; keep this value as an int."),
              cstr("%s() of %lld has no exact float"), cstr("float"), i, 0)
    }
    return f
}

# string(v): the text of any value, as to_string(v) gives it.
func lb_string(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let o = stack_buf(16)
    _to_string(o, argv_p)
    retp(o)
}

# code(c): the code of a character, 0 to 255.
func lb_code(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    if (_tag(argv_p) != T_CHAR) {
        _arg_fail(self_p, argv_p, 0, cstr("char"))
    }
    let o = stack_buf(16)
    _int(o, ld8(argv_p + 8))
    retp(o)
}

# char(n): the character with code n, 0 to 255.
func lb_char(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let n = _arg_int(self_p, argv_p, 0)
    if (n < 0 or n > 255) {
        _errf(E_ARGUMENT, cstr("A char holds one byte: a code from 0 to 255."),
              cstr("char() of %lld is not a character code"), n, 0, 0)
    }
    let o = stack_buf(16)
    _chr(o, n)
    retp(o)
}

func lb_to_string(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 2)
    let o = stack_buf(16)
    if (argc_i == 2) {
        if (_tag(argv_p) != T_FLOAT) {
            _arg_fail(self_p, argv_p, 0, cstr("float"))
        }
        let digits = _arg_int(self_p, argv_p, 1)
        if (digits < 1 or digits > 17) {
            _errf(E_ARGUMENT, cstr("Use a number of significant digits from 1 to 17."),
                  cstr("to_string() digits must be between 1 and 17"), 0, 0, 0)
        }
        let tmp = stack_buf(64)
        _float_text(tmp, _val(argv_p), digits)
        _str_n(o, tmp, strlen(tmp))
        retp(o)
    }
    _to_string(o, argv_p)
    retp(o)
}

# fixed(x, decimals): a float as text with exactly that many places after the point.
func lb_fixed(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 2, 2)
    if (_tag(argv_p) != T_FLOAT) {
        _arg_fail(self_p, argv_p, 0, cstr("float"))
    }
    let decimals = _arg_int(self_p, argv_p, 1)
    if (decimals < 0 or decimals > 15) {
        _errf(E_ARGUMENT, cstr("Use a number of decimal places from 0 to 15."),
              cstr("fixed() decimals must be between 0 and 15"), 0, 0, 0)
    }
    let fmt = stack_buf(16)
    snprintf(fmt, 16, cstr("%%.%df"), decimals)
    let tmp = stack_buf(400)
    # Rounded first the way round(x, digits) rounds (halves away from zero); printf alone sent halves to the
    # even neighbour, so fixed(2.5, 0) was "2" while round(2.5) is 3.
    snprintf(tmp, 400, fmt, dbl(_round_digits(_val(argv_p), decimals)))
    # A tiny negative number rounds to zero: write 0.00, not -0.00.
    let start = 0
    if (ld8(tmp) == 45) {
        let all_zero = 1
        let p = tmp + 1
        while (ld8(p) != 0) {
            if (ld8(p) != 48 and ld8(p) != 46) {
                all_zero = 0
            }
            p += 1
        }
        if (all_zero != 0) {
            start = 1
        }
    }
    let o = stack_buf(16)
    _str_n(o, tmp + start, strlen(tmp) - start)
    retp(o)
}

# assert() accepts any value and uses its truthiness.
func _assert_truthy(v) {
    let t = _tag(v)
    if (t == T_BOOL) {
        return ld32(v + 8) != 0
    }
    if (t == T_INT) {
        return _val(v) != 0
    }
    if (t == T_FLOAT) {
        return fne(_val(v), 0.0)
    }
    if (t == T_CHAR) {
        return ld8(v + 8) != 0
    }
    if (t == T_STR) {
        return ld64(_val(v)) > 0
    }
    if (t == T_FILE) {
        return _val(v) != 0 and ld32(_val(v) + FI_CLOSED) == 0
    }
    if (t == T_LIST or t == T_DENSE or t == T_MAP or t == T_FUNC) {
        return 1
    }
    if (t >= T_BLOC_TYPE and t <= T_BOX) {
        return 1
    }
    if (t == T_PTR) {
        return _val(v) != 0
    }
    return 0
}

func lb_assert(self_p, argc_i, argv_p) {
    if (argc_i != 1) {
        lv_error(E_ARGUMENT, cstr("assert() takes exactly 1 argument"), cstr("Use assert(condition) to verify logic."))
    }
    if (_assert_truthy(argv_p) == 0) {
        lv_error(E_ASSERTION, cstr("Assertion failed"), cstr("The condition evaluated to false."))
    }
    let o = stack_buf(16)
    _bool(o, 1)
    retp(o)
}

func lb_input(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 0, 1)
    let o = stack_buf(16)
    if (argc_i == 1) {
        let p = stack_buf(16)
        _to_string(p, argv_p)
        fwrite(_val(p) + S_DATA, 1, ld64(_val(p)), _stdout())
        fflush(_stdout())
    }
    let cell = stack_buf(16)
    st64(cell, 0)
    st64(cell + 8, 0)
    let n = getline(cell, cell + 8, _stdin())
    let line = ld64(cell)
    if (n < 0) {
        free(line)
        _str(o, cstr(""))
        retp(o)
    }
    while (n > 0 and (ld8(line + n - 1) == 10 or ld8(line + n - 1) == 13)) {
        n -= 1
    }
    _str_n(o, line, n)
    free(line)
    retp(o)
}

func lb_debug(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let s = stack_buf(16)
    _to_string(s, argv_p)
    printf(cstr("value = %s\n"), _val(s) + S_DATA)
    let o = stack_buf(16)
    _cp(o, argv_p)
    retp(o)
}

func lb_range(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 3)
    let start = 0
    let end = 0
    let step = 1
    if (argc_i == 1) {
        end = _arg_int(self_p, argv_p, 0)
    } else {
        start = _arg_int(self_p, argv_p, 0)
        end = _arg_int(self_p, argv_p, 1)
        if (argc_i == 3) {
            step = _arg_int(self_p, argv_p, 2)
        }
    }
    if (step == 0) {
        lv_error(E_ARGUMENT, cstr("range() step must not be 0"), cstr("A step of 0 never reaches the end. Use 1, or a negative step to count down"))
    }
    # The span and the step are taken as unsigned 64-bit numbers: end - start can be larger than the largest
    # int (range(-2^63, 2^63 - 1, 2^62) has 4 items), and end - start + step - 1 wrapped before.
    let n = 0
    if (step > 0 and end > start) {
        n = udiv(end - start - 1, step) + 1
    }
    if (step < 0 and end < start) {
        n = udiv(start - end - 1, 0 - step) + 1
    }
    # each item is a 16-byte value; a list larger than memory is refused here with the line, not as a bare "out of memory"
    if (_too_big(n, 16)) {
        _errf(E_ARGUMENT, cstr("Use a larger step or a smaller span, or loop with for (let i = start; i < end; i += step)."),
              cstr("range() would make %llu items, too many to hold in memory"), n, 0, 0)
    }
    let o = stack_buf(16)
    _list_new(o, n)
    let items = ld64(_val(o) + L_ITEMS)
    let v = start
    for (let i = 0; i < n; i++) {
        _set(items + 16 * i, T_INT, v)
        v += step
    }
    st64(_val(o) + L_COUNT, n)
    retp(o)
}

func lb_args(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 0, 0)
    let argc = ld64(addr_of("_argc"))
    let argv = ld64(addr_of("_argv"))
    let o = stack_buf(16)
    let s = stack_buf(16)
    _list_new(o, argc)
    for (let i = 1; i < argc; i++) {
        _str(s, ld64(argv + i * 8))
        _list_push(o, s)
    }
    retp(o)
}

func lb_exit(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 0, 1)
    let code = 0
    if (argc_i == 1) {
        code = _arg_int(self_p, argv_p, 0)
    }
    if (code < 0 or code > 255) {
        _errf(E_ARGUMENT, cstr("An exit status is a number from 0 (success) to 255."),
              cstr("exit() status must be from 0 to 255, got %lld"), code, 0, 0)
    }
    exit(lv_flush_stdout_at_exit(code))
    let o = stack_buf(16)
    _null(o)
    retp(o)
}

func lb_system(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 1, 1)
    let cmd = _arg_path(self_p, argv_p, 0)
    let o = stack_buf(16)
    fflush(_stdout())
    let rc = system(cmd + S_DATA)
    if (rc == -1) {
        let e = ld32(__errno_location())
        _errf(E_RUNTIME, cstr("The system could not start a shell for the command."),
              cstr("system() failed: %s"), strerror(e), 0, 0)
    } else if (band(rc, 127) == 0) {
        _int(o, band(shr(rc, 8), 255))
    } else {
        let sig = band(rc, 127)
        if (sar(shl(sig + 1, 56), 57) > 0) {
            _int(o, 128 + sig)
        } else {
            _int(o, 128)
        }
    }
    retp(o)
}

func lb_clock(self_p, argc_i, argv_p) {
    lv_arity(self_p, argc_i, 0, 0)
    let ts = stack_buf(16)
    clock_gettime(1, ts)
    let o = stack_buf(16)
    _flt(o, fadd(i2f(ld64(ts)), fdiv(i2f(ld64(ts + 8)), 1000000000.0)))
    retp(o)
}

