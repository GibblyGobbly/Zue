#
# zue_rt_core.zu: the core of the runtime of compiled Zue programs, written in Zue and
# compiled with `zuec --native` (see compiler/emit_native.zu). Values are LVs in memory:
# a 16-byte cell holding a tag word and a payload word. Functions here take pointers to
# LVs and write results through an out pointer; the entry points that generated code
# calls by value return an LV with retp.
#
# This file holds the layouts, errors, strings, lists, maps and the to_string rules.
# Operators, calls and the program entry are in zue_rt_ops.zu, the builtins in
# zue_rt_lib.zu and zue_rt_math.zu, and data, box and unsafe in zue_rt_data.zu.

extern("memcpy", "ptr", "ptr,ptr,i64")
extern("memmove", "ptr", "ptr,ptr,i64")
extern("memset", "ptr", "ptr,i32,i64")
extern("memcmp", "i32", "ptr,ptr,i64")
extern("memchr", "ptr", "ptr,i32,i64")
extern("strlen", "i64", "ptr")
extern("strcmp", "i32", "ptr,ptr")
extern("snprintf", "i32", "ptr,i64,ptr,...")
extern("fprintf", "i32", "ptr,ptr,...")
extern("printf", "i32", "ptr,...")
extern("fwrite", "i64", "ptr,i64,i64,ptr")
extern("fputc", "i32", "i32,ptr")
extern("fflush", "i32", "ptr")
extern("getenv", "ptr", "ptr")
extern("exit", "void", "i32")
extern("free", "void", "ptr")
extern("calloc", "ptr", "i64,i64")
extern("realloc", "ptr", "ptr,i64")

# LV tags
const T_NULL = 0
const T_BOOL = 1
const T_INT = 2
const T_FLOAT = 3
const T_CHAR = 4
const T_STR = 5
const T_LIST = 6
const T_MAP = 7
const T_FUNC = 8
const T_FILE = 9
const T_DENSE = 10
const T_BLOC_TYPE = 11
const T_BLOC = 12
const T_DTYPE = 13
const T_TEMPLATE = 14
const T_BOX = 15
const T_PTR = 16
const T_UNDEF = 17
const T_THREAD = 18    # a blue thread: the payload is its object (see zue_rt_blue.zu)
const T_CHAN = 19      # a channel between blue threads

# error kinds
const E_RUNTIME = 0
const E_TYPE = 1
const E_NAME = 2
const E_INDEX = 3
const E_ARGUMENT = 4
const E_ASSERTION = 5

# LvStr { i64 len; char data[] }
const S_DATA = 8
# LvList { count, cap, items }
const L_COUNT = 0
const L_CAP = 8
const L_ITEMS = 16
const L_SIZE = 24
const LIST_INLINE_BYTES = 512    # a list whose items take no more than this shares its object with the header
# LvMap { count, used, cap, entries, index, icap }; entry { key, val(16), live } is 32 bytes
const M_COUNT = 0
const M_USED = 8
const M_CAP = 16
const M_ENTRIES = 24
const M_INDEX = 32
const M_ICAP = 40
const M_SIZE = 48
const E_KEY = 0
const E_VAL = 8
const E_LIVE = 24
const E_SIZE = 32
# LvFunc { fn, name, int native, int ncells, cells }
const F_FN = 0
const F_NAME = 8
const F_NATIVE = 16
const F_NCELLS = 20
const F_CELLS = 24
const F_SIZE = 32
# LvDense { count, cap, data }
const D_COUNT = 0
const D_CAP = 8
const D_DATA = 16
const D_SIZE = 24
# LvFile { fp, int closed }
const FI_FP = 0
const FI_CLOSED = 8
# LvModule { path, lines, int line_count }
const MOD_PATH = 0
const MOD_LINES = 8
const MOD_COUNT = 16
# LvBuf { buf, len, cap }
const B_BUF = 0
const B_LEN = 8
const B_CAP = 16
const B_SIZE = 24

space("lv_pos_mod", 8)
space("lv_depth", 4)

# Where the operation that is running is, as set by the generated code before an operation that can
# fail (ll_pos in ll_state.zu): bits 0-21 the line, 22-33 the column, 34-45 the length on that line,
# 46-57 the offset of the operator from the column (0 when there is none), 58-59 the operator
# length minus 1. A column of 0 means that only the line is known.
space("lv_pos", 8)

# Text for the marks of the next error, set by the code that raises it: beside the carets, and under
# the left and the right operand of an operator. 0 when there is none.
space("lv_lab_main", 8)
space("lv_lab_l", 8)
space("lv_lab_r", 8)

# The argument of a call that the next error is about, counting from 1, or 0. The carets then go
# under that argument.
space("lv_err_arg", 8)

# The calls that are running, innermost last, indexed by depth: for each, the place of the call, the
# module it was made in and the name of the function (a static string, or 0).
const FRAME_SIZE = 24
space("lv_frames", 2400072)
space("_argc", 8)
space("_argv", 8)
let g_found = 0

func _stdout() {
    return ld64(addr_of("stdout"))
}

func _stderr() {
    return ld64(addr_of("stderr"))
}

func _stdin() {
    return ld64(addr_of("stdin"))
}

# LV cells

func _tag(p) {
    return ld32(p)
}

func _val(p) {
    return ld64(p + 8)
}

# Every write of a value cell goes through _set or _cp. They apply the write barrier (see zue_gc.zu) to the
# value being overwritten, whether the cell is on the stack or in a heap object.
func _set(p, t, v) {
    lv_wb_cell(p)
    st64(p, t)
    st64(p + 8, v)
}

func _cp(dst, src) {
    lv_wb_cell(dst)
    st64(dst, ld64(src))
    st64(dst + 8, ld64(src + 8))
}

func _null(o) {
    _set(o, T_NULL, 0)
}

func _int(o, i) {
    _set(o, T_INT, i)
}

func _flt(o, bits) {
    # adding +0.0 turns -0.0 into 0.0: Zue has no negative zero
    _set(o, T_FLOAT, fadd(bits, 0.0))
}

func _bool(o, b) {
    if (b != 0) {
        _set(o, T_BOOL, 1)
    } else {
        _set(o, T_BOOL, 0)
    }
}

func _chr(o, c) {
    _set(o, T_CHAR, band(c, 255))
}

func _is_num(p) {
    return _tag(p) == T_INT or _tag(p) == T_FLOAT
}

# A number as a double (its bit pattern).
func _num(p) {
    if (_tag(p) == T_INT) {
        return i2f(_val(p))
    }
    return _val(p)
}

func _is_listish(p) {
    return _tag(p) == T_LIST or _tag(p) == T_DENSE
}

# Errors

func _err_name(k) {
    if (k == E_RUNTIME) {
        return cstr("Runtime Error")
    }
    if (k == E_TYPE) {
        return cstr("Type Error")
    }
    if (k == E_NAME) {
        return cstr("Name Error")
    }
    if (k == E_INDEX) {
        return cstr("Index Error")
    }
    if (k == E_ARGUMENT) {
        return cstr("Argument Error")
    }
    if (k == E_ASSERTION) {
        return cstr("Assertion Error")
    }
    return cstr("Error")
}

# Text layout. A tab is shown as this many spaces, so that carets stay under the code.
const TAB_COLS = 4

# The screen columns taken by the first n bytes of text.
func _cols(text, n) {
    let w = 0
    for (let k = 0; k < n; k++) {
        let c = ld8(text + k)
        if (c == 0) {
            break
        }
        if (c == 9) {
            w += TAB_COLS
        } else if (band(c, 192) != 128) {
            w += 1
        }
    }
    return w
}

func _put_chars(ch, n) {
    for (let k = 0; k < n; k++) {
        fputc(ch, _stderr())
    }
}

# Writes text with each tab as spaces, from byte from up to byte to.
func _put_source(text, from, to) {
    for (let k = from; k < to; k++) {
        let c = ld8(text + k)
        if (c == 0) {
            break
        }
        if (c == 9) {
            _put_chars(32, TAB_COLS)
        } else {
            fputc(c, _stderr())
        }
    }
}

# Writes one row of marks, drawn under a source line. marks holds up to 3 entries of 3 words: the
# screen column, the width and the character. n entries are used.
func _put_marks(marks, n) {
    let at = 0
    for (let i = 0; i < n; i++) {
        let m = marks + i * 24
        _put_chars(32, ld64(m) - at)
        _put_chars(ld64(m + 16), ld64(m + 8))
        at = ld64(m) + ld64(m + 8)
    }
}

func _set_mark(marks, i, at, width, ch) {
    let m = marks + i * 24
    st64(m, at)
    if (width < 1) {
        width = 1
    }
    st64(m + 8, width)
    st64(m + 16, ch)
}

# Whether the span [from, to) of text, with the blanks around it removed, is not empty; moves from
# and to (in the two words at rng) inward.
func _trim_span(text, rng) {
    let a = ld64(rng)
    let b = ld64(rng + 8)
    while (a < b and ld8(text + a) == 32) {
        a += 1
    }
    while (b > a and ld8(text + b - 1) == 32) {
        b -= 1
    }
    st64(rng, a)
    st64(rng + 8, b)
    return b > a
}

# The span of argument number want (counting from 1) of the call that starts at byte from of text and
# ends before byte to; writes its start and end into rng and returns true, or returns false if the
# line does not hold it.
func _call_arg(text, from, to, want, rng) {
    let k = from
    while (k < to and ld8(text + k) != 40) {
        k += 1
    }
    if (k >= to) {
        return false
    }
    k += 1
    let depth = 0
    let index = 1
    let start = k
    while (k < to) {
        let c = ld8(text + k)
        if (c == 34 or c == 39) {
            let q = c
            k += 1
            while (k < to and ld8(text + k) != q) {
                if (ld8(text + k) == 92) {
                    k += 1
                }
                k += 1
            }
        } else if (c == 40 or c == 91 or c == 123) {
            depth += 1
        } else if (c == 93 or c == 125) {
            depth -= 1
        } else if (c == 41) {
            if (depth == 0) {
                if (index == want) {
                    st64(rng, start)
                    st64(rng + 8, k)
                    return _trim_span(text, rng)
                }
                return false
            }
            depth -= 1
        } else if (c == 44 and depth == 0) {
            if (index == want) {
                st64(rng, start)
                st64(rng + 8, k)
                return _trim_span(text, rng)
            }
            index += 1
            start = k + 1
        }
        k += 1
    }
    return false
}

# The carets under the source line of an error. A binary operation gets a caret under its operator and
# dashes under its operands; a call whose argument is at fault gets a caret under that argument;
# anything else a caret under the whole expression.
func _error_marks(text, tlen, pos) {
    let col0 = band(shr(pos, 22), 4095) - 1
    let end = col0 + band(shr(pos, 34), 4095)
    if (end > tlen) {
        end = tlen
    }
    let opoff = band(shr(pos, 46), 4095)
    let oplen = band(shr(pos, 58), 3) + 1
    let marks = stack_buf(72)
    let rng = stack_buf(16)
    let n = 0
    let main = ld64(addr_of("lv_lab_main"))
    let lab_l = ld64(addr_of("lv_lab_l"))
    let lab_r = ld64(addr_of("lv_lab_r"))
    let arg = ld64(addr_of("lv_err_arg"))
    let at_l = 0
    let last_text = main
    if (opoff > 0 and col0 + opoff + oplen <= end) {
        let a = col0 + opoff
        st64(rng, col0)
        st64(rng + 8, a)
        if (_trim_span(text, rng)) {
            _set_mark(marks, n, _cols(text, ld64(rng)), _cols(text + ld64(rng), ld64(rng + 8) - ld64(rng)), 45)
            at_l = _cols(text, ld64(rng))
            n += 1
        }
        _set_mark(marks, n, _cols(text, a), _cols(text + a, oplen), 94)
        n += 1
        st64(rng, a + oplen)
        st64(rng + 8, end)
        if (_trim_span(text, rng)) {
            _set_mark(marks, n, _cols(text, ld64(rng)), _cols(text + ld64(rng), ld64(rng + 8) - ld64(rng)), 45)
            n += 1
        }
        last_text = lab_r
    } else if (arg > 0 and _call_arg(text, col0, end, arg, rng)) {
        _set_mark(marks, 0, _cols(text, ld64(rng)), _cols(text + ld64(rng), ld64(rng + 8) - ld64(rng)), 94)
        n = 1
    } else {
        _set_mark(marks, 0, _cols(text, col0), _cols(text + col0, end - col0), 94)
        n = 1
    }
    fprintf(_stderr(), cstr("     | "))
    _put_marks(marks, n)
    if (last_text != 0) {
        fprintf(_stderr(), cstr(" %s"), last_text)
    }
    fputc(10, _stderr())
    if (lab_l != 0 and opoff > 0 and n > 1) {
        fprintf(_stderr(), cstr("     | "))
        _put_chars(32, at_l)
        fprintf(_stderr(), cstr("|\n     | "))
        _put_chars(32, at_l)
        fprintf(_stderr(), cstr("%s\n"), lab_l)
    }
}

# The source line of the error, quoted under the message, with carets when the column is known.
func _error_source(pos) {
    let m = ld64(addr_of("lv_pos_mod"))
    let line = band(pos, 4194303)
    if (m == 0 or line < 1 or line > ld32(m + MOD_COUNT)) {
        return 0
    }
    let text = ld64(ld64(m + MOD_LINES) + (line - 1) * 8)
    fprintf(_stderr(), cstr("\n%4d | "), line)
    _put_source(text, 0, 1000000)
    fputc(10, _stderr())
    let col = band(shr(pos, 22), 4095)
    let tlen = strlen(text)
    if (col > 0 and col <= tlen) {
        _error_marks(text, tlen, pos)
    }
    fputc(10, _stderr())
}

# One line of the call stack: the function, where it was called from and that source line.
func _put_frame(i, cur_mod) {
    let fr = addr_of("lv_frames") + i * FRAME_SIZE
    let pos = ld64(fr)
    let m = ld64(fr + 8)
    let name = ld64(fr + 16)
    let line = band(pos, 4194303)
    fprintf(_stderr(), cstr("  in "))
    if (name != 0) {
        fprintf(_stderr(), cstr("%s()"), name)
    } else {
        fprintf(_stderr(), cstr("a function"))
    }
    fprintf(_stderr(), cstr(", called at line %d"), line)
    if (m != 0 and m != cur_mod and ld64(m + MOD_PATH) != 0) {
        fprintf(_stderr(), cstr(" of %s"), ld64(m + MOD_PATH))
    }
    if (m != 0 and line >= 1 and line <= ld32(m + MOD_COUNT)) {
        let text = ld64(ld64(m + MOD_LINES) + (line - 1) * 8)
        let from = 0
        while (ld8(text + from) == 32 or ld8(text + from) == 9) {
            from += 1
        }
        let to = strlen(text)
        fprintf(_stderr(), cstr(": "))
        if (to - from > 80) {
            _put_source(text, from, from + 77)
            fprintf(_stderr(), cstr("..."))
        } else {
            _put_source(text, from, to)
        }
    }
    fputc(10, _stderr())
}

# The calls that were running when the error happened, innermost first. A long chain shows the first
# six calls, the last three and how many are left out.
func _print_stack() {
    let depth = ld32(addr_of("lv_depth"))
    if (depth <= 0) {
        return 0
    }
    let cur_mod = ld64(addr_of("lv_pos_mod"))
    fprintf(_stderr(), cstr("Call stack, innermost call first:\n"))
    let i = depth
    while (i >= 1) {
        if (depth > 12 and i == depth - 6) {
            fprintf(_stderr(), cstr("  ... %d more calls ...\n"), i - 3)
            i = 3
        }
        _put_frame(i, cur_mod)
        i -= 1
    }
}

# " [E0201]" after the name of the error, for a message that belongs to a family of errors.
func _put_code(msg_p) {
    let c = lv_code_for(msg_p)
    if (c != 0) {
        fprintf(_stderr(), cstr(" [%s]"), c)
    }
}

# The text s as a JSON string on standard error.
func _json_str(s) {
    fputc(34, _stderr())
    let k = 0
    while (ld8(s + k) != 0) {
        let c = ld8(s + k)
        if (c == 34) {
            fprintf(_stderr(), cstr("\\\""))
        } else if (c == 92) {
            fprintf(_stderr(), cstr("\\\\"))
        } else if (c == 10) {
            fprintf(_stderr(), cstr("\\n"))
        } else if (c == 9) {
            fprintf(_stderr(), cstr("\\t"))
        } else if (c == 13) {
            fprintf(_stderr(), cstr("\\r"))
        } else if (c >= 32) {
            fputc(c, _stderr())
        }
        k += 1
    }
    fputc(34, _stderr())
}

# True when ZUE_ERROR_FORMAT=json asks for each error as one JSON object on one line.
func _json_wanted() {
    let v = getenv(cstr("ZUE_ERROR_FORMAT"))
    return v != 0 and strcmp(v, cstr("json")) == 0
}

# The error as one JSON object: kind, code, file, place, message, hint and the call stack.
func _error_json(kind_i, msg_p, hint_p) {
    let m = ld64(addr_of("lv_pos_mod"))
    let pos = ld64(addr_of("lv_pos"))
    fprintf(_stderr(), cstr("\{\"kind\": "))
    _json_str(_err_name(kind_i))
    fprintf(_stderr(), cstr(", \"code\": "))
    let c = lv_code_for(msg_p)
    if (c != 0) {
        _json_str(c)
    } else {
        fprintf(_stderr(), cstr("null"))
    }
    fprintf(_stderr(), cstr(", \"file\": "))
    if (m != 0 and ld64(m + MOD_PATH) != 0) {
        _json_str(ld64(m + MOD_PATH))
    } else {
        fprintf(_stderr(), cstr("null"))
    }
    let col = band(shr(pos, 22), 4095)
    fprintf(_stderr(), cstr(", \"line\": %d, \"column\": %d, \"end_column\": %d, \"message\": "), band(pos, 4194303), col,
            col + band(shr(pos, 34), 4095))
    _json_str(msg_p)
    fprintf(_stderr(), cstr(", \"hint\": "))
    if (hint_p != 0) {
        _json_str(hint_p)
    } else {
        fprintf(_stderr(), cstr("null"))
    }
    fprintf(_stderr(), cstr(", \"stack\": ["))
    let depth = ld32(addr_of("lv_depth"))
    let i = depth
    while (i >= 1) {
        let fr = addr_of("lv_frames") + i * FRAME_SIZE
        let name = ld64(fr + 16)
        let fm = ld64(fr + 8)
        if (i != depth) {
            fprintf(_stderr(), cstr(", "))
        }
        fprintf(_stderr(), cstr("\{\"function\": "))
        if (name != 0) {
            _json_str(name)
        } else {
            fprintf(_stderr(), cstr("null"))
        }
        fprintf(_stderr(), cstr(", \"line\": %d, \"file\": "), band(ld64(fr), 4194303))
        if (fm != 0 and ld64(fm + MOD_PATH) != 0) {
            _json_str(ld64(fm + MOD_PATH))
        } else {
            fprintf(_stderr(), cstr("null"))
        }
        fprintf(_stderr(), cstr("}"))
        i -= 1
    }
    fprintf(_stderr(), cstr("]}\n"))
}

func lv_error(kind_i, msg_p, hint_p) {
    fflush(_stdout())
    if (_json_wanted()) {
        _error_json(kind_i, msg_p, hint_p)
        exit(1)
    }
    let m = ld64(addr_of("lv_pos_mod"))
    let pos = ld64(addr_of("lv_pos"))
    fprintf(_stderr(), cstr("%s"), _err_name(kind_i))
    _put_code(msg_p)
    if (m != 0 and ld64(m + MOD_PATH) != 0) {
        fprintf(_stderr(), cstr(" in %s"), ld64(m + MOD_PATH))
    }
    fprintf(_stderr(), cstr(" at line %d:\n  %s\n"), band(pos, 4194303), msg_p)
    _error_source(pos)
    if (hint_p != 0) {
        fprintf(_stderr(), cstr("Hint: %s\n"), hint_p)
    }
    _print_stack()
    exit(1)
}

# The same, with text next to the marks: main beside the carets; l and r under the left and the right
# operand of an operator.
func lv_error_labeled(kind_i, msg_p, hint_p, main_p, l_p, r_p) {
    st64(addr_of("lv_lab_main"), main_p)
    st64(addr_of("lv_lab_l"), l_p)
    st64(addr_of("lv_lab_r"), r_p)
    lv_error(kind_i, msg_p, hint_p)
}

# printf-style errors with up to four arguments (strings or integers).
func _errf4(kind, hint, fmt, a, b, c, d) {
    let msg = stack_buf(512)
    snprintf(msg, 512, fmt, a, b, c, d)
    lv_error(kind, msg, hint)
}

func _errf(kind, hint, fmt, a, b, c) {
    _errf4(kind, hint, fmt, a, b, c, 0)
}

func lv_undefined(name) {
    _errf(E_NAME, cstr("Declare variables with 'let' before using them"), cstr("Variable '%s' is not defined"), name, 0, 0)
}

func _type_name(v) {
    let t = _tag(v)
    if (t == T_NULL) {
        return cstr("null")
    }
    if (t == T_BOOL) {
        return cstr("boolean")
    }
    if (t == T_INT) {
        return cstr("int")
    }
    if (t == T_FLOAT) {
        return cstr("float")
    }
    if (t == T_CHAR) {
        return cstr("char")
    }
    if (t == T_STR) {
        return cstr("string")
    }
    if (t == T_LIST or t == T_DENSE) {
        return cstr("list")
    }
    if (t == T_MAP) {
        return cstr("map")
    }
    if (t >= T_BLOC_TYPE and t <= T_PTR) {
        return _data_type_name(v)
    }
    if (t == T_FUNC) {
        if (ld32(_val(v) + F_NATIVE) != 0) {
            return cstr("native_function")
        }
        return cstr("function")
    }
    if (t == T_THREAD) {
        return cstr("thread")
    }
    if (t == T_CHAN) {
        return cstr("channel")
    }
    if (t == T_FILE) {
        return cstr("file")
    }
    if (t == T_UNDEF) {
        return cstr("undefined")
    }
    return cstr("unknown")
}

# Constructors

func _str_n(o, s, n) {
    let st = lv_alloc_atomic(S_DATA + n + 1)
    st64(st, n)
    if (n != 0) {
        memcpy(st + S_DATA, s, n)
    }
    st8(st + S_DATA + n, 0)
    _set(o, T_STR, st)
}

func _str(o, s) {
    _str_n(o, s, strlen(s))
}

func lv_str_n(s, n) {
    let o = stack_buf(16)
    _str_n(o, s, n)
    retp(o)
}

func _list_new(o, cap) {
    if (ugt(cap, 4398046511104)) {
        _die_oom()
    }
    let c = cap
    if (c < 4) {
        c = 4
    }
    # A small list whose size is known keeps its items in the same object as its header: one allocation, not
    # two. The items pointer then points into the object (the collector follows interior pointers). When the
    # list outgrows this space _list_push moves the items to an object of their own, and the space inside is
    # dead weight. An empty list (cap 0) is one that will be filled by appending, and usually grows past the
    # first items, so it keeps its items apart: a row of 8 appended items took 256 bytes inline against 176.
    let l = 0
    if (cap != 0 and 16 * c <= LIST_INLINE_BYTES) {
        l = lv_alloc(L_SIZE + 16 * c)
        st64(l + L_ITEMS, l + L_SIZE)
    } else {
        l = lv_alloc(L_SIZE)
        st64(l + L_ITEMS, lv_alloc(16 * c))
    }
    st64(l + L_COUNT, 0)
    st64(l + L_CAP, c)
    _set(o, T_LIST, l)
}

func lv_list_new(cap) {
    let o = stack_buf(16)
    _list_new(o, cap)
    retp(o)
}

func _list_of(o, n_i, items) {
    _list_new(o, n_i)
    let l = _val(o)
    if (n_i != 0) {
        memcpy(ld64(l + L_ITEMS), items, 16 * n_i)
    }
    st64(l + L_COUNT, n_i)
}

func lv_list_of(n_i, items) {
    let o = stack_buf(16)
    _list_of(o, n_i, items)
    retp(o)
}

# Appends the LV at v to the list at list.
func _list_push(list, v) {
    let l = _val(list)
    if (ld64(l + L_COUNT) == ld64(l + L_CAP)) {
        st64(l + L_CAP, ld64(l + L_CAP) * 2)
        # Not lv_realloc: the items may sit inside the header object, and then they are not an object.
        let grown = lv_alloc(16 * ld64(l + L_CAP))
        memcpy(grown, ld64(l + L_ITEMS), 16 * ld64(l + L_COUNT))
        if (ld64(l + L_ITEMS) == l + L_SIZE) {
            lv_wb_word(l + L_ITEMS)
            lv_wb_range(l + L_SIZE, 16 * ld64(l + L_COUNT))    # the elements are still reachable from the new items
            memset(l + L_SIZE, 0, 16 * ld64(l + L_COUNT))    # the old inline slots must not keep elements alive
        } else {
            lv_wb_word(l + L_ITEMS)
        }
        st64(l + L_ITEMS, grown)
    }
    _cp(ld64(l + L_ITEMS) + 16 * ld64(l + L_COUNT), v)
    st64(l + L_COUNT, ld64(l + L_COUNT) + 1)
}

func _map_new(o) {
    let m = lv_alloc(M_SIZE)
    st64(m + M_COUNT, 0)
    st64(m + M_USED, 0)
    st64(m + M_CAP, 8)
    st64(m + M_ENTRIES, lv_alloc(E_SIZE * 8))
    st64(m + M_ICAP, 16)
    st64(m + M_INDEX, lv_alloc_atomic(8 * 16))
    _set(o, T_MAP, m)
}

func lv_map_new() {
    let o = stack_buf(16)
    _map_new(o)
    retp(o)
}

func _dense_new(o, n) {
    if (ugt(n, 4398046511104)) {
        _die_oom()
    }
    let d = lv_alloc(D_SIZE)
    st64(d + D_COUNT, n)
    let cap = n
    if (cap < 1) {
        cap = 1
    }
    st64(d + D_CAP, cap)
    st64(d + D_DATA, lv_alloc_atomic(8 * cap))
    _set(o, T_DENSE, d)
}

func _closure(o, fn, name, ncells_i, cells) {
    let f = lv_alloc(F_SIZE)
    st64(f + F_FN, fn)
    st64(f + F_NAME, name)
    st32(f + F_NATIVE, 0)
    st32(f + F_NCELLS, ncells_i)
    st64(f + F_CELLS, 0)
    if (ncells_i > 0) {
        st64(f + F_CELLS, lv_alloc(8 * ncells_i))
        memcpy(ld64(f + F_CELLS), cells, 8 * ncells_i)
    }
    _set(o, T_FUNC, f)
}

func lv_closure(fn, name, ncells_i, cells) {
    let o = stack_buf(16)
    _closure(o, fn, name, ncells_i, cells)
    retp(o)
}

func lv_native(fn, name) {
    let o = stack_buf(16)
    _closure(o, fn, name, 0, 0)
    st32(_val(o) + F_NATIVE, 1)
    retp(o)
}

# A heap cell holding a copy of the LV at init: how closures share a captured variable.
func lvp_cell(init) {
    let c = lv_alloc(16)
    _cp(c, init)
    return c
}

# Maps

func _hash(s, n) {
    let h = 1469598103934665603
    for (let i = 0; i < n; i++) {
        h = bxor(h, ld8(s + i))
        h = h * 1099511628211
    }
    return h
}

func _str_same(a, b) {
    if (a == b) {
        return 1
    }
    if (ld64(a) != ld64(b)) {
        return 0
    }
    if (ld64(a) == 0) {
        return 1
    }
    if (ld8(a + S_DATA) != ld8(b + S_DATA)) {
        return 0
    }
    return memcmp(a + S_DATA, b + S_DATA, ld64(a)) == 0
}

# The hash slot holding key, or the slot to insert it into; g_found says which.
func _map_slot(m, key) {
    let mask = ld64(m + M_ICAP) - 1
    let i = band(_hash(key + S_DATA, ld64(key)), mask)
    let index = ld64(m + M_INDEX)
    let tomb = -1
    while (true) {
        let e = index[i]
        if (e == 0) {
            g_found = 0
            if (tomb >= 0) {
                return tomb
            }
            return i
        }
        if (e == -1) {
            if (tomb < 0) {
                tomb = i
            }
        } else if (_str_same(ld64(ld64(m + M_ENTRIES) + (e - 1) * E_SIZE + E_KEY), key)) {
            g_found = 1
            return i
        }
        i = band(i + 1, mask)
    }
}

func _map_rehash(m) {
    # Compact live entries, then rebuild the index.
    let entries = ld64(m + M_ENTRIES)
    lv_wb_range(entries, E_SIZE * ld64(m + M_USED))    # live entries move down over dead ones
    let w = 0
    for (let r = 0; r < ld64(m + M_USED); r++) {
        if (ld32(entries + r * E_SIZE + E_LIVE) != 0) {
            if (w != r) {
                memcpy(entries + w * E_SIZE, entries + r * E_SIZE, E_SIZE)
            }
            w++
        }
    }
    st64(m + M_USED, w)
    while (ld64(m + M_ICAP) < (ld64(m + M_COUNT) + 1) * 2) {
        st64(m + M_ICAP, ld64(m + M_ICAP) * 2)
    }
    let fresh = lv_alloc_atomic(8 * ld64(m + M_ICAP))
    lv_wb_word(m + M_INDEX)
    st64(m + M_INDEX, fresh)
    for (let e = 0; e < w; e++) {
        let slot = _map_slot(m, ld64(entries + e * E_SIZE + E_KEY))
        let index = ld64(m + M_INDEX)
        index[slot] = e + 1
    }
}

# Writes the value of key to o (null when missing); g_found tells whether it was there.
func _map_get(o, map, key) {
    let m = _val(map)
    let slot = _map_slot(m, key)
    if (g_found == 0) {
        _null(o)
        return 0
    }
    let index = ld64(m + M_INDEX)
    _cp(o, ld64(m + M_ENTRIES) + (index[slot] - 1) * E_SIZE + E_VAL)
}

func _map_put(map, key, val) {
    let m = _val(map)
    let slot = _map_slot(m, key)
    let index = ld64(m + M_INDEX)
    if (g_found != 0) {
        _cp(ld64(m + M_ENTRIES) + (index[slot] - 1) * E_SIZE + E_VAL, val)
        return 0
    }
    if (ld64(m + M_USED) == ld64(m + M_CAP)) {
        if (ld64(m + M_COUNT) < ld64(m + M_USED) / 2) {
            _map_rehash(m)
        } else {
            st64(m + M_CAP, ld64(m + M_CAP) * 2)
            let grown = lv_realloc(ld64(m + M_ENTRIES), E_SIZE * ld64(m + M_CAP))
            lv_wb_word(m + M_ENTRIES)
            st64(m + M_ENTRIES, grown)
        }
        slot = _map_slot(m, key)
        index = ld64(m + M_INDEX)
    }
    let e = ld64(m + M_ENTRIES) + ld64(m + M_USED) * E_SIZE
    lv_wb_word(e + E_KEY)
    st64(e + E_KEY, key)
    _cp(e + E_VAL, val)
    st32(e + E_LIVE, 1)
    st64(m + M_USED, ld64(m + M_USED) + 1)
    st64(m + M_COUNT, ld64(m + M_COUNT) + 1)
    index[slot] = ld64(m + M_USED)
    if (ld64(m + M_USED) * 2 > ld64(m + M_ICAP)) {
        _map_rehash(m)
    }
}

func _map_del(map, key) {
    let m = _val(map)
    let slot = _map_slot(m, key)
    if (g_found == 0) {
        return 0
    }
    let index = ld64(m + M_INDEX)
    st32(ld64(m + M_ENTRIES) + (index[slot] - 1) * E_SIZE + E_LIVE, 0)
    index[slot] = -1
    st64(m + M_COUNT, ld64(m + M_COUNT) - 1)
    return 1
}

# Strings

func _buf_init(b) {
    st64(b + B_CAP, 64)
    st64(b + B_LEN, 0)
    st64(b + B_BUF, lv_alloc_atomic(64))
}

func _buf_add(b, s, n) {
    if (ugt(n, 70368744177664) or ugt(ld64(b + B_LEN) + n, 70368744177664)) {
        _die_oom()
    }
    if (ld64(b + B_LEN) + n + 1 > ld64(b + B_CAP)) {
        while (ld64(b + B_LEN) + n + 1 > ld64(b + B_CAP)) {
            st64(b + B_CAP, ld64(b + B_CAP) * 2)
        }
        st64(b + B_BUF, lv_realloc(ld64(b + B_BUF), ld64(b + B_CAP)))
    }
    memcpy(ld64(b + B_BUF) + ld64(b + B_LEN), s, n)
    st64(b + B_LEN, ld64(b + B_LEN) + n)
}

func _buf_cstr(b, s) {
    _buf_add(b, s, strlen(s))
}

# The text of the double whose bits are f, printed like %.6g, with ".0" added when the text has
# neither a point nor an exponent, so that a float never prints like an int (see _float_text).
func _buf_float(b, f) {
    let tmp = stack_buf(64)
    _float_text(tmp, f, 6)
    _buf_cstr(b, tmp)
}

# Writes into tmp (64 bytes) the text of the double whose bits are f with that many significant
# digits (1 to 17), in the %g style.
func _float_text(tmp, f, digits) {
    let fmt = stack_buf(16)
    snprintf(fmt, 16, cstr("%%.%dg"), digits)
    snprintf(tmp, 64, fmt, dbl(f))
    let p = tmp
    let plain = 1
    while (ld8(p) != 0) {
        if (ld8(p) == 46 or ld8(p) == 101) {
            plain = 0
        }
        p += 1
    }
    if (plain != 0) {
        st8(p, 46)
        st8(p + 1, 48)
        st8(p + 2, 0)
    }
}

# Writes the decimal text of the int v so that it ends just before end, and returns where it starts.
# The digits are taken as an unsigned number, so the smallest int needs no special case.
func _int_text(v, end) {
    let u = v
    let neg = 0
    if (v < 0) {
        neg = 1
        u = 0 - v
    }
    let p = end
    if (u == 0) {
        p -= 1
        st8(p, 48)
    }
    while (u != 0) {
        let q = udiv(u, 10)
        p -= 1
        st8(p, 48 + (u - q * 10))
        u = q
    }
    if (neg != 0) {
        p -= 1
        st8(p, 45)
    }
    return p
}

func _buf_value(b, v) {
    let tmp = stack_buf(64)
    let t = _tag(v)
    if (t == T_NULL) {
        _buf_cstr(b, cstr("null"))
    } else if (t == T_BOOL) {
        if (ld32(v + 8) != 0) {
            _buf_cstr(b, cstr("true"))
        } else {
            _buf_cstr(b, cstr("false"))
        }
    } else if (t == T_INT) {
        let at = _int_text(_val(v), tmp + 40)
        _buf_add(b, at, tmp + 40 - at)
    } else if (t == T_FLOAT) {
        _buf_float(b, _val(v))
    } else if (t == T_CHAR) {
        _buf_add(b, v + 8, 1)
    } else if (t == T_STR) {
        _buf_add(b, _val(v) + S_DATA, ld64(_val(v)))
    } else if (t == T_LIST) {
        let l = _val(v)
        _buf_cstr(b, cstr("["))
        for (let i = 0; i < ld64(l + L_COUNT); i++) {
            if (i != 0) {
                _buf_cstr(b, cstr(", "))
            }
            _buf_value(b, ld64(l + L_ITEMS) + 16 * i)
        }
        _buf_cstr(b, cstr("]"))
    } else if (t == T_MAP) {
        let m = _val(v)
        _buf_cstr(b, cstr("\{"))
        let first = 1
        for (let i = 0; i < ld64(m + M_USED); i++) {
            let e = ld64(m + M_ENTRIES) + i * E_SIZE
            if (ld32(e + E_LIVE) == 0) {
                continue
            }
            if (first == 0) {
                _buf_cstr(b, cstr(", "))
            }
            first = 0
            _buf_cstr(b, cstr("\""))
            _buf_add(b, ld64(e + E_KEY) + S_DATA, ld64(ld64(e + E_KEY)))
            _buf_cstr(b, cstr("\": "))
            _buf_value(b, e + E_VAL)
        }
        _buf_cstr(b, cstr("}"))
    } else if (t == T_DENSE) {
        let d = _val(v)
        _buf_cstr(b, cstr("d["))
        for (let i = 0; i < ld64(d + D_COUNT); i++) {
            if (i != 0) {
                _buf_cstr(b, cstr(", "))
            }
            _buf_float(b, ld64(ld64(d + D_DATA) + i * 8))
        }
        _buf_cstr(b, cstr("]"))
    } else if (t == T_THREAD) {
        _buf_cstr(b, cstr("<thread>"))
    } else if (t == T_CHAN) {
        _buf_cstr(b, cstr("<channel>"))
    } else if (t == T_FUNC) {
        if (ld32(_val(v) + F_NATIVE) != 0) {
            _buf_cstr(b, cstr("<native function>"))
        } else {
            _buf_cstr(b, cstr("<function>"))
        }
    } else if (t == T_FILE) {
        _buf_cstr(b, cstr("<file>"))
    } else if (t == T_UNDEF) {
        _buf_cstr(b, cstr("<undefined>"))
    } else {
        _data_tostring(b, v)
    }
}

# Finishes the buffer as a string value at o.
func _buf_done(o, b) {
    _str_n(o, ld64(b + B_BUF), ld64(b + B_LEN))
    st64(b + B_BUF, 0)
}

func _to_string(o, v) {
    if (_tag(v) == T_STR) {
        _cp(o, v)
        return 0
    }
    let b = stack_buf(B_SIZE)
    _buf_init(b)
    _buf_value(b, v)
    _buf_done(o, b)
}

func lv_interp(n_i, parts) {
    let b = stack_buf(B_SIZE)
    let o = stack_buf(16)
    # When every part is already a string, the result is built with one exact-size allocation.
    let total = 0
    let all_text = 1
    for (let i = 0; i < n_i; i++) {
        let part = parts + 16 * i
        if (_tag(part) != T_STR) {
            all_text = 0
            break
        }
        total += ld64(_val(part))
    }
    if (all_text != 0) {
        if (ugt(total, 70368744177664)) {
            _die_oom()
        }
        let st = lv_alloc_atomic(S_DATA + total + 1)
        st64(st, total)
        let at = st + S_DATA
        for (let i = 0; i < n_i; i++) {
            let src = _val(parts + 16 * i)
            let n = ld64(src)
            if (n != 0) {
                memcpy(at, src + S_DATA, n)
                at += n
            }
        }
        st8(at, 0)
        _set(o, T_STR, st)
        retp(o)
    }
    # Strings and ints (up to 8 parts, the usual "k{i}"): one exact-size allocation, no buffer to copy from.
    if (n_i <= 8) {
        let scratch = stack_buf(192)
        let starts = stack_buf(64)
        let sum = 0
        let simple = 1
        for (let i = 0; i < n_i; i++) {
            let part = parts + 16 * i
            if (_tag(part) == T_STR) {
                sum += ld64(_val(part))
            } else if (_tag(part) == T_INT) {
                let at = _int_text(_val(part), scratch + 24 * i + 24)
                st64(starts + 8 * i, at)
                sum += scratch + 24 * i + 24 - at
            } else {
                simple = 0
                break
            }
        }
        if (simple != 0) {
            if (ugt(sum, 70368744177664)) {
                _die_oom()
            }
            let st = lv_alloc_atomic(S_DATA + sum + 1)
            st64(st, sum)
            let at = st + S_DATA
            for (let i = 0; i < n_i; i++) {
                let part = parts + 16 * i
                if (_tag(part) == T_STR) {
                    let m = ld64(_val(part))
                    if (m != 0) {
                        memcpy(at, _val(part) + S_DATA, m)
                        at += m
                    }
                } else {
                    let from = ld64(starts + 8 * i)
                    let m = scratch + 24 * i + 24 - from
                    memcpy(at, from, m)
                    at += m
                }
            }
            st8(at, 0)
            _set(o, T_STR, st)
            retp(o)
        }
    }
    _buf_init(b)
    for (let i = 0; i < n_i; i++) {
        _buf_value(b, parts + 16 * i)
    }
    _buf_done(o, b)
    retp(o)
}

func lvp_print(v) {
    if (_tag(v) == T_STR) {
        fwrite(_val(v) + S_DATA, 1, ld64(_val(v)), _stdout())
        fputc(10, _stdout())
        return 0
    }
    let b = stack_buf(B_SIZE)
    _buf_init(b)
    _buf_value(b, v)
    _buf_add(b, cstr("\n"), 1)
    fwrite(ld64(b + B_BUF), 1, ld64(b + B_LEN), _stdout())
}
