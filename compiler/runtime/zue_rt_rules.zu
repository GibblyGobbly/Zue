#
# zue_rt_rules.zu: the validation rules behind data, template, bloc, box and unsafe blocks.
# The zue_data_* functions hold the bloc and template schemas, the box handle table and the
# containment rules. The zue_mem_* functions hold the allocation table and the ten pointer
# rules.
#
# Every rule is a function that returns 0 for "allowed" or a non-zero error code; the
# caller in zue_rt_data.zu turns the code into the runtime error with
# zue_data_error_message or zue_mem_error_message.

extern("memcpy", "ptr", "ptr,ptr,i64")
extern("strlen", "i64", "ptr")
extern("strcmp", "i32", "ptr,ptr")
extern("free", "void", "ptr")
extern("calloc", "ptr", "i64,i64")
extern("realloc", "ptr", "ptr,i64")

# Shared helpers

# A hash map from a word key to a non-zero word value (0 means "absent"). The record is
# { keys, vals, cap, count }; cap is a power of two and the table stays at most half full.
const HM_KEYS = 0
const HM_VALS = 8
const HM_CAP = 16
const HM_N = 24
const HM_SIZE = 32

func _rl_hash(key) {
    let h = key * 2654435761
    return bxor(h, shr(h, 29))
}

# The slot holding key, or the empty slot where it would go.
func _rl_hm_find(m, key) {
    let cap = ld64(m + HM_CAP)
    if (cap == 0) {
        return -1
    }
    let keys = ld64(m + HM_KEYS)
    let vals = ld64(m + HM_VALS)
    let i = band(_rl_hash(key), cap - 1)
    while (vals[i] != 0 and keys[i] != key) {
        i = band(i + 1, cap - 1)
    }
    return i
}

func _rl_hm_get(m, key) {
    let i = _rl_hm_find(m, key)
    if (i < 0) {
        return 0
    }
    let vals = ld64(m + HM_VALS)
    return vals[i]
}

func _rl_hm_grow(m) {
    let old_cap = ld64(m + HM_CAP)
    let old_keys = ld64(m + HM_KEYS)
    let old_vals = ld64(m + HM_VALS)
    let cap = 16
    if (old_cap != 0) {
        cap = old_cap * 2
    }
    st64(m + HM_CAP, cap)
    st64(m + HM_KEYS, calloc(cap, 8))
    st64(m + HM_VALS, calloc(cap, 8))
    let keys = ld64(m + HM_KEYS)
    let vals = ld64(m + HM_VALS)
    for (let j = 0; j < old_cap; j++) {
        if (old_vals[j] != 0) {
            let i = band(_rl_hash(old_keys[j]), cap - 1)
            while (vals[i] != 0) {
                i = band(i + 1, cap - 1)
            }
            keys[i] = old_keys[j]
            vals[i] = old_vals[j]
        }
    }
    if (old_cap != 0) {
        free(old_keys)
        free(old_vals)
    }
}

func _rl_hm_put(m, key, val) {
    if ((ld64(m + HM_N) + 1) * 2 > ld64(m + HM_CAP)) {
        _rl_hm_grow(m)
    }
    let i = _rl_hm_find(m, key)
    let keys = ld64(m + HM_KEYS)
    let vals = ld64(m + HM_VALS)
    if (vals[i] == 0) {
        keys[i] = key
        st64(m + HM_N, ld64(m + HM_N) + 1)
    }
    vals[i] = val
}

func _rl_hm_clear(m) {
    if (ld64(m + HM_CAP) != 0) {
        free(ld64(m + HM_KEYS))
        free(ld64(m + HM_VALS))
    }
    st64(m + HM_KEYS, 0)
    st64(m + HM_VALS, 0)
    st64(m + HM_CAP, 0)
    st64(m + HM_N, 0)
}

# Copies the message into buf as a NUL-terminated string cut to buf_len - 1 bytes.
func _rl_copy_message(msg, buf, buf_len) {
    if (buf == 0 or buf_len == 0) {
        return 0
    }
    let n = strlen(msg)
    if (ult(buf_len - 1, n)) {
        n = buf_len - 1
    }
    if (n > 0) {
        memcpy(buf, msg, n)
    }
    st8(buf + n, 0)
}

func _rl_dup(s) {
    let n = strlen(s)
    let p = calloc(n + 1, 1)
    memcpy(p, s, n)
    return p
}

# UTF-8 as a validating decoder accepts it. The length of the code point starting at p, or 0
# when the bytes there are not well-formed UTF-8.
func _rl_cp_len(p) {
    let b0 = ld8(p)
    if (b0 < 128) {
        return 1
    }
    let b1 = ld8(p + 1)
    if (b0 >= 194 and b0 <= 223) {
        if (b1 >= 128 and b1 <= 191) {
            return 2
        }
        return 0
    }
    if (b0 >= 224 and b0 <= 239) {
        let lo = 128
        let hi = 191
        if (b0 == 224) {
            lo = 160
        }
        if (b0 == 237) {
            hi = 159
        }
        if (b1 >= lo and b1 <= hi and ld8(p + 2) >= 128 and ld8(p + 2) <= 191) {
            return 3
        }
        return 0
    }
    if (b0 >= 240 and b0 <= 244) {
        let lo = 128
        let hi = 191
        if (b0 == 240) {
            lo = 144
        }
        if (b0 == 244) {
            hi = 143
        }
        if (b1 >= lo and b1 <= hi and ld8(p + 2) >= 128 and ld8(p + 2) <= 191 and ld8(p + 3) >= 128 and ld8(p + 3) <= 191) {
            return 4
        }
        return 0
    }
    return 0
}

func _rl_cp(p, n) {
    let b0 = ld8(p)
    if (n == 1) {
        return b0
    }
    if (n == 2) {
        return shl(band(b0, 31), 6) + band(ld8(p + 1), 63)
    }
    if (n == 3) {
        return shl(band(b0, 15), 12) + shl(band(ld8(p + 1), 63), 6) + band(ld8(p + 2), 63)
    }
    return shl(band(b0, 7), 18) + shl(band(ld8(p + 1), 63), 12) + shl(band(ld8(p + 2), 63), 6) + band(ld8(p + 3), 63)
}

# Unicode White_Space, the set str::trim removes.
func _rl_is_space(c) {
    if (c == 32 or (c >= 9 and c <= 13) or c == 133 or c == 160 or c == 5760) {
        return 1
    }
    if ((c >= 8192 and c <= 8202) or c == 8232 or c == 8233 or c == 8239 or c == 8287 or c == 12288) {
        return 1
    }
    return 0
}

# 1 when s is a non-null string of well-formed UTF-8 (CStr::to_str succeeded), else 0.
func _rl_utf8_ok(s) {
    if (s == 0) {
        return 0
    }
    let p = s
    while (ld8(p) != 0) {
        let n = _rl_cp_len(p)
        if (n == 0) {
            return 0
        }
        p = p + n
    }
    return 1
}

# 1 when s trims to the empty string.
func _rl_blank(s) {
    let p = s
    while (ld8(p) != 0) {
        let n = _rl_cp_len(p)
        if (_rl_is_space(_rl_cp(p, n)) == 0) {
            return 0
        }
        p = p + n
    }
    return 1
}

# A usable name: valid UTF-8 and not blank.
func _rl_name_ok(s) {
    return _rl_utf8_ok(s) != 0 and _rl_blank(s) == 0
}

# The field names of a C array that are valid UTF-8, as a calloc'd block { n, name... }.
func _rl_collect_fields(fields, count) {
    if (fields == 0 or count <= 0) {
        return calloc(1, 8)
    }
    let out = calloc(count + 1, 8)
    let n = 0
    for (let i = 0; i < count; i++) {
        let f = ld64(fields + i * 8)
        if (_rl_utf8_ok(f) != 0) {
            n += 1
            out[n] = f
        }
    }
    out[0] = n
    return out
}

# The index (1-based) of the first field equal to an earlier one, or 0.
func _rl_duplicate_field(list) {
    let n = list[0]
    for (let i = 2; i <= n; i++) {
        for (let j = 1; j < i; j++) {
            if (strcmp(list[i], list[j]) == 0) {
                return i
            }
        }
    }
    return 0
}

# Data runtime: error codes and text

const DERR_BLOC_EMPTY_NAME = 1
const DERR_BLOC_DUPLICATE_FIELD = 2
const DERR_BLOC_OVERSIZE = 3
const DERR_BOX_INVALID_SIZE = 4
const DERR_BOX_USE_AFTER_FREE = 5
const DERR_BOX_NOT_LIVE = 6
const DERR_TEMPLATE_EMPTY_NAME = 7
const DERR_TEMPLATE_DUPLICATE_FIELD = 8
const DERR_TEMPLATE_DUPLICATE_SCHEMA = 9
const DERR_TEMPLATE_ARITY = 10
const DERR_TEMPLATE_UNKNOWN_FIELD = 11
const DERR_CONTAINMENT = 12

const BLOC_MAX_INLINE_BYTES = 64
const BOX_MAX_BYTES = 16777216
const KIND_BLOC = 1
const KIND_BOX = 2
const KIND_TEMPLATE = 3

func _rl_data_message(code) {
    if (code == 0) {
        return cstr("ok")
    }
    if (code == DERR_BLOC_EMPTY_NAME) {
        return cstr("bloc name cannot be empty")
    }
    if (code == DERR_BLOC_DUPLICATE_FIELD) {
        return cstr("bloc has duplicate field names")
    }
    if (code == DERR_BLOC_OVERSIZE) {
        return cstr("bloc exceeds the cache-line size limit (64 bytes)")
    }
    if (code == DERR_BOX_INVALID_SIZE) {
        return cstr("box size must be between 1 and 16777216 bytes")
    }
    if (code == DERR_BOX_USE_AFTER_FREE) {
        return cstr("box was already freed (use-after-free)")
    }
    if (code == DERR_BOX_NOT_LIVE) {
        return cstr("box is not live")
    }
    if (code == DERR_TEMPLATE_EMPTY_NAME) {
        return cstr("template name cannot be empty")
    }
    if (code == DERR_TEMPLATE_DUPLICATE_FIELD) {
        return cstr("template has duplicate field names")
    }
    if (code == DERR_TEMPLATE_DUPLICATE_SCHEMA) {
        return cstr("template with this name is already registered")
    }
    if (code == DERR_TEMPLATE_ARITY) {
        return cstr("template constructor argument count does not match field count")
    }
    if (code == DERR_TEMPLATE_UNKNOWN_FIELD) {
        return cstr("template does not have a field with that name")
    }
    if (code == DERR_CONTAINMENT) {
        return cstr("containment hierarchy violation: type cannot be stored inside this tier")
    }
    return cstr("unknown data runtime error")
}

func zue_data_error_message(code, buf, buf_len) {
    _rl_copy_message(_rl_data_message(code), buf, buf_len)
}

# Data runtime: state

space("rl_box_map", 32)
# Template schemas { next, name, nfields, fields } in a list, newest first.
const TS_NEXT = 0
const TS_NAME = 8
const TS_NFIELDS = 16
const TS_FIELDS = 24
const TS_SIZE = 32
let rl_schemas = 0

func zue_data_init() {
    _rl_hm_clear(addr_of("rl_box_map"))
    let s = rl_schemas
    while (s != 0) {
        let next = ld64(s + TS_NEXT)
        let n = ld64(s + TS_NFIELDS)
        for (let i = 0; i < n; i++) {
            free(ld64(ld64(s + TS_FIELDS) + i * 8))
        }
        free(ld64(s + TS_FIELDS))
        free(ld64(s + TS_NAME))
        free(s)
        s = next
    }
    rl_schemas = 0
}

func _rl_schema_find(name) {
    let s = rl_schemas
    while (s != 0) {
        if (strcmp(ld64(s + TS_NAME), name) == 0) {
            return s
        }
        s = ld64(s + TS_NEXT)
    }
    return 0
}

# Data runtime: bloc, box, template rules

# Name not blank, no duplicate fields, and the fields (8 bytes each, the worst case) fit in 64
# bytes (BLOC_MAX_INLINE_BYTES). Duplicates are checked before the size at each field, as the layout builder did.
func zue_data_bloc_validate(name, fields, count) {
    if (_rl_name_ok(name) == 0) {
        return DERR_BLOC_EMPTY_NAME
    }
    let list = _rl_collect_fields(fields, count)
    let n = list[0]
    let size = 0
    for (let i = 1; i <= n; i++) {
        for (let j = 1; j < i; j++) {
            if (strcmp(list[i], list[j]) == 0) {
                free(list)
                return DERR_BLOC_DUPLICATE_FIELD
            }
        }
        size += 8
        if (size > BLOC_MAX_INLINE_BYTES) {
            free(list)
            return DERR_BLOC_OVERSIZE
        }
    }
    free(list)
    return 0
}

func zue_data_box_size_ok(size) {
    if (size == 0 or ugt(size, BOX_MAX_BYTES)) {
        return DERR_BOX_INVALID_SIZE
    }
    return 0
}

# A handle's state in the table: 1 live, 2 freed, 0 unknown.
func zue_data_box_track(handle) {
    _rl_hm_put(addr_of("rl_box_map"), handle, 1)
}

func zue_data_box_access_ok(handle) {
    let st = _rl_hm_get(addr_of("rl_box_map"), handle)
    if (st == 1) {
        return 0
    }
    if (st == 2) {
        return DERR_BOX_USE_AFTER_FREE
    }
    return DERR_BOX_NOT_LIVE
}

func zue_data_box_free_ok(handle) {
    let m = addr_of("rl_box_map")
    let st = _rl_hm_get(m, handle)
    if (st == 1) {
        _rl_hm_put(m, handle, 2)
        return 0
    }
    if (st == 2) {
        return DERR_BOX_USE_AFTER_FREE
    }
    return DERR_BOX_NOT_LIVE
}

# Validates a template schema and registers it. Registering a name again is allowed and
# keeps the first schema.
func zue_data_template_register(name, fields, count) {
    if (_rl_name_ok(name) == 0) {
        return DERR_TEMPLATE_EMPTY_NAME
    }
    let list = _rl_collect_fields(fields, count)
    if (_rl_duplicate_field(list) != 0) {
        free(list)
        return DERR_TEMPLATE_DUPLICATE_FIELD
    }
    if (_rl_schema_find(name) == 0) {
        let n = list[0]
        let s = calloc(1, TS_SIZE)
        st64(s + TS_NAME, _rl_dup(name))
        st64(s + TS_NFIELDS, n)
        st64(s + TS_FIELDS, calloc(n + 1, 8))
        for (let i = 0; i < n; i++) {
            st64(ld64(s + TS_FIELDS) + i * 8, _rl_dup(list[i + 1]))
        }
        st64(s + TS_NEXT, rl_schemas)
        rl_schemas = s
    }
    free(list)
    return 0
}

# A constructor call with got arguments against the registered schema. Unregistered names pass.
func zue_data_template_arity_ok(name, got) {
    if (_rl_utf8_ok(name) == 0) {
        return DERR_TEMPLATE_EMPTY_NAME
    }
    let s = _rl_schema_find(name)
    if (s == 0 or ld64(s + TS_NFIELDS) == got) {
        return 0
    }
    return DERR_TEMPLATE_ARITY
}

# A field name against the registered schema. Unregistered names pass.
func zue_data_template_field_ok(name, field) {
    if (_rl_utf8_ok(name) == 0) {
        return DERR_TEMPLATE_EMPTY_NAME
    }
    if (_rl_utf8_ok(field) == 0) {
        return DERR_TEMPLATE_UNKNOWN_FIELD
    }
    let s = _rl_schema_find(name)
    if (s == 0) {
        return 0
    }
    let n = ld64(s + TS_NFIELDS)
    for (let i = 0; i < n; i++) {
        if (strcmp(ld64(ld64(s + TS_FIELDS) + i * 8), field) == 0) {
            return 0
        }
    }
    return DERR_TEMPLATE_UNKNOWN_FIELD
}

# Containment, what a type may hold: a box holds nothing, a bloc may hold a box, a template may hold a bloc, a box
# or another template (a reference to it).
func zue_data_containment_ok(outer, inner) {
    if (outer == KIND_TEMPLATE and (inner == KIND_BLOC or inner == KIND_BOX or inner == KIND_TEMPLATE)) {
        return 0
    }
    if (outer == KIND_BLOC and inner == KIND_BOX) {
        return 0
    }
    return DERR_CONTAINMENT
}


# Unsafe runtime: error codes and text

const MERR_POINTER_TO_POINTER = 1
const MERR_ESCAPE = 2
const MERR_OUT_OF_BOUNDS = 3
const MERR_USE_AFTER_FREE = 4
const MERR_ADDR_TEMPORARY = 5
const MERR_NESTED_UNSAFE = 6    # not raised here: the compiler rejects an unsafe block written inside another (R6)
const MERR_GC_STORE = 7
const MERR_ALLOC_SIZE = 8
const MERR_CMP_BASE = 9
const MERR_CAST = 10
const MERR_CALL = 11            # not raised: any function may be called inside unsafe
const MERR_LEAK = 12
const MERR_UNKNOWN_POINTER = 13
const MERR_OBJECT_OFFSET = 14
const MERR_FREE_INTERIOR = 15
const MERR_FREE_NOT_ALLOC = 16
const MERR_DEFERRED = 17
const MERR_ALLOC_TOO_LARGE = 18
const MERR_STORE_POINTER = 19
const MERR_UNWRITTEN = 20
const MERR_TOO_MANY = 21

func _rl_mem_message(code) {
    if (code == 0) {
        return cstr("ok")
    }
    if (code == MERR_POINTER_TO_POINTER) {
        return cstr("cannot take address_of() of a pointer value")
    }
    if (code == MERR_ESCAPE) {
        return cstr("pointer cannot escape the current unsafe block")
    }
    if (code == MERR_OUT_OF_BOUNDS) {
        return cstr("ptr_add() moved outside the allocation bounds")
    }
    if (code == MERR_USE_AFTER_FREE) {
        return cstr("pointer was freed or freed twice")
    }
    if (code == MERR_ADDR_TEMPORARY) {
        return cstr("address_of() only works on named values")
    }
    if (code == MERR_GC_STORE) {
        return cstr("pointers cannot be stored inside GC-managed values")
    }
    if (code == MERR_ALLOC_SIZE) {
        return cstr("alloc() size must be a positive integer")
    }
    if (code == MERR_CMP_BASE) {
        return cstr("ordered pointer comparisons need the same base allocation")
    }
    if (code == MERR_CAST) {
        return cstr("pointers may only be cast to int")
    }
    if (code == MERR_LEAK) {
        return cstr("memory from alloc() was not freed before the unsafe block ended")
    }
    if (code == MERR_UNKNOWN_POINTER) {
        return cstr("unsafe error: pointer is not registered in the runtime")
    }
    if (code == MERR_OBJECT_OFFSET) {
        return cstr("ptr_add() cannot move a pointer to an object made with alloc()")
    }
    if (code == MERR_FREE_INTERIOR) {
        return cstr("free() needs the pointer that alloc() returned, not one moved with ptr_add()")
    }
    if (code == MERR_FREE_NOT_ALLOC) {
        return cstr("only memory from alloc() can be freed: this pointer comes from address_of()")
    }
    if (code == MERR_DEFERRED) {
        return cstr("pointer was already given to defer() and is freed when the block ends")
    }
    if (code == MERR_ALLOC_TOO_LARGE) {
        return cstr("alloc() size is more than 4294967295 slots")
    }
    if (code == MERR_STORE_POINTER) {
        return cstr("pointers cannot be stored in memory from alloc()")
    }
    if (code == MERR_UNWRITTEN) {
        return cstr("load() of a pointer slot that was never written")
    }
    if (code == MERR_TOO_MANY) {
        return cstr("unsafe error: more than 2147483647 pointers were made in one unsafe block")
    }
    return cstr("unsafe error: unknown runtime error")
}

func zue_mem_error_message(code, buf, buf_len) {
    _rl_copy_message(_rl_mem_message(code), buf, buf_len)
}

# Unsafe runtime: allocation table

# One entry per allocation made since the outermost unsafe block began: memory from alloc(), an object
# copied by alloc(object), or a variable named by address_of().
#
# A pointer value is (number << 32) | slot. The number names an entry; the slot counts 16-byte slots
# from the start of the entry's memory. A number is never given out twice while a block runs, so a freed
# allocation stays freed even when malloc hands its address out again; numbers also go on from one
# outermost block to the next, so a pointer from an earlier block is not mistaken for a new one.
#
# The entries are in number order. Those made since the last compaction have consecutive numbers and are
# found by arithmetic; those that survived a compaction are found through rl_num_map.
const AE_NUM = 0        # the number of the entry
const AE_BASE = 8       # address of the memory
const AE_CELLS = 16     # number of 16-byte slots
const AE_STATE = 24     # AS_LIVE, AS_DEFERRED or AS_FREED (AS_SEEN while compacting)
const AE_KIND = 32      # AK_ALLOC, AK_ADDR, AK_TEMPLATE or AK_BLOC
const AE_FLAGS = 40     # alloc only: one byte per slot, 1 once the slot was written
const AE_LINE = 48      # line of the alloc() call
const AE_DEPTH = 56     # address_of() of a local on the stack: the call depth of its function; -1 otherwise
const AE_BYTES = 64

const AK_ALLOC = 1
const AK_ADDR = 2
const AK_TEMPLATE = 3
const AK_BLOC = 4

const AS_LIVE = 0
const AS_DEFERRED = 1
const AS_FREED = 2
const AS_SEEN = 3       # freed, but a pointer to it was found on the stack

const RL_LAST_NUMBER = 4294967295
const RL_RESTART = 2147483648
const RL_SLOT_MASK = 4294967295
const RL_COMPACT_MIN = 1024

# address_of() of the same variable twice in one block gives the same pointer: slot address -> number.
space("rl_addr_map", 32)
# number -> index + 1, for the entries that survived a compaction
space("rl_num_map", 32)
let rl_entries = 0
let rl_entry_n = 0
let rl_entry_cap = 0
let rl_freed = 0
let rl_next = 1         # the number the next entry gets
let rl_first = 1        # the first number of the running outermost block
let rl_tail_idx = 0     # entries from this index on have consecutive numbers ...
let rl_tail_num = 1     # ... starting with this one
# Deferred frees: entry numbers, the newest last.
let rl_defers = 0
let rl_defer_n = 0
let rl_defer_cap = 0
# Per open block: the number of pending deferred frees and the next entry number when it began.
let rl_inside = 0
let rl_marks = 0
let rl_mark_cap = 0

func _rl_reset_table() {
    _rl_hm_clear(addr_of("rl_addr_map"))
    _rl_hm_clear(addr_of("rl_num_map"))
    rl_entry_n = 0
    rl_freed = 0
    rl_first = rl_next
    rl_tail_idx = 0
    rl_tail_num = rl_next
    rl_defer_n = 0
}

func zue_mem_init() {
    rl_next = 1
    rl_inside = 0
    _rl_reset_table()
}

# A new entry; returns its pointer value (slot 0), or 0 when the table cannot grow.
func zue_mem_new(base, cells, kind, line, depth) {
    if (rl_next > RL_LAST_NUMBER) {
        return 0
    }
    if (rl_entry_n == rl_entry_cap) {
        let cap = 64
        if (rl_entry_cap != 0) {
            cap = rl_entry_cap * 2
        }
        let grown = realloc(rl_entries, cap * AE_BYTES)
        if (grown == 0) {
            return 0
        }
        rl_entries = grown
        rl_entry_cap = cap
    }
    let e = rl_entries + rl_entry_n * AE_BYTES
    st64(e + AE_NUM, rl_next)
    st64(e + AE_BASE, base)
    st64(e + AE_CELLS, cells)
    st64(e + AE_STATE, AS_LIVE)
    st64(e + AE_KIND, kind)
    st64(e + AE_FLAGS, 0)
    st64(e + AE_LINE, line)
    st64(e + AE_DEPTH, depth)
    rl_entry_n += 1
    rl_next += 1
    return shl(rl_next - 1, 32)
}

# The entry with this number, or 0.
func _rl_by_num(num) {
    if (num >= rl_tail_num and num < rl_next) {
        return rl_entries + (rl_tail_idx + num - rl_tail_num) * AE_BYTES
    }
    if (num < rl_first or num >= rl_tail_num) {
        return 0
    }
    let found = _rl_hm_get(addr_of("rl_num_map"), num)
    if (found == 0) {
        return 0
    }
    return rl_entries + (found - 1) * AE_BYTES
}

# The entry a pointer value names, or 0 when it names none (a forged value, one from an earlier block, or
# one whose freed entry was dropped by a compaction).
func zue_mem_entry(p) {
    let e = _rl_by_num(shr(p, 32))
    if (e == 0 or uge(band(p, RL_SLOT_MASK), ld64(e + AE_CELLS))) {
        return 0
    }
    return e
}

func zue_mem_slot(p) {
    return band(p, RL_SLOT_MASK)
}

# The address of the slot a valid pointer value points at.
func zue_mem_address(p) {
    let e = zue_mem_entry(p)
    if (e == 0) {
        return 0
    }
    return ld64(e + AE_BASE) + band(p, RL_SLOT_MASK) * 16
}

func zue_mem_kind(p) {
    let e = zue_mem_entry(p)
    if (e == 0) {
        return 0
    }
    return ld64(e + AE_KIND)
}

# The pointer value for address_of() of the slot at addr, if this block already made one, else 0.
func zue_mem_find_addr(addr) {
    let n = _rl_hm_get(addr_of("rl_addr_map"), addr)
    if (n == 0) {
        return 0
    }
    let e = _rl_by_num(n)
    if (e == 0 or ld64(e + AE_BASE) != addr) {
        return 0
    }
    return shl(n, 32)
}

func zue_mem_remember_addr(addr, p) {
    _rl_hm_put(addr_of("rl_addr_map"), addr, shr(p, 32))
}

# Compaction. A long block that allocates and frees would keep one entry per allocation. When the table is
# full and at least half of it is freed, the caller scans the words of the running stack with
# zue_mem_note_ref (a pointer can be nowhere else: R2 keeps it out of the heap, globals, captured variables,
# threads and channels) and zue_mem_compact drops the freed entries that no word names. A pointer the scan
# missed then names no entry: it is reported as not registered, and never mistaken for another allocation.
func zue_mem_compact_wanted() {
    return rl_entry_n == rl_entry_cap and rl_entry_n >= RL_COMPACT_MIN and rl_freed * 2 >= rl_entry_n
}

func zue_mem_note_ref(w) {
    let e = _rl_by_num(shr(w, 32))
    if (e != 0 and ld64(e + AE_STATE) == AS_FREED) {
        st64(e + AE_STATE, AS_SEEN)
    }
}

func zue_mem_compact() {
    let j = 0
    for (let i = 0; i < rl_entry_n; i++) {
        let e = rl_entries + i * AE_BYTES
        let state = ld64(e + AE_STATE)
        if (state == AS_FREED) {
            rl_freed -= 1
        } else {
            if (state == AS_SEEN) {
                st64(e + AE_STATE, AS_FREED)
            }
            if (j != i) {
                memcpy(rl_entries + j * AE_BYTES, e, AE_BYTES)
            }
            j += 1
        }
    }
    rl_entry_n = j
    rl_tail_idx = j
    rl_tail_num = rl_next
    _rl_hm_clear(addr_of("rl_num_map"))
    for (let i = 0; i < j; i++) {
        _rl_hm_put(addr_of("rl_num_map"), ld64(rl_entries + i * AE_BYTES + AE_NUM), i + 1)
    }
    return j
}

func zue_mem_entry_count() {
    return rl_entry_n
}

# Unsafe runtime: rules

# A function with its own unsafe block can be called from inside another one, so blocks nest at
# run time (an unsafe block written inside another is rejected by the compiler, rule R6). Each block
# remembers how many deferred frees there were and the next entry number when it began.
func zue_mem_begin() {
    if (rl_inside == rl_mark_cap) {
        let cap = 8
        if (rl_mark_cap != 0) {
            cap = rl_mark_cap * 2
        }
        rl_marks = realloc(rl_marks, cap * 16)
        rl_mark_cap = cap
    }
    st64(rl_marks + rl_inside * 16, rl_defer_n)
    st64(rl_marks + rl_inside * 16 + 8, rl_next)
    rl_inside += 1
    return 0
}

func _rl_mark_freed(e) {
    st64(e + AE_STATE, AS_FREED)
    rl_freed += 1
}

# The newest deferred entry of the innermost block, taken off the list and marked freed, or 0 when the
# block has none left. The caller gives the memory back.
func zue_mem_pop_defer() {
    if (rl_inside == 0 or rl_defer_n <= ld64(rl_marks + (rl_inside - 1) * 16)) {
        return 0
    }
    rl_defer_n -= 1
    let e = _rl_by_num(rl_defers[rl_defer_n])
    _rl_mark_freed(e)
    return e
}

# R10: the number of allocations made in the innermost block that are neither freed nor deferred. The
# line of the first goes to out_line.
func zue_mem_leaks(out_line) {
    if (rl_inside == 0) {
        return 0
    }
    let leaks = 0
    let first = ld64(rl_marks + (rl_inside - 1) * 16 + 8)
    let i = rl_entry_n - 1
    while (i >= 0 and ld64(rl_entries + i * AE_BYTES + AE_NUM) >= first) {
        let e = rl_entries + i * AE_BYTES
        if (ld64(e + AE_KIND) != AK_ADDR and ld64(e + AE_STATE) == AS_LIVE) {
            if (out_line != 0) {
                st64(out_line, ld64(e + AE_LINE))    # the walk goes backwards: the last one written is the first
            }
            leaks += 1
        }
        i -= 1
    }
    return leaks
}

# Leaves the innermost block. When the outermost one ends no pointer can still exist (R2) and every
# allocation was freed (R10), so the table is emptied; numbers go on from where they were.
func zue_mem_end() {
    if (rl_inside == 0) {
        return 0
    }
    rl_inside -= 1
    if (rl_inside == 0) {
        if (rl_next > RL_RESTART) {
            rl_next = 1
        }
        _rl_reset_table()
        # A long block can leave a large table behind; give it back.
        if (rl_entry_cap > 4096) {
            free(rl_entries)
            rl_entries = 0
            rl_entry_cap = 0
        }
    }
}

# Whether an entry is the start of memory that free() and defer() may take: 0 when it is.
func _rl_release_ok(p) {
    let e = zue_mem_entry(p)
    if (e == 0) {
        return MERR_UNKNOWN_POINTER
    }
    let k = ld64(e + AE_KIND)
    if (k == AK_ADDR) {
        return MERR_FREE_NOT_ALLOC
    }
    if (ld64(e + AE_STATE) == AS_FREED) {
        return MERR_USE_AFTER_FREE
    }
    if (ld64(e + AE_STATE) == AS_DEFERRED) {
        return MERR_DEFERRED
    }
    if (band(p, RL_SLOT_MASK) != 0) {
        return MERR_FREE_INTERIOR
    }
    return 0
}

# R4: free marks the allocation freed; a second free, or a free of a deferred pointer, is an error.
func zue_mem_free_ok(p) {
    let code = _rl_release_ok(p)
    if (code != 0) {
        return code
    }
    _rl_mark_freed(zue_mem_entry(p))
    return 0
}

# defer(ptr): the allocation is freed when the innermost block ends; each allocation is deferred once.
func zue_mem_defer(p) {
    let code = _rl_release_ok(p)
    if (code != 0) {
        return code
    }
    if (rl_defer_n == rl_defer_cap) {
        let cap = 16
        if (rl_defer_cap != 0) {
            cap = rl_defer_cap * 2
        }
        let grown = realloc(rl_defers, cap * 8)
        if (grown == 0) {
            return MERR_TOO_MANY
        }
        rl_defers = grown
        rl_defer_cap = cap
    }
    rl_defers[rl_defer_n] = shr(p, 32)
    rl_defer_n += 1
    st64(zue_mem_entry(p) + AE_STATE, AS_DEFERRED)
    return 0
}

# R4: a load or store needs a live allocation.
func zue_mem_deref_ok(p) {
    let e = zue_mem_entry(p)
    if (e == 0) {
        return MERR_UNKNOWN_POINTER
    }
    if (ld64(e + AE_STATE) == AS_FREED) {
        return MERR_USE_AFTER_FREE
    }
    return 0
}

func zue_mem_store_ok(p) {
    return zue_mem_deref_ok(p)
}

# R3: p moved by n slots must stay inside its allocation. The result goes to out_ptr (when not null)
# only on success. The test needs no multiply, so no offset can wrap around into the bounds.
func zue_mem_ptr_add_ok(p, n, out_ptr) {
    let code = zue_mem_deref_ok(p)
    if (code != 0) {
        return code
    }
    let e = zue_mem_entry(p)
    let k = ld64(e + AE_KIND)
    if (k == AK_TEMPLATE or k == AK_BLOC) {
        return MERR_OBJECT_OFFSET
    }
    let slot = band(p, RL_SLOT_MASK)
    let cells = ld64(e + AE_CELLS)
    if (n < 0 - slot or n >= cells - slot) {
        return MERR_OUT_OF_BOUNDS
    }
    if (out_ptr != 0) {
        st64(out_ptr, p + n)
    }
    return 0
}

# R1 and R5: address_of needs a named value that does not hold a pointer.
func zue_mem_addr_ok(holds_pointer, is_named) {
    if (is_named == 0) {
        return MERR_ADDR_TEMPORARY
    }
    if (holds_pointer != 0) {
        return MERR_POINTER_TO_POINTER
    }
    return 0
}

# R2: a pointer never leaves its unsafe block.
func zue_mem_escape_ok(p) {
    return MERR_ESCAPE
}

# R2: a pointer to a local variable of a function may not be returned from that function, whose stack slot
# is gone after the return. depth is the call depth of the returning function.
func zue_mem_return_ok(p, depth) {
    let e = zue_mem_entry(p)
    if (e == 0 or ld64(e + AE_KIND) != AK_ADDR) {
        return 0
    }
    let d = ld64(e + AE_DEPTH)
    if (d >= 0 and d >= depth) {
        return MERR_ESCAPE
    }
    return 0
}

# R8: == and != compare any pointers; ordered comparisons need one allocation.
func zue_mem_cmp_ok(a, b, op) {
    if (op == 0 or op == 1) {
        return 0
    }
    if (zue_mem_entry(a) == 0 or zue_mem_entry(b) == 0) {
        return MERR_UNKNOWN_POINTER
    }
    if (shr(a, 32) == shr(b, 32)) {
        return 0
    }
    return MERR_CMP_BASE
}

# R9: only int(ptr), target type 0, casts a pointer.
func zue_mem_cast_ok(p, target_type) {
    if (target_type == 0) {
        return 0
    }
    return MERR_CAST
}

# R7: alloc takes a positive integer that fits the slot field of a pointer.
func zue_mem_alloc_size_ok(n, is_integer) {
    if (is_integer == 0 or n <= 0) {
        return MERR_ALLOC_SIZE
    }
    if (n > RL_SLOT_MASK) {
        return MERR_ALLOC_TOO_LARGE
    }
    return 0
}

# R2: a pointer may not be stored in a GC-managed value.
func zue_mem_gc_store_ok(p) {
    return MERR_GC_STORE
}
