func lvv_eq(at, ap, bt, bp) {
    let a = stack_buf(16)
    let b = stack_buf(16)
    let o = stack_buf(16)
    if (at == T_STR and bt == T_STR) {
        _bool(o, _str_same(ap, bp))
        retp(o)
    }
    if (at == T_INT and bt == T_INT) {
        _bool(o, ap == bp)
        retp(o)
    }
    _set(a, at, ap)
    _set(b, bt, bp)
    lvp_eq_fast(o, a, b)
    retp(o)
}

func lvv_ne(at, ap, bt, bp) {
    let a = stack_buf(16)
    let b = stack_buf(16)
    let o = stack_buf(16)
    if (at == T_STR and bt == T_STR) {
        _bool(o, _str_same(ap, bp) == 0)
        retp(o)
    }
    if (at == T_INT and bt == T_INT) {
        _bool(o, ap != bp)
        retp(o)
    }
    _set(a, at, ap)
    _set(b, bt, bp)
    lvp_ne_fast(o, a, b)
    retp(o)
}

