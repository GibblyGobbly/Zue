# A value that does not have the type its variable is kept in registers as (int, float or boolean).
# The checker proved the type, so this only happens when a value came from code it cannot see.
func lvv_unbox_fail(name, want_i, t, p) {
    let a = stack_buf(16)
    _set(a, t, p)
    let want = cstr("an int")
    if (want_i == T_FLOAT) {
        want = cstr("a float")
    }
    if (want_i == T_BOOL) {
        want = cstr("a boolean")
    }
    _errf(E_TYPE, cstr("The type checker could not follow where this value came from"),
          cstr("variable '%s' must be %s, got %s"), name, want, _type_name(a))
}

# A whole-number literal that the checker found wanted as a float for some signatures of its function only
# (see adapt_to in check.zu): it becomes a float when like, the value it goes into, is a float, a dense list
# or a list whose first item is a float.
func lvp_num_like(o, v, like) {
    _cp(o, v)
    if (_tag(v) != T_INT) {
        return 0
    }
    let t = _tag(like)
    let float_like = t == T_FLOAT or t == T_DENSE
    if (t == T_LIST and ld64(_val(like) + L_COUNT) > 0) {
        float_like = _tag(ld64(_val(like) + L_ITEMS)) == T_FLOAT
    }
    if (float_like) {
        let f = i2f(_val(v))
        if (_val(v) == -9223372036854775807 - 1 or (fge(fabs(f), 9223372036854775808.0) == 0 and f2i(f) == _val(v))) {
            _set(o, T_FLOAT, f)
        } else {
            _errf(E_TYPE, cstr("A float holds whole numbers exactly only up to 9007199254740992. Write a float literal, or keep the value an int"),
                  cstr("the number literal %lld has no exact float value"), _val(v), 0, 0)
        }
    }
}

func lvv_global_store_check(t, p, in_function_i) {
    let a = stack_buf(16)
    _set(a, t, p)
    lvp_global_store_check(a, in_function_i)
}

func lvp_gundef(g, name) {
