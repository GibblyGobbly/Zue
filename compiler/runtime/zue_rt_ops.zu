#
# zue_rt_ops.zu: operators, indexing, iteration, calls and the program entry of the
# runtime. Operators convert nothing implicitly, division of integers is integer division,
# conditions must be booleans, and every error uses the same format. Every function takes pointers to LV cells; the
# result, if any, is written through the first argument.

extern("fmod", "double", "double,double")
extern("pthread_attr_init", "i32", "ptr")
extern("pthread_attr_setstacksize", "i32", "ptr,i64")
extern("pthread_create", "i32", "ptr,ptr,ptr,ptr")
extern("pthread_join", "i32", "i64,ptr")

const MAX_DEPTH = 100000

# Errors in operators

func _operand_error(op, a, b) {
    let msg = stack_buf(160)
    snprintf(msg, 160, cstr("cannot use '%s' on %s and %s"), op, _type_name(a), _type_name(b))
    if (ld8(op) == 43 and ld8(op + 1) == 0 and (_is_num(a) == 0 or _is_num(b) == 0)) {
        lv_error_labeled(E_TYPE, msg, cstr("Both sides must be numbers, or both strings. Build text with \"\{x}\" or to_string(x)."),
                         0, _type_name(a), _type_name(b))
    }
    if (_is_num(a) and _is_num(b)) {
        lv_error_labeled(E_TYPE, msg, cstr("Ints and floats do not mix: convert one side with float(x) or int(x)."),
                         0, _type_name(a), _type_name(b))
    }
    lv_error_labeled(E_TYPE, msg, cstr("Both sides must be numbers."), 0, _type_name(a), _type_name(b))
}

func _overflow(op) {
    _errf(E_RUNTIME, cstr("The result does not fit in a 64-bit int. Use floats for very large numbers."),
          cstr("integer overflow in '%s'"), op, 0, 0)
}

func _float_overflow(op) {
    _errf(E_RUNTIME, cstr("Zue has no infinity: the result must fit in a 64-bit float."),
          cstr("float overflow in '%s'"), op, 0, 0)
}

# A float result that is not infinite or NaN (the exponent bits are not all ones).
func _is_finite(bits) {
    return band(shr(bits, 52), 2047) != 2047
}

# Stores the float r in o, or raises an overflow error naming the operator.
func _flt_checked(o, r, op) {
    if (_is_finite(r) == 0) {
        _float_overflow(op)
    }
    _flt(o, r)
}

func _div_zero() {
    lv_error(E_RUNTIME, cstr("division by zero"), cstr("Check the divisor before dividing."))
}

func _oob(idx, len, what) {
    let msg = stack_buf(160)
    snprintf(msg, 160, cstr("Index %lld is out of bounds for %s of length %lld"), idx, what, len)
    let lab = stack_buf(96)
    if (len == 0) {
        snprintf(lab, 96, cstr("index %lld, but the %s is empty"), idx, what)
    } else {
        snprintf(lab, 96, cstr("index %lld, valid indexes are 0 to %lld"), idx, len - 1)
    }
    lv_error_labeled(E_INDEX, msg, cstr("Ensure your index is between 0 and len-1"), lab, 0, 0)
}

# Arithmetic

# A number element as a double; a dense list holds only numbers.
# A value stored in a dense list: a float. An int does not become one by itself.
func _elem(v) {
    if (_tag(v) == T_FLOAT) {
        return _val(v)
    }
    if (_tag(v) == T_INT) {
        _errf(E_TYPE, cstr("A dense list holds only floats; convert an int with float(x)."),
              cstr("cannot store a %s in a dense list"), _type_name(v), 0, 0)
    }
    _errf(E_TYPE, cstr("A dense list holds only numbers."),
          cstr("cannot store a %s in a dense list"), _type_name(v), 0, 0)
}

func _float_op(op, x, y) {
    if (op == 0) {
        return fadd(x, y)
    }
    if (op == 1) {
        return fsub(x, y)
    }
    if (op == 2) {
        return fmul(x, y)
    }
    return fdiv(x, y)
}

func _op_symbol(op) {
    if (op == 0) {
        return cstr("+")
    }
    if (op == 1) {
        return cstr("-")
    }
    if (op == 2) {
        return cstr("*")
    }
    return cstr("/")
}

# The one number type of the items of a plain list: T_INT, T_FLOAT, or 0 for an empty list. An item that
# is not a number, or a list that mixes ints and floats, is an error.
func _list_num_kind(v, op) {
    let n = ld64(_val(v) + L_COUNT)
    let items = ld64(_val(v) + L_ITEMS)
    let kind = 0
    for (let i = 0; i < n; i++) {
        let t = _tag(items + 16 * i)
        if (t != T_INT and t != T_FLOAT) {
            _errf4(E_TYPE, cstr("Both lists must hold only numbers."),
                   cstr("cannot use '%s' on a list: element %d is a %s, not a number"), op, i, _type_name(items + 16 * i), 0)
        }
        if (kind == 0) {
            kind = t
        } else if (t != kind) {
            _errf4(E_TYPE, cstr("Ints and floats do not mix: convert the items with float(x) or int(x)."),
                   cstr("cannot use '%s' on a list that holds ints and floats (element %d)"), op, i, 0, 0)
        }
    }
    return kind
}

# Element-wise arithmetic on two lists or two dense lists of the same length. Two lists of ints give a
# list of ints, computed like the operator on two ints (overflow and division by zero are errors); floats
# give a dense list. A list mixed with a dense list, lists of different lengths, a non-number element,
# ints with floats, a division by zero and a result that is not finite are errors.
func _list_arith(o, op, a, b) {
    let sym = _op_symbol(op)
    let n = 0
    let ta = _tag(a)
    let tb = _tag(b)
    if (ta == T_DENSE and tb == T_DENSE) {
        n = ld64(_val(a) + D_COUNT)
        if (ld64(_val(b) + D_COUNT) != n) {
            _errf4(E_ARGUMENT, cstr("Both lists need the same number of elements."),
                   cstr("cannot use '%s' on lists of different lengths (%d and %d)"), sym, n, ld64(_val(b) + D_COUNT), 0)
        }
        _dense_new(o, n)
        let out = ld64(_val(o) + D_DATA)
        let xs = ld64(_val(a) + D_DATA)
        let ys = ld64(_val(b) + D_DATA)
        for (let i = 0; i < n; i++) {
            out[i] = _float_elem_op(op, sym, xs[i], ys[i])
        }
        return 0
    }
    if (ta != T_LIST or tb != T_LIST) {
        _errf(E_TYPE, cstr("Use two lists, or two dense lists."),
              cstr("cannot use '%s' on a %s and a %s"), sym, _type_name(a), _type_name(b))
    }
    n = ld64(_val(a) + L_COUNT)
    if (ld64(_val(b) + L_COUNT) != n) {
        _errf4(E_ARGUMENT, cstr("Both lists need the same number of elements."),
               cstr("cannot use '%s' on lists of different lengths (%d and %d)"), sym, n, ld64(_val(b) + L_COUNT), 0)
    }
    let ka = _list_num_kind(a, sym)
    let kb = _list_num_kind(b, sym)
    if (n == 0) {
        _list_new(o, 0)
        return 0
    }
    if (ka != kb) {
        _errf(E_TYPE, cstr("Ints and floats do not mix: convert the items with float(x) or int(x)."),
              cstr("cannot use '%s' on a list of %s and a list of %s"), sym, _type_name(ld64(_val(a) + L_ITEMS)), _type_name(ld64(_val(b) + L_ITEMS)))
    }
    let xs = ld64(_val(a) + L_ITEMS)
    let ys = ld64(_val(b) + L_ITEMS)
    if (ka == T_FLOAT) {
        _dense_new(o, n)
        let out = ld64(_val(o) + D_DATA)
        for (let i = 0; i < n; i++) {
            out[i] = _float_elem_op(op, sym, _val(xs + 16 * i), _val(ys + 16 * i))
        }
        return 0
    }
    _list_new(o, n)
    let cell = stack_buf(16)
    for (let i = 0; i < n; i++) {
        if (op == 0) {
            lvp_add(cell, xs + 16 * i, ys + 16 * i)
        } else if (op == 1) {
            lvp_sub(cell, xs + 16 * i, ys + 16 * i)
        } else if (op == 2) {
            lvp_mul(cell, xs + 16 * i, ys + 16 * i)
        } else {
            lvp_div(cell, xs + 16 * i, ys + 16 * i)
        }
        _list_push(o, cell)
    }
}

func _float_elem_op(op, sym, x, y) {
    if (op == 3 and feq(y, 0.0)) {
        _div_zero()
    }
    let r = _float_op(op, x, y)
    if (_is_finite(r) == 0) {
        _float_overflow(sym)
    }
    return r
}

func lvp_add(o, a, b) {
    let ta = _tag(a)
    let tb = _tag(b)
    if (ta == T_INT and tb == T_INT) {
        if (addof(_val(a), _val(b)) != 0) {
            _overflow(cstr("+"))
        }
        _int(o, _val(a) + _val(b))
        return 0
    }
    if (_tag(a) == T_FLOAT and _tag(b) == T_FLOAT) {
        _flt_checked(o, fadd(_val(a), _val(b)), cstr("+"))
        return 0
    }
    if (ta == T_STR and tb == T_STR) {
        let la = ld64(_val(a))
        let lb = ld64(_val(b))
        if (_too_big(la + lb, 1)) {
            _die_oom()
        }
        # One exact-size allocation, each part copied from its own bytes. (This once called _str_n with the
        # length la + lb on the bytes of a alone, which read lb bytes past the end of a: harmless inside a
        # page, a crash when a large string ended where its mapping ended.)
        let st = lv_alloc_atomic(S_DATA + la + lb + 1)
        st64(st, la + lb)
        if (la != 0) {
            memcpy(st + S_DATA, _val(a) + S_DATA, la)
        }
        if (lb != 0) {
            memcpy(st + S_DATA + la, _val(b) + S_DATA, lb)
        }
        st8(st + S_DATA + la + lb, 0)
        _set(o, T_STR, st)
        return 0
    }
    if (_is_listish(a) and _is_listish(b)) {
        _list_arith(o, 0, a, b)
        return 0
    }
    _operand_error(cstr("+"), a, b)
}

func lvp_sub(o, a, b) {
    if (_tag(a) == T_INT and _tag(b) == T_INT) {
        if (subof(_val(a), _val(b)) != 0) {
            _overflow(cstr("-"))
        }
        _int(o, _val(a) - _val(b))
        return 0
    }
    if (_tag(a) == T_FLOAT and _tag(b) == T_FLOAT) {
        _flt_checked(o, fsub(_val(a), _val(b)), cstr("-"))
        return 0
    }
    if (_is_listish(a) and _is_listish(b)) {
        _list_arith(o, 1, a, b)
        return 0
    }
    _operand_error(cstr("-"), a, b)
}

func lvp_mul(o, a, b) {
    if (_tag(a) == T_INT and _tag(b) == T_INT) {
        if (mulof(_val(a), _val(b)) != 0) {
            _overflow(cstr("*"))
        }
        _int(o, _val(a) * _val(b))
        return 0
    }
    if (_tag(a) == T_FLOAT and _tag(b) == T_FLOAT) {
        _flt_checked(o, fmul(_val(a), _val(b)), cstr("*"))
        return 0
    }
    if (_is_listish(a) and _is_listish(b)) {
        _list_arith(o, 2, a, b)
        return 0
    }
    _operand_error(cstr("*"), a, b)
}

func lvp_div(o, a, b) {
    if (_tag(a) == T_INT and _tag(b) == T_INT) {
        if (_val(b) == 0) {
            _div_zero()
        }
        if (_val(a) == -9223372036854775807 - 1 and _val(b) == -1) {
            _overflow(cstr("/"))
        }
        _int(o, _val(a) / _val(b))
        return 0
    }
    if (_tag(a) == T_FLOAT and _tag(b) == T_FLOAT) {
        let d = _val(b)
        if (feq(d, 0.0)) {
            _div_zero()
        }
        _flt_checked(o, fdiv(_val(a), d), cstr("/"))
        return 0
    }
    if (_is_listish(a) and _is_listish(b)) {
        _list_arith(o, 3, a, b)
        return 0
    }
    _operand_error(cstr("/"), a, b)
}

func lvp_mod(o, a, b) {
    if (_tag(a) == T_INT and _tag(b) == T_INT) {
        if (_val(b) == 0) {
            _div_zero()
        }
        if (_val(b) == -1) {
            _int(o, 0)
            return 0
        }
        _int(o, _val(a) % _val(b))
        return 0
    }
    if (_tag(a) == T_FLOAT and _tag(b) == T_FLOAT) {
        let d = _val(b)
        if (feq(d, 0.0)) {
            _div_zero()
        }
        _flt(o, fmod(_val(a), d))
        return 0
    }
    _operand_error(cstr("%"), a, b)
}

# Bitwise operators work on ints only.
func _bit_ints(op, a, b) {
    if (_tag(a) != T_INT or _tag(b) != T_INT) {
        _operand_error(op, a, b)
    }
}

func lvp_band(o, a, b) {
    _bit_ints(cstr("&"), a, b)
    _int(o, band(_val(a), _val(b)))
}

func lvp_bor(o, a, b) {
    _bit_ints(cstr("|"), a, b)
    _int(o, bor(_val(a), _val(b)))
}

func lvp_bxor(o, a, b) {
    _bit_ints(cstr("^"), a, b)
    _int(o, bxor(_val(a), _val(b)))
}

func _shift_count(b) {
    if (_val(b) < 0 or _val(b) > 63) {
        _errf(E_ARGUMENT, cstr("A shift count must be from 0 to 63."),
              cstr("shift count %lld is out of range"), _val(b), 0, 0)
    }
}

# x << n must not lose bits: the result shifted back has to give x again.
func lvp_shl(o, a, b) {
    _bit_ints(cstr("<<"), a, b)
    _shift_count(b)
    let r = shl(_val(a), _val(b))
    if (sar(r, _val(b)) != _val(a)) {
        _overflow(cstr("<<"))
    }
    _int(o, r)
}

func lvp_shr(o, a, b) {
    _bit_ints(cstr(">>"), a, b)
    _shift_count(b)
    _int(o, sar(_val(a), _val(b)))
}

# Comparison

# Values of one family can be compared with == and !=. An int and a float are not one family: they never mix.
func _family(v) {
    let t = _tag(v)
    if (t == T_INT) {
        return 1
    }
    if (t == T_FLOAT) {
        return 3
    }
    if (t == T_LIST or t == T_DENSE) {
        return 2
    }
    return 100 + t
}

# == without the type check. Lists and maps compare their contents.
func lvp_equal(a, b) {
    if (_is_container(_tag(a)) and _is_container(_tag(b))) {
        return _equal_deep(a, b)
    }
    return _equal_flat(a, b)
}

func _is_container(t) {
    return t == T_LIST or t == T_DENSE or t == T_MAP
}

# Item i of a list or a dense list, written at o.
func _seq_item(o, v, i) {
    if (_tag(v) == T_DENSE) {
        _set(o, T_FLOAT, ld64(ld64(_val(v) + D_DATA) + i * 8))
    } else {
        _cp(o, ld64(_val(v) + L_ITEMS) + 16 * i)
    }
}

func _seq_count(v) {
    if (_tag(v) == T_DENSE) {
        return ld64(_val(v) + D_COUNT)
    }
    return ld64(_val(v) + L_COUNT)
}

# Deep ==. Two lists (or dense lists) are equal when they have the same items in the same order; two
# maps when they have the same keys with equal values, in any order. Nested containers go on a work
# list instead of a recursive call, so any depth works, and every pair of containers taken up is put
# in a set: a pair met again (a list that contains itself) is not compared a second time, which is
# what makes such comparisons end. The record w holds both, in malloc memory that is freed at the end;
# nothing here allocates on the heap, and the values stay reachable from a and b.
const EQ_WORK = 0       # pairs still to compare, 32 bytes each (two values)
const EQ_WORK_N = 8
const EQ_WORK_CAP = 16
const EQ_SEEN = 24      # set of container pairs: 2 words per slot, an empty slot has 0 in its first word
const EQ_SEEN_N = 32
const EQ_SEEN_CAP = 40
const EQ_ROOT_A = 48    # the first pair, put in the set only once a second pair shows up
const EQ_ROOT_B = 56
const EQ_ROOT_TAKEN = 64    # 1 once the first pair has been compared
const EQ_SIZE = 72
const EQ_FIRST_CAP = 16

func _equal_deep(a, b) {
    let w = stack_buf(EQ_SIZE)
    memset(w, 0, EQ_SIZE)
    st64(w + EQ_ROOT_A, _val(a))
    st64(w + EQ_ROOT_B, _val(b))
    _eq_push(w, a, b)
    let x = stack_buf(16)
    let y = stack_buf(16)
    let r = 1
    while (r != 0 and ld64(w + EQ_WORK_N) != 0) {
        let n = ld64(w + EQ_WORK_N) - 1
        st64(w + EQ_WORK_N, n)
        _cp(x, ld64(w + EQ_WORK) + 32 * n)
        _cp(y, ld64(w + EQ_WORK) + 32 * n + 16)
        r = _eq_pair(w, x, y)
    }
    free(ld64(w + EQ_WORK))
    free(ld64(w + EQ_SEEN))
    return r
}

func _eq_push(w, x, y) {
    let n = ld64(w + EQ_WORK_N)
    if (n == ld64(w + EQ_WORK_CAP)) {
        let cap = EQ_FIRST_CAP
        if (n != 0) {
            cap = n * 2
        }
        let grown = realloc(ld64(w + EQ_WORK), cap * 32)
        if (grown == 0) {
            _die_oom()
        }
        st64(w + EQ_WORK, grown)
        st64(w + EQ_WORK_CAP, cap)
    }
    _cp(ld64(w + EQ_WORK) + 32 * n, x)
    _cp(ld64(w + EQ_WORK) + 32 * n + 16, y)
    st64(w + EQ_WORK_N, n + 1)
}

# Adds the pair (pa, pb) to the set; returns 1 when it was there already.
func _eq_seen_add(w, pa, pb) {
    if ((ld64(w + EQ_SEEN_N) + 1) * 2 > ld64(w + EQ_SEEN_CAP)) {
        let old = ld64(w + EQ_SEEN)
        let old_cap = ld64(w + EQ_SEEN_CAP)
        let cap = EQ_FIRST_CAP
        if (old_cap != 0) {
            cap = old_cap * 2
        }
        let slots = calloc(cap, 16)
        if (slots == 0) {
            _die_oom()
        }
        st64(w + EQ_SEEN, slots)
        st64(w + EQ_SEEN_CAP, cap)
        st64(w + EQ_SEEN_N, 0)
        for (let i = 0; i < old_cap; i++) {
            if (ld64(old + 16 * i) != 0) {
                _eq_seen_add(w, ld64(old + 16 * i), ld64(old + 16 * i + 8))
            }
        }
        free(old)
    }
    let cap = ld64(w + EQ_SEEN_CAP)
    let slots = ld64(w + EQ_SEEN)
    let i = band(_rl_hash(bxor(_rl_hash(pa), pb)), cap - 1)
    while (ld64(slots + 16 * i) != 0) {
        if (ld64(slots + 16 * i) == pa and ld64(slots + 16 * i + 8) == pb) {
            return 1
        }
        i = band(i + 1, cap - 1)
    }
    st64(slots + 16 * i, pa)
    st64(slots + 16 * i + 8, pb)
    st64(w + EQ_SEEN_N, ld64(w + EQ_SEEN_N) + 1)
    return 0
}

# One item pair inside two containers: two containers are put on the work list (and count as equal
# for now), anything else is compared at once.
func _eq_item(w, x, y) {
    if (_is_container(_tag(x)) and _is_container(_tag(y))) {
        _eq_push(w, x, y)
        return 1
    }
    return _equal_flat(x, y)
}

func _eq_pair(w, x, y) {
    let tx = _tag(x)
    let ty = _tag(y)
    if ((tx == T_MAP) != (ty == T_MAP)) {
        return 0
    }
    if (tx == ty and _val(x) == _val(y)) {
        return 1
    }
    let is_root = _val(x) == ld64(w + EQ_ROOT_A) and _val(y) == ld64(w + EQ_ROOT_B)
    if (ld64(w + EQ_SEEN_CAP) == 0) {
        if (is_root != 0 and ld64(w + EQ_ROOT_TAKEN) != 0) {
            return 1
        }
        st64(w + EQ_ROOT_TAKEN, 1)
        if (is_root == 0) {
            _eq_seen_add(w, ld64(w + EQ_ROOT_A), ld64(w + EQ_ROOT_B))
        }
    }
    if (ld64(w + EQ_SEEN_CAP) != 0 and _eq_seen_add(w, _val(x), _val(y)) != 0) {
        return 1
    }
    if (tx == T_MAP) {
        let mx = _val(x)
        if (ld64(mx + M_COUNT) != ld64(_val(y) + M_COUNT)) {
            return 0
        }
        let other = stack_buf(16)
        for (let i = 0; i < ld64(mx + M_USED); i++) {
            let e = ld64(mx + M_ENTRIES) + i * E_SIZE
            if (ld32(e + E_LIVE) == 0) {
                continue
            }
            _map_get(other, y, ld64(e + E_KEY))
            if (g_found == 0 or _eq_item(w, e + E_VAL, other) == 0) {
                return 0
            }
        }
        return 1
    }
    let n = _seq_count(x)
    if (n != _seq_count(y)) {
        return 0
    }
    let xi = stack_buf(16)
    let yi = stack_buf(16)
    for (let i = 0; i < n; i++) {
        _seq_item(xi, x, i)
        _seq_item(yi, y, i)
        if (_eq_item(w, xi, yi) == 0) {
            return 0
        }
    }
    return 1
}

func _equal_flat(a, b) {
    let ta = _tag(a)
    let tb = _tag(b)
    if (ta == T_NULL or tb == T_NULL) {
        return ta == tb
    }
    if (ta == T_INT and tb == T_INT) {
        return _val(a) == _val(b)
    }
    if (ta == T_FLOAT and tb == T_FLOAT) {
        return feq(_val(a), _val(b))
    }
    if (ta != tb) {
        return 0
    }
    if (ta == T_BOOL) {
        return ld32(a + 8) == ld32(b + 8)
    }
    if (ta == T_CHAR) {
        return ld8(a + 8) == ld8(b + 8)
    }
    if (ta == T_STR) {
        return _str_same(_val(a), _val(b))
    }
    if (ta == T_FILE) {
        return _val(a) == _val(b)
    }
    if (ta >= T_BLOC_TYPE and ta <= T_PTR) {
        return _data_equal(a, b)
    }
    if (ta == T_FUNC) {
        let fa = _val(a)
        let fb = _val(b)
        if (fa == fb) {
            return 1
        }
        return ld32(fa + F_NATIVE) != 0 and ld32(fb + F_NATIVE) != 0 and ld64(fa + F_FN) == ld64(fb + F_FN)
    }
    return 0
}

func _check_comparable(a, b) {
    if (_tag(a) == T_NULL or _tag(b) == T_NULL) {
        return 0
    }
    if (_family(a) != _family(b)) {
        _errf(E_TYPE, cstr("Compare values of the same type (comparing with null is always allowed)."),
              cstr("cannot compare %s with %s"), _type_name(a), _type_name(b), 0)
    }
}

func lvp_eq(o, a, b) {
    if (_tag(a) == T_INT and _tag(b) == T_INT) {
        _bool(o, _val(a) == _val(b))
        return 0
    }
    if (_tag(a) == T_PTR) {
        _ptr_compare_check(a, b, 0)
    }
    _check_comparable(a, b)
    _bool(o, lvp_equal(a, b))
}

func lvp_ne(o, a, b) {
    if (_tag(a) == T_INT and _tag(b) == T_INT) {
        _bool(o, _val(a) != _val(b))
        return 0
    }
    if (_tag(a) == T_PTR) {
        _ptr_compare_check(a, b, 1)
    }
    _check_comparable(a, b)
    _bool(o, lvp_equal(a, b) == 0)
}

# The order of two strings by their bytes, unsigned, over their whole length: a NUL byte is an ordinary
# byte (strcmp stopped at it, so "a\0b" and "a\0c" were neither equal nor in order), and a string that is
# the start of another comes first.
func _str_order(a, b) {
    let la = ld64(a)
    let lb = ld64(b)
    let n = la
    if (lb < n) {
        n = lb
    }
    let c = memcmp(a + S_DATA, b + S_DATA, n)
    if (c != 0) {
        return (c > 0) - (c < 0)
    }
    return (la > lb) - (la < lb)
}

# -1, 0 or 1; an error for values that have no order.
func _order(a, b) {
    let ta = _tag(a)
    let tb = _tag(b)
    if (ta == T_INT and tb == T_INT) {
        return (_val(a) > _val(b)) - (_val(a) < _val(b))
    }
    if (ta == T_FLOAT and tb == T_FLOAT) {
        let x = _val(a)
        let y = _val(b)
        return fgt(x, y) - flt(x, y)
    }
    if (ta == T_STR and tb == T_STR) {
        return _str_order(_val(a), _val(b))
    }
    if (ta == T_CHAR and tb == T_CHAR) {
        # unsigned, as strings compare and as < on two chars does (lvp_lt_fast)
        let x = ld8(a + 8)
        let y = ld8(b + 8)
        return (x > y) - (x < y)
    }
    if (ta == T_PTR and tb == T_PTR) {
        return ugt(_val(a), _val(b)) - ult(_val(a), _val(b))
    }
    _errf(E_TYPE, cstr("Ordering works on two ints, two floats, two strings or two chars."),
          cstr("cannot order %s and %s with <, <=, > or >="), _type_name(a), _type_name(b), 0)
}

func lvp_lt(o, a, b) {
    if (_tag(a) == T_PTR) {
        _ptr_compare_check(a, b, 2)
    }
    _bool(o, _order(a, b) < 0)
}

func lvp_le(o, a, b) {
    if (_tag(a) == T_PTR) {
        _ptr_compare_check(a, b, 4)
    }
    _bool(o, _order(a, b) <= 0)
}

func lvp_gt(o, a, b) {
    if (_tag(a) == T_PTR) {
        _ptr_compare_check(a, b, 3)
    }
    _bool(o, _order(a, b) > 0)
}

func lvp_ge(o, a, b) {
    if (_tag(a) == T_PTR) {
        _ptr_compare_check(a, b, 5)
    }
    _bool(o, _order(a, b) >= 0)
}

# A condition must be a boolean.
func lvp_truth(a) {
    if (_tag(a) == T_BOOL) {
        return ld32(a + 8)
    }
    _errf(E_TYPE, cstr("Write the test explicitly, for example x != 0, len(s) > 0 or v != null."),
          cstr("condition must be a boolean, got %s"), _type_name(a), 0, 0)
}

func lvp_not(o, a) {
    _bool(o, lvp_truth(a) == 0)
}

# Fast paths that generated code calls: small integers and chars without leaving this file.
func lvp_add_fast(o, a, b) {
    if (_tag(a) == T_INT and _tag(b) == T_INT) {
        if (addof(_val(a), _val(b)) == 0) {
            _int(o, _val(a) + _val(b))
            return 0
        }
    }
    lvp_add(o, a, b)
}

func lvp_sub_fast(o, a, b) {
    if (_tag(a) == T_INT and _tag(b) == T_INT) {
        if (subof(_val(a), _val(b)) == 0) {
            _int(o, _val(a) - _val(b))
            return 0
        }
    }
    lvp_sub(o, a, b)
}

func lvp_mul_fast(o, a, b) {
    if (_tag(a) == T_INT and _tag(b) == T_INT) {
        if (mulof(_val(a), _val(b)) == 0) {
            _int(o, _val(a) * _val(b))
            return 0
        }
    }
    lvp_mul(o, a, b)
}

func lvp_lt_fast(o, a, b) {
    if (_tag(a) == T_INT and _tag(b) == T_INT) {
        _bool(o, _val(a) < _val(b))
        return 0
    }
    if (_tag(a) == T_CHAR and _tag(b) == T_CHAR) {
        _bool(o, ld8(a + 8) < ld8(b + 8))
        return 0
    }
    lvp_lt(o, a, b)
}

func lvp_le_fast(o, a, b) {
    if (_tag(a) == T_INT and _tag(b) == T_INT) {
        _bool(o, _val(a) <= _val(b))
        return 0
    }
    if (_tag(a) == T_CHAR and _tag(b) == T_CHAR) {
        _bool(o, ld8(a + 8) <= ld8(b + 8))
        return 0
    }
    lvp_le(o, a, b)
}

func lvp_gt_fast(o, a, b) {
    if (_tag(a) == T_INT and _tag(b) == T_INT) {
        _bool(o, _val(a) > _val(b))
        return 0
    }
    if (_tag(a) == T_CHAR and _tag(b) == T_CHAR) {
        _bool(o, ld8(a + 8) > ld8(b + 8))
        return 0
    }
    lvp_gt(o, a, b)
}

func lvp_ge_fast(o, a, b) {
    if (_tag(a) == T_INT and _tag(b) == T_INT) {
        _bool(o, _val(a) >= _val(b))
        return 0
    }
    if (_tag(a) == T_CHAR and _tag(b) == T_CHAR) {
        _bool(o, ld8(a + 8) >= ld8(b + 8))
        return 0
    }
    lvp_ge(o, a, b)
}

func lvp_eq_fast(o, a, b) {
    if (_tag(a) == T_INT and _tag(b) == T_INT) {
        _bool(o, _val(a) == _val(b))
        return 0
    }
    if (_tag(a) == T_CHAR and _tag(b) == T_CHAR) {
        _bool(o, ld8(a + 8) == ld8(b + 8))
        return 0
    }
    if (_tag(a) == T_STR and _tag(b) == T_STR) {
        _bool(o, _str_same(_val(a), _val(b)))
        return 0
    }
    lvp_eq(o, a, b)
}

func lvp_ne_fast(o, a, b) {
    if (_tag(a) == T_INT and _tag(b) == T_INT) {
        _bool(o, _val(a) != _val(b))
        return 0
    }
    if (_tag(a) == T_CHAR and _tag(b) == T_CHAR) {
        _bool(o, ld8(a + 8) != ld8(b + 8))
        return 0
    }
    if (_tag(a) == T_STR and _tag(b) == T_STR) {
        _bool(o, _str_same(_val(a), _val(b)) == 0)
        return 0
    }
    lvp_ne(o, a, b)
}

# a == b as a plain 0 or 1, for switch.
func lvp_eq_b(a, b) {
    let r = stack_buf(16)
    lvp_eq(r, a, b)
    return ld32(r + 8)
}

# Indexing

func _need_int_index(idx, what) {
    if (_tag(idx) != T_INT) {
        _errf(E_TYPE, cstr("Use an int index"), what, _type_name(idx), 0, 0)
    }
}

# target[lo:hi] in generated code. Positions count from 0 like indexes and both ends are included, so "bug"[0:1]
# is "bu". lo or hi is null when it was left out: it then stands for the first or the last position.
# A negative position, a position past the end, and a start after the end are errors.
func lvp_slice(o, t, lo, hi) {
    let tt = _tag(t)
    let n = 0
    if (tt == T_STR) {
        n = ld64(_val(t))
    } else if (tt == T_LIST) {
        n = ld64(_val(t) + L_COUNT)
    } else if (tt == T_DENSE) {
        n = ld64(_val(t) + D_COUNT)
    } else {
        _errf(E_TYPE, cstr("Slices work on strings and lists"), cstr("cannot slice a value of type %s"), _type_name(t), 0, 0)
    }
    if (_tag(lo) == T_NULL and _tag(hi) == T_NULL) {
        if (tt == T_LIST) {
            _list_of(o, n, ld64(_val(t) + L_ITEMS))
        } else if (tt == T_DENSE) {
            _dense_slice(o, t, 0, n)
        } else {
            _cp(o, t)
        }
        return 0
    }
    let a = 0
    let b = n - 1
    # A negative position counts from the end, as in indexing: "hello"[-2:] is "lo".
    if (_tag(lo) != T_NULL) {
        _need_int_index(lo, cstr("slice start must be an int, got %s"))
        a = _val(lo)
        if (a < 0) {
            a += n
        }
    }
    if (_tag(hi) != T_NULL) {
        _need_int_index(hi, cstr("slice end must be an int, got %s"))
        b = _val(hi)
        if (b < 0) {
            b += n
        }
    }
    let what = cstr("string")
    if (tt != T_STR) {
        what = cstr("list")
    }
    # Both ends are included, so s[a:] with a at the length is the empty rest (""[0:], s[len(s):]).
    if (_tag(hi) == T_NULL and a == n) {
        if (tt == T_STR) {
            _str(o, cstr(""))
        } else if (tt == T_DENSE) {
            _dense_slice(o, t, 0, 0)
        } else {
            _list_new(o, 0)
        }
        return 0
    }
    # the messages show the positions as written, before a negative one was counted from the end
    let wa = a
    let wb = b
    if (_tag(lo) != T_NULL) {
        wa = _val(lo)
    }
    if (_tag(hi) != T_NULL) {
        wb = _val(hi)
    }
    if (a < 0 or b > n - 1) {
        _errf4(E_INDEX, cstr("Positions start at 0 like indexes (or count from the end when negative) and both ends are included"),
               cstr("Slice %lld:%lld is out of bounds for a %s of length %lld"), wa, wb, what, n)
    }
    if (a > b) {
        _errf(E_INDEX, cstr("The start of a slice must not come after its end"),
              cstr("Slice start %lld is after its end %lld"), wa, wb, 0)
    }
    if (tt == T_STR) {
        _str_n(o, _val(t) + S_DATA + a, b - a + 1)
    } else if (tt == T_DENSE) {
        _dense_slice(o, t, a, b - a + 1)
    } else {
        _list_of(o, b - a + 1, ld64(_val(t) + L_ITEMS) + 16 * a)
    }
}

func _dense_slice(o, t, start, count) {
    _dense_new(o, count)
    if (count != 0) {
        memcpy(ld64(_val(o) + D_DATA), ld64(_val(t) + D_DATA) + 8 * start, 8 * count)
    }
}

# A read of a key the map does not have: an error, not null, so a misspelled key cannot go unnoticed.
func _missing_key(key) {
    _errf(E_NAME, cstr("Check with map_has(m, key) first, or give a default: map_get(m, key, default)."),
          cstr("Key '%s' does not exist in the map"), key + S_DATA, 0, 0)
}

func lvp_index(o, t, idx) {
    let tt = _tag(t)
    if (tt != T_LIST and tt >= T_BLOC_TYPE and tt <= T_PTR) {
        if (_data_index(t, idx, o) != 0) {
            return 0
        }
    }
    if (tt == T_LIST) {
        _need_int_index(idx, cstr("list index must be an int, got %s"))
        let l = _val(t)
        let i = _val(idx)
        if (i < 0) {
            i += ld64(l + L_COUNT)
        }
        if (i < 0 or i >= ld64(l + L_COUNT)) {
            _oob(_val(idx), ld64(l + L_COUNT), cstr("list"))
        }
        _cp(o, ld64(l + L_ITEMS) + 16 * i)
        return 0
    }
    if (tt == T_DENSE) {
        _need_int_index(idx, cstr("list index must be an int, got %s"))
        let d = _val(t)
        let i = _val(idx)
        if (i < 0) {
            i += ld64(d + D_COUNT)
        }
        if (i < 0 or i >= ld64(d + D_COUNT)) {
            _oob(_val(idx), ld64(d + D_COUNT), cstr("list"))
        }
        _flt(o, ld64(d + D_DATA)[i])
        return 0
    }
    if (tt == T_STR) {
        _need_int_index(idx, cstr("string index must be an int, got %s"))
        let s = _val(t)
        let i = _val(idx)
        if (i < 0) {
            i += ld64(s)
        }
        if (i < 0 or i >= ld64(s)) {
            _oob(_val(idx), ld64(s), cstr("string"))
        }
        _chr(o, ld8(s + S_DATA + i))
        return 0
    }
    if (tt == T_MAP) {
        if (_tag(idx) != T_STR) {
            _errf(E_TYPE, cstr("Maps use string keys"), cstr("map key must be a string, got %s"), _type_name(idx), 0, 0)
        }
        _map_get(o, t, _val(idx))
        if (g_found == 0) {
            _missing_key(_val(idx))
        }
        return 0
    }
    _errf(E_TYPE, cstr("Index lists and strings with ints, maps with strings"), cstr("cannot index %s"), _type_name(t), 0, 0)
}

# For 'else' and 'if (let ...)': t[idx] into o and 1, or 0 when nothing is there (a key the map does not
# have, an index out of range) or the value is null. A wrong kind of index is still an error.
func lv_try_index(o, t, idx) {
    let tt = _tag(t)
    if (tt == T_MAP and _tag(idx) == T_STR) {
        _map_get(o, t, _val(idx))
        if (g_found == 0) {
            return 0
        }
        return _tag(o) != T_NULL
    }
    let n = -1
    if (tt == T_LIST) {
        n = ld64(_val(t) + L_COUNT)
    } else if (tt == T_DENSE) {
        n = ld64(_val(t) + D_COUNT)
    } else if (tt == T_STR) {
        n = ld64(_val(t))
    }
    if (n >= 0 and _tag(idx) == T_INT) {
        let i = _val(idx)
        if (i < 0) {
            i += n
        }
        if (i < 0 or i >= n) {
            return 0
        }
    }
    lvp_index(o, t, idx)
    return _tag(o) != T_NULL
}

# For 'else' and 'if (let ...)': target.name into o and 1, or 0 when a map has no such key or the field
# is empty (null).
func lv_try_field(o, t, key, ic) {
    if (_tag(t) == T_MAP) {
        _map_get(o, t, _val(key))
        if (g_found == 0) {
            return 0
        }
    } else {
        lvp_field_ic(o, t, key, ic)
    }
    return _tag(o) != T_NULL
}

# Whether an argument is the absent value: a call with named arguments passes it for a parameter with a
# default that it leaves out. It is a null with payload 1; every other null has payload 0.
func lvp_is_absent(v) {
    if (_tag(v) == T_NULL and ld64(v + 8) == 1) {
        return 1
    }
    return 0
}

# target.name
func lvp_field(o, t, key) {
    let tt = _tag(t)
    if (tt == T_MAP) {
        _map_get(o, t, _val(key))
        if (g_found == 0) {
            _missing_key(_val(key))
        }
        return 0
    }
    if (tt == T_TEMPLATE) {
        let i = _tpl_find(_val(t), _val(key) + S_DATA)
        if (i >= 0) {
            _cp(o, _val(t) + TP_FIELDS + 16 * i)
            return 0
        }
    }
    if (tt >= T_BLOC_TYPE and tt <= T_PTR) {
        if (_data_field(t, key, o) != 0) {
            return 0
        }
    }
    _errf(E_TYPE, cstr("Dot access works on maps"), cstr("cannot read field '%s' of %s"), _val(key) + S_DATA, _type_name(t), 0)
}

# target.name in generated code. ic is the site's cache: the template type last seen there and the
# index of the field in it. The same site nearly always sees the same type, so a read is a compare
# and a copy. The cache words sit in the data segment, which the collector scans, so a cached type
# is never freed and its address never reused.
func lvp_field_ic(o, t, key, ic) {
    if (_tag(t) == T_TEMPLATE) {
        let tp = _val(t)
        let dt = ld64(tp + TP_DT)
        if (dt == ld64(ic)) {
            _cp(o, tp + TP_FIELDS + 16 * ld64(ic + 8))
            return 0
        }
        let i = _tpl_find(tp, _val(key) + S_DATA)
        if (i >= 0) {
            st64(ic, dt)
            st64(ic + 8, i)
            _cp(o, tp + TP_FIELDS + 16 * i)
            return 0
        }
    }
    lvp_field(o, t, key)
}

func lvp_index_set(t, idx, val) {
    let tt = _tag(t)
    if (tt >= T_BLOC_TYPE and tt <= T_PTR) {
        if (_data_index_set(t, idx, val) != 0) {
            return 0
        }
    }
    if (tt == T_LIST or tt == T_MAP) {
        lvp_container_check(val)
    }
    if (tt == T_LIST) {
        _need_int_index(idx, cstr("list index must be an int, got %s"))
        let l = _val(t)
        let i = _val(idx)
        if (i < 0) {
            i += ld64(l + L_COUNT)
        }
        if (i < 0 or i >= ld64(l + L_COUNT)) {
            _errf(E_INDEX, cstr("Ensure your index is between 0 and len(list)-1"),
                  cstr("Index %lld is out of bounds for list of length %lld"), _val(idx), ld64(l + L_COUNT), 0)
        }
        _cp(ld64(l + L_ITEMS) + 16 * i, val)
        return 0
    }
    if (tt == T_DENSE) {
        _need_int_index(idx, cstr("list index must be an int, got %s"))
        let d = _val(t)
        let i = _val(idx)
        if (i < 0) {
            i += ld64(d + D_COUNT)
        }
        if (i < 0 or i >= ld64(d + D_COUNT)) {
            _errf(E_INDEX, cstr("Ensure your index is between 0 and len(list)-1"),
                  cstr("Index %lld is out of bounds for list of length %lld"), _val(idx), ld64(d + D_COUNT), 0)
        }
        ld64(d + D_DATA)[i] = _elem(val)
        return 0
    }
    if (tt == T_MAP) {
        if (_tag(idx) != T_STR) {
            _errf(E_TYPE, cstr("Maps use string keys"), cstr("map key must be a string, got %s"), _type_name(idx), 0, 0)
        }
        _map_put(t, _val(idx), val)
        return 0
    }
    lv_error(E_TYPE, cstr("Cannot assign through this target"),
             cstr("Use integer indices for lists, or string keys for maps and templates"))
}

func lvp_map_put(m, key, val) {
    _map_put(m, _val(key), val)
}

# for-in: lists by element, strings by char. Maps are rejected;
# iterate map_keys(m) instead.
func lvp_iter_prepare(o, v) {
    let t = _tag(v)
    if (t == T_LIST or t == T_STR or t == T_DENSE) {
        _cp(o, v)
        return 0
    }
    lv_error(E_TYPE, cstr("for-in expects a list, dense list, or string"),
             cstr("Use for (let item in list) \{ ... }"))
}

func lvp_iter_len(v) {
    if (_tag(v) == T_LIST) {
        return ld64(_val(v) + L_COUNT)
    }
    if (_tag(v) == T_DENSE) {
        return ld64(_val(v) + D_COUNT)
    }
    return ld64(_val(v))
}

func lvp_iter_at(o, v, i) {
    let n = lvp_iter_len(v)
    if (i >= n) {
        # A for-in loop takes the length once; only a list made shorter in the loop gets here.
        if (_tag(v) != T_STR) {
            _errf(E_INDEX, cstr("Do not remove items from a list while a for-in loop walks it; build a new list instead."),
                  cstr("item %lld is out of bounds: the list was made shorter while a loop walked it (now %lld items)"), i, n, 0)
        }
        _oob(i, n, cstr("string"))
    }
    if (_tag(v) == T_DENSE) {
        _flt(o, ld64(ld64(_val(v) + D_DATA) + i * 8))
        return 0
    }
    if (_tag(v) == T_LIST) {
        _cp(o, ld64(_val(v) + L_ITEMS) + 16 * i)
        return 0
    }
    _chr(o, ld8(_val(v) + S_DATA + i))
}

func lvp_gget(o, g, name) {
    if (_tag(g) == T_UNDEF) {
        lv_undefined(name)
    }
    _cp(o, g)
}

# Calls

# The record of a call that starts at this depth: where it was made, in which module, and the name of the
# function, for the call stack of an error; and the two ways the nesting can be too deep.
func _call_frame(depth, pos, mod, name_p) {
    if (depth > MAX_DEPTH) {
        lv_error(E_RUNTIME, cstr("stack overflow: recursion is too deep"),
                 cstr("Zue allows 100000 nested calls. Check for a recursion that never stops."))
    }
    let fr = addr_of("lv_frames") + depth * FRAME_SIZE
    st64(fr, pos)
    st64(fr + 8, mod)
    st64(fr + 16, name_p)
    let stack_low = ld64(addr_of("_heap0") + H_STACK_LOW)
    if (stack_low != 0 and ult(stack_ptr(), stack_low)) {
        lvp_out_of_stack()
    }
}

# The error of a call that finds the stack of the running thread used up. Generated code makes this call
# itself for a direct call, after its own test of the stack.
func lvp_out_of_stack() {
    lv_error(E_RUNTIME, cstr("stack overflow: recursion is too deep"),
             cstr("The program ran out of stack. Check for a recursion that never stops."))
}

# A direct call of a function the compiler specialized: the same bookkeeping as lvp_call, in two steps
# around the call. lvp_leave reads back from the record what lvp_enter wrote.
func lvp_enter(name_p) {
    let depth = ld32(addr_of("lv_depth")) + 1
    st32(addr_of("lv_depth"), depth)
    _call_frame(depth, ld64(addr_of("lv_pos")), ld64(addr_of("lv_pos_mod")), name_p)
}

func lvp_leave() {
    let depth = ld32(addr_of("lv_depth"))
    let fr = addr_of("lv_frames") + depth * FRAME_SIZE
    st32(addr_of("lv_depth"), depth - 1)
    st64(addr_of("lv_pos_mod"), ld64(fr + 8))
    st64(addr_of("lv_pos"), ld64(fr))
}

func lvp_call(o, f, argc_i, argv) {
    let tf = _tag(f)
    if (tf == T_DTYPE or tf == T_BLOC_TYPE) {
        _construct(o, f, argc_i, argv)
        return 0
    }
    if (tf != T_FUNC) {
        _errf(E_TYPE, cstr("Make sure you are calling a function value, closure, or native builtin"),
              cstr("cannot call %s"), _type_name(f), 0, 0)
    }
    let mod = ld64(addr_of("lv_pos_mod"))
    let pos = ld64(addr_of("lv_pos"))
    let fn = _val(f)
    let depth = ld32(addr_of("lv_depth")) + 1
    st32(addr_of("lv_depth"), depth)
    _call_frame(depth, pos, mod, ld64(fn + F_NAME))
    callv(o, ld64(fn + F_FN), fn, argc_i, argv)
    st32(addr_of("lv_depth"), depth - 1)
    st64(addr_of("lv_pos_mod"), mod)
    st64(addr_of("lv_pos"), pos)
}

func lv_arity(self_p, argc_i, min_i, max_i) {
    if (argc_i >= min_i and argc_i <= max_i) {
        return 0
    }
    let name = cstr("function")
    if (self_p != 0 and ld64(self_p + F_NAME) != 0) {
        name = ld64(self_p + F_NAME)
    }
    if (min_i == max_i) {
        let plural = cstr("s")
        if (min_i == 1) {
            plural = cstr("")
        }
        _errf4(E_ARGUMENT, cstr("Pass one value per parameter"),
               cstr("%s() expects %d argument%s, but got %d"), name, min_i, plural, argc_i)
    }
    _errf4(E_ARGUMENT, cstr("Pass one value per required parameter"),
           cstr("%s() expects %d to %d arguments, but got %d"), name, min_i, max_i, argc_i)
}

# Program entry

# A crash (an invalid memory access, an arithmetic fault) is reported like any other error: where in
# the program it happened, and the calls that were running. The handler runs on its own small stack so
# that it still works when the crash is the program running out of stack.
extern("sigaction", "i32", "i32,ptr,ptr")
extern("sigaltstack", "i32", "ptr,ptr")

func _crash_name(sig) {
    if (sig == 11) {
        return cstr("invalid memory access (segmentation fault)")
    }
    if (sig == 7) {
        return cstr("invalid memory access (bus error)")
    }
    if (sig == 8) {
        return cstr("arithmetic fault")
    }
    return cstr("the program was stopped by a signal")
}

func _crash_handler(sig) {
    fflush(_stdout())
    let m = ld64(addr_of("lv_pos_mod"))
    let pos = ld64(addr_of("lv_pos"))
    fprintf(_stderr(), cstr("Fatal Error"))
    _put_code(_crash_name(sig))
    if (m != 0 and ld64(m + MOD_PATH) != 0) {
        fprintf(_stderr(), cstr(" in %s"), ld64(m + MOD_PATH))
    }
    fprintf(_stderr(), cstr(" near line %d:\n  %s\n"), band(pos, 4194303), _crash_name(sig))
    _error_source(pos)
    fprintf(_stderr(), cstr("Hint: This is a bug in the program's unsafe code or in the Zue runtime. Look for a pointer used after free() or outside its block.\n"))
    _print_stack()
    exit(128 + sig)
}

# Installs the handler for the calling thread's crashes.
func _crash_setup() {
    let size = 65536
    let stk = stack_buf(24)
    st64(stk, malloc(size))
    st64(stk + 8, 0)
    st64(stk + 16, size)
    sigaltstack(stk, 0)
    let act = stack_buf(160)
    memset(act, 0, 160)
    st64(act, fn_addr("_crash_handler"))
    # SA_ONSTACK | SA_RESETHAND: run on the spare stack, and a crash inside the handler is fatal.
    st32(act + 136, 134217728 + 2147483648)
    sigaction(11, act, 0)
    sigaction(7, act, 0)
    sigaction(8, act, 0)
}

func _thread_main(start) {
    _crash_setup()
    lv_gc_start()
    call_ptr(ld64(start))
    fflush(_stdout())
    return 0
}

func lv_main(argc_i, argv_p, entry_p) {
    lv_data_init()
    _srand_default()
    st64(addr_of("_argc"), argc_i)
    st64(addr_of("_argv"), argv_p)
    # Deep recursion needs a large stack; run the program on its own thread.
    let attr = stack_buf(128)
    pthread_attr_init(attr)
    let th = stack_buf(16)
    let start = stack_buf(16)
    st64(start, entry_p)
    # 1 GiB, or less when the address space is limited (ulimit -v); the stack check in
    # lvp_call turns running out of it into an error instead of a crash.
    let size = 1073741824
    let rc = 1
    while (rc != 0 and size >= 16777216) {
        pthread_attr_setstacksize(attr, size)
        rc = pthread_create(th, attr, fn_addr("_thread_main"), start)
        if (rc != 0) {
            size = size / 4
        }
    }
    if (rc != 0) {
        _crash_setup()
        lv_gc_start()
        call_ptr(entry_p)
    } else {
        pthread_join(ld64(th), 0)
    }
    return lv_flush_stdout_at_exit(0)
}

# The program ends with status code, or 1 when what it printed could not all be written (a full disk, a
# closed pipe): a failure is never reported as success.
func lv_flush_stdout_at_exit(code) {
    let rc = fflush(_stdout())
    let e = ld32(__errno_location())
    if (rc != 0) {
        fprintf(_stderr(), cstr("Runtime Error [E0450]: print() failed: %s\n"), strerror(e))
        return 1
    }
    # An earlier write failed when the buffer filled; its reason (errno) is gone by now.
    if (ferror(_stdout()) != 0) {
        fprintf(_stderr(), cstr("Runtime Error [E0450]: print() failed: the output could not be written\n"))
        return 1
    }
    return code
}

# By-value entry points for generated code. The operands arrive as tag and payload words and the
# result is returned as an LV in registers, so the generated code never has to give the runtime the
# address of a value and LLVM can keep its values in registers.

# The slow path of an operator whose operand on side (1 left, 2 right) is a whole-number literal the checker
# could not decide (see ll_binop): next to a float the literal is that float. Its float is exact (the
# compiler sends only literals of at most 2^53 here). op is the index in the table of _dyn_op.
func lvv_binop_lit(op, side, at, ap, bt, bp) {
    let a = stack_buf(16)
    let b = stack_buf(16)
    let o = stack_buf(16)
    _set(a, at, ap)
    _set(b, bt, bp)
    if (side == 2 and at == T_FLOAT and bt == T_INT) {
        _set(b, T_FLOAT, i2f(bp))
    } else if (side == 1 and bt == T_FLOAT and at == T_INT) {
        _set(a, T_FLOAT, i2f(ap))
    }
    if (op == 0) {
        lvp_add_fast(o, a, b)
    } else if (op == 1) {
        lvp_sub_fast(o, a, b)
    } else if (op == 2) {
        lvp_mul_fast(o, a, b)
    } else if (op == 3) {
        lvp_div(o, a, b)
    } else if (op == 4) {
        lvp_mod(o, a, b)
    } else if (op == 5) {
        lvp_lt_fast(o, a, b)
    } else if (op == 6) {
        lvp_le_fast(o, a, b)
    } else if (op == 7) {
        lvp_gt_fast(o, a, b)
    } else if (op == 8) {
        lvp_ge_fast(o, a, b)
    } else if (op == 9) {
        lvp_eq_fast(o, a, b)
    } else {
        lvp_ne_fast(o, a, b)
    }
    retp(o)
}

func lvv_add(at, ap, bt, bp) {
    let a = stack_buf(16)
    let b = stack_buf(16)
    let o = stack_buf(16)
