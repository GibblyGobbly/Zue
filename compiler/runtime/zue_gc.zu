# Sizes
const GRAN = 16                # objects start on a granule and take whole granules
const LINE = 128               # the unit of reuse
const LINE_SHIFT = 7
const BLOCK = 32768            # 256 lines; holds normal or atomic objects, not both
const BLOCK_SHIFT = 15
const LINES_PER_BLOCK = 256
const GRANS_PER_BLOCK = 2048
const CHUNK_SIZE = 2097152     # 64 blocks, aligned to 2 MB
const BLOCKS_PER_CHUNK = 64
const MAX_MEDIUM = 8192        # a quarter of a block: larger objects get a span of their own
const PAGE_SHIFT = 16          # the page table maps 64 KB of address space to a descriptor
const PAGE_SIZE = 65536
const MIN_THRESHOLD = 16777216
const CHUNK_BYTES = 4096       # a larger object is scanned in pieces of this size
const STEP_BYTES = 8192        # bytes the program allocates between two steps while a cycle runs
const LOCAL_CAP = 256
const GCT_BATCH = 16384        # words the GC thread marks before it looks at what the program thread handed over
const THROTTLE_NS_STEP = 100000  # time a collector step of a program that allocates too fast is held back
const ROOT_STEP_WORDS = 32768  # words of root ranges scanned in one step of the collector (256 KB)
const SWEEP_CLAIM = 64         # blocks the GC thread claims for sweeping at a time

# struct Chunk, the descriptor of a 2 MB chunk (calloc). Kind 1; offset 0 is shared with struct Large.
const CD_KIND = 0              # u8: 1
const CD_BASE = 8
const CD_VMARK = 16            # the verifier's visited bits, allocated when the verifier first runs
const CD_START = 64            # bit per granule: an object starts here
const CD_END = 16448           # bit per granule: an object ends here (its last granule)
const CD_MARK = 32832          # bit per granule, at an object's start: marked in the cycle
const CD_LINES = 49216         # byte per line: the epoch of the cycle that last found the line live, 0 when free
const CD_NEW = 65600           # bit per granule, at an object's start: allocated while the cycle marks (program thread only)
const CD_BLK = 81984           # BlockInfo[64]
const CD_SIZE = 83008
const DESC_STEP = 86016         # CD_SIZE in whole 4 KB pages: the distance between two descriptors of an arena
const MAP_BYTES = 16384        # bytes of one granule bitmap of a chunk
# struct BlockInfo (16 bytes)
const BI_KIND = 0              # u8: 0 free, 1 normal objects, 2 atomic objects
const BI_SWEPT = 1             # u8: the sweep epoch that last swept the block, or in which it was taken
const BI_ZERO = 2              # u8: 1 while every byte of the block is zero
const BI_COLD = 3              # u8: 1 when its memory was given back to the system
const BI_GAP = 4               # u16: the largest gap the last sweep left, in granules (0: the block is full)
const BI_SIZE = 16

# struct Large, the descriptor of an object over MAX_MEDIUM (calloc). Kind 2.
const LD_KIND = 0              # u8: 2
const LD_MARK = 1              # u8
const LD_ATOMIC = 2            # u8
const LD_VMARK = 4             # u8: visited by the verifier
const LD_BASE = 8
const LD_OBJ = 16              # the object's size
const LD_SPAN = 24             # bytes mapped
const LD_SIZE = 32

# struct Allocator: bump allocation into one gap. The block is kept as its number (address >> BLOCK_SHIFT)
# and the cursor as an offset: the collector's state is in the data segment, which is scanned, and an
# address there would keep whatever object starts at it alive.
const AL_BLOCK = 0             # block number, 0 when there is none
const AL_OFF = 8               # where the next object goes, from the block's start
const AL_LEFT = 16             # bytes left in the gap
const AL_CD = 24               # the block's chunk descriptor
const AL_G0 = 32               # the block's first granule, counted from the chunk's start
const AL_SIZE = 40
# Four allocators: [atomic][overflow]. The overflow allocator takes medium objects that do not fit the gap.

# struct Worker: what a thread that runs Zue code keeps for itself (the tspace "_wk0": one for each operating
# system thread). The collector reaches the workers through H_WORKERS. The fields from WK_CUR on belong to the
# blue threads (zue_rt_blue.zu). The driver scans WK_CUR to WK_ZOMBIE and WK_HANDOFF to WK_IDLE as roots.
const WK_STATE = 0             # 0: runs Zue code. 1: stopped at a safe point, or in a call that may wait (atomic)
const WK_SP = 8                # its stack pointer when it stopped: the stack from here up does not change while WK_STATE is 1
const WK_STACK_BASE = 16       # end of the stack of the blue thread it runs
const WK_STACK_LOW = 24        # lowest usable address of that stack; 0 when unknown
const WK_BYTES = 32            # bytes it allocated that H_BYTES_SINCE_GC does not hold yet
const WK_LIMIT = 40            # WK_BYTES above this makes _gc_alloc look at the collector
const WK_SLOT = 48             # { first granule, size, bytes marked in this cycle } of the object _find found
const WK_LOCAL_N = 72          # items waiting in WK_LOCAL_BUF
const WK_ALLOC = 80            # Allocator[4]
const WK_LOW_P = 240           # the address of its lv_stack_low, for the threads that ask it to stop
const WK_ID = 248              # its index in H_WORKERS
const WK_DRIVER = 256          # 1 while it drives the collector
const WK_CUR = 264             # the blue thread it runs
const WK_RUNH = 272            # its run queue of ready threads (the head is written with st64a: other threads read it without the lock)
const WK_RUNT = 280
const WK_ZOMBIE = 288          # finished threads whose stack it still has to unmap
const WK_SWITCHES = 296        # switches so far, for the ticker (atomic)
const WK_PARK = 304            # 0: has work or looks for it. 1: looks for work without sleeping. 2: sleeps (atomic)
const WK_WAKE = 320            # Worker*[]: workers to wake once the scheduler lock is let go
const WK_WAKE_N = 328
const WK_FRAMES = 336          # its table of call frames (lv_frames_p), for a crash report from another thread
const WK_POS_P = 344           # the addresses of its lv_pos, lv_pos_mod and lv_depth, for the same
const WK_MOD_P = 352
const WK_DEPTH_P = 360
const WK_ASKED = 368           # 1 when the ticker asked the running thread to let another run (atomic)
const WK_STARTS = 376          # workers to start once the scheduler lock is let go
const WK_HANDOFF = 384         # a thread it took for itself but could not take up yet: it waits on its own stack until the worker before has left that thread's stack
const WK_IDLE = 392            # the thread it waits for work on, with a stack of its own
const WK_STEALN = 400          # threads in its run queue that another worker may take (atomic)
const WK_SEEN = 408            # i64[]: WK_SWITCHES of every worker when it last began to look for work
const WK_QLOCK = 464           # spin lock of its run queue (WK_RUNH, WK_RUNT, WK_STEALN and the CO_NEXT links)
const WK_LOCAL_BUF = 512       # MarkItem[LOCAL_CAP]: objects its barrier marked, for the marking threads to scan
const WK_SIZE = 4608
const WK_MAX = 1024            # workers the table holds (ZUE_RT_BLUE_WORKERS is at most this)

# State of the collector: one block of 64-bit fields that the functions reach through _heap(). A field's
# offset is its constant H_NAME. The fields named in zue_rt_blue.zu and zue_rt_ops.zu keep their names.
const H_SETUP_DONE = 0
const H_TABLE = 8              # top level of the page table: 65536 pointers to second-level tables
const H_HEAP_LO = 16
const H_HEAP_HI = 24
const H_BYTES_SINCE_GC = 32    # bytes allocated since the last cycle ended, without what the workers have not added yet (atomic adds)
const H_THRESHOLD = 40
const H_EXTRA = 48             # bytes the program may allocate between two cycle ends before it is slowed down (see _after_sweep)
const H_LIVE_BYTES = 64
const H_GC_READY = 72
const H_GC_BUSY = 80           # 1 while a worker drives the collector (taken with a compare-and-swap)
const H_STRESS_EVERY = 88
const H_ALLOC_COUNT = 96
const H_COLLECTIONS = 104
const H_WORKERS = 112          # Worker*[WK_MAX]: every thread that runs Zue code, in the order they began
const H_MARKERS = 120          # Marker[H_NMARK + 1]: one per marking thread, the last for the program thread
const H_NMARK = 128            # marking threads (ZUE_RT_GC_MARKERS); the first also sweeps
const H_IDLE = 136             # marking threads waiting for work
const H_ROOTS = 144            # Range { lo, hi }
const H_ROOT_COUNT = 152
const H_ROOT_CAP = 160
const H_PAUSE_TOTAL = 168      # nanoseconds the program thread spent in collector steps
const H_PAUSE_MAX = 176
const H_NWORKERS = 184         # entries of H_WORKERS in use (atomic; written with the mutex held)
const H_MARKING = 192          # 1 from the start of a cycle until its marks are final
const H_VERIFY = 200
const H_VMODE = 208            # 1 while the verifier walks the heap
const H_VSTACK = 216           # 1 while the verifier reads the stack
const H_SWEEPING = 224         # 1 from the end of marking until the sweep is done and the pacer has run
const H_EPOCH = 232            # the line epoch of the running or last cycle, 1 to 255
const H_CHUNKS = 240           # Chunk*[]
const H_CHUNK_COUNT = 248
const H_CHUNK_CAP = 256
const H_FRESH_CD = 264         # the chunk new blocks are cut from; 0 before the first
const H_FRESH_USED = 272       # blocks of it cut so far
const H_LARGE = 280            # Large*[]
const H_LARGE_COUNT = 288
const H_LARGE_CAP = 296
const H_LISTS = 304            # BlockList[4] { buf, n, cap }: recyclable normal, recyclable atomic, free, free cold
const L_RECYC = 0              # [normal, atomic]: blocks with a gap of at least a line, which fits any small object
const L_FREE = 2
const L_COLD = 3
const L_TIGHT = 4              # [normal, atomic]: blocks whose largest gap is smaller than a line (at H_LISTS2)
const H_SW_CHUNK = 400         # the sweep's cursor: chunk index
const H_SW_BLOCK = 408         # and block index
const H_SW_EPOCH = 416         # the sweep epoch, 1 to 255
const H_SW_LARGE = 424         # large objects that existed when the sweep began
const H_SW_DONE = 432          # 1 when the GC thread has finished the sweep
const H_STATS = 448
const H_GCT_STATE = 464        # 0: idle, 1: marking, 2: marking and every marker out of work, 3: sweeping (atomic stores, mutex held)
const H_SHARED_N = 488         # items in the pool: handed over by the program thread or given away by a marker, not taken yet
const H_SHARED_CAP = 496
const H_SHARED_BUF = 504
const H_STW = 512              # 1 while the driver asks every other worker to stop at its next safe point (atomic)
const H_CYCLE_BYTES = 520      # H_BYTES_SINCE_GC when the cycle began
const H_SLOW_US = 528          # ZUE_RT_GC_SLOW: microseconds the GC thread sleeps after each piece of marking
const H_GCT_NS = 536           # nanoseconds the marking threads spent marking, added up
const H_SWEEP_NS = 544         # nanoseconds the GC thread spent sweeping
const H_MUTEX = 552            # pthread_mutex_t, 40 bytes, valid when zero filled
const H_COND_GC = 592          # pthread_cond_t, 48 bytes: wakes the marking threads (the first also sweeps)
const H_COND_DONE = 640        # pthread_cond_t: the GC thread has run out of work
const H_CYCLE_T0 = 4784        # when the running cycle began
const H_CYCLE_MAX = 4792       # the longest cycle from its start to final marks
const H_CYCLE_GCT0 = 4800      # H_GCT_NS when the running cycle began
const H_CYCLE_COST = 4808      # the pacer's measure of a cycle: nanoseconds from its start to the end of its sweep, per MiB live
const H_THROTTLE_CALL = 4816   # nanoseconds the running collector step has spun to slow the program down
const H_THROTTLE_NS = 4824
const H_THROTTLE_N = 4832
const H_PAUSE_MAX_SLEEP = 4840 # of the longest pause, the nanoseconds that were the throttle's spin
const H_THROTTLE_MAX = 4848
const H_LAST_END = 4856        # when the last cycle ended
const H_ALLOC_RATE = 4864      # the pacer's measure of the program: bytes allocated per millisecond
const H_PRE = 4872             # the helper thread's block (calloc); 0 when no helper runs
const H_RS_ON = 4880           # 1 while the root ranges from unsafe code are being scanned in steps
const H_RS_I = 4888
const H_RS_POS = 4896
const H_BS_ON = 4904           # 1 while the stacks of the blue threads that are away are being scanned in steps
const H_BS_CUR = 4912
const H_LOWMEM = 4920          # 1 for a program built with --gc=lowmem
const H_BEGIN_MAX = 4928       # the longest start of a cycle
const H_FINISH_MAX = 4936      # the longest end of the marking (verify, hook, sweep start)
const H_LARGE_BYTES = 5104     # bytes mapped for large objects
const H_COLD_KEEP = 5112       # free blocks the trim leaves hot
const H_PRE_POKE = 5120        # 1 when the helper is to be woken once the program thread lets the mutex go
const H_DYING = 5144           # 1 once the program ends or reports an error: the other workers stop for good (atomic)
const H_ROOT_LOCK = 5152       # spin lock of the root ranges (H_ROOTS, H_RS_*)
const H_LISTS2 = 5168          # BlockList[2]: the lists L_TIGHT
# Mutex timing for ZUE_RT_GC_STATS (written only with the mutex held, or by the program thread for its wait).
const H_LK_SITE = 5216         # where the holder took the mutex (a site number, + 256 for the program thread)
const H_LK_T0 = 5224           # when it took it
const H_LK_WAIT = 5232         # { ns, site }: the program thread's longest wait for the mutex
const H_LK_PHOLD = 5248        # { ns, site }: the program thread's longest hold
const H_LK_GHOLD = 5264        # { ns, site }: the longest hold by a collector thread
const HEAP_SIZE = 5280

# struct Marker: the work of one marking thread. Its mark stack and its slot, { first granule, size, bytes marked
# in this cycle } of the object _find found. A marker that waits for work has an empty stack. 128 bytes, so two
# markers do not share a cache line.
const MK_STACK = 0             # MarkItem { p, n }[]
const MK_TOP = 8
const MK_CAP = 16
const MK_SLOT = 24
const MK_GROW = 48             # times the mark stack grew
const MK_WORDS = 56            # words scanned
const MK_NS = 64               # time spent marking
const MK_GIVEN = 72            # times it gave work to the pool
const MK_GIVEN_N = 80          # items given
const MK_TAKES = 88            # times it took work from the pool
const MK_WAITS = 96            # times it went to sleep during marking
const MK_SIZE = 128
# The block of the helper thread, which makes chunks ahead of time.
const PRE_SLOTS = 16
const PRE_RING = 0
const PRE_HEAD = 128           # next slot the program thread takes (written by the program thread only)
const PRE_TAIL = 136           # next slot the helper fills (written by the helper only)
const PRE_WANT = 144           # how many ready chunks the helper keeps; 0 until the program has asked for a second chunk
const PRE_MUTEX = 152
const PRE_COND = 192
const PRE_HITS = 240
const PRE_MISSES = 248
const PRE_HINT = 256           # 1 while new chunks ask for huge pages; the helper turns it off
const PRE_MADE = 264
const PRE_SPIKES = 272
const PRE_OFF_AT = 280
const PRE_MAXNS = 288
const PRE_OWN_NS = 296         # the longest chunk the program thread made itself: all of it, the mapping, the descriptor
const PRE_OWN_MAP = 304
const PRE_OWN_DESC = 312
const PRE_ARENA = 320          # the next chunk of the arena and the arena's end (PRE_MUTEX)
const PRE_ARENA_END = 328
const PRE_DESCS = 336          # the descriptor of the next chunk of the arena (PRE_MUTEX)
const PRE_SIZE = 344
const SPIKE_NS = 1000000       # a chunk that takes longer than this to make is a spike (the pause goal is below a millisecond)
const ARENA_CHUNKS = 64         # chunks of address space the helper maps at a time
const RESERVE_PART = 8          # the helper keeps one chunk ready for every this many chunks of heap (at most PRE_SLOTS)
const HINT_MISSES = 3          # this many chunks the program had to make itself switch the huge page hint off
space("_heap0", HEAP_SIZE)
tspace("_wk0", WK_SIZE)
tspace("lv_stack_low", 8)   # a copy of WK_STACK_LOW for generated code, which does the stack test of a direct call itself
space("_hibit", 256)        # the highest set bit of a byte
space("_lobit", 256)        # the lowest set bit of a byte

func _heap() {
    return addr_of("_heap0")
}

# The calling thread's Worker.
func _wk() {
    return addr_of("_wk0")
}

# A lock held for a few instructions: the word at p is 1 while it is held. A thread that waits for it reads
# the word until it is 0 and only then tries to take it, so that the waiting threads do not take the cache
# line from the holder at every turn; after each try that another thread won it waits twice as long before
# it looks again (up to 256 pauses), so that many threads that wait do not all try at once; and it lets
# another thread have the core when the wait takes long (the holder may have lost its core).
func _spin_lock(p) {
    let spins = 0
    let backoff = 1
    while (cas64(p, 0, 1) == 0) {
        for (let i = 0; i < backoff; i++) {
            cpu_relax()
        }
        if (backoff < 256) {
            backoff = backoff * 2
        }
        while (ld64a(p) != 0) {
            cpu_relax()
            spins += 1
            if (spins > 1000) {
                sched_yield()
                spins = 0
            }
        }
    }
}

func _spin_unlock(p) {
    st64a(p, 0)
}

func _now_ns() {
    let ts = stack_buf(16)
    clock_gettime(1, ts)
    return ld64(ts) * 1000000000 + ld64(ts + 8)
}

func _die_oom() {
    write(2, cstr("Runtime Error: out of memory\n"), 29)
    exit(1)
}

func _invariant_fail(what) {
    let buf = stack_buf(200)
    let n = snprintf(buf, 200, cstr("Runtime Error: GC invariant broken: %s\n"), what)
    write(2, buf, n)
    exit(1)
}

# Every place that takes the mutex passes its site number (_site_name), so that ZUE_RT_GC_STATS can say where
# the longest waits and holds were.
func _lock(site) {
    pthread_mutex_lock(_heap() + H_MUTEX)
    _lock_note(site, 0, 0)
}

func _lock_note(site, prog, t0) {
    let h = _heap()
    if (ld64(h + H_STATS) == 0) {
        return 0
    }
    let now = _now_ns()
    if (prog != 0 and now - t0 > ld64(h + H_LK_WAIT)) {
        st64(h + H_LK_WAIT, now - t0)
        st64(h + H_LK_WAIT + 8, site)
    }
    st64(h + H_LK_SITE, site + prog * 256)
    st64(h + H_LK_T0, now)
    return 0
}

# The holder is about to let the mutex go (or to wait on a condition, which lets it go).
func _hold_end() {
    let h = _heap()
    if (ld64(h + H_STATS) == 0) {
        return 0
    }
    let dt = _now_ns() - ld64(h + H_LK_T0)
    let site = ld64(h + H_LK_SITE)
    let f = h + H_LK_GHOLD
    if (site >= 256) {
        f = h + H_LK_PHOLD
    }
    if (dt > ld64(f)) {
        st64(f, dt)
        st64(f + 8, band(site, 255))
    }
    return 0
}

func _site_name(i) {
    if (i == 1) {
        return cstr("_take_block")
    }
    if (i == 2) {
        return cstr("_refill")
    }
    if (i == 3) {
        return cstr("_alloc_large")
    }
    if (i == 4) {
        return cstr("_local_add")
    }
    if (i == 5) {
        return cstr("_donate")
    }
    if (i == 6) {
        return cstr("_sweep_large")
    }
    if (i == 7) {
        return cstr("_trim_free")
    }
    if (i == 8) {
        return cstr("_gct_sweep")
    }
    if (i == 9) {
        return cstr("_gc_begin")
    }
    if (i == 10) {
        return cstr("_marker_main")
    }
    if (i == 11) {
        return cstr("_cycle_poll")
    }
    if (i == 12) {
        return cstr("_gc_finish")
    }
    if (i == 13) {
        return cstr("_gc_work")
    }
    if (i == 14) {
        return cstr("_marker_main (after a wait)")
    }
    return cstr("none")
}

# The program thread takes the mutex by spinning, never by sleeping: a thread that sleeps on it can wait for a
# whole time slice of whatever runs on the core it wakes on (measured: up to 2.2 ms, with no thread holding the
# mutex longer than 0.3 ms). The markers and the helper hold it for microseconds.
func _lock_prog(site) {
    let h = _heap()
    let t0 = 0
    if (ld64(h + H_STATS) != 0) {
        t0 = _now_ns()
    }
    let spins = 0
    while (pthread_mutex_trylock(h + H_MUTEX) != 0) {
        spins += 1
    }
    _lock_note(site, 1, t0)
}

func _unlock() {
    _hold_end()
    pthread_mutex_unlock(_heap() + H_MUTEX)
}

func _gc_setup() {
    let h = _heap()
    st64(h + H_SETUP_DONE, 1)
    st64(h + H_HEAP_LO, -1)
    st64(h + H_THRESHOLD, MIN_THRESHOLD)
    st64(h + H_EXTRA, 4 * MIN_THRESHOLD)
    st64(h + H_EPOCH, 1)
    st64(h + H_SW_EPOCH, 1)
    st64(h + H_COLD_KEEP, MIN_THRESHOLD / BLOCK)
    let hi = addr_of("_hibit")
    let lo = addr_of("_lobit")
    for (let b = 1; b < 256; b++) {
        let top = 7
        while (band(b, shl(1, top)) == 0) {
            top--
        }
        st8(hi + b, top)
        let low = 0
        while (band(b, shl(1, low)) == 0) {
            low++
        }
        st8(lo + b, low)
    }
}

# Page table: the descriptor of each 64 KB of address space, found from the address with two loads. The
# first level is indexed by bits 32 to 47 of the address, the second by bits 16 to 31. Writers hold the mutex;
# the marking thread reads without it, and a descriptor is complete before the table shows it.

func _table_insert(key, d) {
    let h = _heap()
    if (ld64(h + H_TABLE) == 0) {
        let top = calloc(65536, 8)
        if (top == 0) {
            _die_oom()
        }
        st64a(h + H_TABLE, top)
    }
    let slot = ld64(h + H_TABLE) + shr(key, 16) * 8
    let l2 = ld64(slot)
    if (l2 == 0) {
        l2 = calloc(65536, 8)
        if (l2 == 0) {
            _die_oom()
        }
        st64a(slot, l2)
    }
    st64a(l2 + band(key, 65535) * 8, d)
}

func _table_find(key) {
    let h = _heap()
    let top = ld64a(h + H_TABLE)
    if (top == 0) {
        return 0
    }
    let l2 = ld64a(top + shr(key, 16) * 8)
    if (l2 == 0) {
        return 0
    }
    return ld64a(l2 + band(key, 65535) * 8)
}

func _note_heap(lo, n) {
    let h = _heap()
    if (ult(lo, ld64(h + H_HEAP_LO))) {
        st64a(h + H_HEAP_LO, lo)
    }
    if (ugt(lo + n, ld64(h + H_HEAP_HI))) {
        st64a(h + H_HEAP_HI, lo + n)
    }
}

# A growable array of words (calloc, never scanned): { buf, n, cap } at p.
func _arr_push(p, v) {
    if (ld64(p + 8) == ld64(p + 16)) {
        let cap = ld64(p + 16) * 2
        if (cap == 0) {
            cap = 64
        }
        let buf = realloc(ld64(p), cap * 8)
        if (buf == 0) {
            _die_oom()
        }
        st64(p, buf)
        st64(p + 16, cap)
    }
    st64(ld64(p) + ld64(p + 8) * 8, v)
    st64(p + 8, ld64(p + 8) + 1)
}

func _arr_pop(p) {
    if (ld64(p + 8) == 0) {
        return 0
    }
    st64(p + 8, ld64(p + 8) - 1)
    return ld64(ld64(p) + ld64(p + 8) * 8)
}

func _list(i) {
    if (i >= L_TIGHT) {
        return _heap() + H_LISTS2 + (i - L_TIGHT) * 24
    }
    return _heap() + H_LISTS + i * 24
}

# Chunks

# Maps a 2 MB chunk aligned to 2 MB, asks for huge pages and touches it, so that the kernel has zeroed
# and attached the memory when this returns. Returns 0 when the system has no memory left. The first
# touch of a huge page can take milliseconds, which is why the helper thread does it ahead of time. hint is
# 0 once the helper has failed to keep up with huge pages (see _chunk_new).
func _chunk_make(hint) {
    let raw = mmap(0, CHUNK_SIZE * 2, 3, 34, -1, 0)    # read and write, private and anonymous
    if (raw == -1 or raw == 0) {
        return 0
    }
    let base = band(raw + CHUNK_SIZE - 1, bnot(CHUNK_SIZE - 1))
    if (base > raw) {
        munmap(raw, base - raw)
    }
    let tail = raw + CHUNK_SIZE * 2 - (base + CHUNK_SIZE)
    if (tail > 0) {
        munmap(base + CHUNK_SIZE, tail)
    }
    _chunk_touch(base, hint)
    return base
}

# Asks for a huge page for the chunk at base (or for small pages) and touches it.
func _chunk_touch(base, hint) {
    if (hint != 0) {
        madvise(base, CHUNK_SIZE, 14)    # MADV_HUGEPAGE: a hint, ignored where unsupported
    } else {
        madvise(base, CHUNK_SIZE, 15)    # MADV_NOHUGEPAGE
    }
    st8(base, 0)
}

# The arena: address space for ARENA_CHUNKS chunks, mapped by the helper in one piece and handed out a chunk at
# a time. A chunk cut from it needs no call into the kernel, so a program thread that finds no chunk ready
# does not wait for the kernel's lock on the address space (held for milliseconds by another thread's munmap
# or first touch of a huge page: 5 ms measured). The first page is touched at once: a mapping that has been
# touched takes its later page faults without that lock.

# The next chunk of the arena, or 0 when it is used up. PRE_MUTEX held.
func _arena_slice(pre) {
    let base = ld64(pre + PRE_ARENA)
    if (base == ld64(pre + PRE_ARENA_END)) {
        return 0
    }
    st64(pre + PRE_ARENA, base + CHUNK_SIZE)
    return base
}

# The descriptor that goes with the chunk _arena_slice just returned. PRE_MUTEX held.
func _arena_desc(pre) {
    let cd = ld64(pre + PRE_DESCS)
    st64(pre + PRE_DESCS, cd + DESC_STEP)
    return cd
}

# Maps a new arena. Helper thread, PRE_MUTEX not held. Returns 0 when the system has no address space left.
func _arena_grow(pre) {
    let size = ARENA_CHUNKS * CHUNK_SIZE
    let raw = mmap(0, size + CHUNK_SIZE, 3, 34, -1, 0)    # read and write, private and anonymous
    if (raw == -1 or raw == 0) {
        return 0
    }
    let base = band(raw + CHUNK_SIZE - 1, bnot(CHUNK_SIZE - 1))
    if (base > raw) {
        munmap(raw, base - raw)
    }
    let tail = raw + size + CHUNK_SIZE - (base + size)
    if (tail > 0) {
        munmap(base + size, tail)
    }
    st8(base, 0)
    # The descriptors of its chunks, mapped with it: calloc on the program thread took 1.5 ms once (it may
    # call into the kernel, or wait for another thread's calloc).
    let descs = mmap(0, ARENA_CHUNKS * DESC_STEP, 3, 34, -1, 0)
    if (descs == -1 or descs == 0) {
        munmap(base, size)
        return 0
    }
    st8(descs, 0)
    pthread_mutex_lock(pre + PRE_MUTEX)
    st64(pre + PRE_DESCS, descs)
    st64(pre + PRE_ARENA, base)
    st64(pre + PRE_ARENA_END, base + size)
    pthread_mutex_unlock(pre + PRE_MUTEX)
    return 1
}

# Counts a chunk the helper made and how long it took (ZUE_RT_GC_STATS). A chunk that takes long is the
# kernel compacting memory to find a huge page; the hint goes off only when that starves the program (see
# _chunk_new).
func _pre_judge(pre, dt) {
    st64(pre + PRE_MADE, ld64(pre + PRE_MADE) + 1)
    if (dt > ld64(pre + PRE_MAXNS)) {
        st64(pre + PRE_MAXNS, dt)
    }
    if (dt > SPIKE_NS) {
        st64(pre + PRE_SPIKES, ld64(pre + PRE_SPIKES) + 1)
    }
}

# The helper thread: keeps PRE_WANT chunks ready for the program thread. It sleeps on PRE_COND and holds the
# mutex only to decide whether to sleep, never while it makes a chunk.
func _pre_main(pre) {
    pthread_mutex_lock(pre + PRE_MUTEX)
    while (1 == 1) {
        let tail = ld64a(pre + PRE_TAIL)
        if (tail - ld64a(pre + PRE_HEAD) < ld64a(pre + PRE_WANT)) {
            let base = _arena_slice(pre)
            let cd = 0
            if (base != 0) {
                cd = _arena_desc(pre)
            }
            pthread_mutex_unlock(pre + PRE_MUTEX)
            if (base == 0) {
                if (_arena_grow(pre) == 0) {
                    return 0    # out of memory: the program thread meets it on its own path
                }
                pthread_mutex_lock(pre + PRE_MUTEX)
                continue
            }
            let t0 = _now_ns()
            _chunk_touch(base, ld64a(pre + PRE_HINT))
            # Only the chunk's own time judges the hint: a slow calloc of the descriptor (up to 12 ms seen) is not
            # the hint's cost, and counting it switched huge pages off and cost 15 percent of throughput at 4 GiB.
            _pre_judge(pre, _now_ns() - t0)
            _desc_init(cd, base)
            st64(pre + PRE_RING + (tail % PRE_SLOTS) * 8, cd)
            st64a(pre + PRE_TAIL, tail + 1)
            pthread_mutex_lock(pre + PRE_MUTEX)
        } else {
            pthread_cond_wait(pre + PRE_COND, pre + PRE_MUTEX)
        }
    }
    return 0
}

# A new chunk with its descriptor, in the page table and the list of chunks. Program thread, mutex held.
# The memory comes ready from the helper thread when it has one.
# The descriptor of a new chunk at base, ready to use, or 0 when there is no memory. Its pages are touched here,
# so that the thread that uses it takes no page faults on them. The helper makes descriptors ahead of time:
# calloc on the program thread, with the collector mutex held, took up to 8 ms when other threads were
# allocating and freeing at the same time.
func _desc_make(base) {
    let cd = calloc(1, CD_SIZE)
    if (cd == 0) {
        return 0
    }
    _desc_init(cd, base)
    return cd
}

# Fills in the zeroed descriptor cd for the chunk at base and touches its pages.
func _desc_init(cd, base) {
    for (let off = 0; off < CD_SIZE; off += 4096) {
        st8(cd + off, 0)
    }
    st8(cd + CD_KIND, 1)
    st64(cd + CD_BASE, base)
    for (let i = 0; i < BLOCKS_PER_CHUNK; i++) {
        st8(cd + CD_BLK + i * BI_SIZE + BI_ZERO, 1)
    }
    return cd
}

func _chunk_new() {
    let h = _heap()
    let cd = 0
    let pre = ld64(h + H_PRE)
    if (pre != 0) {
        let head = ld64a(pre + PRE_HEAD)
        if (ld64a(pre + PRE_TAIL) != head) {
            cd = ld64(pre + PRE_RING + (head % PRE_SLOTS) * 8)
            st64a(pre + PRE_HEAD, head + 1)
            st64(pre + PRE_HITS, ld64(pre + PRE_HITS) + 1)
        } else if (ld64a(pre + PRE_WANT) != 0) {
            st64(pre + PRE_MISSES, ld64(pre + PRE_MISSES) + 1)
            # The helper did not keep up HINT_MISSES times: from now on it makes chunks of small pages, which
            # come at once. A slow huge page alone does not switch the hint off: the reserve covers it, and
            # without huge pages the program is slower (15 percent at 4 GiB).
            if (ld64a(pre + PRE_HINT) != 0 and ld64(pre + PRE_MISSES) >= HINT_MISSES) {
                st64(pre + PRE_OFF_AT, ld64a(pre + PRE_MADE))
                st64a(pre + PRE_HINT, 0)
            }
            if (ld64a(pre + PRE_WANT) < PRE_SLOTS) {
                st64a(pre + PRE_WANT, ld64a(pre + PRE_WANT) * 2)    # the program outruns the helper: keep more ready
            }
        } else {
            st64a(pre + PRE_WANT, 2)    # the second chunk has been asked for: from now on keep some ready
        }
        st64a(h + H_PRE_POKE, 1)    # woken by _refill after the mutex is let go (see _wake)
    }
    let t0 = 0
    let t1 = 0
    let t2 = 0
    if (cd == 0) {
        let hint = 1
        if (pre != 0) {
            hint = ld64a(pre + PRE_HINT)
        }
        t0 = _now_ns()
        let made = 0
        if (pre != 0) {
            # a chunk of the helper's arena and its descriptor, without a call into the kernel; the pages
            # of the chunk come as they are used
            pthread_mutex_lock(pre + PRE_MUTEX)
            made = _arena_slice(pre)
            if (made != 0) {
                cd = _arena_desc(pre)
            }
            pthread_mutex_unlock(pre + PRE_MUTEX)
        }
        t1 = _now_ns()
        if (made != 0) {
            _desc_init(cd, made)
        } else {
            made = _chunk_make(hint)
            if (made == 0) {
                _die_oom()
            }
            t1 = _now_ns()
            cd = _desc_make(made)
            if (cd == 0) {
                _die_oom()
            }
        }
        t2 = _now_ns()
    }
    let base = ld64(cd + CD_BASE)
    _arr_push(h + H_CHUNKS, cd)
    # The reserve of ready chunks grows with the heap: one for every RESERVE_PART chunks in use, as many as the
    # ring holds. While the helper is held up in the kernel (a huge page that took 5 to 8 ms to come), the
    # program lives on the reserve; a chunk it has to make itself waits for the same lock in the kernel
    # (5 ms measured, mutex held). --gc=lowmem keeps the small reserve.
    if (pre != 0 and ld64(h + H_LOWMEM) == 0 and ld64a(pre + PRE_WANT) != 0) {
        let want = ld64(h + H_CHUNKS + 8) / RESERVE_PART
        if (want > PRE_SLOTS) {
            want = PRE_SLOTS
        }
        if (want > ld64a(pre + PRE_WANT)) {
            st64a(pre + PRE_WANT, want)
        }
    }
    _note_heap(base, CHUNK_SIZE)
    for (let off = 0; off < CHUNK_SIZE; off += PAGE_SIZE) {
        _table_insert(shr(base + off, PAGE_SHIFT), cd)
    }
    # The longest chunk the program thread made itself, by its parts (ZUE_RT_GC_STATS).
    if (t0 != 0 and pre != 0 and _now_ns() - t0 > ld64(pre + PRE_OWN_NS)) {
        st64(pre + PRE_OWN_NS, _now_ns() - t0)
        st64(pre + PRE_OWN_MAP, t1 - t0)
        st64(pre + PRE_OWN_DESC, t2 - t1)
    }
    return cd
}

func _block_info(cd, bi) {
    return cd + CD_BLK + bi * BI_SIZE
}

# Granule bitmaps. Bit g of a map is bit (g & 7) of byte g >> 3.

func _bit_set(map, g) {
    let p = map + shr(g, 3)
    st8a(p, bor(ld8(p), shl(1, band(g, 7))))
}

func _bit_clear(map, g) {
    let p = map + shr(g, 3)
    st8a(p, band(ld8(p), bnot(shl(1, band(g, 7)))))
}

# The start of the object that granule g of a chunk falls in, searching back to the start of the block, or -1.
func _obj_start(cd, g) {
    let map = cd + CD_START
    let lo = shr(band(g, bnot(GRANS_PER_BLOCK - 1)), 3)
    let i = shr(g, 3)
    let b = band(ld8a(map + i), shl(2, band(g, 7)) - 1)
    if (b != 0) {
        return i * 8 + ld8(addr_of("_hibit") + b)
    }
    i--
    while (i >= lo) {
        if (band(i, 7) == 7 and ld64a(map + i - 7) == 0) {
            i -= 8
            continue
        }
        b = ld8a(map + i)
        if (b != 0) {
            return i * 8 + ld8(addr_of("_hibit") + b)
        }
        i--
    }
    return -1
}

# The last granule of the object that starts at granule s: the first end bit at or after s, in its block.
func _obj_end(cd, s) {
    let map = cd + CD_END
    let hi = shr(band(s, bnot(GRANS_PER_BLOCK - 1)) + GRANS_PER_BLOCK, 3)
    let i = shr(s, 3)
    let b = band(ld8a(map + i), bnot(shl(1, band(s, 7)) - 1))
    if (b != 0) {
        return i * 8 + ld8(addr_of("_lobit") + b)
    }
    i++
    while (i < hi) {
        if (band(i, 7) == 0 and ld64a(map + i) == 0) {
            i += 8
            continue
        }
        b = ld8a(map + i)
        if (b != 0) {
            return i * 8 + ld8(addr_of("_lobit") + b)
        }
        i++
    }
    _invariant_fail(cstr("an object start without an end"))
    return -1
}

# The object that w points into: its descriptor (a chunk or a large object), or 0. For a chunk the object's
# first granule is left at slot and its size at slot + 8; for a large object its size at slot + 8.
func _find(w, slot) {
    let h = _heap()
    if (ult(w, ld64a(h + H_HEAP_LO)) or uge(w, ld64a(h + H_HEAP_HI))) {
        return 0
    }
    let d = _table_find(shr(w, PAGE_SHIFT))
    if (d == 0) {
        return 0
    }
    if (ld8(d) == 2) {
        if (ult(w, ld64(d + LD_BASE)) or uge(w, ld64(d + LD_BASE) + ld64(d + LD_OBJ))) {
            return 0
        }
        st64(slot + 8, ld64(d + LD_OBJ))
        return d
    }
    let off = w - ld64(d + CD_BASE)
    if (ld8a(_block_info(d, shr(off, BLOCK_SHIFT)) + BI_KIND) == 0) {
        return 0
    }
    let g = shr(off, 4)
    let s = _obj_start(d, g)
    if (s < 0) {
        return 0
    }
    let e = _obj_end(d, s)
    if (e < g) {
        return 0
    }
    st64(slot, s)
    st64(slot + 8, (e - s + 1) * GRAN)
    return d
}

# Sets the mark bit of the object at granule s; 0 when it was set already (by this or another thread).
func _mark_bit(cd, s) {
    let p = cd + CD_MARK + shr(s, 3)
    let bit = shl(1, band(s, 7))
    while (1 == 1) {
        let old = ld8a(p)
        if (band(old, bit) != 0) {
            return 0
        }
        if (cas8(p, old, bor(old, bit)) != 0) {
            return 1
        }
    }
    return 0
}

# The lines of the object at granules s to s + n / GRAN - 1 are live in this cycle.
func _mark_lines(cd, s, n) {
    let e = _heap() + H_EPOCH
    let first = shr(s, 3)
    let last = shr(s + n / GRAN - 1, 3)
    let ep = ld64(e)
    for (let l = first; l <= last; l++) {
        if (ld8a(cd + CD_LINES + l) != ep) {
            st8a(cd + CD_LINES + l, ep)
        }
    }
}

# An object allocated while a cycle marks survives it: its bit in the map of new objects counts as a mark, and
# its lines are live in the cycle. The marker never scans it: what it points to was reachable at the snapshot or
# is new too. Only the program thread writes this map, so the bit needs no compare-and-swap.
func _born_marked(cd, g, n) {
    _bit_set(cd + CD_NEW, g)
    _mark_lines(cd, g, n)
}

# Whether the object at granule s survives the cycle: marked, or allocated during it.
func _is_live(cd, s) {
    return band(bor(ld8a(cd + CD_MARK + shr(s, 3)), ld8a(cd + CD_NEW + shr(s, 3))), shl(1, band(s, 7)))
}

# Allocation

# Adds what the calling worker allocated to the total and gives it a new budget (WK_LIMIT): the bytes it may
# allocate before it looks at the collector again. Between two cycles that is its share of what is left up to
# the threshold; while a cycle runs, STEP_BYTES; -1 when every allocation is to be counted (stress mode); out
# of reach while this worker drives the collector or the collector has not started.
func _set_limit() {
    let h = _heap()
    let wk = _wk()
    let mine = ld64(wk + WK_BYTES)
    if (mine != 0) {
        xadd64(h + H_BYTES_SINCE_GC, mine)
        st64(wk + WK_BYTES, 0)
    }
    st64(wk + WK_LIMIT, 4611686018427387904)
    if (ld64(h + H_GC_READY) != 0 and ld64(wk + WK_DRIVER) == 0) {
        let budget = STEP_BYTES
        if (ld64(h + H_MARKING) == 0 and ld64a(h + H_SWEEPING) == 0) {
            let workers = ld64a(h + H_NWORKERS)
            if (workers == 0) {
                workers = 1
            }
            let left = (ld64a(h + H_THRESHOLD) - ld64a(h + H_BYTES_SINCE_GC)) / workers
            if (left > budget) {
                budget = left
            }
        }
        if (ld64(h + H_STRESS_EVERY) != 0) {
            budget = -1
        }
        st64(wk + WK_LIMIT, budget)
    }
}

# The slow part of an allocation: whether it is time to collect. One worker at a time drives the collector;
# another one that comes here meanwhile stops if the driver asks for it, and is held back like the driver when
# the program allocates faster than the collector marks.
func _gc_check() {
    let h = _heap()
    let wk = _wk()
    let count = xadd64(h + H_ALLOC_COUNT, 1) + 1
    let mine = ld64(wk + WK_BYTES)
    if (mine != 0) {
        xadd64(h + H_BYTES_SINCE_GC, mine)
        st64(wk + WK_BYTES, 0)
    }
    if (ld64(h + H_GC_READY) != 0 and ld64(wk + WK_DRIVER) == 0) {
        if (cas64(h + H_GC_BUSY, 0, 1) != 0) {
            st64(wk + WK_DRIVER, 1)
            if (ld64(h + H_MARKING) != 0 or ld64a(h + H_SWEEPING) != 0) {
                _gc_work()
            } else if (ld64a(h + H_BYTES_SINCE_GC) > ld64a(h + H_THRESHOLD) or (ld64(h + H_STRESS_EVERY) != 0 and count % ld64(h + H_STRESS_EVERY) == 0)) {
                _gc_work()
            }
            st64(wk + WK_DRIVER, 0)
            st64a(h + H_GC_BUSY, 0)
        } else {
            _gc_poll()
            if (ld64(h + H_MARKING) != 0) {
                _throttle(0)
            }
        }
    }
    _set_limit()
}

# Safe points

# A safe point: the calling worker stops here while the driver asks for it, and for good once the program is
# ending. Reached from a call or the head of a loop whose stack test failed (lvp_stack_slow) and from the slow
# part of an allocation.
func _gc_poll() {
    let h = _heap()
    if (ld64a(h + H_STW) != 0 or ld64a(h + H_DYING) != 0) {
        if (ld64(_wk() + WK_DRIVER) == 0) {
            _gc_park()
        }
    }
    return 0
}

# Kept out of line, with every callee-saved register spilled into its frame, so that the driver, which scans
# this worker's stack from WK_SP up, finds the values held only in registers.
func _gc_park() {
    spill_regs()
    let wk = _wk()
    st64(wk + WK_SP, stack_ptr())
    _wk_wait(wk)
    return 0
}

# The calling worker is stopped (WK_SP is set) until no stop is asked for. A program that is ending never
# lets it go on.
func _wk_wait(wk) {
    let h = _heap()
    while (1 == 1) {
        st64a(wk + WK_STATE, 1)
        let spins = 0
        while (ld64a(h + H_STW) != 0 or ld64a(h + H_DYING) != 0) {
            if (ld64a(h + H_DYING) != 0) {
                pause()
            }
            spins += 1
            if (spins > 2000) {
                sched_yield()
            }
        }
        st64a(wk + WK_STATE, 0)
        fence()
        if (ld64a(h + H_STW) == 0 and ld64a(h + H_DYING) == 0) {
            return 0
        }
    }
    return 0
}

# Around a call that may wait for long (input, a command, sleeping until there is work): the worker counts as
# stopped, so that a cycle can begin and end without it. The caller has spilled its registers (spill_regs) and
# passes its stack pointer; between the two calls it does not touch the heap or a Zue value.
func _safe_enter(sp) {
    let wk = _wk()
    st64(wk + WK_SP, sp)
    st64a(wk + WK_STATE, 1)
    return 0
}

func _safe_leave() {
    let h = _heap()
    let wk = _wk()
    st64a(wk + WK_STATE, 0)
    fence()
    if (ld64a(h + H_STW) != 0 or ld64a(h + H_DYING) != 0) {
        _wk_wait(wk)
    }
    return 0
}

# The driver stops every other worker: it asks, raises their stack limits so that their next call or loop head
# comes to lvp_stack_slow, and waits until each is at a safe point. A worker restores its limit before it
# looks at H_STW, and H_STW is set before the limits are raised, so no request is lost. The driver holds no
# lock while it waits: a worker may need one to reach its safe point.
func _stw_begin() {
    let h = _heap()
    let me = _wk()
    st64a(h + H_STW, 1)
    fence()
    let n = ld64a(h + H_NWORKERS)
    let tab = ld64(h + H_WORKERS)
    for (let i = 0; i < n; i++) {
        let w = ld64(tab + i * 8)
        if (w != me) {
            st64a(ld64(w + WK_LOW_P), -1)
        }
    }
    for (let i = 0; i < n; i++) {
        let w = ld64(tab + i * 8)
        if (w != me) {
            let spins = 0
            while (ld64a(w + WK_STATE) == 0) {
                spins += 1
                if (spins > 2000) {
                    sched_yield()
                }
            }
        }
    }
    return n
}

func _stw_end() {
    st64a(_heap() + H_STW, 0)
    return 0
}

# The program ends, or reports an error and ends: the other workers stop at their next safe point and stay
# there, so that they print nothing more. Returns 0 when another worker got here first: that one ends the
# program, and the caller waits for it.
func lv_gc_dying() {
    let h = _heap()
    if (cas64(h + H_DYING, 0, 1) == 0) {
        return 0
    }
    let me = _wk()
    st64(me + WK_DRIVER, 1)    # it stops at no safe point and drives no cycle from here on
    let n = ld64a(h + H_NWORKERS)
    let tab = ld64(h + H_WORKERS)
    for (let i = 0; i < n; i++) {
        let w = ld64(tab + i * 8)
        if (w != me) {
            st64a(ld64(w + WK_LOW_P), -1)
        }
    }
    return 1
}

# The allocation that almost every call is: an object that fits the gap of its allocator, and no collector
# work due. A gap is cleared when it is taken, so the object is already zero. It is kept short on purpose:
# _slow_gc_alloc takes gaps and blocks, runs collector steps and allocates large objects.
func _gc_alloc(size, atomic) {
    let h = _heap()
    let n = band(size + GRAN, -GRAN)    # one byte more than asked (a pointer just past the end stays inside), whole granules
    let wk = _wk()
    if (ule(size, MAX_MEDIUM - GRAN) and ld64(wk + WK_BYTES) <= ld64(wk + WK_LIMIT)) {
        let a = wk + WK_ALLOC + atomic * (2 * AL_SIZE)
        let left = ld64(a + AL_LEFT)
        if (ule(n, left)) {
            let off = ld64(a + AL_OFF)
            st64(a + AL_OFF, off + n)
            st64(a + AL_LEFT, left - n)
            let cd = ld64(a + AL_CD)
            let g = ld64(a + AL_G0) + shr(off, 4)
            _bit_set(cd + CD_START, g)
            _bit_set(cd + CD_END, g + shr(n, 4) - 1)
            if (ld64(h + H_MARKING) != 0) {
                _born_marked(cd, g, n)
            }
            st64(wk + WK_BYTES, ld64(wk + WK_BYTES) + n)
            return shl(ld64(a + AL_BLOCK), BLOCK_SHIFT) + off
        }
    }
    return _slow_gc_alloc(size, atomic)
}

# A block for allocator kind k (1 normal, 2 atomic): a recyclable one of that kind unless only a free block
# will do, then one the program sweeps itself while the GC thread's sweep is still on, then a free one
# (_take_free). Mutex held. Returns the block's address.
func _take_block(k, free_only, n) {
    let h = _heap()
    if (free_only == 0) {
        # Only objects of at most a line come here, so any block on L_RECYC fits. A block on L_TIGHT is taken when
        # its largest gap fits this request; only the top one is looked at, so taking a block never searches
        # (searching every block for a gap that fits took up to 15 ms in one allocation).
        let b = _arr_pop(_list(L_RECYC + k - 1))
        if (b != 0) {
            return b
        }
        let t = _list(L_TIGHT + k - 1)
        if (ld64(t + 8) != 0 and _fits(ld64(ld64(t) + (ld64(t + 8) - 1) * 8), n) != 0) {
            return _arr_pop(t)
        }
    }
    # At most one block: a program that sweeps until it finds room can sweep thousands of full blocks in one stop.
    let b = 0
    if (ld64(h + H_SWEEPING) != 0 and ld64(h + H_SW_DONE) == 0) {
        b = _sweep_claim()
    }
    if (b != 0) {
        _unlock()
        let cd = _table_find(shr(b, PAGE_SHIFT))
        let bi = shr(b - ld64(cd + CD_BASE), BLOCK_SHIFT)
        let free_lines = _sweep_block(cd, bi)
        _lock_prog(1)
        let info = _block_info(cd, bi)
        if (free_lines == LINES_PER_BLOCK) {
            st8a(info + BI_KIND, 0)
            return _block_ready(b, k)
        }
        if (free_only == 0 and _fits(b, n) != 0 and ld8(info + BI_KIND) == k) {
            return b
        }
        _recycle(b, info)
    }
    return _take_free(k)
}

# A free block, then one whose memory was given back, then a new one cut from a chunk. Mutex held.
func _take_free(k) {
    let h = _heap()
    let b = _arr_pop(_list(L_FREE))
    if (b == 0) {
        b = _arr_pop(_list(L_COLD))
    }
    if (b == 0) {
        let cd = ld64(h + H_FRESH_CD)
        if (cd == 0 or ld64(h + H_FRESH_USED) == BLOCKS_PER_CHUNK) {
            cd = _chunk_new()
            st64(h + H_FRESH_CD, cd)
            st64(h + H_FRESH_USED, 0)
        }
        b = ld64(cd + CD_BASE) + ld64(h + H_FRESH_USED) * BLOCK
        st64(h + H_FRESH_USED, ld64(h + H_FRESH_USED) + 1)
    }
    return _block_ready(b, k)
}

# A free block becomes a block of kind k. The sweep that may be running skips it.
func _block_ready(b, k) {
    let h = _heap()
    let cd = _table_find(shr(b, PAGE_SHIFT))
    let info = _block_info(cd, shr(b - ld64(cd + CD_BASE), BLOCK_SHIFT))
    st8(info + BI_SWEPT, ld64(h + H_SW_EPOCH))
    st8(info + BI_COLD, 0)
    st8a(info + BI_KIND, k)
    return b
}

# The first object start at or after granule p and before hi (granules of a chunk), or hi when there is none.
func _next_start(cd, p, hi) {
    let map = cd + CD_START
    let i = shr(p, 3)
    let last = shr(hi, 3)
    let b = band(ld8a(map + i), bnot(shl(1, band(p, 7)) - 1))
    if (b != 0) {
        return i * 8 + ld8(addr_of("_lobit") + b)
    }
    i++
    while (i < last) {
        if (band(i, 7) == 0 and i + 8 <= last and ld64a(map + i) == 0) {
            i += 8
            continue
        }
        b = ld8a(map + i)
        if (b != 0) {
            return i * 8 + ld8(addr_of("_lobit") + b)
        }
        i++
    }
    return hi
}

# Moves allocator a to the next gap of its block, from granule p of the chunk on, that holds at least n bytes:
# returns 1 when it found one. A gap is the space between two live objects (the sweep took the bits of the
# dead ones away). It is cleared here unless the block is still all zero.
func _next_gap(a, p, n) {
    let cd = ld64(a + AL_CD)
    let g0 = ld64(a + AL_G0)
    let hi = g0 + GRANS_PER_BLOCK
    while (p < hi) {
        let q = _next_start(cd, p, hi)
        if ((q - p) * GRAN >= n) {
            let info = _block_info(cd, shr(g0, 11))
            let off = (p - g0) * GRAN
            if (ld8(info + BI_ZERO) == 0) {
                memset(shl(ld64(a + AL_BLOCK), BLOCK_SHIFT) + off, 0, (q - p) * GRAN)
            }
            st8(info + BI_ZERO, 0)
            st64(a + AL_OFF, off)
            st64(a + AL_LEFT, (q - p) * GRAN)
            return 1
        }
        if (q >= hi) {
            return 0
        }
        p = _obj_end(cd, q) + 1
    }
    return 0
}

# Gives allocator a (kind k) a gap of at least n bytes. The search goes on after the end of the current gap,
# which is the start of an object or the end of the block.
func _refill(a, k, n, free_only) {
    let h = _heap()
    if (ld64(a + AL_BLOCK) != 0) {
        let from = ld64(a + AL_G0) + shr(ld64(a + AL_OFF) + ld64(a + AL_LEFT), 4)
        if (_next_gap(a, from, n) != 0) {
            return 0
        }
    }
    while (1 == 1) {
        _lock_prog(2)
        let b = _take_block(k, free_only, n)
        _unlock()
        if (ld64a(h + H_PRE_POKE) != 0) {
            st64a(h + H_PRE_POKE, 0)
            let pre = ld64(h + H_PRE)
            pthread_mutex_lock(pre + PRE_MUTEX)
            pthread_cond_signal(pre + PRE_COND)
            pthread_mutex_unlock(pre + PRE_MUTEX)
        }
        let cd = _table_find(shr(b, PAGE_SHIFT))
        st64(a + AL_BLOCK, shr(b, BLOCK_SHIFT))
        st64(a + AL_CD, cd)
        st64(a + AL_G0, shr(b - ld64(cd + CD_BASE), 4))
        st64(a + AL_OFF, 0)
        st64(a + AL_LEFT, 0)
        if (_next_gap(a, ld64(a + AL_G0), n) != 0) {
            return 0
        }
    }
    return 0
}

func _slow_gc_alloc(size, atomic) {
    let h = _heap()
    if (ld64(h + H_SETUP_DONE) == 0) {
        _gc_setup()
    }
    if (ugt(size, 70368744177664)) {
        _die_oom()    # more than 64 TiB: no request like that can be met, and size + 16 would wrap
    }
    let n = band(size + GRAN, -GRAN)
    let wk = _wk()
    if (ld64(wk + WK_BYTES) > ld64(wk + WK_LIMIT)) {
        _gc_check()
    }
    if (n > MAX_MEDIUM) {
        return _alloc_large(size + 1, atomic)
    }
    let a = wk + WK_ALLOC + atomic * (2 * AL_SIZE)
    if (ugt(n, ld64(a + AL_LEFT))) {
        if (n > LINE) {
            # A medium object that does not fit the gap: the overflow allocator takes it, so the gaps of
            # the block are not skipped for it.
            a = a + AL_SIZE
            if (ugt(n, ld64(a + AL_LEFT))) {
                _refill(a, atomic + 1, n, 1)
            }
        } else {
            _refill(a, atomic + 1, n, 0)
        }
    }
    let off = ld64(a + AL_OFF)
    st64(a + AL_OFF, off + n)
    st64(a + AL_LEFT, ld64(a + AL_LEFT) - n)
    let cd = ld64(a + AL_CD)
    let g = ld64(a + AL_G0) + shr(off, 4)
    _bit_set(cd + CD_START, g)
    _bit_set(cd + CD_END, g + shr(n, 4) - 1)
    if (ld64(h + H_MARKING) != 0) {
        _born_marked(cd, g, n)
    }
    st64(wk + WK_BYTES, ld64(wk + WK_BYTES) + n)
    return shl(ld64(a + AL_BLOCK), BLOCK_SHIFT) + off
}

# An object over MAX_MEDIUM gets its own span, rounded up to whole 64 KB pages and aligned to them. A fresh
# mapping is zeroed by the kernel and touched only when used.
func _alloc_large(n, atomic) {
    let h = _heap()
    let span = band(n + PAGE_SIZE - 1, bnot(PAGE_SIZE - 1))
    let raw = mmap(0, span + PAGE_SIZE, 3, 34, -1, 0)    # read and write, private and anonymous
    if (raw == -1 or raw == 0) {
        _die_oom()
    }
    let mem = band(raw + PAGE_SIZE - 1, bnot(PAGE_SIZE - 1))
    if (mem > raw) {
        munmap(raw, mem - raw)
    }
    munmap(mem + span, raw + PAGE_SIZE - mem)
    let d = calloc(1, LD_SIZE)
    if (d == 0) {
        _die_oom()
    }
    st8(d + LD_KIND, 2)
    st8(d + LD_ATOMIC, atomic)
    st8(d + LD_MARK, ld64(h + H_MARKING))    # allocated during a cycle: survives it
    st64(d + LD_BASE, mem)
    st64(d + LD_OBJ, n)
    st64(d + LD_SPAN, span)
    _lock_prog(3)
    _note_heap(mem, span)
    for (let off = 0; off < span; off += PAGE_SIZE) {
        _table_insert(shr(mem + off, PAGE_SHIFT), d)
    }
    _arr_push(h + H_LARGE, d)
    st64(h + H_LARGE_BYTES, ld64(h + H_LARGE_BYTES) + span)
    _unlock()
    let wk = _wk()
    st64(wk + WK_BYTES, ld64(wk + WK_BYTES) + n)
    return mem
}

func lv_alloc(n) {
    return _gc_alloc(n, 0)
}

func lv_alloc_atomic(n) {
    return _gc_alloc(n, 1)
}

# Memory outside the heap whose life the collector decides: the bytes of a box that a template owns,
# freed after the cycle that finds the template dead. They count like an allocation, so that a program
# that makes many such boxes starts cycles (a template and its 64 KiB box add only about 100 heap bytes).
func lv_gc_note_external(n) {
    let h = _heap()
    if (ld64(h + H_SETUP_DONE) == 0) {
        return 0
    }
    let wk = _wk()
    st64(wk + WK_BYTES, ld64(wk + WK_BYTES) + n)
    if (ld64(wk + WK_BYTES) > ld64(wk + WK_LIMIT)) {
        _gc_check()
    }
}

func lv_realloc(p, n) {
    if (p == 0) {
        return _gc_alloc(n, 0)
    }
    let slot = _wk() + WK_SLOT
    let d = _find(p, slot)
    if (d == 0) {
        _die_oom()
    }
    let old = ld64(slot + 8)
    let atomic = 0
    if (ld8(d) == 2) {
        atomic = ld8(d + LD_ATOMIC)
    } else if (ld8a(_block_info(d, shr(p - ld64(d + CD_BASE), BLOCK_SHIFT)) + BI_KIND) == 2) {
        atomic = 1
    }
    let q = _gc_alloc(n, atomic)
    let m = n
    if (old < n) {
        m = old
    }
    memcpy(q, p, m)
    return q
}

# Marking

func _marker(i) {
    return ld64(_heap() + H_MARKERS) + i * MK_SIZE
}

# The marker of the program thread: it marks the roots at the start of a cycle and runs the verifier, while the
# marking threads wait.
func _prog_marker() {
    return _marker(ld64(_heap() + H_NMARK))
}

# Makes room for k more items on the mark stack of marker mk.
func _reserve(mk, k) {
    let need = ld64(mk + MK_TOP) + k
    if (need <= ld64(mk + MK_CAP)) {
        return 0
    }
    let cap = ld64(mk + MK_CAP) * 2
    if (cap == 0) {
        cap = 4096
    }
    while (cap < need) {
        cap = cap * 2
    }
    st64(mk + MK_GROW, ld64(mk + MK_GROW) + 1)
    st64(mk + MK_STACK, realloc(ld64(mk + MK_STACK), cap * 16))
    if (ld64(mk + MK_STACK) == 0) {
        _die_oom()
    }
    st64(mk + MK_CAP, cap)
    return 0
}

func _push(mk, p, n) {
    let top = ld64(mk + MK_TOP)
    if (top == ld64(mk + MK_CAP)) {
        _reserve(mk, 1)
    }
    let item = ld64(mk + MK_STACK) + top * 16
    st64(item, p)
    st64(item + 8, n)
    st64(mk + MK_TOP, top + 1)
}

# Marks the object w points into and returns its address when it is to be scanned (not atomic and not
# marked before), else 0. Its size is left at slot + 8.
func _mark_find(w, slot) {
    let h = _heap()
    let d = _find(w, slot)
    if (d == 0) {
        return 0
    }
    if (ld8(d) == 2) {
        if (ld64(h + H_VMODE) != 0) {
            return _vmark_large(d)
        }
        let m = d + LD_MARK
        if (ld8a(m) != 0 or cas8(m, 0, 1) == 0) {
            return 0
        }
        st64(slot + 16, ld64(slot + 16) + ld64(d + LD_OBJ))
        if (ld8(d + LD_ATOMIC) != 0) {
            return 0
        }
        return ld64(d + LD_BASE)
    }
    let s = ld64(slot)
    let n = ld64(slot + 8)
    if (ld64(h + H_VMODE) != 0) {
        return _vmark(d, s, n)
    }
    if (band(ld8a(d + CD_NEW + shr(s, 3)), shl(1, band(s, 7))) != 0 or _mark_bit(d, s) == 0) {
        return 0
    }
    _mark_lines(d, s, n)
    st64(slot + 16, ld64(slot + 16) + n)
    if (ld8a(_block_info(d, shr(s, 11)) + BI_KIND) == 2) {
        return 0
    }
    return ld64(d + CD_BASE) + s * GRAN
}

# Marks the object w points into and queues it for scanning on the mark stack of marker mk.
func _mark_word(mk, w) {
    let slot = mk + MK_SLOT
    let p = _mark_find(w, slot)
    if (p != 0) {
        _push(mk, p, ld64(slot + 8))
    }
    return 0
}

func _mark_range(mk, lo, hi) {
    let h = _heap()
    let p = band(lo + 7, -8)
    let heap_lo = ld64a(h + H_HEAP_LO)
    let heap_hi = ld64a(h + H_HEAP_HI)
    while (ule(p + 8, hi)) {
        let w = ld64(p)
        if (uge(w, heap_lo) and ult(w, heap_hi)) {    # most words (tags, ints) are not heap addresses: skip the call
            _mark_word(mk, w)
        }
        p += 8
    }
}

# Marking by the program thread while the marking threads wait: the roots at the start of a cycle, the verifier.
func _scan_range(lo, hi) {
    _mark_range(_prog_marker(), lo, hi)
}

# Marking by a worker while the marking threads run: the barrier. The object is marked here, so that it
# is queued once, and handed over in batches.
func _shade_word(w) {
    let slot = _wk() + WK_SLOT
    let p = _mark_find(w, slot)
    if (p != 0) {
        _local_add(p, ld64(slot + 8))
    }
    return 0
}

func _shade_range(lo, hi) {
    let h = _heap()
    let p = band(lo + 7, -8)
    let heap_lo = ld64a(h + H_HEAP_LO)
    let heap_hi = ld64a(h + H_HEAP_HI)
    while (ule(p + 8, hi)) {
        let w = ld64(p)
        if (uge(w, heap_lo) and ult(w, heap_hi)) {
            _shade_word(w)
        }
        p += 8
    }
}

# The calling worker's batch of marked objects the marking threads have to scan.
func _local_add(p, n) {
    let wk = _wk()
    let i = ld64(wk + WK_LOCAL_N)
    st64(wk + WK_LOCAL_BUF + i * 16, p)
    st64(wk + WK_LOCAL_BUF + i * 16 + 8, n)
    st64(wk + WK_LOCAL_N, i + 1)
    if (i + 1 == LOCAL_CAP) {
        _lock_prog(4)
        let w = _hand_over(wk)
        _unlock()
        _wake(w)
    }
}

# Adds k mark items to the pool. Mutex held. Returns 1 when a marker waits for work: the caller wakes one with
# _wake after it lets the mutex go. A marker that takes work and leaves some wakes the next (_pool_take), so
# they do not all run for the mutex at once. H_SHARED_N and H_IDLE are written with atomic stores: a busy marker
# reads them without the mutex to see whether to give work away.
func _pool_add(src, k) {
    let h = _heap()
    if (k == 0) {
        return 0
    }
    let need = ld64(h + H_SHARED_N) + k
    if (need > ld64(h + H_SHARED_CAP)) {
        let cap = ld64(h + H_SHARED_CAP) * 2
        if (cap < need) {
            cap = need + 1024
        }
        st64(h + H_SHARED_BUF, realloc(ld64(h + H_SHARED_BUF), cap * 16))
        if (ld64(h + H_SHARED_BUF) == 0) {
            _die_oom()
        }
        st64(h + H_SHARED_CAP, cap)
    }
    memcpy(ld64(h + H_SHARED_BUF) + ld64(h + H_SHARED_N) * 16, src, k * 16)
    st64a(h + H_SHARED_N, need)
    if (ld64(h + H_GCT_STATE) == 2) {
        st64a(h + H_GCT_STATE, 1)
    }
    if (ld64(h + H_IDLE) != 0) {
        return 1
    }
    return 0
}

# Wakes one marker that waits, when w is 1. Called after the mutex is let go: a thread woken while the waker
# still holds it often runs at once on the waker's core, and the waker, with the mutex, waits for its turn
# (measured: the program thread then waited up to 3 ms for a new block).
func _wake(w) {
    if (w != 0) {
        pthread_cond_signal(_heap() + H_COND_GC)
    }
}

# Moves the batch of worker wk to the pool. Mutex held; wk is the caller's, or a stopped worker's. Returns what
# _pool_add returns.
func _hand_over(wk) {
    let w = _pool_add(wk + WK_LOCAL_BUF, ld64(wk + WK_LOCAL_N))
    st64(wk + WK_LOCAL_N, 0)
    return w
}

# The batches of every worker go to the pool. Mutex held, the other workers stopped.
func _hand_over_all() {
    let h = _heap()
    let n = ld64a(h + H_NWORKERS)
    let w = 0
    for (let i = 0; i < n; i++) {
        if (_hand_over(ld64(ld64(h + H_WORKERS) + i * 8)) != 0) {
            w = 1
        }
    }
    return w
}

# Marker mk, out of work, takes its share of the pool: the items divided by the number of markers, at least one.
# Mutex held. Returns 1 when items are left and another marker waits, to be woken after the mutex is let go.
func _pool_take(mk) {
    let h = _heap()
    let n = ld64(h + H_SHARED_N)
    let k = (n + ld64(h + H_NMARK) - 1) / ld64(h + H_NMARK)
    _reserve(mk, k)
    memcpy(ld64(mk + MK_STACK) + ld64(mk + MK_TOP) * 16, ld64(h + H_SHARED_BUF) + (n - k) * 16, k * 16)
    st64(mk + MK_TOP, ld64(mk + MK_TOP) + k)
    st64a(h + H_SHARED_N, n - k)
    if (n - k != 0 and ld64(h + H_IDLE) != 0) {
        return 1
    }
    return 0
}

# A marker that has work while another waits and the pool is empty gives the bottom half of its stack away: the
# oldest items, which are the nearest to the roots and have the most behind them. A large item among them is
# cut in two and one half kept, so the scan of one huge list is shared too (measured before: the rest of a list
# of 5 million rows stayed at the bottom of one stack, the other markers were given about 115 rows at a time,
# and with four markers fewer than two were busy). With one item on the stack, a large one, half of it is given.
func _donate(mk) {
    let h = _heap()
    let k = ld64(mk + MK_TOP) / 2
    if (k == 0) {
        k = 1
    }
    for (let i = 0; i < k; i++) {
        let item = ld64(mk + MK_STACK) + i * 16
        let n = ld64(item + 8)
        if (n > 2 * CHUNK_BYTES) {
            let half = band(n / 2, -16)
            st64(item + 8, half)
            _push(mk, ld64(item) + half, n - half)
        }
    }
    let stack = ld64(mk + MK_STACK)
    let top = ld64(mk + MK_TOP)
    if (top < 2) {
        return 0
    }
    _lock(5)
    let w = _pool_add(stack, k)
    _unlock()
    memmove(stack, stack + k * 16, (top - k) * 16)
    st64(mk + MK_TOP, top - k)
    st64(mk + MK_GIVEN, ld64(mk + MK_GIVEN) + 1)
    st64(mk + MK_GIVEN_N, ld64(mk + MK_GIVEN_N) + k)
    _wake(w)
}

# Write barrier. While a cycle is marking, an object the program is about to overwrite a pointer to is marked
# first, so everything that was reachable when the cycle began is found (snapshot at the beginning). An
# overwritten word that is not a pointer is ignored.

# Before the 16-byte value at p is overwritten.
func lv_wb_cell(p) {
    let h = _heap()
    if (ld64(h + H_MARKING) != 0) {
        _shade_word(ld64(p + 8))
    }
    return 0
}

# Before the pointer stored at p is overwritten.
func lv_wb_word(p) {
    let h = _heap()
    if (ld64(h + H_MARKING) != 0) {
        _shade_word(ld64(p))
    }
    return 0
}

# Before the n bytes at p are overwritten or moved.
func lv_wb_range(p, n) {
    let h = _heap()
    if (ld64(h + H_MARKING) != 0) {
        let q = band(p + 7, -8)
        let e = p + n
        while (ule(q + 8, e)) {
            _shade_word(ld64(q))
            q += 8
        }
    }
    return 0
}

# Scans the piece of the top mark item of marker mk (at most CHUNK_BYTES; the rest stays on the stack) and
# returns the number of words scanned.
func _scan_top(mk) {
    let top = ld64(mk + MK_TOP) - 1
    st64(mk + MK_TOP, top)
    let item = ld64(mk + MK_STACK) + top * 16
    let p = ld64(item)
    let n = ld64(item + 8)
    if (n > CHUNK_BYTES) {
        _push(mk, p + CHUNK_BYTES, n - CHUNK_BYTES)
        n = CHUNK_BYTES
    }
    _mark_range(mk, p, p + n)
    return n / 8
}

# Marks from the program thread's mark stack until it is empty (the verifier).
func _drain() {
    let mk = _prog_marker()
    while (ld64(mk + MK_TOP) != 0) {
        _scan_top(mk)
    }
}

# Marks about GCT_BATCH words from the stack of marker mk, giving half of it away when another marker waits
# and the pool is empty.
func _mark_batch(mk) {
    let h = _heap()
    let work = 0
    while (ld64(mk + MK_TOP) != 0 and work < GCT_BATCH) {
        work += _scan_top(mk)
        if (ld64a(h + H_IDLE) != 0 and ld64a(h + H_SHARED_N) == 0 and ld64(mk + MK_TOP) != 0) {
            if (ld64(mk + MK_TOP) > 1 or ld64(ld64(mk + MK_STACK) + 8) > 2 * CHUNK_BYTES) {
                _donate(mk)
            }
        }
    }
    st64(mk + MK_WORDS, ld64(mk + MK_WORDS) + work)
}

# Roots

func _root_register(lo, hi) {
    let h = _heap()
    if (ld64(h + H_ROOT_COUNT) == ld64(h + H_ROOT_CAP)) {
        if (ld64(h + H_ROOT_CAP) != 0) {
            st64(h + H_ROOT_CAP, ld64(h + H_ROOT_CAP) * 2)
        } else {
            st64(h + H_ROOT_CAP, 64)
        }
        st64(h + H_ROOTS, realloc(ld64(h + H_ROOTS), ld64(h + H_ROOT_CAP) * 16))
        if (ld64(h + H_ROOTS) == 0) {
            _die_oom()
        }
    }
    st64(ld64(h + H_ROOTS) + ld64(h + H_ROOT_COUNT) * 16, lo)
    st64(ld64(h + H_ROOTS) + ld64(h + H_ROOT_COUNT) * 16 + 8, hi)
    st64(h + H_ROOT_COUNT, ld64(h + H_ROOT_COUNT) + 1)
}

# Adds a range that holds Zue values copied from elsewhere. During a cycle it holds what the program put
# there, so it is shaded now, unless the stepwise scan of the roots is still to reach it.
func lv_gc_root_add(lo, hi) {
    let h = _heap()
    _spin_lock(h + H_ROOT_LOCK)
    _root_register(lo, hi)
    if (ld64(h + H_MARKING) != 0 and ld64(h + H_RS_ON) == 0) {
        _shade_range(lo, hi)
    }
    _spin_unlock(h + H_ROOT_LOCK)
}

# Adds a range that is zero filled, so that there is nothing to shade: an unsafe buffer from alloc(n).
# A store into it shades the value it overwrites (the write barrier in _cp), like a store into any object.
func lv_gc_root_add_fresh(lo, hi) {
    let h = _heap()
    _spin_lock(h + H_ROOT_LOCK)
    _root_register(lo, hi)
    _spin_unlock(h + H_ROOT_LOCK)
}

# The rest of range j, which the stepwise scan has not reached yet, is shaded now (the range is about to
# go away, or to change places with another).
func _root_finish(j) {
    let h = _heap()
    if (ld64(h + H_RS_ON) == 0 or j < ld64(h + H_RS_I)) {
        return 0
    }
    let e = ld64(h + H_ROOTS) + j * 16
    let pos = ld64(e)
    if (j == ld64(h + H_RS_I)) {
        pos = ld64(h + H_RS_POS)
    }
    _shade_range(pos, ld64(e + 8))
}

# The lock is held until the range is out of the table: the driver scans the ranges with the lock held
# (_root_step), so the caller can give the memory back once this returns.
func lv_gc_root_remove(lo) {
    let h = _heap()
    _spin_lock(h + H_ROOT_LOCK)
    _root_remove(lo)
    _spin_unlock(h + H_ROOT_LOCK)
}

func _root_remove(lo) {
    let h = _heap()
    for (let i = 0; i < ld64(h + H_ROOT_COUNT); i++) {
        if (ld64(ld64(h + H_ROOTS) + i * 16) == lo) {
            let last = ld64(h + H_ROOT_COUNT) - 1
            _root_finish(i)
            if (i != last and i < ld64(h + H_RS_I)) {
                _root_finish(last)    # it moves into a slot the scan has passed
            }
            st64(h + H_ROOT_COUNT, last)
            st64(ld64(h + H_ROOTS) + i * 16, ld64(ld64(h + H_ROOTS) + last * 16))
            st64(ld64(h + H_ROOTS) + i * 16 + 8, ld64(ld64(h + H_ROOTS) + last * 16 + 8))
            if (ld64(h + H_RS_ON) != 0 and i == ld64(h + H_RS_I) and i != last) {
                st64(h + H_RS_POS, ld64(ld64(h + H_ROOTS) + i * 16))    # the range that moved in is scanned from its start
            }
            return 0
        }
    }
}

# Whether the object at p survived the marking that just ended (an object allocated during it is marked). A value
# that is not a heap object counts as marked. Program thread, after the marks are final.
func lv_gc_is_marked(p) {
    let slot = _wk() + WK_SLOT
    let d = _find(p, slot)
    if (d == 0) {
        return 1
    }
    if (ld8(d) == 2) {
        return ld8(d + LD_MARK)
    }
    let s = ld64(slot)
    if (_is_live(d, s) != 0) {
        return 1
    }
    return 0
}

# Kept out of line, with every callee-saved register spilled into its frame, so that values held only in
# registers are found by the stack scan. Marks what the stack and the registers point to, without following it.
func _scan_stack_cur() {
    let wk = _wk()
    spill_regs()
    let sp = stack_ptr()
    if (ult(sp, ld64(wk + WK_STACK_BASE))) {
        _scan_range(sp, ld64(wk + WK_STACK_BASE))
    }
}

# The other workers are stopped: marks what the stack each of them runs on points to, from where it stopped,
# and what its Worker holds (the blue thread it runs, its queue, the finished threads it still has to clean up).
func _scan_workers() {
    let h = _heap()
    let me = _wk()
    let n = ld64a(h + H_NWORKERS)
    for (let i = 0; i < n; i++) {
        let w = ld64(ld64(h + H_WORKERS) + i * 8)
        if (w != me and ult(ld64(w + WK_SP), ld64(w + WK_STACK_BASE))) {
            _scan_range(ld64(w + WK_SP), ld64(w + WK_STACK_BASE))
        }
        _scan_range(w + WK_CUR, w + WK_ZOMBIE + 8)
        _scan_range(w + WK_HANDOFF, w + WK_IDLE + 8)
    }
}

# The verifier scans every stack at once. A cycle scans the stacks of the blue threads that are away in steps
# (_blue_scan_step).
func _scan_stack() {
    _scan_stack_cur()
    _scan_workers()
    _blue_scan_parked()
}

# Marks what the data segment points to, without following it. The collector's own state is left out: it
# holds no address of a heap object, and the workers and the marking threads write it at any time.
func _scan_static() {
    let h = _heap()
    _scan_range(addr_of("__data_start"), h)
    _scan_range(h + HEAP_SIZE, addr_of("_end"))
}

# Everything at once, for the verifier. A cycle scans the root ranges in steps instead (_root_step).
func _scan_roots() {
    let h = _heap()
    _scan_static()
    for (let i = 0; i < ld64(h + H_ROOT_COUNT); i++) {
        _scan_range(ld64(ld64(h + H_ROOTS) + i * 16), ld64(ld64(h + H_ROOTS) + i * 16 + 8))
    }
}

# One step of the scan of the root ranges that unsafe code registered: a slice of ROOT_STEP_WORDS words, so
# that a large buffer does not make one long pause. A store into a range that is still to be scanned shades
# the value it overwrites, so nothing the range held when the cycle began is lost. The cycle cannot end while
# this is on.
func _root_step() {
    let h = _heap()
    if (ld64(h + H_RS_ON) == 0) {
        return 0
    }
    _spin_lock(h + H_ROOT_LOCK)
    _root_scan_some()
    _spin_unlock(h + H_ROOT_LOCK)
}

func _root_scan_some() {
    let h = _heap()
    let budget = ROOT_STEP_WORDS
    while (ld64(h + H_RS_I) < ld64(h + H_ROOT_COUNT) and budget > 0) {
        let e = ld64(h + H_ROOTS) + ld64(h + H_RS_I) * 16
        let hi = ld64(e + 8)
        let pos = ld64(h + H_RS_POS)
        let end = hi
        if (ult(pos + budget * 8, hi)) {
            end = pos + budget * 8
        }
        _shade_range(pos, end)
        if (ult(pos, end)) {
            budget -= (end - pos) / 8
        }
        if (uge(end, hi)) {
            st64(h + H_RS_I, ld64(h + H_RS_I) + 1)
            if (ld64(h + H_RS_I) < ld64(h + H_ROOT_COUNT)) {
                st64(h + H_RS_POS, ld64(ld64(h + H_ROOTS) + ld64(h + H_RS_I) * 16))
            }
        } else {
            st64(h + H_RS_POS, end)
        }
    }
    if (ld64(h + H_RS_I) >= ld64(h + H_ROOT_COUNT)) {
        st64(h + H_RS_ON, 0)
    }
}

# Sweeping

# The next block the sweep has not reached, claimed for whoever sweeps it, or 0 when there is none. Mutex held.
func _sweep_claim() {
    let h = _heap()
    let ep = ld64(h + H_SW_EPOCH)
    while (ld64(h + H_SW_CHUNK) < ld64(h + H_CHUNK_COUNT)) {
        let cd = ld64(ld64(h + H_CHUNKS) + ld64(h + H_SW_CHUNK) * 8)
        let bi = ld64(h + H_SW_BLOCK)
        st64(h + H_SW_BLOCK, bi + 1)
        if (bi + 1 == BLOCKS_PER_CHUNK) {
            st64(h + H_SW_BLOCK, 0)
            st64(h + H_SW_CHUNK, ld64(h + H_SW_CHUNK) + 1)
        }
        let info = _block_info(cd, bi)
        if (ld8(info + BI_KIND) != 0 and ld8(info + BI_SWEPT) != ep) {
            st8(info + BI_SWEPT, ep)
            return ld64(cd + CD_BASE) + bi * BLOCK
        }
    }
    return 0
}

# Clears the start and end bits of every object that starts in byte i of the maps (one line) and is in
# `dead`, a bit set of those objects.
func _clear_dead(cd, i, dead) {
    let h = _heap()
    let base = ld64(cd + CD_BASE)
    for (let k = 0; k < 8; k++) {
        if (band(dead, shl(1, k)) != 0) {
            let s = i * 8 + k
            let e = _obj_end(cd, s)
            if (ld64(h + H_VERIFY) != 0) {
                memset(base + s * GRAN, 221, (e - s + 1) * GRAN)    # a use after free then reads obvious garbage
            }
            _bit_clear(cd + CD_START, s)
            _bit_clear(cd + CD_END, e)
        }
    }
}

# Sweeps block bi of a chunk and returns its free lines. Every object that was neither marked nor new loses its start and
# end bits, also one that starts in a line that becomes free and ends in a live one (a stale end bit there would
# make a new object in the gap look shorter than it is). Then every line not live in this cycle is free and its
# epoch is cleared. The marks and the bits of new objects are cleared for the next cycle. Nothing else of a dead object is touched: a gap is
# cleared when the allocator takes it. BI_GAP is the largest gap left, so taking the block needs no search.
func _sweep_block(cd, bi) {
    let h = _heap()
    let ep = ld64(h + H_EPOCH)
    let l0 = bi * LINES_PER_BLOCK
    let free_lines = 0
    let gaps = 0
    for (let l = l0; l < l0 + LINES_PER_BLOCK; l++) {
        let dead = band(ld8(cd + CD_START + l), bnot(bor(ld8(cd + CD_MARK + l), ld8(cd + CD_NEW + l))))
        if (dead != 0) {
            _clear_dead(cd, l, dead)
            if (ld8(cd + CD_LINES + l) == ep) {
                gaps = 1
            }
        }
    }
    for (let l = l0; l < l0 + LINES_PER_BLOCK; l++) {
        if (ld8(cd + CD_LINES + l) != ep) {
            st8a(cd + CD_LINES + l, 0)
            if (ld64(h + H_VERIFY) != 0) {
                if (ld8(cd + CD_START + l) != 0 or ld8(cd + CD_END + l) != 0) {
                    _invariant_fail(cstr("a free line still holds an object"))
                }
                memset(ld64(cd + CD_BASE) + l * LINE, 221, LINE)
            }
            free_lines++
        }
    }
    memset(cd + CD_MARK + l0, 0, LINES_PER_BLOCK)
    memset(cd + CD_NEW + l0, 0, LINES_PER_BLOCK)
    let info = _block_info(cd, bi)
    st8(info + BI_ZERO, 0)
    let gap = 0
    if (free_lines == LINES_PER_BLOCK) {
        gap = GRANS_PER_BLOCK
    } else if (free_lines != 0 or gaps != 0) {
        gap = _largest_gap(cd, bi)
    }
    st16(info + BI_GAP, gap)
    return free_lines
}

# The largest gap between the objects of block bi of a chunk, in granules.
func _largest_gap(cd, bi) {
    let p = bi * GRANS_PER_BLOCK
    let hi = p + GRANS_PER_BLOCK
    let best = 0
    while (p < hi) {
        let q = _next_start(cd, p, hi)
        if (q - p > best) {
            best = q - p
        }
        if (q >= hi) {
            return best
        }
        p = _obj_end(cd, q) + 1
    }
    return best
}

# Puts a swept block that is not free on the list its largest gap belongs to; a full block goes on none. Mutex
# held.
func _recycle(b, info) {
    let gap = ld16(info + BI_GAP)
    if (gap * GRAN >= LINE) {
        _arr_push(_list(L_RECYC + ld8(info + BI_KIND) - 1), b)
    } else if (gap != 0) {
        _arr_push(_list(L_TIGHT + ld8(info + BI_KIND) - 1), b)
    }
}

# Whether block b has a gap of at least n bytes.
func _fits(b, n) {
    let cd = _table_find(shr(b, PAGE_SHIFT))
    let info = _block_info(cd, shr(b - ld64(cd + CD_BASE), BLOCK_SHIFT))
    if (ld16(info + BI_GAP) * GRAN >= n) {
        return 1
    }
    return 0
}

# Sweeps the large objects that existed when the sweep began: a dead one leaves the page table and its span is
# given back after the mutex is let go. Mutex held at the start and at the end.
# Unmaps the span of a dead large object, a chunk's size at a time. One munmap of the whole span keeps the
# kernel's lock on the address space for as long as it takes to free every page (5.4 ms for 64 MB, measured),
# and a program thread that needs a new chunk or a large object at that moment waits for it.
func _unmap_span(base, span) {
    let off = 0
    while (off < span) {
        let n = span - off
        if (n > CHUNK_SIZE) {
            n = CHUNK_SIZE
        }
        munmap(base + off, n)
        off += n
    }
}

func _sweep_large() {
    let h = _heap()
    let n = ld64(h + H_SW_LARGE)
    let arr = ld64(h + H_LARGE)
    let gone = calloc(n + 1, 8)
    if (gone == 0) {
        _die_oom()
    }
    let ngone = 0
    let keep = 0
    for (let i = 0; i < n; i++) {
        let d = ld64(arr + i * 8)
        if (ld8(d + LD_MARK) == 0) {
            let mem = ld64(d + LD_BASE)
            for (let off = 0; off < ld64(d + LD_SPAN); off += PAGE_SIZE) {
                _table_insert(shr(mem + off, PAGE_SHIFT), 0)
            }
            st64(h + H_LARGE_BYTES, ld64(h + H_LARGE_BYTES) - ld64(d + LD_SPAN))
            st64(gone + ngone * 8, d)
            ngone++
        } else {
            st8(d + LD_MARK, 0)
            st64(arr + keep * 8, d)
            keep++
        }
    }
    let total = ld64(h + H_LARGE_COUNT)
    memmove(arr + keep * 8, arr + n * 8, (total - n) * 8)
    st64(h + H_LARGE_COUNT, total - (n - keep))
    _unlock()
    for (let i = 0; i < ngone; i++) {
        let d = ld64(gone + i * 8)
        _unmap_span(ld64(d + LD_BASE), ld64(d + LD_SPAN))
        free(d)
    }
    free(gone)
    _lock(6)
    return 0
}

# The free blocks beyond what the program is expected to allocate before the next cycle give their memory
# back to the system, off the program thread. A cold block is zero when it is taken again. Mutex held.
func _trim_free() {
    let h = _heap()
    let keep = ld64(h + H_COLD_KEEP)
    while (ld64(_list(L_FREE) + 8) > keep) {
        let b = _arr_pop(_list(L_FREE))
        let cd = _table_find(shr(b, PAGE_SHIFT))
        let info = _block_info(cd, shr(b - ld64(cd + CD_BASE), BLOCK_SHIFT))
        _unlock()
        madvise(b, BLOCK, 4)    # MADV_DONTNEED
        _lock(7)
        st8(info + BI_COLD, 1)
        st8(info + BI_ZERO, 1)
        _arr_push(_list(L_COLD), b)
    }
}

# The GC thread's sweep: blocks in claims of SWEEP_CLAIM, then the stacks of blue threads that were not used
# again, then the large objects, then the trim. Mutex held at
# the start and at the end.
func _gct_sweep() {
    let h = _heap()
    let t0 = _now_ns()
    let got = stack_buf(SWEEP_CLAIM * 16)
    while (1 == 1) {
        let n = 0
        while (n < SWEEP_CLAIM) {
            let b = _sweep_claim()
            if (b == 0) {
                break
            }
            st64(got + n * 16, b)
            n++
        }
        if (n == 0) {
            break
        }
        _unlock()
        for (let i = 0; i < n; i++) {
            let b = ld64(got + i * 16)
            let cd = _table_find(shr(b, PAGE_SHIFT))
            st64(got + i * 16 + 8, _sweep_block(cd, shr(b - ld64(cd + CD_BASE), BLOCK_SHIFT)))
        }
        _lock(8)
        for (let i = 0; i < n; i++) {
            let b = ld64(got + i * 16)
            let free_lines = ld64(got + i * 16 + 8)
            let cd = _table_find(shr(b, PAGE_SHIFT))
            let info = _block_info(cd, shr(b - ld64(cd + CD_BASE), BLOCK_SHIFT))
            if (free_lines == LINES_PER_BLOCK) {
                st8a(info + BI_KIND, 0)
                _arr_push(_list(L_FREE), b)
            } else {
                _recycle(b, info)
            }
        }
    }
    _unlock()
    _blue_stack_trim()
    _lock(8)
    _sweep_large()
    _trim_free()
    st64(h + H_SWEEP_NS, ld64(h + H_SWEEP_NS) + (_now_ns() - t0))
    st64a(h + H_SW_DONE, 1)
}

# The allocators of worker wk let go of their blocks.
func _allocators_drop(wk) {
    for (let i = 0; i < 4; i++) {
        let a = wk + WK_ALLOC + i * AL_SIZE
        st64(a + AL_BLOCK, 0)
        st64(a + AL_LEFT, 0)
        st64(a + AL_OFF, 0)
    }
}

# The marks are final: the sweep begins. The allocators let go of their blocks (the sweep has to see them), the
# recyclable lists are emptied (their blocks are swept again), and the GC thread is woken to sweep. Mutex held.
func _sweep_start() {
    let h = _heap()
    for (let w = 0; w < ld64a(h + H_NWORKERS); w++) {
        _allocators_drop(ld64(ld64(h + H_WORKERS) + w * 8))
    }
    st64(_list(L_RECYC) + 8, 0)
    st64(_list(L_RECYC + 1) + 8, 0)
    st64(_list(L_TIGHT) + 8, 0)
    st64(_list(L_TIGHT + 1) + 8, 0)
    let ep = ld64(h + H_SW_EPOCH) % 255 + 1
    st64(h + H_SW_EPOCH, ep)
    st64(h + H_SW_CHUNK, 0)
    st64(h + H_SW_BLOCK, 0)
    st64(h + H_SW_LARGE, ld64(h + H_LARGE_COUNT))
    st64a(h + H_SW_DONE, 0)
    st64a(h + H_SWEEPING, 1)
    st64a(h + H_GCT_STATE, 3)
}

# ZUE_RT_GC_STATS=3: after each sweep, where the heap's blocks are. Mutex held.
func _census() {
    let h = _heap()
    let full = 0
    let recyc = 0
    let free_hot = ld64(_list(L_FREE) + 8)
    let cold = ld64(_list(L_COLD) + 8)
    let live_lines = 0
    let used = 0
    for (let c = 0; c < ld64(h + H_CHUNK_COUNT); c++) {
        let cd = ld64(ld64(h + H_CHUNKS) + c * 8)
        for (let bi = 0; bi < BLOCKS_PER_CHUNK; bi++) {
            if (ld8(_block_info(cd, bi) + BI_KIND) == 0) {
                continue
            }
            used++
            let n = 0
            for (let l = 0; l < LINES_PER_BLOCK; l++) {
                if (ld8(cd + CD_LINES + bi * LINES_PER_BLOCK + l) != 0) {
                    n++
                }
            }
            live_lines += n
            if (n == LINES_PER_BLOCK) {
                full++
            } else {
                recyc++
            }
        }
    }
    let buf = stack_buf(320)
    let pct = 0
    if (used != 0) {
        pct = live_lines * 100 / (used * LINES_PER_BLOCK)
    }
    let n2 = snprintf(buf, 320, cstr("ZUE_RT_GC_CENSUS,%llu chunks,%llu blocks in use (%llu full, %llu with holes),%llu%% of their lines live,%llu free blocks,%llu given back,%llu large objects (%llu MiB)\n"), ld64(h + H_CHUNK_COUNT), used, full, recyc, pct, free_hot, cold, ld64(h + H_LARGE_COUNT), ld64(h + H_LARGE_BYTES) / 1048576)
    write(2, buf, n2)
    return 0
}

# After a sweep: the pacer. It measures how fast the program allocated and how long the cycle took for the live
# data it had, and from them estimates what the program will allocate during the next cycle (a). The heap goal
# is four times that, so the marker finishes before the program is slowed down, but never more than twice the
# live size and never more than the free memory of the machine allows. The next cycle begins when the rest of
# the goal (goal minus a) has been allocated. A heap this small has a floor, MIN_THRESHOLD, so that it does not
# collect all the time.
func _after_sweep() {
    let h = _heap()
    let now = _now_ns()
    # The bytes of the objects the cycle marked: what the program held at its start. What was allocated during
    # the cycle survives it but is not counted, so the goal is a multiple of what the program really holds.
    let live = ld64(h + H_LIVE_BYTES)
    let since = ld64a(h + H_BYTES_SINCE_GC)
    let elapsed = now - ld64(h + H_LAST_END)
    if (ld64(h + H_LAST_END) != 0 and elapsed > 0) {
        let rate = since * 1000000 / elapsed
        if (ld64(h + H_ALLOC_RATE) != 0) {
            rate = (rate + ld64(h + H_ALLOC_RATE)) / 2
        }
        st64(h + H_ALLOC_RATE, rate)
    }
    st64(h + H_LAST_END, now)
    let mib = live / 1048576
    if (mib < 1) {
        mib = 1
    }
    let cost = (now - ld64(h + H_CYCLE_T0)) / mib
    if (ld64(h + H_CYCLE_COST) != 0) {
        cost = (cost + ld64(h + H_CYCLE_COST)) / 2
    }
    st64(h + H_CYCLE_COST, cost)
    let cycle_ms = mib * cost / 1000000
    let a = ld64(h + H_ALLOC_RATE) * cycle_ms
    let goal = 4 * a
    let top = 2 * live
    if (ld64(h + H_LOWMEM) != 0) {
        top = live / 8    # --gc=lowmem: memory first, so the goal is a small part of the live size and cycles come more often
    }
    if (top < 2 * MIN_THRESHOLD) {
        top = 2 * MIN_THRESHOLD
    }
    # The heap may grow until the free memory of the machine is nearly used up, not further: past that the
    # kernel reclaims and compacts inside a page fault of the program. The free pages shrink as this heap
    # grows, so what the heap holds now is added back.
    let held = ld64(h + H_CHUNK_COUNT) * CHUNK_SIZE + ld64(h + H_LARGE_BYTES)
    let room = (sysconf(86) * sysconf(30) + held) / 100 * 85 - live    # _SC_AVPHYS_PAGES
    # A limit on the address space (ulimit -v) bounds the heap too. Stacks, the GC thread, freed memory not
    # yet given back and the program itself take the rest, so the heap may use 70 percent of it.
    let rl = stack_buf(16)
    if (getrlimit(9, rl) == 0 and ld64(rl) > 0) {    # RLIMIT_AS; the unlimited value is all ones, which reads as -1
        let as_room = ld64(rl) / 100 * 70 - live
        if (as_room < room) {
            room = as_room
        }
    }
    if (room < 0) {
        room = 0
    }
    if (goal > top) {
        goal = top
    }
    if (goal > room) {
        goal = room
    }
    if (goal < 2 * MIN_THRESHOLD) {
        goal = 2 * MIN_THRESHOLD
    }
    # When the program is held back. The default mode gives memory for speed: a cycle that takes longer than
    # the pacer expected lets the heap grow past the goal, and the program is held back only where the
    # machine's memory ends (room). --gc=lowmem holds the program to the goal.
    let hold = goal
    if (ld64(h + H_LOWMEM) == 0 and room > hold) {
        hold = room
    }
    st64a(h + H_EXTRA, hold)
    let next = goal - a
    if (next < MIN_THRESHOLD) {
        next = MIN_THRESHOLD
    }
    st64a(h + H_THRESHOLD, next)
    st64(h + H_COLD_KEEP, next / BLOCK)
    st64a(h + H_BYTES_SINCE_GC, 0)
}

func _count_pause(dt) {
    let h = _heap()
    st64(h + H_PAUSE_TOTAL, ld64(h + H_PAUSE_TOTAL) + dt)
    if (dt > ld64(h + H_PAUSE_MAX)) {
        st64(h + H_PAUSE_MAX, dt)
        st64(h + H_PAUSE_MAX_SLEEP, ld64(h + H_THROTTLE_CALL))
    }
}

# A cycle begins by marking the roots (the stacks and registers of the workers, the data segment), which is the
# snapshot; the root ranges and the stacks of the blue threads that are away follow in steps. Every other
# worker is stopped meanwhile, so that all of them see the cycle begin at the same moment: from here every
# new object is born marked (_born_marked) and every store shades what it overwrites.
func _gc_begin() {
    let h = _heap()
    _stw_begin()
    st64(h + H_COLLECTIONS, ld64(h + H_COLLECTIONS) + 1)
    st64(h + H_EPOCH, ld64(h + H_EPOCH) % 255 + 1)
    for (let i = 0; i <= ld64(h + H_NMARK); i++) {
        st64(_marker(i) + MK_SLOT + 16, 0)
    }
    let me = _wk()
    for (let i = 0; i < ld64a(h + H_NWORKERS); i++) {
        let w = ld64(ld64(h + H_WORKERS) + i * 8)
        st64(w + WK_SLOT + 16, 0)
        if (w != me) {
            # what it allocated so far is counted, and its next allocation looks at the collector
            xadd64(h + H_BYTES_SINCE_GC, ld64(w + WK_BYTES))
            st64(w + WK_BYTES, 0)
            st64(w + WK_LIMIT, -1)
        }
    }
    st64(h + H_MARKING, 1)
    _scan_static()
    if (ld64(h + H_ROOT_COUNT) != 0) {
        st64(h + H_RS_I, 0)
        st64(h + H_RS_POS, ld64(ld64(h + H_ROOTS)))
        st64(h + H_RS_ON, 1)
    }
    _scan_stack_cur()
    _scan_workers()
    _blue_begin_scan()
    # The roots are the snapshot. What they point to goes to the pool, for the marking threads.
    st64(h + H_CYCLE_BYTES, ld64a(h + H_BYTES_SINCE_GC))
    st64(h + H_CYCLE_T0, _now_ns())
    st64(h + H_CYCLE_GCT0, ld64(h + H_GCT_NS))
    let pm = _prog_marker()
    _lock_prog(9)
    st64a(h + H_GCT_STATE, 1)
    _pool_add(ld64(pm + MK_STACK), ld64(pm + MK_TOP))
    st64(pm + MK_TOP, 0)
    _unlock()
    _stw_end()
    pthread_cond_broadcast(h + H_COND_GC)
}

# A marking thread. It sleeps while no cycle runs. During marking it marks from its own mark stack, takes its share
# of the pool when the stack is empty, and gives half of its stack to the pool when another marker waits. When
# every marker waits and the pool is empty, the state says so; the program thread then ends the marking. The
# first marker (the GC thread) also sweeps.
func _marker_main(mk) {
    let h = _heap()
    let first = _marker(0)
    _lock(10)
    while (1 == 1) {
        let st = ld64(h + H_GCT_STATE)
        if (st == 3 and mk == first) {
            _gct_sweep()
            st64a(h + H_GCT_STATE, 0)
            continue
        }
        let w = 0
        if (st == 1 and ld64(mk + MK_TOP) == 0 and ld64(h + H_SHARED_N) != 0) {
            w = _pool_take(mk)
            st64(mk + MK_TAKES, ld64(mk + MK_TAKES) + 1)
        }
        if (st == 1 and ld64(mk + MK_TOP) != 0) {
            _unlock()
            _wake(w)
            let t0 = _now_ns()
            _mark_batch(mk)
            let dt = _now_ns() - t0
            if (ld64(h + H_SLOW_US) != 0) {
                usleep(ld64(h + H_SLOW_US))
            }
            _lock(10)
            st64(h + H_GCT_NS, ld64(h + H_GCT_NS) + dt)
            st64(mk + MK_NS, ld64(mk + MK_NS) + dt)
            continue
        }
        st64a(h + H_IDLE, ld64(h + H_IDLE) + 1)
        if (st == 1) {
            st64(mk + MK_WAITS, ld64(mk + MK_WAITS) + 1)
        }
        if (st == 1 and ld64(h + H_IDLE) == ld64(h + H_NMARK) and ld64(h + H_SHARED_N) == 0) {
            st64a(h + H_GCT_STATE, 2)
            pthread_cond_broadcast(h + H_COND_DONE)
        }
        _hold_end()
        pthread_cond_wait(h + H_COND_GC, h + H_MUTEX)
        _lock_note(14, 0, 0)
        st64a(h + H_IDLE, ld64(h + H_IDLE) - 1)
    }
    return 0
}

# ZUE_RT_GC_STATS=2: one line per cycle.
func _trace_cycle(wall) {
    let h = _heap()
    let buf = stack_buf(160)
    let n = snprintf(buf, 160, cstr("ZUE_RT_GC_CYCLE,%llu wall ns,%llu gc thread ns,%zu bytes allocated during the cycle,%zu bytes allocated before it\n"), wall, ld64(h + H_GCT_NS) - ld64(h + H_CYCLE_GCT0), ld64a(h + H_BYTES_SINCE_GC) - ld64(h + H_CYCLE_BYTES), ld64(h + H_CYCLE_BYTES))
    write(2, buf, n)
}

# While the markers mark, asks whether they are done: returns 1 when the marks are final, with the mutex held
# and every other worker stopped. The workers are stopped only when every marker is out of work and the roots
# have all been scanned; then the batch of every worker is handed over, so a marked object one of them still
# holds is never left behind. If that gave the markers work, the workers go on and the cycle does too.
func _cycle_poll() {
    let h = _heap()
    if (ld64a(h + H_GCT_STATE) == 2) {
        if (ld64(h + H_RS_ON) == 0 and ld64(h + H_BS_ON) == 0) {
            _stw_begin()
            _lock_prog(11)
            let w = _hand_over_all()
            if (ld64(h + H_GCT_STATE) == 2 and ld64(h + H_SHARED_N) == 0) {
                st64a(h + H_GCT_STATE, 0)    # the markers sleep again, so the marks are the driver's to use
                if (ld64(h + H_VERIFY) != 0) {
                    _check_marking_done()
                }
                return 1
            }
            _unlock()
            _wake(w)
            _stw_end()
        } else {
            _lock_prog(11)
            let w = _hand_over(_wk())
            _unlock()
            _wake(w)
        }
    }
    _throttle(1)
    return 0
}

# A program that allocates far more than the collector can keep up with is slowed down here, a little at a
# time, so that no single step is long. Every worker that comes to the collector during a cycle is held back;
# one that does not drive the collector stops when the driver asks for it.
func _throttle(driver) {
    let h = _heap()
    if (ld64a(h + H_BYTES_SINCE_GC) <= ld64a(h + H_EXTRA)) {
        return 0
    }
    # Spin instead of usleep: a sleep can overshoot by milliseconds, a spin takes what it is told.
    let t0 = _now_ns()
    let spins = 0
    while (_now_ns() - t0 < THROTTLE_NS_STEP) {
        spins += 1    # no sched_yield: giving up the core can hand it to the GC thread for a whole time slice
        if (driver == 0) {
            _gc_poll()
        }
    }
    let dt = _now_ns() - t0
    xadd64(h + H_THROTTLE_NS, dt)
    xadd64(h + H_THROTTLE_N, 1)
    if (driver != 0) {
        st64(h + H_THROTTLE_CALL, ld64(h + H_THROTTLE_CALL) + dt)
        if (dt > ld64(h + H_THROTTLE_MAX)) {
            st64(h + H_THROTTLE_MAX, dt)
        }
    }
    return 0
}

# The marks are final (mutex held, the other workers stopped): check them if asked, free the boxes of dead
# templates, start the sweep, and let the workers go on.
func _gc_finish() {
    let h = _heap()
    if (ld64(h + H_VERIFY) != 0) {
        _verify_marks()
    }
    st64(h + H_MARKING, 0)
    let live = 0
    for (let i = 0; i <= ld64(h + H_NMARK); i++) {
        live += ld64(_marker(i) + MK_SLOT + 16)
    }
    for (let i = 0; i < ld64a(h + H_NWORKERS); i++) {
        live += ld64(ld64(ld64(h + H_WORKERS) + i * 8) + WK_SLOT + 16)
    }
    st64(h + H_LIVE_BYTES, live)
    _unlock()
    lv_data_gc_hook()
    _lock_prog(12)
    _sweep_start()
    _unlock()
    _stw_end()
    pthread_cond_broadcast(h + H_COND_GC)    # every marker waits on it; only the first sweeps
}

# One stop of the incremental collector, by the worker that drives it. While the GC thread sweeps, it only
# looks whether the sweep is done, and then runs the pacer. Otherwise it begins a cycle if none is running,
# scans one step of the roots, and ends the marking when nothing is left to scan.
func _gc_work() {
    let h = _heap()
    let t0 = _now_ns()
    st64(h + H_THROTTLE_CALL, 0)
    if (ld64(h + H_SWEEPING) != 0) {
        if (ld64a(h + H_SW_DONE) != 0) {
            _lock_prog(13)
            if (ld64(h + H_GCT_STATE) == 0) {
                st64a(h + H_SWEEPING, 0)
                if (ld64(h + H_STATS) == 3) {
                    _census()
                }
                _after_sweep()
                if (ld64(h + H_VERIFY) != 0) {
                    _check_lists()
                }
            }
            _unlock()
        }
    } else {
        if (ld64(h + H_MARKING) == 0) {
            _gc_begin()
            if (_now_ns() - t0 > ld64(h + H_BEGIN_MAX)) {
                st64(h + H_BEGIN_MAX, _now_ns() - t0)
            }
        }
        if (ld64(h + H_MARKING) != 0) {
            _root_step()
            _blue_scan_step()
        }
        if (ld64(h + H_MARKING) != 0 and _cycle_poll() != 0) {
            let t1 = _now_ns()
            if (t1 - ld64(h + H_CYCLE_T0) > ld64(h + H_CYCLE_MAX)) {
                st64(h + H_CYCLE_MAX, t1 - ld64(h + H_CYCLE_T0))
            }
            if (ld64(h + H_STATS) == 2) {
                _trace_cycle(t1 - ld64(h + H_CYCLE_T0))
            }
            _gc_finish()
            if (_now_ns() - t1 > ld64(h + H_FINISH_MAX)) {
                st64(h + H_FINISH_MAX, _now_ns() - t1)
            }
        }
    }
    _count_pause(_now_ns() - t0)
}

# The verifier. At the end of a cycle every object that can be reached from the roots must be marked. It walks the heap again with a second set of bits. A word on the
# stack that points at an unmarked object is skipped: a stale word left in an unused stack slot can point at an
# object that died before the cycle began, and the program cannot reach it through that word.

# When the marks are final nothing may be left to scan.
func _check_marking_done() {
    let h = _heap()
    for (let i = 0; i <= ld64(h + H_NMARK); i++) {
        if (ld64(_marker(i) + MK_TOP) != 0) {
            _invariant_fail(cstr("a cycle ended with objects still on a mark stack"))
        }
    }
    if (ld64(h + H_SHARED_N) != 0) {
        _invariant_fail(cstr("a cycle ended with objects still in the shared batch"))
    }
    for (let i = 0; i < ld64a(h + H_NWORKERS); i++) {
        if (ld64(ld64(ld64(h + H_WORKERS) + i * 8) + WK_LOCAL_N) != 0) {
            _invariant_fail(cstr("a cycle ended with objects still in a worker's batch"))
        }
    }
}

# Every block on a list is of the list's kind and swept, a free block has no live line and no object, and no
# block is on two lists. Mutex held.
func _check_lists() {
    let h = _heap()
    for (let k = 0; k < 6; k++) {
        let p = _list(k)
        for (let i = 0; i < ld64(p + 8); i++) {
            let b = ld64(ld64(p) + i * 8)
            let cd = _table_find(shr(b, PAGE_SHIFT))
            if (cd == 0 or ld8(cd) != 1) {
                _invariant_fail(cstr("a block on a list is not in a chunk"))
            }
            let bi = shr(b - ld64(cd + CD_BASE), BLOCK_SHIFT)
            let info = _block_info(cd, bi)
            if ((k < 2 and ld8(info + BI_KIND) != k + 1) or (k >= L_TIGHT and ld8(info + BI_KIND) != k - L_TIGHT + 1)) {
                _invariant_fail(cstr("a recyclable block is of the wrong kind"))
            }
            if (k < 2 and ld16(info + BI_GAP) * GRAN < LINE) {
                _invariant_fail(cstr("a block on the recyclable list has no gap of a line"))
            }
            if (k == 2 or k == 3) {
                if (ld8(info + BI_KIND) != 0) {
                    _invariant_fail(cstr("a free block is in use"))
                }
                for (let l = 0; l < LINES_PER_BLOCK; l++) {
                    let j = bi * LINES_PER_BLOCK + l
                    if (ld8(cd + CD_LINES + j) != 0 or ld8(cd + CD_START + j) != 0 or ld8(cd + CD_END + j) != 0) {
                        _invariant_fail(cstr("a free block holds a live line or an object"))
                    }
                }
            }
        }
    }
}

func _verify_fail(p, n) {
    let buf = stack_buf(192)
    let k = snprintf(buf, 192, cstr("Runtime Error: GC verify failed: the object at %p (%zu bytes) can be reached but was not marked\n"), p, n)
    write(2, buf, k)
    exit(1)
}

func _vmark_large(d) {
    let h = _heap()
    if (ld8(d + LD_VMARK) != 0) {
        return 0
    }
    if (ld8(d + LD_MARK) == 0) {
        if (ld64(h + H_VSTACK) != 0) {
            return 0
        }
        _verify_fail(ld64(d + LD_BASE), ld64(d + LD_OBJ))
    }
    st8(d + LD_VMARK, 1)
    if (ld8(d + LD_ATOMIC) != 0) {
        return 0
    }
    return ld64(d + LD_BASE)
}

func _vmark(cd, s, n) {
    let h = _heap()
    let vm = ld64(cd + CD_VMARK)
    if (band(ld8(vm + shr(s, 3)), shl(1, band(s, 7))) != 0) {
        return 0
    }
    if (_is_live(cd, s) == 0) {
        if (ld64(h + H_VSTACK) != 0) {
            return 0
        }
        _verify_fail(ld64(cd + CD_BASE) + s * GRAN, n)
    }
    _bit_set(vm, s)
    if (ld8(_block_info(cd, shr(s, 11)) + BI_KIND) == 2) {
        return 0
    }
    return ld64(cd + CD_BASE) + s * GRAN
}

func _verify_marks() {
    let h = _heap()
    for (let c = 0; c < ld64(h + H_CHUNK_COUNT); c++) {
        let cd = ld64(ld64(h + H_CHUNKS) + c * 8)
        if (ld64(cd + CD_VMARK) == 0) {
            st64(cd + CD_VMARK, calloc(1, MAP_BYTES))
            if (ld64(cd + CD_VMARK) == 0) {
                _die_oom()
            }
        } else {
            memset(ld64(cd + CD_VMARK), 0, MAP_BYTES)
        }
    }
    for (let i = 0; i < ld64(h + H_LARGE_COUNT); i++) {
        st8(ld64(ld64(h + H_LARGE) + i * 8) + LD_VMARK, 0)
    }
    st64(h + H_VMODE, 1)
    st64(_prog_marker() + MK_TOP, 0)
    _scan_roots()
    _drain()
    st64(h + H_VSTACK, 1)
    _scan_stack()
    st64(h + H_VSTACK, 0)
    _drain()
    st64(h + H_VMODE, 0)
}

func _gc_report() {
    let h = _heap()
    let grows = 0
    for (let i = 0; i <= ld64(h + H_NMARK); i++) {
        grows += ld64(_marker(i) + MK_GROW)
    }
    let buf = stack_buf(480)
    let n = snprintf(buf, 480, cstr("ZUE_RT_GC_STATS,%llu collections,%zu live bytes,%llu chunks,%llu total pause ns,%llu max pause ns,%llu mark ns,%llu sweep ns,%llu max cycle end ns,%llu max cycle start ns,%llu mark stack grows,%llu large object bytes,%llu longest cycle ns\n"), ld64(h + H_COLLECTIONS), ld64(h + H_LIVE_BYTES), ld64(h + H_CHUNK_COUNT), ld64(h + H_PAUSE_TOTAL), ld64(h + H_PAUSE_MAX), ld64(h + H_GCT_NS), ld64(h + H_SWEEP_NS), ld64(h + H_FINISH_MAX), ld64(h + H_BEGIN_MAX), grows, ld64(h + H_LARGE_BYTES), ld64(h + H_CYCLE_MAX))
    write(2, buf, n)
    let bl = stack_buf(256)
    let nl = snprintf(bl, 256, cstr("ZUE_RT_GC_LOCK,%llu ns longest wait of the program thread for the mutex,in %s,%llu ns longest hold by the program thread,in %s,%llu ns longest hold by a collector thread,in %s\n"), ld64(h + H_LK_WAIT), _site_name(ld64(h + H_LK_WAIT + 8)), ld64(h + H_LK_PHOLD), _site_name(ld64(h + H_LK_PHOLD + 8)), ld64(h + H_LK_GHOLD), _site_name(ld64(h + H_LK_GHOLD + 8)))
    write(2, bl, nl)
    let buf2 = stack_buf(256)
    let n2 = snprintf(buf2, 256, cstr("ZUE_RT_GC_THROTTLE,%llu steps slept,%llu total sleep ns,%llu longest sleep ns,%llu of the longest pause was sleep ns\n"), ld64(h + H_THROTTLE_N), ld64(h + H_THROTTLE_NS), ld64(h + H_THROTTLE_MAX), ld64(h + H_PAUSE_MAX_SLEEP))
    write(2, buf2, n2)
    let buf3 = stack_buf(256)
    let pre = ld64(h + H_PRE)
    let hits = 0
    let misses = 0
    let made = 0
    let spikes = 0
    let maxns = 0
    let off = 0
    if (pre != 0) {
        hits = ld64(pre + PRE_HITS)
        misses = ld64(pre + PRE_MISSES)
        made = ld64a(pre + PRE_MADE)
        spikes = ld64a(pre + PRE_SPIKES)
        maxns = ld64a(pre + PRE_MAXNS)
        off = ld64a(pre + PRE_OFF_AT)
    }
    let n3 = snprintf(buf3, 256, cstr("ZUE_RT_GC_CHUNKS,%llu taken ready,%llu made by the program thread,%llu made by the helper,%llu of them over a millisecond,%llu longest make ns,%llu chunks made when the hint went off (0: still on)\n"), hits, misses, made, spikes, maxns, off)
    write(2, buf3, n3)
    if (pre != 0) {
        let n4 = snprintf(buf3, 256, cstr("ZUE_RT_GC_OWN_CHUNK,%llu ns longest chunk made by the program thread,%llu ns of it the mapping,%llu ns the descriptor\n"), ld64(pre + PRE_OWN_NS), ld64(pre + PRE_OWN_MAP), ld64(pre + PRE_OWN_DESC))
        write(2, buf3, n4)
    }
    for (let i = 0; i < ld64(h + H_NMARK); i++) {
        let mk = _marker(i)
        let n5 = snprintf(buf3, 256, cstr("ZUE_RT_GC_MARKER,%llu,%llu words scanned,%llu ns marking,%llu times gave work away,%llu items given,%llu times took work,%llu times waited for work\n"), i, ld64(mk + MK_WORDS), ld64(mk + MK_NS), ld64(mk + MK_GIVEN), ld64(mk + MK_GIVEN_N), ld64(mk + MK_TAKES), ld64(mk + MK_WAITS))
        write(2, buf3, n5)
    }
    _blue_report()
}

# Called first thing in main of a program built with --gc=lowmem.
func lv_gc_set_lowmem() {
    st64(_heap() + H_LOWMEM, 1)
}

# Makes the calling thread a worker: a thread that runs Zue code. Its stack limits come from the thread
# itself. It is in the table before it runs any Zue code, and counts as stopped until then.
# base is where the scan of its stack ends: an address in the frame of the function the thread began in.
# Above it are the thread's own variables (the operating system keeps them at the top of the stack), which
# hold no Zue value and which the thread writes while its stack is scanned.
func lv_gc_worker_start(base) {
    let h = _heap()
    let wk = _wk()
    let attr = stack_buf(128)
    let out = stack_buf(16)
    st64(wk + WK_STACK_BASE, base)
    if (pthread_getattr_np(pthread_self(), attr) == 0) {
        pthread_attr_getstack(attr, out, out + 8)
        pthread_attr_destroy(attr)
        st64(wk + WK_STACK_LOW, ld64(out) + 262144)    # keep 256 KiB for the runtime itself
        st64(addr_of("lv_stack_low"), ld64(out) + 262144)
    }
    st64(wk + WK_LOW_P, addr_of("lv_stack_low"))
    st64(wk + WK_SP, base)    # nothing on its stack yet for the collector to scan
    st64a(wk + WK_STATE, 1)
    pthread_mutex_lock(h + H_MUTEX)
    let id = ld64(h + H_NWORKERS)
    if (id == WK_MAX) {
        write(2, cstr("Runtime Error: too many worker threads\n"), 39)
        exit(1)
    }
    st64(ld64(h + H_WORKERS) + id * 8, wk)
    st64(wk + WK_ID, id)
    st64a(h + H_NWORKERS, id + 1)
    pthread_mutex_unlock(h + H_MUTEX)
    _safe_leave()
    return id
}

# Called once from the thread that runs the program.
func lv_gc_start(base) {
    let h = _heap()
    if (ld64(h + H_SETUP_DONE) == 0) {
        _gc_setup()
    }
    st64(h + H_WORKERS, calloc(WK_MAX, 8))
    if (ld64(h + H_WORKERS) == 0) {
        _die_oom()
    }
    lv_gc_worker_start(base)
    let s = getenv(cstr("ZUE_RT_GC_STRESS"))
    if (s != 0 and ld8(s) != 0) {
        st64(h + H_STRESS_EVERY, strtoull(s, 0, 10))
    }
    let ver = getenv(cstr("ZUE_RT_GC_VERIFY"))
    if (ver != 0 and ld8(ver) != 0 and ld8(ver) != 48) {
        st64(h + H_VERIFY, 1)
    }
    if (getenv(cstr("ZUE_RT_GC_STATS")) != 0) {
        st64(h + H_STATS, 1)
        if (ld8(getenv(cstr("ZUE_RT_GC_STATS"))) == 50) {
            st64(h + H_STATS, 2)    # "2": also one line per cycle
        }
        if (ld8(getenv(cstr("ZUE_RT_GC_STATS"))) == 51) {
            st64(h + H_STATS, 3)    # "3": also a census of the heap after each sweep
        }
        atexit(fn_addr("_gc_report"))
    }
    let slow = getenv(cstr("ZUE_RT_GC_SLOW"))
    if (slow != 0 and ld8(slow) != 0) {
        st64(h + H_SLOW_US, strtoull(slow, 0, 10))
    }
    # Marking threads for a quarter of the processors, four at most: measured on 16 processors at 256 MiB to
    # 4 GiB live, four were faster than two in both modes (in --gc=lowmem by 25 to 40 percent), and eight were
    # no faster than four for 60 percent more processor time (see docs/plan.md).
    let nm = sysconf(84) / 4    # _SC_NPROCESSORS_ONLN
    if (nm < 1) {
        nm = 1
    }
    if (nm > 4) {
        nm = 4
    }
    let ms = getenv(cstr("ZUE_RT_GC_MARKERS"))
    if (ms != 0) {
        let end = stack_buf(8)
        nm = strtoull(ms, end, 10)
        if (nm == 0 or ld8(ld64(end)) != 0 or ld8(ms) < 48 or ld8(ms) > 57) {
            write(2, cstr("Runtime Error: ZUE_RT_GC_MARKERS must be a whole number from 1 up\n"), 66)
            exit(1)
        }
    }
    st64(h + H_NMARK, nm)
    st64(h + H_MARKERS, calloc(nm + 1, MK_SIZE))
    if (ld64(h + H_MARKERS) == 0) {
        _die_oom()
    }
    let th = stack_buf(16)
    for (let i = 0; i < nm; i++) {
        if (pthread_create(th, 0, fn_addr("_marker_main"), _marker(i)) != 0) {
            write(2, cstr("Runtime Error: cannot start the garbage collector thread\n"), 57)
            exit(1)
        }
    }
    let pth = stack_buf(16)
    let pre = calloc(1, PRE_SIZE)
    if (pre != 0) {
        st64(pre + PRE_HINT, 1)
        if (pthread_create(pth, 0, fn_addr("_pre_main"), pre) == 0) {
            st64(h + H_PRE, pre)    # if the helper cannot start, chunks are made on the program thread
        }
    }
    st64(h + H_GC_READY, 1)
    _set_limit()
}
