# Copyright (c) 2026 GibblyGobbly
#
# zue_gc.zu: memory management for compiled Zue programs: a conservative,
# non-moving mark-and-sweep collector with a write barrier. A GC thread marks while the program runs;
# the program thread sweeps in short steps. Compiled with `zue --native`.
#
# Every runtime object is allocated here. Small objects come from 64 KB pages split
# into size classes; large ones get pages of their own. A collection marks everything
# reachable from the stack, the registers, the program's static data and any registered
# root ranges, treating every aligned word as a possible pointer (interior pointers
# count), then sweeps the rest. Objects that hold no pointers (strings, doubles, bytes)
# are allocated "atomic" and never scanned.
#
# Environment:
#   ZUE_RT_GC_STRESS=N  collect every N allocations (testing)
#   ZUE_RT_GC_STATS=1   print the collection count, live bytes, pages and the total and longest pause at exit
#   see docs/gc.md for ZUE_RT_GC_STATS, _STRESS, _SLOW and _VERIFY

extern("malloc", "ptr", "i64")
extern("calloc", "ptr", "i64,i64")
extern("realloc", "ptr", "ptr,i64")
extern("free", "void", "ptr")
extern("aligned_alloc", "ptr", "i64,i64")
extern("mmap", "ptr", "ptr,i64,i32,i32,i32,i64")
extern("munmap", "i32", "ptr,i64")
extern("madvise", "i32", "ptr,i64,i32")
extern("memset", "ptr", "ptr,i32,i64")
extern("memcpy", "ptr", "ptr,ptr,i64")
extern("memmove", "ptr", "ptr,ptr,i64")
extern("write", "i64", "i32,ptr,i64")
extern("exit", "void", "i32")
extern("getenv", "ptr", "ptr")
extern("strtoull", "i64", "ptr,ptr,i32")
extern("atexit", "i32", "ptr")
extern("clock_gettime", "i32", "i32,ptr")
extern("snprintf", "i32", "ptr,i64,ptr,...")
extern("pthread_self", "i64", "")
extern("pthread_getattr_np", "i32", "i64,ptr")
extern("pthread_attr_getstack", "i32", "ptr,ptr,ptr")
extern("pthread_attr_destroy", "i32", "ptr")
extern("pthread_create", "i32", "ptr,ptr,ptr,ptr")
extern("pthread_mutex_lock", "i32", "ptr")
extern("pthread_mutex_unlock", "i32", "ptr")
extern("pthread_cond_wait", "i32", "ptr,ptr")
extern("pthread_cond_signal", "i32", "ptr")
extern("pthread_cond_broadcast", "i32", "ptr")
extern("usleep", "i32", "i32")
extern("sysconf", "i64", "i32")
extern("getrlimit", "i32", "i32,ptr")

# struct Page
const PG_BASE = 0
const PG_OBJ = 8
const PG_NOBJS = 16       # u32
const PG_BUMP = 20        # u32, objects handed out at least once
const PG_FREE = 24        # u32, where the search for a free slot starts: no slot below it is free
const PG_NFREE = 28       # u32, free slots below PG_BUMP (objects freed by a sweep that were not handed out again)
const PG_USED_COUNT = 32  # u32
const PG_ATOMIC = 36      # u8
const PG_LARGE = 37       # u8
const PG_IN_LIST = 39     # u8
const PG_CLS = 40         # i32
const PG_EPOCH = 44       # u32, the sweep that last handled this page; a page of the current sweep is skipped
const PG_SPAN = 48        # bytes owned by a large page
const PG_USED = 56
const PG_MARK = 64
const PG_NEXT = 72
const PG_RECIP = 80       # i64, 2^32 / object size + 1: offset * PG_RECIP >> 32 is the object index
const PG_SIZE = 88

# struct Slot { key, page }
const SLOT_SIZE = 16

const PAGE_SHIFT = 16
const PAGE_SIZE = 65536
const MAX_SMALL = 32752
const MIN_THRESHOLD = 16777216
const CHUNK_SIZE = 2097152    # small-object pages are cut from chunks of this size (32 pages)
const NCLASSES = 38
const SPAN_CACHE_SLOTS = 512
const TRIM_BATCH = 16         # empty pages given back to the OS per collector step, at most
const TRIM_STEP_NS = 20000    # time a step spends giving pages back before it stops (at least one page is given back)
const RETIRE_BATCH = 64       # pooled pages given up completely per collector step, at most
const CHUNK_BYTES = 4096      # a larger object is scanned in pieces of this size
const STEP_BYTES = 8192       # bytes the program allocates between two steps
const SWEEP_STEP_NS = 50000   # time an incremental sweep step may take
const TRIM_BYTES = 1048576    # cached large-object memory given back per call of _cache_trim

table("_class_sizes", "i32", 16, 32, 48, 64, 80, 96, 112, 128, 144, 160, 192, 224, 256, 272, 320, 384, 448, 512, 528, 640, 768, 1024, 1040, 1280, 1536, 2048, 2064, 3072, 4096, 4112, 6144, 8192, 8208, 10920, 13104, 16368, 21840, 32752)
space("_class_of", 2056)       # u8[MAX_SMALL / 16 + 1]

# State of the collector: one block of 64-bit fields (and two tables) that the functions reach
# through _heap(). A field's offset is its constant H_NAME.
const H_SETUP_DONE = 0
const H_ALL_PAGES = 8
const H_ALL_COUNT = 16
const H_ALL_CAP = 24
const H_POOL = 32
const H_POOL_COUNT = 40
const H_POOL_CAP = 48
const H_POOL_COLD = 56        # pool entries below this index have been given back to the OS
const H_TABLE = 64            # top level of the page table: 65536 pointers to second-level tables
const H_HEAP_LO = 72
const H_HEAP_HI = 80
const H_BYTES_SINCE_GC = 88
const H_THRESHOLD = 96
const H_EXTRA = 104            # the pacer's heap goal: bytes the program may allocate between two cycle ends before it is slowed down
const H_LIMIT = 112    # bytes allocated since the last collection that make _gc_alloc look at the collector
const H_LIVE_BYTES = 120
const H_GC_READY = 128
const H_GC_BUSY = 136
const H_STRESS_EVERY = 144
const H_ALLOC_COUNT = 152
const H_COLLECTIONS = 160
const H_STACK_BASE = 168
const H_MSTACK = 176           # MarkItem { p, n }
const H_MTOP = 184
const H_MCAP = 192
const H_ROOTS = 200            # Range { lo, hi }
const H_ROOT_COUNT = 208
const H_ROOT_CAP = 216
const H_PAUSE_TOTAL = 224      # nanoseconds spent in collections
const H_PAUSE_MAX = 232        # the longest single collection, in nanoseconds
const H_MARK_TOTAL = 240       # nanoseconds spent marking
const H_SWEEP_TOTAL = 248      # nanoseconds spent sweeping
const H_STACK_LOW = 256        # lowest usable address of the program thread stack; 0 when unknown
const H_CHUNK_BASE = 264         # the start of the current chunk; 0 before the first
const H_CHUNK_USED = 272         # pages of it cut so far (a count, not an address: see _chunk_page)
const H_IDX = 280              # object index set by _page_of
const H_MARKING = 288          # 1 from the start of an incremental cycle until its marks are final
const H_VERIFY = 304           # 1: at the end of each incremental cycle check that no live object is unmarked
const H_VMODE = 312            # 1 while the verifier walks the heap
const H_VSTACK = 320           # 1 while the verifier reads the stack
const H_SWEEPING = 328         # 1 from the end of marking until every page is swept
const H_SWEEP_I = 336          # next page to sweep
const H_SWEEP_KEEP = 344       # pages kept so far; the list of pages is compacted as it is swept
const H_SWEEP_EPOCH = 352
const H_SWEEPSTEP_MAX = 360    # the longest incremental sweep step, in nanoseconds
const H_FINISH_MAX = 376       # the longest end of a cycle (verify, hook, sweep), in nanoseconds
const H_BEGIN_MAX = 384        # the longest start of a cycle (marking the roots), in nanoseconds
const H_CACHE_COUNT = 392
const H_CACHE_BYTES = 400
const H_CACHE_SPAN = 408       # span of the slot taken by _cache_take

func _die_oom() {
    write(2, cstr("Runtime Error: out of memory\n"), 29)
    exit(1)
}

func _class_size(c) {
    return ld32(addr_of("_class_sizes") + c * 4)
}

# Size-class lookup table, filled before the first allocation.
func _gc_setup() {
    let h = _heap()
    st64(h + H_SETUP_DONE, 1)
    st64(h + H_HEAP_LO, -1)
    st64(h + H_THRESHOLD, MIN_THRESHOLD)
    st64(h + H_EXTRA, 4 * MIN_THRESHOLD)
    st64(h + H_LIMIT, 4611686018427387904)
    let c = 0
    let tab = addr_of("_class_of")
    for (let i = 0; i <= MAX_SMALL / 16; i++) {
        while (_class_size(c) < i * 16) {
            c++
        }
        st8(tab + i, c)
    }
}

# Page table: the page descriptor of each 64 KB page, found from the address with two loads. The
# first level is indexed by bits 32 to 47 of the address, the second by bits 16 to 31.

func _table_insert(key, pg) {
    let h = _heap()
    if (ld64(h + H_TABLE) == 0) {
        let top = calloc(65536, 8)
        if (top == 0) {
            _die_oom()
        }
        st64a(h + H_TABLE, top)
    }
    let slot = ld64(h + H_TABLE) + shr(key, 16) * 8
    let l2 = ld64(slot)
    if (l2 == 0) {
        l2 = calloc(65536, 8)
        if (l2 == 0) {
            _die_oom()
        }
        st64a(slot, l2)
    }
    st64a(l2 + band(key, 65535) * 8, pg)    # the page is complete before the table shows it to the GC thread
}

func _table_find(key) {
    let h = _heap()
    let l2 = ld64a(ld64a(h + H_TABLE) + shr(key, 16) * 8)
    if (l2 == 0) {
        return 0
    }
    return ld64a(l2 + band(key, 65535) * 8)
}

# Pages

func _note_heap(lo, n) {
    let h = _heap()
    if (ult(lo, ld64(h + H_HEAP_LO))) {
        st64a(h + H_HEAP_LO, lo)
    }
    if (ugt(lo + n, ld64(h + H_HEAP_HI))) {
        st64a(h + H_HEAP_HI, lo + n)
    }
}

func _track_page(pg) {
    let h = _heap()
    if (ld64(h + H_ALL_COUNT) == ld64(h + H_ALL_CAP)) {
        if (ld64(h + H_ALL_CAP) != 0) {
            st64(h + H_ALL_CAP, ld64(h + H_ALL_CAP) * 2)
        } else {
            st64(h + H_ALL_CAP, 256)
        }
        st64(h + H_ALL_PAGES, realloc(ld64(h + H_ALL_PAGES), ld64(h + H_ALL_CAP) * 8))
        if (ld64(h + H_ALL_PAGES) == 0) {
            _die_oom()
        }
    }
    st64(ld64(h + H_ALL_PAGES) + ld64(h + H_ALL_COUNT) * 8, pg)
    st64(h + H_ALL_COUNT, ld64(h + H_ALL_COUNT) + 1)
}

func _init_small_page(pg, cls, atomic) {
    let h = _heap()
    let size = _class_size(cls)
    st32(pg + PG_CLS, cls)
    st32(pg + PG_EPOCH, ld64(h + H_SWEEP_EPOCH))
    st64(pg + PG_OBJ, size)
    st64(pg + PG_RECIP, udiv(4294967296, size) + 1)
    st32(pg + PG_NOBJS, PAGE_SIZE / size)
    st32(pg + PG_BUMP, 0)
    st32(pg + PG_FREE, 0)
    st32(pg + PG_NFREE, 0)
    st32(pg + PG_USED_COUNT, 0)
    st8(pg + PG_ATOMIC, atomic)
    st8(pg + PG_LARGE, 0)
    st8(pg + PG_IN_LIST, 0)
    free(ld64(pg + PG_USED))
    free(ld64(pg + PG_MARK))
    let n = ld32(pg + PG_NOBJS)
    st64(pg + PG_USED, calloc(n, 1))
    st64(pg + PG_MARK, calloc(n, 1))
    if (ld64(pg + PG_USED) == 0 or ld64(pg + PG_MARK) == 0) {
        _die_oom()
    }
}

# Maps a 2 MB chunk aligned to 2 MB, asks for huge pages and touches it, so that the kernel has zeroed
# and attached the memory when this returns. Returns 0 when the system has no memory left. The first
# touch of a huge page can take milliseconds, which is why the helper thread does it ahead of time. hint is
# 0 once the helper has seen the hint cost spikes (see _pre_main).
func _chunk_make(hint) {
    let raw = mmap(0, CHUNK_SIZE * 2, 3, 34, -1, 0)    # read and write, private and anonymous
    if (raw == -1 or raw == 0) {
        return 0
    }
    let base = band(raw + CHUNK_SIZE - 1, bnot(CHUNK_SIZE - 1))
    if (base > raw) {
        munmap(raw, base - raw)
    }
    let tail = raw + CHUNK_SIZE * 2 - (base + CHUNK_SIZE)
    if (tail > 0) {
        munmap(base + CHUNK_SIZE, tail)
    }
    if (hint != 0) {
        madvise(base, CHUNK_SIZE, 14)    # MADV_HUGEPAGE: a hint, ignored where unsupported
    } else {
        madvise(base, CHUNK_SIZE, 15)    # MADV_NOHUGEPAGE
    }
    st8(base, 0)
    return base
}

# The hint costs speed when the kernel has to compact memory to find a huge page, and the cost shows as a
# chunk that takes long to make. After HINT_SPIKES such chunks, new chunks stop asking for huge pages. There
# is no size limit on this: the kernel docs tie these stalls to fragmentation of free memory, not to the size
# of the heap. At 1 and 4 GiB no chunk took long and the hint stayed on; at 10 GiB it went off after about
# 6,400 chunks.
func _pre_judge(pre, dt) {
    st64(pre + PRE_MADE, ld64(pre + PRE_MADE) + 1)
    if (dt > ld64(pre + PRE_MAXNS)) {
        st64(pre + PRE_MAXNS, dt)
    }
    if (dt > SPIKE_NS) {
        st64(pre + PRE_SPIKES, ld64(pre + PRE_SPIKES) + 1)
    }
    if (ld64a(pre + PRE_HINT) != 0 and ld64(pre + PRE_SPIKES) >= HINT_SPIKES) {
        st64(pre + PRE_OFF_AT, ld64(pre + PRE_MADE))
        st64a(pre + PRE_HINT, 0)
    }
}

# The helper thread: keeps PRE_WANT chunks ready for the program thread. It sleeps on PRE_COND
# and holds the mutex only to decide whether to sleep, never while it makes a chunk.
func _pre_main(pre) {
    pthread_mutex_lock(pre + PRE_MUTEX)
    while (1 == 1) {
        let tail = ld64a(pre + PRE_TAIL)
        if (tail - ld64a(pre + PRE_HEAD) < ld64a(pre + PRE_WANT)) {
            pthread_mutex_unlock(pre + PRE_MUTEX)
            let t0 = _now_ns()
            let base = _chunk_make(ld64a(pre + PRE_HINT))
            if (base == 0) {
                return 0    # out of memory: the program thread meets it on its own path
            }
            _pre_judge(pre, _now_ns() - t0)
            st64(pre + PRE_RING + (tail % PRE_SLOTS) * 8, base)
            st64a(pre + PRE_TAIL, tail + 1)
            pthread_mutex_lock(pre + PRE_MUTEX)
        } else {
            pthread_cond_wait(pre + PRE_COND, pre + PRE_MUTEX)
        }
    }
    return 0
}

# A 64 KB page, zero filled and aligned to 64 KB. Pages are cut from 2 MB chunks of fresh anonymous
# memory, which the kernel zeroes, and which may be backed by huge pages: far fewer page faults than
# one allocation per page. A chunk comes ready from the helper thread when one is there.
func _chunk_page() {
    let h = _heap()
    if (ld64(h + H_CHUNK_BASE) == 0 or ld64(h + H_CHUNK_USED) == CHUNK_SIZE / PAGE_SIZE) {
        let base = 0
        let pre = ld64(h + H_PRE)
        if (pre != 0) {
            let head = ld64a(pre + PRE_HEAD)
            if (ld64a(pre + PRE_TAIL) != head) {
                base = ld64(pre + PRE_RING + (head % PRE_SLOTS) * 8)
                st64a(pre + PRE_HEAD, head + 1)
                st64(pre + PRE_HITS, ld64(pre + PRE_HITS) + 1)
            } else if (ld64a(pre + PRE_WANT) != 0) {
                st64(pre + PRE_MISSES, ld64(pre + PRE_MISSES) + 1)
                if (ld64a(pre + PRE_WANT) < PRE_SLOTS) {
                    st64a(pre + PRE_WANT, ld64a(pre + PRE_WANT) * 2)    # the program outruns the helper: keep more ready
                }
            } else {
                st64a(pre + PRE_WANT, 2)    # the second chunk has been asked for: from now on keep some ready
            }
            pthread_mutex_lock(pre + PRE_MUTEX)
            pthread_cond_signal(pre + PRE_COND)
            pthread_mutex_unlock(pre + PRE_MUTEX)
        }
        if (base == 0) {
            let hint = 1
            if (pre != 0) {
                hint = ld64a(pre + PRE_HINT)
            }
            base = _chunk_make(hint)
            if (base == 0) {
                _die_oom()
            }
        }
        st64(h + H_CHUNK_BASE, base)
        st64(h + H_CHUNK_USED, 0)
    }
    # The state is the chunk's start and a count, never the address just past its end: the collector scans
    # this block as a root, and an address one past the end is the start of whatever is mapped next to the
    # chunk, often a large object. That kept a dead large object reachable, and made the verifier report it.
    let page = ld64(h + H_CHUNK_BASE) + ld64(h + H_CHUNK_USED) * PAGE_SIZE
    st64(h + H_CHUNK_USED, ld64(h + H_CHUNK_USED) + 1)
    return page
}

func _new_small_page(cls, atomic) {
    let h = _heap()
    let pg = 0
    if (ld64(h + H_POOL_COUNT) != 0 and ld64(h + H_MARKING) == 0) {    # a pooled page is still in the page table: the GC thread may read it
        st64(h + H_POOL_COUNT, ld64(h + H_POOL_COUNT) - 1)
        pg = ld64(ld64(h + H_POOL) + ld64(h + H_POOL_COUNT) * 8)
        if (ld64(h + H_POOL_COLD) > ld64(h + H_POOL_COUNT)) {
            st64(h + H_POOL_COLD, ld64(h + H_POOL_COUNT))
        }
    }
    if (pg != 0) {
        st64(pg + PG_NEXT, 0)
        # A recycled page still holds its old objects. A fresh one is already zero.
        memset(ld64(pg + PG_BASE), 0, PAGE_SIZE)
        _init_small_page(pg, cls, atomic)
    } else {
        pg = calloc(1, PG_SIZE)
        let mem = _chunk_page()
        if (pg == 0) {
            _die_oom()
        }
        st64(pg + PG_BASE, mem)
        _note_heap(mem, PAGE_SIZE)
        _track_page(pg)
        _init_small_page(pg, cls, atomic)
        _table_insert(shr(mem, PAGE_SHIFT), pg)
    }
    return pg
}

# A freed large span is kept for reuse, because mapping and unmapping memory costs more than clearing
# it. The cache holds at most H_THRESHOLD bytes of touched memory, which is no more than the garbage that
# was resident before the sweep, so the peak does not grow. A span not reused within one collection is given back.
func _cache_take(need) {
    let h = _heap()
    for (let i = ld64(h + H_CACHE_COUNT) - 1; i >= 0; i--) {
        let e = (h + H_SPAN_CACHE) + i * 32
        let sp = ld64(e + 8)
        if (sp >= need and sp <= need + need / 4) {
            let base = ld64(e)
            st64(h + H_CACHE_SPAN, sp)
            st64(h + H_CACHE_BYTES, ld64(h + H_CACHE_BYTES) - (ld64(e + 24)))
            st64(h + H_CACHE_COUNT, ld64(h + H_CACHE_COUNT) - 1)
            let last = (h + H_SPAN_CACHE) + ld64(h + H_CACHE_COUNT) * 32
            st64(e, ld64(last))
            st64(e + 8, ld64(last + 8))
            st64(e + 16, ld64(last + 16))
            st64(e + 24, ld64(last + 24))
            st64(last, 0)    # a stale address in the data segment would keep a dead object alive
            st64(last + 8, 0)
            st64(last + 16, 0)
            st64(last + 24, 0)
            return base
        }
    }
    return 0
}

func _cache_put(mem, span, used) {
    let h = _heap()
    let touched = band(used + 4095, -4096)    # the part of the span that was ever written
    if (ld64(h + H_CACHE_COUNT) < SPAN_CACHE_SLOTS) {
        let e = (h + H_SPAN_CACHE) + ld64(h + H_CACHE_COUNT) * 32
        let stamp = ld64(h + H_COLLECTIONS)
        if (ld64(h + H_CACHE_BYTES) + touched > ld64(h + H_THRESHOLD)) {
            stamp = 0    # over the cap: expired at once, given back by _cache_trim in small pieces
        }
        st64(e, mem)
        st64(e + 8, span)
        st64(e + 16, stamp)
        st64(e + 24, touched)
        st64(h + H_CACHE_COUNT, ld64(h + H_CACHE_COUNT) + 1)
        st64(h + H_CACHE_BYTES, ld64(h + H_CACHE_BYTES) + (touched))
        return 0
    }
    munmap(mem, span)
}

# Gives back the cached spans that no allocation used since the previous collection, at most TRIM_BYTES
# at a time so that one call stays short. Returns 1 when it gave something back.
func _cache_trim() {
    let h = _heap()
    let budget = TRIM_BYTES
    let released = 0
    let i = 0
    while (i < ld64(h + H_CACHE_COUNT) and budget > 0) {
        let e = (h + H_SPAN_CACHE) + i * 32
        if (ld64(e + 16) < ld64(h + H_COLLECTIONS)) {
            let sp = ld64(e + 8)
            let n = sp
            if (n > budget) {
                n = budget
            }
            munmap(ld64(e), n)
            released = 1
            budget -= n
            let t = ld64(e + 24)
            let drop = n
            if (drop > t) {
                drop = t
            }
            st64(h + H_CACHE_BYTES, ld64(h + H_CACHE_BYTES) - (drop))
            if (n == sp) {
                st64(h + H_CACHE_COUNT, ld64(h + H_CACHE_COUNT) - 1)
                let last = (h + H_SPAN_CACHE) + ld64(h + H_CACHE_COUNT) * 32
                st64(e, ld64(last))
                st64(e + 8, ld64(last + 8))
                st64(e + 16, ld64(last + 16))
                st64(e + 24, ld64(last + 24))
                st64(last, 0)    # a stale address in the data segment would keep a dead object alive
                st64(last + 8, 0)
                st64(last + 16, 0)
                st64(last + 24, 0)
            } else {
                st64(e, ld64(e) + n)
                st64(e + 8, sp - n)
                st64(e + 24, t - drop)
            }
        } else {
            i++
        }
    }
    return released
}

# An object over MAX_SMALL gets its own span, rounded up to whole pages and aligned to 64 KB. A fresh
# mapping is zeroed by the kernel and touched only when used; a reused span is cleared here. The used
# and mark bytes live at the end of the descriptor.
func _alloc_large(n, atomic) {
    let h = _heap()
    let span = band(n + PAGE_SIZE - 1, bnot(PAGE_SIZE - 1))
    let mem = _cache_take(span)
    if (mem != 0) {
        span = ld64(h + H_CACHE_SPAN)
        memset(mem, 0, n)
    } else {
        let raw = mmap(0, span + PAGE_SIZE, 3, 34, -1, 0)    # read and write, private and anonymous
        if (raw == -1 or raw == 0) {
            _die_oom()
        }
        mem = band(raw + PAGE_SIZE - 1, bnot(PAGE_SIZE - 1))
        if (mem > raw) {
            munmap(raw, mem - raw)
        }
        munmap(mem + span, raw + PAGE_SIZE - mem)
    }
    let pg = calloc(1, PG_SIZE + 2)
    if (pg == 0) {
        _die_oom()
    }
    st64(pg + PG_BASE, mem)
    st64(pg + PG_OBJ, n)
    st32(pg + PG_EPOCH, ld64(h + H_SWEEP_EPOCH))
    st32(pg + PG_NOBJS, 1)
    st32(pg + PG_BUMP, 1)
    st32(pg + PG_USED_COUNT, 1)
    st8(pg + PG_ATOMIC, atomic)
    st8(pg + PG_LARGE, 1)
    st64(pg + PG_SPAN, span)
    st64(pg + PG_USED, pg + PG_SIZE)
    st64(pg + PG_MARK, pg + PG_SIZE + 1)
    st8(pg + PG_SIZE, 1)
    st8(pg + PG_SIZE + 1, ld64(h + H_MARKING))    # allocated during a cycle: survives it
    _note_heap(mem, span)
    let off = 0
    while (off < span) {
        _table_insert(shr(mem + off, PAGE_SHIFT), pg)
        off += PAGE_SIZE
    }
    _track_page(pg)
    st64(h + H_BYTES_SINCE_GC, ld64(h + H_BYTES_SINCE_GC) + (n))
    return mem
}

# Retires a dead large object: its page table entries and descriptor go, its span is cached or unmapped.
func _free_large(pg) {
    let mem = ld64(pg + PG_BASE)
    let span = ld64(pg + PG_SPAN)
    let off = 0
    while (off < span) {
        _table_insert(shr(mem + off, PAGE_SHIFT), 0)
        off += PAGE_SIZE
    }
    _cache_put(mem, span, ld64(pg + PG_OBJ))
    free(pg)
}

# Sets H_LIMIT: the threshold while collecting is allowed, -1 when every allocation is to be counted
# (stress mode), and out of reach while the collector runs or has not started.
func _set_limit() {
    let h = _heap()
    st64(h + H_LIMIT, 4611686018427387904)
    if (ld64(h + H_GC_READY) != 0 and ld64(h + H_GC_BUSY) == 0) {
        st64(h + H_LIMIT, ld64(h + H_THRESHOLD))
        if (ld64(h + H_MARKING) != 0 or ld64(h + H_SWEEPING) != 0 or _pool_pending() != 0) {
            st64(h + H_LIMIT, ld64(h + H_BYTES_SINCE_GC) + STEP_BYTES)
        }
        if (ld64(h + H_STRESS_EVERY) != 0) {
            st64(h + H_LIMIT, -1)
        }
    }
}

# The slow part of an allocation: whether it is time to collect.
func _gc_check() {
    let h = _heap()
    st64(h + H_ALLOC_COUNT, ld64(h + H_ALLOC_COUNT) + 1)
    if (ld64(h + H_GC_READY) != 0 and ld64(h + H_GC_BUSY) == 0) {
        if (ld64(h + H_MARKING) != 0 or ld64(h + H_SWEEPING) != 0) {
            _gc_work()
        } else if (ld64(h + H_BYTES_SINCE_GC) > ld64(h + H_THRESHOLD) or (ld64(h + H_STRESS_EVERY) != 0 and ld64(h + H_ALLOC_COUNT) % ld64(h + H_STRESS_EVERY) == 0)) {
            _gc_work()
        } else {
            _pool_trim()    # pages the sweep emptied go back to the system a few at a time, cycle or no cycle
            _set_limit()
        }
    }
}

# The allocation that almost every call is: a small object, no collector work due, and a page of that size
# class with a free slot or room to bump. It is kept short on purpose. _slow_gc_alloc is large (it can set
# up the collector, run a step of it, map a page, allocate a large object), and when its code sat in this
# function every call paid for it: six saved registers and a 264-byte frame before the first instruction.
func _gc_alloc(size, atomic) {
    let h = _heap()
    let n = size + 1    # keeps a pointer just past the end inside the object
    if (ld64(h + H_SETUP_DONE) != 0 and ule(n, MAX_SMALL) and ld64(h + H_BYTES_SINCE_GC) <= ld64(h + H_LIMIT)) {
        let cls = ld8(addr_of("_class_of") + (n + 15) / 16)
        let pg = ld64((h + H_CLASS_LIST) + atomic * 320 + cls * 8)
        if (pg != 0) {
            let osz = ld64(pg + PG_OBJ)
            let nfree = ld32(pg + PG_NFREE)
            let idx = ld32(pg + PG_BUMP)
            if (nfree != 0) {
                # The free slots are the zero bytes of the page's used map below PG_BUMP; there are nfree of them,
                # so the search ends. A sweep only clears bytes of that map: it does not touch the dead objects.
                let used = ld64(pg + PG_USED)
                idx = ld32(pg + PG_FREE)
                while (ld8(used + idx) != 0) {
                    idx++
                }
                st32(pg + PG_FREE, idx + 1)
                st32(pg + PG_NFREE, nfree - 1)
                let obj = ld64(pg + PG_BASE) + idx * osz
                memset(obj, 0, osz)    # a recycled object holds its old contents
                st8(used + idx, 1)
                if (ld64(h + H_MARKING) != 0) {
                    st8a(ld64(pg + PG_MARK) + idx, 1)    # allocated during a cycle: survives it
                }
                st64(h + H_BYTES_SINCE_GC, ld64(h + H_BYTES_SINCE_GC) + osz)
                return obj
            }
            if (idx < ld32(pg + PG_NOBJS)) {
                st32(pg + PG_BUMP, idx + 1)
                st8(ld64(pg + PG_USED) + idx, 1)
                if (ld64(h + H_MARKING) != 0) {
                    st8a(ld64(pg + PG_MARK) + idx, 1)
                }
                st64(h + H_BYTES_SINCE_GC, ld64(h + H_BYTES_SINCE_GC) + osz)
                return ld64(pg + PG_BASE) + idx * osz
            }
        }
    }
    return _slow_gc_alloc(size, atomic)
}

func _slow_gc_alloc(size, atomic) {
    let h = _heap()
    if (ld64(h + H_SETUP_DONE) == 0) {
        _gc_setup()
    }
    if (ugt(size, 70368744177664)) {
        _die_oom()    # more than 64 TiB: no request like that can be met, and size + 16 would wrap
    }
    let n = size + 1    # keeps a pointer just past the end inside the object
    if (ld64(h + H_BYTES_SINCE_GC) > ld64(h + H_LIMIT)) {
        _gc_check()
    }
    if (n > MAX_SMALL) {
        return _alloc_large(n, atomic)
    }
    let cls = ld8(addr_of("_class_of") + (n + 15) / 16)
    let head = (h + H_CLASS_LIST) + atomic * 320 + cls * 8
    let pg = ld64(head)
    while (pg != 0 and ld32(pg + PG_NFREE) == 0 and ld32(pg + PG_BUMP) >= ld32(pg + PG_NOBJS)) {
        st8(pg + PG_IN_LIST, 0)
        pg = ld64(pg + PG_NEXT)
        st64(head, pg)
    }
    if (pg == 0) {
        pg = _new_small_page(cls, atomic)
        st64(pg + PG_NEXT, ld64(head))
        st8(pg + PG_IN_LIST, 1)
        st64(head, pg)
    }
    let osz = ld64(pg + PG_OBJ)
    let idx = 0
    if (ld32(pg + PG_NFREE) != 0) {
        let used = ld64(pg + PG_USED)
        idx = ld32(pg + PG_FREE)
        while (ld8(used + idx) != 0) {
            idx++
        }
        st32(pg + PG_FREE, idx + 1)
        st32(pg + PG_NFREE, ld32(pg + PG_NFREE) - 1)
        memset(ld64(pg + PG_BASE) + idx * osz, 0, osz)    # a recycled object holds its old contents
    } else {
        idx = ld32(pg + PG_BUMP)
        st32(pg + PG_BUMP, idx + 1)
    }
    st8(ld64(pg + PG_USED) + idx, 1)
    if (ld64(h + H_MARKING) != 0) {
        st8a(ld64(pg + PG_MARK) + idx, 1)    # allocated during a cycle: survives it
    }
    let obj = ld64(pg + PG_BASE) + idx * osz
    st64(h + H_BYTES_SINCE_GC, ld64(h + H_BYTES_SINCE_GC) + (osz))
    return obj
}

func lv_alloc(n) {
    return _gc_alloc(n, 0)
}

func lv_alloc_atomic(n) {
    return _gc_alloc(n, 1)
}

# The page holding address w, or 0; the object's index is stored at idxp. The program thread uses
# H_IDX and the marking thread H_IDX_GC, so that two threads never share the slot.
func _page_find(w, idxp) {
    let h = _heap()
    if (ult(w, ld64a(h + H_HEAP_LO)) or uge(w, ld64a(h + H_HEAP_HI))) {
        return 0
    }
    if (ld64a(h + H_TABLE) == 0) {
        return 0
    }
    let pg = _table_find(shr(w, PAGE_SHIFT))
    if (pg == 0) {
        return 0
    }
    let idx = 0
    if (ld8(pg + PG_LARGE) != 0) {
        if (uge(w, ld64(pg + PG_BASE) + ld64(pg + PG_OBJ))) {
            return 0
        }
    } else {
        idx = shr((w - ld64(pg + PG_BASE)) * ld64(pg + PG_RECIP), 32)
        if (idx >= ld32(pg + PG_BUMP)) {
            return 0
        }
    }
    if (ld8(ld64(pg + PG_USED) + idx) == 0) {
        return 0
    }
    st64(idxp, idx)
    return pg
}

# The page holding address w, or 0; the object's index is left in H_IDX. Program thread only.
func _page_of(w) {
    let h = _heap()
    return _page_find(w, h + H_IDX)
}

func lv_realloc(p, n) {
    if (p == 0) {
        return _gc_alloc(n, 0)
    }
    let pg = _page_of(p)
    if (pg == 0) {
        _die_oom()
    }
    let old = ld64(pg + PG_OBJ)
    let q = _gc_alloc(n, ld8(pg + PG_ATOMIC))
    let m = n
    if (old < n) {
        m = old
    }
    memcpy(q, p, m)
    return q
}

# Marking

func _push(p, n) {
    let h = _heap()
    if (ld64(h + H_MTOP) == ld64(h + H_MCAP)) {
        if (ld64(h + H_MCAP) != 0) {
            st64(h + H_MCAP, ld64(h + H_MCAP) * 2)
        } else {
            st64(h + H_MCAP, 4096)
        }
        st64(h + H_MSTACK_GROW, ld64(h + H_MSTACK_GROW) + 1)
        st64(h + H_MSTACK, realloc(ld64(h + H_MSTACK), ld64(h + H_MCAP) * 16))
        if (ld64(h + H_MSTACK) == 0) {
            _die_oom()
        }
    }
    st64(ld64(h + H_MSTACK) + ld64(h + H_MTOP) * 16, p)
    st64(ld64(h + H_MSTACK) + ld64(h + H_MTOP) * 16 + 8, n)
    st64(h + H_MTOP, ld64(h + H_MTOP) + 1)
}

# Marks the object w points into and queues it for scanning on the mark stack. Used by the marking
# thread, and by the program thread at the start of a cycle and in the verifier (the GC thread sleeps then).
func _mark_word(w) {
    let h = _heap()
    let pg = _page_find(w, h + H_IDX_GC)
    if (pg == 0) {
        return 0
    }
    let idx = ld64(h + H_IDX_GC)
    let m = ld64(pg + PG_MARK) + idx
    if (ld64(h + H_VMODE) != 0) {
        return _vmark(pg, idx)
    }
    if (ld8a(m) != 0) {
        return 0
    }
    if (cas8(m, 0, 1) == 0) {    # the other thread marked it first
        return 0
    }
    if (ld8(pg + PG_ATOMIC) == 0) {
        let obj = ld64(pg + PG_BASE)
        if (ld8(pg + PG_LARGE) == 0) {
            obj = obj + idx * ld64(pg + PG_OBJ)
        }
        _push(obj, ld64(pg + PG_OBJ))
    }
    return 0
}

func _scan_range(lo, hi) {
    let h = _heap()
    let p = band(lo + 7, -8)
    let heap_lo = ld64a(h + H_HEAP_LO)
    let heap_hi = ld64a(h + H_HEAP_HI)
    while (ule(p + 8, hi)) {
        let w = ld64(p)
        if (uge(w, heap_lo) and ult(w, heap_hi)) {    # most words (tags, ints) are not heap addresses: skip the call
            _mark_word(w)
        }
        p += 8
    }
}

# Marking by the program thread while the GC thread runs: the barrier. The object is marked here, so that
# it is queued once, and handed over in batches.
func _shade_word(w) {
    let h = _heap()
    let pg = _page_find(w, h + H_IDX)
    if (pg == 0) {
        return 0
    }
    let idx = ld64(h + H_IDX)
    let m = ld64(pg + PG_MARK) + idx
    if (ld8a(m) != 0) {
        return 0
    }
    if (cas8(m, 0, 1) == 0) {
        return 0
    }
    if (ld8(pg + PG_ATOMIC) == 0) {
        let obj = ld64(pg + PG_BASE)
        if (ld8(pg + PG_LARGE) == 0) {
            obj = obj + idx * ld64(pg + PG_OBJ)
        }
        _local_add(obj, ld64(pg + PG_OBJ))
    }
    return 0
}

func _shade_range(lo, hi) {
    let h = _heap()
    let p = band(lo + 7, -8)
    let heap_lo = ld64a(h + H_HEAP_LO)
    let heap_hi = ld64a(h + H_HEAP_HI)
    while (ule(p + 8, hi)) {
        let w = ld64(p)
        if (uge(w, heap_lo) and ult(w, heap_hi)) {
            _shade_word(w)
        }
        p += 8
    }
}

# The program thread's batch of marked objects the GC thread has to scan.
func _local_add(p, n) {
    let h = _heap()
    let i = ld64(h + H_LOCAL_N)
    st64(h + H_LOCAL_BUF + i * 16, p)
    st64(h + H_LOCAL_BUF + i * 16 + 8, n)
    st64(h + H_LOCAL_N, i + 1)
    if (i + 1 == LOCAL_CAP) {
        pthread_mutex_lock(h + H_MUTEX)
        _hand_over()
        pthread_mutex_unlock(h + H_MUTEX)
    }
}

# Moves the local batch to the shared one and wakes the GC thread if it ran dry. H_MUTEX is held.
func _hand_over() {
    let h = _heap()
    let k = ld64(h + H_LOCAL_N)
    if (k == 0) {
        return 0
    }
    let need = ld64(h + H_SHARED_N) + k
    if (need > ld64(h + H_SHARED_CAP)) {
        let cap = ld64(h + H_SHARED_CAP) * 2
        if (cap < need) {
            cap = need + 1024
        }
        st64(h + H_SHARED_BUF, realloc(ld64(h + H_SHARED_BUF), cap * 16))
        if (ld64(h + H_SHARED_BUF) == 0) {
            _die_oom()
        }
        st64(h + H_SHARED_CAP, cap)
    }
    memcpy(ld64(h + H_SHARED_BUF) + ld64(h + H_SHARED_N) * 16, h + H_LOCAL_BUF, k * 16)
    st64(h + H_SHARED_N, need)
    st64(h + H_LOCAL_N, 0)
    if (ld64(h + H_GCT_STATE) == 2) {
        st64(h + H_GCT_STATE, 1)
        pthread_cond_signal(h + H_COND_GC)
    }
    return 0
}

# Write barrier. While a cycle is marking, an object the program is about to overwrite a pointer to
# is marked first, so everything that was reachable when the cycle began is found (snapshot at the
# beginning). An overwritten word that is not a pointer is ignored by _mark_word.

# Before the 16-byte value at p is overwritten.
func lv_wb_cell(p) {
    let h = _heap()
    if (ld64(h + H_MARKING) != 0) {
        _shade_word(ld64(p + 8))
    }
    return 0
}

# Before the pointer stored at p is overwritten.
func lv_wb_word(p) {
    let h = _heap()
    if (ld64(h + H_MARKING) != 0) {
        _shade_word(ld64(p))
    }
    return 0
}

# Before the n bytes at p are overwritten or moved.
func lv_wb_range(p, n) {
    let h = _heap()
    if (ld64(h + H_MARKING) != 0) {
        let q = band(p + 7, -8)
        let e = p + n
        while (ule(q + 8, e)) {
            _shade_word(ld64(q))
            q += 8
        }
    }
    return 0
}

# Scans the piece of the top mark item (at most CHUNK_BYTES; the rest stays on the stack) and
# returns the number of words scanned.
func _scan_top() {
    let h = _heap()
    st64(h + H_MTOP, ld64(h + H_MTOP) - 1)
    let p = ld64(ld64(h + H_MSTACK) + ld64(h + H_MTOP) * 16)
    let n = ld64(ld64(h + H_MSTACK) + ld64(h + H_MTOP) * 16 + 8)
    if (n > CHUNK_BYTES) {
        _push(p + CHUNK_BYTES, n - CHUNK_BYTES)
        n = CHUNK_BYTES
    }
    _scan_range(p, p + n)
    return n / 8
}

func _drain() {
    let h = _heap()
    while (ld64(h + H_MTOP) != 0) {
        _scan_top()
    }
}

func _root_register(lo, hi) {
    let h = _heap()
    if (ld64(h + H_ROOT_COUNT) == ld64(h + H_ROOT_CAP)) {
        if (ld64(h + H_ROOT_CAP) != 0) {
            st64(h + H_ROOT_CAP, ld64(h + H_ROOT_CAP) * 2)
        } else {
            st64(h + H_ROOT_CAP, 64)
        }
        st64(h + H_ROOTS, realloc(ld64(h + H_ROOTS), ld64(h + H_ROOT_CAP) * 16))
        if (ld64(h + H_ROOTS) == 0) {
            _die_oom()
        }
    }
    st64(ld64(h + H_ROOTS) + ld64(h + H_ROOT_COUNT) * 16, lo)
    st64(ld64(h + H_ROOTS) + ld64(h + H_ROOT_COUNT) * 16 + 8, hi)
    st64(h + H_ROOT_COUNT, ld64(h + H_ROOT_COUNT) + 1)
}

# Adds a range that holds Zue values copied from elsewhere. During a cycle it holds what the program put
# there, so it is shaded now, unless the stepwise scan of the roots is still to reach it.
func lv_gc_root_add(lo, hi) {
    let h = _heap()
    _root_register(lo, hi)
    if (ld64(h + H_MARKING) != 0 and ld64(h + H_RS_ON) == 0) {
        _shade_range(lo, hi)
    }
}

# Adds a range that is zero filled, so that there is nothing to shade: an unsafe buffer from alloc(n).
# A store into it shades the value it overwrites (the write barrier in _cp), like a store into any object.
func lv_gc_root_add_fresh(lo, hi) {
    _root_register(lo, hi)
}

# The rest of range j, which the stepwise scan has not reached yet, is shaded now (the range is about to
# go away, or to change places with another).
func _root_finish(j) {
    let h = _heap()
    if (ld64(h + H_RS_ON) == 0 or j < ld64(h + H_RS_I)) {
        return 0
    }
    let e = ld64(h + H_ROOTS) + j * 16
    let pos = ld64(e)
    if (j == ld64(h + H_RS_I)) {
        pos = ld64(h + H_RS_POS)
    }
    _shade_range(pos, ld64(e + 8))
}

func lv_gc_root_remove(lo) {
    let h = _heap()
    for (let i = 0; i < ld64(h + H_ROOT_COUNT); i++) {
        if (ld64(ld64(h + H_ROOTS) + i * 16) == lo) {
            let last = ld64(h + H_ROOT_COUNT) - 1
            _root_finish(i)
            if (i != last and i < ld64(h + H_RS_I)) {
                _root_finish(last)    # it moves into a slot the scan has passed
            }
            st64(h + H_ROOT_COUNT, last)
            st64(ld64(h + H_ROOTS) + i * 16, ld64(ld64(h + H_ROOTS) + last * 16))
            st64(ld64(h + H_ROOTS) + i * 16 + 8, ld64(ld64(h + H_ROOTS) + last * 16 + 8))
            if (ld64(h + H_RS_ON) != 0 and i == ld64(h + H_RS_I) and i != last) {
                st64(h + H_RS_POS, ld64(ld64(h + H_ROOTS) + i * 16))    # the range that moved in is scanned from its start
            }
            return 0
        }
    }
}


func lv_gc_is_marked(p) {
    let h = _heap()
    let pg = _page_of(p)
    if (pg == 0) {
        return 1
    }
    return ld8(ld64(pg + PG_MARK) + ld64(h + H_IDX))
}

# Kept out of line, with every callee-saved register spilled into its frame, so that
# values held only in registers are found by the stack scan.
# Marks what the stack and the registers point to, without following it.
func _scan_stack_cur() {
    let h = _heap()
    spill_regs()
    let sp = stack_ptr()
    if (ult(sp, ld64(h + H_STACK_BASE))) {
        _scan_range(sp, ld64(h + H_STACK_BASE))
    }
}

# The verifier scans every stack at once. A cycle scans the stacks of the blue threads that are away in
# steps (_blue_scan_step).
func _scan_stack() {
    _scan_stack_cur()
    _blue_scan_parked()
}

# Marks what the data segment and the registered root ranges point to, without following it.
func _scan_static() {
    let h = _heap()
    # lv_frames (2.4 MB of call positions and static names) never holds a heap pointer
    let frames = addr_of("lv_frames")
    _scan_range(addr_of("__data_start"), frames)
    _scan_range(frames + 2400072, addr_of("_end"))
}

# Everything at once, for the verifier. A cycle scans the root ranges in steps instead (_root_step).
func _scan_roots() {
    let h = _heap()
    _scan_static()
    for (let i = 0; i < ld64(h + H_ROOT_COUNT); i++) {
        _scan_range(ld64(ld64(h + H_ROOTS) + i * 16), ld64(ld64(h + H_ROOTS) + i * 16 + 8))
    }
}

# One step of the scan of the root ranges that unsafe code registered: a slice of ROOT_STEP_WORDS words,
# so that a large buffer does not make one long pause. The program thread runs it between its own work.
# A store into a range that is still to be scanned shades the value it overwrites, so nothing the
# range held when the cycle began is lost. The cycle cannot end while this is on.
func _root_step() {
    let h = _heap()
    if (ld64(h + H_RS_ON) == 0) {
        return 0
    }
    let budget = ROOT_STEP_WORDS
    while (ld64(h + H_RS_I) < ld64(h + H_ROOT_COUNT) and budget > 0) {
        let e = ld64(h + H_ROOTS) + ld64(h + H_RS_I) * 16
        let hi = ld64(e + 8)
        let pos = ld64(h + H_RS_POS)
        let end = hi
        if (ult(pos + budget * 8, hi)) {
            end = pos + budget * 8
        }
        _shade_range(pos, end)
        if (ult(pos, end)) {
            budget -= (end - pos) / 8
        }
        if (uge(end, hi)) {
            st64(h + H_RS_I, ld64(h + H_RS_I) + 1)
            if (ld64(h + H_RS_I) < ld64(h + H_ROOT_COUNT)) {
                st64(h + H_RS_POS, ld64(ld64(h + H_ROOTS) + ld64(h + H_RS_I) * 16))
            }
        } else {
            st64(h + H_RS_POS, end)
        }
    }
    if (ld64(h + H_RS_I) >= ld64(h + H_ROOT_COUNT)) {
        st64(h + H_RS_ON, 0)
    }
}

# Sweeping

func _pool_push(pg) {
    let h = _heap()
    if (ld64(h + H_POOL_COUNT) == ld64(h + H_POOL_CAP)) {
        if (ld64(h + H_POOL_CAP) != 0) {
            st64(h + H_POOL_CAP, ld64(h + H_POOL_CAP) * 2)
        } else {
            st64(h + H_POOL_CAP, 64)
        }
        st64(h + H_POOL, realloc(ld64(h + H_POOL), ld64(h + H_POOL_CAP) * 8))
        if (ld64(h + H_POOL) == 0) {
            _die_oom()
        }
    }
    st64(ld64(h + H_POOL) + ld64(h + H_POOL_COUNT) * 8, pg)
    st64(h + H_POOL_COUNT, ld64(h + H_POOL_COUNT) + 1)
}

# Sweeping works page by page. A sweep starts with empty class lists; each page that is swept and has
# room goes back on its list, so the allocator only ever sees swept pages, and a page made during the
# sweep carries the current epoch and is not swept again. The list of pages is compacted as it is walked.

func _sweep_begin() {
    let h = _heap()
    st64(h + H_LIVE_BYTES, 0)
    memset((h + H_CLASS_LIST), 0, 640)
    st64(h + H_SWEEP_EPOCH, ld64(h + H_SWEEP_EPOCH) + 1)
    st64(h + H_SWEEP_I, 0)
    st64(h + H_SWEEP_KEEP, 0)
    st64(h + H_SWEEPING, 1)
}

# Sweeps one page. Returns 0 when the page was a dead large object and is gone.
func _sweep_page(pg) {
    let h = _heap()
    if (ld8(pg + PG_IN_LIST) == 3) {
        free(pg)    # a page that _pool_retire gave up: only the descriptor is left
        return 0
    }
    st32(pg + PG_EPOCH, ld64(h + H_SWEEP_EPOCH))
    if (ld8(pg + PG_IN_LIST) == 2) {
        return 1
    }
    if (ld8(pg + PG_LARGE) != 0) {
        if (ld8(ld64(pg + PG_MARK)) == 0) {
            _free_large(pg)
            return 0
        }
        st8(ld64(pg + PG_MARK), 0)
        st64(h + H_LIVE_BYTES, ld64(h + H_LIVE_BYTES) + (ld64(pg + PG_SPAN)))
        return 1
    }
    st8(pg + PG_IN_LIST, 0)
    st64(pg + PG_NEXT, 0)
    let used = ld64(pg + PG_USED)
    let mark = ld64(pg + PG_MARK)
    let osz = ld64(pg + PG_OBJ)
    let base = ld64(pg + PG_BASE)
    let bump = ld32(pg + PG_BUMP)
    let live = 0
    let nfree = 0
    for (let j = 0; j < bump; j++) {
        if (ld8(used + j) == 0) {
            nfree++    # free since an earlier sweep and not handed out again
            continue
        }
        if (ld8(mark + j) != 0) {
            st8(mark + j, 0)
            live++
            continue
        }
        # Dead: the slot is free once its byte in the used map is zero. The object itself is not touched here
        # (the allocator clears it when it hands it out, and has to write it then anyway).
        st8(used + j, 0)
        nfree++
        if (ld64(h + H_VERIFY) != 0) {
            memset(base + j * osz, 221, osz)    # a use after free then reads obvious garbage
        }
    }
    st32(pg + PG_FREE, 0)
    st32(pg + PG_NFREE, nfree)
    st32(pg + PG_USED_COUNT, live)
    st64(h + H_LIVE_BYTES, ld64(h + H_LIVE_BYTES) + (live * osz))
    if (live == 0) {
        # Empty: recycle the whole page for any size class.
        _pool_push(pg)
        st32(pg + PG_BUMP, 0)
        st32(pg + PG_FREE, 0)
        st32(pg + PG_NFREE, 0)
        st8(pg + PG_IN_LIST, 2)
        return 1
    }
    if (nfree != 0 or ld32(pg + PG_BUMP) < ld32(pg + PG_NOBJS)) {
        let head = (h + H_CLASS_LIST) + ld8(pg + PG_ATOMIC) * 320 + ld32(pg + PG_CLS) * 8
        st64(pg + PG_NEXT, ld64(head))
        st64(head, pg)
        st8(pg + PG_IN_LIST, 1)
    }
    return 1
}

# Sweeps pages for up to budget_ns (0: no time limit) or max_pages pages (0: no limit). Returns 1 when
# every page has been swept.
func _sweep_some(budget_ns, max_pages) {
    let h = _heap()
    let t_end = 0
    if (budget_ns != 0) {
        t_end = _now_ns() + budget_ns
    }
    let pages = 0
    while (ld64(h + H_SWEEP_I) < ld64(h + H_ALL_COUNT)) {
        let pg = ld64(ld64(h + H_ALL_PAGES) + ld64(h + H_SWEEP_I) * 8)
        st64(h + H_SWEEP_I, ld64(h + H_SWEEP_I) + 1)
        let keep = 1
        if (ld32(pg + PG_EPOCH) != ld64(h + H_SWEEP_EPOCH)) {
            keep = _sweep_page(pg)
        }
        if (keep != 0) {
            st64(ld64(h + H_ALL_PAGES) + ld64(h + H_SWEEP_KEEP) * 8, pg)
            st64(h + H_SWEEP_KEEP, ld64(h + H_SWEEP_KEEP) + 1)
        }
        pages++
        if (max_pages != 0 and pages >= max_pages) {
            break
        }
        if (t_end != 0 and _now_ns() >= t_end) {
            break
        }
    }
    if (ld64(h + H_SWEEP_I) >= ld64(h + H_ALL_COUNT)) {
        return 1
    }
    return 0
}

# ZUE_RT_GC_STATS=3: after each sweep, where the heap's bytes are: per size class the pages, the slots
# in use and the slots free, and the totals for large objects and pooled empty pages.
func _census() {
    let h = _heap()
    let acc = calloc(NCLASSES * 2 + 8, 8)
    if (acc == 0) {
        return 0
    }
    let large_n = 0
    let large_b = 0
    let pooled = 0
    for (let i = 0; i < ld64(h + H_ALL_COUNT); i++) {
        let pg = ld64(ld64(h + H_ALL_PAGES) + i * 8)
        if (ld8(pg + PG_LARGE) != 0) {
            large_n++
            large_b += ld64(pg + PG_SPAN)
            continue
        }
        if (ld8(pg + PG_IN_LIST) == 3) {
            continue
        }
        if (ld8(pg + PG_IN_LIST) == 2) {
            pooled++
            continue
        }
        let c = ld32(pg + PG_CLS)
        st64(acc + c * 16, ld64(acc + c * 16) + 1)
        st64(acc + c * 16 + 8, ld64(acc + c * 16 + 8) + ld32(pg + PG_USED_COUNT))
    }
    let buf = stack_buf(200)
    let total_pages = 0
    let total_live = 0
    for (let c = 0; c < NCLASSES; c++) {
        let np = ld64(acc + c * 16)
        if (np == 0) {
            continue
        }
        let used = ld64(acc + c * 16 + 8)
        let sz = _class_size(c)
        let slots = np * (PAGE_SIZE / sz)
        let n = snprintf(buf, 200, cstr("ZUE_RT_GC_CENSUS,class %d,size %d,%llu pages,%llu slots in use,%llu slots free,%llu%% of the page bytes in use\n"), c, sz, np, used, slots - used, used * sz * 100 / (np * PAGE_SIZE))
        write(2, buf, n)
        total_pages += np
        total_live += used * sz
    }
    let n2 = snprintf(buf, 200, cstr("ZUE_RT_GC_CENSUS,small pages %llu (%llu MiB), live in them %llu MiB, large objects %llu (%llu MiB), pooled empty pages %llu\n"), total_pages, total_pages * PAGE_SIZE / 1048576, total_live / 1048576, large_n, large_b / 1048576, pooled)
    write(2, buf, n2)
    free(acc)
    return 0
}

func _sweep_end() {
    let h = _heap()
    st64(h + H_ALL_COUNT, ld64(h + H_SWEEP_KEEP))
    st64(h + H_SWEEPING, 0)
    if (ld64(h + H_STATS) == 3) {
        _census()
    }
}

func _cpu_ns() {
    let ts = stack_buf(16)
    clock_gettime(3, ts)
    return ld64(ts) * 1000000000 + ld64(ts + 8)
}

const H_MSTACK_GROW = 424      # how often the mark stack was enlarged
const H_STATS = 432            # 1 when ZUE_RT_GC_STATS is set
const H_CLASS_LIST = 440    # Page*[2][40]: pages with room, per [atomic][class]
const H_SPAN_CACHE = 1080    # SpanSlot[512] { base, span, stamp, touched }: freed large spans kept for reuse
# The GC thread. Everything below is guarded by H_MUTEX except H_LOCAL_BUF and H_LOCAL_N,
# which only the program thread touches, and H_IDX_GC, which only the thread that marks uses.
const H_GCT_STATE = 17464      # 0: no cycle (the GC thread sleeps), 1: marking, 2: its mark stack is empty and it waits
const H_IDX_GC = 17480         # object index set by _page_find for the marking thread
const H_SHARED_N = 17488       # items the program thread has handed over and the GC thread has not taken yet
const H_SHARED_CAP = 17496
const H_SHARED_BUF = 17504     # MarkItem { p, n }
const H_LOCAL_N = 17512        # items waiting in H_LOCAL_BUF
const H_CYCLE_BYTES = 17520    # H_BYTES_SINCE_GC when the cycle began
const H_SLOW_US = 17528        # ZUE_RT_GC_SLOW: microseconds the GC thread sleeps after each piece of marking (to widen races in tests)
const H_GCT_NS = 17536         # nanoseconds the GC thread spent marking
const H_MUTEX = 17544          # pthread_mutex_t, 40 bytes, valid when zero filled
const H_COND_GC = 17584        # pthread_cond_t, 48 bytes: wakes the GC thread
const H_COND_DONE = 17632      # pthread_cond_t: the GC thread has run out of work
const H_LOCAL_BUF = 17680      # MarkItem[LOCAL_CAP]
const LOCAL_CAP = 256
const GCT_BATCH = 16384        # words the GC thread marks before it looks at what the program thread handed over
const THROTTLE_NS_STEP = 100000  # time a collector step of a program that allocates too fast is held back
const H_CYCLE_T0 = 21776       # when the running cycle began
const H_CYCLE_MAX = 21784      # the longest cycle from its start to final marks, in nanoseconds
const H_CYCLE_GCT0 = 21792     # H_GCT_NS when the running cycle began
const H_CYCLE_COST = 21800     # the pacer's measure of a cycle: nanoseconds from its start to the end of its sweep, per MiB of live data
const H_THROTTLE_CALL = 21808  # nanoseconds the running collector step has slept to slow the program down
const H_THROTTLE_NS = 21816    # nanoseconds slept in all steps
const H_THROTTLE_N = 21824     # steps that slept
const H_PAUSE_MAX_SLEEP = 21832  # of the longest pause, the nanoseconds that were the throttle's sleep
const H_THROTTLE_MAX = 21840   # the longest single sleep
const H_LAST_END = 21848      # when the last cycle ended
const H_ALLOC_RATE = 21856     # the pacer's measure of the program: bytes allocated per millisecond
const H_PRE = 21864            # the helper thread's block (calloc, so the collector never scans it); 0 when no helper runs
const H_RS_ON = 21872           # 1 while the root ranges from unsafe code are being scanned in steps (program thread only)
const H_RS_I = 21880           # the range being scanned
const H_RS_POS = 21888         # where in that range the scan has reached
const ROOT_STEP_WORDS = 32768  # words of root ranges scanned in one step of the collector (256 KB)
const H_BS_ON = 21896           # 1 while the stacks of the blue threads that are away are being scanned in steps (program thread only)
const H_BS_CUR = 21904          # the next thread whose stack is to be scanned
const H_LOWMEM = 21912            # 1 for a program built with --gc=lowmem: the pacer allows far less garbage
const HEAP_SIZE = 21920
# The block: the chunks the helper has made ready (mapped, hinted and touched), and what the two threads share.
const PRE_SLOTS = 16
const PRE_RING = 0             # PRE_SLOTS chunk addresses
const PRE_HEAD = 128           # next slot the program thread takes (written by the program thread only)
const PRE_TAIL = 136           # next slot the helper fills (written by the helper only)
const PRE_WANT = 144           # how many ready chunks the helper keeps; 0 until the program has asked for a second chunk
const PRE_MUTEX = 152          # pthread_mutex_t: only guards the helper's sleep
const PRE_COND = 192           # pthread_cond_t: wakes the helper when the program thread took a chunk
const PRE_HITS = 240           # chunks taken ready
const PRE_MISSES = 248         # times the ring was empty and the program thread had to make the chunk itself
const PRE_HINT = 256           # 1 while new chunks ask for huge pages; the helper turns it off (written by the helper only)
const PRE_MADE = 264           # chunks the helper has made
const PRE_SPIKES = 272         # of those, the ones that took more than SPIKE_NS
const PRE_OFF_AT = 280         # PRE_MADE when the hint went off; 0 while it is on
const PRE_MAXNS = 288          # the longest time the helper took to make a chunk
const PRE_SIZE = 296
const SPIKE_NS = 1000000       # a chunk that takes longer than this to make is a spike (the pause goal is below a millisecond)
const HINT_SPIKES = 3          # this many spikes switch the huge page hint off for the chunks made after them
space("_heap0", HEAP_SIZE)
space("lv_stack_low", 8)    # a copy of H_STACK_LOW for generated code, which does the stack test of a direct call itself

# The collector state in use. Zero filled until _gc_setup sets the fields that start non-zero.
func _heap() {
    return addr_of("_heap0")
}

func _now_ns() {
    let ts = stack_buf(16)
    clock_gettime(1, ts)
    return ld64(ts) * 1000000000 + ld64(ts + 8)
}

# Gives the memory of the oldest empty pages back to the OS. The newest ones stay, as many as the
# program can allocate before the next collection; a recycled page is cleared when it is reused.
# At most TRIM_BATCH pages per call, and it stops after TRIM_STEP_NS, so that a step of the collector stays short.
# 1 when the pool holds empty pages beyond what is kept for reuse that have not been given back yet. Giving
# them back used to happen only inside the steps of a cycle, so how much came back depended on how many steps
# the sweep took; a sweep that does not touch dead objects takes few.
func _pool_pending() {
    let h = _heap()
    let keep = ld64(h + H_THRESHOLD) / PAGE_SIZE
    if (ld64(h + H_POOL_COUNT) > keep and ld64(h + H_POOL_COLD) < ld64(h + H_POOL_COUNT) - keep) {
        return 1
    }
    if (ld64(h + H_MARKING) == 0 and ld64(h + H_POOL_COLD) > keep / 4) {
        return 1
    }
    return 0
}

# A page in the pool whose memory has been given back (a cold one) still costs its descriptor, its two maps,
# and its place in the page table and in the address space. The allocator does not take pooled pages while a
# cycle marks (the GC thread may read them), so a program that allocates much during cycles makes new pages
# while the pool fills with cold ones, and without this they pile up for as long as the program runs: a heap
# of constant size grew by about 1.5 GiB over 600 million allocations. This gives the oldest cold pages beyond
# a quarter of the pages kept ready up completely. It is done only when no cycle is marking, because only
# then nothing reads the page table or the maps but the program thread. The descriptor stays in the list of
# all pages, marked 3, and the next sweep drops it (see _sweep_page).
func _pool_retire() {
    let h = _heap()
    if (ld64(h + H_MARKING) != 0) {
        return 0
    }
    let cold_keep = ld64(h + H_THRESHOLD) / PAGE_SIZE / 4
    let cold = ld64(h + H_POOL_COLD)
    if (cold <= cold_keep) {
        return 0
    }
    let n = cold - cold_keep
    if (n > RETIRE_BATCH) {
        n = RETIRE_BATCH
    }
    let pool = ld64(h + H_POOL)
    let t_end = _now_ns() + TRIM_STEP_NS
    let i = 0
    while (i < n) {
        let pg = ld64(pool + i * 8)
        let base = ld64(pg + PG_BASE)
        _table_insert(shr(base, PAGE_SHIFT), 0)
        free(ld64(pg + PG_USED))
        free(ld64(pg + PG_MARK))
        st64(pg + PG_USED, 0)
        st64(pg + PG_MARK, 0)
        munmap(base, PAGE_SIZE)
        st8(pg + PG_IN_LIST, 3)
        i++
        if (_now_ns() >= t_end) {
            break
        }
    }
    memmove(pool, pool + i * 8, (ld64(h + H_POOL_COUNT) - i) * 8)
    st64(h + H_POOL_COUNT, ld64(h + H_POOL_COUNT) - i)
    st64(h + H_POOL_COLD, ld64(h + H_POOL_COLD) - i)
    return 0
}

func _pool_trim() {
    _pool_retire()
    let h = _heap()
    let keep = ld64(h + H_THRESHOLD) / PAGE_SIZE
    if (ld64(h + H_POOL_COUNT) > keep) {
        let cold = ld64(h + H_POOL_COUNT) - keep
        if (cold > ld64(h + H_POOL_COLD) + TRIM_BATCH) {
            cold = ld64(h + H_POOL_COLD) + TRIM_BATCH
        }
        let t_end = _now_ns() + TRIM_STEP_NS
        while (ld64(h + H_POOL_COLD) < cold) {
            madvise(ld64(ld64(ld64(h + H_POOL) + ld64(h + H_POOL_COLD) * 8) + PG_BASE), PAGE_SIZE, 4)    # MADV_DONTNEED
            st64(h + H_POOL_COLD, ld64(h + H_POOL_COLD) + 1)
            if (_now_ns() >= t_end) {
                break    # a call on a huge page splits it and can take a long time
            }
        }
    }
}

# After a sweep: the pacer. It measures how fast the program allocated and how long the cycle took for
# the live data it had, and from them estimates what the program will allocate during the next cycle (a).
# The heap goal is twice that, so the marker finishes before the program is slowed down, but never more
# than the live size and never more than half of the free memory of the machine. The next cycle begins
# when the rest of the goal (goal minus a) has been allocated. A heap this small has a floor,
# MIN_THRESHOLD, so that it does not collect all the time.
func _after_sweep() {
    let h = _heap()
    let now = _now_ns()
    let live = ld64(h + H_LIVE_BYTES)
    let since = ld64(h + H_BYTES_SINCE_GC)
    # What was allocated while the cycle ran survives it, so it is counted as live. The goal is a multiple of
    # what the program really holds, not of that: with it the goal grew with the garbage it was meant to bound.
    let during = since - ld64(h + H_CYCLE_BYTES)
    if (during > 0) {
        live = live - during
        if (live < ld64(h + H_LIVE_BYTES) / 2) {
            live = ld64(h + H_LIVE_BYTES) / 2
        }
    }
    let elapsed = now - ld64(h + H_LAST_END)
    if (ld64(h + H_LAST_END) != 0 and elapsed > 0) {
        let rate = since * 1000000 / elapsed
        if (ld64(h + H_ALLOC_RATE) != 0) {
            rate = (rate + ld64(h + H_ALLOC_RATE)) / 2
        }
        st64(h + H_ALLOC_RATE, rate)
    }
    st64(h + H_LAST_END, now)
    let mib = live / 1048576
    if (mib < 1) {
        mib = 1
    }
    let cost = (now - ld64(h + H_CYCLE_T0)) / mib
    if (ld64(h + H_CYCLE_COST) != 0) {
        cost = (cost + ld64(h + H_CYCLE_COST)) / 2
    }
    st64(h + H_CYCLE_COST, cost)
    let cycle_ms = mib * cost / 1000000
    let a = ld64(h + H_ALLOC_RATE) * cycle_ms
    let goal = 4 * a
    let top = 2 * live
    if (ld64(h + H_LOWMEM) != 0) {
        top = live / 8    # --gc=lowmem: memory first, so the goal is a small part of the live size and cycles come more often
    }
    if (top < 2 * MIN_THRESHOLD) {
        top = 2 * MIN_THRESHOLD
    }
    # The heap may grow until the free memory of the machine is nearly used up, not further: past that the
    # kernel reclaims and compacts inside a page fault of the program (one run stalled 12 ms). The free
    # pages shrink as this heap grows, so what the heap holds now is added back.
    let room = (sysconf(86) * sysconf(30) + ld64(h + H_ALL_COUNT) * PAGE_SIZE) / 100 * 85 - live    # _SC_AVPHYS_PAGES
    # A limit on the address space (ulimit -v) bounds the heap too. Stacks, the GC thread, freed memory not
    # yet given back and the program itself take the rest, so the heap may use 70 percent of it.
    let rl = stack_buf(16)
    if (getrlimit(9, rl) == 0 and ld64(rl) > 0) {    # RLIMIT_AS; the unlimited value is all ones, which reads as -1
        let as_room = ld64(rl) / 100 * 70 - live
        if (as_room < room) {
            room = as_room
        }
    }
    if (room < 0) {
        room = 0
    }
    if (goal > top) {
        goal = top
    }
    if (goal > room) {
        goal = room
    }
    if (goal < 2 * MIN_THRESHOLD) {
        goal = 2 * MIN_THRESHOLD
    }
    st64(h + H_EXTRA, goal)
    let next = goal - a
    if (next < MIN_THRESHOLD) {
        next = MIN_THRESHOLD
    }
    st64(h + H_THRESHOLD, next)
    st64(h + H_BYTES_SINCE_GC, 0)
    _pool_trim()
}

func _count_pause(dt) {
    let h = _heap()
    st64(h + H_PAUSE_TOTAL, ld64(h + H_PAUSE_TOTAL) + (dt))
    if (dt > ld64(h + H_PAUSE_MAX)) {
        st64(h + H_PAUSE_MAX, dt)
        st64(h + H_PAUSE_MAX_SLEEP, ld64(h + H_THROTTLE_CALL))
    }
}

# Incremental collection. A cycle begins by marking the roots (the stack, the registers, the data
# segment and the root ranges), which is the snapshot. The program then runs between steps; each step
# scans a bounded number of words. When nothing is left to scan the marks are final, the cycle ends
# with a sweep, and the next cycle can begin.

func _gc_begin() {
    let h = _heap()
    st64(h + H_COLLECTIONS, ld64(h + H_COLLECTIONS) + 1)
    st64(h + H_MTOP, 0)
    st64(h + H_MARKING, 1)
    _scan_static()
    if (ld64(h + H_ROOT_COUNT) != 0) {
        st64(h + H_RS_I, 0)
        st64(h + H_RS_POS, ld64(ld64(h + H_ROOTS)))
        st64(h + H_RS_ON, 1)
    }
    _scan_stack_cur()
    _blue_begin_scan()
    # The roots are the snapshot. From here the GC thread owns the mark stack.
    st64(h + H_CYCLE_BYTES, ld64(h + H_BYTES_SINCE_GC))
    st64(h + H_CYCLE_T0, _now_ns())
    st64(h + H_CYCLE_GCT0, ld64(h + H_GCT_NS))
    pthread_mutex_lock(h + H_MUTEX)
    st64(h + H_GCT_STATE, 1)
    pthread_cond_signal(h + H_COND_GC)
    pthread_mutex_unlock(h + H_MUTEX)
}

# The GC thread. It sleeps while no cycle runs. During a cycle it marks from its own mark stack, takes
# the batches the program thread hands over (the objects the write barrier marked), and says so when it
# has nothing left. The program thread then ends the cycle.
func _gct_take() {
    let h = _heap()
    let n = ld64(h + H_SHARED_N)
    let buf = ld64(h + H_SHARED_BUF)
    for (let i = 0; i < n; i++) {
        _push(ld64(buf + i * 16), ld64(buf + i * 16 + 8))
    }
    st64(h + H_SHARED_N, 0)
}

func _gct_main(arg) {
    let h = _heap()
    pthread_mutex_lock(h + H_MUTEX)
    while (1 == 1) {
        while (ld64(h + H_GCT_STATE) == 0) {
            pthread_cond_wait(h + H_COND_GC, h + H_MUTEX)
        }
        _gct_take()
        if (ld64(h + H_MTOP) != 0) {
            pthread_mutex_unlock(h + H_MUTEX)
            let t0 = _now_ns()
            let work = 0
            while (ld64(h + H_MTOP) != 0 and work < GCT_BATCH) {
                work += _scan_top()
            }
            st64(h + H_GCT_NS, ld64(h + H_GCT_NS) + (_now_ns() - t0))
            if (ld64(h + H_SLOW_US) != 0) {
                usleep(ld64(h + H_SLOW_US))
            }
            pthread_mutex_lock(h + H_MUTEX)
        } else {
            st64(h + H_GCT_STATE, 2)
            pthread_cond_broadcast(h + H_COND_DONE)
            while (ld64(h + H_GCT_STATE) == 2) {
                pthread_cond_wait(h + H_COND_GC, h + H_MUTEX)
            }
        }
    }
    return 0
}

# ZUE_RT_GC_STATS=2: one line per cycle.
func _trace_cycle(wall) {
    let h = _heap()
    let buf = stack_buf(160)
    let n = snprintf(buf, 160, cstr("ZUE_RT_GC_CYCLE,%llu wall ns,%llu gc thread ns,%zu bytes allocated during the cycle,%zu bytes allocated before it\n"), wall, ld64(h + H_GCT_NS) - ld64(h + H_CYCLE_GCT0), ld64(h + H_BYTES_SINCE_GC) - ld64(h + H_CYCLE_BYTES), ld64(h + H_CYCLE_BYTES))
    write(2, buf, n)
}

# While the GC thread marks, asks whether it is done: returns 1 when the marks are final. The program
# thread hands over its batch first, so a marked object it still holds is never left behind. A program
# that allocates far more than the collector can keep up with is slowed down here, a little at a time,
# so that no single step is long.
func _cycle_poll() {
    let h = _heap()
    pthread_mutex_lock(h + H_MUTEX)
    _hand_over()
    let done = 0
    let slow = 0
    if (ld64(h + H_GCT_STATE) == 2 and ld64(h + H_SHARED_N) == 0 and ld64(h + H_RS_ON) == 0 and ld64(h + H_BS_ON) == 0) {
        st64(h + H_GCT_STATE, 0)    # the GC thread sleeps again, so the marks are the program thread's to use
        done = 1
    } else {
        if (ld64(h + H_BYTES_SINCE_GC) > ld64(h + H_EXTRA)) {
            slow = 1
        }
    }
    pthread_mutex_unlock(h + H_MUTEX)
    if (slow != 0) {
        # Spin instead of usleep: a sleep can overshoot by milliseconds, a spin takes what it is told.
        let t0 = _now_ns()
        let spins = 0
        while (_now_ns() - t0 < THROTTLE_NS_STEP) {
            spins += 1    # no sched_yield: giving up the core can hand it to the GC thread for a whole time slice
        }
        let dt = _now_ns() - t0
        st64(h + H_THROTTLE_CALL, ld64(h + H_THROTTLE_CALL) + dt)
        st64(h + H_THROTTLE_NS, ld64(h + H_THROTTLE_NS) + dt)
        st64(h + H_THROTTLE_N, ld64(h + H_THROTTLE_N) + 1)
        if (dt > ld64(h + H_THROTTLE_MAX)) {
            st64(h + H_THROTTLE_MAX, dt)
        }
    }
    return done
}

# The marks are final: check them if asked, free the boxes of dead templates, and start the sweep.
func _gc_finish() {
    let h = _heap()
    if (ld64(h + H_VERIFY) != 0) {
        _verify_marks()
    }
    st64(h + H_MARKING, 0)
    lv_data_gc_hook()
    _sweep_begin()
}

# One stop of the incremental collector. While sweeping it sweeps for a short time. Otherwise it begins
# a cycle if none is running, scans one step, and ends the marking when nothing is left to scan.
func _gc_work() {
    let h = _heap()
    let t0 = _now_ns()
    st64(h + H_THROTTLE_CALL, 0)
    st64(h + H_GC_BUSY, 1)
    _pool_trim()
    if (ld64(h + H_SWEEPING) != 0) {
        let ns = SWEEP_STEP_NS
        let pages = 0
        if (ld64(h + H_STRESS_EVERY) != 0) {
            ns = 0
            pages = 1    # one page per step, to interleave the program with the sweep as much as possible
        }
        _cache_trim()
        if (_sweep_some(ns, pages) != 0) {
            _sweep_end()
            _after_sweep()
        }
        let dt = _now_ns() - t0
        st64(h + H_SWEEP_TOTAL, ld64(h + H_SWEEP_TOTAL) + (dt))
        if (dt > ld64(h + H_SWEEPSTEP_MAX)) {
            st64(h + H_SWEEPSTEP_MAX, dt)
        }
    } else {
        if (ld64(h + H_MARKING) == 0) {
            _gc_begin()
            if (_now_ns() - t0 > ld64(h + H_BEGIN_MAX)) {
                st64(h + H_BEGIN_MAX, _now_ns() - t0)
            }
        }
        if (ld64(h + H_MARKING) != 0) {
            _root_step()
            _blue_scan_step()
        }
        if (ld64(h + H_MARKING) != 0 and _cycle_poll() != 0) {
            let t1 = _now_ns()
            if (t1 - ld64(h + H_CYCLE_T0) > ld64(h + H_CYCLE_MAX)) {
                st64(h + H_CYCLE_MAX, t1 - ld64(h + H_CYCLE_T0))
            }
            if (ld64(h + H_STATS) == 2) {
                _trace_cycle(t1 - ld64(h + H_CYCLE_T0))
            }
            _gc_finish()
            if (_now_ns() - t1 > ld64(h + H_FINISH_MAX)) {
                st64(h + H_FINISH_MAX, _now_ns() - t1)
            }
        }
    }
    st64(h + H_GC_BUSY, 0)
    _set_limit()
    _count_pause(_now_ns() - t0)
}

# The verifier. At the end of a cycle every object that can be reached from the roots must be marked.
# It walks the heap again, with a second bit in the mark byte as the visited flag. A word on the stack
# that points at an unmarked object is skipped: a stale word left in an unused stack slot can point at
# an object that died before the cycle began, and the program cannot reach it through that word.

func _verify_fail(pg, idx) {
    let obj = ld64(pg + PG_BASE)
    if (ld8(pg + PG_LARGE) == 0) {
        obj = obj + idx * ld64(pg + PG_OBJ)
    }
    let buf = stack_buf(192)
    let n = snprintf(buf, 192, cstr("Runtime Error: GC verify failed: the object at %p (%zu bytes) can be reached but was not marked\n"), obj, ld64(pg + PG_OBJ))
    write(2, buf, n)
    exit(1)
}

func _vmark(pg, idx) {
    let h = _heap()
    let m = ld64(pg + PG_MARK) + idx
    let v = ld8(m)
    if (band(v, 2) != 0) {
        return 0
    }
    if (band(v, 1) == 0) {
        if (ld64(h + H_VSTACK) != 0) {
            return 0
        }
        _verify_fail(pg, idx)
    }
    st8(m, v + 2)
    if (ld8(pg + PG_ATOMIC) == 0) {
        let obj = ld64(pg + PG_BASE)
        if (ld8(pg + PG_LARGE) == 0) {
            obj = obj + idx * ld64(pg + PG_OBJ)
        }
        _push(obj, ld64(pg + PG_OBJ))
    }
    return 0
}

func _verify_marks() {
    let h = _heap()
    st64(h + H_VMODE, 1)
    st64(h + H_MTOP, 0)
    _scan_roots()
    _drain()
    st64(h + H_VSTACK, 1)
    _scan_stack()
    st64(h + H_VSTACK, 0)
    _drain()
    st64(h + H_VMODE, 0)
}

func _gc_report() {
    let h = _heap()
    let buf = stack_buf(480)
    let n = snprintf(buf, 480, cstr("ZUE_RT_GC_STATS,%llu collections,%zu live bytes,%zu pages,%llu total pause ns,%llu max pause ns,%llu mark ns,%llu sweep ns,%llu max cycle end ns,%llu max cycle start ns,%llu mark stack grows,%llu max sweep step ns,%llu longest cycle ns\n"), ld64(h + H_COLLECTIONS), ld64(h + H_LIVE_BYTES), ld64(h + H_ALL_COUNT), ld64(h + H_PAUSE_TOTAL), ld64(h + H_PAUSE_MAX), ld64(h + H_MARK_TOTAL) + ld64(h + H_GCT_NS), ld64(h + H_SWEEP_TOTAL), ld64(h + H_FINISH_MAX), ld64(h + H_BEGIN_MAX), ld64(h + H_MSTACK_GROW), ld64(h + H_SWEEPSTEP_MAX), ld64(h + H_CYCLE_MAX))
    write(2, buf, n)
    let buf2 = stack_buf(256)
    let n2 = snprintf(buf2, 256, cstr("ZUE_RT_GC_THROTTLE,%llu steps slept,%llu total sleep ns,%llu longest sleep ns,%llu of the longest pause was sleep ns\n"), ld64(h + H_THROTTLE_N), ld64(h + H_THROTTLE_NS), ld64(h + H_THROTTLE_MAX), ld64(h + H_PAUSE_MAX_SLEEP))
    write(2, buf2, n2)
    let buf3 = stack_buf(256)
    let pre = ld64(h + H_PRE)
    let hits = 0
    let misses = 0
    let made = 0
    let spikes = 0
    let maxns = 0
    let off = 0
    if (pre != 0) {
        hits = ld64(pre + PRE_HITS)
        misses = ld64(pre + PRE_MISSES)
        made = ld64a(pre + PRE_MADE)
        spikes = ld64a(pre + PRE_SPIKES)
        maxns = ld64a(pre + PRE_MAXNS)
        off = ld64a(pre + PRE_OFF_AT)
    }
    let n3 = snprintf(buf3, 256, cstr("ZUE_RT_GC_CHUNKS,%llu taken ready,%llu made by the program thread,%llu made by the helper,%llu of them over a millisecond,%llu longest make ns,%llu chunks made when the hint went off (0: still on)\n"), hits, misses, made, spikes, maxns, off)
    write(2, buf3, n3)
}

# Called once from the thread that runs the program.
# Called first thing in main of a program built with --gc=lowmem.
func lv_gc_set_lowmem() {
    st64(_heap() + H_LOWMEM, 1)
}

func lv_gc_start() {
    let h = _heap()
    if (ld64(h + H_SETUP_DONE) == 0) {
        _gc_setup()
    }
    let attr = stack_buf(128)
    let out = stack_buf(16)
    if (pthread_getattr_np(pthread_self(), attr) == 0) {
        pthread_attr_getstack(attr, out, out + 8)
        pthread_attr_destroy(attr)
        st64(h + H_STACK_BASE, ld64(out) + ld64(out + 8))
        st64(h + H_STACK_LOW, ld64(out) + 262144)    # keep 256 KiB for the runtime itself
        st64(addr_of("lv_stack_low"), ld64(out) + 262144)
    } else {
        st64(h + H_STACK_BASE, frame_addr() + 4096)
    }
    let s = getenv(cstr("ZUE_RT_GC_STRESS"))
    if (s != 0 and ld8(s) != 0) {
        st64(h + H_STRESS_EVERY, strtoull(s, 0, 10))
    }
    let ver = getenv(cstr("ZUE_RT_GC_VERIFY"))
    if (ver != 0 and ld8(ver) != 0 and ld8(ver) != 48) {
        st64(h + H_VERIFY, 1)
    }
    if (getenv(cstr("ZUE_RT_GC_STATS")) != 0) {
        st64(h + H_STATS, 1)
        if (ld8(getenv(cstr("ZUE_RT_GC_STATS"))) == 50) {
            st64(h + H_STATS, 2)    # "2": also one line per cycle
        }
        if (ld8(getenv(cstr("ZUE_RT_GC_STATS"))) == 51) {
            st64(h + H_STATS, 3)    # "3": also a census of the heap after each sweep
        }
        atexit(fn_addr("_gc_report"))
    }
    let slow = getenv(cstr("ZUE_RT_GC_SLOW"))
    if (slow != 0 and ld8(slow) != 0) {
        st64(h + H_SLOW_US, strtoull(slow, 0, 10))
    }
    let th = stack_buf(16)
    if (pthread_create(th, 0, fn_addr("_gct_main"), 0) != 0) {
        write(2, cstr("Runtime Error: cannot start the garbage collector thread\n"), 57)
        exit(1)
    }
    let pth = stack_buf(16)
    let pre = calloc(1, PRE_SIZE)
    if (pre != 0) {
        st64(pre + PRE_HINT, 1)
        if (pthread_create(pth, 0, fn_addr("_pre_main"), pre) == 0) {
            st64(h + H_PRE, pre)    # if the helper cannot start, chunks are made on the program thread as before
        }
    }
    st64(h + H_GC_READY, 1)
    _set_limit()
}
