# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (c) 2026 GibblyGobbly
#
# zue_gc.zu: memory management for compiled Zue programs: a conservative,
# non-moving mark-and-sweep collector. Compiled with `zue --native`.
#
# Every runtime object is allocated here. Small objects come from 64 KB pages split
# into size classes; large ones get pages of their own. A collection marks everything
# reachable from the stack, the registers, the program's static data and any registered
# root ranges, treating every aligned word as a possible pointer (interior pointers
# count), then sweeps the rest. Objects that hold no pointers (strings, doubles, bytes)
# are allocated "atomic" and never scanned.
#
# Environment:
#   ZUE_RT_GC_STRESS=N  collect every N allocations (testing)
#   ZUE_RT_GC_STATS=1   print the collection count, live bytes, pages and the total and longest pause at exit

extern("malloc", "ptr", "i64")
extern("calloc", "ptr", "i64,i64")
extern("realloc", "ptr", "ptr,i64")
extern("free", "void", "ptr")
extern("aligned_alloc", "ptr", "i64,i64")
extern("mmap", "ptr", "ptr,i64,i32,i32,i32,i64")
extern("munmap", "i32", "ptr,i64")
extern("madvise", "i32", "ptr,i64,i32")
extern("memset", "ptr", "ptr,i32,i64")
extern("memcpy", "ptr", "ptr,ptr,i64")
extern("write", "i64", "i32,ptr,i64")
extern("exit", "void", "i32")
extern("getenv", "ptr", "ptr")
extern("strtoull", "i64", "ptr,ptr,i32")
extern("atexit", "i32", "ptr")
extern("clock_gettime", "i32", "i32,ptr")
extern("snprintf", "i32", "ptr,i64,ptr,...")
extern("pthread_self", "i64", "")
extern("pthread_getattr_np", "i32", "i64,ptr")
extern("pthread_attr_getstack", "i32", "ptr,ptr,ptr")
extern("pthread_attr_destroy", "i32", "ptr")

# struct Page
const PG_BASE = 0
const PG_OBJ = 8
const PG_NOBJS = 16       # u32
const PG_BUMP = 20        # u32, objects handed out at least once
const PG_FREE = 24        # u32, 1-based index of the first recycled object, 0 if none
const PG_NFREE = 28       # u32
const PG_USED_COUNT = 32  # u32
const PG_ATOMIC = 36      # u8
const PG_LARGE = 37       # u8
const PG_IN_LIST = 39     # u8
const PG_CLS = 40         # i32
const PG_EPOCH = 44       # u32, the sweep that last handled this page; a page of the current sweep is skipped
const PG_SPAN = 48        # bytes owned by a large page
const PG_USED = 56
const PG_MARK = 64
const PG_NEXT = 72
const PG_RECIP = 80       # i64, 2^32 / object size + 1: offset * PG_RECIP >> 32 is the object index
const PG_SIZE = 88

# struct Slot { key, page }
const SLOT_SIZE = 16

const PAGE_SHIFT = 16
const PAGE_SIZE = 65536
const MAX_SMALL = 32752
const MIN_THRESHOLD = 16777216
const CHUNK_SIZE = 2097152    # small-object pages are cut from chunks of this size (32 pages)
const NCLASSES = 31
const SPAN_CACHE_SLOTS = 512
const CHUNK_BYTES = 4096      # a larger object is scanned in pieces of this size
const STEP_WORDS = 16384      # words an incremental step scans before it gives control back
const STEP_BYTES = 8192       # bytes the program allocates between two steps
const SWEEP_STEP_NS = 50000   # time an incremental sweep step may take
const TRIM_BYTES = 1048576    # cached large-object memory given back per call of _cache_trim

table("_class_sizes", "i32", 16, 32, 48, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 384, 448, 512, 640, 768, 1024, 1280, 1536, 2048, 3072, 4096, 6144, 8192, 10920, 13104, 16368, 21840, 32752)
space("_class_of", 2056)       # u8[MAX_SMALL / 16 + 1]
space("_class_list", 512)      # Page*[2][32]: pages with room, per [atomic][class]
space("_span_cache", 16384)    # SpanSlot[512] { base, span, stamp, touched }: freed large spans kept for reuse

let g_setup_done = 0
let g_all_pages = 0
let g_all_count = 0
let g_all_cap = 0
let g_pool = 0
let g_pool_count = 0
let g_pool_cap = 0
let g_table = 0            # top level of the page table: 65536 pointers to second-level tables
let g_heap_lo = -1
let g_heap_hi = 0
let g_bytes_since_gc = 0
let g_threshold = MIN_THRESHOLD
let g_limit = 4611686018427387904    # bytes allocated since the last collection that make _gc_alloc look at the collector
let g_live_bytes = 0
let g_gc_ready = 0
let g_gc_busy = 0
let g_stress_every = 0
let g_alloc_count = 0
let g_collections = 0
let g_stack_base = 0
let g_mstack = 0           # MarkItem { p, n }
let g_mtop = 0
let g_mcap = 0
let g_roots = 0            # Range { lo, hi }
let g_root_count = 0
let g_root_cap = 0
let g_pause_total = 0      # nanoseconds spent in collections
let g_pause_max = 0        # the longest single collection, in nanoseconds
let g_mark_total = 0       # nanoseconds spent marking
let g_sweep_total = 0      # nanoseconds spent sweeping
let g_stack_low = 0        # lowest usable address of the program thread stack; 0 when unknown
let g_chunk_next = 0         # next unused page in the current chunk
let g_chunk_end = 0
let g_idx = 0              # object index set by _page_of
let g_marking = 0          # 1 from the start of an incremental cycle until its marks are final
let g_incremental = 0      # 1: collect in steps with a write barrier; 0: stop the world
let g_verify = 0           # 1: at the end of each incremental cycle check that no live object is unmarked
let g_vmode = 0            # 1 while the verifier walks the heap
let g_vstack = 0           # 1 while the verifier reads the stack
let g_sweeping = 0         # 1 from the end of marking until every page is swept
let g_sweep_i = 0          # next page to sweep
let g_sweep_keep = 0       # pages kept so far; the list of pages is compacted as it is swept
let g_sweep_epoch = 0
let g_sweepstep_max = 0    # the longest incremental sweep step, in nanoseconds
let g_slice_max = 0        # the longest incremental mark step, in nanoseconds
let g_finish_max = 0       # the longest end of a cycle (verify, hook, sweep), in nanoseconds
let g_begin_max = 0        # the longest start of a cycle (marking the roots), in nanoseconds
let g_cache_count = 0
let g_cache_bytes = 0
let g_cache_span = 0       # span of the slot taken by _cache_take

func _die_oom() {
    write(2, cstr("Runtime Error: out of memory\n"), 29)
    exit(1)
}

func _class_size(c) {
    return ld32(addr_of("_class_sizes") + c * 4)
}

# Size-class lookup table, filled before the first allocation.
func _gc_setup() {
    g_setup_done = 1
    let c = 0
    let tab = addr_of("_class_of")
    for (let i = 0; i <= MAX_SMALL / 16; i++) {
        while (_class_size(c) < i * 16) {
            c++
        }
        st8(tab + i, c)
    }
}

# Page table: the page descriptor of each 64 KB page, found from the address with two loads. The
# first level is indexed by bits 32 to 47 of the address, the second by bits 16 to 31.

func _table_insert(key, pg) {
    if (g_table == 0) {
        g_table = calloc(65536, 8)
        if (g_table == 0) {
            _die_oom()
        }
    }
    let slot = g_table + shr(key, 16) * 8
    let l2 = ld64(slot)
    if (l2 == 0) {
        l2 = calloc(65536, 8)
        if (l2 == 0) {
            _die_oom()
        }
        st64(slot, l2)
    }
    st64(l2 + band(key, 65535) * 8, pg)
}

func _table_find(key) {
    let l2 = ld64(g_table + shr(key, 16) * 8)
    if (l2 == 0) {
        return 0
    }
    return ld64(l2 + band(key, 65535) * 8)
}

# Pages

func _note_heap(lo, n) {
    if (ult(lo, g_heap_lo)) {
        g_heap_lo = lo
    }
    if (ugt(lo + n, g_heap_hi)) {
        g_heap_hi = lo + n
    }
}

func _track_page(pg) {
    if (g_all_count == g_all_cap) {
        if (g_all_cap != 0) {
            g_all_cap = g_all_cap * 2
        } else {
            g_all_cap = 256
        }
        g_all_pages = realloc(g_all_pages, g_all_cap * 8)
        if (g_all_pages == 0) {
            _die_oom()
        }
    }
    st64(g_all_pages + g_all_count * 8, pg)
    g_all_count++
}

func _init_small_page(pg, cls, atomic) {
    let size = _class_size(cls)
    st32(pg + PG_CLS, cls)
    st32(pg + PG_EPOCH, g_sweep_epoch)
    st64(pg + PG_OBJ, size)
    st64(pg + PG_RECIP, udiv(4294967296, size) + 1)
    st32(pg + PG_NOBJS, PAGE_SIZE / size)
    st32(pg + PG_BUMP, 0)
    st32(pg + PG_FREE, 0)
    st32(pg + PG_NFREE, 0)
    st32(pg + PG_USED_COUNT, 0)
    st8(pg + PG_ATOMIC, atomic)
    st8(pg + PG_LARGE, 0)
    st8(pg + PG_IN_LIST, 0)
    free(ld64(pg + PG_USED))
    free(ld64(pg + PG_MARK))
    let n = ld32(pg + PG_NOBJS)
    st64(pg + PG_USED, calloc(n, 1))
    st64(pg + PG_MARK, calloc(n, 1))
    if (ld64(pg + PG_USED) == 0 or ld64(pg + PG_MARK) == 0) {
        _die_oom()
    }
}

# A 64 KB page, zero filled and aligned to 64 KB. Pages are cut from 2 MB chunks of fresh anonymous
# memory, which the kernel zeroes, and which may be backed by huge pages: far fewer page faults than
# one allocation per page.
func _chunk_page() {
    if (g_chunk_next == g_chunk_end) {
        let raw = mmap(0, CHUNK_SIZE * 2, 3, 34, -1, 0)    # read and write, private and anonymous
        if (raw == -1 or raw == 0) {
            _die_oom()
        }
        let base = band(raw + CHUNK_SIZE - 1, bnot(CHUNK_SIZE - 1))
        if (base > raw) {
            munmap(raw, base - raw)
        }
        let tail = raw + CHUNK_SIZE * 2 - (base + CHUNK_SIZE)
        if (tail > 0) {
            munmap(base + CHUNK_SIZE, tail)
        }
        madvise(base, CHUNK_SIZE, 14)    # MADV_HUGEPAGE: a hint, ignored where unsupported
        g_chunk_next = base
        g_chunk_end = base + CHUNK_SIZE
    }
    let page = g_chunk_next
    g_chunk_next += PAGE_SIZE
    return page
}

func _new_small_page(cls, atomic) {
    let pg = 0
    if (g_pool_count != 0) {
        g_pool_count--
        pg = ld64(g_pool + g_pool_count * 8)
    }
    if (pg != 0) {
        st64(pg + PG_NEXT, 0)
        # A recycled page still holds its old objects. A fresh one is already zero.
        memset(ld64(pg + PG_BASE), 0, PAGE_SIZE)
    } else {
        pg = calloc(1, PG_SIZE)
        let mem = _chunk_page()
        if (pg == 0) {
            _die_oom()
        }
        st64(pg + PG_BASE, mem)
        _note_heap(mem, PAGE_SIZE)
        _table_insert(shr(mem, PAGE_SHIFT), pg)
        _track_page(pg)
    }
    _init_small_page(pg, cls, atomic)
    return pg
}

# A freed large span is kept for reuse, because mapping and unmapping memory costs more than clearing
# it. The cache holds at most g_threshold bytes of touched memory, which is no more than the garbage that
# was resident before the sweep, so the peak does not grow. A span not reused within one collection is given back.
func _cache_take(need) {
    for (let i = g_cache_count - 1; i >= 0; i--) {
        let e = addr_of("_span_cache") + i * 32
        let sp = ld64(e + 8)
        if (sp >= need and sp <= need + need / 4) {
            let base = ld64(e)
            g_cache_span = sp
            g_cache_bytes -= ld64(e + 24)
            g_cache_count--
            let last = addr_of("_span_cache") + g_cache_count * 32
            st64(e, ld64(last))
            st64(e + 8, ld64(last + 8))
            st64(e + 16, ld64(last + 16))
            st64(e + 24, ld64(last + 24))
            st64(last, 0)    # a stale address in the data segment would keep a dead object alive
            st64(last + 8, 0)
            st64(last + 16, 0)
            st64(last + 24, 0)
            return base
        }
    }
    return 0
}

func _cache_put(mem, span, used) {
    let touched = band(used + 4095, -4096)    # the part of the span that was ever written
    if (g_cache_count < SPAN_CACHE_SLOTS) {
        let e = addr_of("_span_cache") + g_cache_count * 32
        let stamp = g_collections
        if (g_cache_bytes + touched > g_threshold) {
            stamp = 0    # over the cap: expired at once, given back by _cache_trim in small pieces
        }
        st64(e, mem)
        st64(e + 8, span)
        st64(e + 16, stamp)
        st64(e + 24, touched)
        g_cache_count++
        g_cache_bytes += touched
        return 0
    }
    munmap(mem, span)
}

# Gives back the cached spans that no allocation used since the previous collection, at most TRIM_BYTES
# at a time so that one call stays short. Returns 1 when it gave something back.
func _cache_trim() {
    let budget = TRIM_BYTES
    let released = 0
    let i = 0
    while (i < g_cache_count and budget > 0) {
        let e = addr_of("_span_cache") + i * 32
        if (ld64(e + 16) < g_collections) {
            let sp = ld64(e + 8)
            let n = sp
            if (n > budget) {
                n = budget
            }
            munmap(ld64(e), n)
            released = 1
            budget -= n
            let t = ld64(e + 24)
            let drop = n
            if (drop > t) {
                drop = t
            }
            g_cache_bytes -= drop
            if (n == sp) {
                g_cache_count--
                let last = addr_of("_span_cache") + g_cache_count * 32
                st64(e, ld64(last))
                st64(e + 8, ld64(last + 8))
                st64(e + 16, ld64(last + 16))
                st64(e + 24, ld64(last + 24))
                st64(last, 0)    # a stale address in the data segment would keep a dead object alive
                st64(last + 8, 0)
                st64(last + 16, 0)
                st64(last + 24, 0)
            } else {
                st64(e, ld64(e) + n)
                st64(e + 8, sp - n)
                st64(e + 24, t - drop)
            }
        } else {
            i++
        }
    }
    return released
}

# Gives back every expired cached span, for the stop-the-world collector and for an explicit collection.
func _cache_trim_all() {
    let rounds = 0
    while (_cache_trim() != 0) {
        rounds++
    }
    return rounds
}

# An object over MAX_SMALL gets its own span, rounded up to whole pages and aligned to 64 KB. A fresh
# mapping is zeroed by the kernel and touched only when used; a reused span is cleared here. The used
# and mark bytes live at the end of the descriptor.
func _alloc_large(n, atomic) {
    let span = band(n + PAGE_SIZE - 1, bnot(PAGE_SIZE - 1))
    let mem = _cache_take(span)
    if (mem != 0) {
        span = g_cache_span
        memset(mem, 0, n)
    } else {
        let raw = mmap(0, span + PAGE_SIZE, 3, 34, -1, 0)    # read and write, private and anonymous
        if (raw == -1 or raw == 0) {
            _die_oom()
        }
        mem = band(raw + PAGE_SIZE - 1, bnot(PAGE_SIZE - 1))
        if (mem > raw) {
            munmap(raw, mem - raw)
        }
        munmap(mem + span, raw + PAGE_SIZE - mem)
    }
    let pg = calloc(1, PG_SIZE + 2)
    if (pg == 0) {
        _die_oom()
    }
    st64(pg + PG_BASE, mem)
    st64(pg + PG_OBJ, n)
    st32(pg + PG_EPOCH, g_sweep_epoch)
    st32(pg + PG_NOBJS, 1)
    st32(pg + PG_BUMP, 1)
    st32(pg + PG_USED_COUNT, 1)
    st8(pg + PG_ATOMIC, atomic)
    st8(pg + PG_LARGE, 1)
    st64(pg + PG_SPAN, span)
    st64(pg + PG_USED, pg + PG_SIZE)
    st64(pg + PG_MARK, pg + PG_SIZE + 1)
    st8(pg + PG_SIZE, 1)
    st8(pg + PG_SIZE + 1, g_marking)    # allocated during a cycle: survives it
    _note_heap(mem, span)
    let off = 0
    while (off < span) {
        _table_insert(shr(mem + off, PAGE_SHIFT), pg)
        off += PAGE_SIZE
    }
    _track_page(pg)
    g_bytes_since_gc += n
    return mem
}

# Retires a dead large object: its page table entries and descriptor go, its span is cached or unmapped.
func _free_large(pg) {
    let mem = ld64(pg + PG_BASE)
    let span = ld64(pg + PG_SPAN)
    let off = 0
    while (off < span) {
        _table_insert(shr(mem + off, PAGE_SHIFT), 0)
        off += PAGE_SIZE
    }
    _cache_put(mem, span, ld64(pg + PG_OBJ))
    free(pg)
}

# Sets g_limit: the threshold while collecting is allowed, -1 when every allocation is to be counted
# (stress mode), and out of reach while the collector runs or has not started.
func _set_limit() {
    g_limit = 4611686018427387904
    if (g_gc_ready != 0 and g_gc_busy == 0) {
        g_limit = g_threshold
        if (g_marking != 0 or g_sweeping != 0) {
            g_limit = g_bytes_since_gc + STEP_BYTES
        }
        if (g_stress_every != 0) {
            g_limit = -1
        }
    }
}

# The slow part of an allocation: whether it is time to collect.
func _gc_check() {
    g_alloc_count++
    if (g_gc_ready != 0 and g_gc_busy == 0) {
        if (g_marking != 0 or g_sweeping != 0) {
            _gc_work()
        } else if (g_bytes_since_gc > g_threshold or (g_stress_every != 0 and g_alloc_count % g_stress_every == 0)) {
            if (g_incremental != 0) {
                _gc_work()
            } else {
                _collect()
            }
        }
    }
}

func _gc_alloc(size, atomic) {
    if (g_setup_done == 0) {
        _gc_setup()
    }
    if (ugt(size, 70368744177664)) {
        _die_oom()    # more than 64 TiB: no request like that can be met, and size + 16 would wrap
    }
    let n = size + 1    # keeps a pointer just past the end inside the object
    if (g_bytes_since_gc > g_limit) {
        _gc_check()
    }
    if (n > MAX_SMALL) {
        return _alloc_large(n, atomic)
    }
    let cls = ld8(addr_of("_class_of") + (n + 15) / 16)
    let head = addr_of("_class_list") + atomic * 256 + cls * 8
    let pg = ld64(head)
    while (pg != 0 and ld32(pg + PG_FREE) == 0 and ld32(pg + PG_BUMP) >= ld32(pg + PG_NOBJS)) {
        st8(pg + PG_IN_LIST, 0)
        pg = ld64(pg + PG_NEXT)
        st64(head, pg)
    }
    if (pg == 0) {
        pg = _new_small_page(cls, atomic)
        st64(pg + PG_NEXT, ld64(head))
        st8(pg + PG_IN_LIST, 1)
        st64(head, pg)
    }
    let osz = ld64(pg + PG_OBJ)
    let idx = 0
    if (ld32(pg + PG_FREE) != 0) {
        idx = ld32(pg + PG_FREE) - 1
        st32(pg + PG_FREE, ld32(ld64(pg + PG_BASE) + idx * osz))
        st32(pg + PG_NFREE, ld32(pg + PG_NFREE) - 1)
        memset(ld64(pg + PG_BASE) + idx * osz, 0, osz)    # a recycled object holds its old contents
    } else {
        idx = ld32(pg + PG_BUMP)
        st32(pg + PG_BUMP, idx + 1)
    }
    st8(ld64(pg + PG_USED) + idx, 1)
    if (g_marking != 0) {
        st8(ld64(pg + PG_MARK) + idx, 1)    # allocated during a cycle: survives it
    }
    let obj = ld64(pg + PG_BASE) + idx * osz
    g_bytes_since_gc += osz
    return obj
}

func lv_alloc(n) {
    return _gc_alloc(n, 0)
}

func lv_alloc_atomic(n) {
    return _gc_alloc(n, 1)
}

# The page holding address w, or 0; the object's index is left in g_idx.
func _page_of(w) {
    if (ult(w, g_heap_lo) or uge(w, g_heap_hi)) {
        return 0
    }
    if (g_table == 0) {
        return 0
    }
    let pg = _table_find(shr(w, PAGE_SHIFT))
    if (pg == 0) {
        return 0
    }
    let idx = 0
    if (ld8(pg + PG_LARGE) != 0) {
        if (uge(w, ld64(pg + PG_BASE) + ld64(pg + PG_OBJ))) {
            return 0
        }
    } else {
        idx = shr((w - ld64(pg + PG_BASE)) * ld64(pg + PG_RECIP), 32)
        if (idx >= ld32(pg + PG_BUMP)) {
            return 0
        }
    }
    if (ld8(ld64(pg + PG_USED) + idx) == 0) {
        return 0
    }
    g_idx = idx
    return pg
}

func lv_realloc(p, n) {
    if (p == 0) {
        return _gc_alloc(n, 0)
    }
    let pg = _page_of(p)
    if (pg == 0) {
        _die_oom()
    }
    let old = ld64(pg + PG_OBJ)
    let q = _gc_alloc(n, ld8(pg + PG_ATOMIC))
    let m = n
    if (old < n) {
        m = old
    }
    memcpy(q, p, m)
    return q
}

# Marking

func _push(p, n) {
    if (g_mtop == g_mcap) {
        if (g_mcap != 0) {
            g_mcap = g_mcap * 2
        } else {
            g_mcap = 4096
        }
        g_mstack_grow++
        g_mstack = realloc(g_mstack, g_mcap * 16)
        if (g_mstack == 0) {
            _die_oom()
        }
    }
    st64(g_mstack + g_mtop * 16, p)
    st64(g_mstack + g_mtop * 16 + 8, n)
    g_mtop++
}

func _mark_word(w) {
    let pg = _page_of(w)
    if (pg == 0) {
        return 0
    }
    let idx = g_idx
    let m = ld64(pg + PG_MARK) + idx
    if (g_vmode != 0) {
        return _vmark(pg, idx)
    }
    if (ld8(m) != 0) {
        return 0
    }
    st8(m, 1)
    if (ld8(pg + PG_ATOMIC) == 0) {
        let obj = ld64(pg + PG_BASE)
        if (ld8(pg + PG_LARGE) == 0) {
            obj = obj + idx * ld64(pg + PG_OBJ)
        }
        _push(obj, ld64(pg + PG_OBJ))
    }
    return 0
}

func _scan_range(lo, hi) {
    let p = band(lo + 7, -8)
    while (ule(p + 8, hi)) {
        _mark_word(ld64(p))
        p += 8
    }
}

# Write barrier. While a cycle is marking, an object the program is about to overwrite a pointer to
# is marked first, so everything that was reachable when the cycle began is found (snapshot at the
# beginning). An overwritten word that is not a pointer is ignored by _mark_word.

# Before the 16-byte value at p is overwritten.
func lv_wb_cell(p) {
    if (g_marking != 0) {
        _mark_word(ld64(p + 8))
    }
    return 0
}

# Before the pointer stored at p is overwritten.
func lv_wb_word(p) {
    if (g_marking != 0) {
        _mark_word(ld64(p))
    }
    return 0
}

# Before the n bytes at p are overwritten or moved.
func lv_wb_range(p, n) {
    if (g_marking != 0) {
        let q = band(p + 7, -8)
        let e = p + n
        while (ule(q + 8, e)) {
            _mark_word(ld64(q))
            q += 8
        }
    }
    return 0
}

# Scans the piece of the top mark item (at most CHUNK_BYTES; the rest stays on the stack) and
# returns the number of words scanned.
func _scan_top() {
    g_mtop--
    let p = ld64(g_mstack + g_mtop * 16)
    let n = ld64(g_mstack + g_mtop * 16 + 8)
    if (n > CHUNK_BYTES) {
        _push(p + CHUNK_BYTES, n - CHUNK_BYTES)
        n = CHUNK_BYTES
    }
    _scan_range(p, p + n)
    return n / 8
}

func _drain() {
    while (g_mtop != 0) {
        _scan_top()
    }
}

func lv_gc_root_add(lo, hi) {
    if (g_root_count == g_root_cap) {
        if (g_root_cap != 0) {
            g_root_cap = g_root_cap * 2
        } else {
            g_root_cap = 64
        }
        g_roots = realloc(g_roots, g_root_cap * 16)
        if (g_roots == 0) {
            _die_oom()
        }
    }
    st64(g_roots + g_root_count * 16, lo)
    st64(g_roots + g_root_count * 16 + 8, hi)
    g_root_count++
    if (g_marking != 0) {
        _scan_range(lo, hi)    # a range added during a cycle holds what the program put there
    }
}

func lv_gc_root_remove(lo) {
    for (let i = 0; i < g_root_count; i++) {
        if (ld64(g_roots + i * 16) == lo) {
            g_root_count--
            st64(g_roots + i * 16, ld64(g_roots + g_root_count * 16))
            st64(g_roots + i * 16 + 8, ld64(g_roots + g_root_count * 16 + 8))
            return 0
        }
    }
}

func lv_gc_is_marked(p) {
    let pg = _page_of(p)
    if (pg == 0) {
        return 1
    }
    return ld8(ld64(pg + PG_MARK) + g_idx)
}

# Kept out of line, with every callee-saved register spilled into its frame, so that
# values held only in registers are found by the stack scan.
# Marks what the stack and the registers point to, without following it.
func _scan_stack() {
    spill_regs()
    let sp = stack_ptr()
    if (ult(sp, g_stack_base)) {
        _scan_range(sp, g_stack_base)
    }
}

func _scan_stack_and_registers() {
    _scan_stack()
    _drain()
}

# Marks what the data segment and the registered root ranges point to, without following it.
func _scan_roots() {
    # lv_frames (2.4 MB of call positions and static names) never holds a heap pointer
    let frames = addr_of("lv_frames")
    _scan_range(addr_of("__data_start"), frames)
    _scan_range(frames + 2400072, addr_of("_end"))
    for (let i = 0; i < g_root_count; i++) {
        _scan_range(ld64(g_roots + i * 16), ld64(g_roots + i * 16 + 8))
    }
}

# Sweeping

func _pool_push(pg) {
    if (g_pool_count == g_pool_cap) {
        if (g_pool_cap != 0) {
            g_pool_cap = g_pool_cap * 2
        } else {
            g_pool_cap = 64
        }
        g_pool = realloc(g_pool, g_pool_cap * 8)
        if (g_pool == 0) {
            _die_oom()
        }
    }
    st64(g_pool + g_pool_count * 8, pg)
    g_pool_count++
}

# Sweeping works page by page. A sweep starts with empty class lists; each page that is swept and has
# room goes back on its list, so the allocator only ever sees swept pages, and a page made during the
# sweep carries the current epoch and is not swept again. The list of pages is compacted as it is walked.

func _sweep_begin() {
    g_live_bytes = 0
    memset(addr_of("_class_list"), 0, 512)
    g_sweep_epoch++
    g_sweep_i = 0
    g_sweep_keep = 0
    g_sweeping = 1
}

# Sweeps one page. Returns 0 when the page was a dead large object and is gone.
func _sweep_page(pg) {
    st32(pg + PG_EPOCH, g_sweep_epoch)
    if (ld8(pg + PG_IN_LIST) == 2) {
        return 1
    }
    if (ld8(pg + PG_LARGE) != 0) {
        if (ld8(ld64(pg + PG_MARK)) == 0) {
            _free_large(pg)
            return 0
        }
        st8(ld64(pg + PG_MARK), 0)
        g_live_bytes += ld64(pg + PG_SPAN)
        return 1
    }
    st8(pg + PG_IN_LIST, 0)
    st64(pg + PG_NEXT, 0)
    let used = ld64(pg + PG_USED)
    let mark = ld64(pg + PG_MARK)
    let osz = ld64(pg + PG_OBJ)
    let base = ld64(pg + PG_BASE)
    let bump = ld32(pg + PG_BUMP)
    let live = 0
    for (let j = 0; j < bump; j++) {
        if (ld8(used + j) == 0) {
            continue
        }
        if (ld8(mark + j) != 0) {
            st8(mark + j, 0)
            live++
            continue
        }
        st8(used + j, 0)
        st32(base + j * osz, ld32(pg + PG_FREE))
        if (g_verify != 0) {
            memset(base + j * osz + 4, 221, osz - 4)    # a use after free then reads obvious garbage
        }
        st32(pg + PG_FREE, j + 1)
        st32(pg + PG_NFREE, ld32(pg + PG_NFREE) + 1)
    }
    st32(pg + PG_USED_COUNT, live)
    g_live_bytes += live * osz
    if (live == 0) {
        # Empty: recycle the whole page for any size class.
        _pool_push(pg)
        st32(pg + PG_BUMP, 0)
        st32(pg + PG_FREE, 0)
        st32(pg + PG_NFREE, 0)
        st8(pg + PG_IN_LIST, 2)
        return 1
    }
    if (ld32(pg + PG_FREE) != 0 or ld32(pg + PG_BUMP) < ld32(pg + PG_NOBJS)) {
        let head = addr_of("_class_list") + ld8(pg + PG_ATOMIC) * 256 + ld32(pg + PG_CLS) * 8
        st64(pg + PG_NEXT, ld64(head))
        st64(head, pg)
        st8(pg + PG_IN_LIST, 1)
    }
    return 1
}

# Sweeps pages for up to budget_ns (0: no time limit) or max_pages pages (0: no limit). Returns 1 when
# every page has been swept.
func _sweep_some(budget_ns, max_pages) {
    let t_end = 0
    if (budget_ns != 0) {
        t_end = _now_ns() + budget_ns
    }
    let pages = 0
    while (g_sweep_i < g_all_count) {
        let pg = ld64(g_all_pages + g_sweep_i * 8)
        g_sweep_i++
        let keep = 1
        if (ld32(pg + PG_EPOCH) != g_sweep_epoch) {
            keep = _sweep_page(pg)
        }
        if (keep != 0) {
            st64(g_all_pages + g_sweep_keep * 8, pg)
            g_sweep_keep++
        }
        pages++
        if (max_pages != 0 and pages >= max_pages) {
            break
        }
        if (t_end != 0 and _now_ns() >= t_end) {
            break
        }
    }
    if (g_sweep_i >= g_all_count) {
        return 1
    }
    return 0
}

func _sweep_end() {
    g_all_count = g_sweep_keep
    g_sweeping = 0
}

# The whole sweep at once, for the stop-the-world collector.
func _sweep() {
    _sweep_begin()
    _sweep_some(0, 0)
    _sweep_end()
    _cache_trim_all()
}

func _cpu_ns() {
    let ts = stack_buf(16)
    clock_gettime(3, ts)
    return ld64(ts) * 1000000000 + ld64(ts + 8)
}

let g_cpu_max = 0          # the longest incremental mark step in thread CPU time; wall time also counts being descheduled
let g_mstack_grow = 0      # how often the mark stack was enlarged
let g_stats = 0            # 1 when ZUE_RT_GC_STATS is set

func _now_ns() {
    let ts = stack_buf(16)
    clock_gettime(1, ts)
    return ld64(ts) * 1000000000 + ld64(ts + 8)
}

func _collect() {
    let t0 = _now_ns()
    g_gc_busy = 1
    _set_limit()
    g_collections++
    g_mtop = 0
    _scan_roots()
    _drain()
    _scan_stack_and_registers()
    lv_data_gc_hook()
    let t1 = _now_ns()
    _sweep()
    g_mark_total += t1 - t0
    g_sweep_total += _now_ns() - t1
    _after_sweep()
    g_gc_busy = 0
    _set_limit()
    _count_pause(_now_ns() - t0)
}

# After a sweep: the next collection comes when as many bytes have been allocated as are live.
func _after_sweep() {
    g_bytes_since_gc = 0
    if (g_live_bytes > MIN_THRESHOLD) {
        g_threshold = g_live_bytes
    } else {
        g_threshold = MIN_THRESHOLD
    }
}

func _count_pause(dt) {
    g_pause_total += dt
    if (dt > g_pause_max) {
        g_pause_max = dt
    }
}

# Incremental collection. A cycle begins by marking the roots (the stack, the registers, the data
# segment and the root ranges), which is the snapshot. The program then runs between steps; each step
# scans a bounded number of words. When nothing is left to scan the marks are final, the cycle ends
# with a sweep, and the next cycle can begin.

func _gc_begin() {
    g_collections++
    g_mtop = 0
    g_marking = 1
    _scan_roots()
    _scan_stack()
}

# Scans up to budget words. Returns 1 when no object is left to scan.
func _mark_some(budget) {
    let work = 0
    while (g_mtop != 0 and work < budget) {
        work += _scan_top()
    }
    if (g_mtop == 0) {
        return 1
    }
    return 0
}

# The marks are final: check them if asked, free the boxes of dead templates, and start the sweep.
func _gc_finish() {
    if (g_verify != 0) {
        _verify_marks()
    }
    g_marking = 0
    lv_data_gc_hook()
    _sweep_begin()
}

# One stop of the incremental collector. While sweeping it sweeps for a short time. Otherwise it begins
# a cycle if none is running, scans one step, and ends the marking when nothing is left to scan.
func _gc_work() {
    let t0 = _now_ns()
    g_gc_busy = 1
    if (g_sweeping != 0) {
        let ns = SWEEP_STEP_NS
        let pages = 0
        if (g_stress_every != 0) {
            ns = 0
            pages = 1    # one page per step, to interleave the program with the sweep as much as possible
        }
        _cache_trim()
        if (_sweep_some(ns, pages) != 0) {
            _sweep_end()
            _after_sweep()
        }
        let dt = _now_ns() - t0
        g_sweep_total += dt
        if (dt > g_sweepstep_max) {
            g_sweepstep_max = dt
        }
    } else {
        if (g_marking == 0) {
            _gc_begin()
            if (_now_ns() - t0 > g_begin_max) {
                g_begin_max = _now_ns() - t0
            }
        }
        let budget = STEP_WORDS
        if (g_stress_every != 0) {
            budget = 64    # many small steps, to interleave the program with the marking as much as possible
        }
        let c0 = 0
        if (g_stats != 0) {
            c0 = _cpu_ns()
        }
        let done = _mark_some(budget)
        if (g_stats != 0 and _cpu_ns() - c0 > g_cpu_max) {
            g_cpu_max = _cpu_ns() - c0
        }
        let t1 = _now_ns()
        g_mark_total += t1 - t0
        if (t1 - t0 > g_slice_max) {
            g_slice_max = t1 - t0
        }
        if (done != 0) {
            _gc_finish()
            if (_now_ns() - t1 > g_finish_max) {
                g_finish_max = _now_ns() - t1
            }
        }
    }
    g_gc_busy = 0
    _set_limit()
    _count_pause(_now_ns() - t0)
}

# The verifier. At the end of a cycle every object that can be reached from the roots must be marked.
# It walks the heap again, with a second bit in the mark byte as the visited flag. A word on the stack
# that points at an unmarked object is skipped: a stale word left in an unused stack slot can point at
# an object that died before the cycle began, and the program cannot reach it through that word.

func _verify_fail(pg, idx) {
    let obj = ld64(pg + PG_BASE)
    if (ld8(pg + PG_LARGE) == 0) {
        obj = obj + idx * ld64(pg + PG_OBJ)
    }
    let buf = stack_buf(192)
    let n = snprintf(buf, 192, cstr("Runtime Error: GC verify failed: the object at %p (%zu bytes) can be reached but was not marked\n"), obj, ld64(pg + PG_OBJ))
    write(2, buf, n)
    exit(1)
}

func _vmark(pg, idx) {
    let m = ld64(pg + PG_MARK) + idx
    let v = ld8(m)
    if (band(v, 2) != 0) {
        return 0
    }
    if (band(v, 1) == 0) {
        if (g_vstack != 0) {
            return 0
        }
        _verify_fail(pg, idx)
    }
    st8(m, v + 2)
    if (ld8(pg + PG_ATOMIC) == 0) {
        let obj = ld64(pg + PG_BASE)
        if (ld8(pg + PG_LARGE) == 0) {
            obj = obj + idx * ld64(pg + PG_OBJ)
        }
        _push(obj, ld64(pg + PG_OBJ))
    }
    return 0
}

func _verify_marks() {
    g_vmode = 1
    g_mtop = 0
    _scan_roots()
    _drain()
    g_vstack = 1
    _scan_stack()
    g_vstack = 0
    _drain()
    g_vmode = 0
}

func lv_gc_collect() {
    if (g_gc_ready != 0 and g_gc_busy == 0) {
        if (g_marking != 0 or g_sweeping != 0) {
            g_gc_busy = 1
            if (g_marking != 0) {
                _mark_some(4611686018427387904)
                _gc_finish()
            }
            _sweep_some(0, 0)
            _sweep_end()
            _after_sweep()
            _cache_trim_all()
            g_gc_busy = 0
            _set_limit()
        } else {
            _collect()
        }
    }
}

func _gc_report() {
    let buf = stack_buf(448)
    let n = snprintf(buf, 448, cstr("ZUE_RT_GC_STATS,%llu collections,%zu live bytes,%zu pages,%llu total pause ns,%llu max pause ns,%llu mark ns,%llu sweep ns,%llu max mark step ns,%llu max cycle end ns,%llu max cycle start ns,%llu max step cpu ns,%llu mark stack grows,%llu max sweep step ns\n"), g_collections, g_live_bytes, g_all_count, g_pause_total, g_pause_max, g_mark_total, g_sweep_total, g_slice_max, g_finish_max, g_begin_max, g_cpu_max, g_mstack_grow, g_sweepstep_max)
    write(2, buf, n)
}

# Called once from the thread that runs the program.
func lv_gc_start() {
    if (g_setup_done == 0) {
        _gc_setup()
    }
    let attr = stack_buf(128)
    let out = stack_buf(16)
    if (pthread_getattr_np(pthread_self(), attr) == 0) {
        pthread_attr_getstack(attr, out, out + 8)
        pthread_attr_destroy(attr)
        g_stack_base = ld64(out) + ld64(out + 8)
        g_stack_low = ld64(out) + 262144    # keep 256 KiB for the runtime itself
    } else {
        g_stack_base = frame_addr() + 4096
    }
    let s = getenv(cstr("ZUE_RT_GC_STRESS"))
    if (s != 0 and ld8(s) != 0) {
        g_stress_every = strtoull(s, 0, 10)
    }
    let inc = getenv(cstr("ZUE_RT_GC_INCR"))
    if (inc != 0 and ld8(inc) != 0 and ld8(inc) != 48) {
        g_incremental = 1
    }
    let ver = getenv(cstr("ZUE_RT_GC_VERIFY"))
    if (ver != 0 and ld8(ver) != 0 and ld8(ver) != 48) {
        g_verify = 1
    }
    if (getenv(cstr("ZUE_RT_GC_STATS")) != 0) {
        g_stats = 1
        atexit(fn_addr("_gc_report"))
    }
    g_gc_ready = 1
    _set_limit()
}
