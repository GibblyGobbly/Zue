#
# diag.zu: compile-time diagnostics. An error is recorded with the place it points at (a span), may
# carry labels on other places, a hint and notes, and is printed with the source line and carets
# under the exact text. The lexer, the parser and the checker record errors and go on, so one run can
# report every error; diag_exit_if_errors prints them all and ends the run.
#
# A span is a line, a column (counting bytes from 1) and an end line and end column (the column just
# after the last byte). A span with column 0 names only a line: no carets are drawn for it.

use { ST } from "state.zu"
use { code_for } from "error_codes.zu"
use { cut } from "ranges.zu"

export template Span { line: int, col: int, eline: int, ecol: int }
template Label { span: Span, text: string }
# guess is the undefined name the checker suggests a close name for ("did you mean"), or null. A
# suggestion compares the name with every name in scope, so it is made only for the errors that are
# printed (diag_shown), after all of them are known.
export template Diag {
    kind: string, file: string, lines: list<string>, span: Span, ptext: string, msg: string,
    labels: list<Label>, hint: string, notes: list<string>, trace: list<string>, guess: string
}

# More errors than this are counted but not printed.
let MAX_PRINTED = 100
# A tab is shown as this many spaces so that the carets line up with the code.
let TAB_WIDTH = 4

let DIAGS: list<Diag> = []

# "text" for the usual layout, "json" for one JSON object per error on its own line (for editors).
let FORMAT = {"mode": "text"}

export func diag_set_format(mode: string) {
    FORMAT.mode = mode
}

export func span_at(line: int, col: int, eline: int, ecol: int) -> Span {
    return Span(line, col, eline, ecol)
}

export func span_line(line: int) -> Span {
    return Span(line, 0, line, 0)
}

# The span of one token that starts at line, col and ends before ecol on the same line.
export func span_tok(line: int, col: int, ecol: int) -> Span {
    return Span(line, col, line, ecol)
}

# Records an error and returns it, so the caller can add labels, a hint or notes.
export func diag_new(kind: string, span: Span, msg: string) -> Diag {
    let d = Diag(kind, ST.src_file, ST.src_lines, span, "", msg, [], "", [], [], null)
    append(DIAGS, d)
    ERROR_LINES["{ST.src_file}:{span.line}"] = true
    if (not map_has(FILE_ORDER, ST.src_file)) {
        FILE_ORDER[ST.src_file] = len(map_keys(FILE_ORDER))
    }
    return d
}

# The lines that have an error ("file:line"), and the order in which files got their first error.
let ERROR_LINES: map<bool> = {}
let FILE_ORDER: map<int> = {}

# Text printed next to the carets of the main span.
export func diag_text(d: Diag, text: string) -> Diag {
    if (d == null) {
        return null
    }
    d.ptext = text
    return d
}

# Marks another place with dashes and a short text. The functions that take an error accept null
# (an error that was not recorded) and then do nothing, so a caller need not test for it.
export func diag_label(d: Diag, span: Span, text: string) -> Diag {
    if (d == null or span == null) {
        return d
    }
    append(d.labels, Label(span, text))
    return d
}

export func diag_hint(d: Diag, text: string) -> Diag {
    if (d == null) {
        return null
    }
    d.hint = text
    return d
}

# A line printed under the message, before the source: the chain of calls the checker followed.
export func diag_trace(d: Diag, text: string) -> Diag {
    if (d == null) {
        return null
    }
    append(d.trace, text)
    return d
}

# True when an error is already recorded on this line of the current file.
export func diag_on_line(line: int) -> bool {
    return map_has(ERROR_LINES, "{ST.src_file}:{line}")
}

# True for a byte that continues a UTF-8 character.
func is_cont(c: int) -> bool {
    return c >= 128 and c < 192
}

# The number of screen columns taken by the first n bytes of text.
func screen_width(text: string, n: int) -> int {
    let w = 0
    let m = len(text)
    if (n < m) {
        m = n
    }
    for (let k = 0; k < m; k++) {
        let ch = text[k]
        if (ch == '\t') {
            w += TAB_WIDTH
        } else if (not is_cont(code(ch))) {
            w += 1
        }
    }
    return w
}

# The source line with each tab replaced by spaces.
func shown_line(text: string) -> string {
    if (not contains(text, "\t")) {
        return text
    }
    return replace(text, "\t", repeat(" ", TAB_WIDTH))
}

# A mark under a line: where it starts on screen, how wide it is, its character and its text.
template Mark { at: int, width: int, ch: string, text: string }

# The marks of one source line: the main span (carets) and every label that sits on that line.
func line_marks(d: Diag, line: int, text: string) -> list<Mark> {
    let marks: list<Mark> = []
    let s = d.span
    if (s.col > 0 and s.line == line) {
        let first = s.col - 1
        let last = len(text)
        if (s.eline == s.line and s.ecol - 1 < last) {
            last = s.ecol - 1
        }
        let w = screen_width(cut(text, first, last), last - first)
        if (w < 1) {
            w = 1
        }
        append(marks, Mark(screen_width(text, first), w, "^", d.ptext))
    }
    for (let lb in d.labels) {
        let ls = lb.span
        if (ls.col > 0 and ls.line == line) {
            let first = ls.col - 1
            let last = len(text)
            if (ls.eline == ls.line and ls.ecol - 1 < last) {
                last = ls.ecol - 1
            }
            let w = screen_width(cut(text, first, last), last - first)
            if (w < 1) {
                w = 1
            }
            append(marks, Mark(screen_width(text, first), w, "-", lb.text))
        }
    }
    return marks
}

# Sorts marks by their start; a main mark goes before a label that starts at the same place.
func sort_marks(marks: list<Mark>) -> list<Mark> {
    let out: list<Mark> = []
    for (let m in marks) {
        let i = len(out)
        while (i > 0 and out[i - 1].at > m.at) {
            i -= 1
        }
        let rest = cut(out, i, len(out))
        let head = cut(out, 0, i)
        out = head
        append(out, m)
        for (let r in rest) {
            append(out, r)
        }
    }
    return out
}

# The row of carets and dashes, with the text of the last mark after it.
func underline_row(marks: list<Mark>) -> string {
    let row = ""
    let pos = 0
    for (let m in marks) {
        let start = m.at
        if (start < pos) {
            start = pos
        }
        row = row + repeat(" ", start - pos)
        let w = m.width - (start - m.at)
        if (w < 1) {
            w = 1
        }
        row = row + repeat(m.ch, w)
        pos = start + w
    }
    return row
}

# A row with a bar at the start of each given mark.
func bars_row(marks: list<Mark>) -> string {
    let row = ""
    let pos = 0
    for (let m in marks) {
        if (m.at >= pos) {
            row = row + repeat(" ", m.at - pos) + "|"
            pos = m.at + 1
        }
    }
    return row
}

# The rows drawn under one source line, without the gutter.
func mark_rows(marks: list<Mark>) -> list<string> {
    let sorted = sort_marks(marks)
    let rows: list<string> = []
    let n = len(sorted)
    let last = sorted[n - 1]
    let first_row = underline_row(sorted)
    if (len(last.text) > 0) {
        first_row = first_row + " " + last.text
    }
    append(rows, first_row)
    let pending: list<Mark> = []
    for (let i = 0; i < n - 1; i++) {
        if (len(sorted[i].text) > 0) {
            append(pending, sorted[i])
        }
    }
    if (len(pending) > 0) {
        append(rows, bars_row(pending))
        let k = len(pending) - 1
        while (k >= 0) {
            let row = bars_row(cut(pending, 0, k))
            let at = pending[k].at
            row = row + repeat(" ", at - len(row)) + pending[k].text
            append(rows, row)
            k -= 1
        }
    }
    return rows
}

func gutter_width(d: Diag) -> int {
    let top = d.span.line
    for (let lb in d.labels) {
        if (lb.span.line > top) {
            top = lb.span.line
        }
    }
    let w = len(to_string(top))
    if (w < 4) {
        w = 4
    }
    return w
}

# The lines of the source with their marks, for every line the error or a label points at.
func excerpt_rows(d: Diag) -> list<string> {
    let width = gutter_width(d)
    let blank = repeat(" ", width) + " |"
    let lines = [d.span.line]
    for (let lb in d.labels) {
        if (lb.span.col > 0 and not contains(lines, lb.span.line)) {
            append(lines, lb.span.line)
        }
    }
    sort(lines)
    let out: list<string> = []
    let prev = 0
    for (let ln in lines) {
        if (ln < 1 or ln > len(d.lines)) {
            continue
        }
        if (prev > 0 and ln - prev == 2) {
            append(out, pad_left(to_string(prev + 1), width, " ") + " | " + shown_line(d.lines[prev]))
        } else if (prev > 0 and ln - prev > 2) {
            append(out, "...")
        }
        let text = d.lines[ln - 1]
        append(out, pad_left(to_string(ln), width, " ") + " | " + shown_line(text))
        let marks = line_marks(d, ln, text)
        if (len(marks) > 0) {
            for (let row in mark_rows(marks)) {
                append(out, trim_right(blank + " " + row))
            }
        }
        prev = ln
    }
    return out
}

# " [E0201]" for a message that belongs to a family of errors, else "".
func code_text(msg: string) -> string {
    let c = code_for(msg)
    if (c == null) {
        return ""
    }
    return " [{c}]"
}

# The printed form of one error, as a list of lines.
export func render(d: Diag) -> list<string> {
    let out: list<string> = []
    append(out, "{d.kind}{code_text(d.msg)} in {d.file} at line {d.span.line}:")
    append(out, "  {d.msg}")
    for (let t in d.trace) {
        append(out, t)
    }
    let line = d.span.line
    if (line >= 1 and line <= len(d.lines)) {
        append(out, "")
        for (let row in excerpt_rows(d)) {
            append(out, row)
        }
        append(out, "")
    }
    if (len(d.hint) > 0) {
        append(out, "Hint: {d.hint}")
    }
    for (let n in d.notes) {
        append(out, "Note: {n}")
    }
    return out
}

# Position order: by file as recorded, then line, then column.
# Errors of one file come together, files in the order of their first error, and within a file by place.
func before(a: Diag, b: Diag) -> bool {
    if (a.file != b.file) {
        return FILE_ORDER[a.file] < FILE_ORDER[b.file]
    }
    if (a.span.line != b.span.line) {
        return a.span.line < b.span.line
    }
    return a.span.col < b.span.col
}

# A stable merge sort: errors at the same place keep the order they were found in. (An insertion that
# rebuilt the list made 10,000 errors take about 2 s.)
func sorted_diags() {
    return merge_sorted(DIAGS)
}

func merge_sorted(xs: list<Diag>) -> list<Diag> {
    let n = len(xs)
    if (n < 2) {
        return xs
    }
    let mid = n / 2
    let a = merge_sorted(cut(xs, 0, mid))
    let b = merge_sorted(cut(xs, mid, n))
    let out: list<Diag> = []
    let i = 0
    let j = 0
    while (i < len(a) and j < len(b)) {
        if (before(b[j], a[i])) {
            append(out, b[j])
            j += 1
        } else {
            append(out, a[i])
            i += 1
        }
    }
    while (i < len(a)) {
        append(out, a[i])
        i += 1
    }
    while (j < len(b)) {
        append(out, b[j])
        j += 1
    }
    return out
}

func json_str(s: string) -> string {
    let t = replace(s, "\\", "\\\\")
    t = replace(t, "\"", "\\\"")
    t = replace(t, "\n", "\\n")
    t = replace(t, "\t", "\\t")
    t = replace(t, "\r", "\\r")
    return "\"" + t + "\""
}

func json_span(sp: Span) -> string {
    return "\"line\": {sp.line}, \"column\": {sp.col}, \"end_line\": {sp.eline}, \"end_column\": {sp.ecol}"
}

func json_list(items: list<string>) -> string {
    let out: list<string> = []
    for (let x in items) {
        append(out, json_str(x))
    }
    return "[" + join(out, ", ") + "]"
}

# One error as a JSON object on one line.
func render_json(d: Diag) -> string {
    let labels: list<string> = []
    for (let lb in d.labels) {
        append(labels, "\{{json_span(lb.span)}, \"text\": {json_str(lb.text)}}")
    }
    let c = code_for(d.msg)
    let code = "null"
    if (c != null) {
        code = json_str(c)
    }
    return "\{\"kind\": {json_str(d.kind)}, \"code\": {code}, \"file\": {json_str(d.file)}, {json_span(d.span)}, \"message\": {json_str(d.msg)}, \"text\": {json_str(d.ptext)}, \"hint\": {json_str(d.hint)}, \"labels\": [{join(labels, ", ")}], \"notes\": {json_list(d.notes)}, \"trace\": {json_list(d.trace)}}"
}

# The recorded errors that diag_print_all prints, in that order: all of them as JSON, the first
# MAX_PRINTED as text.
export func diag_shown() {
    let all = sorted_diags()
    if (FORMAT.mode == "json" or len(all) <= MAX_PRINTED) {
        return all
    }
    return cut(all, 0, MAX_PRINTED)
}

# Prints every recorded error, in the order of the source, and forgets them.
export func diag_print_all() {
    let total = len(DIAGS)
    let all = diag_shown()
    if (FORMAT.mode == "json") {
        for (let d in all) {
            print(render_json(d))
        }
        DIAGS = []
        ERROR_LINES = {}
        return null
    }
    let shown = 0
    let last_blank = true
    for (let d in all) {
        if (not last_blank) {
            print("")
        }
        let rows = render(d)
        for (let row in rows) {
            print(row)
        }
        last_blank = len(rows) > 0 and rows[len(rows) - 1] == ""
        shown += 1
    }
    if (total > shown) {
        print("... and {total - shown} more errors not shown")
    }
    if (total > 1) {
        print("{total} errors found.")
    }
    DIAGS = []
    ERROR_LINES = {}
}

# Ends the run with status 1 if any error is recorded.
# How many errors are recorded so far.
export func diag_count() {
    return len(DIAGS)
}

export func diag_exit_if_errors() {
    if (len(DIAGS) > 0) {
        diag_print_all()
        exit(1)
    }
}

# Records one error that has only a line and stops at once. This is the old single error form.
export func die_line(kind: string, line: int, msg: string) {
    diag_new(kind, span_line(line), msg)
    diag_exit_if_errors()
}

# The least number of edits that turn a into b, where an edit inserts, deletes or replaces one
# character or swaps two neighbours; or limit + 1 as soon as it is clear the number is more than limit.
# Two strings whose lengths differ by more than limit need more edits than that, and once two rows in
# a row are all above limit no later row can come back under it, so most pairs stop early. rows holds
# three lists of at least len(b) + 1 items, reused from call to call.
func edit_distance(a: string, b: string, limit: int, rows: list<list<int>>) -> int {
    let n = len(a)
    let m = len(b)
    if (n - m > limit or m - n > limit) {
        return limit + 1
    }
    let older = rows[0]
    let prev = rows[1]
    let row = rows[2]
    for (let j = 0; j <= m; j++) {
        prev[j] = j
    }
    let prev_low = 0
    for (let i = 1; i <= n; i++) {
        row[0] = i
        let low = i
        let ca = a[i - 1]
        for (let j = 1; j <= m; j++) {
            let cost = 1
            if (ca == b[j - 1]) {
                cost = 0
            }
            let best = prev[j - 1] + cost
            if (prev[j] + 1 < best) {
                best = prev[j] + 1
            }
            if (row[j - 1] + 1 < best) {
                best = row[j - 1] + 1
            }
            if (i > 1 and j > 1 and ca == b[j - 2] and a[i - 2] == b[j - 1] and older[j - 2] + 1 < best) {
                best = older[j - 2] + 1
            }
            row[j] = best
            if (best < low) {
                low = best
            }
        }
        if (low > limit and prev_low > limit) {
            return limit + 1
        }
        let spare = older
        older = prev
        prev = row
        row = spare
        prev_low = low
    }
    if (prev[m] > limit) {
        return limit + 1
    }
    return prev[m]
}

# The candidate that is closest to word, or null when none is close enough to be a likely typo:
# within a third of the length of word (at least one edit). A difference in case alone counts as close.
export func suggest(word: string, candidates: list<string>) -> string {
    let limit = len(word) / 3
    if (limit < 1) {
        limit = 1
    }
    let lower = to_lower(word)
    let best = null
    let best_d = limit + 1
    # a candidate within limit edits is at most len(word) + limit long
    let rows: list<list<int>> = []
    for (let k = 0; k < 3; k++) {
        let r: list<int> = []
        for (let j = 0; j <= len(word) + limit; j++) {
            append(r, 0)
        }
        append(rows, r)
    }
    for (let c in candidates) {
        if (c == word or len(c) - len(word) >= best_d or len(word) - len(c) >= best_d) {
            continue
        }
        let dist = edit_distance(lower, lower_name(c), best_d - 1, rows)
        if (dist < best_d) {
            best = c
            best_d = dist
        }
    }
    return best
}

# to_lower of a name, made once for each name.
let LOWER_NAMES: map<string> = {}

func lower_name(c: string) -> string {
    if (not map_has(LOWER_NAMES, c)) {
        LOWER_NAMES[c] = to_lower(c)
    }
    return LOWER_NAMES[c]
}
