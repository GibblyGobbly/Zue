#
# emit_native.zu: the native backend. It compiles the runtime of Zue, which is written
# in Zue, to LLVM IR without any C in between.
#
# A native source file uses the ordinary Zue syntax but has one type: the 64-bit word.
# Integers, pointers and doubles (as their bit pattern) are all words; memory is read and
# written through the intrinsics below. Several files are compiled into one module and
# see each other's functions.
#
#   func name(a, b_i, c_p) { ... }   parameters; a suffix _i is a C int, _p a pointer
#   const NAME = 16                  a compile-time constant
#   let counter = 0                  a module-level word variable
#   extern("snprintf", "i32", "ptr,i64,ptr,...")    declares a C function
#   space("lv_depth", 4)             a zeroed global of that many bytes
#   tspace("lv_depth", 4)            the same, one for each operating system thread
#   per_thread("counter", "other")   the module-level variables named (declared after this line) are
#                                    one for each operating system thread
#   table("sizes", "i32", 16, 32)    a constant array
#
# Intrinsics: ld8 ld16 ld32 ld64 lds8 lds16 lds32 st8 st16 st32 st64, band bor bxor
# shl shr sar bnot, ult ule ugt uge udiv urem, addof subof mulof (overflow flags),
# fadd fsub fmul fdiv fneg flt fle fgt fge feq fne i2f f2i dbl, cstr addr_of fn_addr
# ld8a ld64a (acquire loads) st8a st64a (release stores) cas8 cas64 xadd64 fence (for data shared between threads),
# stack_buf frame_addr stack_ptr spill_regs call_ptr callv retv retp trap. p[i] reads and
# p[i] = v writes the 64-bit word at p + 8 * i.

use { die } from "util.zu"
use { Node, mk_id_line, nodes_under } from "ast_nodes.zu"
use { ll, ll_alloca, ll_br, ll_condbr, ll_escape, ll_label, ll_new_ctx, ll_new_label } from "ll_state.zu"
use { ll_reg } from "ll_state.zu"
use { find_local } from "ll_scope.zu"
use { Loop, ST, Var } from "state.zu"

# A native function: the kind of each parameter (see param_kind) and whether it returns an LV (retv/retp).
template NFunc { kinds: list<string>, lv: bool }
# A C function declared with extern: its result and parameter types, whether it takes more (...), and
# its LLVM signature.
template NExtern { ret: string, params: list<string>, variadic: bool, sig: string }
# What the files of the module declare and the text made for them.
template NState {
    funcs: map<NFunc>, order: list<Node>, externs: map<NExtern>, consts: map<int>, gvars: map<bool>,
    datas: map<int>, decls: list<string>, decl_ids: map<bool>, strs: list<string>, str_ids: map<string>,
    defs: list<string>, syms: map<bool>, tls: map<bool>
}
let NS = NState({}, [], {}, {}, {}, {}, [], {}, [], {}, [], {}, {})

# One native source file and its statements.
export template NativeFile { path: string, stmts: list<Node> }

# The value of a constant expression.
template Konst { v: int }

# One argument of a call to a C function: the value and the LLVM type it is passed as.
template NArg { v: string, ty: string }

let TWO_OPS: map<string> = {
    "band": "and", "bor": "or", "bxor": "xor", "shl": "shl", "shr": "lshr", "sar": "ashr",
    "udiv": "udiv", "urem": "urem"
}
let CMP_OPS: map<string> = {
    "ult": "ult", "ule": "ule", "ugt": "ugt", "uge": "uge"
}
let FLT_OPS: map<string> = {"fadd": "fadd", "fsub": "fsub", "fmul": "fmul", "fdiv": "fdiv"}
let FCMP_OPS: map<string> = {"flt": "olt", "fle": "ole", "fgt": "ogt", "fge": "oge", "feq": "oeq", "fne": "une"}
let LOADS: map<string> = {
    "ld8": "i8", "ld16": "i16", "ld32": "i32", "ld64": "i64",
    "lds8": "i8", "lds16": "i16", "lds32": "i32"
}
let STORES: map<string> = {"st8": "i8", "st16": "i16", "st32": "i32", "st64": "i64"}
let ALOADS: map<string> = {"ld8a": "i8", "ld64a": "i64"}
let ASTORES: map<string> = {"st8a": "i8", "st64a": "i64"}
let WIDTH: map<int> = {"i8": 1, "i16": 2, "i32": 4, "i64": 8}
let OVF: map<string> = {"addof": "sadd", "subof": "ssub", "mulof": "smul"}
let ARITY: map<int> = {
    "band": 2, "bor": 2, "bxor": 2, "shl": 2, "shr": 2, "sar": 2, "udiv": 2, "urem": 2,
    "bnot": 1, "ult": 2, "ule": 2, "ugt": 2, "uge": 2,
    "addof": 2, "subof": 2, "mulof": 2,
    "fadd": 2, "fsub": 2, "fmul": 2, "fdiv": 2, "fneg": 1, "flt": 2, "fle": 2, "fgt": 2,
    "fge": 2, "feq": 2, "fne": 2, "i2f": 1, "f2i": 1,
    "ld8": 1, "ld16": 1, "ld32": 1, "ld64": 1, "lds8": 1, "lds16": 1, "lds32": 1,
    "ld8a": 1, "ld64a": 1, "st8a": 2, "st64a": 2, "cas8": 3, "cas64": 3, "xadd64": 2, "fence": 0,
    "st8": 2, "st16": 2, "st32": 2, "st64": 2, "frame_addr": 0, "stack_ptr": 0, "spill_regs": 0,
    "trap": 0, "retv": 2, "retp": 1
}

func commas(items: list<string>) -> string {
    return join(items, ", ")
}

func nfail(n: Node, msg: string) {
    die("Native Error", n.line, msg)
}

func declare_once(key: string, text: string) {
    if (not map_has(NS.decl_ids, key)) {
        NS.decl_ids[key] = true
        append(NS.decls, text)
    }
}

# A NUL-terminated string constant as an i64 expression.
func nstr(text: string) -> string {
    if (not map_has(NS.str_ids, text)) {
        let name = "@.n{len(NS.strs)}"
        append(NS.strs, "{name} = private unnamed_addr constant [{len(text) + 1} x i8] c\"{ll_escape(text)}\\00\"")
        NS.str_ids[text] = name
    }
    return "ptrtoint (ptr {NS.str_ids[text]} to i64)"
}

func ntype(kind: string) -> string {
    if (kind == "i32") {
        return "i32"
    }
    if (kind == "ptr") {
        return "ptr"
    }
    if (kind == "double") {
        return "double"
    }
    return "i64"
}

# The word v converted to the LLVM type of an extern or native parameter.
func to_type(v: string, ty: string) -> string {
    if (ty == "i64") {
        return v
    }
    let r = ll_reg()
    if (ty == "i32") {
        ll("{r} = trunc i64 {v} to i32")
    } else if (ty == "ptr") {
        ll("{r} = inttoptr i64 {v} to ptr")
    } else {
        ll("{r} = bitcast i64 {v} to double")
    }
    return r
}

# A value of LLVM type ty converted back into a word.
func from_type(v: string, ty: string) -> string {
    if (ty == "i64") {
        return v
    }
    let r = ll_reg()
    if (ty == "i32") {
        ll("{r} = sext i32 {v} to i64")
    } else if (ty == "ptr") {
        ll("{r} = ptrtoint ptr {v} to i64")
    } else {
        ll("{r} = bitcast double {v} to i64")
    }
    return r
}

# Constants

# The integer value of a constant expression, or null when it is not constant.
func cfold(e: Node) -> Konst {
    if (e.k == "num") {
        if (len(e.v) > 18) {
            return null
        }
        return Konst(e.v as int)
    }
    if (e.k == "char") {
        return Konst(e.v as int)
    }
    if (e.k == "bool") {
        if (e.v == "true") {
            return Konst(1)
        }
        return Konst(0)
    }
    if (e.k == "id") {
        if (map_has(NS.consts, e.name)) {
            return Konst(NS.consts[e.name])
        }
        return null
    }
    if (e.k == "bin") {
        let ka = cfold(e.l)
        let kb = cfold(e.r)
        if (ka == null or kb == null) {
            return null
        }
        let a = ka.v
        let b = kb.v
        if (e.op == "+") {
            return Konst(a + b)
        }
        if (e.op == "-") {
            return Konst(a - b)
        }
        if (e.op == "*") {
            return Konst(a * b)
        }
        if (e.op == "/" and b != 0) {
            return Konst(a / b)
        }
        if (e.op == "%" and b != 0) {
            return Konst(a % b)
        }
        return null
    }
    if (e.k == "call" and e.callee.k == "id" and len(e.args) == 2) {
        let ka = cfold(e.args[0])
        let kb = cfold(e.args[1])
        if (ka == null or kb == null) {
            return null
        }
        let a = ka.v
        let b = kb.v
        let nm = e.callee.name
        if (nm == "shl" and b >= 0 and b < 62) {
            let r = a
            for (let i = 0; i < b; i++) {
                r = r * 2
            }
            return Konst(r)
        }
        if (nm == "bor" and a >= 0 and b >= 0 and band_free(a, b)) {
            return Konst(a + b)
        }
    }
    return null
}

# True when a and b share no set bit, so a | b equals a + b.
func band_free(a: int, b: int) -> bool {
    let x = a
    let y = b
    while (x > 0 and y > 0) {
        if (x % 2 == 1 and y % 2 == 1) {
            return false
        }
        x = x / 2
        y = y / 2
    }
    return true
}

# Expressions

func nx_list(nodes: list<Node>) -> list<string> {
    let res: list<string> = []
    for (let n in nodes) {
        append(res, nx(n))
    }
    return res
}

func nx_id(n: Node) -> string {
    let v = find_local(n.name)
    if (v != null) {
        let r = ll_reg()
        ll("{r} = load i64, ptr {v.c}")
        return r
    }
    if (map_has(NS.consts, n.name)) {
        return "{NS.consts[n.name]}"
    }
    if (map_has(NS.gvars, n.name)) {
        let r = ll_reg()
        ll("{r} = load i64, ptr @{n.name}")
        return r
    }
    if (n.name == "null") {
        return "0"
    }
    nfail(n, "Unknown name '{n.name}' (a function is used as a value with fn_addr)")
    return ""
}

func nx_bin(n: Node) -> string {
    if (n.op == "and" or n.op == "or") {
        return nx_logic(n)
    }
    let c = cfold(n)
    if (c != null) {
        return "{c.v}"
    }
    let a = nx(n.l)
    let b = nx(n.r)
    let ops: map<string> = {"+": "add", "-": "sub", "*": "mul", "/": "sdiv", "%": "srem"}
    let cmps: map<string> = {"==": "eq", "!=": "ne", "<": "slt", "<=": "sle", ">": "sgt", ">=": "sge"}
    let r = ll_reg()
    if (map_has(ops, n.op)) {
        ll("{r} = {ops[n.op]} i64 {a}, {b}")
        return r
    }
    if (map_has(cmps, n.op)) {
        let f = ll_reg()
        ll("{f} = icmp {cmps[n.op]} i64 {a}, {b}")
        ll("{r} = zext i1 {f} to i64")
        return r
    }
    nfail(n, "Unsupported operator '{n.op}' in native code")
    return ""
}

# and / or with short-circuit evaluation; the result is 0 or 1.
func nx_logic(n: Node) -> string {
    let slot = ll_alloca("i64")
    let rhs = ll_new_label("lr")
    let done = ll_new_label("ld")
    let a = nx(n.l)
    let f = ll_reg()
    ll("{f} = icmp ne i64 {a}, 0")
    let z = ll_reg()
    ll("{z} = zext i1 {f} to i64")
    ll("store i64 {z}, ptr {slot}")
    if (n.op == "and") {
        ll_condbr(f, rhs, done)
    } else {
        ll_condbr(f, done, rhs)
    }
    ll_label(rhs)
    let b = nx(n.r)
    let g = ll_reg()
    ll("{g} = icmp ne i64 {b}, 0")
    let w = ll_reg()
    ll("{w} = zext i1 {g} to i64")
    ll("store i64 {w}, ptr {slot}")
    ll_br(done)
    ll_label(done)
    let r = ll_reg()
    ll("{r} = load i64, ptr {slot}")
    return r
}

# The address of word index of target: target + index * 8.
func word_addr(n: Node) -> string {
    let base = nx(n.target)
    let off = nx(n.index)
    let scaled = ll_reg()
    ll("{scaled} = mul i64 {off}, 8")
    let addr = ll_reg()
    ll("{addr} = add i64 {base}, {scaled}")
    return addr
}

func nx_not(n: Node) -> string {
    let a = nx(n.e)
    let f = ll_reg()
    ll("{f} = icmp eq i64 {a}, 0")
    let r = ll_reg()
    ll("{r} = zext i1 {f} to i64")
    return r
}

func nx_float(n: Node) -> string {
    let t = n.v
    if (not contains(t, ".")) {
        t = "{t}.0"
    }
    return "bitcast (double {t} to i64)"
}

func ptr_of(a: string) -> string {
    let p = ll_reg()
    ll("{p} = inttoptr i64 {a} to ptr")
    return p
}

# One argument of a call, with the LLVM type it is passed as.
func arg_value(a: Node, ty: string) -> NArg {
    if (a.k == "call" and a.callee.k == "id" and a.callee.name == "dbl" and len(a.args) == 1) {
        let w = nx(a.args[0])
        return NArg(to_type(w, "double"), "double")
    }
    return NArg(to_type(nx(a), ty), ty)
}

func call_text(args: list<NArg>) -> string {
    let parts: list<string> = []
    for (let a in args) {
        append(parts, "{a.ty} {a.v}")
    }
    return commas(parts)
}

func nx_intrinsic(n: Node, name: string, a: list<string>) -> string {
    let r = ll_reg()
    if (map_has(TWO_OPS, name)) {
        ll("{r} = {TWO_OPS[name]} i64 {a[0]}, {a[1]}")
        return r
    }
    if (name == "bnot") {
        ll("{r} = xor i64 {a[0]}, -1")
        return r
    }
    if (map_has(CMP_OPS, name)) {
        let f = ll_reg()
        ll("{f} = icmp {CMP_OPS[name]} i64 {a[0]}, {a[1]}")
        ll("{r} = zext i1 {f} to i64")
        return r
    }
    if (map_has(OVF, name)) {
        let st = ll_reg()
        let intr = "llvm.{OVF[name]}.with.overflow.i64"
        declare_once(intr, "declare \{ i64, i1 } @{intr}(i64, i64)")
        ll("{st} = call \{ i64, i1 } @{intr}(i64 {a[0]}, i64 {a[1]})")
        let f = ll_reg()
        ll("{f} = extractvalue \{ i64, i1 } {st}, 1")
        ll("{r} = zext i1 {f} to i64")
        return r
    }
    if (map_has(LOADS, name)) {
        let ty = LOADS[name]
        let p = ptr_of(a[0])
        if (ty == "i64") {
            ll("{r} = load i64, ptr {p}, align 8")
            return r
        }
        let v = ll_reg()
        ll("{v} = load {ty}, ptr {p}, align {WIDTH[ty]}")
        if (starts_with(name, "lds")) {
            ll("{r} = sext {ty} {v} to i64")
        } else {
            ll("{r} = zext {ty} {v} to i64")
        }
        return r
    }
    if (map_has(ALOADS, name)) {
        let ty = ALOADS[name]
        let p = ptr_of(a[0])
        if (ty == "i64") {
            ll("{r} = load atomic i64, ptr {p} acquire, align 8")
            return r
        }
        let v = ll_reg()
        ll("{v} = load atomic {ty}, ptr {p} acquire, align {WIDTH[ty]}")
        ll("{r} = zext {ty} {v} to i64")
        return r
    }
    if (map_has(ASTORES, name)) {
        let ty = ASTORES[name]
        let p = ptr_of(a[0])
        let v = a[1]
        if (ty != "i64") {
            v = ll_reg()
            ll("{v} = trunc i64 {a[1]} to {ty}")
        }
        ll("store atomic {ty} {v}, ptr {p} release, align {WIDTH[ty]}")
        return "0"
    }
    if (name == "cas8") {
        # cas8(p, expected, new): sets the byte to new if it was expected; 1 when it did
        let p = ptr_of(a[0])
        let e = ll_reg()
        ll("{e} = trunc i64 {a[1]} to i8")
        let nv = ll_reg()
        ll("{nv} = trunc i64 {a[2]} to i8")
        let pair = ll_reg()
        ll("{pair} = cmpxchg ptr {p}, i8 {e}, i8 {nv} seq_cst seq_cst")
        let f = ll_reg()
        ll("{f} = extractvalue \{ i8, i1 } {pair}, 1")
        ll("{r} = zext i1 {f} to i64")
        return r
    }
    if (name == "cas64") {
        # cas64(p, expected, new): sets the word to new if it was expected; 1 when it did
        let p = ptr_of(a[0])
        let pair = ll_reg()
        ll("{pair} = cmpxchg ptr {p}, i64 {a[1]}, i64 {a[2]} seq_cst seq_cst")
        let f = ll_reg()
        ll("{f} = extractvalue \{ i64, i1 } {pair}, 1")
        ll("{r} = zext i1 {f} to i64")
        return r
    }
    if (name == "xadd64") {
        # xadd64(p, v): adds v to the word in one step and returns what it held before
        let p = ptr_of(a[0])
        ll("{r} = atomicrmw add ptr {p}, i64 {a[1]} seq_cst")
        return r
    }
    if (name == "fence") {
        ll("fence seq_cst")
        return "0"
    }
    if (map_has(STORES, name)) {
        let ty = STORES[name]
        let p = ptr_of(a[0])
        let v = a[1]
        if (ty != "i64") {
            v = ll_reg()
            ll("{v} = trunc i64 {a[1]} to {ty}")
        }
        ll("store {ty} {v}, ptr {p}, align {WIDTH[ty]}")
        return "0"
    }
    if (map_has(FLT_OPS, name)) {
        let x = to_type(a[0], "double")
        let y = to_type(a[1], "double")
        let z = ll_reg()
        ll("{z} = {FLT_OPS[name]} double {x}, {y}")
        return from_type(z, "double")
    }
    if (name == "fneg") {
        let x = to_type(a[0], "double")
        let z = ll_reg()
        ll("{z} = fneg double {x}")
        return from_type(z, "double")
    }
    if (map_has(FCMP_OPS, name)) {
        let x = to_type(a[0], "double")
        let y = to_type(a[1], "double")
        let f = ll_reg()
        ll("{f} = fcmp {FCMP_OPS[name]} double {x}, {y}")
        ll("{r} = zext i1 {f} to i64")
        return r
    }
    if (name == "i2f") {
        let z = ll_reg()
        ll("{z} = sitofp i64 {a[0]} to double")
        return from_type(z, "double")
    }
    if (name == "f2i") {
        let x = to_type(a[0], "double")
        ll("{r} = fptosi double {x} to i64")
        return r
    }
    if (name == "frame_addr") {
        declare_once("llvm.frameaddress", "declare ptr @llvm.frameaddress.p0(i32)")
        let p = ll_reg()
        ll("{p} = call ptr @llvm.frameaddress.p0(i32 0)")
        ll("{r} = ptrtoint ptr {p} to i64")
        return r
    }
    if (name == "stack_ptr") {
        declare_once("llvm.stacksave", "declare ptr @llvm.stacksave.p0()")
        let p = ll_reg()
        ll("{p} = call ptr @llvm.stacksave.p0()")
        ll("{r} = ptrtoint ptr {p} to i64")
        return r
    }
    if (name == "spill_regs") {
        declare_once("llvm.eh.unwind.init", "declare void @llvm.eh.unwind.init()")
        ll("call void @llvm.eh.unwind.init()")
        ST.ctx.spills = true
        return "0"
    }
    if (name == "trap") {
        declare_once("llvm.trap", "declare void @llvm.trap()")
        ll("call void @llvm.trap()")
        ll("unreachable")
        ST.ctx.dead = true
        return "0"
    }
    nfail(n, "Intrinsic '{name}' is not implemented")
    return ""
}

# Calls whose arguments are not plain words: strings, symbols and the special forms.
func nx_special(n: Node, name: string) {
    let args = n.args
    if (name == "cstr") {
        if (len(args) != 1 or args[0].k != "str") {
            nfail(n, "cstr takes one string literal")
        }
        return nstr(args[0].v)
    }
    if (name == "addr_of" or name == "fn_addr") {
        if (len(args) != 1 or args[0].k != "str") {
            nfail(n, "{name} takes one string literal")
        }
        let sym = args[0].v
        if (map_has(NS.tls, sym)) {
            # The address of a thread's own copy is not a constant: it is taken where it is used.
            let r = ll_reg()
            ll("{r} = ptrtoint ptr @{sym} to i64")
            return r
        }
        if (not map_has(NS.datas, sym) and not map_has(NS.funcs, sym) and not map_has(NS.syms, sym)) {
            NS.syms[sym] = true
            declare_once("sym_{sym}", "@{sym} = external global i8")
        }
        return "ptrtoint (ptr @{sym} to i64)"
    }
    if (name == "stack_buf") {
        let size: Konst = null
        if (len(args) == 1) {
            size = cfold(args[0])
        }
        if (size == null or size.v <= 0) {
            nfail(n, "stack_buf takes a constant size")
        }
        let slot = ll_alloca("[{size.v} x i8]")
        let r = ll_reg()
        ll("{r} = ptrtoint ptr {slot} to i64")
        return r
    }
    return null
}

# call_ptr(f, args...): an indirect call of a word function.
func nx_call_ptr(n: Node) -> string {
    let vals = nx_list(n.args)
    let parts: list<string> = []
    for (let i = 1; i < len(vals); i++) {
        append(parts, "i64 {vals[i]}")
    }
    let p = ptr_of(vals[0])
    let r = ll_reg()
    ll("{r} = call i64 {p}({commas(parts)})")
    return r
}

# callv(out, f, args...): calls a function that returns an LV and stores it at out. f is
# the name of a native function or an expression holding a function address.
func nx_callv(n: Node) -> string {
    let out_w = nx(n.args[0])
    let callee = n.args[1]
    let direct = callee.k == "id" and map_has(NS.funcs, callee.name)
    let target = ""
    let fv = ""
    if (not direct) {
        fv = nx(callee)
    }
    let parts: list<string> = []
    for (let i = 2; i < len(n.args); i++) {
        let w = nx(n.args[i])
        if (direct) {
            let ty = ntype(NS.funcs[callee.name].kinds[i - 2])
            append(parts, "{ty} {to_type(w, ty)}")
        } else {
            append(parts, "i64 {w}")
        }
    }
    if (direct) {
        target = "@{callee.name}"
    } else {
        target = ptr_of(fv)
    }
    let r = ll_reg()
    ll("{r} = call %LV {target}({commas(parts)})")
    let o = ptr_of(out_w)
    ll("store %LV {r}, ptr {o}, align 8")
    return "0"
}

func nx_retv(n: Node, a: list<string>) -> string {
    let t = ll_reg()
    ll("{t} = insertvalue %LV undef, i64 {a[0]}, 0")
    let u = ll_reg()
    ll("{u} = insertvalue %LV {t}, i64 {a[1]}, 1")
    ll("ret %LV {u}")
    ST.ctx.dead = true
    return "0"
}

func nx_retp(n: Node, a: list<string>) -> string {
    let p = ptr_of(a[0])
    let v = ll_reg()
    ll("{v} = load %LV, ptr {p}, align 8")
    ll("ret %LV {v}")
    ST.ctx.dead = true
    return "0"
}

func nx_call(n: Node) -> string {
    if (n.callee.k != "id") {
        nfail(n, "Only named functions can be called in native code")
    }
    let name = n.callee.name
    let sp = nx_special(n, name)
    if (sp != null) {
        return sp
    }
    if (name == "call_ptr") {
        return nx_call_ptr(n)
    }
    if (name == "callv") {
        return nx_callv(n)
    }
    if (name == "dbl") {
        return nx(n.args[0])
    }
    if (map_has(ARITY, name)) {
        if (len(n.args) != ARITY[name]) {
            nfail(n, "{name} takes {ARITY[name]} argument(s)")
        }
        let a = nx_list(n.args)
        if (name == "retv") {
            return nx_retv(n, a)
        }
        if (name == "retp") {
            return nx_retp(n, a)
        }
        return nx_intrinsic(n, name, a)
    }
    if (map_has(NS.funcs, name)) {
        let info = NS.funcs[name]
        if (len(n.args) != len(info.kinds)) {
            nfail(n, "{name} takes {len(info.kinds)} argument(s), not {len(n.args)}")
        }
        if (info.lv) {
            nfail(n, "{name} returns an LV; call it with callv")
        }
        let parts: list<string> = []
        for (let i = 0; i < len(n.args); i++) {
            let ty = ntype(info.kinds[i])
            append(parts, "{ty} {to_type(nx(n.args[i]), ty)}")
        }
        let r = ll_reg()
        ll("{r} = call i64 @{name}({commas(parts)})")
        return r
    }
    if (map_has(NS.externs, name)) {
        let ext = NS.externs[name]
        let fixed = len(ext.params)
        if (len(n.args) < fixed or (len(n.args) > fixed and not ext.variadic)) {
            nfail(n, "{name} takes {fixed} argument(s), not {len(n.args)}")
        }
        let vals: list<NArg> = []
        for (let i = 0; i < len(n.args); i++) {
            let ty = "i64"
            if (i < fixed) {
                ty = ntype(ext.params[i])
            }
            append(vals, arg_value(n.args[i], ty))
        }
        let sig = ""
        if (ext.variadic) {
            sig = "{ext.sig} "
        }
        let rty = ntype(ext.ret)
        if (ext.ret == "void") {
            ll("call void {sig}@{name}({call_text(vals)})")
            return "0"
        }
        let r = ll_reg()
        ll("{r} = call {rty} {sig}@{name}({call_text(vals)})")
        return from_type(r, rty)
    }
    nfail(n, "Unknown function '{name}'")
    return ""
}

func nx(n: Node) -> string {
    let k = n.k
    if (k == "num") {
        return n.v
    }
    if (k == "char") {
        return "{n.v}"
    }
    if (k == "bool") {
        if (n.v == "true") {
            return "1"
        }
        return "0"
    }
    if (k == "float") {
        return nx_float(n)
    }
    if (k == "str") {
        return nstr(n.v)
    }
    if (k == "id") {
        return nx_id(n)
    }
    if (k == "call") {
        return nx_call(n)
    }
    if (k == "bin") {
        return nx_bin(n)
    }
    if (k == "not") {
        return nx_not(n)
    }
    if (k == "incdec") {
        nx_incdec(n)
        return nx_id(mk_id_line(n.line, n.name))
    }
    if (k == "index") {
        let addr = word_addr(n)
        let r = ll_reg()
        let p = ptr_of(addr)
        ll("{r} = load i64, ptr {p}, align 8")
        return r
    }
    nfail(n, "Unsupported expression '{k}' in native code")
    return ""
}

# Statements

func local_slot(name: string) {
    let v = find_local(name)
    if (v != null) {
        return "ptr {v.c}"
    }
    if (map_has(NS.gvars, name)) {
        return "ptr @{name}"
    }
    return null
}

func nx_incdec(n: Node) {
    let slot = local_slot(n.name)
    if (slot == null) {
        nfail(n, "Unknown variable '{n.name}'")
    }
    let a = ll_reg()
    ll("{a} = load i64, {slot}")
    let b = ll_reg()
    let op = "add"
    if (n.op == "--") {
        op = "sub"
    }
    ll("{b} = {op} i64 {a}, 1")
    ll("store i64 {b}, {slot}")
}

func ncond(e: Node) -> string {
    let v = nx(e)
    let f = ll_reg()
    ll("{f} = icmp ne i64 {v}, 0")
    return f
}

func push_scope() {
    append(ST.ctx.scopes, {})
}

func pop_scope() {
    remove(ST.ctx.scopes, len(ST.ctx.scopes) - 1)
}

func nblock(stmts: list<Node>) {
    push_scope()
    for (let s in stmts) {
        nst(s)
    }
    pop_scope()
}

func nst_let(n: Node) {
    let v = "0"
    if (n.init != null) {
        v = nx(n.init)
    }
    let slot = ll_alloca("i64")
    ll("store i64 {v}, ptr {slot}")
    ST.ctx.scopes[len(ST.ctx.scopes) - 1][n.name] = Var(n.name, false, slot, null)
}

func nst_assign(n: Node) {
    let v = nx(n.e)
    let slot = local_slot(n.name)
    if (slot == null) {
        nfail(n, "Assignment to unknown variable '{n.name}'")
    }
    ll("store i64 {v}, {slot}")
}

# target[index] = value, or target[index] op= value, on 64-bit words.
func nst_setidx(n: Node) {
    if (n.index.k == "str") {
        nfail(n, "Field assignment is not available in native code; use st64 and offsets")
    }
    let addr = word_addr(n)
    let p = ptr_of(addr)
    let v = nx(n.e)
    if (n.op != null) {
        let cur = ll_reg()
        ll("{cur} = load i64, ptr {p}, align 8")
        let ops = {"+": "add", "-": "sub", "*": "mul", "/": "sdiv"}
        let r = ll_reg()
        ll("{r} = {ops[n.op]} i64 {cur}, {v}")
        v = r
    }
    ll("store i64 {v}, ptr {p}, align 8")
}

func nst_if(n: Node) {
    let yes = ll_new_label("it")
    let no = ll_new_label("ie")
    let end = ll_new_label("ix")
    let c = ncond(n.cond)
    if (len(n.els) > 0) {
        ll_condbr(c, yes, no)
    } else {
        ll_condbr(c, yes, end)
    }
    ll_label(yes)
    nblock(n.then)
    ll_br(end)
    if (len(n.els) > 0) {
        ll_label(no)
        nblock(n.els)
        ll_br(end)
    }
    ll_label(end)
}

func nst_while(n: Node) {
    let head = ll_new_label("wh")
    let body = ll_new_label("wb")
    let end = ll_new_label("we")
    ll_br(head)
    ll_label(head)
    let c = ncond(n.cond)
    ll_condbr(c, body, end)
    ll_label(body)
    append(ST.ctx.loops, Loop("while", 0, end, head, 0))
    nblock(n.body)
    remove(ST.ctx.loops, len(ST.ctx.loops) - 1)
    ll_br(head)
    ll_label(end)
}

func nst_for(n: Node) {
    push_scope()
    if (n.init != null) {
        nst(n.init)
    }
    let head = ll_new_label("fh")
    let body = ll_new_label("fb")
    let step = ll_new_label("fs")
    let end = ll_new_label("fe")
    ll_br(head)
    ll_label(head)
    let c = ncond(n.cond)
    ll_condbr(c, body, end)
    ll_label(body)
    append(ST.ctx.loops, Loop("for", 0, end, step, 0))
    nblock(n.body)
    remove(ST.ctx.loops, len(ST.ctx.loops) - 1)
    ll_br(step)
    ll_label(step)
    nst(n.incr)
    ll_br(head)
    ll_label(end)
    pop_scope()
}

func nst_switch(n: Node) {
    let v = nx(n.e)
    let end = ll_new_label("sx")
    for (let c in n.cases) {
        let want = nx(c.e)
        let hit = ll_new_label("sc")
        let miss = ll_new_label("sn")
        let f = ll_reg()
        ll("{f} = icmp eq i64 {v}, {want}")
        ll_condbr(f, hit, miss)
        ll_label(hit)
        nblock(c.body)
        ll_br(end)
        ll_label(miss)
    }
    nblock(n.dflt)
    ll_br(end)
    ll_label(end)
}

func nst_return(n: Node) {
    if (ST.ctx.lv) {
        nfail(n, "A function that returns an LV must end with retv")
    }
    let v = "0"
    if (n.e != null) {
        v = nx(n.e)
    }
    ll("ret i64 {v}")
    ST.ctx.dead = true
}

func nst(n: Node) {
    let k = n.k
    if (k == "let") {
        nst_let(n)
    } else if (k == "group") {
        for (let it in n.items) {
            nst_let(it)
        }
    } else if (k == "assign") {
        nst_assign(n)
    } else if (k == "if") {
        nst_if(n)
    } else if (k == "while") {
        nst_while(n)
    } else if (k == "for") {
        nst_for(n)
    } else if (k == "switch") {
        nst_switch(n)
    } else if (k == "return") {
        nst_return(n)
    } else if (k == "break") {
        let loops = ST.ctx.loops
        ll_br(loops[len(loops) - 1].brk)
    } else if (k == "continue") {
        let loops = ST.ctx.loops
        ll_br(loops[len(loops) - 1].cont)
    } else if (k == "incdec") {
        nx_incdec(n)
    } else if (k == "setidx") {
        nst_setidx(n)
    } else if (k == "call" or k == "bin" or k == "id" or k == "not") {
        nx(n)
    } else {
        nfail(n, "Unsupported statement '{k}' in native code")
    }
}

# Functions and the module

func param_kind(name: string) -> string {
    if (ends_with(name, "_i")) {
        return "i32"
    }
    if (ends_with(name, "_p")) {
        return "ptr"
    }
    return "i64"
}

func has_retv(xs: list<Node>) -> bool {
    for (let x in nodes_under(xs)) {
        if (x.k == "call" and x.callee.k == "id" and (x.callee.name == "retv" or x.callee.name == "retp")) {
            return true
        }
    }
    return false
}

func compile_func(n: Node) {
    let info = NS.funcs[n.name]
    ST.ctx = ll_new_ctx(false)
    ST.ctx.lv = info.lv
    let params: list<string> = []
    for (let i = 0; i < len(n.params); i++) {
        let ty = ntype(info.kinds[i])
        append(params, "{ty} %p{i}")
    }
    for (let i = 0; i < len(n.params); i++) {
        let slot = ll_alloca("i64")
        let ty = ntype(info.kinds[i])
        let w = from_type("%p{i}", ty)
        ll("store i64 {w}, ptr {slot}")
        ST.ctx.scopes[0][n.params[i]] = Var(n.params[i], false, slot, null)
    }
    for (let s in n.body) {
        nst(s)
    }
    if (info.lv) {
        ll("ret %LV zeroinitializer")
    } else {
        ll("ret i64 0")
    }
    let linkage = ""
    if (starts_with(n.name, "_")) {
        linkage = "internal "
    }
    let rty = "i64"
    if (info.lv) {
        rty = "%LV"
    }
    let attrs = ""
    if (ST.ctx.spills == true) {
        attrs = " noinline"
    }
    # A function named _slow_... is the rarely taken part of a hot function: it stays a call, so that the
    # hot function does not carry its registers and frame.
    if (starts_with(n.name, "_slow_")) {
        attrs = " noinline cold"
    }
    let lines = ["define {linkage}{rty} @{n.name}({commas(params)}){attrs} \{", "entry:"]
    for (let a in ST.ctx.allocas) {
        append(lines, a)
    }
    append(lines, "  br label %start")
    append(lines, "start:")
    for (let o in ST.ctx.out) {
        append(lines, o)
    }
    append(lines, "}")
    append(NS.defs, join(lines, "\n"))
}

func register_extern(n: Node) {
    let a = n.args
    if (len(a) != 3 or a[0].k != "str" or a[1].k != "str" or a[2].k != "str") {
        nfail(n, "extern takes a name, a return type and a parameter list as strings")
    }
    let params: list<string> = []
    let variadic = false
    let ptys: list<string> = []
    if (a[2].v != "") {
        for (let p in split(a[2].v, ",")) {
            if (p == "...") {
                variadic = true
            } else {
                append(params, p)
                append(ptys, ntype(p))
            }
        }
    }
    if (variadic) {
        append(ptys, "...")
    }
    let rty = "void"
    if (a[1].v != "void") {
        rty = ntype(a[1].v)
    }
    let sig = "({commas(ptys)})"
    NS.externs[a[0].v] = NExtern(a[1].v, params, variadic, sig)
    declare_once("ext_{a[0].v}", "declare {rty} @{a[0].v}({commas(ptys)})")
}

func register_data(n: Node, per_thread: bool) {
    let a = n.args
    if (len(a) != 2 or a[0].k != "str") {
        nfail(n, "space takes a name and a byte size")
    }
    let size = cfold(a[1])
    if (size == null) {
        nfail(n, "space needs a constant size")
    }
    NS.datas[a[0].v] = size.v
    let linkage = ""
    if (starts_with(a[0].v, "_")) {
        linkage = "internal "
    }
    if (per_thread) {
        NS.tls[a[0].v] = true
        linkage = linkage + "thread_local(localexec) "
    }
    append(NS.defs, "@{a[0].v} = {linkage}global [{size.v} x i8] zeroinitializer, align 16")
}

# table("name", "i32", v1, v2, ...): a constant array of integers.
func register_table(n: Node) {
    let a = n.args
    if (len(a) < 3 or a[0].k != "str" or a[1].k != "str") {
        nfail(n, "table takes a name, an element type and constant values")
    }
    let ty = a[1].v
    let items: list<string> = []
    for (let i = 2; i < len(a); i++) {
        let v = cfold(a[i])
        if (v == null) {
            nfail(n, "table values must be constants")
        }
        append(items, "{ty} {v.v}")
    }
    NS.datas[a[0].v] = len(items)
    let linkage = ""
    if (starts_with(a[0].v, "_")) {
        linkage = "internal "
    }
    append(NS.defs, "@{a[0].v} = {linkage}constant [{len(items)} x {ty}] [{commas(items)}], align 16")
}

# First pass over one file: names, constants, externs and data, so that functions can be
# used before they are defined.
func scan_file(stmts: list<Node>) {
    for (let s in stmts) {
        if (s.k == "func") {
            let kinds: list<string> = []
            for (let p in s.params) {
                append(kinds, param_kind(p))
            }
            NS.funcs[s.name] = NFunc(kinds, has_retv(s.body))
            append(NS.order, s)
        } else if (s.k == "let") {
            let c: Konst = null
            if (s.init != null) {
                c = cfold(s.init)
            }
            if (s.const_decl == true) {
                # a const whose value is not constant is not known as one
                if (c != null) {
                    NS.consts[s.name] = c.v
                }
            } else {
                NS.gvars[s.name] = true
                let first = 0
                if (c != null) {
                    first = c.v
                }
                if (map_has(NS.tls, s.name)) {
                    append(NS.defs, "@{s.name} = internal thread_local(localexec) global i64 {first}")
                } else {
                    append(NS.defs, "@{s.name} = internal global i64 {first}")
                }
            }
        } else if (s.k == "call" and s.callee.k == "id" and s.callee.name == "extern") {
            register_extern(s)
        } else if (s.k == "call" and s.callee.k == "id" and s.callee.name == "space") {
            register_data(s, false)
        } else if (s.k == "call" and s.callee.k == "id" and s.callee.name == "tspace") {
            register_data(s, true)
        } else if (s.k == "call" and s.callee.k == "id" and s.callee.name == "per_thread") {
            for (let a in s.args) {
                if (a.k != "str") {
                    nfail(s, "per_thread takes the names of module-level variables as strings")
                }
                NS.tls[a.v] = true
            }
        } else if (s.k == "call" and s.callee.k == "id" and s.callee.name == "table") {
            register_table(s)
        } else {
            nfail(s, "Only func, const, let, extern, space, tspace, per_thread and table are allowed at the top of a native file")
        }
    }
}

# Compiles the files into one module and returns its text.
export func compile_native(files: list<NativeFile>) -> string {
    for (let f in files) {
        ST.src_file = f.path
        scan_file(f.stmts)
    }
    for (let fn in NS.order) {
        compile_func(fn)
    }
    let out: list<string> = ["; generated by zuec --native", "%LV = type \{ i64, i64 }"]
    for (let d in NS.decls) {
        append(out, d)
    }
    for (let s in NS.strs) {
        append(out, s)
    }
    for (let d in NS.defs) {
        append(out, d)
    }
    return join(out, "\n") + "\n"
}
