#
# lexer.zu: source text to tokens.
#
# A token is {"t": kind, "v": value, "line": n}. Kinds: nl, str, char, num, float, id, eof, the
# keywords, and the operator names from token.zu. A "num" value is decimal digit text (hex, binary
# and underscores are resolved here), a "float" value is the number text, a "char" value is the code.

use { die } from "util.zu"
use { KEYWORDS, ONE_CHAR, TWO_CHAR } from "token.zu"

func is_dig(c) {
    return c >= '0' and c <= '9'
}

func is_ident_start(c) {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'
}

func is_ident_char(c) {
    return is_ident_start(c) or is_dig(c)
}

# Set by interp_end when the expression writes its quotes as \" (the older way to put a string
# inside an interpolation); lex_string then turns \" into " in the expression text.
let ESCAPED_QUOTES = false

# The bytes a string literal scan stops at: the closing quote, an escape, a newline, an interpolation.
let STRING_STOPS = "\"\\\n\{"
# The bytes that may be in an identifier, and the bytes of a number's digits.
let IDENT_BYTES = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789"
let DIGIT_BYTES = "0123456789"
let NUMBER_BYTES = "0123456789_"

template Token { t, v, line }

func make_tok(t, v, line) {
    return Token(t, v, line)
}

# The value of a hex digit, or -1.
func hex_value(c) {
    if (c >= '0' and c <= '9') {
        return int(c) - 48
    }
    if (c >= 'a' and c <= 'f') {
        return int(c) - 87
    }
    if (c >= 'A' and c <= 'F') {
        return int(c) - 55
    }
    return -1
}

# Strings

# The text an escape letter stands for inside a string or character literal, or null.
func escape_text(e) {
    if (e == 'n') {
        return "\n"
    }
    if (e == 't') {
        return "\t"
    }
    if (e == 'r') {
        return "\r"
    }
    if (e == '\\') {
        return "\\"
    }
    if (e == '"') {
        return "\""
    }
    if (e == '\'') {
        return "'"
    }
    if (e == '{') {
        return "\{"
    }
    if (e == '}') {
        return "\}"
    }
    return null
}

# The index just after the string literal whose opening quote is at k.
func skip_string(src, k, start_line) {
    let n = len(src)
    k += 1
    while (k < n) {
        let c = src[k]
        if (c == '\\') {
            k += 2
        } else if (c == '"') {
            return k + 1
        } else if (c == '\{' and k + 1 < n and src[k + 1] != '\}') {
            k = interp_end(src, k + 1, start_line) + 1
        } else {
            k += 1
        }
    }
    die("Syntax Error", start_line, "Unterminated string")
}

# The index of the } that closes an interpolation whose text starts at k. Braces, strings and
# character literals inside the expression are skipped over.
func interp_end(src, k, start_line) {
    let n = len(src)
    let depth = 1
    while (k < n) {
        let c = src[k]
        if (c == '"') {
            k = skip_string(src, k, start_line)
        } else if (c == '\\' and k + 1 < n and src[k + 1] == '"') {
            ESCAPED_QUOTES = true
            k += 2
        } else if (c == '\'') {
            if (k + 1 < n and src[k + 1] == '\\') {
                k += 4
            } else {
                k += 3
            }
        } else if (c == '\{') {
            depth += 1
            k += 1
        } else if (c == '\}') {
            depth -= 1
            if (depth == 0) {
                return k
            }
            k += 1
        } else {
            k += 1
        }
    }
    die("Syntax Error", start_line, "Unclosed string interpolation expression")
}

func count_newlines(src, a, b) {
    let count = 0
    let k = index_of(src, "\n", a)
    while (k >= 0 and k < b) {
        count += 1
        k = index_of(src, "\n", k + 1)
    }
    return count
}

# Reads the string whose opening quote is at index i. Returns [parts, next_i, next_line]. A part
# is either a string or {"expr": source, "line": n}. A { starts an interpolation unless it is
# written \{ or is immediately followed by }.
func lex_string(src, i, start_line) {
    let n = len(src)
    let line = start_line
    let parts = []
    let cur = []
    i += 1
    let seg = i
    while (true) {
        i = index_of_any(src, STRING_STOPS, i)
        if (i < 0) {
            die("Syntax Error", start_line, "Unterminated string")
        }
        let c = src[i]
        if (c == '"') {
            break
        }
        if (c == '\n') {
            line += 1
            i += 1
        } else if (c == '\\') {
            if (i + 1 >= n) {
                die("Syntax Error", start_line, "Unterminated string")
            }
            let text = escape_text(src[i + 1])
            if (text == null) {
                die("Syntax Error", line, "Unknown escape '\\{src[i + 1]}' in string")
            }
            append(cur, slice(src, seg, i))
            append(cur, text)
            i += 2
            seg = i
        } else if (c == '\{' and i + 1 < n and src[i + 1] == '\}') {
            i += 1
        } else {
            let before = slice(src, seg, i)
            if (len(cur) > 0) {
                append(cur, before)
                before = join(cur, "")
            }
            if (len(before) > 0) {
                append(parts, before)
            }
            cur = []
            ESCAPED_QUOTES = false
            let stop = interp_end(src, i + 1, line)
            let expr = slice(src, i + 1, stop)
            if (ESCAPED_QUOTES) {
                expr = replace(expr, "\\\"", "\"")
            }
            append(parts, {"expr": expr, "line": line})
            line += count_newlines(src, i + 1, stop)
            i = stop + 1
            seg = i
        }
    }
    let last = slice(src, seg, i)
    if (len(cur) > 0) {
        append(cur, last)
        last = join(cur, "")
    }
    if (len(last) > 0 or len(parts) == 0) {
        append(parts, last)
    }
    return [parts, i + 1, line]
}

# Characters

# Reads the character literal whose opening quote is at index i. Returns [code, next_i].
func lex_char(src, i, line) {
    let n = len(src)
    i += 1
    if (i >= n or src[i] == '\n') {
        die("Syntax Error", line, "Unterminated character literal")
    }
    let code = 0
    if (src[i] == '\'') {
        die("Syntax Error", line, "Empty character literal")
    }
    if (src[i] == '\\') {
        if (i + 1 >= n) {
            die("Syntax Error", line, "Unterminated character literal")
        }
        let e = src[i + 1]
        if (e == '0') {
            code = 0
        } else {
            let text = escape_text(e)
            if (text == null) {
                die("Syntax Error", line, "Unknown escape '\\{e}' in character literal")
            }
            code = int(text[0])
        }
        i += 2
    } else {
        code = int(src[i])
        i += 1
    }
    if (i >= n or src[i] != '\'') {
        die("Syntax Error", line, "A character literal holds exactly one character")
    }
    return [code, i + 1]
}

# Numbers

# Reads the digits of a number in the given base starting at i, allowing single underscores
# between digits. Returns [value or text, next_i]; for base 16 and 2 the value is a decimal int.
func lex_based(src, i, base, line) {
    let n = len(src)
    let limit = 576460752303423487
    if (base == 2) {
        limit = 4611686018427387903
    }
    let value = 0
    let digits = 0
    let prev_underscore = false
    while (i < n) {
        let c = src[i]
        if (c == '_') {
            if (digits == 0 or prev_underscore) {
                die("Syntax Error", line, "Misplaced '_' in number")
            }
            prev_underscore = true
            i += 1
        } else {
            let d = hex_value(c)
            if (d < 0 or d >= base) {
                break
            }
            if (value > limit) {
                die("Syntax Error", line, "Integer literal does not fit in 64 bits")
            }
            value = value * base + d
            digits += 1
            prev_underscore = false
            i += 1
        }
    }
    if (digits == 0 or prev_underscore) {
        die("Syntax Error", line, "Invalid number literal")
    }
    return [value, i]
}

# Reads the number starting at index i. Returns [token, next_i].
func lex_number(src, i, line) {
    let n = len(src)
    let s = i
    let tok = null
    if (src[i] == '0' and i + 1 < n and (src[i + 1] == 'x' or src[i + 1] == 'X' or src[i + 1] == 'b' or src[i + 1] == 'B')) {
        let base = 16
        if (src[i + 1] == 'b' or src[i + 1] == 'B') {
            base = 2
        }
        let r = lex_based(src, i + 2, base, line)
        tok = make_tok("num", "{r[0]}", line)
        i = r[1]
    } else {
        i = skip_chars(src, NUMBER_BYTES, i)
        let is_float = false
        if (i + 1 < n and src[i] == '.' and is_dig(src[i + 1])) {
            is_float = true
            i = skip_chars(src, NUMBER_BYTES, i + 1)
        }
        if (i < n and (src[i] == 'e' or src[i] == 'E')) {
            let j = i + 1
            if (j < n and (src[j] == '+' or src[j] == '-')) {
                j += 1
            }
            if (j < n and is_dig(src[j])) {
                is_float = true
                i = skip_chars(src, DIGIT_BYTES, j)
            }
        }
        let text = slice(src, s, i)
        if (index_of(text, "_") >= 0) {
            if (ends_with(text, "_") or index_of(text, "__") >= 0 or index_of(text, "_.") >= 0 or index_of(text, "._") >= 0) {
                die("Syntax Error", line, "Misplaced '_' in number")
            }
            text = replace(text, "_", "")
        }
        if (is_float) {
            tok = make_tok("float", text, line)
        } else {
            tok = make_tok("num", text, line)
        }
    }
    if (i < n and is_ident_char(src[i])) {
        die("Syntax Error", line, "Invalid number literal: '{slice(src, s, i + 1)}' is a number followed by a letter")
    }
    return [tok, i]
}

# Tokens

# One-character operators and the first characters of two-character operators, indexed by byte
# code so that the lexer needs no string or map work for them.
func build_one_kinds() {
    let table = []
    for (let k = 0; k < 256; k++) {
        append(table, null)
    }
    for (let key in map_keys(ONE_CHAR)) {
        table[int(key[0])] = ONE_CHAR[key]
    }
    return table
}

# The text of each one-character operator by byte code, so a token reuses it instead of building "{c}".
func build_one_texts() {
    let table = []
    for (let k = 0; k < 256; k++) {
        append(table, null)
    }
    for (let key in map_keys(ONE_CHAR)) {
        table[int(key[0])] = key
    }
    return table
}

# Two-character operators: TWO_KIND[first][second] is the token kind and TWO_TEXT[first][second] the
# operator text, both null where the pair is not an operator. A row exists only for first bytes that
# start an operator, so the lexer looks a pair up without slicing a string.
func build_two_table(want_kind) {
    let table = []
    for (let k = 0; k < 256; k++) {
        append(table, null)
    }
    for (let key in map_keys(TWO_CHAR)) {
        let a = int(key[0])
        if (table[a] == null) {
            let row = []
            for (let k = 0; k < 256; k++) {
                append(row, null)
            }
            table[a] = row
        }
        if (want_kind) {
            table[a][int(key[1])] = TWO_CHAR[key]
        } else {
            table[a][int(key[1])] = key
        }
    }
    return table
}

# What the lexer does at a byte: 1 starts an identifier (letter or _), 2 starts a number, 3 is
# blank (space, tab, CR), 4 is a newline, 5 opens a string, 6 opens a character literal, 7 starts a
# # comment, 8 is / (a comment when another / follows, an operator otherwise), 0 is an operator
# byte or an error.
func build_classes() {
    let table = []
    for (let k = 0; k < 256; k++) {
        if ((k >= 65 and k <= 90) or (k >= 97 and k <= 122) or k == 95) {
            append(table, 1)
        } else if (k >= 48 and k <= 57) {
            append(table, 2)
        } else if (k == 32 or k == 9 or k == 13) {
            append(table, 3)
        } else if (k == 10) {
            append(table, 4)
        } else if (k == 34) {
            append(table, 5)
        } else if (k == 39) {
            append(table, 6)
        } else if (k == 35) {
            append(table, 7)
        } else if (k == 47) {
            append(table, 8)
        } else {
            append(table, 0)
        }
    }
    return table
}

let ONE_KIND = build_one_kinds()
let ONE_TEXT = build_one_texts()
let TWO_KIND = build_two_table(true)
let TWO_TEXT = build_two_table(false)
let CLASS = build_classes()

export func lex(src, first_line) {
    let toks = []
    let n = len(src)
    let i = 0
    let line = first_line
    while (i < n) {
        let c = src[i]
        let code = int(c)
        let cls = CLASS[code]
        if (cls == 8) {
            if (i + 1 < n and src[i + 1] == '/') {
                cls = 7
            } else {
                cls = 0
            }
        }
        if (cls == 0) {
            let kind = null
            let row = TWO_KIND[code]
            if (row != null and i + 1 < n) {
                let second = int(src[i + 1])
                kind = row[second]
                if (kind != null) {
                    append(toks, Token(kind, TWO_TEXT[code][second], line))
                    i += 2
                    continue
                }
            }
            kind = ONE_KIND[code]
            if (kind != null) {
                append(toks, Token(kind, ONE_TEXT[code], line))
                i += 1
            } else if (code >= 128) {
                die("Syntax Error", line, "Unexpected character (byte {code}): only ASCII is allowed outside strings and comments")
            } else {
                die("Syntax Error", line, "Unexpected character '{c}'")
            }
        } else if (cls == 1) {
            let s = i
            i = skip_chars(src, IDENT_BYTES, i + 1)
            let word = slice(src, s, i)
            let kw = KEYWORDS[word]
            if (kw != null) {
                append(toks, Token(kw, word, line))
            } else {
                append(toks, Token("id", word, line))
            }
        } else if (cls == 3) {
            i = skip_chars(src, " \t\r", i + 1)
        } else if (cls == 4) {
            append(toks, Token("nl", null, line))
            line += 1
            i += 1
        } else if (cls == 2) {
            let r = lex_number(src, i, line)
            append(toks, r[0])
            i = r[1]
        } else if (cls == 5) {
            let r = lex_string(src, i, line)
            append(toks, Token("str", r[0], line))
            i = r[1]
            line = r[2]
        } else if (cls == 6) {
            let r = lex_char(src, i, line)
            append(toks, Token("char", r[0], line))
            i = r[1]
        } else {
            i = index_of(src, "\n", i)
            if (i < 0) {
                i = n
            }
        }
    }
    append(toks, Token("eof", null, line))
    return toks
}
