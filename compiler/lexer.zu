#
# lexer.zu: source text to tokens.
#
# A token has a kind t, a value v, and its place: line and col (counting bytes from 1) where it starts,
# eline and ecol where it ends (ecol is the column just after its last byte). Kinds: nl, str, char,
# num, float, id, eof, the keywords, and the operator names from token.zu. A "num" value is decimal
# digit text (hex, binary and underscores are resolved here), a "float" value is the number text, a
# "char" value is the code.
#
# A mistake in the text is recorded with diag_new and the lexer goes on, so one run finds every
# lexical error. Each case below says how the lexer resumes.

use { diag_new, diag_text, diag_hint, diag_on_line, span_tok } from "diag.zu"
use { KEYWORDS, ONE_CHAR, TWO_CHAR } from "token.zu"
use { cut } from "ranges.zu"

# True for a byte that continues a UTF-8 character.
func is_cont_byte(c) {
    return c >= 128 and c < 192
}

func is_dig(c) {
    return c >= '0' and c <= '9'
}

func is_ident_start(c) {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'
}

func is_ident_char(c) {
    return is_ident_start(c) or is_dig(c)
}

# Set by interp_end when the expression writes its quotes as \" (the older way to put a string
# inside an interpolation); lex_string then turns \" into " in the expression text.
let ESCAPED_QUOTES = false

# Set by interp_end when an interpolation has no closing brace.
let INTERP_FAILED = false

# The bytes a string literal scan stops at: the closing quote, an escape, a newline, an interpolation.
let STRING_STOPS = "\"\\\n\{"
# The bytes that may be in an identifier, and the bytes of a number's digits.
let IDENT_BYTES = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789"
let DIGIT_BYTES = "0123456789"
let NUMBER_BYTES = "0123456789_"

template Token { t, v, line, col, eline, ecol }

# The index of the first byte of the line being scanned. Inside a string interpolation it is chosen
# so that columns count from the place of the expression in the file.
let LS = 0

# The column of the byte at index i on the current line.
func col_of(i) {
    return i - LS + 1
}

# Records a lexical error, unless the line already has one: the first error on a line is the cause,
# and what follows it on that line is usually its effect. Returns the error, or null.
func lex_error(line, col, ecol, msg) {
    if (diag_on_line(line)) {
        return null
    }
    return diag_new("Syntax Error", span_tok(line, col, ecol), msg)
}

# The index of the end of the line that holds index i.
func line_end(src, i) {
    # index_of_any gives len(src) when there is no line break after i
    return index_of_any(src, "\n", i)
}

# The value of a hex digit, or -1.
func hex_value(c) {
    if (c >= '0' and c <= '9') {
        return int(c) - 48
    }
    if (c >= 'a' and c <= 'f') {
        return int(c) - 87
    }
    if (c >= 'A' and c <= 'F') {
        return int(c) - 55
    }
    return -1
}

# Strings

# The text an escape letter stands for inside a string or character literal, or null.
func escape_text(e) {
    if (e == 'n') {
        return "\n"
    }
    if (e == 't') {
        return "\t"
    }
    if (e == 'r') {
        return "\r"
    }
    if (e == '\\') {
        return "\\"
    }
    if (e == '"') {
        return "\""
    }
    if (e == '\'') {
        return "'"
    }
    if (e == '{') {
        return "\{"
    }
    if (e == '}') {
        return "\}"
    }
    return null
}

# The index just after the string literal whose opening quote is at k.
func skip_string(src, k, start_line) {
    let n = len(src)
    k += 1
    while (k < n) {
        let c = src[k]
        if (c == '\\') {
            k += 2
        } else if (c == '"') {
            return k + 1
        } else if (c == '\{' and k + 1 < n and src[k + 1] != '\}') {
            k = interp_end(src, k + 1, start_line) + 1
        } else {
            k += 1
        }
    }
    return n
}

# The index of the } that closes an interpolation whose text starts at k. Braces, strings and
# character literals inside the expression are skipped over.
func interp_end(src, k, start_line) {
    let n = len(src)
    let open_at = k - 1
    let open_col = col_of(open_at)
    let depth = 1
    while (k < n) {
        let c = src[k]
        if (c == '"') {
            k = skip_string(src, k, start_line)
        } else if (c == '\\' and k + 1 < n and src[k + 1] == '"') {
            ESCAPED_QUOTES = true
            k += 2
        } else if (c == '\'') {
            if (k + 1 < n and src[k + 1] == '\\') {
                k += 4
            } else {
                k += 3
            }
        } else if (c == '\{') {
            depth += 1
            k += 1
        } else if (c == '\}') {
            depth -= 1
            if (depth == 0) {
                return k
            }
            k += 1
        } else {
            k += 1
        }
    }
    let d = lex_error(start_line, open_col, open_col + 1, "Unclosed string interpolation expression")
    diag_text(d, "this '\{' is never closed")
    diag_hint(d, "Close it with '\}', or write '\\\{' for a literal brace")
    INTERP_FAILED = true
    return open_at
}

# Counts the line breaks in src from index a up to index b, and moves LS to the start of the last line.
func track_newlines(src, a, b) {
    let count = 0
    let k = index_of_any(src, "\n", a)
    while (k < b) {
        count += 1
        LS = k + 1
        k = index_of_any(src, "\n", k + 1)
    }
    return count
}

# Reads the string whose opening quote is at index i. Returns [parts, next_i, next_line]. A part
# is either a string or {"expr": source, "line": n, "col": c}. A { starts an interpolation unless it
# is written \{ or is immediately followed by }. An unterminated string is reported and ends at the
# end of the line it starts on.
func lex_string(src, i, start_line) {
    let n = len(src)
    let line = start_line
    let q_at = i
    let ls0 = LS
    let q_col = col_of(i)
    let parts = []
    let cur = []
    i += 1
    let seg = i
    while (true) {
        i = index_of_any(src, STRING_STOPS, i)
        if (i == len(src)) {
            return string_unterminated(src, q_at, q_col, ls0, start_line)
        }
        let c = src[i]
        if (c == '"') {
            break
        }
        if (c == '\n') {
            line += 1
            i += 1
            LS = i
        } else if (c == '\\') {
            if (i + 1 >= n) {
                return string_unterminated(src, q_at, q_col, ls0, start_line)
            }
            let text = escape_text(src[i + 1])
            let width = 2
            if (text == null) {
                text = ""
                if (src[i + 1] == '\n') {
                    width = 1
                    let d = lex_error(line, col_of(i), col_of(i) + 1, "A backslash at the end of a line is not an escape")
                    diag_hint(d, "Write \\\\ for a backslash; a string may continue on the next line without one")
                } else {
                    # the whole character after the backslash, all of its UTF-8 bytes ("\\é" showed half of it)
                    let clen = utf8_len(src[i + 1])
                    width = 1 + clen
                    let d = lex_error(line, col_of(i), col_of(i) + 1 + clen, "Unknown escape '\\{cut(src, i + 1, i + 1 + clen)}' in string")
                    diag_text(d, "not an escape")
                    diag_hint(d, "The escapes are \\n \\t \\r \\\\ \\\" \\' \\\{ and \\\}")
                }
            }
            append(cur, cut(src, seg, i))
            append(cur, text)
            i += width
            seg = i
        } else if (c == '\{' and i + 1 < n and src[i + 1] == '\}') {
            i += 1
        } else {
            ESCAPED_QUOTES = false
            INTERP_FAILED = false
            let stop = interp_end(src, i + 1, line)
            if (INTERP_FAILED) {
                INTERP_FAILED = false
                i += 1
                continue
            }
            let before = cut(src, seg, i)
            if (len(cur) > 0) {
                append(cur, before)
                before = join(cur, "")
            }
            if (len(before) > 0) {
                append(parts, before)
            }
            cur = []
            let expr = cut(src, i + 1, stop)
            if (ESCAPED_QUOTES) {
                expr = replace(expr, "\\\"", "\"")
            }
            append(parts, {"expr": expr, "line": line, "col": col_of(i + 1)})
            line += track_newlines(src, i + 1, stop)
            i = stop + 1
            seg = i
        }
    }
    let last = cut(src, seg, i)
    if (len(cur) > 0) {
        append(cur, last)
        last = join(cur, "")
    }
    if (len(last) > 0 or len(parts) == 0) {
        append(parts, last)
    }
    return [parts, i + 1, line]
}

# Reports a string with no closing quote. The string is taken to end with its first line.
func string_unterminated(src, q_at, q_col, ls0, start_line) {
    LS = ls0
    let e = line_end(src, q_at)
    let d = lex_error(start_line, q_col, col_of(e), "Unterminated string")
    diag_text(d, "this string has no closing quote")
    diag_hint(d, "Add a closing '\"' at the end of the string")
    return [[cut(src, q_at + 1, e)], e, start_line]
}

# Characters

# Reports a bad character literal that starts at index i0 and returns [0, next_i]: the literal is
# taken to end at its closing quote when there is one on the line, otherwise at the end of the line.
func char_fail(src, i0, line, msg, hint) {
    let e = line_end(src, i0)
    let q = index_of_any(src, "'", i0 + 1)
    let next = e
    if (q < e) {
        next = q + 1
    }
    let d = lex_error(line, col_of(i0), col_of(next), msg)
    diag_hint(d, hint)
    return [0, next]
}

# Reads the character literal whose opening quote is at index i. Returns [code, next_i].
func lex_char(src, i, line) {
    let n = len(src)
    let i0 = i
    i += 1
    if (i >= n or src[i] == '\n') {
        return char_fail(src, i0, line, "Unterminated character literal", "A character literal looks like 'a'")
    }
    let code = 0
    if (src[i] == '\'') {
        return char_fail(src, i0, line, "Empty character literal", "Put one character between the quotes, like 'a'")
    }
    if (src[i] == '\\') {
        if (i + 1 >= n) {
            return char_fail(src, i0, line, "Unterminated character literal", "A character literal looks like 'a'")
        }
        let e = src[i + 1]
        if (e == '0') {
            code = 0
        } else {
            let text = escape_text(e)
            if (text == null) {
                return char_fail(src, i0, line, "Unknown escape '\\{e}' in character literal", "The escapes are \\n \\t \\r \\\\ \\' \\\" and \\0")
            }
            code = int(text[0])
        }
        i += 2
    } else {
        code = int(src[i])
        i += 1
    }
    if (i >= n or src[i] != '\'') {
        return char_fail(src, i0, line, "A character literal holds exactly one character", "Use double quotes for text: \"ab\"")
    }
    return [code, i + 1]
}

# Numbers

# Reads the digits of a number in the given base starting at i, allowing single underscores
# between digits. s is the index where the literal starts. Returns [value, next_i]; for base 16 and
# 2 the value is a decimal int. A bad literal is reported and read to its end, and its value is 0.
func lex_based(src, s, i, base, line) {
    let n = len(src)
    let limit = 576460752303423487
    if (base == 2) {
        limit = 4611686018427387903
    }
    let value = 0
    let digits = 0
    let prev_underscore = false
    let bad = null
    while (i < n) {
        let c = src[i]
        if (c == '_') {
            if ((digits == 0 or prev_underscore) and bad == null) {
                bad = lex_error(line, col_of(s), col_of(i) + 1, "Misplaced '_' in number")
                diag_hint(bad, "Put a single '_' between two digits, like 1_000")
            }
            prev_underscore = true
            i += 1
        } else {
            let d = hex_value(c)
            if (d < 0 or d >= base) {
                break
            }
            if (value > limit and bad == null) {
                bad = lex_error(line, col_of(s), col_of(i) + 1, "Integer literal does not fit in 64 bits")
                diag_hint(bad, "The largest int is 9223372036854775807")
            }
            if (bad == null) {
                value = value * base + d
            }
            digits += 1
            prev_underscore = false
            i += 1
        }
    }
    if ((digits == 0 or prev_underscore) and bad == null) {
        bad = lex_error(line, col_of(s), col_of(i), "Invalid number literal")
        diag_hint(bad, "Digits are needed after 0x or 0b, and '_' goes between digits")
    }
    if (bad != null) {
        bad.span.ecol = col_of(i)
        value = 0
    }
    return [value, i]
}

# The number of bytes of the UTF-8 character whose first byte is c.
func utf8_len(c) {
    let b = int(c)
    if (b < 0) {
        b += 256
    }
    if (b >= 240) {
        return 4
    }
    if (b >= 224) {
        return 3
    }
    if (b >= 192) {
        return 2
    }
    return 1
}

# True when the float literal text (no '_') is too large for a 64-bit float: it rounds to infinity. That is
# from 1.7976931348623158079372897140530341507993e308 on, halfway between the largest float
# (1.7976931348623157e308) and the next power of two; a value below the halfway point rounds down to the
# largest float.
func float_too_big(text) {
    let e = index_of_any(text, "eE")
    let mant = text
    let ed = "0"
    let neg = false
    if (e < len(text)) {
        mant = cut(text, 0, e)
        ed = cut(text, e + 1, len(text))
        neg = starts_with(ed, "-")
        if (neg or starts_with(ed, "+")) {
            ed = cut(ed, 1, len(ed))
        }
        while (len(ed) > 1 and starts_with(ed, "0")) {
            ed = cut(ed, 1, len(ed))    # 1e0000001 is 1e1
        }
    }
    let whole = mant
    let digits = mant
    if (contains(mant, ".")) {
        whole = cut(mant, 0, index_of(mant, "."))
        digits = replace(mant, ".", "")
    }
    let lead = 0
    while (lead < len(digits) and digits[lead] == '0') {
        lead += 1
    }
    if (lead == len(digits) or neg) {
        return false    # zero (0e9999999 is 0), or a negative exponent: never too large
    }
    if (len(ed) > 6) {
        return true
    }
    let top = len(whole) - lead - 1 + to_int(ed)
    if (top != 308) {
        return top > 308
    }
    let sig = cut(digits, lead, len(digits))
    while (len(sig) < 40) {
        sig = "{sig}0"
    }
    return cut(sig, 0, 40) >= "1797693134862315807937289714053034150799"
}

# Reads the number starting at index i. Returns [token fields, next_i]: the kind and the text.
func lex_number(src, i, line) {
    let n = len(src)
    let s = i
    let kind = "num"
    let text = ""
    if (src[i] == '0' and i + 1 < n and (src[i + 1] == 'x' or src[i + 1] == 'X' or src[i + 1] == 'b' or src[i + 1] == 'B')) {
        let base = 16
        if (src[i + 1] == 'b' or src[i + 1] == 'B') {
            base = 2
        }
        let r = lex_based(src, s, i + 2, base, line)
        text = "{r[0]}"
        i = r[1]
    } else {
        i = skip_chars(src, NUMBER_BYTES, i)
        let is_float = false
        if (i + 1 < n and src[i] == '.' and is_dig(src[i + 1])) {
            is_float = true
            i = skip_chars(src, NUMBER_BYTES, i + 1)
        }
        if (i < n and (src[i] == 'e' or src[i] == 'E')) {
            let j = i + 1
            if (j < n and (src[j] == '+' or src[j] == '-')) {
                j += 1
            }
            if (j < n and is_dig(src[j])) {
                is_float = true
                i = skip_chars(src, DIGIT_BYTES, j)
            }
        }
        text = cut(src, s, i)
        if (contains(text, "_")) {
            if (ends_with(text, "_") or contains(text, "__") or contains(text, "_.") or contains(text, "._")) {
                let d = lex_error(line, col_of(s), col_of(i), "Misplaced '_' in number")
                diag_hint(d, "Put a single '_' between two digits, like 1_000")
            }
            text = replace(text, "_", "")
        }
        if (is_float) {
            kind = "float"
            if (float_too_big(text)) {
                let d = lex_error(line, col_of(s), col_of(i), "Float literal does not fit in a 64-bit float")
                diag_hint(d, "The largest float is about 1.7976931348623157e308. Zue has no infinity")
                text = "0.0"
            }
        }
    }
    if (i < n and is_ident_char(src[i])) {
        let j = skip_chars(src, IDENT_BYTES, i)
        let d = lex_error(line, col_of(s), col_of(j), "Invalid number literal: '{cut(src, s, i + 1)}' is a number followed by a letter")
        diag_hint(d, "Put an operator or a space between a number and a name")
    }
    return [kind, text, i]
}

# Tokens

# One-character operators and the first characters of two-character operators, indexed by byte
# code so that the lexer needs no string or map work for them.
func build_one_kinds() {
    let table = []
    for (let k = 0; k < 256; k++) {
        append(table, null)
    }
    for (let key in map_keys(ONE_CHAR)) {
        table[int(key[0])] = ONE_CHAR[key]
    }
    return table
}

# The text of each one-character operator by byte code, so a token reuses it instead of building "{c}".
func build_one_texts() {
    let table = []
    for (let k = 0; k < 256; k++) {
        append(table, null)
    }
    for (let key in map_keys(ONE_CHAR)) {
        table[int(key[0])] = key
    }
    return table
}

# Two-character operators: TWO_KIND[first][second] is the token kind and TWO_TEXT[first][second] the
# operator text, both null where the pair is not an operator. A row exists only for first bytes that
# start an operator, so the lexer looks a pair up without slicing a string.
func build_two_table(want_kind) {
    let table = []
    for (let k = 0; k < 256; k++) {
        append(table, null)
    }
    for (let key in map_keys(TWO_CHAR)) {
        let a = int(key[0])
        if (table[a] == null) {
            let row = []
            for (let k = 0; k < 256; k++) {
                append(row, null)
            }
            table[a] = row
        }
        if (want_kind) {
            table[a][int(key[1])] = TWO_CHAR[key]
        } else {
            table[a][int(key[1])] = key
        }
    }
    return table
}

# What the lexer does at a byte: 1 starts an identifier (letter or _), 2 starts a number, 3 is
# blank (space, tab, CR), 4 is a newline, 5 opens a string, 6 opens a character literal, 7 starts a
# # comment, 8 is / (a comment when another / follows, an operator otherwise), 0 is an operator
# byte or an error.
func build_classes() {
    let table = []
    for (let k = 0; k < 256; k++) {
        if ((k >= 65 and k <= 90) or (k >= 97 and k <= 122) or k == 95) {
            append(table, 1)
        } else if (k >= 48 and k <= 57) {
            append(table, 2)
        } else if (k == 32 or k == 9 or k == 13) {
            append(table, 3)
        } else if (k == 10) {
            append(table, 4)
        } else if (k == 34) {
            append(table, 5)
        } else if (k == 39) {
            append(table, 6)
        } else if (k == 35) {
            append(table, 7)
        } else if (k == 47) {
            append(table, 8)
        } else {
            append(table, 0)
        }
    }
    return table
}

let ONE_KIND = build_one_kinds()
let ONE_TEXT = build_one_texts()
let TWO_KIND = build_two_table(true)
let TWO_TEXT = build_two_table(false)
let CLASS = build_classes()

# Tokens for src. first_line is the line number of its first line and first_col the column of its
# first byte; both are 1 for a whole file and name the place of the expression for the text of a
# string interpolation.
export func lex(src, first_line, first_col = 1) {
    let toks = []
    let n = len(src)
    let i = 0
    let line = first_line
    let ls = 1 - first_col
    while (i < n) {
        let c = src[i]
        let code = int(c)
        let cls = CLASS[code]
        if (cls == 8) {
            if (i + 1 < n and src[i + 1] == '/') {
                cls = 7
            } else {
                cls = 0
            }
        }
        if (cls == 0) {
            let kind = null
            let col = i - ls + 1
            let row = TWO_KIND[code]
            if (row != null and i + 1 < n) {
                let second = int(src[i + 1])
                kind = row[second]
                if (kind != null) {
                    append(toks, Token(kind, TWO_TEXT[code][second], line, col, line, col + 2))
                    i += 2
                    continue
                }
            }
            kind = ONE_KIND[code]
            if (kind != null) {
                append(toks, Token(kind, ONE_TEXT[code], line, col, line, col + 1))
                i += 1
            } else if (code >= 128) {
                let j = i + 1
                while (j < n and is_cont_byte(int(src[j]))) {
                    j += 1
                }
                let d = lex_error(line, col, col + j - i, "Unexpected character (byte {code}): only ASCII is allowed outside strings and comments")
                diag_hint(d, "Put the character inside a string or a comment")
                i = j
            } else {
                let d = lex_error(line, col, col + 1, "Unexpected character '{c}'")
                diag_text(d, "not part of the language")
                i += 1
            }
        } else if (cls == 1) {
            let s = i
            i = skip_chars(src, IDENT_BYTES, i + 1)
            let word = cut(src, s, i)
            let kw = map_get(KEYWORDS, word, null)
            let col = s - ls + 1
            if (kw != null) {
                append(toks, Token(kw, word, line, col, line, col + i - s))
            } else {
                append(toks, Token("id", word, line, col, line, col + i - s))
            }
        } else if (cls == 3) {
            i = skip_chars(src, " \t\r", i + 1)
        } else if (cls == 4) {
            let col = i - ls + 1
            append(toks, Token("nl", null, line, col, line, col + 1))
            line += 1
            i += 1
            ls = i
        } else if (cls == 2) {
            LS = ls
            let col = i - ls + 1
            let r = lex_number(src, i, line)
            i = r[2]
            append(toks, Token(r[0], r[1], line, col, line, i - ls + 1))
        } else if (cls == 5) {
            LS = ls
            let col = i - ls + 1
            let start_line = line
            let r = lex_string(src, i, line)
            i = r[1]
            line = r[2]
            ls = LS
            append(toks, Token("str", r[0], start_line, col, line, i - ls + 1))
        } else if (cls == 6) {
            LS = ls
            let col = i - ls + 1
            let r = lex_char(src, i, line)
            i = r[1]
            append(toks, Token("char", r[0], line, col, line, i - ls + 1))
        } else {
            i = index_of_any(src, "\n", i)
        }
    }
    append(toks, Token("eof", null, line, n - ls + 1, line, n - ls + 1))
    return toks
}
