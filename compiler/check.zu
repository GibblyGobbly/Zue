#
# check.zu: compile-time type checking of the main program.
#
# Every expression gets a type, a string: int, float, bool, char, string, null, list, map, box,
# function, or any. A list or map can carry its element type, written list<int> or map<float>; plain
# list and map mean the elements are not known. "any" means the checker cannot tell, and nothing is reported about it; the
# runtime checks still apply. int~ and float~ are untyped number constants: a literal adapts to
# the type its context needs (sqrt(16) is fine), while a variable never converts.
#
# A variable has the type of its first value and keeps it. A parameter has the type of the
# argument at each call; a function that is never called is checked with parameters of type any.

use { ST } from "state.zu"
use { BUILTINS } from "shared.zu"
use { Diag, Span, diag_new, diag_text, diag_hint, diag_label, diag_trace, diag_exit_if_errors, diag_shown, span_at, span_line, suggest } from "diag.zu"
use { cut } from "ranges.zu"
use { Node, mk_call, node_span, nodes_under } from "ast_nodes.zu"
use { parse_source } from "parser.zu"
use { resolve_named_args } from "named_args.zu"
use { path_dir, path_join, path_norm, split_lines } from "util.zu"

# One scope: the type of each name, and beside the types what else a name stands for: the node of a
# function, the node of a list that started empty (let xs = [], emptied when it gets a second type), the
# file a function was imported from, and where each variable got its type (a span, to label an error).
template Scope { types: map<string>, fns: map<Node>, empties: map<Node>, homes: map<CkFile>, origins: map<Span> }

let SCOPES: list<Scope> = []

# Strict mode is the rule: a value whose type the checker cannot tell is an error where its type matters,
# and so is an untyped parameter of a function value.

# Above 0 while the body of a named function with an untyped parameter is checked once with that
# parameter unknown. Such a body is checked again for the argument types of every call, and those
# checks report what strict mode finds; the pass with unknown parameters reports only proven errors.
let GENERIC = 0

# zue --no-strict, a switch for the test suite only: strict mode stays silent, so a test can hide the
# type of a value and reach the check the runtime makes itself. It is not part of the language.
export const NO_STRICT = [false]

# zue check --list-types: for each list that starts empty (let xs = []), the types of the values appended
# to it, so that a tool can write the element type: "file:line" -> the list's name and the types.
export const LIST_TYPES_ON = [false]
template ListNote { name: string, types: map<bool> }
let LIST_TYPES: map<ListNote> = {}

# Notes that a value of type t is appended to the list a names, when a starts empty.
func note_list_type(a: Node, t: string) {
    if (a.k != "id") {
        return null
    }
    let idx = scope_index(a.name)
    if (idx < 0 or idx != empty_index(a.name)) {
        return null
    }
    let ln = SCOPES[idx].empties[a.name]
    if (ln == null) {
        return null
    }
    let key = "{ST.src_file}:{ln.line}"
    if (not map_has(LIST_TYPES, key)) {
        LIST_TYPES[key] = ListNote(a.name, {})
    }
    # unknown while a recursive function is still being checked; its second pass gives the type
    let st = settle(t)
    if (st != "any") {
        LIST_TYPES[key].types[st] = true
    }
}

# A list that starts empty (let xs = []) takes the type of the first value appended to it: xs is a
# list<int> after append(xs, 1). A value of another type appended later makes it a list of mixed items.
# A map that starts empty (let m = {}) takes the type of the first value stored in it, m[k] = v.
# Returns true when a is such a list, so the append needs no other check.
func grow_list(a: Node, t: string, vt: string) -> bool {
    if (a.k != "id") {
        return false
    }
    let idx = scope_index(a.name)
    if (idx < 0 or idx != empty_index(a.name) or SCOPES[idx].empties[a.name] == null) {
        return false
    }
    let types = SCOPES[idx].types
    let kind = kind_of(types[a.name])
    let v = settle(vt)
    if (types[a.name] == kind and v != "any" and v != "null" and v != "unset") {
        types[a.name] = "{kind}<{v}>"
    } else if (types[a.name] != "{kind}<{v}>") {
        # a second type, or a value of unknown type: a list (or map) of mixed items from here on
        types[a.name] = kind
        SCOPES[idx].empties[a.name] = null
    }
    return true
}

# Prints "file:line: name: list<T>" for every list that starts empty and gets values of one known type.
func print_list_types() {
    for (let key in sort(map_keys(LIST_TYPES))) {
        let ts = map_keys(LIST_TYPES[key].types)
        if (len(ts) == 1 and ts[0] != "null" and ts[0] != "unset") {
            print("{key}: {LIST_TYPES[key].name}: list<{ts[0]}>")
        }
    }
}

func strict_on() -> bool {
    return GENERIC == 0 and not NO_STRICT[0]
}

# Per-call checking of user functions. A function body is checked once for each distinct list of
# argument types, with the parameters bound to those types.
# The typed bloc and template definitions the file being checked knows, by name.
let TYPEDEFS: map<Node> = {}

# Every bloc and template definition of every file, by name, and the definitions known in the file that
# declares it. Kept for the whole compilation, as FILES is: each module is checked on its own
# (check_program), and a file checked for an earlier module is not checked again. A value can reach a file that never names its type (a function of another file returns
# it), and its fields are still known; the types written in a definition or in the signature of a
# function are read in the file they are written in.
let ALL_TYPEDEFS: map<Node> = {}
let DEF_SCOPE: map<map<Node>> = {}

func note_typedef(n: Node) {
    TYPEDEFS[n.name] = n
    if (not map_has(ALL_TYPEDEFS, n.name)) {
        ALL_TYPEDEFS[n.name] = n
        DEF_SCOPE[n.name] = TYPEDEFS
    }
}

let MEMO: map<string> = {}
let INPROG: map<bool> = {}

# The function bodies being checked, innermost last: the function's name and argument types, the line of
# the call, the place of the body, and the file of the call.
template Call { name: string, types: list<string>, line: int, body: string, file: string }
let CALLS: list<Call> = []
let RETS: list<list<string>> = []

# Recursion. The result type of a function that calls itself is unknown while its body is checked, so
# the first pass takes it as any. When the other returns agree on one scalar type, the body is checked
# once more with that type assumed for the recursive calls (ASSUME). If every return then has that type
# the assumption holds, because a recursion that ends does so in a return that does not recurse.
# The second pass reports nothing (QUIET counts the errors it would have reported) and keeps a log of
# what it changed (LOG), so that a rejected assumption leaves no trace.
let RECURSIVE: map<bool> = {}
let ASSUME: map<string> = {}
let QUIET = 0
let QUIET_HITS = 0

# A change to a node: which field ("sty", "stys", "ads" or "spec"), its value before, and for stys and
# ads the key of the entry (before is null when the entry did not exist).
template MarkEntry { n: Node, field: string, before: string, key: string }
# The changes made and the MEMO keys added while LOG is not empty.
template Log { marks: list<MarkEntry>, memos: list<string> }
let LOG: Log = null

# Builtin signatures: name -> alternatives, each the parameter types and the result. T stands for a number
# type (int or float) that must be the same everywhere it appears.
template Alt { params: list<string>, res: string }
let SIGS: map<list<Alt>> = {}
let BUILTIN_NAMES: map<bool> = {}

# The alternatives of a builtin, written "int,int>int|float,float>float" (">float" takes no argument).
func sig(name: string, text: string) {
    let alts: list<Alt> = []
    for (let form in split(text, "|")) {
        let gt = index_of(form, ">")
        let params: list<string> = []
        if (gt > 0) {
            params = split(cut(form, 0, gt), ",")
        }
        append(alts, Alt(params, cut(form, gt + 1, len(form))))
    }
    SIGS[name] = alts
}

# Builtins whose result type is fixed whatever the arguments are.
let RESULTS: map<string> = {}

func ck_init_results() {
    for (let nm in split("len str_len index_of index_of_any skip_chars last_index_of", " ")) {
        RESULTS[nm] = "int"
    }
    for (let nm in split("type to_upper to_lower trim trim_left trim_right replace repeat pad_left pad_right substring join", " ")) {
        RESULTS[nm] = "string"
    }
    for (let nm in split("contains starts_with ends_with is_digit is_alpha is_alnum is_space is_empty map_has", " ")) {
        RESULTS[nm] = "bool"
    }
    RESULTS["split"] = "list<string>"
    RESULTS["map_keys"] = "list<string>"
    RESULTS["range"] = "list<int>"
    RESULTS["dense_list"] = "list<float>"
    RESULTS["args"] = "list<string>"
    RESULTS["map_items"] = "list<list>"
    for (let nm in split("read char_at concat to_string fixed string", " ")) {
        RESULTS[nm] = "string"
    }
    for (let nm in split("code system find", " ")) {
        RESULTS[nm] = "int"
    }
    RESULTS["char"] = "char"
    RESULTS["clock"] = "float"
    RESULTS["file_exists"] = "bool"
    # an open file, or null when it cannot be opened
    RESULTS["open"] = "file"
    # Strict mode is the rule, so every builtin has a result type. Those that give nothing give null.
    for (let nm in split("print write flush close map_set yield send channel_close srand exit free store defer shape ssort shuffle tshuffle", " ")) {
        RESULTS[nm] = "null"
    }
    for (let nm in split("assert remove_file map_delete", " ")) {
        RESULTS[nm] = "bool"
    }
    RESULTS["read_line"] = "string"
    # the values of a map of mixed items (a map with a value type gives a list of that type, see ck_builtin)
    RESULTS["map_values"] = "list"
    RESULTS["input"] = "string"
    for (let nm in split("alloc ptr_add ptr_offset address_of addr", " ")) {
        RESULTS[nm] = "pointer"
    }
    RESULTS["channel"] = "channel"
    RESULTS["spawn"] = "thread"
    for (let nm in split("map vec_add vec_sub vec_mul vec_div vec_mul_inline mat_mul", " ")) {
        RESULTS[nm] = "list"
    }
    # What these give depends on what was stored, sent or returned: the program says it, let v: int = recv(ch).
    for (let nm in split("load deref wait recv reduce", " ")) {
        RESULTS[nm] = "any"
    }
}

ck_init_results()

for (let nm in map_keys(BUILTINS)) {
    BUILTIN_NAMES[nm] = true
}

# Names the code generator treats as calls without them being in BUILTINS (see ex_call).
BUILTIN_NAMES["address_of"] = true
BUILTIN_NAMES["addr"] = true

func ck_init_sigs() {
    for (let nm in split("sqrt cbrt exp ln log10 sin cos tan asin acos atan sinh cosh tanh fract deg_to_rad rad_to_deg", " ")) {
        sig(nm, "float>float")
    }
    sig("atan2", "float,float>float")
    sig("mod", "int,int>int|float,float>float")
    sig("floor_div", "int,int>int|float,float>float")
    sig("divmod", "int,int>list|float,float>list")
    sig("lerp", "float,float,float>float")
    for (let nm in split("floor ceil round trunc", " ")) {
        sig(nm, "float>int")
    }
    sig("round", "float>int|float,int>float|int,int>int")
    sig("pow", "int,int>int|float,float>float")
    sig("abs", "T>T")
    sig("min", "T,T>T|list>any")
    sig("max", "T,T>T|list>any")
    sig("sum", "list>any")
    sig("mean", "list>float")
    sig("gcd", "int,int>int")
    sig("lcm", "int,int>int")
    sig("isqrt", "int>int")
    sig("clamp", "T,T,T>T")
    sig("sign", "int>int|float>int")
    sig("rand", ">float|int>int|int,int>int")
    sig("srand", ">null|int>null")
    sig("trand", ">int|int>int|int,int>int")
    # Conversions keep the value: an int from a whole float or from text, a float from an int or from text.
    # A char or a bool is not a number (code(c) gives a character's code).
    sig("float", "int>float|float>float|string>float")
    # int(p) of a pointer gives its address, inside unsafe
    sig("int", "float>int|int>int|string>int|pointer>int")
    sig("to_string", "any>string|float,int>string")
    sig("string", "any>string")
    sig("code", "char>int")
    sig("char", "int>char")
    sig("fixed", "float,int>string")
    # a condition is a bool, as for if and while
    sig("assert", "bool>bool")
}

ck_init_sigs()

# The argument lists the other builtins take, for checking their arguments only (their results come from
# RESULTS and ck_builtin). Forms are separated by |, an empty form takes no argument. "text" is a string or
# a char. The builtins of unsafe code, print and spawn are checked elsewhere.
let ARGS: map<list<Alt>> = {}

func args_of(name: string, text: string) {
    let alts: list<Alt> = []
    for (let form in split(text, "|")) {
        let params: list<string> = []
        if (form != "-") {
            params = split(form, ",")
        }
        append(alts, Alt(params, "any"))
    }
    ARGS[name] = alts
}

func ck_init_args() {
    # len of a template, bloc or data value is its number of fields
    args_of("len", "string|list|map|box|record")
    args_of("str_len", "string")
    args_of("append", "list,any")
    args_of("list_append", "list,any")
    for (let nm in split("type shape debug", " ")) {
        args_of(nm, "any")
    }
