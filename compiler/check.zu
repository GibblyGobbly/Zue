    args_of("exit", "-|int")
    args_of("system", "string")
    args_of("map_set", "map,string,any")
    args_of("map_get", "map,string|map,string,any")
    args_of("map_has", "map,string")
    args_of("map_delete", "map,string")
    for (let nm in split("map_keys map_values map_items", " ")) {
        args_of(nm, "map")
    }
    args_of("remove", "list,int")
    args_of("find", "list,any")
    args_of("slice", "list,int,int|string,int,int")
    for (let nm in split("sort shuffle tshuffle ssort", " ")) {
        args_of(nm, "list")
    }
    args_of("map", "list,function")
    args_of("filter", "list,function")
    args_of("reduce", "list,function,any")
    args_of("is_empty", "string")
    args_of("concat", "string,string")
    args_of("substring", "string,int,int")
    args_of("char_at", "string,int")
    args_of("index_of", "string,text|string,text,int")
    args_of("index_of_any", "string,text|string,text,int")
    args_of("skip_chars", "string,text|string,text,int")
    args_of("last_index_of", "string,text")
    args_of("contains", "string,text|list,any")
    args_of("starts_with", "string,text")
    args_of("ends_with", "string,text")
    for (let nm in split("to_upper to_lower", " ")) {
        args_of(nm, "text")
    }
    for (let nm in split("trim trim_left trim_right", " ")) {
        args_of(nm, "string")
    }
    args_of("replace", "string,text,text")
    args_of("reverse", "string|list")
    args_of("repeat", "text,int")
    args_of("pad_left", "string,int,text")
    args_of("pad_right", "string,int,text")
    args_of("split", "string,text")
    args_of("join", "list,string")
    for (let nm in split("is_digit is_alpha is_alnum is_space", " ")) {
        args_of(nm, "text")
    }
    args_of("open", "string,string")
    for (let nm in split("close read read_line flush", " ")) {
        args_of(nm, "file")
    }
    args_of("write", "file,string")
    args_of("file_exists", "string")
    args_of("remove_file", "string")
    args_of("dense_list", "int,float")
    for (let nm in split("vec_add vec_sub vec_mul vec_div vec_mul_inline mat_mul", " ")) {
        args_of(nm, "list,list")
    }
    args_of("wait", "thread")
    args_of("channel", "-|int")
    args_of("send", "channel,any")
    args_of("recv", "channel")
    args_of("channel_close", "channel")
}

ck_init_args()

# Types

func is_const(t: string) -> bool {
    return ends_with(t, "~")
}

func is_number(t: string) -> bool {
    return t == "int" or t == "float" or t == "int~" or t == "float~"
}

# A constant takes its natural type when nothing else decides.
func settle(t: string) -> string {
    if (t == "int~") {
        return "int"
    }
    if (t == "float~") {
        return "float"
    }
    return t
}

# Whether a value of type t can be used where type target is required.
func fits(t: string, target: string) -> bool {
    if (t == "any" or target == "any" or t == target) {
        return true
    }
    if (t == "int~") {
        return target == "int" or target == "float"
    }
    if (t == "float~") {
        return target == "float"
    }
    let kt = kind_of(t)
    if ((kt == "list" or kt == "map") and kt == kind_of(target)) {
        let et = elem_of(t)
        let eg = elem_of(target)
        if (et == null or eg == null) {
            return true
        }
        return fits(et, eg) and fits(eg, et)
    }
    if (kt == kind_of(target) and object_def(kt) != null) {
        let at = template_args(t)
        let ag = template_args(target)
        if (at == null or ag == null) {
            return true
        }
        for (let i = 0; i < len(at) and i < len(ag); i++) {
            if (not (fits(at[i], ag[i]) and fits(ag[i], at[i]))) {
                return false
            }
        }
        return true
    }
    return false
}

# A value of a template whose fields have no written type has the types of what it was made with, after its
# name: Stack([1, 2]) is a Stack<list<int>>, a Pair(1, "a") of template Pair { a, b } a Pair<int,string>. Only
# the fields without a type are listed, in their order. The plain name (an annotation, a value from code the
# checker cannot see) says nothing about them.
func template_args(t: string) {
    let inner = angle_inner(t)
    if (inner == null) {
        return null
    }
    let out: list<string> = []
    let depth = 0
    let start = 0
    for (let i = 0; i < len(inner); i++) {
        let c = inner[i]
        if (c == '<') {
            depth += 1
        } else if (c == '>') {
            depth -= 1
        } else if (c == ',' and depth == 0) {
            append(out, cut(inner, start, i))
            start = i + 1
        }
    }
    append(out, cut(inner, start, len(inner)))
    return out
}

# The type of field fi of a value of type t whose definition is td.
func object_field_type(td: Node, t: string, fi: int) -> string {
    if (td.ftypes[fi] != "") {
        return field_check_type(td.ftypes[fi], def_scope(td))
    }
    let args = template_args(t)
    if (args == null) {
        return "any"
    }
    let pos = 0
    for (let i = 0; i < fi; i++) {
        if (td.ftypes[i] == "") {
            pos += 1
        }
    }
    if (pos < len(args)) {
        return args[pos]
    }
    return "any"
}

# list<int> has the kind list and the element type int; a plain list has no element type.
func kind_of(t: string) -> string {
    if (not contains(t, "<")) {
        return t
    }
    return cut(t, 0, index_of(t, "<"))
}

func elem_of(t: string) {
    let k = kind_of(t)
    if (k != "list" and k != "map") {
        return null
    }
    return angle_inner(t)
}

# What is between the first < of t and its last character, or null when t has no <.
func angle_inner(t: string) {
    if (not contains(t, "<")) {
        return null
    }
    return cut(t, index_of(t, "<") + 1, len(t) - 1)
}

# The element type of a list or map literal whose items have types ts, or null when they differ.
func common_elem(ts: list<string>) {
    if (len(ts) == 0) {
        return null
    }
    let first = settle(ts[0])
    if (first == "any" or first == "null" or first == "unset") {
        return null
    }
    for (let t in ts) {
        if (settle(t) != first) {
            return null
        }
    }
    return first
}

# fits, except that a whole-number constant is not a float: it must be written 2.0 or adapted first.
func fits_slot(t: string, target: string) -> bool {
    if (t == "int~" and target == "float") {
        return false
    }
    return fits(t, target)
}

# Whole numbers written in the source become floats where a float is wanted, so a float variable,
# field or list never holds an int. Only + - * keep their value when both sides turn into floats.
#
# The body of a function is checked once per signature (the argument types of a call), and a literal can
# be wanted as a float for one signature and as an int for another (x = 1 where x came from a parameter).
# So inside such a check the literal is not changed: lit_record keeps, per signature, what it is wanted as
# (n.ads), and settle_literals decides once everything is checked: a float for every signature makes it a
# float literal; a float for some only makes it "dyn", and the generated code then turns it into a float at
# run time when the value it goes into is one. A specialized version of the function reads n.ads itself.
func adapt_to(n: Node, want: string) {
    if (want == "float") {
        if (n.k == "num") {
            if (not exact_float(n.v as int)) {
                let d = fail_node(n, "the number literal {n.v} has no exact float value")
                diag_text(d, "a float is wanted here")
                diag_hint(d, "A float holds whole numbers exactly only up to 9007199254740992. Write a float literal, or keep the value an int")
                return null
            }
            if (len(CALLS) > 0) {
                lit_record(n, "float")
            } else {
                n.k = "float"
                if (not contains(n.v, ".")) {
                    n.v = "{n.v}.0"
                }
            }
        } else if (n.k == "bin" and (n.op == "+" or n.op == "-" or n.op == "*") and is_int_tree(n)) {
            adapt_to(n.l, want)
            adapt_to(n.r, want)
        }
        return null
    }
    let e = elem_of(want)
    if (e == null) {
        return null
    }
    if (kind_of(want) == "list" and n.k == "list") {
        for (let item in n.items) {
            adapt_to(item, e)
        }
    } else if (kind_of(want) == "map" and n.k == "map") {
        for (let v in n.vals) {
            adapt_to(v, e)
        }
    }
    return null
}

# Every name that some statement of the program assigns (name = value, name += value, name++), at any depth.
let ASSIGNED: map<bool> = {}

func collect_assigned(stmts: list<Node>) {
    for (let x in nodes_under(stmts)) {
        if (x.k == "assign" or x.k == "incdec") {
            ASSIGNED[x.name] = true
        }
    }
}

# The signature of the function being checked, as the key of n.ads and n.stys.
func call_key() -> string {
    return join(CALLS[len(CALLS) - 1].types, ",")
}

# The whole-number literals adapted inside a per-signature check, and for each function body (by place)
# the signatures it was checked with.
let LITERALS: list<Node> = []
let BODY_SIGS: map<list<string>> = {}

# Records that a whole-number literal is wanted as a float for the signature being checked. n.ad holds the
# place of the function body until settle_literals.
func lit_record(n: Node, what: string) {
    let key = call_key()
    if (n.ads == null) {
        n.ads = {}
        append(LITERALS, n)
    }
    n.ad = CALLS[len(CALLS) - 1].body
    let before = map_get(n.ads, key, null)
    if (before == what) {
        return null
    }
    n.ads[key] = what
    if (LOG != null) {
        append(LOG.marks, MarkEntry(n, "ads", before, key))
    }
}

# A whole-number literal (or + - * of them) next to a value of unknown type: decided at run time.
func lit_mark_any(n: Node) {
    if (n.k == "num") {
        if (n.ads == null) {
            n.ads = {}
            append(LITERALS, n)
        }
        n.ads["*"] = "any"
    } else if (n.k == "bin" and is_int_tree(n)) {
        lit_mark_any(n.l)
        lit_mark_any(n.r)
    }
}

# After the whole program is checked: what each recorded literal is in the ordinary version of its function.
func settle_literals() {
    for (let n in LITERALS) {
        let sigs = null
        if (n.ad != null) {
            sigs = map_get(BODY_SIGS, n.ad, null)
        }
        let floats = 0
        let all = sigs != null
        if (sigs != null) {
            for (let key in sigs) {
                if (map_get(n.ads, key, null) == "float") {
                    floats += 1
                } else {
                    all = false
                }
            }
        }
        n.ad = null
        if (map_get(n.ads, "*", null) == "any") {
            n.ad = "dyn"
        } else if (floats > 0 and all) {
            n.k = "float"
            if (not contains(n.v, ".")) {
                n.v = "{n.v}.0"
            }
        } else if (floats > 0) {
            n.ad = "dyn"
        }
    }
}

# Whether the int v becomes a float with no change of value.
func exact_float(v: int) -> bool {
    if (v == -9223372036854775807 - 1) {
        return true
    }
    let a = abs(v)
    while (a > 9007199254740992) {
        if (a % 2 != 0) {
            return false
        }
        a = a / 2
    }
    return true
}

# Whether n is made only of whole-number literals joined by + - *.
func is_int_tree(n: Node) -> bool {
    if (n.k == "num") {
        return true
    }
    if (n.k == "bin" and (n.op == "+" or n.op == "-" or n.op == "*")) {
        return is_int_tree(n.l) and is_int_tree(n.r)
    }
    return false
}

# The type of expression n (of type et) once it is adapted to the slot type want.
func adapt_expr(n: Node, et: string, want: string) -> string {
    if (want == "any") {
        return et
    }
    # a list or map literal is adapted item by item even when its plain type fits ([1.5, 2] is a list)
    let literal = (n.k == "list" or n.k == "map") and elem_of(want) != null
    if (literal or not fits_slot(et, want)) {
        adapt_to(n, want)
        et = ck_expr(n)
    }
    if (fits_slot(et, want)) {
        ck_literal_items(n, want)
    }
    return et
}

# A list or map written out where a typed one is wanted: each item must be of the element type. (Such a
# literal of mixed items has the plain type list or map, which fits any list or map type.)
func ck_literal_items(n: Node, want: string) {
    let e = elem_of(want)
    if (e == null or e == "any") {
        return null
    }
    let items = n.items
    if (n.k == "map") {
        items = n.vals
    } else if (n.k != "list") {
        return null
    }
    for (let item in items) {
        let it = ck_expr(item)
        if (it == "any") {
            strict_known(it, item, "an item of this {want}")
        } else if (it == "null" and not is_scalar(e) and e != "char") {
            # an item of a type whose values may be empty (string, list, map, function, template)
            continue
        } else if (not fits_slot(it, e)) {
            let d = fail_node(item, "cannot put {describe(it)} in a {want}")
            diag_text(d, "this is {describe(it)}")
            let how = convert_hint(e, it, item)
            if (len(how) == 0) {
                how = "A {want} holds only {e} items"
            }
            diag_hint(d, how)
        } else {
            ck_literal_items(item, e)
        }
    }
}

# The checker type for a type written in the source. An unknown name is an error when strict, else any.
func annot(text: string, span: Span, strict: bool) -> string {
    return annot_in(text, span, strict, TYPEDEFS)
}

# annot with the type definitions ds.
func annot_in(text: string, span: Span, strict: bool, ds: map<Node>) -> string {
    if (contains(text, "<")) {
        let i = index_of(text, "<")
        let kind = cut(text, 0, i)
        let inner = annot_in(cut(text, i + 1, len(text) - 1), span, strict, ds)
        if (inner == "any") {
            return kind
        }
        return "{kind}<{inner}>"
    }
    if (text == "int" or text == "float" or text == "bool" or text == "char" or text == "string") {
        return text
    }
    if (text == "list" or text == "map" or text == "function") {
        return text
    }
    if (text == "pointer" or text == "channel" or text == "thread" or text == "file") {
        return text
    }
    let td = map_get(ds, text, null)
    if (td != null) {
        if (td.is_bloc == true or td.is_template == true) {
            return text
        }
        return "any"
    }
    if (strict and lookup(text) == null) {
        let d = fail_at(span, "unknown type '{text}'")
        diag_text(d, "not a type")
        diag_hint(d, "The types are int, float, bool, char, string, list, map, function, pointer, channel, thread, file, and the names of your own bloc and template types")
    }
    return "any"
}

func describe(t: string) -> string {
    if (t == "int~") {
        return "an int constant"
    }
    if (t == "float~") {
        return "a float constant"
    }
    return t
}

# The type of an operation on two numbers, or null when they do not fit.
func unify(a: string, b: string) {
    if (not is_number(a) or not is_number(b)) {
        return null
    }
    if (is_const(a) and is_const(b)) {
        if (a == "float~" or b == "float~") {
            return "float~"
        }
        return "int~"
    }
    if (is_const(a)) {
        if (fits(a, b)) {
            return b
        }
        return null
    }
    if (is_const(b)) {
        if (fits(b, a)) {
            return a
        }
        return null
    }
    if (a == b) {
        return a
    }
    return null
}

# Scopes

func push_scope() {
    append(SCOPES, Scope({}, {}, {}, {}, {}))
}

func pop_scope() {
    remove(SCOPES, len(SCOPES) - 1)
}

# Every name a block declares with let, func, a type or use, noted when the block starts. At the end
# of the check it tells a typo from a name that is merely declared further down.
let HOISTED: map<bool> = {}

# Declares name with type t in the innermost scope; at is where it got the type, or null.
func declare(name: string, t: string, at: Span = null) {
    let sc = SCOPES[len(SCOPES) - 1]
    sc.types[name] = t
    if (at != null) {
        sc.origins[name] = at
    }
}

func declare_fn(name: string, n: Node) {
    SCOPES[len(SCOPES) - 1].fns[name] = n
}

func declare_home(name: string, cf: CkFile) {
    SCOPES[len(SCOPES) - 1].homes[name] = cf
}

# Notes that the list variable name starts empty (n is its let), or, with n null, that it no longer does.
func declare_empty(name: string, n: Node) {
    SCOPES[len(SCOPES) - 1].empties[name] = n
}

# Where the type of variable name was decided, as a span, or null.
func type_origin(name: string) -> Span {
    let i = scope_index(name)
    if (i < 0 or not map_has(SCOPES[i].origins, name)) {
        return null
    }
    return SCOPES[i].origins[name]
}

# The types of the scope that holds name, or null.
func scope_of(name: string) {
    let i = scope_index(name)
    if (i < 0) {
        return null
    }
    return SCOPES[i].types
}

func lookup(name: string) {
    let i = scope_index(name)
    if (i < 0) {
        return null
    }
    return SCOPES[i].types[name]
}

# Errors

# A name that is read or assigned but declared nowhere yet is noted here and judged at the end of the
# check, when every declaration has been seen: it is a typo only if nothing in the program declares
# it, and it is not a builtin. When a use brings in a whole file without naming its names, any name
# may come from it.
template Pending { span: Span, name: string, what: string, scopes: list<Scope> }
let PENDING: list<Pending> = []
let OPEN_IMPORT = false

# The names a typo could have meant: those in scope, those declared anywhere, then the builtins.
func name_candidates(scopes: list<Scope>) -> list<string> {
    let out: list<string> = []
    let seen: map<bool> = {}
    for (let sc in scopes) {
        for (let key in map_keys(sc.types)) {
            if (not map_has(seen, key)) {
                seen[key] = true
                append(out, key)
            }
        }
    }
    for (let key in map_keys(HOISTED)) {
        if (not map_has(seen, key)) {
            seen[key] = true
            append(out, key)
        }
    }
    for (let key in map_keys(BUILTIN_NAMES)) {
        if (not map_has(seen, key)) {
            append(out, key)
        }
    }
    return out
}

# Notes the name in id node n for the end of the check if it is not a builtin. what is Variable or
# Function. Returns true when the name is not declared at this point, so the caller treats its type
# as unknown.
func check_name(n: Node, what: string) -> bool {
    let name = n.name
    if (map_has(BUILTIN_NAMES, name) or name == "null") {
        return false
    }
    append(PENDING, Pending(node_span(n), name, what, cut(SCOPES, 0, len(SCOPES))))
    # a name declared nowhere is reported at the end; strict mode does not also report its unknown type
    append(ERROR_SPANS, ErrorAt(ST.src_file, node_span(n)))
    return true
}

# Builtins that were removed, and what to write instead.
let REMOVED_NAMES: map<string> = {"to_int": "s as int, or int(s)", "to_float": "s as float, or float(s)"}

func undefined_error(span: Span, name: string, what: string, scopes: list<Scope>) {
    let d = fail_at(span, "{what} '{name}' is not defined", "Name Error")
    diag_text(d, "not declared anywhere")
    if (what == "Function") {
        diag_hint(d, "Define it with func {name}(...) before calling it, or check the spelling of a builtin")
    } else {
        diag_hint(d, "Declare variables with 'let' before using them")
    }
    if (map_has(REMOVED_NAMES, name)) {
        diag_hint(d, "{name} was removed: write {REMOVED_NAMES[name]}")
        return null
    }
    # the "did you mean" replaces the hint later, if the error is printed (fill_guesses)
    if (d != null) {
        d.guess = name
        append(GUESS_SCOPES, Guess(d, scopes))
    }
}

# For each undefined-name error, the scopes that were open where the name was used.
template Guess { d: Diag, scopes: list<Scope> }
let GUESS_SCOPES: list<Guess> = []

# Gives each printed undefined-name error a "did you mean" when a declared name is close to it.
func fill_guesses() {
    for (let d in diag_shown()) {
        if (d.guess != null) {
            for (let g in GUESS_SCOPES) {
                if (g.d == d) {
                    let guess = suggest(d.guess, name_candidates(g.scopes))
                    if (guess != null) {
                        diag_hint(d, "Did you mean '{guess}'?")
                    }
                }
            }
            d.guess = null
        }
    }
    GUESS_SCOPES = []
}

# Places that already have an error. A function body is checked once for each list of argument
# types, so the same mistake could be found again; it is reported once.
let REPORTED: map<bool> = {}

# sp, or the place of node n when sp is not known.
func span_or(sp: Span, n: Node) -> Span {
    if (sp == null) {
        return node_span(n)
    }
    return sp
}

# Records a type error at span. Returns it, to add labels and a hint, or null when the place already
# has one. Checking goes on after an error; the expression that failed is given the type any, which
# raises no further errors.
func fail_at(span: Span, msg: string, kind: string = "Type Error") -> Diag {
    if (QUIET > 0) {
        QUIET_HITS += 1
        return null
    }
    let key = "{ST.src_file}:{span.line}:{span.col}"
    if (span.col == 0) {
        key = "{ST.src_file}:{span.line}:{msg}"
    }
    if (map_has(REPORTED, key)) {
        return null
    }
    REPORTED[key] = true
    append(ERROR_SPANS, ErrorAt(ST.src_file, span))
    let d = diag_new(kind, span, msg)
    let i = len(CALLS) - 1
    while (i >= 0) {
        let c = CALLS[i]
        let sep = ", "
        let at = "line {c.line}"
        if (c.file != ST.src_file) {
            at = "{c.file} line {c.line}"
        }
        diag_trace(d, "  in {c.name}({join(c.types, sep)}), called at {at}")
        i -= 1
    }
    return d
}

func fail_node(n: Node, msg: string) -> Diag {
    return fail_at(node_span(n), msg)
}

# What to write to get a value of type want from one of type got, or "".
func convert_hint(want: string, got: string, n: Node = null) -> string {
    if (n != null and (n.k == "str" or n.k == "tmpl" or n.k == "char" or n.k == "bool" or n.k == "list" or n.k == "map")) {
        # A literal of the wrong type is not something to convert; the value itself is wrong.
        if (want != "float" and want != "int") {
            return ""
        }
        if (n.k != "num" and n.k != "float") {
            return ""
        }
    }
    if (want == "float" and got == "int~") {
        return "Write the number with a decimal point, for example 2.0"
    }
    if (want == "float" and got == "int") {
        return "An int never becomes a float by itself: convert it with float(x)"
    }
    if (want == "int" and (got == "float" or got == "float~")) {
        return "A float never becomes an int by itself: say how to round it with round(x), floor(x), ceil(x) or trunc(x)"
    }
    if (want == "string" and is_number(got)) {
        return "Convert a number to text with x as string, or write it inside a string: \"\{x}\""
    }
    if ((want == "int" or want == "float" or want == "number") and got == "string") {
        return "Convert text to a number with s as int or s as float"
    }
    if (want == "bool") {
        return "Make a bool with a comparison, for example x != 0 or len(s) > 0"
    }
    return ""
}

# Where errors were reported. A value whose expression holds one of them has the type any because of that
# error, and strict mode does not report it again.
template ErrorAt { file: string, span: Span }
let ERROR_SPANS: list<ErrorAt> = []

# Names whose type is unknown because of an error already reported: names a use statement asked for that
# their file does not export, and variables whose first value had an error.
let BAD_IMPORTS: map<bool> = {}

# Whether an error was reported inside the place of node n, or n uses a name in BAD_IMPORTS.
func error_inside(n: Node) -> bool {
    if (len(map_keys(BAD_IMPORTS)) > 0) {
        for (let x in nodes_under([n])) {
            if (x.k == "id" and map_has(BAD_IMPORTS, x.name)) {
                return true
            }
        }
    }
    let at = node_span(n)
    for (let e in ERROR_SPANS) {
        if (e.file != ST.src_file) {
            continue
        }
        let sp = e.span
        let after_start = sp.line > at.line or (sp.line == at.line and sp.col >= at.col)
        let before_end = sp.line < at.eline or (sp.line == at.eline and (sp.col < at.ecol or at.col == 0))
        if (after_start and before_end) {
            return true
        }
    }
    return false
}

# In strict mode a value of type any may not be used where its type matters.
func strict_known(t: string, n: Node, what: string) {
    if (strict_on() and t == "any" and not error_inside(n)) {
        let d = fail_node(n, "strict mode: the type of {what} is not known. Give it a type, for example let x: int = ...")
        diag_text(d, "type not known")
    }
}

# The place of the operator of a binary node.
func op_span(n: Node) -> Span {
    if (n.ospan != null) {
        return n.ospan
    }
    return node_span(n)
}

func operand_error(n: Node, a: string, b: string) {
    let op = n.op
    let d = fail_at(op_span(n), "cannot use '{op}' on {describe(a)} and {describe(b)}")
    diag_label(d, node_span(n.l), describe(a))
    diag_label(d, node_span(n.r), describe(b))
    if (op == "+" and (a == "string" or b == "string")) {
        diag_hint(d, "'+' joins two strings. Build text with interpolation, \"\{x} and \{y}\", or convert with x as string")
    } else if (is_number(a) and is_number(b)) {
        diag_hint(d, "int and float never mix: convert an int with float(n), or round a float with round(x), floor(x), ceil(x) or trunc(x)")
    } else if (op == "==" or op == "!=") {
        diag_hint(d, "'{op}' compares two values of the same kind; convert one side first")
    }
}

# Names the operands of a binary node; unary minus is stored as 0 - x.
func bin_error(n: Node, a: string, b: string) {
    if (n.unary == true) {
        let d = fail_at(op_span(n), "cannot negate {describe(b)}")
        diag_label(d, node_span(n.r), describe(b))
        diag_hint(d, "Only an int or a float can be negated")
        return null
    }
    operand_error(n, a, b)
}

# Expressions

# A list is indexed by an int.
func ck_index(t: string, it: string, idx_node: Node) {
    if (kind_of(t) == "list" and it != "any" and it != "int" and it != "int~") {
        let d = fail_node(idx_node, "list index must be an int, got {describe(it)}")
        diag_text(d, "this is {describe(it)}")
        diag_hint(d, "An index is a whole number counting from 0; round a float with round(x), floor(x), ceil(x) or trunc(x) if you mean that")
    }
}

func is_zero_literal(n: Node) -> bool {
    return (n.k == "num" and n.v == "0") or (n.k == "float" and (n.v == "0.0" or n.v == "0"))
}

func ck_bin(n: Node) -> string {
    let a = ck_expr(n.l)
    let b = ck_expr(n.r)
    let op = n.op
    # A whole-number literal next to a float becomes a float: 2.5 * 2 is 2.5 * 2.0, x < 1 for a float x is
    # x < 1.0. The runtime never mixes an int with a float.
    # Next to a value whose type is not known here the literal takes that value's number type at run time.
    let bitwise = op == "&" or op == "|" or op == "^" or op == "<<" or op == ">>"
    if (op != "and" and op != "or" and not bitwise and n.unary == null) {
        if (a == "int~" and (b == "float" or b == "float~")) {
            a = adapt_expr(n.l, a, "float")
        } else if (b == "int~" and (a == "float" or a == "float~")) {
            b = adapt_expr(n.r, b, "float")
        } else if (a == "int~" and b == "any") {
            lit_mark_any(n.l)
        } else if (b == "int~" and a == "any") {
            lit_mark_any(n.r)
        }
    }
    if (strict_on() and (op != "==" and op != "!=" or (a != "null" and b != "null"))) {
        strict_known(a, n.l, "the left operand of '{op}'")
        strict_known(b, n.r, "the right operand of '{op}'")
    }
    if (op == "and" or op == "or") {
        if (a != "any" and a != "bool") {
            let d = fail_node(n.l, "'{op}' needs bool operands, got {describe(a)}")
            diag_text(d, "this is {describe(a)}")
            diag_hint(d, "Use a comparison, for example x != 0 or len(s) > 0")
        }
        if (b != "any" and b != "bool") {
            let d = fail_node(n.r, "'{op}' needs bool operands, got {describe(b)}")
            diag_text(d, "this is {describe(b)}")
            diag_hint(d, "Use a comparison, for example x != 0 or len(s) > 0")
        }
        return "bool"
    }
    if (op == "==" or op == "!=") {
        if (a == "any" or b == "any" or a == "null" or b == "null") {
            return "bool"
        }
        if (is_number(a) or is_number(b)) {
            if (unify(a, b) == null) {
                operand_error(n, a, b)
            }
            return "bool"
        }
        if (a != b and not fits(a, b)) {
            operand_error(n, a, b)
        }
        return "bool"
    }
    if (op == "<" or op == ">" or op == "<=" or op == ">=") {
        if (a == "any" or b == "any") {
            return "bool"
        }
        if (is_number(a) or is_number(b)) {
            if (unify(a, b) == null) {
                operand_error(n, a, b)
            }
            return "bool"
        }
        # two pointers into one allocation are ordered (the runtime checks that they are)
        if (a == b and (a == "string" or a == "char" or a == "pointer")) {
            return "bool"
        }
        operand_error(n, a, b)
        return "bool"
    }
    if (op == "&" or op == "|" or op == "^" or op == "<<" or op == ">>") {
        if ((a != "any" and a != "int" and a != "int~") or (b != "any" and b != "int" and b != "int~")) {
            operand_error(n, a, b)
            return "any"
        }
        if (a == "any" or b == "any") {
            return "any"
        }
        return "int"
    }
    # + - * / % **
    if (a == "any" or b == "any") {
        return "any"
    }
    if (op == "+" and a == "string" and b == "string") {
        return "string"
    }
    if (kind_of(a) == "list" and kind_of(b) == "list") {
        # Element-wise arithmetic: two lists of ints give a list of ints, floats a dense list of floats.
        if (op == "+" or op == "-" or op == "*" or op == "/") {
            let ea = elem_of(a)
            let eb = elem_of(b)
            if (ea == "int" and eb == "int") {
                return "list<int>"
            }
            if (ea == "float" and eb == "float") {
                return "list<float>"
            }
            if (ea != null and eb != null and ea != eb) {
                bin_error(n, a, b)
                return "any"
            }
        }
        return "list"
    }
    let t = unify(a, b)
    if (t == null) {
        bin_error(n, a, b)
        return "any"
    }
    if ((op == "/" or op == "%") and is_zero_literal(n.r)) {
        let d = fail_node(n.r, "division by zero")
        diag_text(d, "this is zero")
        diag_hint(d, "A divisor of 0 is always an error; check the value before dividing")
    }
    return t
}

# The first argument that does not fit a signature alternative: its index and the type expected there.
template Miss { i: int, want: string }

# The first mismatch of args against one signature alternative, or null when it fits. T is bound to the
# number type seen first.
func match_alt(alt: Alt, argtypes: list<string>) -> Miss {
    let bound = null
    let params = alt.params
    for (let i = 0; i < len(params); i++) {
        let p = params[i]
        let a = argtypes[i]
        if (p == "text") {
            if (a != "any" and a != "string" and a != "char") {
                return Miss(i, "string")
            }
        } else if (p == "record") {
            if (a != "any" and object_def(a) == null) {
                return Miss(i, "template")
            }
        } else if (p == "T") {
            if (a == "any") {
                continue
            }
            if (not is_number(a)) {
                return Miss(i, "number")
            }
            if (bound == null) {
                bound = a
            } else {
                let u = unify(bound, a)
                if (u == null) {
                    return Miss(i, settle(bound))
                }
                bound = u
            }
        } else if (not fits(a, p)) {
            return Miss(i, p)
        }
    }
    return null
}

# A whole-number literal given where the matched form of a builtin takes a float becomes a float, so the
# runtime gets two floats: min(1, 2.5) is min(1.0, 2.5), sqrt(16) is sqrt(16.0). A T parameter takes the type
# the arguments agree on.
func adapt_builtin_args(n: Node, alt: Alt, argtypes: list<string>) {
    let bound = alt_result(Alt(alt.params, "T"), argtypes)
    for (let i = 0; i < len(alt.params); i++) {
        let p = alt.params[i]
        if (p == "T") {
            p = bound
        }
        if (p == "float" and argtypes[i] == "int~") {
            argtypes[i] = adapt_expr(n.args[i], argtypes[i], "float")
        } else if (alt.params[i] == "T" and argtypes[i] == "int~" and contains(argtypes, "any")) {
            lit_mark_any(n.args[i])
        }
    }
}

func fits_without_adapting(alt: Alt, argtypes: list<string>) -> bool {
    for (let i = 0; i < len(alt.params); i++) {
        let p = alt.params[i]
        if (p != "T" and p != "text" and p != "record" and not fits_slot(argtypes[i], alt.params[i])) {
            return false
        }
    }
    return true
}

func alt_result(alt: Alt, argtypes: list<string>) -> string {
    let r = alt.res
    if (r != "T") {
        return r
    }
    let bound = null
    for (let i = 0; i < len(alt.params); i++) {
        if (alt.params[i] == "T" and argtypes[i] != "any") {
            if (bound == null) {
                bound = argtypes[i]
            } else {
                bound = unify(bound, argtypes[i])
            }
        }
    }
    if (bound == null) {
        return "any"
    }
    return settle(bound)
}

func alt_text(alt: Alt) -> string {
    let shown: list<string> = []
    for (let p in alt.params) {
        if (p == "text") {
            p = "string"
        } else if (p == "record") {
            p = "template"
        }
        append(shown, p)
    }
    let sep = ", "
    return "({join(shown, sep)})"
}

# Whether some form of alts takes argtypes.
func args_fit(alts: list<Alt>, argtypes: list<string>) -> bool {
    for (let alt in alts) {
        if (len(alt.params) == len(argtypes) and match_alt(alt, argtypes) == null) {
            return true
        }
    }
    return false
}

# The arguments of a builtin listed in ARGS: their number and types. False when they do not fit (the
# error is reported).
func ck_builtin_args(n: Node, name: string, argtypes: list<string>) -> bool {
    if (not map_has(ARGS, name)) {
        return true
    }
    if (strict_on()) {
        ck_strict_args(n, name, ARGS[name], argtypes)
    }
    ck_builtin_call(n, name, ARGS[name], argtypes)
    return args_fit(ARGS[name], argtypes)
}

# The place of the argument list of a call node, parentheses included.
func args_span(n: Node) -> Span {
    if (n.aspan != null) {
        return n.aspan
    }
    return node_span(n)
}

func ck_builtin_call(n: Node, name: string, alts: list<Alt>, argtypes: list<string>) -> string {
    let same_count: list<Alt> = []
    for (let alt in alts) {
        if (len(alt.params) == len(argtypes)) {
            append(same_count, alt)
        }
    }
    if (len(same_count) == 0) {
        let counts: list<string> = []
        for (let alt in alts) {
            if (not contains(counts, "{len(alt.params)}")) {
                append(counts, "{len(alt.params)}")
            }
        }
        let last = remove(counts, len(counts) - 1)
        let wanted = last
        if (len(counts) > 0) {
            let sep = ", "
            wanted = "{join(counts, sep)} or {last}"
        }
        let plural = "s"
        if (wanted == "1") {
            plural = ""
        }
        let d = fail_at(args_span(n), "{name}() expects {wanted} argument{plural}, but got {len(argtypes)}")
        diag_text(d, "found {len(argtypes)}")
        diag_label(d, node_span(n.callee), "{name} takes {wanted}")
        let forms: list<string> = []
        for (let alt in alts) {
            append(forms, "{name}{alt_text(alt)}")
        }
        let or_sep = " or "
        diag_hint(d, "Usage: {join(forms, or_sep)}")
        return "any"
    }
    # A form the arguments fit as they are wins over one that needs a literal made a float: round(5, 2) is the
    # int form, mod(5.5, 2) the float one.
    for (let alt in same_count) {
        if (match_alt(alt, argtypes) == null and fits_without_adapting(alt, argtypes)) {
            adapt_builtin_args(n, alt, argtypes)
            return alt_result(alt, argtypes)
        }
    }
    let first_miss: Miss = null
    for (let alt in same_count) {
        let miss = match_alt(alt, argtypes)
        if (miss == null) {
            adapt_builtin_args(n, alt, argtypes)
            return alt_result(alt, argtypes)
        }
        if (first_miss == null) {
            first_miss = miss
        }
    }
    if (len(same_count) == 1) {
        let idx = first_miss.i
        let want = first_miss.want
        let d = fail_node(n.args[idx], "{name}() argument {idx + 1} must be {article(want)} {want}, got {describe(argtypes[idx])}")
        diag_text(d, "expected {want}, found {describe(argtypes[idx])}")
        diag_label(d, node_span(n.callee), "argument {idx + 1} of {name}()")
        diag_hint(d, convert_hint(want, argtypes[idx], n.args[idx]))
        return "any"
    }
    let forms: list<string> = []
    for (let alt in same_count) {
        append(forms, alt_text(alt))
    }
    let got: list<string> = []
    for (let t in argtypes) {
        append(got, settle(t))
    }
    let sep = ", "
    let or_text = " or "
    let d = fail_at(args_span(n), "{name}() cannot be called with ({join(got, sep)}); use {join(forms, or_text)}")
    diag_text(d, "no form takes ({join(got, sep)})")
    diag_label(d, node_span(n.callee), name)
    if ((name == "int" or name == "float") and len(got) == 1) {
        if (got[0] == "char") {
            diag_hint(d, "A char is not a number: code(c) gives the code of a character")
        } else if (got[0] == "bool") {
            diag_hint(d, "A bool is not a number: choose the number with an if")
        }
    }
    return "any"
}

# A builtin that wants a particular type is not given a value of unknown type.
func ck_strict_args(n: Node, name: string, alts: list<Alt>, argtypes: list<string>) {
    # x as int and x as float (int(x), float(x)) take a value of any type: converting a value whose type is
    # not known (an item of a mixed list) is what they are for, and they check it when the program runs
    if ((name == "int" or name == "float") and len(argtypes) == 1) {
        return null
    }
    for (let i = 0; i < len(argtypes); i++) {
        if (argtypes[i] != "any" or error_inside(n.args[i])) {
            continue
        }
        for (let alt in alts) {
            if (len(alt.params) == len(argtypes) and alt.params[i] != "any") {
                let d = fail_node(n.args[i], "strict mode: the type of argument {i + 1} of {name}() is not known. Give it a type, for example let x: float = ...")
                diag_text(d, "type not known")
            }
        }
    }
}

func article(t: string) -> string {
    if (contains("aeiouAEIOU", char_at(t, 0))) {
        return "an"
    }
    return "a"
}

# The checker type a field declared with type text accepts, or "any" for a type it cannot judge.
func field_check_type(text: string, defs: map<Node>) -> string {
    if (text == null or text == "") {
        return "any"
    }
    if (text == "int" or text == "float" or text == "bool" or text == "char" or text == "string") {
        return text
    }
    if (text == "list" or text == "map" or text == "function") {
        return text
    }
    if (starts_with(text, "box:")) {
        return "box"
    }
    return annot_in(text, null, false, defs)
}

# The definitions the file that declares typedef td knows.
func def_scope(td: Node) -> map<Node> {
    if (map_get(ALL_TYPEDEFS, td.name, null) == td) {
        return DEF_SCOPE[td.name]
    }
    return TYPEDEFS
}

# The index of field in the fields of the typed definition td, or -1.
func field_index(td: Node, field: string) -> int {
    for (let i = 0; i < len(td.fields); i++) {
        if (td.fields[i] == field) {
            return i
        }
    }
    return -1
}

# The definition t names when t is a bloc, template or data type, else null.
func object_def(t: string) -> Node {
    let td = map_get(TYPEDEFS, kind_of(t), null)
    if (td == null) {
        td = map_get(ALL_TYPEDEFS, kind_of(t), null)
    }
    return td
}

# Constructing a type with typed fields: a whole-number literal given to a float field becomes a
# float literal, and an argument that cannot fit its field is an error now, not when it runs.
func ck_typed_construct(n: Node, name: string, argtypes: list<string>) -> string {
    let td = TYPEDEFS[name]
    let kind = "Template"
    if (td.is_bloc == true) {
        kind = "Bloc"
    }
    for (let i = 0; i < len(td.fields) and i < len(argtypes); i++) {
        let want = field_check_type(td.ftypes[i], def_scope(td))
        let got = argtypes[i]
        if (want == "any" or got == "any") {
            continue
        }
        # A field of a template may be empty; reading it is then a missing value (p.f else { ... }).
        if (got == "null" and td.is_bloc != true) {
            continue
        }
        got = adapt_expr(n.args[i], got, want)
        if (not fits_slot(got, want)) {
            let hint = ""
            if (want == "float" and got == "int~") {
                hint = ". Write the number with a decimal point, for example 2.0"
            }
            let d = fail_node(n.args[i], "{kind} '{name}' field '{td.fields[i]}' must be {article(want)} {want}, got {describe(got)}{hint}")
            diag_text(d, "expected {want}, found {describe(got)}")
            if (td.fspans != null) {
                diag_label(d, td.fspans[i], "field '{td.fields[i]}' of {name} is {want}")
            }
            diag_hint(d, convert_hint(want, got, n.args[i]))
        }
    }
    # A field without a type takes the type of the value it is made with, in a template or a bloc.
    let args: list<string> = []
    let known = false
    for (let i = 0; i < len(td.fields); i++) {
        if (td.ftypes[i] == "") {
            let t = "any"
            if (i < len(argtypes)) {
                t = settle(argtypes[i])
            }
            if (t == "null" or t == "unset") {
                t = "any"
            }
            if (t != "any") {
                known = true
            }
            append(args, t)
        }
    }
    if (not known) {
        return name
    }
    return "{name}<{join(args, ",")}>"
}

# How many "{}" placeholders a string literal holds, or -1 when the node is not a string literal.
func literal_holes(n: Node) -> int {
    let text = ""
    if (n.k == "str") {
        text = n.v
    } else if (n.k == "tmpl") {
        for (let part in n.parts) {
            if (part.k == "text") {
                text = text + part.v
            }
        }
    } else {
        return -1
    }
    let holes = 0
    let i = 0
    while (i + 1 < len(text)) {
        if (substring(text, i, 2) == "\{}") {
            holes += 1
            i += 1
        }
        i += 1
    }
    return holes
}

# print("... {} ...", a, b): one value for each placeholder.
func check_print_holes(n: Node) {
    if (len(n.args) < 2) {
        return null
    }
    let holes = literal_holes(n.args[0])
    if (holes > 0 and holes != len(n.args) - 1) {
        let d = fail_node(n, "print() has {holes} \{} placeholder(s) but got {len(n.args) - 1} value(s)")
        diag_text(d, "{holes} placeholder(s) in the first string")
        diag_hint(d, "Give one value for each \{} in the first string, or print the values on their own lines by leaving \{} out.")
    }
}

# Builtins that call a function they are given: the place of that argument, or -1.
func fn_arg_index(name: string) -> int {
    if (name == "map" or name == "filter" or name == "reduce") {
        return 1
    }
    if (name == "spawn") {
        return 0
    }
    return -1
}

# The place of a node, as a key.
func node_key(n: Node) -> string {
    return "{ST.src_file}:{n.line}:{n.col}"
}

# Named functions whose typed parameters are checked when the program runs, by file and place: those used
# as a value (the calls through the value are not followed) and those whose name is assigned elsewhere.
# A function without a name always checks them (see compile_function in emit_llvm.zu).
export const RT_PARAM_CHECKS: map<bool> = {}

# Names of named functions given to map, filter, reduce or spawn, by place: checked there for the
# types they are called with (ck_fn_value_call), so they may have untyped parameters.
let FN_ARG_OK: map<bool> = {}

# The node of the named function that name stands for here, or null (a variable holding a function,
# or a name assigned somewhere, is not followed).
func named_fn(name: string) -> Node {
    if (lookup(name) != "function" or map_has(ASSIGNED, name)) {
        return null
    }
    let fidx = fn_index(name)
    if (fidx < 0 or fidx != scope_index(name)) {
        return null
    }
    return SCOPES[fidx].fns[name]
}

# The first untyped parameter of fn, or "".
func untyped_param(fn: Node) -> string {
    for (let i = 0; i < len(fn.params); i++) {
        if (fn.ptypes == null or fn.ptypes[i] == "") {
            return fn.params[i]
        }
    }
    return ""
}

# A named function with an untyped parameter used as a value: what calls it later is not followed.
func fn_value_error(n: Node, fn: Node, why: string) {
    let p = untyped_param(fn)
    let d = fail_node(n, "strict mode: '{n.name}' is used as a value, so its parameter '{p}' needs a type, for example {p}: int")
    diag_text(d, why)
    diag_hint(d, "A function called by its name is checked for the types of each call; one passed around as a value is not")
}

# map(xs, f), filter(xs, f), reduce(xs, f, init) and spawn(f, args...) with a named function f: f is
# checked for the types it will be called with, as a direct call is.
func ck_fn_value_call(n: Node, name: string, argtypes: list<string>) {
    let fi = fn_arg_index(name)
    if (fi < 0 or fi >= len(n.args) or n.args[fi].k != "id") {
        return null
    }
    let a = n.args[fi]
    let fn = named_fn(a.name)
    if (fn == null) {
        return null
    }
    let types: list<string> = []
    if (name == "spawn") {
        for (let i = 1; i < len(argtypes); i++) {
            append(types, settle(argtypes[i]))
        }
    } else {
        let el = elem_of(argtypes[0])
        if (kind_of(argtypes[0]) != "list" or el == null) {
            el = "any"
        }
        if (name == "reduce" and len(argtypes) == 3) {
            append(types, settle(argtypes[2]))
        }
        append(types, el)
    }
    if (contains(types, "any")) {
        if (strict_on() and untyped_param(fn) != "") {
            fn_value_error(a, fn, "the types it is called with are not known here")
        }
        return null
    }
    let fidx = fn_index(a.name)
    let home: CkFile = null
    if (home_index(a.name) == fidx) {
        home = SCOPES[fidx].homes[a.name]
    }
    let nodes: list<Node> = []
    for (let t in types) {
        append(nodes, a)
    }
    ck_user_call(a.name, fn, fidx, types, mk_call(a, a, a, nodes, a), home, true)
}

func ck_call(n: Node) -> string {
    if (n.callee.k == "id" and lookup(n.callee.name) == null) {
        let fi = fn_arg_index(n.callee.name)
        if (fi >= 0 and fi < len(n.args) and n.args[fi].k == "id") {
            FN_ARG_OK[node_key(n.args[fi])] = true
        }
    }
    let argtypes = []
    for (let a in n.args) {
        append(argtypes, ck_expr(a))
    }
    if (n.callee.k != "id") {
        ck_expr(n.callee)
        return "any"
    }
    let name = n.callee.name
    let known = lookup(name)
    if (known == null and not map_has(BUILTIN_NAMES, name) and check_name(n.callee, "Function")) {
        return "any"
    }
    if (map_has(TYPEDEFS, name) and known == "type") {
        return ck_typed_construct(n, name, argtypes)
    }
    if (name == "print" and known == null) {
        check_print_holes(n)
        return "null"
    }
    if (name == "input" and known == null) {
        ck_builtin_args(n, name, argtypes)
        return "string"
    }
    # The body of a function is trusted only for the declaration the name stands for here (a parameter or a
    # local of the same name hides it) and only when the name is never assigned: after g = h a call of g runs h.
    if (known == "function" and not map_has(ASSIGNED, name)) {
        let fidx = fn_index(name)
        if (fidx >= 0 and fidx == scope_index(name)) {
            let home: CkFile = null
            if (home_index(name) == fidx) {
                home = SCOPES[fidx].homes[name]
            }
            return ck_user_call(name, SCOPES[fidx].fns[name], fidx, argtypes, n, home)
        }
    }
    if (known == null and map_has(BUILTIN_NAMES, name)) {
        ck_fn_value_call(n, name, argtypes)
        return ck_builtin(n, name, argtypes)
    }
    return "any"
}

# Calls of builtins: the signature table where there is one, a fixed result type where there is
# one, and the element type of a list argument for append, remove, min and max.
func ck_builtin(n: Node, name: string, argtypes: list<string>) -> string {
    if (not ck_builtin_args(n, name, argtypes)) {
        return "any"
    }
    let first = "any"
    if (len(argtypes) > 0) {
        first = argtypes[0]
    }
    let el = elem_of(first)
    if ((name == "append" or name == "list_append") and len(argtypes) == 2) {
        if (LIST_TYPES_ON[0]) {
            note_list_type(n.args[0], argtypes[1])
        }
        if (grow_list(n.args[0], first, argtypes[1])) {
            return lookup(n.args[0].name)
        }
        if (kind_of(first) == "list" and el != null) {
            if (el != "any") {
                strict_known(argtypes[1], n.args[1], "the value appended to {first}")
            }
            let vt = adapt_expr(n.args[1], argtypes[1], el)
            # a list of a template type may hold empty items, as a field of that type may be empty
            if (not fits_slot(vt, el) and not (vt == "null" and template_or_null([el]) != null)) {
                let d = fail_node(n.args[1], "cannot append {describe(vt)} to {first}")
                diag_text(d, "this is {describe(vt)}")
                diag_label(d, node_span(n.args[0]), "{first}")
                diag_hint(d, convert_hint(el, vt, n.args[1]))
            }
        }
        # append and sort give back the list they changed
        if (kind_of(first) == "list") {
            return first
        }
        return "any"
    }
    if (name == "sort" and len(argtypes) == 1 and kind_of(first) == "list") {
        return first
    }
    # reverse and slice of a list give a list (of the same element type, below)
    if ((name == "reverse" or name == "slice") and kind_of(first) == "list" and el == null) {
        return "list"
    }
    if (name == "map_set" and len(argtypes) == 3 and kind_of(first) == "map") {
        grow_list(n.args[0], first, argtypes[2])
    }
    # alloc(Player(...)) makes a template or bloc by hand: it is used as that type
    if (name == "alloc" and len(argtypes) == 1 and object_def(first) != null) {
        return first
    }
    # slice and reverse of a string give a string; the element-wise list operations give the list type
    if ((name == "slice" or name == "reverse") and first == "string") {
        return "string"
    }
    if ((name == "vec_add" or name == "vec_sub" or name == "vec_mul" or name == "vec_div" or name == "mat_mul") and kind_of(first) == "list") {
        return first
    }
    # filter keeps the items it is given; debug gives back its value
    if ((name == "filter" and kind_of(first) == "list") or (name == "debug" and len(argtypes) == 1)) {
        return first
    }
    # Results that follow the element type of the first argument.
    if (el != null and kind_of(first) == "map" and (name == "map_get" or name == "map_values")) {
        if (name == "map_values") {
            return "list<{el}>"
        }
        if (len(argtypes) == 2 or (len(argtypes) == 3 and settle(argtypes[2]) == el)) {
            return el
        }
        # map_get(m, key, null) of a map whose values may be empty (a string, a list, a template, ...)
        if (len(argtypes) == 3 and argtypes[2] == "null" and nullable_or_null([el, "null"]) == el) {
            return el
        }
        if (len(argtypes) == 3 and argtypes[2] == "null" and template_or_null([el]) == el) {
            return el
        }
    }
    if (el != null and kind_of(first) == "list" and name == "remove" and len(argtypes) == 2) {
        return el
    }
    let result = "any"
    if (map_has(SIGS, name)) {
        if (strict_on()) {
            ck_strict_args(n, name, SIGS[name], argtypes)
        }
        result = ck_builtin_call(n, name, SIGS[name], argtypes)
    } else if (map_has(RESULTS, name)) {
        result = RESULTS[name]
    }
    if (el == null) {
        return result
    }
    if (kind_of(first) == "list") {
        if (name == "remove" and len(argtypes) == 2) {
            return el
        }
        if ((name == "min" or name == "max" or name == "sum") and len(argtypes) == 1 and (el == "int" or el == "float")) {
            return el
        }
        if ((name == "reverse" or name == "slice") and (len(argtypes) == 1 or len(argtypes) == 3)) {
            return first
        }
    }
    if (kind_of(first) == "map" and name == "map_values") {
        return "list<{el}>"
    }
    return result
}

# The index of the innermost scope that declares name, or -1.
func scope_index(name: string) -> int {
    let i = len(SCOPES) - 1
    while (i >= 0) {
        if (map_has(SCOPES[i].types, name)) {
            return i
        }
        i -= 1
    }
    return -1
}

# The index of the innermost scope that holds the function node of name, or -1.
func fn_index(name: string) -> int {
    let i = len(SCOPES) - 1
    while (i >= 0) {
        if (map_has(SCOPES[i].fns, name)) {
            return i
        }
        i -= 1
    }
    return -1
}

# The index of the innermost scope that holds the file name was imported from, or -1.
func home_index(name: string) -> int {
    let i = len(SCOPES) - 1
    while (i >= 0) {
        if (map_has(SCOPES[i].homes, name)) {
            return i
        }
        i -= 1
    }
    return -1
}

# The index of the innermost scope that notes whether list name started empty, or -1.
func empty_index(name: string) -> int {
    let i = len(SCOPES) - 1
    while (i >= 0) {
        if (map_has(SCOPES[i].empties, name)) {
            return i
        }
        i -= 1
    }
    return -1
}

# The type a function returns: the common type of its return statements.
func join_returns(rets: list<string>) -> string {
    if (len(rets) == 0) {
        return "null"
    }
    # A template value may be empty: returns of one template type and of null give that type.
    let tt = template_or_null(rets)
    if (tt != null) {
        return tt
    }
    # So may a string, a list, a map or a function: returns of one such type and of null give that type.
    let nt = nullable_or_null(rets)
    if (nt != null) {
        return nt
    }
    let t = rets[0]
    for (let r in rets) {
        if (r != t) {
            if (kind_of(r) == kind_of(t) and (kind_of(t) == "list" or kind_of(t) == "map")) {
                t = kind_of(t)
            } else {
                return "any"
            }
        }
    }
    return t
}

# Checks the body of fn with its parameters bound to the argument types of this call, and returns
# the type the call has. The body sees the scopes the function was defined in, not the caller's.
# "s" for a count other than one.
func s_if(count: int) -> string {
    if (count == 1) {
        return ""
    }
    return "s"
}

# The place of the type written for parameter i of fn, or null.
func ptype_span(fn: Node, i: int) -> Span {
    if (fn.tspans == null) {
        return null
    }
    return fn.tspans[i]
}

# The place of parameter i of fn, or null.
func param_span(fn: Node, i: int) -> Span {
    if (fn.pspans == null) {
        return null
    }
    return fn.pspans[i]
}

func ck_user_call(name: string, fn: Node, idx: int, argtypes: list<string>, call: Node, home: CkFile = null, fixed: bool = false) -> string {
    let argnodes = call.args
    let line = call.line
    let np = len(fn.params)
    let required = 0
    for (let d in fn.defaults) {
        if (d == null) {
            required += 1
        }
    }
    if (len(argtypes) < required or len(argtypes) > np) {
        let wanted = "{np}"
        if (required != np) {
            wanted = "{required} to {np}"
        }
        let plural = "s"
        if (wanted == "1") {
            plural = ""
        }
        let d = fail_at(args_span(call), "{name}() expects {wanted} argument{plural}, but got {len(argtypes)}")
        diag_text(d, "found {len(argtypes)}")
        if (home == null) {
            diag_label(d, fn.nspan, "{name} is defined here with {np} parameter{s_if(np)}")
            diag_hint(d, "Usage: {name}({join(fn.params, ", ")})")
        } else {
            diag_hint(d, "Usage: {name}({join(fn.params, ", ")}), defined in {home.canon} at line {fn.line}")
        }
        return "any"
    }
    let types: list<string> = []
    for (let i = 0; i < np; i++) {
        let want = null
        if (fn.ptypes != null and fn.ptypes[i] != "") {
            want = sig_annot(fn.ptypes[i], span_or(ptype_span(fn, i), fn), home)
        }
        if (i < len(argtypes) and argtypes[i] != "absent") {
            let at = argtypes[i]
            if (want != null) {
                # fixed: the types come from where a function value is used (the items of a list given to
                # map), not from expressions that a literal could adapt in
                if (not fixed) {
                    strict_known(at, argnodes[i], "argument {i + 1} of {name}()")
                    at = adapt_expr(argnodes[i], at, want)
                }
                # a parameter of a template type may be given an empty value, as a field of that type may
                if (not fits_slot(at, want) and not (at == "null" and template_or_null([want]) != null)) {
                    let d = fail_node(argnodes[i], "{name}() argument {i + 1} must be {article(want)} {want}, got {describe(at)}")
                    diag_text(d, "expected {want}, found {describe(at)}")
                    if (home == null) {
                        diag_label(d, ptype_span(fn, i), "parameter '{fn.params[i]}' is {want}")
                        diag_hint(d, convert_hint(want, at, argnodes[i]))
                    } else {
                        let ch = convert_hint(want, at, argnodes[i])
                        if (ch != "") {
                            ch = "{ch}. "
                        }
                        diag_hint(d, "{ch}{name} is defined in {home.canon} at line {fn.line}, with '{fn.params[i]}' a {want}")
                    }
                }
                at = want
            }
            append(types, settle(at))
        } else if (want != null) {
            append(types, want)
        } else {
            append(types, settle(ck_expr(fn.defaults[i])))
        }
    }
    let sep = ","
    let mkey = "{name}({join(types, sep)}){captured_types(fn, idx)}"
    if (home != null) {
        mkey = "{home.canon}:{mkey}"
    }
    # A check made while strict mode is silent (GENERIC) does not stand for one that reports.
    if (GENERIC > 0) {
        mkey = "{mkey}|generic"
    }
    if (map_has(MEMO, mkey)) {
        if (home == null) {
            spec_site(call, fn, idx, types, MEMO[mkey])
        }
        return MEMO[mkey]
    }
    if (map_has(INPROG, mkey) and fn.rtype != null) {
        return sig_annot(fn.rtype, span_or(fn.rspan, fn), home)
    }
    if (map_has(INPROG, mkey)) {
        RECURSIVE[mkey] = true
        if (map_has(ASSUME, mkey)) {
            if (home == null) {
                spec_site(call, fn, idx, types, ASSUME[mkey])
            }
            return ASSUME[mkey]
        }
        return "any"
    }
    INPROG[mkey] = true
    # A function that calls itself: while its body is first checked, the result of the call to itself is not
    # known yet, so that pass reports only proven errors (strict mode is silent, as for an untyped parameter).
    # Once the result type is settled, one more pass reports what strict mode finds, with the calls to
    # itself of that type.
    let selfcall = calls_itself(fn, name)
    let reporting = strict_on()
    if (selfcall) {
        GENERIC += 1
    }
    let rets1 = check_body(name, fn, idx, types, line, home)
    if (selfcall) {
        GENERIC -= 1
    }
    let result = join_returns(rets1)
    if (fn.rtype != null) {
        result = sig_annot(fn.rtype, span_or(fn.rspan, fn), home)
    }
    if (map_has(RECURSIVE, mkey) and not is_scalar(result)) {
        result = try_assume(name, fn, idx, types, line, mkey, rets1, result, home)
    }
    if (selfcall and reporting) {
        # the calls to itself have the settled type, or else the type of the returns that do not recurse,
        # so that a mistake in using them is reported as what it is
        let assumed = result
        if (assumed == "any") {
            assumed = common_scalar(rets1)
        }
        if (assumed != null and assumed != "any") {
            ASSUME[mkey] = assumed
        }
        check_body(name, fn, idx, types, line, home)
        map_delete(ASSUME, mkey)
    }
    MEMO[mkey] = result
    if (LOG != null) {
        append(LOG.memos, mkey)
    }
    map_delete(INPROG, mkey)
    if (home == null) {
        spec_site(call, fn, idx, types, result)
    }
    return result
}

# The names a function's body uses, by the place of the function.
let BODY_NAMES: map<list<string>> = {}

# For a function declared inside another (scope idx above 0), the types of the names its body takes
# from the enclosing functions, as text for the check's key: the same function checked inside two
# calls of its parent can see a captured variable with two types, so the two checks are not the same.
func captured_types(fn: Node, idx: int) -> string {
    if (idx == 0) {
        return ""
    }
    let key = "{ST.src_file}:{fn.line}:{fn.col}"
    if (not map_has(BODY_NAMES, key)) {
        let seen: map<bool> = {}
        let names: list<string> = []
        for (let x in nodes_under(fn.body)) {
            if (x.k == "id" and not map_has(seen, x.name)) {
                seen[x.name] = true
                append(names, x.name)
            }
        }
        BODY_NAMES[key] = names
    }
    let parts: list<string> = []
    for (let name in BODY_NAMES[key]) {
        if (contains(fn.params, name)) {
            continue
        }
        let j = idx
        while (j >= 1) {
            if (map_has(SCOPES[j].types, name)) {
                append(parts, "{name}={SCOPES[j].types[name]}")
                break
            }
            j -= 1
        }
    }
    if (len(parts) == 0) {
        return ""
    }
    return "[{join(parts, ",")}]"
}

# Whether the body of fn calls name, the name fn has where it is called.
let SELF_CALLS: map<bool> = {}

func calls_itself(fn: Node, name: string) -> bool {
    let key = "{fn.line}:{fn.col}:{name}"
    if (not map_has(SELF_CALLS, key)) {
        let found = false
        for (let x in nodes_under(fn.body)) {
            if (x.k == "call" and x.callee.k == "id" and x.callee.name == name) {
                found = true
            }
        }
        SELF_CALLS[key] = found
    }
    return SELF_CALLS[key]
}

# A type written in the signature of a function: read in its own file (home) when it is another file's.
# An unknown name there was reported when that file was checked.
func sig_annot(text: string, span: Span, home: CkFile) -> string {
    if (home == null) {
        return annot(text, span, true)
    }
    return annot_in(text, span, false, home.typedefs)
}

# Whether every way through stmts ends in a return.
func always_returns(stmts: list<Node>) -> bool {
    if (len(stmts) == 0) {
        return false
    }
    let last = stmts[len(stmts) - 1]
    if (last.k == "return") {
        return true
    }

    if (last.k == "if") {
        return len(last.els) > 0 and always_returns(last.then) and always_returns(last.els)
    }
    if (last.k == "block") {
        return always_returns(last.body)
    }
    if (last.k == "switch") {
        return switch_ends(last, false)
    }
    return false
}

# Whether every way through switch n ends in a return (or, with exits, a call of exit): it has a default,
# and each case and the default end so, with no break that would leave the switch first.
func switch_ends(n: Node, exits: bool) -> bool {
    if (n.dflt == null or len(n.dflt) == 0) {
        return false
    }
    let bodies: list<list<Node>> = [n.dflt]
    for (let c in n.cases) {
        append(bodies, c.body)
    }
    for (let body in bodies) {
        for (let x in nodes_under(body)) {
            if (x.k == "break") {
                return false
            }
        }
        if (exits and not returns_or_exits(body)) {
            return false
        }
        if (not exits and not always_returns(body)) {
            return false
        }
    }
    return true
}

# Whether every way through stmts ends in a return or a call of exit: no way gives null. (A direct call
# needs a return on every way, see spec_site, so always_returns does not count exit.)
func returns_or_exits(stmts: list<Node>) -> bool {
    if (len(stmts) == 0) {
        return false
    }
    let last = stmts[len(stmts) - 1]
    if (last.k == "return") {
        return true
    }
    # exit(...) ends the program (when exit is the builtin)
    if (last.k == "call" and last.callee.k == "id" and last.callee.name == "exit" and lookup("exit") == null) {
        return true
    }

    if (last.k == "if") {
        return len(last.els) > 0 and returns_or_exits(last.then) and returns_or_exits(last.els)
    }
    if (last.k == "block" or last.k == "unsafe") {
        return returns_or_exits(last.body)
    }
    if (last.k == "switch") {
        return switch_ends(last, true)
    }
    return false
}

# Marks a call of a user function that can be made directly: the function is defined at the top of its
# module, takes no default values, its parameters and its result are int, float or bool, and every
# way through its body returns. The emitter decides the rest (see emit_llvm.zu).
func spec_site(call: Node, fn: Node, idx: int, types: list<string>, result: string) {
    if (call == null or call.k != "call") {
        return null
    }
    let ok = idx == 0 and is_scalar(result) and len(call.args) == len(fn.params) and len(types) == len(fn.params)
    if (ok) {
        for (let d in fn.defaults) {
            if (d != null) {
                ok = false
            }
        }
        for (let t in types) {
            if (not is_scalar(t)) {
                ok = false
            }
        }
        if (not always_returns(fn.body)) {
            ok = false
        }
    }
    if (ok) {
        mark_spec(call, "{join(types, ",")}>{result}")
    }
}

func is_scalar(t: string) -> bool {
    return t == "int" or t == "float" or t == "bool"
}

# Checks the body of fn with its parameters bound to types, and returns the types of its return statements.
func check_body(name: string, fn: Node, idx: int, types: list<string>, line: int, home: CkFile = null) -> list<string> {
    let caller_file = ST.src_file
    let saved = SCOPES
    let saved_ctx: FileState = null
    if (home == null) {
        SCOPES = cut(saved, 0, idx + 1)
    } else {
        saved_ctx = enter_file(home)
    }
    push_scope()
    for (let i = 0; i < len(fn.params); i++) {
        declare(fn.params[i], types[i], param_span(fn, i))
    }
    let body = "{ST.src_file}:{fn.line}:{fn.col}:{name}"
    let key = join(types, ",")
    if (not map_has(BODY_SIGS, body)) {
        BODY_SIGS[body] = []
    }
    if (not contains(BODY_SIGS[body], key)) {
        append(BODY_SIGS[body], key)
    }
    append(CALLS, Call(name, types, line, body, caller_file))
    let none: list<string> = []
    append(RETS, none)
    push_result_type(fn)
    ck_block(fn.body)
    remove(RESULT_TYPES, len(RESULT_TYPES) - 1)
    let rets = remove(RETS, len(RETS) - 1)
    # A way through the body that does not end in a return gives null.
    if (not returns_or_exits(fn.body)) {
        append(rets, "null")
    }
    remove(CALLS, len(CALLS) - 1)
    if (saved_ctx != null) {
        leave_file(saved_ctx)
    }
    SCOPES = saved
    return rets
}

# The one type of rets other than null when it is a type whose values may be empty (string, list, map,
# function), with at least one null among rets; else null. int, float, bool and char are never empty.
func nullable_or_null(rets: list<string>) {
    let t = null
    let nulls = 0
    for (let r in rets) {
        if (r == "null") {
            nulls += 1
            continue
        }
        let k = kind_of(r)
        if (k != "string" and k != "list" and k != "map" and k != "function") {
            return null
        }
        if (t == null) {
            t = r
        } else if (t != r) {
            return null
        }
    }
    if (nulls == 0) {
        return null
    }
    return t
}

# The one template type of rets when every other item is null, or null.
func template_or_null(rets: list<string>) {
    let t = null
    for (let r in rets) {
        if (r == "null") {
            continue
        }
        let od = object_def(r)
        if (od == null or od.is_template != true) {
            return null
        }
        if (t == null) {
            t = r
        } else if (t != r) {
            return null
        }
    }
    return t
}

# The type all the returns that do not depend on the recursion agree on, or null. A template type
# may come with null returns (an empty value).
func common_scalar(rets: list<string>) {
    let tt = template_or_null(without_any(rets))
    if (tt != null) {
        return tt
    }
    let t = null
    for (let r in rets) {
        if (r == "any") {
            continue
        }
        if (r == "null" or r == "unset") {
            return null
        }
        if (t == null) {
            t = r
        } else if (t != r) {
            return null
        }
    }
    return t
}

func without_any(rets: list<string>) -> list<string> {
    let out: list<string> = []
    for (let r in rets) {
        if (r != "any") {
            append(out, r)
        }
    }
    return out
}

# The second pass of a recursive function: checks the body again with the recursive calls typed as the
# type its other returns have. Returns that type if every return has it, else first (the first pass).
func try_assume(name: string, fn: Node, idx: int, types: list<string>, line: int, mkey: string, rets1: list<string>, first: string, home: CkFile = null) -> string {
    let cand = common_scalar(rets1)
    if (cand == null) {
        return first
    }
    let saved_log = LOG
    LOG = Log([], [])
    ASSUME[mkey] = cand
    QUIET += 1
    let hits = QUIET_HITS
    let rets = check_body(name, fn, idx, types, line, home)
    QUIET -= 1
    map_delete(ASSUME, mkey)
    if (QUIET_HITS == hits and join_returns(rets) == cand) {
        if (saved_log != null) {
            for (let e in LOG.marks) {
                append(saved_log.marks, e)
            }
            for (let k in LOG.memos) {
                append(saved_log.memos, k)
            }
        }
        LOG = saved_log
        return cand
    }
    undo_marks(LOG.marks)
    for (let k in LOG.memos) {
        map_delete(MEMO, k)
    }
    LOG = saved_log
    return first
}

# The default value of typed parameter i of fn (of type dt) must fit the parameter's type want, as an
# argument must. A whole-number literal becomes a float where the parameter is a float.
func ck_default(fn: Node, i: int, dt: string, want: string) {
    let dn = fn.defaults[i]
    strict_known(dt, dn, "the default value of '{fn.params[i]}'")
    let at = adapt_expr(dn, dt, want)
    if (not fits_slot(at, want) and not (at == "null" and template_or_null([want]) != null)) {
        let d = fail_node(dn, "the default value of parameter '{fn.params[i]}' must be {article(want)} {want}, got {describe(at)}")
        diag_text(d, "expected {want}, found {describe(at)}")
        diag_label(d, ptype_span(fn, i), "parameter '{fn.params[i]}' is {want}")
        diag_hint(d, convert_hint(want, at, dn))
    }
}

# A named function is checked for the argument types of each call, so an untyped parameter of it is
# known where the function is used. A function value (func without a name) is called through
# variables the checker does not follow, so in strict mode its parameters need types.
func ck_func(n: Node) {
    if (n.name != null and map_has(ASSIGNED, n.name)) {
        RT_PARAM_CHECKS["{CUR_CANON}:{n.line}:{n.col}"] = true
    }
    let untyped = false
    for (let i = 0; i < len(n.params); i++) {
        if (n.ptypes == null or n.ptypes[i] == "") {
            untyped = true
            if (strict_on() and n.name == null) {
                let d = fail_at(span_or(param_span(n, i), n), "strict mode: parameter '{n.params[i]}' of this function value needs a type, for example {n.params[i]}: int")
                diag_text(d, "needs a type")
                diag_hint(d, "A function declared with a name is checked for the types of each call; a function value is not")
            }
        }
    }
    if (untyped and n.name != null) {
        GENERIC += 1
    }
    push_result_type(n)
    let none: list<string> = []
    append(RETS, none)
    push_scope()
    for (let i = 0; i < len(n.params); i++) {
        let dt = ""
        if (n.defaults[i] != null) {
            dt = ck_expr(n.defaults[i])
        }
        if (n.ptypes != null and n.ptypes[i] != "") {
            let want = annot(n.ptypes[i], span_or(ptype_span(n, i), n), true)
            if (n.defaults[i] != null) {
                ck_default(n, i, dt, want)
            }
            declare(n.params[i], want, param_span(n, i))
        } else {
            declare(n.params[i], "any", param_span(n, i))
        }
    }
    ck_block(n.body)
    pop_scope()
    remove(RETS, len(RETS) - 1)
    remove(RESULT_TYPES, len(RESULT_TYPES) - 1)
    check_result_paths(n)
    if (untyped and n.name != null) {
        GENERIC -= 1
    }
}

func ck_expr(n: Node) -> string {
    let k = n.k
    if (k == "absent") {
        # a parameter with a default that a call with named arguments leaves out (named_args.zu)
        return "absent"
    }
    if (k == "num") {
        if (len(CALLS) > 0 and n.ads != null and map_get(n.ads, call_key(), null) == "float") {
            return "float"
        }
        return "int~"
    }
    if (k == "float") {
        return "float~"
    }
    if (k == "str") {
        return "string"
    }
    if (k == "tmpl") {
        for (let part in n.parts) {
            if (part.k != "text") {
                ck_expr(part)
            }
        }
        return "string"
    }
    if (k == "char") {
        return "char"
    }
    if (k == "bool") {
        return "bool"
    }
    if (k == "id") {
        if (n.name == "null") {
            return "null"
        }
        let t = lookup(n.name)
        if (t == null and check_name(n, "Variable")) {
            return "any"
        }
        if (t == null or t == "unset") {
            return "any"
        }
        if (t == "function" and not map_has(FN_ARG_OK, node_key(n))) {
            let fn = named_fn(n.name)
            if (fn != null and untyped_param(fn) != "") {
                if (strict_on()) {
                    fn_value_error(n, fn, "used as a value")
                }
            } else if (fn != null) {
                # its calls through the value are not checked here: the function checks its parameters
                let fidx = fn_index(n.name)
                let canon = CUR_CANON
                if (home_index(n.name) == fidx) {
                    canon = SCOPES[fidx].homes[n.name].canon
                }
                RT_PARAM_CHECKS["{canon}:{fn.line}:{fn.col}"] = true
            }
        }
        return t
    }
    if (k == "list") {
        let ts: list<string> = []
        for (let item in n.items) {
            append(ts, ck_expr(item))
        }
        let e = common_elem(ts)
        if (e == null) {
            return "list"
        }
        return "list<{e}>"
    }
    if (k == "map") {
        let ts: list<string> = []
        for (let v in n.vals) {
            append(ts, ck_expr(v))
        }
        let e = common_elem(ts)
        if (e == null) {
            return "map"
        }
        return "map<{e}>"
    }
    if (k == "func") {
        ck_func(n)
        return "function"
    }
    if (k == "call") {
        return ck_call(n)
    }
    if (k == "index") {
        let t = ck_expr(n.target)
        strict_known(t, n.target, "the value being indexed")
        ck_index(t, ck_expr(n.index), n.index)
        if (t == "string") {
            return "char"
        }
        # a byte of a box
        if (t == "box") {
            return "int"
        }
        # p["x"] reads the field x of a bloc, template or data value
        let od = object_def(t)
        if (od != null and n.index.k == "str") {
            let fi = field_index(od, n.index.v)
            if (fi >= 0) {
                return object_field_type(od, t, fi)
            }
        }
        let el = elem_of(t)
        if (el != null) {
            return el
        }
        return "any"
    }
    if (k == "slice") {
        let t = ck_expr(n.target)
        strict_known(t, n.target, "the value being sliced")
        for (let bound in [n.lo, n.hi]) {
            if (bound != null) {
                let bt = ck_expr(bound)
                if (bt != "any" and bt != "int" and bt != "int~") {
                    let d = fail_node(bound, "slice position must be an int, got {describe(bt)}")
                    diag_text(d, "this is {describe(bt)}")
                    diag_hint(d, "A slice position is a whole number counting from 0, both ends included")
                }
            }
        }
        if (t == "string" or kind_of(t) == "list") {
            return t
        }
        if (t != "any") {
            let d = fail_node(n.target, "cannot slice {describe(t)}")
            diag_text(d, "this is {describe(t)}")
            diag_hint(d, "Only a string or a list can be sliced")
        }
        return "any"
    }
    if (k == "field") {
        let ft = ck_expr(n.target)
        strict_known(ft, n.target, "the value whose field '{n.field}' is read")
        let td = object_def(ft)
        if (td != null) {
            let fi = field_index(td, n.field)
            if (fi >= 0) {
                return object_field_type(td, ft, fi)
            }
        }
        if (ft == "box" and (n.field == "len" or n.field == "cap")) {
            return "int"
        }
        # m.key reads the key "key" of a map
        if (kind_of(ft) == "map" and elem_of(ft) != null) {
            return elem_of(ft)
        }
        return "any"
    }
    if (k == "incdec") {
        let t = lookup(n.name)
        if (t == null and not map_has(BUILTIN_NAMES, n.name)) {
            append(PENDING, Pending(span_or(n.nspan, n), n.name, "Variable", cut(SCOPES, 0, len(SCOPES))))
            return "any"
        }
        if (t != null and t != "any" and t != "unset" and t != "int" and t != "float") {
            let d = fail_node(n, "cannot use '{n.op}' on {n.name}, which is {t}")
            diag_text(d, "{n.name} is {t}")
            diag_label(d, type_origin(n.name), "{n.name} became {t} here")
            diag_hint(d, "'++' and '--' work on an int or a float variable")
            return "any"
        }
        if (t == null or t == "unset") {
            return "any"
        }
        return t
    }
    if (k == "not") {
        let t = ck_expr(n.e)
        strict_known(t, n.e, "the operand of 'not'")
        if (t != "any" and t != "bool") {
            let d = fail_node(n.e, "'not' needs a bool, got {describe(t)}")
            diag_text(d, "this is {describe(t)}")
            diag_hint(d, "Use a comparison, for example not (x == 0)")
        }
        return "bool"
    }
    if (k == "bin") {
        return ck_bin(n)
    }
    if (k == "box") {
        ck_expr(n.size)
        return "box"
    }
    return "any"
}

# Statements

func declare_func(n: Node) {
    declare(n.name, "function")
    declare_fn(n.name, n)
}

func ck_cond(e: Node, what: string) {
    let t = ck_expr(e)
    strict_known(t, e, "the condition of {what}")
    if (t != "any" and t != "bool") {
        let d = fail_node(e, "{what} needs a bool, got {describe(t)}")
        diag_text(d, "this is {describe(t)}")
        diag_hint(d, "A condition must be true or false: compare with ==, != or <, for example x != 0 or len(s) > 0")
    }
}

func ck_assign(n: Node) {
    let et = ck_expr(n.e)
    let s = scope_of(n.name)
    if (s == null) {
        if (not map_has(BUILTIN_NAMES, n.name)) {
            append(PENDING, Pending(span_or(n.nspan, n), n.name, "Variable", cut(SCOPES, 0, len(SCOPES))))
        }
        return null
    }
    let vt = s[n.name]
    if (vt == "unset") {
        s[n.name] = settle(et)
        SCOPES[scope_index(n.name)].origins[n.name] = node_span(n.e)
        return null
    }
    # a variable of a template type may be emptied, as a field of that type may
    if (et == "null" and template_or_null([vt]) != null) {
        return null
    }
    strict_known(et, n.e, "the value assigned to '{n.name}'")
    et = adapt_expr(n.e, et, vt)
    if (not fits_slot(et, vt)) {
        let hint = ""
        if (vt == "float" and et == "int~") {
            hint = ". Write the number with a decimal point, for example 2.0"
        }
        let d = fail_node(n.e, "cannot assign {describe(et)} to '{n.name}', which is {vt}{hint}")
        diag_text(d, "this is {describe(et)}")
        diag_label(d, n.nspan, "'{n.name}' is {vt}")
        diag_label(d, type_origin(n.name), "'{n.name}' became {vt} here")
        let how = convert_hint(vt, et, n.e)
        if (len(how) == 0) {
            how = "Use another variable for the new value"
        }
        diag_hint(d, "A variable keeps the type of its first value. " + how)
    }
    return null
}

# let name: type = init. The declared type decides the variable's type.
func ck_typed_let(n: Node) {
    let at = annot(n.type, span_or(n.tspan, n), true)
    if (n.init != null) {
        let et = adapt_expr(n.init, ck_expr(n.init), at)
        # a value whose type the checker cannot tell (recv(ch), an item of a mixed list) is given its type
        # here, and the program checks it when it runs
        if (et == "any") {
            n.chk = "1"
        }
        # A variable declared int, float or bool holds a raw machine value, which null is not.
        if (et == "null" and is_scalar(at)) {
            let d = fail_node(n.init, "cannot assign null to '{n.name}', which is {at}")
            diag_text(d, "this is null")
            diag_label(d, n.tspan, "'{n.name}' is declared {at}")
            diag_hint(d, "Give the variable a value of its type, or declare it without a type")
        } else if (et != "null" and not fits_slot(et, at)) {
            let hint = ""
            if (at == "float" and et == "int~") {
                hint = ". Write the number with a decimal point, for example 2.0"
            }
            let d = fail_node(n.init, "cannot assign {describe(et)} to '{n.name}', which is {at}{hint}")
            diag_text(d, "this is {describe(et)}")
            diag_label(d, n.tspan, "'{n.name}' is declared {at}")
            diag_hint(d, convert_hint(at, et, n.init))
        }
    }
    declare(n.name, at, n.tspan)
    mark_sty(n, at)
}

func ck_stmt(n: Node) {
    let k = n.k
    if (k == "let") {
        if (n.orelse != null) {
            # let n = s as int else { ... }: the block runs where n has no value yet
            push_scope()
            ck_block(n.orelse)
            pop_scope()
        }
        if (n.type != null) {
            ck_typed_let(n)
        } else if (n.init == null) {
            declare(n.name, "unset")
        } else {
            let it = settle(ck_expr(n.init))
            strict_known(it, n.init, "the value given to '{n.name}'")
            if (it == "any" and error_inside(n.init)) {
                # its value had an error: a use of the variable is not reported again as unknown
                BAD_IMPORTS[n.name] = true
            }
            if (it == "null") {
                # A variable that starts as null takes the type of its first real value.
                it = "unset"
            }
            declare(n.name, it, node_span(n.init))
            if ((n.init.k == "list" and len(n.init.items) == 0) or (n.init.k == "map" and len(n.init.keys) == 0)) {
                declare_empty(n.name, n)
            } else if (empty_index(n.name) == len(SCOPES) - 1) {
                declare_empty(n.name, null)
            }
            mark_sty(n, it)
        }
    } else if (k == "group") {
        for (let item in n.items) {
            ck_stmt(item)
        }
    } else if (k == "assign") {
        ck_assign(n)
    } else if (k == "func") {
        if (n.name != null) {
            declare_func(n)
        }
        ck_func(n)
    } else if (k == "if" and n.cond.k == "let") {
        # if (let n = s as int): n exists in the first block, with the type of the conversion
        let it = settle(ck_expr(n.cond.init))
        strict_known(it, n.cond.init, "the value given to '{n.cond.name}'")
        push_scope()
        declare(n.cond.name, it, node_span(n.cond.init))
        mark_sty(n.cond, it)
        ck_block(n.then)
        pop_scope()
        push_scope()
        ck_block(n.els)
        pop_scope()
    } else if (k == "if") {
        let dead = dead_branch(n.cond)
        ck_cond(n.cond, "'if'")
        if (dead != "then") {
            push_scope()
            ck_block(n.then)
            pop_scope()
        }
        if (dead != "else") {
            push_scope()
            ck_block(n.els)
            pop_scope()
        }
    } else if (k == "while") {
        ck_cond(n.cond, "'while'")
        push_scope()
        ck_block(n.body)
        pop_scope()
    } else if (k == "for") {
        push_scope()
        if (n.init != null) {
            ck_stmt(n.init)
        }
        if (n.cond != null) {
            ck_cond(n.cond, "'for'")
        }
        if (n.incr != null) {
            ck_stmt(n.incr)
        }
        push_scope()
        ck_block(n.body)
        pop_scope()
        pop_scope()
    } else if (k == "forin") {
        let t = ck_expr(n.iter)
        push_scope()
        if (t == "string") {
            declare(n.name, "char")
            mark_sty(n, "char")
        } else if (kind_of(t) == "list" and elem_of(t) != null) {
            declare(n.name, elem_of(t))
            mark_sty(n, elem_of(t))
        } else {
            declare(n.name, "any")
            mark_sty(n, "any")
        }
        ck_block(n.body)
        pop_scope()
    } else if (k == "switch") {
        ck_expr(n.e)
        for (let c in n.cases) {
            ck_expr(c.e)
            push_scope()
            ck_block(c.body)
            pop_scope()
        }
        push_scope()
        ck_block(n.dflt)
        pop_scope()
    } else if (k == "return") {
        let rt = "null"
        if (n.e != null) {
            rt = settle(ck_expr(n.e))
        }
        rt = check_result(n, rt)
        if (len(RETS) > 0) {
            append(RETS[len(RETS) - 1], rt)
        }
    } else if (k == "setidx") {
        let tt = ck_expr(n.target)
        ck_index(tt, ck_expr(n.index), n.index)
        let et = ck_expr(n.e)
        let el = elem_of(tt)
        # a[i] += 1 on a list of floats: the literal is a float.
        if (n.op != null and el == "float" and et == "int~") {
            et = adapt_expr(n.e, et, "float")
        }
        let od = object_def(tt)
        if (od != null and n.op == null and n.index.k == "str") {
            let fi = field_index(od, n.index.v)
            if (fi >= 0) {
                let want = object_field_type(od, tt, fi)
                if (want != "any") {
                    strict_known(et, n.e, "the value stored in field '{od.fields[fi]}'")
                }
                et = adapt_expr(n.e, et, want)
                let empty_ok = et == "null" and od.is_bloc != true
                if (want != "any" and et != "any" and not empty_ok and not fits_slot(et, want)) {
                    let kind = "Template"
                    if (od.is_bloc == true) {
                        kind = "Bloc"
                    }
                    let d = fail_node(n.e, "{kind} '{tt}' field '{od.fields[fi]}' must be {article(want)} {want}, got {describe(et)}")
                    diag_text(d, "expected {want}, found {describe(et)}")
                    if (od.fspans != null) {
                        diag_label(d, od.fspans[fi], "field '{od.fields[fi]}' of {tt} is {want}")
                    }
                    diag_hint(d, convert_hint(want, et, n.e))
                }
            }
        }
        if (el != null and n.op == null and kind_of(tt) == "list" and grow_list(n.target, tt, et)) {
            # a list that started empty: a value of another type makes it a list of mixed items
            return null
        }
        if (n.op == null and kind_of(tt) == "map" and grow_list(n.target, tt, et)) {
            # a map that started empty takes the type of its first value
            return null
        }
        if (el != null and n.op == null) {
            if (el != "any") {
                strict_known(et, n.e, "the value stored in {tt}")
            }
            et = adapt_expr(n.e, et, el)
            if (not fits_slot(et, el) and not (et == "null" and template_or_null([el]) != null)) {
                let d = fail_node(n.e, "cannot store {describe(et)} in {tt}")
                diag_text(d, "this is {describe(et)}")
                diag_label(d, node_span(n.target), "{tt}")
                let how = convert_hint(el, et, n.e)
                if (len(how) == 0) {
                    how = "A {tt} holds only {el} items"
                }
                diag_hint(d, how)
            }
        }
    } else if (k == "block") {
        push_scope()
        ck_block(n.body)
        pop_scope()
    } else if (k == "unsafe") {
        push_scope()
        ck_block(n.body)
        pop_scope()
    } else if (k == "typedef") {
        declare(n.name, "type")
        note_typedef(n)
    } else if (k == "use") {
        bind_use(n)
    } else if (k == "break" or k == "continue") {
        return null
    } else {
        ck_expr(n)
    }
    return null
}

# Names of functions and types are known before their definition runs.
func ck_hoist(stmts: list<Node>) {
    for (let s in stmts) {
        let k = s.k
        if (k == "func" and s.name != null) {
            declare_func(s)
            HOISTED[s.name] = true
        } else if (k == "typedef") {
            declare(s.name, "type")
            note_typedef(s)
            HOISTED[s.name] = true
        } else if (k == "use") {
            bind_use(s)
            for (let nm in s.names) {
                HOISTED[nm] = true
            }
        } else if (k == "let") {
            HOISTED[s.name] = true
        } else if (k == "group") {
            for (let item in s.items) {
                HOISTED[item.name] = true
            }
        }
    }
}

# The body of a function declared in the block is checked after the block's other statements, so it
# knows the variables the block declares below it (a function at the top of a file that uses a variable
# declared further down).
func ck_block(stmts: list<Node>) {
    ck_hoist(stmts)
    let later: list<Node> = []
    for (let s in stmts) {
        if (s.k == "func" and s.name != null) {
            declare_func(s)
            append(later, s)
            continue
        }
        ck_stmt(s)
        # if (type(x) == "list") { ...; return }: for a list x the rest of the block never runs
        if (s.k == "if" and s.cond.k != "let" and dead_branch(s.cond) == "else" and always_returns(s.then)) {
            break
        }
    }
    for (let f in later) {
        ck_func(f)
    }
}

# The result types written after -> of the functions being checked, innermost last: the type, how to name
# the function and the place of the type; an empty item for a function without one.
template ResultType { t: string, who: string, span: Span }
let RESULT_TYPES: list<ResultType> = []

func push_result_type(fn: Node) {
    if (fn.rtype == null) {
        append(RESULT_TYPES, null)
        return null
    }
    let who = "this function"
    if (fn.name != null) {
        who = "{fn.name}()"
    }
    append(RESULT_TYPES, ResultType(annot(fn.rtype, span_or(fn.rspan, fn), true), who, fn.rspan))
}

# A return in a function with a written result type: the value must fit it; a template result may be
# empty (null). Returns the type the return gives.
func check_result(n: Node, rt: string) -> string {
    if (len(RESULT_TYPES) == 0 or RESULT_TYPES[len(RESULT_TYPES) - 1] == null) {
        return rt
    }
    let r = RESULT_TYPES[len(RESULT_TYPES) - 1]
    let want = r.t
    if (n.e != null) {
        if (want != "any") {
            strict_known(rt, n.e, "the value returned by {r.who}")
        }
        rt = adapt_expr(n.e, rt, want)
    }
    let od = object_def(want)
    let empty_ok = rt == "null" and od != null and od.is_template == true
    if (rt != "any" and want != "any" and not empty_ok and not fits_slot(rt, want)) {
        let at = node_span(n)
        if (n.e != null) {
            at = node_span(n.e)
        }
        let d = fail_at(at, "{r.who} must return {article(want)} {want}, got {describe(rt)}")
        diag_text(d, "this is {describe(rt)}")
        diag_label(d, r.span, "the result is {want}")
        diag_hint(d, convert_hint(want, rt, n.e))
    }
    return want
}

# A function with a written result type that is not a template must return on every way through its body.
func check_result_paths(fn: Node) {
    if (fn.rtype == null or returns_or_exits(fn.body)) {
        return null
    }
    let want = annot(fn.rtype, span_or(fn.rspan, fn), true)
    let od = object_def(want)
    if (want == "any" or want == "null" or (od != null and od.is_template == true)) {
        return null
    }
    let who = "this function"
    if (fn.name != null) {
        who = "{fn.name}()"
    }
    let d = fail_at(span_or(fn.rspan, fn), "{who} must return {article(want)} {want} on every path")
    diag_text(d, "a way through the body ends without a return")
    diag_hint(d, "Add a return at the end of the function, or remove the result type")
}

# The name type(v) gives for a value of checker type t, or null when t does not tell.
func runtime_name(t: string) {
    let k = kind_of(t)
    if (k == "bool") {
        return "boolean"
    }
    if (k == "int" or k == "float" or k == "string" or k == "char" or k == "list" or k == "map" or k == "function") {
        return k
    }
    if (k == "pointer" or k == "channel" or k == "thread" or k == "file" or k == "box") {
        return k
    }
    let od = object_def(t)
    if (od != null and od.is_template == true) {
        return "template"
    }
    if (od != null and od.is_bloc == true) {
        return "bloc"
    }
    return null
}

# For if (type(x) == "string") with the type of x known: "then" when that branch cannot run, "else" when
# the other cannot, else null. A function checked for a list argument then does not count a return
# meant for a string. Also with != and the two sides swapped, and for x == null (see null_branch).
func dead_branch(c: Node) {
    if (c.k != "bin" or (c.op != "==" and c.op != "!=")) {
        return null
    }
    let nb = null_branch(c)
    if (nb != null) {
        return nb
    }
    let call = c.l
    let lit = c.r
    if (call.k == "str") {
        call = c.r
        lit = c.l
    }
    if (lit.k != "str" or call.k != "call" or call.callee.k != "id" or call.callee.name != "type") {
        return null
    }
    if (len(call.args) != 1 or call.args[0].k != "id" or lookup("type") != null) {
        return null
    }
    let t = lookup(call.args[0].name)
    if (t == null) {
        return null
    }
    let rn = runtime_name(t)
    if (rn == null) {
        return null
    }
    let same = rn == lit.v
    if (c.op == "!=") {
        same = not same
    }
    if (same) {
        return "else"
    }
    return "then"
}

# For x == null (or !=, or the sides swapped) where x is a variable that holds null here, as a parameter
# given null by a call does: the branch that cannot run, as dead_branch says, else null.
func null_branch(c: Node) {
    let v = c.l
    let other = c.r
    if (v.k == "id" and v.name == "null") {
        v = c.r
        other = c.l
    }
    if (v.k != "id" or other.k != "id" or other.name != "null" or lookup("null") != null) {
        return null
    }
    if (lookup(v.name) != "null") {
        return null
    }
    if (c.op == "==") {
        return "else"
    }
    return "then"
}

# Records on a let or for-in node the scalar type of its variable, for the code generator to keep
# in a machine register. A node can be checked several times (once per argument-type signature of its
# function); only a type that is the same every time stays, any other becomes "any".
func mark_sty(n: Node, t: string) {
    if (t != "int" and t != "float" and t != "bool") {
        t = "any"
    }
    let old = n.sty
    if (n.sty == null) {
        n.sty = t
    } else if (n.sty != t) {
        n.sty = "any"
    }
    if (LOG != null and n.sty != old) {
        append(LOG.marks, MarkEntry(n, "sty", old, null))
    }
    # The same per signature of the function being checked: its specialized version knows its arguments,
    # so a variable it computes from them can be raw there even where it is not in the ordinary version.
    if (len(CALLS) > 0) {
        let key = join(CALLS[len(CALLS) - 1].types, ",")
        if (n.stys == null) {
            n.stys = {}
        }
        let before = map_get(n.stys, key, null)
        if (before == null) {
            n.stys[key] = t
        } else if (before != t) {
            n.stys[key] = "any"
        }
        if (LOG != null and n.stys[key] != before) {
            append(LOG.marks, MarkEntry(n, "stys", before, key))
        }
    }
}

# Records on a call node a signature the call can be made with directly: the scalar types of the
# arguments and of the result, for example "int,int>int". A call node can be checked several times, with
# different argument types, so the node keeps every signature, separated by ";". The emitter picks the
# one whose argument types it has as raw values.
func mark_spec(n: Node, key: string) {
    let old = n.spec
    if (n.spec == null) {
        n.spec = key
    } else if (not contains(";{n.spec};", ";{key};")) {
        n.spec = "{n.spec};{key}"
    }
    if (LOG != null and n.spec != old) {
        append(LOG.marks, MarkEntry(n, "spec", old, null))
    }
}

# Puts back what a rejected pass changed, the last change first.
func undo_marks(log: list<MarkEntry>) {
    let i = len(log) - 1
    while (i >= 0) {
        let e = log[i]
        if (e.field == "sty") {
            e.n.sty = e.before
        } else if (e.field == "stys" or e.field == "ads") {
            # null was "no entry yet": the entry is removed again
            let table = e.n.stys
            if (e.field == "ads") {
                table = e.n.ads
            }
            if (e.before == null) {
                map_delete(table, e.key)
            } else {
                table[e.key] = e.before
            }
        } else {
            e.n.spec = e.before
        }
        i -= 1
    }
}

# Reports the names that were read or assigned and that nothing in the program declares.
func report_undefined() {
    if (OPEN_IMPORT) {
        return null
    }
    for (let p in PENDING) {
        if (map_has(HOISTED, p.name)) {
            continue
        }
        undefined_error(p.span, p.name, p.what, p.scopes)
    }
    fill_guesses()
}

# Files and imports. Each imported file is checked once, in its own context, when a use statement
# names it. A function it exports keeps that context (its file, its top-level names and types), and a
# call of it is checked there for the argument types of the call, as a function of the same file is.
# So a wrong type passed across files is an error when the program is built, at the call, and an
# error inside the other file names that file.
template CkFile {
    canon: string, lines: list<string>, scopes: list<Scope>, typedefs: map<Node>, assigned: map<bool>,
    hoisted: map<bool>, exports: map<bool>, done: bool
}

# Canonical path -> CkFile, or an empty item for a file that cannot be read.
let FILES: map<CkFile> = {}

# The canonical path of the file being checked.
let CUR_CANON = ""

# The checker state that belongs to one file, so that another file can be checked in between.
template FileState {
    scopes: list<Scope>, typedefs: map<Node>, assigned: map<bool>, hoisted: map<bool>, pending: list<Pending>,
    open: bool, file: string, lines: list<string>, canon: string, calls: list<Call>,
    rets: list<list<string>>
}

func save_file_state() -> FileState {
    return FileState(SCOPES, TYPEDEFS, ASSIGNED, HOISTED, PENDING, OPEN_IMPORT, ST.src_file,
        ST.src_lines, CUR_CANON, CALLS, RETS)
}

func restore_file_state(st: FileState) {
    SCOPES = st.scopes
    TYPEDEFS = st.typedefs
    ASSIGNED = st.assigned
    HOISTED = st.hoisted
    PENDING = st.pending
    OPEN_IMPORT = st.open
    ST.src_file = st.file
    ST.src_lines = st.lines
    CUR_CANON = st.canon
    CALLS = st.calls
    RETS = st.rets
}

# Switches to the context of file cf to check a body of it; leave_file puts the caller's back. The
# calls being checked stay, so an error inside the body shows where it was called from. Names the
# body reads that nothing declares were reported when the file itself was checked.
func enter_file(cf: CkFile) -> FileState {
    let saved = save_file_state()
    SCOPES = cut(cf.scopes, 0, len(cf.scopes))
    TYPEDEFS = cf.typedefs
    ASSIGNED = cf.assigned
    HOISTED = cf.hoisted
    PENDING = []
    OPEN_IMPORT = true
    ST.src_file = cf.canon
    ST.src_lines = cf.lines
    CUR_CANON = cf.canon
    return saved
}

func leave_file(saved: FileState) {
    let calls = CALLS
    let rets = RETS
    restore_file_state(saved)
    CALLS = calls
    RETS = rets
}

# The names a file exports: functions, types and variables, also inside groups.
func collect_file_exports(stmts: list<Node>, out: map<bool>) {
    for (let s in stmts) {
        let k = s.k
        if ((k == "func" or k == "typedef" or k == "let") and s.name != null and s.exported == true) {
            out[s.name] = true
        } else if (k == "group") {
            collect_file_exports(s.items, out)
        }
    }
}

# Checks the file at canon once and returns its CkFile, or null when it cannot be read. While the file is
# being checked its CkFile is not done, so a file that imports it back gets its names as unknown.
func check_file(canon: string) -> CkFile {
    if (map_has(FILES, canon)) {
        return FILES[canon]
    }
    let f = open(canon, "r")
    if (f == null) {
        FILES[canon] = null
        return null
    }
    let text = read(f)
    close(f)
    let saved = save_file_state()
    let lines = split_lines(text)
    ST.src_file = canon
    ST.src_lines = lines
    let stmts = parse_source(text)
    resolve_named_args(stmts, canon)
    let cf = CkFile(canon, lines, [], {}, {}, {}, {}, false)
    FILES[canon] = cf
    collect_file_exports(stmts, cf.exports)
    SCOPES = []
    TYPEDEFS = {}
    ASSIGNED = {}
    HOISTED = {}
    PENDING = []
    OPEN_IMPORT = false
    CUR_CANON = canon
    CALLS = []
    RETS = []
    collect_assigned(stmts)
    push_scope()
    ck_block(stmts)
    report_undefined()
    cf.scopes = SCOPES
    cf.typedefs = TYPEDEFS
    cf.assigned = ASSIGNED
    cf.hoisted = HOISTED
    cf.done = true
    restore_file_state(saved)
    return cf
}

# Declares the names a use statement brings in, with what their file says about them: a function keeps
# its declaration and its file, a type its definition, a variable its type. A name the file does not
# export, or a file that cannot be read or is still being checked, gives unknown names (the code
# generator reports a bad import).
func bind_use(n: Node) {
    let cf: CkFile = null
    if (CUR_CANON != "") {
        cf = check_file(path_norm(path_join(path_dir(CUR_CANON), n.path)))
    }
    let names = n.names
    if (len(names) == 0) {
        OPEN_IMPORT = true
        if (cf == null or not cf.done) {
            return null
        }
        names = map_keys(cf.exports)
    }
    for (let nm in names) {
        if (cf == null or not cf.done or not map_has(cf.exports, nm)) {
            declare(nm, "any")
            if (cf != null and cf.done) {
                # the code generator reports the import; strict mode does not also report the unknown type
                BAD_IMPORTS[nm] = true
            }
            continue
        }
        let top = cf.scopes[0]
        let t = map_get(top.types, nm, "any")
        if (t == "function") {
            declare(nm, "function")
            declare_fn(nm, top.fns[nm])
            declare_home(nm, cf)
        } else if (t == "type" and map_has(cf.typedefs, nm)) {
            declare(nm, "type")
            TYPEDEFS[nm] = cf.typedefs[nm]
        } else {
            declare(nm, t)
        }
    }
}

# Reports every Type Error it can prove, in source order, and ends the run if there is one.
export func check_program(stmts: list<Node>, canon: string) {
    CUR_CANON = canon
    if (canon != "" and not map_has(FILES, canon)) {
        FILES[canon] = CkFile(canon, ST.src_lines, [], {}, {}, {}, {}, false)
    }
    SCOPES = []
    TYPEDEFS = {}
    MEMO = {}
    INPROG = {}
    CALLS = []
    RETS = []
    REPORTED = {}
    ERROR_SPANS = []
    BAD_IMPORTS = {}
    HOISTED = {}
    PENDING = []
    OPEN_IMPORT = false
    LITERALS = []
    BODY_SIGS = {}
    ASSIGNED = {}
    collect_assigned(stmts)
    push_scope()
    ck_block(stmts)
    pop_scope()
    if (LIST_TYPES_ON[0]) {
        # the main program is checked first, and its check covers the files it imports
        print_list_types()
        LIST_TYPES_ON[0] = false
    }
    report_undefined()
    diag_exit_if_errors()
    settle_literals()
}
