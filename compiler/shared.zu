# shared.zu: tables and counters shared by the compiler modules.

use { ST } from "state.zu"

# Names of the builtin functions. Each one is implemented as lb_<name> in the runtime.
export const BUILTINS = {}
for (let nm in split("len str_len append list_append type int float string code char to_string fixed to_int to_float assert input print debug range args exit system clock map_set map_get map_has map_delete map_keys map_values map_items remove find slice sort map filter reduce is_empty concat substring char_at index_of index_of_any skip_chars last_index_of contains starts_with ends_with to_upper to_lower trim trim_left trim_right replace reverse repeat pad_left pad_right split join is_digit is_alpha is_alnum is_space abs min max clamp sign pow sqrt cbrt exp ln log10 sin cos tan asin acos atan atan2 sinh cosh tanh floor ceil round trunc fract mod floor_div divmod sum mean gcd lcm isqrt lerp deg_to_rad rad_to_deg open close read read_line write file_exists remove_file flush alloc free load deref store ptr_offset ptr_add defer dense_list vec_add vec_sub vec_mul vec_div vec_mul_inline mat_mul rand srand trand shuffle tshuffle ssort shape spawn wait yield channel send recv channel_close", " ")) {
    BUILTINS[nm] = true
}

# Modules being compiled: by canonical path, and in the order they were first seen.
export const MODULES = {}
export const MOD_LIST = []

# A number that has not been used before; names of temporaries and labels are built from it.
export func uid() {
    ST.uid += 1
    return ST.uid
}
