# ll_state.zu: state and small helpers of the LLVM IR backend.
#
# Every Zue value is an LV in memory (%LV = { i64 tag, i64 payload }). An expression
# compiles to the name of a pointer to its LV. Runtime calls that take or return an
# LV go through the pointer entry points (lvp_*) of the runtime, which is written in
# Zue: compiler/runtime/zue_rt_*.zu.

use { uid } from "shared.zu"
use { Ctx, ST } from "state.zu"
use { Node } from "ast_nodes.zu"
use { cut } from "ranges.zu"

export const LL_STRS: list<string> = []        # private string constants
export const LL_STR_IDS: map<string> = {}
export const LL_CONSTS: list<string> = []      # private constant LV values
export const LL_CONST_IDS: map<string> = {}
export const LL_GLOBALS: list<string> = []     # one definition per Zue global
export const LL_MODDECLS: list<string> = []    # per-module state, source tables and descriptors
export const LL_FUNCS: list<string> = []       # finished function bodies
export const LL_KSTRS: list<string> = []       # text of each K[] string constant
export const LL_K_IDS: map<int> = {}
export const LL_ICS: list<int> = []            # one inline cache per field read: a template type and a field index
export const LL_BUILTINS: list<string> = []    # builtin names whose lb_ function is declared
export const LL_BUILTIN_IDS: map<bool> = {}
export const LL_NATIVES: list<string> = []     # builtins called directly: names that need an nf_ global
export const LL_NATIVE_IDS: map<bool> = {}

func ll_hex_digit(n: int) -> char {
    return "0123456789ABCDEF"[n]
}

# Text for an LLVM c"..." constant (without the surrounding quotes).
export func ll_escape(text: string) -> string {
    let parts: list<string> = []
    for (let ch in text) {
        let byte = code(ch)
        if (ch == '"' or ch == '\\' or byte < 32 or byte > 126) {
            let hi = ll_hex_digit(byte / 16)
            let lo = ll_hex_digit(byte % 16)
            append(parts, "\\{hi}{lo}")
        } else {
            append(parts, "{ch}")
        }
    }
    return join(parts, "")
}

# A NUL-terminated string constant; returns its global name.
export func ll_cstr(text: string) -> string {
    let key = "s{text}"
    if (map_has(LL_STR_IDS, key)) {
        return LL_STR_IDS[key]
    }
    let name = "@.s{len(LL_STRS)}"
    append(LL_STRS, "{name} = private unnamed_addr constant [{len(text) + 1} x i8] c\"{ll_escape(text)}\\00\"")
    LL_STR_IDS[key] = name
    return name
}

# A constant LV with the given tag and payload text; returns its global name.
export func ll_const(tag: int, payload: string) -> string {
    let key = "{tag}:{payload}"
    if (map_has(LL_CONST_IDS, key)) {
        return LL_CONST_IDS[key]
    }
    let name = "@.c{len(LL_CONSTS)}"
    append(LL_CONSTS, "{name} = private constant %LV \{ i64 {tag}, i64 {payload} }")
    LL_CONST_IDS[key] = name
    return name
}

export func ll_null() -> string {
    return ll_const(0, "0")
}

export func ll_int(text: string) -> string {
    return ll_const(2, text)
}

# Float literal text such as 3.14, 1e-05 or 2. as the text of an LLVM double constant.
export func ll_float_text(text: string) -> string {
    let t = text
    # Zue has no negative zero: -0.0 is 0.0
    if (starts_with(t, "-")) {
        let nonzero = false
        for (let i = 1; i < len(t) and char_at(t, i) != "e" and char_at(t, i) != "E"; i++) {
            let ch = char_at(t, i)
            if (ch != "0" and ch != ".") {
                nonzero = true
            }
        }
        if (not nonzero) {
            t = cut(t, 1, len(t))
        }
    }
    if (not contains(t, ".")) {
        if (not contains(t, "e") and not contains(t, "E")) {
            t = "{t}.0"
        } else {
            let e = index_of_any(t, "eE")
            let head = cut(t, 0, e)
            let tail = cut(t, e, len(t))
            t = "{head}.0{tail}"
        }
    }
    return t
}

export func ll_float(text: string) -> string {
    return ll_const(3, "bitcast (double {ll_float_text(text)} to i64)")
}

export func ll_char(code: int) -> string {
    return ll_const(4, "{code}")
}

export func ll_bool(b: bool) -> string {
    if (b) {
        return ll_const(1, "1")
    }
    return ll_const(1, "0")
}

# The K[] slot for a string literal, as a constant pointer expression.
export func ll_kstr(text: string) -> string {
    if (not map_has(LL_K_IDS, text)) {
        LL_K_IDS[text] = len(LL_KSTRS)
        append(LL_KSTRS, text)
    }
    let idx = LL_K_IDS[text]
    return "getelementptr inbounds (%LV, ptr @K, i64 {idx})"
}

# The inline cache for one field read, as a constant pointer expression into @ic (two words).
export func ll_ic() -> string {
    append(LL_ICS, 0)
    return "getelementptr inbounds (i64, ptr @ic, i64 {(len(LL_ICS) - 1) * 2})"
}

export func ll_use_builtin(name: string) {
    if (not map_has(LL_BUILTIN_IDS, name)) {
        LL_BUILTIN_IDS[name] = true
        append(LL_BUILTINS, name)
    }
}

# Builtins called with their own LvFunc (nf_<name>) need a global for it.
export func ll_use_native(name: string) {
    ll_use_builtin(name)
    if (not map_has(LL_NATIVE_IDS, name)) {
        LL_NATIVE_IDS[name] = true
        append(LL_NATIVES, name)
    }
}

# Set by --gc=lowmem: the program asks the collector to use less memory and accepts a lower speed.
export const GC_LOWMEM = [false]

# A function that calls can reach directly: its func node, the signatures calls were found for, and the
# name part of its LLVM symbols.
export template SpecEntry { node: Node, sigs: map<bool>, sym: string }

# The SpecEntry of each such function, by "<module id>:<name>". Filled by ll_spec.zu.
export const SPECS: map<SpecEntry> = {}

# Functions the raw-expression code (ll_typed.zu) needs from the statement emitter (emit_llvm.zu), which
# imports it: ex(n) emits an expression and returns the slot of its value; builtin(name, slots) calls a builtin on
# boxed arguments and returns the slot of the result.
export const HOOKS: map<function> = {"generic_call": null, "ex": null, "builtin": null}

export func ll_new_ctx(is_main: bool) -> Ctx {
    return Ctx([], [], [{}], [[]], {}, {}, is_main, -1, [], false, [], false, false, false, 0, {}, null, false, {}, [])
}

# Debug information, for zue build -g: a line table, so that gdb, valgrind and perf name the Zue
# line and function. Metadata nodes are numbered from 5 (0 to 4 are fixed, see dbg_module_text).
# DBG is shared, so that every module sees the same one: whether it is on, the next node number, the
# metadata lines and the node of each file.
template DbgState { on: bool, next: int, lines: list<string>, files: map<int> }
export const DBG = DbgState(false, 5, [], {})

export func dbg_enable() {
    DBG.on = true
}

func dbg_id() -> int {
    let id = DBG.next
    DBG.next = id + 1
    return id
}

func dbg_quote(text: string) -> string {
    return replace(replace(text, "\\", "\\\\"), "\"", "\\\"")
}

# The metadata node for the file path, made on first use.
func dbg_file(path: string) -> int {
    if (map_has(DBG.files, path)) {
        return DBG.files[path]
    }
    let id = dbg_id()
    append(DBG.lines, "!{id} = !DIFile(filename: \"{dbg_quote(path)}\", directory: \".\")")
    DBG.files[path] = id
    return id
}

# Starts the debug scope of a function: returns its node, or 0 when debug information is off.
export func dbg_function(name: string, line: int) -> int {
    if (not DBG.on) {
        return 0
    }
    let file = dbg_file(ST.src_file)
    let id = dbg_id()
    append(DBG.lines, "!{id} = distinct !DISubprogram(name: \"{dbg_quote(name)}\", scope: !{file}, file: !{file}, line: {line}, type: !2, scopeLine: {line}, spFlags: DISPFlagDefinition, unit: !0)")
    return id
}

# ", !dbg !N" for the position p in the running function, or "" when there is no debug information.
export func dbg_at(p: int) -> string {
    let c = ST.ctx
    if (c.dbg == 0) {
        return ""
    }
    let key = "{p}"
    if (not map_has(c.dbg_locs, key)) {
        let line = p % 4194304
        let col = (p / 4194304) % 4096
        let id = dbg_id()
        append(DBG.lines, "!{id} = !DILocation(line: {line}, column: {col}, scope: !{c.dbg})")
        c.dbg_locs[key] = id
    }
    return ", !dbg !{c.dbg_locs[key]}"
}

# The metadata that goes at the end of the module.
export func dbg_module_text() -> string {
    let out: list<string> = ["!llvm.dbg.cu = !\{!0}", "!llvm.module.flags = !\{!3}"]
    append(out, "!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !{dbg_file(ST.src_file)}, producer: \"zue\", isOptimized: false, runtimeVersion: 0, emissionKind: LineTablesOnly)")
    append(out, "!1 = !DIFile(filename: \"{dbg_quote(ST.src_file)}\", directory: \".\")")
    append(out, "!2 = !DISubroutineType(types: !4)")
    append(out, "!3 = !\{i32 2, !\"Debug Info Version\", i32 3}")
    append(out, "!4 = !\{}")
    for (let l in DBG.lines) {
        append(out, l)
    }
    return join(out, "\n")
}

# Records the position p where an error can be raised: one store, which also carries the line table
# entry when debug information is on.
export func ll_store_pos(p: int) {
    ll("store i64 {p}, ptr @lv_pos{dbg_at(p)}")
}

# One instruction. After a terminator a fresh block starts first, so unreachable code
# after return, break or continue is still valid IR.
export func ll(text: string) {
    let c = ST.ctx
    if (c.dead) {
        c.dead = false
        append(c.out, "d{uid()}:")
    }
    append(c.out, "  {text}")
}

export func ll_label(name: string) {
    let c = ST.ctx
    c.dead = false
    c.line = -1
    append(c.out, "{name}:")
}

export func ll_br(label: string) {
    ll("br label %{label}")
    ST.ctx.dead = true
}

export func ll_condbr(cond: string, yes: string, no: string) {
    ll("br i1 {cond}, label %{yes}, label %{no}")
    ST.ctx.dead = true
}

export func ll_new_label(prefix: string) -> string {
    return "{prefix}{uid()}"
}

# An LV slot for a temporary value, allocated in the entry block.
export func ll_slot() -> string {
    if (ST.ctx.pooling) {
        return ll_temp_alloca("%LV")
    }
    let name = "%t{uid()}"
    append(ST.ctx.allocas, "  {name} = alloca %LV, align 8")
    return name
}

# Temporaries of a statement at the top level of a module hold nothing the next statement needs, so
# when the statement ends they go back to a pool (by type) and later statements reuse them: a long
# top-level body has as many slots as its largest statement needs, not a new set for every statement.
# LLVM's SROA pass takes time for each slot in proportion to the size of the function, which made
# long scripts quadratic (11,200 lines took 23 s). Slots that outlive their statement are made with
# ll_alloca (variables, box memory) or taken out of the pool with ll_keep (deferred call arguments).
export func ll_temp_alloca(kind_text: string) -> string {
    if (not ST.ctx.pooling) {
        return ll_alloca(kind_text)
    }
    let name = ""
    if (map_has(ST.ctx.pool, kind_text) and len(ST.ctx.pool[kind_text]) > 0) {
        name = remove(ST.ctx.pool[kind_text], -1)
    } else {
        name = ll_alloca(kind_text)
    }
    append(ST.ctx.taken, [kind_text, name])
    return name
}

# Keeps the temporary slot name for the rest of the function: it is not given back to the pool.
export func ll_keep(name: string) {
    let kept: list<list<string>> = []
    for (let t in ST.ctx.taken) {
        if (t[1] != name) {
            append(kept, t)
        }
    }
    ST.ctx.taken = kept
}

# Gives the temporaries taken since the last call back to the pool.
export func ll_release_temps() {
    for (let t in ST.ctx.taken) {
        if (not map_has(ST.ctx.pool, t[0])) {
            ST.ctx.pool[t[0]] = []
        }
        append(ST.ctx.pool[t[0]], t[1])
    }
    ST.ctx.taken = []
}

export func ll_alloca(kind_text: string) -> string {
    let name = "%a{uid()}"
    append(ST.ctx.allocas, "  {name} = alloca {kind_text}, align 8")
    return name
}

export func ll_reg() -> string {
    return "%r{uid()}"
}

# Like ll_copy, for a cell in a heap object. The write barrier of the collector sees the value that is
# being overwritten (see zue_gc.zu).
export func ll_copy_heap(dst: string, src: string) {
    ll("call void @lv_wb_cell(ptr {dst})")
    ll_copy(dst, src)
}

export func ll_copy(dst: string, src: string) {
    let r = ll_reg()
    # two 8-byte moves: a 16-byte vector load right after two 8-byte stores cannot be forwarded
    # by the CPU and stalls
    let sp = ll_reg()
    let dp = ll_reg()
    let w = ll_reg()
    ll("{r} = load i64, ptr {src}")
    ll("{sp} = getelementptr inbounds i8, ptr {src}, i64 8")
    ll("{w} = load i64, ptr {sp}")
    ll("store i64 {r}, ptr {dst}")
    ll("{dp} = getelementptr inbounds i8, ptr {dst}, i64 8")
    ll("store i64 {w}, ptr {dp}")
}

# The place of a node as the number the runtime reads from @lv_pos when it reports an error. Bits 0-21
# are the line, 22-33 the column, 34-45 the length on the first line, 46-57 the offset of the operator
# from the column (0 when the node has none) and 58-59 the operator length minus one. A node with no
# column, or one too far along its line, is only a line.
export func ll_pos(n: Node) -> int {
    let line = n.line
    if (line > 4194303) {
        return 0
    }
    let col = n.col
    if (col == 0 or col > 4095) {
        return line
    }
    let width = 4095
    if (n.eline == line) {
        width = n.ecol - col
        if (width > 4095) {
            width = 4095
        }
        if (width < 1) {
            width = 1
        }
    }
    let p = line + col * 4194304 + width * 17179869184
    if (n.k == "bin" and n.ospan != null and n.ospan.line == line) {
        let off = n.ospan.col - col
        let oplen = n.ospan.ecol - n.ospan.col
        if (off > 0 and off <= 4095 and oplen >= 1 and oplen <= 4) {
            p = p + off * 70368744177664 + (oplen - 1) * 288230376151711744
        }
    }
    return p
}

# The place that runs from the start of node a to the end of node b plus extra bytes (a closing bracket).
export func ll_pos_range(a: Node, b: Node, extra: int) -> int {
    let line = a.line
    if (a.col == 0 or a.col > 4095 or line > 4194303) {
        return line
    }
    let width = 4095
    if (b.eline == line) {
        width = b.ecol + extra - a.col
        if (width > 4095) {
            width = 4095
        }
        if (width < 1) {
            width = 1
        }
    }
    return line + a.col * 4194304 + width * 17179869184
}

# Records where the next operations run, so a runtime error can name the exact text. The store is
# left out when the place is the one already recorded.
export func ll_mark(n: Node) {
    ll_mark_pos(ll_pos(n))
}

# The same for a statement: only its line is recorded, so that an error no operation inside it claims
# is not drawn under the wrong text.
export func ll_mark_line(n: Node) {
    ll_mark_pos(n.line)
}

export func ll_mark_pos(p: int) {
    if (ST.ctx.line != p) {
        ll_store_pos(p)
        ST.ctx.line = p
    }
}

# Calls a pointer-ABI wrapper that writes its result through the first argument.
export func ll_call_out(fn_name: string, args_text: string) -> string {
    let t = ll_slot()
    if (args_text == "") {
        ll("call void @{fn_name}(ptr {t})")
    } else {
        ll("call void @{fn_name}(ptr {t}, {args_text})")
    }
    return t
}

# Calls a runtime function that returns an LV by value and stores the result in a slot.
export func ll_call_lv(callee: string, args_text: string) -> string {
    let r = ll_reg()
    ll("{r} = call %LV @{callee}({args_text})")
    let t = ll_slot()
    ll("store %LV {r}, ptr {t}")
    return t
}

export func ll_gname(name: string) -> string {
    return "@{ST.mod.prefix}{name}"
}

export func ll_reg_global(name: string) {
    if (not map_has(ST.mod.globals, name)) {
        ST.mod.globals[name] = true
        append(LL_GLOBALS, "{ll_gname(name)} = internal global %LV \{ i64 17, i64 0 }")
    }
}

# An array of LVs holding copies of the given slots; returns a pointer to its first element.
export func ll_args_array(items: list<string>) -> string {
    if (len(items) == 0) {
        return "null"
    }
    let n = len(items)
    let arr = ll_temp_alloca("[{n} x %LV]")
    for (let i = 0; i < n; i++) {
        let p = ll_reg()
        ll("{p} = getelementptr inbounds [{n} x %LV], ptr {arr}, i64 0, i64 {i}")
        ll_copy(p, items[i])
    }
    return arr
}
