#
# ranges.zu: cut(s, a, b) and cut_list(x, a, b) take the part of a string or a list from offset a up
# to, not including, offset b, counting from 0. A negative offset counts from the end, an offset past either end is
# clamped, and a range that is empty gives "" or []. The compiler uses it because the builtin slice
# counts from 0 and includes both ends, and never gives an empty result.

export func cut(s: string, a: int, b: int) -> string {
    let n = len(s)
    if (a < 0) {
        a += n
    }
    if (b < 0) {
        b += n
    }
    if (a < 0) {
        a = 0
    }
    if (b > n) {
        b = n
    }
    if (a >= b) {
        return ""
    }
    return substring(s, a, b - a)
}

# A list parameter without an item type takes the list type of each call, so the part has the items' type.
export func cut_list(x: list, a: int, b: int) {
    let n = len(x)
    if (a < 0) {
        a += n
    }
    if (b < 0) {
        b += n
    }
    if (a < 0) {
        a = 0
    }
    if (b > n) {
        b = n
    }
    let out = []
    while (a < b) {
        append(out, x[a])
        a += 1
    }
    return out
}
