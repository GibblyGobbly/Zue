#
# ranges.zu: cut(x, a, b) takes the part of a string or list from offset a up to, not including,
# offset b, counting from 0. A negative offset counts from the end, an offset past either end is
# clamped, and a range that is empty gives "" or []. The compiler uses it because the builtin slice
# counts from 1 and includes both ends, and never gives an empty result.

export func cut(x, a, b) {
    let n = len(x)
    if (a < 0) {
        a += n
    }
    if (b < 0) {
        b += n
    }
    if (a < 0) {
        a = 0
    }
    if (b > n) {
        b = n
    }
    if (type(x) == "string") {
        if (a >= b) {
            return ""
        }
        return substring(x, a, b - a)
    }
    let out = []
    while (a < b) {
        append(out, x[a])
        a += 1
    }
    return out
}
