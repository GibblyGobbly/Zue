# zue: the Zue compiler, written in Zue. It turns a .zu program into LLVM IR and has clang
# build a native binary against the runtime in compiler/runtime (also written in Zue and
# compiled by emit_native.zu).
#
#   zue build prog.zu -o prog [-S]     build a binary; -S keeps C/prog.ll and stops
#   zue run prog.zu [args...]          build into C/run/ and run it
#   zue emit prog.zu [-o out.ll]       write the LLVM IR only
#   zue check prog.zu                  report the errors without building
#   zue explain [CODE]                 explain an error code, or list them all
#   zue ast prog.zu                    print the syntax tree as text
#   zue unparse prog.zu                print the program as source again
#   zue --native a.zu b.zu -o out.ll   compile runtime source (see emit_native.zu)
#
# The compiler is split into the modules next to this file. This one is the driver.
# Note for readers: these files must themselves be written in the subset the compiler
# compiles, so identifiers such as data, from, in, input, print and box are never used as
# names, and a literal { inside a string is written \{.

use { read_file, split_lines } from "util.zu"
use { parse_source } from "parser.zu"
use { compile_program_ll } from "emit_llvm.zu"
use { compile_native } from "emit_native.zu"
use { ST } from "state.zu"
use { dump_program } from "ast_dump.zu"
use { unparse_program } from "ast_unparse.zu"
use { dbg_enable } from "ll_state.zu"
use { diag_set_format } from "diag.zu"
use { ERROR_CODES } from "error_codes.zu"
use { cut } from "ranges.zu"

# Name of a file without its directory and extension: "dir/prog.zu" is "prog".
func base_name(path) {
    let slash = last_index_of(path, "/")
    let name = cut(path, slash + 1, len(path))
    if (ends_with(name, ".zu")) {
        name = cut(name, 0, len(name) - 3)
    }
    return name
}

# Set by --release: build with the program and the runtime optimized as one module.
let RELEASE = [false]

# A shell word for one argument, in single quotes.
func shell_quote(text) {
    let q = "'"
    # Each ' becomes '\'' : close the quote, a quoted quote, reopen.
    return q + replace(text, q, "'\\''") + q
}

# The shell command that turns generated IR into a binary. The compiler's own files are
# found through ZUE_HOME, or else from the place of the running zue binary (bin/zue is
# one level below the tree). CC overrides the C compiler.
func build_command(code_path, out_path) {
    let home = "$\{ZUE_HOME:-$(dirname \"$(dirname \"$(readlink -f /proc/$PPID/exe)\")\")}"
    let rt = "\"$(H=\"{home}\"; \"$H/compiler/build_runtime.sh\")\""
    if (RELEASE[0]) {
        # The program and the runtime are joined into one module and optimized together, so that the small
        # runtime functions (allocation, indexing, the write barrier) are inlined into the program.
        # It takes about two seconds longer to build and runs about 10 to 20 percent faster.
        let all = "{code_path}.release.ll"
        return "RT={rt}; $\{LLVM_LINK:-llvm-link-18} -S {shell_quote(code_path)} \"$\{RT%.o}.ll\" -o {shell_quote(all)} && $\{CC:-clang} -O2 -w {shell_quote(all)} -lm -lpthread -ldl -o {shell_quote(out_path)}"
    }
    return "$\{CC:-clang} -O1 -w {shell_quote(code_path)} {rt} -lm -lpthread -ldl -o {shell_quote(out_path)}"
}

func usage() {
    print("usage: zue build [-g] [--release] prog.zu -o program [-S]")
    print("       zue run [-g] [--release] prog.zu [args...]")
    print("       zue emit [-g] prog.zu [-o out.ll]")
    print("       zue ast prog.zu")
    print("       zue unparse prog.zu")
    print("")
    print("  build  compile to a native binary through LLVM IR")
    print("  run    build into C/run/ and run it with the given arguments")
    print("  emit   write LLVM IR only (default C/<name>.ll)")
    print("  check  parse and type-check only; print every error found, nothing when there is none")
    print("  explain [code]  describe an error code such as E0201; without a code, list them all")
    print("  ast    print the parsed syntax tree, one statement per line (--spans adds the places)")
    print("  unparse  print the parsed program as source again")
    print("  -o     where to write the program or the IR")
    print("  -g     with build, run and emit: add line tables so that gdb, valgrind and perf name the Zue line")
    print("  --release  with build and run: join the program and the runtime and optimize them together (slower to build, faster to run)")
    print("  --error-format=json  before the file: print each compile error as one JSON object per line")
    print("  -S     with build: write C/<name>.ll and do not build")
    exit(1)
}

# Parses and compiles one program; returns the LLVM IR text.
func compile_file(path) {
    ST.src_file = path
    let text = read_file(path)
    ST.src_lines = split_lines(text)
    return compile_program_ll(parse_source(text))
}

func write_text(path, text) {
    let f = open(path, "w")
    if (f == null) {
        print("[ERROR] cannot write {path}")
        exit(1)
    }
    write(f, text)
    close(f)
}

# Compiles path to C/<name>.ll and, unless stop is set, builds out_path from it.
func build_program(path, out_path, stop) {
    let name = base_name(path)
    let code = compile_file(path)
    system("mkdir -p C")
    let code_path = "C/{name}.ll"
    write_text(code_path, code)
    if (stop) {
        print("[OK] wrote {code_path}")
        return null
    }
    let rc = system(build_command(code_path, out_path))
    if (rc != 0) {
        print("")
        print("Internal compiler error: clang rejected the code Zue generated (exit {rc}).")
        print("This is a bug in Zue, not in your program. Please report it with {ST.src_file} and the generated IR, which was kept in {code_path}.")
        print("To look at the IR: opt-18 -passes=verify {code_path} -disable-output")
        exit(1)
    }
    print("[OK] built {out_path} from {code_path}")
}

# zue build prog.zu -o program [-S]
func build_main(a) {
    let out_path = ""
    let stop = false
    let i = 1
    while (i < len(a)) {
        if (a[i] == "-o" and i + 1 < len(a)) {
            out_path = a[i + 1]
            i += 2
        } else if (a[i] == "-S") {
            stop = true
            i += 1
        } else if (a[i] == "-g") {
            dbg_enable()
            i += 1
        } else {
            usage()
        }
    }
    if (out_path == "") {
        out_path = base_name(a[0])
    }
    build_program(a[0], out_path, stop)
}

# zue run prog.zu [args...]: the program's exit status is this command's.
func run_main(a) {
    let name = base_name(a[0])
    system("mkdir -p C/run")
    let out_path = "C/run/{name}"
    let code = compile_file(a[0])
    system("mkdir -p C")
    write_text("C/{name}.ll", code)
    let rc = system(build_command("C/{name}.ll", out_path))
    if (rc != 0) {
        print("")
        print("Internal compiler error: clang rejected the code Zue generated (exit {rc}).")
        print("This is a bug in Zue, not in your program. Please report it with {ST.src_file} and the generated IR, which was kept in C/{name}.ll.")
        exit(1)
    }
    let words = [shell_quote("./{out_path}")]
    for (let i = 1; i < len(a); i++) {
        append(words, shell_quote(a[i]))
    }
    exit(system(join(words, " ")))
}

# zue emit prog.zu [-o out.ll]
func emit_main(a) {
    let out_path = "C/{base_name(a[0])}.ll"
    let i = 1
    while (i < len(a)) {
        if (a[i] == "-o" and i + 1 < len(a)) {
            out_path = a[i + 1]
            i += 2
        } else if (a[i] == "-g") {
            dbg_enable()
            i += 1
        } else {
            usage()
        }
    }
    let code = compile_file(a[0])
    system("mkdir -p C")
    write_text(out_path, code)
    print("[OK] wrote {out_path}")
}

# zue explain [E0201]: what an error code means, with an example and the fix. No code lists them all.
func explain_main(a) {
    if (len(a) == 0 or a[0] == "list") {
        print("Error codes (zue explain CODE for details):")
        print("")
        for (let e in ERROR_CODES) {
            print("  {e.code}  {e.title}")
        }
        return null
    }
    let want = to_upper(a[0])
    for (let e in ERROR_CODES) {
        if (e.code == want) {
            print("{e.code}: {e.title}")
            print("")
            print("Why it happens:")
            for (let line in split(e.text, "\n")) {
                print("  {line}")
            }
            if (len(e.example) > 0) {
                print("")
                print("Example:")
                for (let line in split(e.example, "\n")) {
                    print("    {line}")
                }
            }
            print("")
            print("How to fix it:")
            for (let line in split(e.fix, "\n")) {
                print("  {line}")
            }
            return null
        }
    }
    print("No error code {a[0]}. Run zue explain to list them.")
    exit(1)
}

# zue ast [--spans] prog.zu: the syntax tree as text (see ast_dump.zu).
func ast_main(a) {
    let spans = false
    let path = a[0]
    if (len(a) == 2 and a[0] == "--spans") {
        spans = true
        path = a[1]
    }
    ST.src_file = path
    let text = read_file(path)
    ST.src_lines = split_lines(text)
    print(dump_program(parse_source(text), spans))
}

# zue check prog.zu: finds the lexical, syntax, type and import errors of a program without building it. Every
# error is printed together; the status is 1 if there was any.
func check_main(a) {
    compile_file(a[0])
}

# zue unparse prog.zu: the program written back as source (see ast_unparse.zu).
func unparse_main(a) {
    ST.src_file = a[0]
    let text = read_file(a[0])
    ST.src_lines = split_lines(text)
    print(unparse_program(parse_source(text)))
}

# zue --native a.zu b.zu ... -o out.ll: compiles runtime files (emit_native.zu).
func native_main(a) {
    let files = []
    let out_path = ""
    let i = 1
    while (i < len(a)) {
        if (a[i] == "-o" and i + 1 < len(a)) {
            out_path = a[i + 1]
            i += 2
        } else {
            ST.src_file = a[i]
            let text = read_file(a[i])
            ST.src_lines = split_lines(text)
            append(files, {"path": a[i], "stmts": parse_source(text)})
            i += 1
        }
    }
    if (out_path == "" or len(files) == 0) {
        usage()
    }
    write_text(out_path, compile_native(files))
}

# zuec input.zu output.ll [cwd]: the form the test runner and the bootstrap use. The cwd
# is the directory that relative paths in the program resolve against.
func positional_main(a) {
    ST.src_file = a[0]
    let text = read_file(a[0])
    ST.src_lines = split_lines(text)
    if (len(a) >= 3) {
        ST.cwd = a[2]
    }
    let code = compile_program_ll(parse_source(text))
    if (len(a) >= 2) {
        write_text(a[1], code)
    } else {
        print(code)
    }
}

func main() {
    let a = args()
    if (len(a) < 1) {
        usage()
    }
    let cmd = a[0]
    let rest = cut(a, 1, len(a))
    if (len(rest) >= 2 and rest[0] == "--error-format=json") {
        diag_set_format("json")
        rest = cut(rest, 1, len(rest))
    }
    let more = true
    while (more and len(rest) >= 2) {
        if (rest[0] == "-g" and (cmd == "run" or cmd == "build" or cmd == "emit")) {
            dbg_enable()
            rest = cut(rest, 1, len(rest))
        } else if (rest[0] == "--release" and (cmd == "run" or cmd == "build")) {
            RELEASE[0] = true
            rest = cut(rest, 1, len(rest))
        } else {
            more = false
        }
    }
    if (cmd == "--native") {
        native_main(a)
    } else if (cmd == "build" and len(rest) >= 1) {
        build_main(rest)
    } else if (cmd == "run" and len(rest) >= 1) {
        run_main(rest)
    } else if (cmd == "emit" and len(rest) >= 1) {
        emit_main(rest)
    } else if (cmd == "explain" and len(rest) <= 1) {
        explain_main(rest)
    } else if (cmd == "check" and len(rest) == 1) {
        check_main(rest)
    } else if (cmd == "ast" and (len(rest) == 1 or (len(rest) == 2 and rest[0] == "--spans"))) {
        ast_main(rest)
    } else if (cmd == "unparse" and len(rest) == 1) {
        unparse_main(rest)
    } else if (ends_with(cmd, ".zu")) {
        positional_main(a)
    } else {
        usage()
    }
}
