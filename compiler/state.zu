#
# state.zu: state shared between the compiler modules.

# State shared between modules. An imported name is a copy, so a value that several
# modules assign lives in this template, not in a top-level variable.
#   src_file, src_lines  the file being compiled and its lines
#   cwd                  directory that relative paths resolve against
#   ctx                  the function being compiled
#   mod                  the module being compiled
#   uid                  counter for unique names
template State { src_file, src_lines, cwd, ctx, mod, uid }
export let ST = State("", [], "", null, null, 0)
