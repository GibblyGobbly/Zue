#
# frontend_phases.lu: how long the lexer, the parser and the type checker take on source files.
#   luna run bench/frontend_phases.lu file.lu [file.lu ...]
# Times are in seconds. Use a large file (thousands of lines) for numbers worth comparing.

use { lex } from "../compiler/lexer.lu"
use { parse_program } from "../compiler/parser.lu"
use { read_file } from "../compiler/util.lu"
use { check_program } from "../compiler/check.lu"

func measure(path) {
    let text = read_file(path)
    let t0 = clock()
    let toks = lex(text, 1)
    let t1 = clock()
    let tree = parse_program(toks)
    let t2 = clock()
    check_program(tree)
    let t3 = clock()
    print("{path}: {len(text)} bytes, {len(toks)} tokens")
    print("  lex   {t1 - t0}")
    print("  parse {t2 - t1}")
    print("  check {t3 - t2}")
}

for (let p in args()) {
    measure(p)
}
