func roll_dice(num_rolls) {
    srand(42)
    let total = 0
    let lowest = 6
    let highest = 1
    for (let i = 0; i < num_rolls; i++) {
        let roll = rand(1, 6)
        total += roll
        lowest = min(lowest, roll)
        highest = max(highest, roll)
    }
    print("total {total}")
    print("average {float(total) / float(num_rolls)}")
    print("min {lowest}, max {highest}")
}

roll_dice(10)
